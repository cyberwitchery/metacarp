(load "../carp-frontend.carp")
(load "../../carp-specialize/captures.carp")
(load "Test.carp")
(Project.no-echo)
(use-all Test)

(defn infer-source [source]
  (match (Surface.parse source)
    (Result.Success module)
      (CompilerFrontend.infer-module-with &module &(ExpandConfig.init []))
    (Result.Error _)
      (Result.Error (CompileError.init @"parse" @"invalid fixture"))))

(defn preserves-derivation-policy? []
  (let-do [module (CoreIR.empty-module)
           stable (DeriveContext.init true [])
           local (DeriveContext.init false [])]
    (CoreModule.set-expressions! &module [(Box.init (CoreExpr.IntLit 99 1))])
    (let [first (Derive.copies &stable &module)
          other (Derive.copies &local &module)
          again (Derive.copies &stable &module)]
      (and
        (Int.= 99
               (CoreIR.expression-id
                 (Box.peek (Array.unsafe-nth (CoreModule.expressions &first) 0))))
        (and
          (not
            (Int.= 99
                   (CoreIR.expression-id
                     (Box.peek
                       (Array.unsafe-nth (CoreModule.expressions &other) 0)))))
          (Int.= 99
                 (CoreIR.expression-id
                   (Box.peek
                     (Array.unsafe-nth (CoreModule.expressions &again) 0)))))))))

(defn nested-captures? [] (match (infer-source "(defn make [x]
  (let [y (the Int x)]
    (fn [z] (let [w (the Int z)] (fn [] (let [a y b w] y))))))
(make 1)") (Result.Success annotated)
      (match (Specialize.module (AnnotatedModule.core &annotated)
                                (AnnotatedModule.inferred &annotated))
        (Result.Success specialized)
          (let [captures (CaptureAnalysis.module &specialized)]
            (and (Int.= 2 (Array.length &captures))
                 (and
                   (Int.= 2 (Array.length (Array.unsafe-nth &captures 0)))
                   (Int.= 1 (Array.length (Array.unsafe-nth &captures 1))))))
        (Result.Error _) false) (Result.Error _) false))

(deftest test
  (assert-true test
    (Result.success? &(infer-source "(defn identity [x] x) (identity 3)"))
    "the front end infers source without loading a backend")
  (assert-true test
    (match (infer-source "(deftype Recursive [self Recursive])")
      (Result.Error error) (String.= (CompileError.phase &error) "validate")
      (Result.Success _) false)
    "the shared front end rejects by-value recursion during validation")
  (assert-true test
    (preserves-derivation-policy?)
    "interleaved derivations keep their own expression identity policies")
  (assert-true test
    (nested-captures?)
    "capture analysis deduplicates nested free bindings and excludes local binders"))
