(load "../analysis.carp")
(load "Test.carp")
(Project.no-echo)
(use-all Test)

(defn analysis-fixture [type lifetime]
  (let [reference (CoreRef.init 1 @"f" true)
        raw (MonoType.Reference (Box.init (MonoType.Variable 0))
                                (MonoLifetime.Variable 1))]
    (InferredModule.init
      [(SchemeBinding.init (CoreRef.copy &reference)
                           (TypeScheme.init []
                                            []
                                            (Box.init (MonoType.copy type))
                                            []
                                            []))]
      [(Box.init (MonoType.copy &raw))]
      [(CallSite.init 1
                      (CoreRef.copy &reference)
                      (Box.init
                        (MonoType.Function [] (Box.init (MonoType.copy &raw))))
                      (Maybe.Nothing))]
      [(InferredNodeType.init 1 (Maybe.Nothing) (Box.init (MonoType.copy &raw)))]
      [(InferredBindingType.init reference (Maybe.Nothing) (Box.init raw))]
      (TypeSubstitution.init
        [(TypeBinding.init 0 (Box.init (MonoType.copy type)))]
        [(LifetimeBinding.init 1 (MonoLifetime.copy lifetime))]
        []))))

(defn normalized-analysis-joins-independent-runs? []
  (let [left (analysis-fixture &(MonoType.Integer) &(MonoLifetime.Static))
        right (analysis-fixture &(MonoType.Boolean) &(MonoLifetime.Variable 99))
        joined (InferenceAnalysis.append &(InferenceAnalysis.normalize &left)
                                         &(InferenceAnalysis.normalize &right))
        inferred (InferenceAnalysis.append-inferred &left &right)
        expected [(Box.init
                    (MonoType.Reference (Box.init (MonoType.Integer))
                                        (MonoLifetime.Static)))
                  (Box.init
                    (MonoType.Reference (Box.init (MonoType.Boolean))
                                        (MonoLifetime.Variable 99)))]]
    (let-do [ok (and
               (Int.= 2
                      (Array.length
                        (NormalizedAnalysis.expression-types &joined)))
               (and
                 (Int.=
                   (Array.length
                     (TypeSubstitution.bindings (InferredModule.substitution &left)))
                   1)
                 (Array.empty?
                   (TypeSubstitution.bindings (InferredModule.substitution &inferred)))))]
      (for [i 0 2]
        (let [type (Box.peek (Array.unsafe-nth &expected i))]
          (unless (and
              (Type.same? type
                          (Box.peek
                            (Array.unsafe-nth
                              (InferredModule.expression-types &inferred)
                              i)))
              (and
                (Type.same? type
                            (Box.peek
                              (InferredNodeType.type
                                (Array.unsafe-nth (InferredModule.node-types &inferred)
                                                  i))))
                (and
                  (Type.same? type
                              (Box.peek
                                (InferredBindingType.type
                                  (Array.unsafe-nth (InferredModule.binding-types &inferred)
                                                    i))))
                  (Type.same?
                    &(MonoType.Function [] (Box.init (MonoType.copy type)))
                    (Box.peek
                      (CallSite.type
                        (Array.unsafe-nth (InferredModule.calls &inferred) i)))))))
            (set! ok false))))
      ok)))

(defn nested-analysis-rollback? []
  (let-do [left (analysis-fixture &(MonoType.Integer) &(MonoLifetime.Static))
           right (analysis-fixture &(MonoType.Boolean)
                                   &(MonoLifetime.Variable 99))
           normalized (InferenceAnalysis.normalize &left)
           resident (InferenceAnalysis.with-environment &left &normalized)
           before (str &resident)
           outer (InferenceAnalysis.mark &resident)]
    (InferenceAnalysis.append! &resident &(InferenceAnalysis.normalize &right))
    (let-do [middle (str &resident)
             inner (InferenceAnalysis.mark &resident)]
      (InferenceAnalysis.append! &resident &normalized)
      (InferenceAnalysis.retract! &resident &inner)
      (let-do [restored-middle (String.= &middle &(str &resident))]
        (InferenceAnalysis.retract! &resident &outer)
        (and restored-middle (String.= &before &(str &resident)))))))

(deftest test
  (assert-true test
    (normalized-analysis-joins-independent-runs?)
    "independent solver spaces normalize every type and lifetime trace before merging")
  (assert-true test
    (nested-analysis-rollback?)
    "nested inference checkpoints restore all normalized traces and environments"))
