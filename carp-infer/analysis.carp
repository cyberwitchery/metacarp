(load "carp-infer.carp")

(doc NormalizedAnalysis "holds the results of an inference run with its
substitution applied to the traces. `environment` holds the scheme bindings.
`expression-types` holds the types of the top-level expressions. `calls` holds
the call sites, `node-types` the types of nodes, and `binding-types` the types
of bindings.")
(deftype NormalizedAnalysis
  [environment (Array SchemeBinding)
   expression-types (Array (Box MonoType))
   calls (Array CallSite)
   node-types (Array InferredNodeType)
   binding-types (Array InferredBindingType)])

(doc InferenceAnalysis "applies the substitution of an inference run to its
traces, and joins the results of independent runs.")
(defmodule InferenceAnalysis
  (doc normalize "returns the results of `module` with its substitution applied
to every trace. The environment is copied unchanged.")
  (defn normalize [module]
    (let-do [environment (Array.copy (InferredModule.environment module))
             expression-types (the (Array (Box MonoType)) [])
             calls (the (Array CallSite) [])
             node-types (the (Array InferredNodeType) [])
             binding-types (the (Array InferredBindingType) [])
             ; `Type.apply` scans the whole substitution for each variable,
             ; which is quadratic over all traces. this solver is indexed.
             solver (Type.solver-from-substitution (InferredModule.substitution module))]
      (for [i 0 (Array.length (InferredModule.expression-types module))]
        (Array.push-back! &expression-types
                          (Box.init
                            (Type.solver-apply &solver
                                               (Box.peek
                                                 (Array.unsafe-nth (InferredModule.expression-types module)
                                                                   i))))))
      (for [i 0 (Array.length (InferredModule.calls module))]
        (let [call (Array.unsafe-nth (InferredModule.calls module) i)]
          (Array.push-back! &calls
                            (CallSite.init @(CallSite.id call)
                                           (CoreRef.copy (CallSite.reference call))
                                           (Box.init
                                             (Type.solver-apply &solver
                                                                (Box.peek (CallSite.type call))))
                                           (match-ref (CallSite.owner call)
                                             (Maybe.Just owner)
                                               (Maybe.Just (CoreRef.copy owner))
                                             (Maybe.Nothing) (Maybe.Nothing))))))
      (for [i 0 (Array.length (InferredModule.node-types module))]
        (let [node (Array.unsafe-nth (InferredModule.node-types module) i)]
          (Array.push-back! &node-types
                            (InferredNodeType.init @(InferredNodeType.id node)
                                                   (match-ref (InferredNodeType.owner node)
                                                     (Maybe.Just owner)
                                                       (Maybe.Just (CoreRef.copy owner))
                                                     (Maybe.Nothing)
                                                       (Maybe.Nothing))
                                                   (Box.init
                                                     (Type.solver-apply &solver
                                                                        (Box.peek (InferredNodeType.type node))))))))
      (for [i 0 (Array.length (InferredModule.binding-types module))]
        (let [binding (Array.unsafe-nth (InferredModule.binding-types module) i)]
          (Array.push-back! &binding-types
                            (InferredBindingType.init
                              (CoreRef.copy (InferredBindingType.reference binding))
                              (match-ref (InferredBindingType.owner binding)
                                (Maybe.Just owner)
                                  (Maybe.Just (CoreRef.copy owner))
                                (Maybe.Nothing) (Maybe.Nothing))
                              (Box.init
                                (Type.solver-apply &solver
                                                   (Box.peek (InferredBindingType.type binding))))))))
      (NormalizedAnalysis.init environment
                               expression-types
                               calls
                               node-types
                               binding-types)))
  (private append-copies!)
  (hidden append-copies!)
  (defn append-copies! [target source]
    (for [i 0 (Array.length source)]
      (Array.push-back! target @(Array.unsafe-nth source i))))

  (private joined)
  (hidden joined)
  (defn joined [left right]
    (let-do [result @left] (append-copies! &result right) result))

  (doc append "returns `base` followed by `overlay`. Nothing is renamed.")
  (defn append [base overlay]
    (NormalizedAnalysis.init
      (joined (NormalizedAnalysis.environment base)
              (NormalizedAnalysis.environment overlay))
      (joined
        (NormalizedAnalysis.expression-types base)
        (NormalizedAnalysis.expression-types overlay))
      (joined (NormalizedAnalysis.calls base) (NormalizedAnalysis.calls overlay))
      (joined (NormalizedAnalysis.node-types base)
              (NormalizedAnalysis.node-types overlay))
      (joined (NormalizedAnalysis.binding-types base)
              (NormalizedAnalysis.binding-types overlay))))
  (doc with-environment "returns an `InferredModule` with the environment of
`environment` and the traces of `analysis`, with an empty substitution. The
environment of `analysis` is dropped.")
  (defn with-environment [environment analysis]
    (InferredModule.init
      (Array.copy (InferredModule.environment environment))
      (Array.copy (NormalizedAnalysis.expression-types analysis))
      (Array.copy (NormalizedAnalysis.calls analysis))
      (Array.copy (NormalizedAnalysis.node-types analysis))
      (Array.copy (NormalizedAnalysis.binding-types analysis))
      (Type.empty-substitution)))

  (doc append-inferred "normalizes the runs `left` and `right` and joins their
results, with an empty substitution. The environments are joined unchanged.")
  (defn append-inferred [left right]
    (let [base (normalize left)
          overlay (normalize right)]
      (InferredModule.init
        (joined (NormalizedAnalysis.environment &base)
                (NormalizedAnalysis.environment &overlay))
        (joined
          (NormalizedAnalysis.expression-types &base)
          (NormalizedAnalysis.expression-types &overlay))
        (joined (NormalizedAnalysis.calls &base)
                (NormalizedAnalysis.calls &overlay))
        (joined (NormalizedAnalysis.node-types &base)
                (NormalizedAnalysis.node-types &overlay))
        (joined (NormalizedAnalysis.binding-types &base)
                (NormalizedAnalysis.binding-types &overlay))
        (Type.empty-substitution)))))

(defmodule InferenceAnalysis
  (private retract-array!)

  (hidden retract-array!)

  (defn retract-array! [target length]
    (while-do (Int.> (Array.length target) length)
      (ignore (Array.pop-back! target))))

  (doc mark "returns the lengths of the five result arrays of `inferred`, for
`retract!`.")
  (defn mark [inferred]
    [(Array.length (InferredModule.environment inferred))
     (Array.length (InferredModule.expression-types inferred))
     (Array.length (InferredModule.calls inferred))
     (Array.length (InferredModule.node-types inferred))
     (Array.length (InferredModule.binding-types inferred))])

  (doc append! "appends the environment and traces of `extra` to `target`.")
  (defn append! [target extra]
    (do
      (append-copies! (InferredModule.environment target)
                      (NormalizedAnalysis.environment extra))
      (append-copies! (InferredModule.expression-types target)
                      (NormalizedAnalysis.expression-types extra))
      (append-copies! (InferredModule.calls target)
                      (NormalizedAnalysis.calls extra))
      (append-copies! (InferredModule.node-types target)
                      (NormalizedAnalysis.node-types extra))
      (append-copies! (InferredModule.binding-types target)
                      (NormalizedAnalysis.binding-types extra))))

  (doc retract! "shrinks the result arrays of `inferred` back to `lengths`,
which came from `mark`.")
  (defn retract! [inferred lengths]
    (do
      (retract-array! (InferredModule.environment inferred)
                      @(Array.unsafe-nth lengths 0))
      (retract-array!
        (InferredModule.expression-types inferred)
        @(Array.unsafe-nth lengths 1))
      (retract-array! (InferredModule.calls inferred)
                      @(Array.unsafe-nth lengths 2))
      (retract-array! (InferredModule.node-types inferred)
                      @(Array.unsafe-nth lengths 3))
      (retract-array! (InferredModule.binding-types inferred)
                      @(Array.unsafe-nth lengths 4)))))
