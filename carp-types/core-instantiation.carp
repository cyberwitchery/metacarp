(load "../carp-ir/carp-ir.carp")
(load "../carp-types/carp-types.carp")

(doc CoreInstantiation "turns resolved types into concrete types for fields and
layouts. References get the `Static` lifetime. Type variables are looked up with
a function the caller passes, which may fail.")
(defmodule CoreInstantiation
  (sig type-with
       (Fn
         [(Ref CoreType)
          (Ref a)
          (Ref (Fn [(Ref a) (Ref String)] (Result MonoType String)))]
         (Result MonoType String)))
  (sig arguments-with
       (Fn
         [(Ref (Array (Box CoreType)))
          (Ref a)
          (Ref (Fn [(Ref a) (Ref String)] (Result MonoType String)))]
         (Result (Array (Box MonoType)) String)))

  (doc type-with "returns `type` as a concrete type, looking up its type
variables in `bindings` with `lookup`. A failed lookup is an error.")
  (defn type-with [type bindings lookup]
    (match-ref type
      (CoreType.Integer) (Result.Success (Type.integer))
      (CoreType.String) (Result.Success (Type.string))
      (CoreType.Boolean) (Result.Success (Type.boolean))
      (CoreType.Unit) (Result.Success (Type.unit))
      (CoreType.Variable name) (~lookup bindings name)
      (CoreType.Named name arguments)
        (match (arguments-with arguments bindings lookup)
          (Result.Success concrete) (Result.Success (Type.named name concrete))
          (Result.Error error) (Result.Error error))
      (CoreType.Reference inner _)
        (match (type-with (Box.peek inner) bindings lookup)
          (Result.Success concrete)
            (Result.Success (Type.reference concrete (MonoLifetime.Static)))
          (Result.Error error) (Result.Error error))
      (CoreType.Function arguments result)
        (match (arguments-with arguments bindings lookup)
          (Result.Success concrete-arguments)
            (match (type-with (Box.peek result) bindings lookup)
              (Result.Success concrete-result)
                (Result.Success
                  (Type.function concrete-arguments concrete-result))
              (Result.Error error) (Result.Error error))
          (Result.Error error) (Result.Error error))))

  (doc arguments-with "returns each of `arguments` as a concrete type, as
`type-with` does. It stops at the first error.")
  (defn arguments-with [arguments bindings lookup]
    (let-do [result (the (Result (Array (Box MonoType)) String)
                         (Result.Success []))]
      (for [i 0 (Array.length arguments)]
        (match-ref &result
          (Result.Success concrete)
            (match (type-with
                (Box.peek (Array.unsafe-nth arguments i))
                bindings
                lookup)
              (Result.Success type) (Array.push-back! concrete (Box.init type))
              (Result.Error error) (set! result (Result.Error error)))
          (Result.Error _) ()))
      result)))
