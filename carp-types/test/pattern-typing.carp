(load "../../carp-compiler.carp")
(load "Test.carp")
(Project.no-echo)
(use-all Test)

(defmodule OwnershipClassify
  (defn instantiate-test [type] (resolved->mono type)))

(defn pair-constructor []
  (CoreConstructorDeclaration.init (CoreRef.init 7 @"Pair.make" true)
                                   0
                                   [(Box.init (CoreType.Variable @"a"))
                                    (Box.init (CoreType.Variable @"b"))]
                                   [@"first" @"second"]
                                   (Box.init
                                     (CoreType.Named @"Pair"
                                                     [(Box.init (CoreType.Variable @"a"))
                                                      (Box.init (CoreType.Variable @"b"))]))))
(defn wrap-constructor []
  (CoreConstructorDeclaration.init (CoreRef.init 8 @"Wrap.make" true)
                                   0
                                   [(Box.init (CoreType.Variable @"x"))]
                                   [@"value"]
                                   (Box.init
                                     (CoreType.Named @"Wrap"
                                                     [(Box.init (CoreType.Variable @"x"))]))))
(defn wrapped-pattern [child]
  (CorePattern.Constructor (CoreRef.init 8 @"Wrap.make" true) [(Box.init child)]))
(defn pair-pattern [left right]
  (CorePattern.Constructor (CoreRef.init 7 @"Pair.make" true)
                           [(Box.init left) (Box.init right)]))
(defn pair-type [left right]
  (Type.named "Pair" [(Box.init left) (Box.init right)]))
(defn wrap-type [inner] (Type.named "Wrap" [(Box.init inner)]))

(defn nested-bound-and-ignored? []
  (let [binder (CoreRef.init 9 @"bound" false)
        pattern (pair-pattern (wrapped-pattern (CorePattern.Ignore))
                              (wrapped-pattern (CorePattern.Bind @&binder)))
        type (pair-type (wrap-type (Type.string)) (wrap-type (Type.integer)))
        constructors [(pair-constructor) (wrap-constructor)]
        bound (Specialize.bound-slot-types &pattern &type &constructors)
        ignored (Specialize.unbound-slot-types &pattern &type &constructors)]
    (and (Int.= 1 (Array.length &bound))
         (and (Int.= 1 (Array.length &ignored))
              (and
                (CoreIR.same-ref? (Pair.a (Array.unsafe-nth &bound 0)) &binder)
                (and
                  (Type.same? (Pair.b (Array.unsafe-nth &bound 0))
                              &(Type.integer))
                  (Type.same? (Array.unsafe-nth &ignored 0) &(Type.string))))))))

(defn ignored-order-and-rewrite? []
  (let-do [pattern (pair-pattern (CorePattern.Ignore)
                                 (wrapped-pattern (CorePattern.Ignore)))
           type (pair-type (Type.string) (wrap-type (Type.integer)))
           constructors [(pair-constructor) (wrap-constructor)]
           ignored (Specialize.unbound-slot-types &pattern &type &constructors)
           refs [(CoreRef.init 20 @"skipped" false)
                 (CoreRef.init 21 @"drop" false)]
           cursor [0]
           rewritten (Specialize.bind-unbound-slots &pattern
                                                    &refs
                                                    &[false true]
                                                    &cursor)]
    (and (Int.= 2 (Array.length &ignored))
         (and
           (Type.same? (Array.unsafe-nth &ignored 0) &(Type.string))
           (and
             (Type.same? (Array.unsafe-nth &ignored 1) &(Type.integer))
             (and (Int.= 2 @(Array.unsafe-nth &cursor 0))
                  (match-ref &rewritten
                    (CorePattern.Constructor _ children)
                      (and
                        (match-ref (Box.peek (Array.unsafe-nth children 0))
                          (CorePattern.Ignore) true
                          _ false)
                        (match-ref (Box.peek (Array.unsafe-nth children 1))
                          (CorePattern.Constructor _ nested)
                            (match-ref (Box.peek (Array.unsafe-nth nested 0))
                              (CorePattern.Bind reference)
                                (CoreIR.same-ref? reference
                                                  (Array.unsafe-nth &refs 1))
                              _ false)
                          _ false))
                    _ false)))))))

(defn first-exact-constructor? []
  (let-do [pattern (pair-pattern (CorePattern.Ignore) (CorePattern.Ignore))
           type (pair-type (Type.string) (Type.integer))
           wrong (pair-constructor)
           duplicate (pair-constructor)]
    (CoreConstructorDeclaration.set-reference! &wrong
                                               (CoreRef.init 7 @"wrong" true))
    (CoreConstructorDeclaration.set-arguments! &duplicate
                                               [(Box.init (CoreType.Boolean))])
    (let [constructors [wrong (pair-constructor) duplicate]
          slots (Specialize.unbound-slot-types &pattern &type &constructors)]
      (and (Int.= 2 (Array.length &slots))
           (and
             (Type.same? (Array.unsafe-nth &slots 0) &(Type.string))
             (Type.same? (Array.unsafe-nth &slots 1) &(Type.integer)))))))

(defn missing-bindings-and-extra-children? []
  (let [pattern (CorePattern.Constructor (CoreRef.init 7 @"Pair.make" true)
                                         [(Box.init (CorePattern.Ignore))
                                          (Box.init (CorePattern.Ignore))
                                          (Box.init (CorePattern.Ignore))])
        type (Type.named "Pair" [(Box.init (Type.string))])
        slots (Specialize.unbound-slot-types &pattern
                                             &type
                                             &[(pair-constructor)])]
    (and (Int.= 2 (Array.length &slots))
         (and
           (Type.same? (Array.unsafe-nth &slots 0) &(Type.string))
           (Type.same? (Array.unsafe-nth &slots 1) &(Type.unit))))))

(defn root-and-unknown-patterns? []
  (let [type (Type.string)
        ignore (Specialize.unbound-slot-types &(CorePattern.Ignore) &type &[])
        bind (Specialize.bound-slot-types
          &(CorePattern.Bind (CoreRef.init 2 @"root" false))
          &type
          &[])
        unknown (CorePattern.Constructor (CoreRef.init 999 @"missing" true)
                                         [(Box.init (CorePattern.Ignore))])
        absent (Specialize.unbound-slot-types &unknown
                                              &type
                                              &[(pair-constructor)])]
    (and (Int.= 1 (Array.length &ignore))
         (and
           (Type.same? (Array.unsafe-nth &ignore 0) &type)
           (and (Int.= 1 (Array.length &bind)) (Array.empty? &absent))))))

(defn ownership-conversion-policy? []
  (let [type (CoreType.Function
          [(Box.init
             (CoreType.Reference (Box.init (CoreType.Variable @"a"))
                                 (CoreLifetime.Named @"borrow")))]
          (Box.init
            (CoreType.Named @"Pair"
                            [(Box.init (CoreType.String))
                             (Box.init (CoreType.Unit))])))
        actual (OwnershipClassify.instantiate-test &type)
        expected (Type.function
          [(Box.init
             (Type.reference (MonoType.Variable 0) (MonoLifetime.Static)))]
          (Type.named "Pair" [(Box.init (Type.string)) (Box.init (Type.unit))]))]
    (Type.same? &actual &expected)))

(defn joint-nested? []
  (let [binder (CoreRef.init 9 @"bound" false)
        pattern (pair-pattern (wrapped-pattern (CorePattern.Ignore))
                              (wrapped-pattern (CorePattern.Bind @&binder)))
        type (pair-type (wrap-type (Type.string)) (wrap-type (Type.integer)))
        constructors [(pair-constructor) (wrap-constructor)]
        analysis (PatternTyping.analyze &pattern &type &constructors)
        bound (PatternSlotTypes.bound &analysis)
        ignored (PatternSlotTypes.unbound &analysis)]
    (and (Int.= 1 (Array.length bound))
         (and (Int.= 1 (Array.length ignored))
              (and
                (CoreIR.same-ref? (Pair.a (Array.unsafe-nth bound 0)) &binder)
                (and
                  (Type.same? (Pair.b (Array.unsafe-nth bound 0))
                              &(Type.integer))
                  (Type.same? (Array.unsafe-nth ignored 0) &(Type.string))))))))

(deftest test
  (assert-true test
    (joint-nested?)
    "joint analysis retains both typed slot sets in one owning result")
  (assert-true test
    (nested-bound-and-ignored?)
    "nested patterns type bound and ignored generic payloads")
  (assert-true test
    (ignored-order-and-rewrite?)
    "ignored slot order agrees with masked binding and cursor advancement")
  (assert-true test
    (first-exact-constructor?)
    "constructor lookup retains first exact identity rather than id alone")
  (assert-true test
    (missing-bindings-and-extra-children?)
    "missing type bindings become Unit and extra pattern children are ignored")
  (assert-true test
    (root-and-unknown-patterns?)
    "root slots retain their type and unknown constructors produce no slots")
  (assert-true test
    (ownership-conversion-policy?)
    "ownership type conversion keeps variable-zero and static-lifetime recovery"))
