(load "../carp-types.carp")
(Project.no-echo)
(load "Test.carp")

(use-all Test)

(defn unary [argument result] (Type.function [(Box.init argument)] result))

(defn variable-unifies-with-int? []
  (let [variable (Type.variable 0)
        integer (Type.integer)
        empty (Type.empty-substitution)]
    (match (Type.unify &variable &integer &empty)
      (Result.Success substitution)
        (let [applied (Type.apply &substitution &variable)]
          (Type.same? &applied &integer))
      (Result.Error _) false)))

(defn int-unifies-with-variable? []
  (let [variable (Type.variable 0)
        integer (Type.integer)
        empty (Type.empty-substitution)]
    (match (Type.unify &integer &variable &empty)
      (Result.Success substitution)
        (let [applied (Type.apply &substitution &variable)]
          (Type.same? &applied &integer))
      (Result.Error _) false)))

(defn occurs-check-rejects-recursion? []
  (let [variable (Type.variable 0)
        function (unary (Type.variable 0) (Type.integer))
        empty (Type.empty-substitution)]
    (Result.error? &(Type.unify &variable &function &empty))))

(defn identity-unifies-with-string? []
  (let [generic (unary (Type.variable 0) (Type.variable 0))
        concrete (unary (Type.string) (Type.string))
        empty (Type.empty-substitution)]
    (match (Type.unify &generic &concrete &empty)
      (Result.Success substitution)
        (let [applied (Type.apply &substitution &generic)]
          (Type.same? &applied &concrete))
      (Result.Error _) false)))

(defn nominal-reference-unifies-structurally? []
  (let [generic (Type.reference
          (Type.named "Array" [(Box.init (Type.variable 0))])
          (Type.lifetime 1))
        concrete (Type.reference
          (Type.named "Array" [(Box.init (Type.integer))])
          (Type.lifetime 2))
        empty (Type.empty-substitution)]
    (match (Type.unify &generic &concrete &empty)
      (Result.Success substitution)
        (let [applied (Type.apply &substitution &generic)]
          (Type.same? &applied &concrete))
      (Result.Error _) false)))

(defn unit-unifies-with-unit? []
  (let [left (Type.unit)
        right (Type.unit)
        empty (Type.empty-substitution)]
    (Result.success? &(Type.unify &left &right &empty))))

(defn borrowing-is-expression-only? []
  (let [borrowed (Type.reference (Type.integer) (Type.lifetime 0))
        owned (Type.integer)
        empty (Type.empty-substitution)]
    (and
      (Result.error? &(Type.unify &borrowed &owned &empty))
      (Result.error? &(Type.unify-strict &borrowed &owned &empty)))))

(defn mutable-solver-unifies-variable-chains? []
  (let [solver (Type.solver)
        first (Type.variable 0)
        second (Type.variable 1)
        integer (Type.integer)]
    (and
      (Result.success? &(Type.solver-unify! &solver &first &second))
      (and
        (Result.success? &(Type.solver-unify! &solver &second &integer))
        (let [applied (Type.solver-apply &solver &first)
              snapshot (Type.solver-snapshot &solver)
              snapshot-applied (Type.apply &snapshot &first)]
          (and (Type.same? &applied &integer)
               (Type.same? &snapshot-applied &integer)))))))

(defn lifetime-unification-is-applied? []
  (let [left (Type.reference (Type.integer) (Type.lifetime 0))
        right (Type.reference (Type.integer) (Type.lifetime 1))
        empty (Type.empty-substitution)
        solver (Type.solver)]
    (and
      (and (not (Type.same? &left &right))
           (Type.same-representation? &left &right))
      (and
        (match (Type.unify-strict &left &right &empty)
          (Result.Success substitution)
            (let [applied (Type.apply &substitution &left)]
              (Type.same? &applied &right))
          (Result.Error _) false)
        (and
          (Result.success? &(Type.solver-unify-strict! &solver &left &right))
          (let [applied (Type.solver-apply &solver &left)]
            (Type.same? &applied &right)))))))

(deftest t
  (assert-true t
    (variable-unifies-with-int?)
    "unification substitutes an inference variable")
  (assert-true t
    (int-unifies-with-variable?)
    "unification binds a variable on either side")
  (assert-true t
    (occurs-check-rejects-recursion?)
    "unification rejects an infinite type")
  (assert-true t
    (identity-unifies-with-string?)
    "function unification propagates through arguments and result")
  (assert-true t
    (nominal-reference-unifies-structurally?)
    "nominal reference types unify structurally")
  (assert-true t (unit-unifies-with-unit?) "unit types unify")
  (assert-true t
    (borrowing-is-expression-only?)
    "strict declaration matching does not apply implicit borrowing")
  (assert-true t
    (mutable-solver-unifies-variable-chains?)
    "mutable solver snapshots path-compressed variable chains")
  (assert-true t
    (lifetime-unification-is-applied?)
    "immutable and mutable unification preserve lifetime aliases"))
