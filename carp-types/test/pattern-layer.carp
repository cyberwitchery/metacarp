(load "../pattern-typing.carp")
(load "Test.carp")
(Project.no-echo)
(use-all Test)

(defn ignores-own-their-payload? []
  (let [type (Type.string)
        result (PatternTyping.analyze &(CorePattern.Ignore) &type &[])
        bound (PatternSlotTypes.bound &result)
        ignored (PatternSlotTypes.unbound &result)]
    (and (Array.empty? bound)
         (and (Int.= 1 (Array.length ignored))
              (Type.same? (Array.unsafe-nth ignored 0) &type)))))

(defn binders-own-their-type? []
  (let [reference (CoreRef.init 7 @"payload" false)
        type (Type.named "Box" [(Box.init (Type.string))])
        result (PatternTyping.analyze &(CorePattern.Bind @&reference) &type &[])
        bound (PatternSlotTypes.bound &result)
        ignored (PatternSlotTypes.unbound &result)]
    (and (Array.empty? ignored)
         (and (Int.= 1 (Array.length bound))
              (and
                (CoreIR.same-ref? (Pair.a (Array.unsafe-nth bound 0)) &reference)
                (Type.same? (Pair.b (Array.unsafe-nth bound 0)) &type))))))

(deftest test
  (assert-true test
    (ignores-own-their-payload?)
    "standalone pattern typing retains ignored payloads without specialization")
  (assert-true test
    (binders-own-their-type?)
    "standalone pattern typing retains bound payload types"))
