(load "core-prep.carp")
(load "../bas-check.carp")
(Project.no-echo)

;; Types definitions of Core with Boolean-algebraic subtyping, and what they
;; depend on, and prints each type or why it could not be typed.
;;
;;   CT_TARGET=name,name ./run.sh corpus/bas-run.carp

(defn root-cells [state names]
  (let-do [out (the (Array Int) [])]
    (for [i 0 (Array.length names)]
      (let [cell (BSession.resolve state
                                   (CtState.root state)
                                   (Array.unsafe-nth names i))]
        (if (Int.>= cell 0)
          (Array.push-back! &out cell)
          (IO.errorln &(fmt "not found: %s" (Array.unsafe-nth names i))))))
    out))

(defn main []
  (match (prepared-core)
    (Maybe.Nothing) (System.exit 1)
    (Maybe.Just prepared)
      (let-do [state (ExpandSnapshot.state (PreparedExpansion.snapshot &prepared))
               names (match (IO.getenv "CT_TARGET")
                 ;; every definition in the session, macros included
                 (Maybe.Just t)
                 (if (String.= &t "*")
                   (Array.copy-map &(fn [d] @(BDef.name d))
                                   &(Map.vals &(BSession.definitions state)))
                   (String.split-by &t &[\,]))
                 (Maybe.Nothing)
                 [@"Dynamic.empty?"])
               _init (BTop.init!)
               _global (match (IO.getenv "BAS_GLOBAL")
                 (Maybe.Just g)
                   (let [cell (BSession.resolve state (CtState.root state) &g)]
                     (if (Int.< cell 0)
                       (IO.errorln &(fmt "%s: not found" &g))
                       (IO.errorln
                         &(fmt "%s holds %s"
                               &g
                               &(BT.str
                                 (BVal.of-value
                                   (CtEnv.peek-cell (CtState.environment state)
                                                    &(CtEnv.cell-at cell))))))))
                 (Maybe.Nothing) ())
               _repeat (match (IO.getenv "BAS_REPEAT")
                 (Maybe.Just n)
                   (let-do [k (Maybe.from (Int.from-string &n) 0)
                            t0 (System.nanotime)]
                     (for [i 0 k]
                       (do
                         (BTop.init!)
                         (ignore (BTop.check state &(root-cells state &names)))))
                     (IO.errorln
                       &(fmt "repeat %d: %.1f ms each"
                             k
                             (Double./
                               (Double.from-long
                                 (Long.- (Uint64.to-long (System.nanotime))
                                         (Uint64.to-long t0)))
                               (Double.* 1000000.0
                                         (Double.from-int (Int.max k 1)))))))
                 (Maybe.Nothing) ())
               _reinit (BTop.init!)
               start (System.nanotime)
               outcomes (BTop.check state &(root-cells state &names))
               total (Double./
                 (Double.from-long
                   (Long.- (Uint64.to-long (System.nanotime))
                           (Uint64.to-long start)))
                 1000000.0)]
        (for [i 0 (Array.length &outcomes)]
          (let [o (Array.unsafe-nth &outcomes i)]
            (match-ref (BOutcome.type o)
              (Maybe.Just t)
                (do
                  (when (Maybe.just? &(IO.getenv "BAS_DUMP")) (BPrint.dump @t))
                  (IO.println
                    &(fmt "ok   %s : %s  (%.1f ms)"
                          (BOutcome.name o)
                          &(BPrint.show @t)
                          @(BOutcome.millis o))))
              (Maybe.Nothing)
                (IO.println
                  &(fmt "FAIL %s: %s  (%.1f ms)"
                        (BOutcome.name o)
                        (BOutcome.failure o)
                        @(BOutcome.millis o))))))
        (IO.println &(fmt "total %.1f ms" total)))))
