(load "../../carp-expand/carp-expand.carp")
(load "../../carp-module/carp-module.carp")

;; Loading and expanding Core the way the compiler does, for the corpora that
;; check code with Core around it.

(defn core-prefix []
  (match (IO.getenv "CARP_DIR")
    (Maybe.Just dir) (String.append &dir "/core/")
    (Maybe.Nothing) @"../../../carp/core/"))

(defn core-path [name] (String.append &(core-prefix) name))

(defn core-source [path]
  (let [prefix (core-prefix)
        file (String.append &prefix path)]
    (ModuleSource.init (String.copy path)
                       (String.copy &file)
                       (IO.unsafe-read-file &file))))

(defn core-sources []
  (let-do [result (the (Array ModuleSource) [])
           paths (String.split-by "Core.carp
Interfaces.carp
Blitable.carp
Bool.carp
Box.carp
Macros.carp
BoolExtras.carp
List.carp
Derive.carp
Gensym.carp
ControlMacros.carp
Project.carp
Platform.carp
Introspect.carp
Quasiquote.carp
Pointer.carp
Unsafe.carp
Function.carp
Generics.carp
Maybe.carp
Result.carp
Dynamic.carp
Format.carp
Byte.carp
Int.carp
Long.carp
Double.carp
Float.carp
Tuples.carp
Array.carp
StaticArray.carp
StdInt.carp
Char.carp
String.carp
ArrayExt.carp
System.carp
IO.carp
Pattern.carp
Debug.carp
Random.carp
Map.carp
Heap.carp
Sort.carp
Binary.carp
Control.carp
Opaque.carp
Unit.carp" &[\newline])
           n (Array.length &paths)]
    (for [i 0 n]
      (set! result
            (Array.push-back result (core-source (Array.unsafe-nth &paths i)))))
    result))

(defn append-forms [left right]
  (let-do [result (Array.copy left)
           n (Array.length right)]
    (for [i 0 n]
      (set! result
            (Array.push-back result
                             (Box.init
                               (SurfaceNode.copy (Box.peek (Array.unsafe-nth right
                                                                             i)))))))
    result))

(doc boot-prelude "the definitions the compiler's driver puts before Core.")
(defn boot-prelude []
  (Result.from-success (Surface.parse "(defndynamic host-arch [] \"aarch64\")
(defndynamic host-os [] \"darwin\")
(def target-arch \"aarch64\")
(def target-os \"darwin\")
(def target-abi \"unknown\")
(defmodule Project
  (defndynamic config [key value] ())
  (defndynamic no-echo [] ())
  (defndynamic get-config [key]
    (cond
      (= key \"echo-c\") false
      (= key \"title\") \"Untitled\"
      (= key \"output-directory\") \"out\"
      (= key \"load-stack\") (Unsafe.load-stack)
      (= key \"cflag\") '()
      (= key \"libflag\") '()
      (= key \"pkgconfigflag\") '()
      \"native\")))") (SurfaceModule.init [])))

(doc prepare-sources "Core expanded from `sources`, with the compile-time
state it leaves, or the error expanding it raised.")
(defn prepare-sources [sources]
  (let [root (String.copy "Core.carp")
        bootstrap (boot-prelude)]
    (match (ModuleLoader.load sources &root)
      (Result.Success core)
        (let [forms (append-forms (SurfaceModule.forms &bootstrap)
                                  (SurfaceModule.forms &core))
              input (SurfaceModule.init forms)]
          (match (MacroExpand.prepare-module-with &input
                                                  &(ExpandConfig.init [@"Dynamic"]))
            (Result.Success prepared) (Result.Success prepared)
            (Result.Error error) (Result.Error @(CtError.message &error))))
      (Result.Error error) (Result.Error @(ModuleError.message &error)))))

(doc prepared-core "Core expanded, with the compile-time state it leaves.")
(defn prepared-core []
  (let [sources (core-sources)
        root (String.copy "Core.carp")
        bootstrap (boot-prelude)]
    (match (ModuleLoader.load &sources &root)
      (Result.Success core)
        (let [forms (append-forms (SurfaceModule.forms &bootstrap)
                                  (SurfaceModule.forms &core))
              input (SurfaceModule.init forms)]
          (match (MacroExpand.prepare-module-with &input
                                                  &(ExpandConfig.init [@"Dynamic"]))
            (Result.Success prepared) (Maybe.Just prepared)
            (Result.Error error)
              (do (IO.errorln (CtError.message &error)) (Maybe.Nothing))))
      (Result.Error error)
        (do (IO.errorln (ModuleError.message &error)) (Maybe.Nothing)))))
