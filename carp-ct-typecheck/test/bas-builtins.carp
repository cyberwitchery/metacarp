(load "../bas-check.carp")
(Project.no-echo)

;; Checks the builtin types against the evaluator: each sample call is run,
;; and the type of what it answers must fit in the result its builtin's type
;; gives for the types of its arguments (themselves typed from their values).
;; A call the evaluator rejects must be rejected by the type too. Then each
;; declared preimage is checked on sample values of every kind. Exits 1 on
;; any mismatch.

(def samples
  [@"(list 1 'a \"s\")"
   @"(list)"
   @"(array 1 2)"
   @"(Symbol.from \"abc\")"
   @"(Symbol.concat '(a b))"
   @"(Symbol.prefix 'a 'b)"
   @"(car '(1 2))"
   @"(car '[1 2])"
   @"(cdr '(1 2))"
   @"(cdr '[1 2])"
   @"(cadr '(1 2 3))"
   @"(caddr '(1 2 3))"
   @"(cadddr '(1 2 3 4))"
   @"(cddr '(1 2 3))"
   @"(cddr '[1 2 3])"
   @"(caadr '(1 (2 3)))"
   @"(cdadr '(1 (2 3)))"
   @"(last '(1 2 3))"
   @"(last '[1 2 3])"
   @"(all-but-last '(1 2 3))"
   @"(all-but-last '[1 2 3])"
   @"(last '())"
   @"(last '[])"
   @"(all-but-last '())"
   @"(all-but-last '[])"
   @"(car '())"
   @"(cdr '())"
   @"(cons 1 '(2 3))"
   @"(cons 1 '[2 3])"
   @"(cons 1 (array))"
   @"(cons-last 4 '[2 3])"
   @"(cons-last 4 '(2 3))"
   @"(append [1] '(2))"
   @"(append '(1) [2])"
   @"(append [1] [2])"
   @"(cons 1 '())"
   @"(cons 1 '[])"
   @"(cons 1 [2 3])"
   @"(cons 1 [])"
   @"(cons-last 1 '(2 3))"
   @"(cons-last 1 '[2 3])"
   @"(append '(1) '(2))"
   @"(append '[1] '[2])"
   @"(append '(1) '[2])"
   @"(length '(1 2))"
   @"(length '[1 2])"
   @"(length \"abc\")"
   @"(length $[1])"
   @"(empty? $[])"
   @"(empty? '())"
   @"(empty? '[])"
   @"(empty? \"\")"
   @"(list? 1)"
   @"(list? '(1))"
   @"(array? '[1])"
   @"(not true)"
   @"(dynamic-type 'a)"
   @"(dynamic-type '(1))"
   @"(= 1 1)"
   @"(= 'a \"a\")"
   @"(+ 1 2)"
   @"(+ 1.0 2.0)"
   @"(+ 1 2.0)"
   @"(+ 1l 2)"
   @"(- 3 1)"
   @"(* 2 3)"
   @"(/ 6 3)"
   @"(round 1.5)"
   @"(> 1 2)"
   @"(< 1 2)"
   @"(String.length \"abc\")"
   @"(String.index-of \"abc\" \\b)"
   @"(String.char-at \"abc\" 1)"
   @"(String.slice \"abc\" 0 2)"
   @"(String.prefix \"abc\" 1)"
   @"(String.suffix \"abc\" 1)"
   @"(String.head \"abc\")"
   @"(String.tail \"abc\")"
   @"(String.empty? \"\")"
   @"(String.to-list \"ab\")"
   @"(String.to-array \"ab\")"
   @"(String.append \"a\" \"b\")"
   @"(String.concat '(\"a\" \"b\"))"
   @"(String.concat [\"a\" \"b\"])"
   @"(parse \"(a b)\")"
   @"(Dynamic.Path.directory \"a/b\")"
   @"(Dynamic.String.split-on \"-\" \"a-b\")"
   @"(String.split-on \"\" \"ab\")"
   @"(str 1 'a \"b\")"
   @"(hash 'a)"
   @"(line)"
   @"(line 'a)"
   @"(column)"
   @"(file)"
   @"(file 'a)"
   @"(Symbol.str 'a)"
   ;; values that are not forms, for the builtins typed as taking anything
   @"(Symbol.from car)"
   @"(list? car)"
   @"(array? (fn [] 1))"
   @"(dynamic-type car)"
   @"(= car car)"
   @"(= (fn [] 1) 1)"
   @"(= [1] [1])"
   @"(line car)"
   @"(column (fn [] 1))"
   @"(file car)"
   @"(str car)"
   @"(str (fn [] 1))"
   @"(hash car)"
   @"(macro-log car)"
   @"(add-cflag car)"
   @"(Project.config \"title\" car)"
   @"(write-file \"ct-sample-write.txt\" \"x\")"
   @"(write-file \"ct-sample-write.txt\" 1)"
   @"(length [car])"
   @"(cons car '(2))"
   @"(cons [1] '(2))"
   @"(cons 1 [2])"
   @"(cons-last car '(2))"
   @"(cons-last [1] '(2))"
   @"(append (list car) '(2))"
   @"(list [1] 2)"
   @"(list car)"
   @"(list car 'a)"
   @"(array car)"
   @"(system-include car)"
   @"(add-lib car)"
   @"(add-pkg car)"
   @"(macro-error car)"
   @"(file (fn [] 1))"
   @"(macro-log (fn [] 1))"])

;; calls the types are known not to reject although the evaluator does:
;; append's arguments must be of one kind, which one arrow per builtin cannot
;; say (`bas-calculus.md` §8). Reported, not counted.
(def unchecked [@"(append [1] '(2))" @"(append '(1) [2])" @"(append '(1) '[2])"])

(doc typed-call "the result type of builtin `id` called on values of types
`args`, as the checker types the call: through its kind test for a builtin
that acts on a sequence's kind, otherwise by its arrow. Nothing when it has
no type; the type is meaningful only when `*bas-failed*` stays false.")
(defn typed-call [id args]
  (if (and (Int.= 2 (Array.length args))
           (Maybe.just? &(BLower.kind-dispatch id)))
    (let-do [vs (Array.copy-map &(fn [a] (BAst.lit @a)) args)]
      (set! *bas-failed* false)
      (Maybe.Just
        (BTyper.typeof &(the (Map Int BScheme) (Map.create))
                       1
                       (BLower.dispatched id &vs))))
    (match (BBuiltin.type-of id (Array.length args) 1)
      (Maybe.Nothing) (Maybe.Nothing)
      (Maybe.Just t)
        (let-do [r (BT.fresh-var 1)]
          (set! *bas-failed* false)
          (BSolve.constrain t (BT.fun (BT.tup args) r))
          (Maybe.Just r)))))

(defn check [state root src]
  (match (Surface.parse src)
    (Result.Error _) (fmt "PARSE %s" src)
    (Result.Success m)
      (let [form @(Box.peek (Array.unsafe-nth (SurfaceModule.forms &m) 0))]
        (match-ref (SurfaceNode.form &form)
          (SurfaceForm.List items)
            (let-do [head (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth items
                                                                                   0)))
                       (SurfaceForm.Symbol segs) (String.join "." segs)
                       _ @"")
                     id (CtLower.builtin-id &head)
                     args (the (Array Int) [])
                     ok true]
              (for [i 1 (Array.length items)]
                (match (CtEval.eval-node (Box.peek (Array.unsafe-nth items i))
                                         state
                                         root)
                  (Result.Success v) (Array.push-back! &args (BVal.of-value &v))
                  (Result.Error _) (set! ok false)))
              (cond
                (Int.< id 0) (fmt "SKIP %s: not a builtin" src)
                (not ok) (fmt "SKIP %s: an argument failed" src)
                (match (CtEval.eval-node &form state root)
                  (Result.Error e)
                  ;; the evaluator rejects the call: the type must reject it too
                  (match (typed-call id &args)
                    (Maybe.Nothing) (fmt "NOTY %s" src)
                    (Maybe.Just _)
                      (if *bas-failed*
                        (fmt "ok   %s (both reject it)" src)
                        (fmt
                          "ERR  %s: the evaluator rejects it (%s), the type does not"
                          src
                          (CtError.message &e))))
                  (Result.Success v)
                  (match (typed-call id &args)
                    (Maybe.Nothing) (fmt "NOTY %s" src)
                    (Maybe.Just r)
                      (if *bas-failed*
                        (fmt
                          "REJ  %s: the type rejects the arguments: %s"
                          src
                          &*bas-failure*)
                        (let-do [actual (BVal.of-value &v)
                                 promised (BResolve.ground r true)]
                          (BSolve.constrain actual promised)
                          (if *bas-failed* (fmt "BAD  %s
       answers %s
       typed   %s" src &(BPrint.show actual) &(BPrint.show (BResolve.ground r
                                                                            true))) (fmt "ok   %s"
                                                                                         src))))))))
          _ (fmt "SKIP %s: not a call" src)))))

(def values
  [@"1"
   @"1l"
   @"1b"
   @"1.0f"
   @"1.0"
   @"\\c"
   @"\"s\""
   @"\"\""
   @"'a"
   @"true"
   @"false"
   @"'()"
   @"'(1)"
   @"'[]"
   @"'[1]"
   @"$[]"
   @"$[1]"
   @"(list)"
   @"(list 1)"
   @"'(1 2)"
   @"'(1 2 3)"
   @"[1 2]"
   @"[1 2 3]"
   @"(array 1 2)"
   @"(array)"
   @"(array 1)"
   @"(list car)"
   @"(array car)"
   @"'{}"
   @"'{1 2}"
   @"[1]"
   @"[]"
   @"[car]"
   @"#\"p\""
   @"{}"
   @"(fn [] 1)"
   @"car"
   @"when"])

;; each declared preimage: a builtin, a literal it answers, and that literal
;; as BBuiltin.preimage takes it
(def tests
  [(Pair.init @"list?" @"true")
   (Pair.init @"array?" @"true")
   (Pair.init @"empty?" @"true")
   (Pair.init @"length" @"0")
   (Pair.init @"length" @">0")
   (Pair.init @"length" @"1")
   (Pair.init @"length" @"2")
   (Pair.init @"length" @"3")
   (Pair.init @"length" @">1")
   (Pair.init @"length" @">2")
   (Pair.init @"length" @"<1")
   (Pair.init @"length" @"<2")
   (Pair.init @"length" @"<3")
   (Pair.init @"dynamic-type" @"'symbol")
   (Pair.init @"dynamic-type" @"'string")
   (Pair.init @"dynamic-type" @"'char")
   (Pair.init @"dynamic-type" @"'int")
   (Pair.init @"dynamic-type" @"'long")
   (Pair.init @"dynamic-type" @"'byte")
   (Pair.init @"dynamic-type" @"'float")
   (Pair.init @"dynamic-type" @"'double")
   (Pair.init @"dynamic-type" @"'bool")
   (Pair.init @"dynamic-type" @"'list")
   (Pair.init @"dynamic-type" @"'array")
   (Pair.init @"dynamic-type" @"'static-array")
   (Pair.init @"dynamic-type" @"'pattern")
   (Pair.init @"dynamic-type" @"'closure")
   (Pair.init @"dynamic-type" @"'fn")
   (Pair.init @"dynamic-type" @"'macro")
   (Pair.init @"dynamic-type" @"'map")
   (Pair.init @"dynamic-type" @"'comment")])

(defn lit-of [text]
  (cond
    (String.= text "true") (BLit.Boolean true)
    (String.starts-with? text ">")
      (BLit.Above (Maybe.from (Int.from-string &(String.suffix text 1)) 0))
    (String.starts-with? text "<")
      (BLit.Below (Maybe.from (Int.from-string &(String.suffix text 1)) 0))
    (String.starts-with? text "'") (BLit.Sym (String.suffix text 1))
    (BLit.Integer (Maybe.from (Int.from-string text) 0))))

(doc condition "the test `lit` stands for, on `(f v)`.")
(defn condition [f src lit]
  (if (or (String.starts-with? lit ">") (String.starts-with? lit "<"))
    (fmt "(%s (%s %s) %s)" &(String.prefix lit 1) f src &(String.suffix lit 1))
    (fmt "(= (%s %s) %s)" f src lit)))

(defn eval-src [state root src]
  (match (Surface.parse src)
    (Result.Error _) (Maybe.Nothing)
    (Result.Success m)
      (match (CtEval.eval-node
          (Box.peek (Array.unsafe-nth (SurfaceModule.forms &m) 0))
          state
          root)
        (Result.Success v) (Maybe.Just v)
        (Result.Error _) (Maybe.Nothing))))

(doc check-preimage "for each sample value the builtin accepts, `(f v)` is
the literal exactly when `v`'s type is below the declared preimage. Answers
the mismatches, one per line.")
(defn check-preimage [state root test]
  (let-do [f (Pair.a test)
           lit (Pair.b test)
           out @""]
    (match (BBuiltin.preimage (CtLower.builtin-id f) &(lit-of lit))
      (Maybe.Nothing) (set! out (fmt "NOPRE (%s x) = %s is not declared
" f lit))
      (Maybe.Just t)
        (for [i 0 (Array.length &values)]
          (let [src (Array.unsafe-nth &values i)]
            (when (Maybe.just? &(eval-src state root &(fmt "(%s %s)" f src)))
              (match (eval-src state root &(condition f src lit))
                (Maybe.Nothing) (set! out (fmt "%sERR  (= (%s %s) %s) fails
" &out f src lit))
                (Maybe.Just answer)
                  (match (eval-src state root src)
                    (Maybe.Nothing) ()
                    (Maybe.Just arg)
                      (let-do [is (Int.= (BVal.of-value &answer)
                                         (BT.named "True"))]
                        (set! *bas-failed* false)
                        (BSolve.constrain (BVal.of-value &arg) t)
                        (unless (Bool.= is (not *bas-failed*))
                          (set! out
                                (fmt
                                  "%sBAD  (%s %s) is %s %s, but %s is %s below %s
"
                                  &out
                                  f
                                  src
                                  (if is "" "not")
                                  lit
                                  &(BPrint.show (BVal.of-value &arg))
                                  (if *bas-failed* "not" "")
                                  &(BPrint.show t)))))))))))
    out))

(defn main []
  (let-do [state (CtEval.state)
           root (CtEval.root &state)
           bad 0]
    (BTop.init!)
    (for [i 0 (Array.length &samples)]
      (let-do [line (check &state &root (Array.unsafe-nth &samples i))]
        (if (and (String.starts-with? &line "ERR")
                 (Array.contains? &unchecked (Array.unsafe-nth &samples i)))
          (IO.println &(String.append "known " &line))
          (do
            (unless (String.starts-with? &line "ok") (set! bad (Int.inc bad)))
            (IO.println &line)))))
    (IO.println &(fmt "%d of %d not ok" bad (Array.length &samples)))
    (let-do [wrong 0]
      (for [i 0 (Array.length &tests)]
        (let [r (check-preimage &state &root (Array.unsafe-nth &tests i))]
          (unless-do (String.empty? &r)
            (set! wrong (Int.inc wrong))
            (IO.print &r))))
      (IO.println &(fmt "%d of %d preimages wrong" wrong (Array.length &tests)))
      (when (Int.> (Int.+ bad wrong) 0) (System.exit 1)))))
