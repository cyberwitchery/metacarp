(load "../../carp-expand/carp-expand.carp")
(load "../bas-check.carp")
(load "Test.carp")
(use-all Test)

;; checking whole sessions: what the compiler's --check-ct runs on the
;; compile-time state an expansion leaves

(def program "(defndynamic twice-form [x] (list (quote +) x x))
(defmacro twice [x] (twice-form x))
(defndynamic broken [xs] (+ (car xs) \"s\"))
(defndynamic uses-broken [xs] (broken xs))
(defmacro bad-unless [c :rest body] (list (quote if) c () (cons (quote do) (+ body 1))))
(defmacro my-when [c :rest body] (list (quote if) c (cons (quote do) body) ()))
(defndynamic count-all [:rest xs] (length xs))
(defndynamic bad-test [] (if (empty? 5) 1 2))
(defndynamic apply-builtin-is-a-form [] (+ 1 (apply + (quote (1 2)))))
(defndynamic apply-builtin-form [] (car (apply + (quote (1 2)))))
(defndynamic apply-local [f] (apply f (quote (1 2))))")

(doc outcomes "every definition of `source` checked, by name: its failure,
or the empty string when it checks.")
(defn outcomes [source]
  (match (Surface.parse source)
    (Result.Error _) (the (Map String String) (Map.create))
    (Result.Success m)
      (match (MacroExpand.prepare-module-with &m &(ExpandConfig.init []))
        (Result.Error _) (the (Map String String) (Map.create))
        (Result.Success prepared)
          (let-do [state (CtState.copy
                     (ExpandSnapshot.state (PreparedExpansion.snapshot &prepared)))
                   _init (BTop.init!)
                   roots (Map.keys &(BSession.definitions &state))
                   out (the (Map String String) (Map.create))]
            (let [os (BTop.check &state &roots)]
              (for [i 0 (Array.length &os)]
                (let [o (Array.unsafe-nth &os i)]
                  (Map.put! &out
                            (BOutcome.name o)
                            &(if (Maybe.just? (BOutcome.type o))
                              @""
                              @(BOutcome.failure o))))))
            out))))

(defn checks? [os name]
  (match (Map.get-maybe os name)
    (Maybe.Just msg) (String.empty? &msg)
    (Maybe.Nothing) false))

(defn fails? [os name]
  (match (Map.get-maybe os name)
    (Maybe.Just msg) (not (String.empty? &msg))
    (Maybe.Nothing) false))

(defn fails-with? [os name prefix]
  (match (Map.get-maybe os name)
    (Maybe.Just msg) (String.starts-with? &msg prefix)
    (Maybe.Nothing) false))

(defn main []
  (let [os (outcomes program)]
    (with-test t
      (assert-true t
        (checks? &os "twice-form")
        "a function that builds a form checks")
      (assert-true t
        (checks? &os "twice")
        "a macro checks as a function of forms")
      (assert-true t
        (fails-with? &os "broken" "String is not")
        "a type error fails")
      (assert-true t
        (fails-with? &os "uses-broken" "uses broken, which does not check")
        "a failure names the definition it comes from")
      (assert-true t
        (fails-with? &os "bad-unless" "ListNil is not")
        "a macro is checked without being called")
      (assert-true t
        (checks? &os "my-when")
        "a macro with a rest parameter checks")
      (assert-true t
        (checks? &os "count-all")
        "a function with a rest parameter checks")
      (assert-true t
        (fails-with? &os "bad-test" "Int is not")
        "a test still checks its argument")
      (assert-true t
        (fails? &os "apply-builtin-is-a-form")
        "apply of a builtin makes the call form, not its value")
      (assert-true t
        (checks? &os "apply-builtin-form")
        "the call form apply makes is a list")
      (assert-true t (checks? &os "apply-local") "apply of a local checks"))))
