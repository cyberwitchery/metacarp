(load "../bas.carp")
(load "Test.carp")
(use-all Test)

;; the constraint solver on its own: whether `lhs ≤ rhs` can be made to hold

(defn holds? [lhs rhs]
  (do (set! *bas-failed* false) (BSolve.constrain lhs rhs) (not *bas-failed*)))

(defn n [name] (BT.named name))

(defn main []
  (do
    (BT.reset!)
    (let [merged (BT.inter (BT.fun (BT.tup &[(n "Int")]) (n "Int"))
                           (BT.fun (BT.tup &[(n "String")]) (n "String")))
          cell (BT.inters
            &[(n "ListCons") (BT.car-fld (n "Int")) (BT.cdr-fld (n "ListNil"))])
          ;; tagged functions (bas-calculus.md §7.1): an arrow is compared
          ;; with arrows only, never with a tag or a field
          f (BT.inter (n "Closure") (BT.fun (BT.tup &[(n "Int")]) (n "Int")))
          lst (BT.rec-type 0
                           &(fn [self]
                             (BT.union (n "ListNil")
                                       (BT.inters
                                         &[(n "ListCons")
                                           (BT.car-fld (n "Int"))
                                           (BT.cdr-fld self)]))))
          two (BT.inters
            &[(n "ListCons")
              (BT.car-fld (n "Int"))
              (BT.cdr-fld
                (BT.inters
                  &[(n "ListCons")
                    (BT.car-fld (n "Int"))
                    (BT.cdr-fld (n "ListNil"))]))])
          a (BT.fresh-var 1)
          b (BT.fresh-var 1)
          t1 (BT.fresh-var 1)
          t2 (BT.fresh-var 1)]
      (with-test t
        (assert-true t
          (holds? (n "Int") (n "Number"))
          "a tag is below its ancestor")
        (assert-false t (holds? (n "Number") (n "Int")) "not above it")
        (assert-false t (holds? (n "Int") (n "String")) "unrelated tags")
        (assert-true t
          (holds? (BT.inter (n "Int") (n "String")) (BT.bot))
          "unrelated tags are disjoint")
        (assert-true t
          (holds? (BT.union (n "Int") (n "Float")) (n "Number"))
          "a union below")
        (assert-false t
          (holds? (BT.union (n "Int") (n "String")) (n "Number"))
          "a union with a part outside")
        (assert-true t
          (holds? (n "Int") (BT.union (n "String") (n "Number")))
          "below a union")
        (assert-true t
          (holds?
            (BT.inter (n "Number") (BT.neg (n "Int")))
            (BT.union (n "Float")
                      (BT.union (n "Double") (BT.union (n "Long") (n "Byte")))))
          "a difference")
        (assert-false t
          (holds? (BT.inter (n "Number") (BT.neg (n "Int"))) (n "Float"))
          "a difference too large")
        (assert-true t
          (holds? (n "Int") (BT.neg (n "String")))
          "below a negation")
        (assert-true t
          (holds?
            (BT.fun (BT.tup &[(n "Number")]) (n "Int"))
            (BT.fun (BT.tup &[(n "Int")]) (n "Number")))
          "arrows: contravariant, covariant")
        (assert-false t
          (holds? (BT.fun (BT.tup &[(n "Int")]) (n "Int"))
                  (BT.fun (BT.tup &[(n "Number")]) (n "Int")))
          "a domain too small")
        (assert-false t
          (holds? (BT.tup &[(n "Int")]) (BT.tup &[(n "Int") (n "Int")]))
          "tuples of different lengths")
        (assert-true t
          (holds? merged (BT.fun (BT.tup &[(n "Int")]) (n "String")))
          "arrows merge: no overloads")
        (assert-true t
          (holds? merged
                  (BT.fun (BT.tup &[(BT.union (n "Int") (n "String"))]) (BT.bot)))
          "the merged arrow")
        (assert-true t
          (holds? cell (BT.car-fld (n "Number")))
          "a field, covariant")
        (assert-false t
          (holds? cell (BT.car-fld (n "String")))
          "a field of the wrong type")
        (assert-false t
          (holds? cell (BT.cdr-fld (BT.car-fld (n "Int"))))
          "a field the value lacks")
        (assert-true t
          (holds? cell (BT.union (n "Symbol") (BT.car-fld (n "Int"))))
          "a tag missed, a field matched")
        (assert-true t
          (holds? f (BT.fun (BT.tup &[(n "Int")]) (n "Number")))
          "a tagged function is a function")
        (assert-true t (holds? f (n "Closure")) "and has its tag")
        (assert-false t (holds? f (n "Builtin")) "not another tag")
        (assert-false t
          (holds? f (BT.car-fld (n "Int")))
          "a function has no fields")
        (assert-false t
          (holds? cell (BT.fun (BT.tup &[(n "Int")]) (n "Int")))
          "a cons cell is not a function")
        (assert-false t
          (holds? (n "Closure") (BT.fun (BT.tup &[(n "Int")]) (n "Int")))
          "a tag alone is not a function")
        (assert-true t
          (holds? f
                  (BT.union (n "Symbol")
                            (BT.fun (BT.tup &[(n "Int")]) (n "Int"))))
          "a tag missed, the arrow matched")
        (assert-true t (holds? two lst) "a two-element list is a list of ints")
        (assert-false t
          (holds?
            (BT.inters
              &[(n "ListCons")
                (BT.car-fld (n "String"))
                (BT.cdr-fld (n "ListNil"))])
            lst)
          "not a list of strings")
        (assert-true t (holds? (n "Int") a) "a lower bound")
        (assert-true t (holds? a (n "Number")) "a consistent upper bound")
        (assert-false t (holds? a (n "String")) "an inconsistent one")
        (assert-true t
          (holds? b
                  (BT.union (BT.inter (n "ListCons") t1)
                            (BT.inters &[t2 (BT.neg (n "ListCons")) (n "Obj")])))
          "a tag test on a variable")
        (assert-true t (holds? (n "Int") b) "a value flows in")
        (assert-true t (holds? t2 (n "Number")) "the else branch sees it")
        (assert-true t (holds? t1 (n "String")) "the then branch does not")))))
