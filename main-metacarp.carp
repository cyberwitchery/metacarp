(load "driver.carp")
(load "carp-repl/cli.carp")
(Project.config "title" "metacarp")
(Project.no-echo)
(when (= (host-os) "darwin") (add-cflag "-Wl,-stack_size,0x20000000"))

(defn metacarp-help []
  (do
    (print-help "metacarp")
    (IO.println "")
    (IO.println "REPL:")
    (IO.println "  metacarp              open the terminal REPL")
    (IO.println "  metacarp repl [options]")
    (IO.println
      "                        --core <dir>, --history <file>, --no-history")
    (IO.println "  metacarp repl --help   show REPL commands and key bindings")))

(defn main []
  (if (Int.= (StaticArray.length &System.args) 1)
    (repl-main 1 "metacarp")
    (let [argument (StaticArray.unsafe-nth &System.args 1)]
      (cond
        (String.= argument "repl") (repl-main 2 "metacarp repl")
        (or (String.= argument "--help") (String.= argument "-h"))
          (do (metacarp-help) 0)
        (do (compiler-main 1 "metacarp") 0)))))
