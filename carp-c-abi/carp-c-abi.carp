(load "../carp-types/carp-types.carp")
(load "git@github.com:carpentry-org/strbuf@0.3.0")

(deftype CAbiError [message String])

(defmodule CAbi
  (private ascii-alphanumeric?)
  (hidden ascii-alphanumeric?)
  (private append-runtime-character!)
  (hidden append-runtime-character!)
  (private runtime-component)
  (hidden runtime-component)
  (private escape-c-keyword)
  (hidden escape-c-keyword)
  (defn ascii-alphanumeric? [character]
    (let [codepoint (Char.to-int character)]
      (or
        (and (Int.>= codepoint (Char.to-int \a))
             (Int.<= codepoint (Char.to-int \z)))
        (or
          (and (Int.>= codepoint (Char.to-int \A))
               (Int.<= codepoint (Char.to-int \Z)))
          (and (Int.>= codepoint (Char.to-int \0))
               (Int.<= codepoint (Char.to-int \9)))))))

  (doc identifier "normalizes an already-selected C symbol. ASCII letters,
digits, and underscores are preserved; other characters become underscores.")
  (defn identifier [value]
    (let-do [buffer (StringBuf.create)
             characters (String.chars value)
             n (Array.length &characters)]
      (for [i 0 n]
        (let [character @(Array.unsafe-nth &characters i)]
          (StringBuf.append-char &buffer
                                 (if (or (ascii-alphanumeric? character)
                                         (Char.= character \_))
                                   character
                                   \_))))
      (StringBuf.into-string buffer)))

  (defn append-runtime-character! [buffer character]
    (cond
      (Char.= character \+) (StringBuf.append-str buffer "_PLUS_")
      (Char.= character \-) (StringBuf.append-str buffer "_MINUS_")
      (Char.= character \*) (StringBuf.append-str buffer "_MUL_")
      (Char.= character \/) (StringBuf.append-str buffer "_DIV_")
      (Char.= character \<) (StringBuf.append-str buffer "_LT_")
      (Char.= character \>) (StringBuf.append-str buffer "_GT_")
      (Char.= character \?) (StringBuf.append-str buffer "_QMARK_")
      (Char.= character \!) (StringBuf.append-str buffer "_BANG_")
      (Char.= character \=) (StringBuf.append-str buffer "_EQ_")
      (Int.<= (Char.to-int character) 127)
        (StringBuf.append-char buffer character)
      (do
        (StringBuf.append-str buffer "_U")
        (StringBuf.append-str buffer &(Int.str (Char.to-int character)))
        (StringBuf.append-str buffer "U_"))))

  ;; Note: We deliberately diverge from reference Carp here. Reference Carp
  ;; escapes "extern" to "_EXTERN" and "for" to "_FOR" (lacking trailing underscores),
  ;; but we use "_EXTERN_" and "_FOR_" for consistency and symmetry with other keywords.
  (defn escape-c-keyword [value]
    (cond
      (= value "auto") (String.copy "_AUTO_")
      (= value "break") (String.copy "_BREAK_")
      (= value "case") (String.copy "_CASE_")
      (= value "const") (String.copy "_CONST_")
      (= value "char") (String.copy "_CHAR_")
      (= value "continue") (String.copy "_CONTINUE_")
      (= value "default") (String.copy "_DEFAULT_")
      (= value "do") (String.copy "_DO_")
      (= value "double") (String.copy "_DOUBLE_")
      (= value "else") (String.copy "_ELSE_")
      (= value "enum") (String.copy "_ENUM_")
      (= value "extern") (String.copy "_EXTERN_")
      (= value "float") (String.copy "_FLOAT_")
      (= value "for") (String.copy "_FOR_")
      (= value "goto") (String.copy "_GOTO_")
      (= value "if") (String.copy "_IF_")
      (= value "int") (String.copy "_INT_")
      (= value "long") (String.copy "_LONG_")
      (= value "register") (String.copy "_REGISTER_")
      (= value "return") (String.copy "_RETURN_")
      (= value "short") (String.copy "_SHORT_")
      (= value "signed") (String.copy "_SIGNED_")
      (= value "sizeof") (String.copy "_SIZEOF_")
      (= value "static") (String.copy "_STATIC_")
      (= value "struct") (String.copy "_STRUCT_")
      (= value "switch") (String.copy "_SWITCH_")
      (= value "typedef") (String.copy "_TYPEDEF_")
      (= value "union") (String.copy "_UNION_")
      (= value "unsigned") (String.copy "_UNSIGNED_")
      (= value "volatile") (String.copy "_VOLATILE_")
      (= value "void") (String.copy "_VOID_")
      (= value "while") (String.copy "_WHILE_")
      (String.copy value)))

  (defn runtime-component [value]
    (let-do [buffer (StringBuf.create)
             characters (String.chars value)
             n (Array.length &characters)]
      (for [i 0 n]
        (append-runtime-character! &buffer @(Array.unsafe-nth &characters i)))
      (escape-c-keyword &(StringBuf.into-string buffer))))

  (doc runtime-symbol "maps a qualified source name to the stable C symbol
used by Carp's existing runtime headers.")
  (defn runtime-symbol [value]
    (let-do [buffer (StringBuf.create)
             components (String.split-by value &[\.])
             n (Array.length &components)]
      (for [i 0 n]
        (do
          (when (Int.> i 0) (StringBuf.append-char &buffer \_))
          (StringBuf.append-str &buffer
                                &(runtime-component (Array.unsafe-nth &components
                                                                      i)))))
      (StringBuf.into-string buffer)))

  (doc component "encodes a source-level name injectively into C-identifier
characters. Underscores and punctuation are escaped by Unicode code point.")
  (defn component [value]
    (let-do [buffer (StringBuf.create)
             characters (String.chars value)
             n (Array.length &characters)]
      (for [i 0 n]
        (let [character @(Array.unsafe-nth &characters i)]
          (if (ascii-alphanumeric? character)
            (StringBuf.append-char &buffer character)
            (do
              (StringBuf.append-str &buffer "_x")
              (StringBuf.append-str &buffer &(Int.str (Char.to-int character)))
              (StringBuf.append-char &buffer \_)))))
      (StringBuf.into-string buffer)))

  (private framed)
  (hidden framed)
  (defn framed [value]
    (String.concat &[(Int.str (String.length value)) @"_" (String.copy value)]))

  (private arguments-key)
  (hidden arguments-key)
  (private type-key-internal)
  (hidden type-key-internal)
  (defn arguments-key [arguments]
    (let-do [buffer (StringBuf.create)
             n (Array.length arguments)]
      (for [i 0 n]
        (let [key (type-key-internal (Box.peek (Array.unsafe-nth arguments i)))]
          (StringBuf.append-str &buffer &(framed &key))))
      (StringBuf.into-string buffer)))

  (defn type-key-internal [type]
    (match-ref type
      (MonoType.Variable variable)
        (String.concat &[@"V" (Int.str @variable) @"_"])
      (MonoType.Integer) (String.copy "I")
      (MonoType.String) (String.copy "S")
      (MonoType.Boolean) (String.copy "B")
      (MonoType.Unit) (String.copy "U")
      (MonoType.Named name arguments)
        (let [encoded-name (component name)
              encoded-arguments (arguments-key arguments)]
          (String.concat
            &[@"N"
              (framed &encoded-name)
              (Int.str (Array.length arguments))
              @"_"
              encoded-arguments]))
      (MonoType.Reference inner _)
        (let [key (type-key-internal (Box.peek inner))]
          (String.concat &[@"R" (framed &key)]))
      (MonoType.Function arguments result)
        (let [encoded-arguments (arguments-key arguments)
              result-key (type-key-internal (Box.peek result))]
          (String.concat
            &[@"F"
              (Int.str (Array.length arguments))
              @"_"
              encoded-arguments
              @"Z"
              (framed &result-key)]))))

  (doc type-key "returns the structural, identifier-safe ABI key for a type.")
  (defn type-key [type] (type-key-internal type))

  (doc generic-key "the key a nominal application has with its arguments
generalized away: `(Box Int)` and `(Box String)` both key as `(Box a)` does.
A declaration written once for every instance of a type — core's
`(sig delete (Fn [(Box a)] ()))` — is recorded under this key, and an instance
finds it here. Anything else keys as itself.")
  (defn generic-key [type]
    (match-ref type
      (MonoType.Named name arguments)
        (let-do [generalized (the (Array (Box MonoType)) [])]
          (for [i 0 (Array.length arguments)]
            (Array.push-back! &generalized (Box.init (MonoType.Variable 0))))
          (type-key-internal &(MonoType.Named (String.copy name) generalized)))
      _ (type-key-internal type)))

  (doc mangle "returns a collision-resistant generated C symbol.")
  (defn mangle [name signature]
    (let [encoded-name (component name)
          encoded-type (type-key signature)]
      (String.concat &[@"C" (framed &encoded-name) @"__" encoded-type])))

  (doc nominal-name "returns the concrete C name for a nominal type
application, spelled the way the reference does (TypesToC): the mangled type
name, `__`, then its arguments joined by `_`. `(Box Int)` is `Box__int`,
`(Pair Int String)` is `Pair__int_String`. This spelling is ABI rather than
an internal choice — core's own C templates name instances directly
(`Box__$a` in `Box.from-ptr`), so an instance the reference calls `Box__int`
has to carry that name here too.")
  (doc nominal-symbol "renders a nominal type's C name the way the reference
does (TypesToC): module dots removed and segments concatenated, then mangled
by SymPath's rules, so `Pattern.MatchResult` becomes `PatternMatchResult` —
the name the runtime headers use for externally registered module types.")
  (defn nominal-symbol [name]
    (runtime-component &(String.join "" &(String.split-by name &[\.]))))

  (private render-arguments)
  (hidden render-arguments)
  (private function-name)
  (hidden function-name)
  (private render-type-internal)
  (hidden render-type-internal)

  (sig nominal-name
       (Fn [(Ref String) (Ref (Array (Box MonoType)))] (Result String CAbiError)))
  (defn nominal-name [name arguments]
    (if (Int.= 0 (Array.length arguments))
      (Result.Success (nominal-symbol name))
      (match (render-arguments arguments)
        (Result.Success rendered)
          (Result.Success
            (String.concat &[(nominal-symbol name) @"__" rendered]))
        (Result.Error error) (Result.Error error))))

  (doc render-arguments "renders type arguments in name position, joined by
`_`, the way the reference joins them in `tyToCManglePtr`.")
  (sig render-arguments
       (Fn [(Ref (Array (Box MonoType)))] (Result String CAbiError)))
  (defn render-arguments [arguments]
    (let-do [failure (the (Maybe CAbiError) (Maybe.Nothing))
             buffer (StringBuf.create)
             n (Array.length arguments)]
      (for [i 0 n]
        (when (Maybe.nothing? &failure)
          (match (render-type-internal
              (Box.peek (Array.unsafe-nth arguments i))
              true)
            (Result.Success rendered)
              (do
                (when (Int.> i 0) (StringBuf.append-char &buffer \_))
                (StringBuf.append-str &buffer &rendered))
            (Result.Error error) (set! failure (Maybe.Just error)))))
      (match failure
        (Maybe.Nothing) (Result.Success (StringBuf.into-string buffer))
        (Maybe.Just error) (Result.Error error))))

  (doc function-name "spells a function type in name position. A C type
position renders every function as `Lambda`, but a name has to keep the
signature: the reference writes `Fn__int_bool` there.")
  (sig function-name
       (Fn
         [(Ref (Array (Box MonoType))) (Ref (Box MonoType))]
         (Result String CAbiError)))
  (defn function-name [arguments result]
    (match (render-arguments arguments)
      (Result.Success rendered-arguments)
        (match (render-type-internal (Box.peek result) true)
          (Result.Success rendered-result)
            (Result.Success
              (String.concat &[@"Fn__" rendered-arguments @"_" rendered-result]))
          (Result.Error error) (Result.Error error))
      (Result.Error error) (Result.Error error)))

  (doc unmanaged-scalar? "returns true for scalar values whose C
representation does not require ownership or lifetime lowering.")
  (defn unmanaged-scalar? [type]
    (match-ref type
      (MonoType.Integer) true
      (MonoType.Boolean) true
      (MonoType.Unit) true
      (MonoType.Named name arguments)
        (and (Int.= 0 (Array.length arguments))
             (or (= name "Byte")
                 (or (= name "Long")
                     (or (= name "Float")
                         (or (= name "Double")
                             (or (= name "Char") (= name "CChar")))))))
      _ false))

  (private pointer-like)
  (hidden pointer-like)
  (private pointer-suffix)
  (hidden pointer-suffix)
  (doc pointer-suffix "a pointer is a star in a type position and `_MUL_` in a
name, which is SymPath's mangling of the same star.")
  (defn pointer-suffix [in-name?]
    (if in-name? (String.copy "_MUL_") (String.copy "*")))

  (sig pointer-like
       (Fn
         [(Ref String) (Ref (Array (Box MonoType))) Bool]
         (Result String CAbiError)))
  (defn pointer-like [name arguments in-name?]
    (if (Int.= 1 (Array.length arguments))
      (match (render-type-internal
          (Box.peek (Array.unsafe-nth arguments 0))
          in-name?)
        (Result.Success rendered)
          (Result.Success (String.append &rendered &(pointer-suffix in-name?)))
        (Result.Error error) (Result.Error error))
      (Result.Error
        (CAbiError.init
          (String.concat &[(String.copy name) @" expects one type argument"])))))

  (doc render-type-internal "renders a type, in a C type position or — with
`in-name?` — inside another type's name. The two differ exactly where the
reference's `tyToCManglePtr` takes its boolean: pointers mangle, functions
keep their signature, and the runtime container structs keep their element.")
  (sig render-type-internal (Fn [(Ref MonoType) Bool] (Result String CAbiError)))
  (defn render-type-internal [type in-name?]
    (match-ref type
      (MonoType.Variable _)
        (Result.Error (CAbiError.init @"cannot render an inference variable"))
      (MonoType.Integer) (Result.Success (String.copy "int"))
      (MonoType.String) (Result.Success (String.copy "String"))
      (MonoType.Boolean) (Result.Success (String.copy "bool"))
      (MonoType.Unit) (Result.Success (String.copy "void"))
      (MonoType.Named name arguments)
        (cond
          (= name "Ptr")
          (pointer-like name arguments in-name?)
          ;; `Array` and `StaticArray` share the runtime `Array` struct (only
          ;; ownership differs, which is not a C-representation concern), so a
          ;; type position renders that struct. A name cannot drop the
          ;; element: `(Box (Array Int))` and `(Box (Array String))` are
          ;; different structs, and the reference keeps them apart by spelling
          ;; the element out.
          (and (not in-name?) (or (= name "Array") (= name "StaticArray")))
          (Result.Success (String.copy "Array"))
          (= name "Byte")
          (Result.Success (String.copy "uint8_t"))
          (= name "Long")
          (Result.Success (String.copy "Long"))
          (= name "Float")
          (Result.Success (String.copy "float"))
          (= name "Double")
          (Result.Success (String.copy "double"))
          (= name "Char")
          (Result.Success (String.copy "Char"))
          (= name "CChar")
          (Result.Success (String.copy "CChar"))
          (= name "Pattern")
          (Result.Success (String.copy "Pattern"))
          (nominal-name name arguments))
      (MonoType.Reference inner _)
        (match (render-type-internal (Box.peek inner) in-name?)
          (Result.Success rendered)
            (Result.Success (String.append &rendered &(pointer-suffix in-name?)))
          (Result.Error error) (Result.Error error))
      (MonoType.Function arguments result)
        (if in-name?
          (function-name arguments result)
          (Result.Success (String.copy "Lambda")))))

  (doc render-type "renders the concrete C ABI representation of a type.")
  (defn render-type [type] (render-type-internal type false)))
