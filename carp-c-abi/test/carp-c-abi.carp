(load "../carp-c-abi.carp")
(Project.no-echo)
(load "Test.carp")

(use-all Test)

(defn distinct-source-names-remain-distinct? []
  (/= &(CAbi.component "foo-bar") &(CAbi.component "foo_bar")))

(defn generated-identifiers-are-ascii? []
  (and
    (= &(CAbi.component "føø") "f_x248__x248_")
    (= &(CAbi.identifier "føø") "f__")))

(defn runtime-symbols-match-existing-abi? []
  (and
    (= &(CAbi.runtime-symbol "Int.+") "Int__PLUS_")
    (and
      (=
        &(CAbi.runtime-symbol "Int.bit-shift-left")
        "Int_bit_MINUS_shift_MINUS_left")
      (and
        (=
          &(CAbi.runtime-symbol "Debug.log-memory-balance!")
          "Debug_log_MINUS_memory_MINUS_balance_BANG_")
        (and (= &(CAbi.runtime-symbol "int") "_INT_")
             (and (= &(CAbi.runtime-symbol "extern") "_EXTERN_")
                  (and (= &(CAbi.runtime-symbol "for") "_FOR_")
                       (/= &(CAbi.runtime-symbol "Int.*") &(CAbi.runtime-symbol "Int./")))))))))

(defn function-keys-encode-arity? []
  (let [unary (Type.function [(Box.init (Type.integer))] (Type.integer))
        binary (Type.function
          [(Box.init (Type.integer)) (Box.init (Type.integer))]
          (Type.integer))]
    (/= &(CAbi.type-key &unary) &(CAbi.type-key &binary))))

(defn renders-container-and-function-types? []
  (let [box-ref (Type.reference
          (Type.named "Box" [(Box.init (Type.integer))])
          (Type.lifetime 0))
        function (Type.function [(Box.init (Type.integer))] (Type.integer))]
    (and
      (= &(Result.from-success (CAbi.render-type &box-ref) @"") "Box__int*")
      (= &(Result.from-success (CAbi.render-type &function) @"") "Lambda"))))

(defn classifies-and-renders-unmanaged-scalars? []
  (let [byte (Type.named "Byte" [])
        float (Type.named "Float" [])
        string (Type.string)]
    (and (CAbi.unmanaged-scalar? &byte)
         (and (CAbi.unmanaged-scalar? &float)
              (and (not (CAbi.unmanaged-scalar? &string))
                   (and
                     (=
                       &(Result.from-success (CAbi.render-type &byte) @"")
                       "uint8_t")
                     (=
                       &(Result.from-success (CAbi.render-type &float) @"")
                       "float")))))))

(defn parameterized-nominal-names-are-structural? []
  (let [choice-int (Type.named "Choice" [(Box.init (Type.integer))])
        choice-bool (Type.named "Choice" [(Box.init (Type.boolean))])
        source-underscore (Type.named "Choice_Int" [])]
    (and
      (/=
        &(Result.from-success (CAbi.render-type &choice-int) @"")
        &(Result.from-success (CAbi.render-type &choice-bool) @""))
      (/=
        &(Result.from-success (CAbi.render-type &choice-int) @"")
        &(Result.from-success (CAbi.render-type &source-underscore) @"")))))

(deftest t
  (assert-true t
    (distinct-source-names-remain-distinct?)
    "ABI source-name encoding is collision-resistant")
  (assert-true t
    (generated-identifiers-are-ascii?)
    "ABI identifiers contain only ASCII C-identifier characters")
  (assert-true t
    (runtime-symbols-match-existing-abi?)
    "ABI runtime symbols match existing Carp headers without collisions")
  (assert-true t
    (function-keys-encode-arity?)
    "ABI type keys encode function structure")
  (assert-true t
    (renders-container-and-function-types?)
    "ABI type rendering covers pointer-like and callable types")
  (assert-true t
    (classifies-and-renders-unmanaged-scalars?)
    "ABI identifies and renders unmanaged scalar types")
  (assert-true t
    (parameterized-nominal-names-are-structural?)
    "ABI names parameterized nominals structurally"))
