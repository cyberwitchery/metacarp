(load "../carp-c-abi.carp")
(Project.no-echo)
(load "Test.carp")
(use-all Test)

(defn symbol-table []
  (let [key (CAbi.type-key &(Type.integer))]
    [(Pair.init (String.copy &key) @"first")
     (Pair.init @"unrelated" @"other")
     (Pair.init (String.copy &key) @"last-name")]))

(deftest t
  (assert-true t
    (String.=
      &(Maybe.from
        (CAbi.symbol-for-key &(symbol-table) &(CAbi.type-key &(Type.integer)))
        @"missing")
      "last-name")
    "native symbol lookup uses the last exact key and preserves its spelling")
  (assert-true t
    (let [symbols (symbol-table)
          integer (Type.integer)
          reference (Type.reference (Type.integer) (Type.lifetime 0))]
      (and
        (String.=
          &(Maybe.from (CAbi.symbol-for-type &symbols &integer) @"")
          "last-name")
        (Maybe.nothing? &(CAbi.symbol-for-type &symbols &reference))))
    "typed native symbol lookup uses the complete ABI type key")
  (assert-true t
    (and
      (Maybe.nothing?
        &(CAbi.symbol-for-key &(the (Array (Pair String String)) []) "key"))
      (Maybe.nothing? &(CAbi.symbol-for-key &(symbol-table) "missing")))
    "empty tables and missing keys have no native symbol"))
