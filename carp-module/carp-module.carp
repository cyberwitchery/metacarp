(load "../carp-surface/carp-surface.carp")

(doc ModuleSource "is a source the module loader can load. `path` is the
name load directives use for it. `file` is the file the text came from, or
`path` for a source held in memory. While the source is expanded,
`current-file` and `relative-to` resolve against `file`. `text` is the source
text.")
(deftype ModuleSource [path String
                       file String
                       text String])

(doc ModuleError "is an error from loading modules. `message` describes it.
`path` is the path that was being loaded. `span` is the source location of the
error. The loader does not set it.")
(deftype ModuleError [message String
                      path String
                      span (Maybe SurfaceSpan)])

(defmodule ModuleLoader
  (private symbol-name)
  (hidden symbol-name)
  (defn symbol-name [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.Symbol segments)
        (if (Int.= 1 (Array.length segments))
          (Maybe.Just @(Array.unsafe-nth segments 0))
          (Maybe.Nothing))
      _ (Maybe.Nothing)))

  (private named?)
  (hidden named?)
  (defn named? [node name]
    (match (symbol-name node)
      (Maybe.Just found) (= found name)
      (Maybe.Nothing) false))

  (private contains?)
  (hidden contains?)
  (defn contains? [paths path]
    (let-do [found false
             n (Array.length paths)]
      (for [i 0 n] (when (= (Array.unsafe-nth paths i) path) (set! found true)))
      found))

  (private source-by-path)
  (hidden source-by-path)
  (defn source-by-path [sources path]
    (let-do [result (Maybe.Nothing)
             n (Array.length sources)]
      (for [i 0 n]
        (let [source (Array.unsafe-nth sources i)]
          (when (= (ModuleSource.path source) path)
            (set! result (Maybe.Just @source)))))
      result))

  (doc file-load-target "returns the registry key for `(load path file)`. If
`path` is a git reference (it contains `@`), the key is `path` and `file`
separated by a space. Otherwise `file` is ignored and the key is `path`.")
  (defn file-load-target [path file]
    (if (Int.> (String.index-of path \@) -1)
      (String.concat &[@path @" " @file])
      @path))

  (private load-target)
  (hidden load-target)
  (defn load-target [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List items)
        (if (or (Int.= 2 (Array.length items)) (Int.= 3 (Array.length items)))
          (let [head (Box.peek (Array.unsafe-nth items 0))
                target (Box.peek (Array.unsafe-nth items 1))]
            (if (or (named? head @"load") (named? head @"load-once"))
              (match-ref (SurfaceNode.form target)
                ; a two-element `(load "core/X")` is keyed as `X`, the key
                ; core files are loaded under
                (SurfaceForm.StringLit path)
                (if (Int.= 3 (Array.length items))
                  (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth items
                                                                           2)))
                    (SurfaceForm.StringLit file)
                      (Maybe.Just (file-load-target path file))
                    _ (Maybe.Nothing))
                  (Maybe.Just
                    (if (String.starts-with? path "core/")
                      (String.suffix path 5)
                      @path)))
                _
                (Maybe.Nothing))
              (Maybe.Nothing)))
          (Maybe.Nothing))
      _ (Maybe.Nothing)))

  ;; `(load-and-use Mod)` loads "Mod.carp" and then uses the module; this returns
  ;; the bare module name (the file is that name plus ".carp").
  (private load-and-use-target)
  (hidden load-and-use-target)
  (defn load-and-use-target [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List items)
        (if (Int.= 2 (Array.length items))
          (if (named? (Box.peek (Array.unsafe-nth items 0)) @"load-and-use")
            (symbol-name (Box.peek (Array.unsafe-nth items 1)))
            (Maybe.Nothing))
          (Maybe.Nothing))
      _ (Maybe.Nothing)))

  (private use-node)
  (hidden use-node)
  (defn use-node [node module-name]
    (let [span @(SurfaceNode.span node)]
      (SurfaceNode.generated @&span
                             (SurfaceForm.List
                               [(Box.init
                                  (SurfaceNode.generated @&span
                                                         (SurfaceForm.Symbol [@"use-all"])))
                                (Box.init
                                  (SurfaceNode.generated @&span
                                                         (SurfaceForm.Symbol [@module-name])))]))))

  (private zero-span)
  (hidden zero-span)
  (defn zero-span [] (SurfaceSpan.at (Info.init 0 1 1) (Info.init 0 1 1)))

  ;; a synthetic `(Unsafe.load-stack-push! "<file>")` / `(Unsafe.load-stack-pop!)`
  ;; form bracketing a spliced file's forms; the expander maintains the
  ;; compile-time load stack from these and drops them.
  (private load-stack-marker)
  (hidden load-stack-marker)
  (defn load-stack-marker [command file]
    (let-do [span (zero-span)
             items [(Box.init
                      (SurfaceNode.generated @&span
                                             (SurfaceForm.Symbol [@"Unsafe"
                                                                  (String.copy command)])))]]
      (match-ref file
        (Maybe.Just path)
          (Array.push-back! &items
                            (Box.init
                              (SurfaceNode.generated @&span
                                                     (SurfaceForm.StringLit @path))))
        (Maybe.Nothing) ())
      (SurfaceNode.generated span (SurfaceForm.List items))))

  (private load-path!)
  (hidden load-path!)
  (sig load-path!
       (Fn
         [(Ref (Array ModuleSource))
          (Ref String)
          (Ref (Array String))
          (Ref (Array String))
          (Ref (Array (Box SurfaceNode)))]
         (Result Unit ModuleError)))
  ; loads `path` and everything it loads into `output`, each file once. files
  ; are compared by their `file` strings as given, so each file needs one
  ; canonical name. `visited` and `output` are shared by the whole load.
  (defn load-path! [sources path active visited output]
    (match (source-by-path sources path)
      (Maybe.Nothing)
        (Result.Error
          (ModuleError.init @"module source not found" @path (Maybe.Nothing)))
      (Maybe.Just source)
        (let [file (ModuleSource.file &source)]
          (cond
            (contains? active file)
            (Result.Error
              (ModuleError.init @"recursive module load" @path (Maybe.Nothing)))
            (contains? visited file)
            (Result.Success ())
            ; spans record `file` as their source, see `Surface.parse-in`
            (match (Surface.parse-in file (ModuleSource.text &source))
              (Result.Error parse-error)
                (Result.Error
                  (ModuleError.init
                    (String.concat
                      &[(String.copy file)
                        @": "
                        (Parser.format-error &parse-error)])
                    @path
                    (Maybe.Nothing)))
              (Result.Success module)
                (let-do [push-marker (load-stack-marker "load-stack-push!"
                                                        &(Maybe.Just @(ModuleSource.file &source)))
                         result (the (Result Unit ModuleError)
                                     (Result.Success ()))
                         next-active (Array.push-back @active (String.copy file))
                         forms (SurfaceModule.forms &module)
                         n (Array.length forms)]
                  (Array.push-back! output (Box.init push-marker))
                  (for [i 0 n]
                    (match-ref &result
                      (Result.Success _)
                        (let [form (Box.peek (Array.unsafe-nth forms i))]
                          (match (load-and-use-target form)
                            (Maybe.Just module-name)
                              (let [child-path (String.concat &[@&module-name
                                                                @".carp"])]
                                (match (the (Result Unit ModuleError)
                                            (load-path! sources
                                                        &child-path
                                                        &next-active
                                                        visited
                                                        output))
                                  (Result.Success _)
                                    (Array.push-back! output
                                                      (Box.init (use-node form
                                                                          &module-name)))
                                  (Result.Error error)
                                    (set! result (Result.Error error))))
                            (Maybe.Nothing)
                              (match (load-target form)
                                (Maybe.Just child-path)
                                  (match (the (Result Unit ModuleError)
                                              (load-path! sources
                                                          &child-path
                                                          &next-active
                                                          visited
                                                          output))
                                    (Result.Success _) ()
                                    (Result.Error error)
                                      (set! result (Result.Error error)))
                                (Maybe.Nothing)
                                  (Array.push-back! output
                                                    (Box.init (SurfaceNode.copy form))))))
                      (Result.Error error) (set! result (Result.Error @error))))
                  (match result
                    (Result.Success _)
                      (do
                        (Array.push-back! output
                                          (Box.init
                                            (load-stack-marker "load-stack-pop!"
                                                               &(the (Maybe String)
                                                                     (Maybe.Nothing)))))
                        (Array.push-back! visited (String.copy file))
                        (Result.Success ()))
                    (Result.Error error) (Result.Error error))))))))

  (doc compiler-prelude-forms "returns generic `prefix` and `suffix`
definitions built on `slice` and `length`. The reference compiler resolves
Pattern's bare `suffix` call by the type of its receiver. This compiler cannot,
so it supplies these.")
  (defn compiler-prelude-forms []
    (match (Surface.parse "(defn prefix [xs a] (slice xs 0 a))
(defn suffix [xs b] (slice xs b (length xs)))") (Result.Success m)
        @(SurfaceModule.forms &m) (Result.Error _)
        (the (Array (Box SurfaceNode)) [])))

  (doc load "loads `root` from `sources`. Load directives are replaced by the
forms of the files they load, in source order, and each file is included once.
Fails on a missing source, a recursive load or a parse error.")
  (defn load [sources root]
    (let-do [active (the (Array String) [])
             visited (the (Array String) [])
             forms (the (Array (Box SurfaceNode)) [])]
      (match (the (Result Unit ModuleError)
                  (load-path! sources root &active &visited &forms))
        (Result.Success _) (Result.Success (SurfaceModule.init forms))
        (Result.Error error) (Result.Error error))))

  (doc with-compiler-prelude "returns `module` with the forms of
`compiler-prelude-forms` appended. `load` does not add them.")
  (defn with-compiler-prelude [module]
    (let-do [forms @(SurfaceModule.forms module)
             prelude (compiler-prelude-forms)]
      (for [i 0 (Array.length &prelude)]
        (Array.push-back! &forms @(Array.unsafe-nth &prelude i)))
      (SurfaceModule.init forms))))
