(load "../carp-module.carp")
(load "../../carp-expand/carp-expand.carp")
(Project.no-echo)

(defn node-at [module index]
  (SurfaceNode.copy
    (Box.peek (Array.unsafe-nth (SurfaceModule.forms module) index))))

(defn is-symbol? [node expected]
  (match-ref (SurfaceNode.form node)
    (SurfaceForm.List items)
      (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth items 0)))
        (SurfaceForm.Symbol segments)
          (and (Int.= 1 (Array.length segments))
               (= (Array.unsafe-nth segments 0) expected))
        _ false)
    _ false))

(defn loads-in-source-order? []
  (let [sources [(ModuleSource.init (String.copy "root")
                                    (String.copy "(load \"macros\")
(when true 7)"))
                 (ModuleSource.init (String.copy "macros")
                                    (String.copy "(defmacro when [c b] `(if %c %b ()))"))]
        root (String.copy "root")
        module (Result.from-success (ModuleLoader.load &sources &root)
                                    (SurfaceModule.init []))
        first (node-at &module 0)
        second (node-at &module 1)]
    (and
      (Int.= 2 (Array.length (SurfaceModule.forms &module)))
      (and (is-symbol? &first "defmacro") (is-symbol? &second "when")))))

(defn rejects-cycles? []
  (let [sources [(ModuleSource.init (String.copy "a")
                                    (String.copy "(load \"b\")"))
                 (ModuleSource.init (String.copy "b")
                                    (String.copy "(load \"a\")"))]
        root (String.copy "a")]
    (Result.error? &(ModuleLoader.load &sources &root))))

(defn loaded-macros-expand? []
  (let [sources [(ModuleSource.init (String.copy "root")
                                    (String.copy "(load \"macros\")
(when true 7)"))
                 (ModuleSource.init (String.copy "macros")
                                    (String.copy "(defmacro when [c b] `(if %c %b ()))"))]
        root (String.copy "root")
        module (Result.from-success (ModuleLoader.load &sources &root)
                                    (SurfaceModule.init []))
        expanded (Result.from-success (MacroExpand.expand-module &module)
                                      (SurfaceModule.init []))
        form (node-at &expanded 0)]
    (is-symbol? &form "if")))

(defn main []
  (if (and (loads-in-source-order?)
           (and (rejects-cycles?) (loaded-macros-expand?)))
    0
    1))
