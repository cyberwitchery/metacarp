(load "../carp-module.carp")
(load "../../carp-expand/carp-expand.carp")
(Project.no-echo)

(defn node-at [module index]
  (SurfaceNode.copy
    (Box.peek (Array.unsafe-nth (SurfaceModule.forms module) index))))

(defn is-symbol? [node expected]
  (match-ref (SurfaceNode.form node)
    (SurfaceForm.List items)
      (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth items 0)))
        (SurfaceForm.Symbol segments)
          (and (Int.= 1 (Array.length segments))
               (= (Array.unsafe-nth segments 0) expected))
        _ false)
    _ false))

(defn is-int? [node expected]
  (match-ref (SurfaceNode.form node)
    (SurfaceForm.IntLit value) (Int.= @value expected)
    _ false))

(defn loads-in-source-order? []
  (let [sources [(ModuleSource.init (String.copy "root")
                                    (String.copy "root")
                                    (String.copy "(load \"macros\")
(loaded-id 7)"))
                 (ModuleSource.init (String.copy "macros")
                                    (String.copy "macros")
                                    (String.copy "(defmacro loaded-id [x] x)"))]
        root (String.copy "root")]
    (match (ModuleLoader.load &sources &root)
      (Result.Success module)
        (let [forms (SurfaceModule.forms &module)]
          ;; root push, child push, child form, child pop, root form, root pop
          (if (Int.= 6 (Array.length forms))
            (let [first (node-at &module 2)
                  second (node-at &module 4)]
              (and (is-symbol? &first "defmacro")
                   (is-symbol? &second "loaded-id")))
            false))
      (Result.Error _) false)))

(defn rejects-cycles? []
  (let [sources [(ModuleSource.init (String.copy "a")
                                    (String.copy "a")
                                    (String.copy "(load \"b\")"))
                 (ModuleSource.init (String.copy "b")
                                    (String.copy "b")
                                    (String.copy "(load \"a\")"))]
        root (String.copy "a")]
    (Result.error? &(ModuleLoader.load &sources &root))))

(defn loaded-macros-expand? []
  (let [sources [(ModuleSource.init (String.copy "root")
                                    (String.copy "root")
                                    (String.copy "(load \"macros\")
(loaded-id 7)"))
                 (ModuleSource.init (String.copy "macros")
                                    (String.copy "macros")
                                    (String.copy "(defmacro loaded-id [x] x)"))]
        root (String.copy "root")]
    (match (ModuleLoader.load &sources &root)
      (Result.Success module)
        (match (MacroExpand.expand-module &module)
          (Result.Success expanded)
            (if (Int.> (Array.length (SurfaceModule.forms &expanded)) 0)
              (let-do [form (node-at &expanded 0)
                       correct (is-int? &form 7)]
                (unless correct (IO.errorln &(Surface.render-module &expanded)))
                correct)
              false)
          (Result.Error _) false)
      (Result.Error _) false)))

(defn main []
  (let-do [ordered (loads-in-source-order?)
           cycles (rejects-cycles?)
           macros (loaded-macros-expand?)]
    (unless ordered (IO.errorln "module load order test failed"))
    (unless cycles (IO.errorln "module cycle test failed"))
    (unless macros (IO.errorln "loaded macro expansion test failed"))
    (if (and ordered (and cycles macros)) 0 1)))
