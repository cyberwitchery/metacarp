(load "driver.carp")
(Project.config "title" "carp-compiler")
(Project.no-echo)
; The compile-time evaluator needs a large main stack. Pages commit lazily.
(when (= (host-os) "darwin") (add-cflag "-Wl,-stack_size,0x20000000"))

; this driver has no LLVM backend, so the reference can build it
(defn no-llvm [-input -core-dir -output -action -no-core -log-memory -debug]
  (do (IO.errorln "carp-compiler: --emit llvm needs metacarp") 2))

(defn main [] (compiler-main 1 "carp-compiler" no-llvm))
