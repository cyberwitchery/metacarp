         [(Ref (Array (Box SurfaceNode))) (Ref (Array CtShapeBinding)) Int Int]
         (Array Int)))
  (sig quoted-container
       (Fn
         [(Ref SurfaceNode)
          (Ref (Array (Box SurfaceNode)))
