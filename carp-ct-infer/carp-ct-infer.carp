  ;; ------------------------------------------------------- summary lookup

  (private exact-definition-index)
  (hidden exact-definition-index)
  (defn exact-definition-index [name]
    (let-do [found (Maybe.Nothing)
             n (Array.length &*ct-definitions*)]
      (for [i 0 n]
        (let [entry (Array.unsafe-nth &*ct-definitions* i)]
          (when (and (Maybe.nothing? &found) (= (CtDefinition.name entry) name))
            (set! found (Maybe.Just i)))))
      found))

  (doc known-definition-index "where the definition a name resolves to is
stored, resolved the way the evaluator resolves it: by the name as written.")
  (defn known-definition-index [name] (exact-definition-index name))

  (private summary-result-at)
  (hidden summary-result-at)
  (defn summary-result-at [index]
    @(CtSummary.result (Array.unsafe-nth &*ct-summaries* index)))

  (private summary-domain-at)
  (hidden summary-domain-at)
  (defn summary-domain-at [index position]
    (let [domain (CtSummary.domain (Array.unsafe-nth &*ct-summaries* index))]
      (if (Int.< position (Array.length domain))
        @(Array.unsafe-nth domain position)
        (CtShape.top))))

  (private summary-domain-array)
  (hidden summary-domain-array)
  (defn summary-domain-array [index]
    @(CtSummary.domain (Array.unsafe-nth &*ct-summaries* index)))

  (doc summary-usable? "whether the summary at `index` may be believed. A
macro’s may not: its parameters bind unevaluated syntax and its result is
evaluated again, so a summary derived as though it were a function would be a
claim about the wrong program.")
  (defn summary-usable? [index]
    (and *ct-summaries-enabled*
         (and
           (Int.< index (Array.length &*ct-summaries*))
           (not
             @(CtDefinition.macro? (Array.unsafe-nth &*ct-definitions* index))))))

  (private note-assist!)
  (hidden note-assist!)
  (defn note-assist! [shape]
    (when (and (not *ct-quiet*) (not (CtShape.equal? shape (CtShape.top))))
      (set! *ct-summary-assists* (Int.inc *ct-summary-assists*))))

  (doc call-range "the shape a call answers with: the builtin table first,
because the evaluator tries a builtin before it looks a name up, and otherwise
the summary of the function the name resolves to.")
  (defn call-range [name]
    (let [builtin (builtin-range name)]
      (if (or (not (CtShape.equal? builtin (CtShape.top))) (builtin? name))
        builtin
        (match (known-definition-index name)
          (Maybe.Nothing) builtin
          (Maybe.Just index)
            (if (summary-usable? index)
              (let-do [answer (summary-result-at index)]
                (note-assist! answer)
                answer)
              builtin)))))

  (doc call-domain "the shape an argument must meet: the builtin table first,
for the same reason, and otherwise the domain the callee’s body forces on that
parameter.")
  (defn call-domain [name index]
    (let [builtin (builtin-domain name index)]
      (if (or (not (CtShape.equal? builtin (CtShape.top))) (builtin? name))
        builtin
        (match (known-definition-index name)
          (Maybe.Nothing) builtin
          (Maybe.Just found)
            (if (summary-usable? found)
              (let-do [answer (summary-domain-at found index)]
                (note-assist! answer)
                answer)
              builtin)))))

  ;; the spine scanner is one mutually recursive group, like the walker. It
  ;; visits only what the body is certain to evaluate, which is what a domain
  ;; may be derived from: a constraint read off a branch would reject a call
  ;; that never takes it.
  (private scan-spine)
  (hidden scan-spine)
  (private scan-spine-each)
  (hidden scan-spine-each)
  (private scan-spine-let)
  (hidden scan-spine-let)
  (private scan-spine-for)
  (hidden scan-spine-for)
  (private scan-spine-call)
  (hidden scan-spine-call)

  (sig scan-spine
       (Fn [(Ref SurfaceNode) (Ref (Array String)) (Ref (Array Int))] Bool))
  (sig scan-spine-each
       (Fn
         [(Ref (Array (Box SurfaceNode)))
          Int
          (Ref (Array String))
          (Ref (Array Int))]
         Bool))
  (sig scan-spine-let
       (Fn
         [(Ref (Array (Box SurfaceNode))) (Ref (Array String)) (Ref (Array Int))]
         Bool))
  (sig scan-spine-for
       (Fn
         [(Ref (Array (Box SurfaceNode))) (Ref (Array String)) (Ref (Array Int))]
         Bool))
  (sig scan-spine-call
       (Fn
         [(Ref (Array (Box SurfaceNode)))
          (Ref (Array String))
          (Ref (Array Int))
          (Ref String)]
         Bool))

  (private parameter-names)
  (hidden parameter-names)
  (defn parameter-names [node]
    (let-do [names (the (Array String) [])
             items (items-of node)]
      (for [i 0 (Array.length &items)]
        (match (symbol-key (Box.peek (Array.unsafe-nth &items i)))
          (Maybe.Just name) (set! names (Array.push-back names name))
          (Maybe.Nothing) ()))
      names))

  (doc check "walks a node and returns its shape, recording a finding for
every provable contradiction it meets. `quasi` is the quasiquotation depth:
at depth zero a form is code, above zero it is data and only `unquote` and
`unquote-splicing` return to code.")
  (defn check [node env quasi]
    (if (Int.> quasi 0)
      (check-quoted node env quasi)
      ;; `node-kind` already classifies every variant, so the walk dispatches on
      ;; the tag rather than re-matching the form. Container children are copied
      ;; out before recursing: branches of one `match-ref` share a lifetime, and
      ;; passing a borrow from one branch into a call does not survive that.
      (let [kind (node-kind node)]
        (cond
          (CtShape.equal? kind (CtShape.leaf (CtShape.i-symbol)))
            (match (symbol-key node)
              (Maybe.Just name)
                (match (lookup env &name)
                  (Maybe.Just shape) shape
                  (Maybe.Nothing) (CtShape.top))
              (Maybe.Nothing) (CtShape.top))
          (CtShape.equal? kind (CtShape.leaf (CtShape.i-list)))
            (let [items (items-of node)] (check-list node &items env))
          (or
            (CtShape.equal? kind (CtShape.leaf (CtShape.i-array)))
            (or
              (CtShape.equal? kind (CtShape.leaf (CtShape.i-static-array)))
              (CtShape.equal? kind (CtShape.leaf (CtShape.i-dictionary)))))
            (let-do [items (items-of node)
                     elements (the (Array Int) [])]
              (for [i 0 (Array.length &items)]
                (set! elements
                      (Array.push-back elements
                                       (check (Box.peek (Array.unsafe-nth &items
                                                                          i))
                                              env
                                              0))))
              (CtShape.container-of (container-index node) &elements))
          kind))))

  (defn check-each [items env from]
    (for [i from (Array.length items)]
      (ignore (check (Box.peek (Array.unsafe-nth items i)) env 0))))

  (defn check-quoted [node env quasi]
    (let [kind (node-kind node)]
      (cond
        (CtShape.equal? kind (CtShape.leaf (CtShape.i-list)))
          (let [items (items-of node)
                n (Array.length &items)]
            (if (Int.= 0 n)
              kind
              (match (head-key &items)
                (Maybe.Just name)
                  (cond
                    ;; back to code, one level out
                    (and
                      (or (= &name "unquote") (= &name "unquote-splicing"))
                      (Int.= 2 n))
                    (check (Box.peek (Array.unsafe-nth &items 1))
                           env
                           (Int.dec quasi))
                    ;; a nested quasiquote needs one more unquote to escape
                    (= &name "quasiquote")
                    ;; annotated for the reference compiler; see scan-spine's
                    ;; macro-error arm
                    (let-do [inner (the (Array Int)
                                        (quote-each &items env (Int.inc quasi) 1))]
                      (ignore inner)
                      kind)
                    (quoted-container node &items env quasi))
                (Maybe.Nothing) (quoted-container node &items env quasi))))
        (or
          (CtShape.equal? kind (CtShape.leaf (CtShape.i-array)))
          (or
            (CtShape.equal? kind (CtShape.leaf (CtShape.i-static-array)))
            (CtShape.equal? kind (CtShape.leaf (CtShape.i-dictionary)))))
          (let [items (items-of node)] (quoted-container node &items env quasi))
        kind)))

  (doc quoted-container "the shape of a quoted container: its tag, holding what
its children are.

A splice is the one case this cannot do. `unquote-splicing` inserts elements
rather than one element, so the length and the order of what follows are not
known here, and the container falls back to saying only what kind it is.")
  (defn quoted-container [node items env quasi]
    (let-do [elements (quote-each items env quasi 0)
             spliced false]
      (for [i 0 (Array.length items)]
        (let [child (Box.peek (Array.unsafe-nth items i))]
          (when (CtShape.equal? (node-kind child)
                                (CtShape.leaf (CtShape.i-list)))
            (let [inner (items-of child)]
              (match (head-key &inner)
                (Maybe.Just head)
                  (when (= &head "unquote-splicing") (set! spliced true))
                (Maybe.Nothing) ())))))
      (if spliced
        ;; what is written before the splice is there whatever the splice turns
        ;; out to be, so the prefix is kept and the rest is any number of forms
        (CtShape.chain-of (container-index node)
                          &(prefix-before-splice items &elements)
                          (CtShape.every-of (container-index node) (CtShape.top)))
        (CtShape.container-of (container-index node) &elements))))

  (private prefix-before-splice)
  (hidden prefix-before-splice)
  (defn prefix-before-splice [items elements]
    (let-do [out (the (Array Int) [])
             stop false]
      (for [i 0 (Array.length items)]
        (let [child (Box.peek (Array.unsafe-nth items i))]
          (unless-do stop
            (when (CtShape.equal? (node-kind child)
                                  (CtShape.leaf (CtShape.i-list)))
              (let [inner (items-of child)]
                (match (head-key &inner)
                  (Maybe.Just head)
                    (when (= &head "unquote-splicing") (set! stop true))
                  (Maybe.Nothing) ())))
            (unless stop
              (when (Int.< i (Array.length elements))
                (set! out (Array.push-back out @(Array.unsafe-nth elements i))))))))
      out))

  (defn quote-each [items env quasi from]
    (let-do [elements (the (Array Int) [])]
      (for [i from (Array.length items)]
        (set! elements
              (Array.push-back elements
                               (check-quoted (Box.peek (Array.unsafe-nth items i))
                                             env
                                             quasi))))
      elements))

  (defn check-list [node items env]
    (let [n (Array.length items)]
      (if (Int.= 0 n)
        (CtShape.leaf (CtShape.i-list))
        (match (head-key items)
          (Maybe.Nothing)
          ;; a computed callee: it still has to be able to be called
          (let-do [callee (check (Box.peek (Array.unsafe-nth items 0)) env 0)]
            (when (and (not (CtShape.bottom? callee))
                       (CtShape.bottom?
                         (CtShape.intersection callee (CtShape.callable))))
              (record! node
                       @"callee"
                       (fmt
                         "applied a value of shape %s, which can never be callable"
                         &(CtShape.render callee))))
            (check-each items env 1)
            (CtShape.top))
          (Maybe.Just name)
          (check-call node items env &name)))))

  (defn check-call [node items env name]
    (let [n (Array.length items)]
      (cond
        (= name "quote")
        (if (Int.> n 1)
          (data-shape (Box.peek (Array.unsafe-nth items 1)))
          (CtShape.top))
        (= name "quasiquote")
        (if (Int.> n 1)
          (check-quoted (Box.peek (Array.unsafe-nth items 1)) env 1)
          (CtShape.top))
        (= name "if")
        (check-if node items env)
        (or (= name "when") (= name "unless"))
        (let-do [condition (if (Int.> n 1)
                   (Box.peek (Array.unsafe-nth items 1))
                   (Box.peek (Array.unsafe-nth items 0)))]
          (when (Int.> n 1) (ignore (check condition env 0)))
          (let-do [inner (if (Int.> n 1)
                     (narrow env condition (= name "when"))
                     @env)]
            (check-each items &inner 2)
            (CtShape.top)))
        (= name "do")
        (check-do items env 1)
        (or (= name "let") (= name "let-do"))
        (check-let items env)
        (or (= name "fn") (= name "λ"))
        (check-lambda items env)
        (= name "cond")
        (check-cond items env)
        (= name "case")
        (do (check-each items env 1) (CtShape.top))
        ;; `and` and `or` short-circuit and answer with an operand rather than
        ;; with a Bool: `(or false 7)` is 7. So the result is the union of the
        ;; operands, and every operand but the last is tested and must be a
        ;; Bool. `not` is an ordinary call and falls through to the argument
        ;; check below, which is where its own Bool domain applies.
        (or (= name "and") (= name "or"))
        (check-short-circuit items env name)
        (or (= name "while") (= name "set!"))
        (do (check-each items env 1) (CtShape.top))
        (= name "for")
        (let-do [inner @env]
          (when (Int.> n 1)
            (let [names (parameter-names (Box.peek (Array.unsafe-nth items 1)))]
              (when (Int.> (Array.length &names) 0)
                (set! inner
                      (bind &inner
                            (Array.unsafe-nth &names 0)
                            (CtShape.leaf (CtShape.i-int-lit)))))))
          (check-each items &inner 2)
          (CtShape.top))
        (= name "macro-error")
        (do (check-each items env 1) (CtShape.bottom))
        (definition-form? name)
        ;; a definition nested inside a body is not an expression the shape
        ;; pass models; its subforms are still walked so findings inside are
        ;; not lost
        (do (check-each items env 1) (CtShape.top))
        ;; `list` and `array` build a container out of their arguments, so what
        ;; the container holds is what the arguments are. Without this a
        ;; constraint on the elements has nothing to bite on: every constructed
        ;; list would be merely a list
        (Int.>= (construction-index name) 0)
        (check-construction items env name)
        ;; a local holding a function: what it takes and answers is in its own
        ;; shape, so the call is checked against that rather than against a table
        ;; that has nothing to say about a binding
        (local-function? env name)
        (check-local-call items env name)
        ;; an ordinary call
        (do
          (check-arguments items env name)
          (check-arity node items name)
          (call-range name)))))

  (defn check-short-circuit [items env name]
    (let-do [result (CtShape.bottom)
             n (Array.length items)
             boolean (CtShape.leaf (CtShape.i-bool-lit))]
      (for [i 1 n]
        (let-do [operand (Box.peek (Array.unsafe-nth items i))
                 shape (check operand env 0)]
          (when (and (Int.< i (Int.dec n))
                     (and (not (CtShape.bottom? shape))
                          (CtShape.bottom? (CtShape.intersection shape boolean))))
            (record! operand
                     @"shape"
                     (fmt
                       "%s tests argument %d, which is %s and so can never be Bool"
                       name
                       (Int.dec i)
                       &(CtShape.render shape))))
          (set! result (CtShape.union result shape))))
      (if (CtShape.bottom? result) (CtShape.top) result)))

  (doc shape-of-source "the shape the walker gives the first form of a source
string, in an empty environment. Exposed so that a harness can compare the
walker's answer for an arbitrary expression against what the evaluator
actually returns, which is the only way to check the result shapes of forms
the walker handles itself rather than through the builtin table.")
  (defn shape-of-source [source]
    (match (Surface.parse source)
      (Result.Error _) (CtShape.top)
      (Result.Success module)
        (let [forms (SurfaceModule.forms &module)]
          (if (Int.= 0 (Array.length forms))
            (CtShape.top)
            (let [empty (the (Array CtShapeBinding) [])]
              (check (Box.peek (Array.unsafe-nth forms 0)) &empty 0))))))

  (defn check-do [items env from]
    (let-do [result (CtShape.top)
             n (Array.length items)]
      (for [i from n]
        (set! result (check (Box.peek (Array.unsafe-nth items i)) env 0)))
      result))

  (defn check-if [node items env]
    (let [n (Array.length items)]
      (if (Int.< n 3)
        (do (check-each items env 1) (CtShape.top))
        (let [condition (Box.peek (Array.unsafe-nth items 1))
              _ (check condition env 0)
              then-env (narrow env condition true)
              else-env (narrow env condition false)
              then-shape (check (Box.peek (Array.unsafe-nth items 2))
                                &then-env
                                0)]
          (if (Int.> n 3)
            (CtShape.union then-shape
                           (check (Box.peek (Array.unsafe-nth items 3))
                                  &else-env
                                  0))
            (CtShape.union then-shape (CtShape.top)))))))

  (defn check-cond [items env]
    (let-do [n (Array.length items)
             result (CtShape.bottom)
             running @env
             i 1]
      (while (Int.< i n)
        (if (Int.= i (Int.dec n))
          ;; a trailing form with no test is the default branch
          (do
            (set! result
                  (CtShape.union result
                                 (check (Box.peek (Array.unsafe-nth items i))
                                        &running
                                        0)))
            (set! i (Int.inc i)))
          (let-do [condition (Box.peek (Array.unsafe-nth items i))
                   _ (check condition &running 0)
                   taken (narrow &running condition true)]
            (set! result
                  (CtShape.union result
                                 (check
                                   (Box.peek (Array.unsafe-nth items (Int.inc i)))
                                   &taken
                                   0)))
            ;; later clauses only run when this test failed
            (set! running (narrow &running condition false))
            (set! i (Int.+ i 2)))))
      (if (CtShape.bottom? result) (CtShape.top) result)))

  (defn check-let [items env]
    (let-do [n (Array.length items)
             inner @env]
      (when (Int.> n 1)
        (let-do [bindings (items-of (Box.peek (Array.unsafe-nth items 1)))
                 b 0
                 bn (Array.length &bindings)]
          (while (Int.< (Int.inc b) bn)
            (let-do [value (check
                       (Box.peek (Array.unsafe-nth &bindings (Int.inc b)))
                       &inner
                       0)]
              (match (symbol-key (Box.peek (Array.unsafe-nth &bindings b)))
                (Maybe.Just name) (set! inner (bind &inner &name value))
                (Maybe.Nothing) ())
              (set! b (Int.+ b 2))))))
      (check-do items &inner 2)))

  (doc check-argument!
    "records what one argument position means: the coverage it
adds, and the contradiction if there is one. Both kinds of callee come through
here, so a call to a local function reads the same as a call to a builtin.")
  (defn check-argument! [argument actual index name required]
    (do
      (unless *ct-quiet*
        (set! *ct-argument-positions* (Int.inc *ct-argument-positions*)))
      (when-do (and (not *ct-quiet*)
                    (not (CtShape.equal? required (CtShape.top))))
        (set! *ct-constrained-positions* (Int.inc *ct-constrained-positions*))
        (unless (CtShape.equal? actual (CtShape.top))
          (set! *ct-decided-positions* (Int.inc *ct-decided-positions*)))
        (when *ct-explain*
          (Array.push-back! &*ct-observations*
                            (CtObservation.init @&*ct-current-definition*
                                                (node-line argument)
                                                @name
                                                (fmt "argument %d" index)
                                                actual
                                                required))))
      ;; ⊥ on the left is Lemma 4.12 case (a): unreachable code relates to
      ;; anything, so it is never a contradiction
      (when (and (not (CtShape.bottom? actual))
                 (CtShape.bottom? (CtShape.intersection actual required)))
        (record! argument
                 @"shape"
                 (fmt
                   "%s argument %d is %s, which can never be %s"
                   name
                   index
                   &(CtShape.render actual)
                   &(CtShape.render required))))))

  (doc construction-index "the container tag a builtin builds, or -1 when it
builds nothing.")
  (defn construction-index [name]
    (match (dynamic-key name)
      (Maybe.Nothing) -1
      (Maybe.Just n)
        (cond (= &n "list") (CtShape.i-list) (= &n "array") (CtShape.i-array) -1)))

  (doc check-construction "checks the arguments of a container constructor and
answers with the container holding them.")
  (defn check-construction [items env name]
    (let-do [n (Array.length items)
             elements (the (Array Int) [])]
      (for [i 1 n]
        (let-do [argument (Box.peek (Array.unsafe-nth items i))
                 actual (check argument env 0)
                 at (Int.dec i)]
          (check-argument! argument actual at name (call-domain name at))
          (set! elements (Array.push-back elements actual))))
      (CtShape.container-of (construction-index name) &elements)))

  (doc check-lambda "the shape of a lambda: a function from the shapes its body
forces on its parameters to the shape its body answers with.

The domains are read off the spine, the same rule a definition's are: a use the
body might not reach says nothing about the argument. On a backend without arrows
this is `Closure` and everything below it is dropped.")
  (defn check-lambda [items env]
    (let-do [n (Array.length items)
             names (if (Int.> n 1)
               (parameter-names (Box.peek (Array.unsafe-nth items 1)))
               (the (Array String) []))
             unconstrained (CtShape.top)
             domains (Array.replicate (Array.length &names) &unconstrained)
             inner @env]
      (let-do [reached (the Bool (scan-spine-each items 2 &names &domains))]
        (ignore reached))
      ;; a parameter required to be two disjoint things at once makes the lambda
      ;; uncallable, which is a claim about the lambda and not about a call to it
      (for [i 0 (Array.length &domains)]
        (when-do (CtShape.bottom? @(Array.unsafe-nth &domains i))
          (set! *ct-summary-contradictory* (Int.inc *ct-summary-contradictory*))
          (Array.aset! &domains i (CtShape.top))))
      (for [i 0 (Array.length &names)]
        (set! inner
              (bind &inner
                    (Array.unsafe-nth &names i)
                    @(Array.unsafe-nth &domains i))))
      (CtShape.closure-of &domains (check-do items &inner 2))))

  (doc local-function?
    "whether a name is a local binding whose shape says what it
takes. A builtin wins over a binding, so one of those is never this.")
  (defn local-function? [env name]
    (if (builtin? name)
      false
      (match (lookup env name)
        (Maybe.Nothing) false
        (Maybe.Just shape) (CtShape.closure? shape))))

  (doc check-local-call
    "checks a call to a local function against its own domain,
and answers with its codomain.")
  (defn check-local-call [items env name]
    (let-do [callee (match (lookup env name)
               (Maybe.Just shape) shape
               (Maybe.Nothing) (CtShape.top))
             n (Array.length items)]
      (for [i 1 n]
        (let-do [argument (Box.peek (Array.unsafe-nth items i))
                 actual (check argument env 0)
                 index (Int.dec i)]
          (check-argument! argument
                           actual
                           index
                           name
                           (CtShape.closure-domain callee index))))
      (CtShape.closure-result callee)))

  (defn check-arguments [items env name]
    ;; a compile-time definition the program wrote wins over a builtin of the
    ;; same spelling, because that is what the name resolves to when the body
    ;; runs. Constraining `(length m)` as the builtin inside a module that
    ;; defines its own `length` is how a checker rejects correct code.
    (let [n (Array.length items)]
      (for [i 1 n]
        (let-do [argument (Box.peek (Array.unsafe-nth items i))
                 actual (check argument env 0)
                 index (Int.dec i)]
          (check-argument! argument actual index name (call-domain name index))))))

  (private exact-definition)
  (hidden exact-definition)
  (defn exact-definition [name]
    (let-do [found (Maybe.Nothing)
             n (Array.length &*ct-definitions*)]
      (for [i 0 n]
        (let [entry (Array.unsafe-nth &*ct-definitions* i)]
          (when (and (Maybe.nothing? &found) (= (CtDefinition.name entry) name))
            (set! found (Maybe.Just @entry)))))
      found))

  (doc known-definition "resolves a name the way the evaluator resolves it: by
the name as written, against the definitions registered under that exact path.

A bare name inside a module does NOT mean that module's definition. The body of
a `defndynamic` is evaluated in the lexical environment it was written in plus
the global one, and the module's own bindings live under their qualified paths,
so an unqualified call reaches the top-level definition and the module's is
reachable only qualified. That is why library code writes its own recursion out
in full: `OrderedTree.put` calls `(OrderedTree.put …)`, and `(length (car t))`
beside it means the builtin.

Verified against the reference evaluator on 2026-09-12: with a global `pick` of
two arguments and an `M.pick` of one, `(M.pick 7)` answers 7, which is the global
one. Assuming the other precedence made this pass reject a correct call in
`carpentry-org/match-utils`, which is the defect this note replaces.")
  (defn known-definition [name] (exact-definition name))

  (doc builtin? "whether the compile-time evaluator answers to this name
itself.

This decides two things, and gets them from the evaluator rather than from
taste. `carp-ct-eval` tries `apply-builtin` on a call's head *before* it looks
the head up in the environment, so a builtin wins over a compile-time
definition that shares its spelling: inside `(defmodule Map ...)`, `(length m)`
is the builtin `length`, not a `Map.length` the module defined. So a name in
this list keeps its domain no matter what the program defines, and is never
arity-checked against a definition that cannot receive the call.")
  (defn builtin? [name]
    (match (dynamic-key name)
      (Maybe.Just n)
        (one-of? &n
                 &[@"*"
                   @"+"
                   @"-"
                   @"/"
                   @"<"
                   @"="
                   @">"
                   @"String.append"
                   @"String.char-at"
                   @"String.concat"
                   @"String.empty?"
                   @"String.head"
                   @"String.index-of"
                   @"String.length"
                   @"String.prefix"
                   @"String.slice"
                   @"String.suffix"
                   @"String.tail"
                   @"String.to-array"
                   @"String.to-list"
                   @"Symbol.concat"
                   @"Symbol.from"
                   @"Symbol.prefix"
                   @"Unsafe.load-stack"
                   @"all-but-last"
                   @"and"
                   @"append"
                   @"apply"
                   @"array"
                   @"array?"
                   @"caadr"
                   @"cadddr"
                   @"caddr"
                   @"cadr"
                   @"car"
                   @"case"
                   @"cdadr"
                   @"cddr"
                   @"cdr"
                   @"column"
                   @"concat"
                   @"cond"
                   @"cons"
                   @"cons-last"
                   @"def"
                   @"def-"
                   @"definterface"
                   @"defmodule"
                   @"defn"
                   @"defn-"
                   @"deftemplate"
                   @"deftype"
                   @"do"
                   @"dynamic-type"
                   @"empty?"
                   @"eval"
                   @"expand"
                   @"file"
                   @"fn"
                   @"for"
                   @"hash"
                   @"if"
                   @"last"
                   @"length"
                   @"let"
                   @"let-do"
                   @"line"
                   @"list"
                   @"list?"
                   @"macro-error"
                   @"macro-log"
                   @"managed?"
                   @"members"
                   @"meta"
                   @"not"
                   @"or"
                   @"parse"
                   @"quote"
                   @"read-file"
                   @"register"
                   @"round"
                   @"s-expr"
                   @"set!"
                   @"str"
                   @"type"
                   @"use"
                   @"when"
                   @"while"
                   @"with-test-internal"])
      (Maybe.Nothing)
        (one-of? name
                 &[@"*"
                   @"+"
                   @"-"
                   @"/"
                   @"<"
                   @"="
                   @">"
                   @"String.append"
                   @"String.char-at"
                   @"String.concat"
                   @"String.empty?"
                   @"String.head"
                   @"String.index-of"
                   @"String.length"
                   @"String.prefix"
                   @"String.slice"
                   @"String.suffix"
                   @"String.tail"
                   @"String.to-array"
                   @"String.to-list"
                   @"Symbol.concat"
                   @"Symbol.from"
                   @"Symbol.prefix"
                   @"Unsafe.load-stack"
                   @"all-but-last"
                   @"and"
                   @"append"
                   @"apply"
                   @"array"
                   @"array?"
                   @"caadr"
                   @"cadddr"
                   @"caddr"
                   @"cadr"
                   @"car"
                   @"case"
                   @"cdadr"
                   @"cddr"
                   @"cdr"
                   @"column"
                   @"concat"
                   @"cond"
                   @"cons"
                   @"cons-last"
                   @"def"
                   @"def-"
                   @"definterface"
                   @"defmodule"
                   @"defn"
                   @"defn-"
                   @"deftemplate"
                   @"deftype"
                   @"do"
                   @"dynamic-type"
                   @"empty?"
                   @"eval"
                   @"expand"
                   @"file"
                   @"fn"
                   @"for"
                   @"hash"
                   @"if"
                   @"last"
                   @"length"
                   @"let"
                   @"let-do"
                   @"line"
                   @"list"
                   @"list?"
                   @"macro-error"
                   @"macro-log"
                   @"managed?"
                   @"members"
                   @"meta"
                   @"not"
                   @"or"
                   @"parse"
                   @"quote"
                   @"read-file"
                   @"register"
                   @"round"
                   @"s-expr"
                   @"set!"
                   @"str"
                   @"type"
                   @"use"
                   @"when"
                   @"while"
                   @"with-test-internal"])))

  (defn check-arity [node items name]
    (let [supplied (Int.dec (Array.length items))]
      ;; a call whose head the evaluator handles itself never reaches a
      ;; compile-time definition, so it cannot be checked against one
      (unless (builtin? name)
        (match (known-definition name)
          (Maybe.Nothing) ()
          (Maybe.Just definition)
            (let [expected @(CtDefinition.arity &definition)]
              (when (if @(CtDefinition.rest? &definition)
                  (Int.< supplied expected)
                  (Int./= supplied expected))
                (record! node
                         @"arity"
                         (fmt
                           "%s takes %d argument(s) but is given %d"
                           name
                           expected
                           supplied))))))))

  ;; ------------------------------------------------------------ definitions

  (private rest-marker?)
  (hidden rest-marker?)
  (defn rest-marker? [name] (String.starts-with? name ":"))

  (doc special-form-minimum "how many forms a special form has to hold at the
least, or 0 where this makes no claim.

A minimum is the part of a form's grammar that cannot drift: a form with too few
children is malformed in any version of the expander, while what may follow the
ones required is where the variadic subtleties live. So this says only that, and
`carp-expand` stays the one place that knows the rest.")
  (defn special-form-minimum [name]
    (cond
      (= name "if") 3
      (= name "set!") 3
      (= name "def") 3
      (= name "defn") 4
      (= name "let") 3
      (= name "while") 3
      0))

  (doc check-emitted! "checks the syntax a macro answers with.

This is a claim about the macro's output rather than about the macro as a
program, and it is deliberately the narrowest one available: the form has to
start with a known special form, its length has to be fixed — a splice makes it
unknown and nothing is claimed — and it has to be shorter than that form can ever
be.")
  (defn check-emitted! [node shape]
    (match (CtShape.head-spelling shape)
      (Maybe.Nothing) ()
      (Maybe.Just head)
        (let [minimum (special-form-minimum &head)
              length (CtShape.form-length shape)]
          (when (and (Int.> minimum 0)
                     (and (Int.>= length 0) (Int.< length minimum)))
            (record! node
                     @"syntax"
                     (fmt
                       "emits (%s …) holding %d form(s), and %s is never well formed with fewer than %d"
                       &head
                       length
                       &head
                       minimum))))))

  (doc check-definition "checks one `defmacro` or `defndynamic` body under an
environment holding its parameters.")
  (defn check-definition [items macro?]
    (let-do [n (Array.length items)
             env (the (Array CtShapeBinding) [])
             seen-rest false]
      (when (Int.> n 2)
        (let-do [names (parameter-names (Box.peek (Array.unsafe-nth items 2)))
                 parameter-shape (if (and macro? *ct-precise-macro-parameters*)
                   (CtShape.syntax)
                   (CtShape.top))]
          (for [i 0 (Array.length &names)]
            (let [name (Array.unsafe-nth &names i)]
              (if (rest-marker? name)
                (set! seen-rest true)
                (set! env
                      (bind &env
                            name
                            (if seen-rest (CtShape.listy) parameter-shape))))))))
      (let-do [constrained-before *ct-constrained-positions*
               decided-before *ct-decided-positions*
               answered (check-do items &env 3)]
        ;; a macro's body answers with the syntax it emits, and that syntax has to
        ;; be something the expander can take
        (when macro?
          (check-emitted! (Box.peek (Array.unsafe-nth items 0)) answered))
        (when (Int.> *ct-constrained-positions* constrained-before)
          (set! *ct-definitions-constrained*
                (Int.inc *ct-definitions-constrained*)))
        (when (Int.> *ct-decided-positions* decided-before)
          (set! *ct-definitions-decided* (Int.inc *ct-definitions-decided*))))))

  (private definition-of)
  (hidden definition-of)
  (defn definition-of [items macro?]
    (let-do [names (if (Int.> (Array.length items) 2)
               (parameter-names (Box.peek (Array.unsafe-nth items 2)))
               (the (Array String) []))
             fixed 0
             rest? false]
      (for [i 0 (Array.length &names)]
        (let [name (Array.unsafe-nth &names i)]
          (if (rest-marker? name)
            (set! rest? true)
            (unless rest? (set! fixed (Int.inc fixed))))))
      (CtDefinition.init @"" fixed rest? macro?)))

  ;; ---------------------------------------------------------- summaries

  (private position-of)
  (hidden position-of)
  (defn position-of [names name]
    (let-do [found (Maybe.Nothing)
             n (Array.length names)]
      (for [i 0 n]
        (when (and (Maybe.nothing? &found) (= (Array.unsafe-nth names i) name))
          (set! found (Maybe.Just i))))
      found))

  (private hide)
  (hidden hide)
  (doc hide "a parameter list with one name struck out. A local binding that
shadows a parameter hides it: a use below the binding is a use of the local and
says nothing about the argument.")
  (defn hide [name names]
    (let-do [kept (the (Array String) [])
             n (Array.length names)]
      (for [i 0 n]
        (let [candidate (Array.unsafe-nth names i)]
          (set! kept
                (Array.push-back kept (if (= candidate name) @"" @candidate)))))
      kept))

  (private stored-items)
  (hidden stored-items)
  (defn stored-items [index]
    (items-of (Box.peek (Array.unsafe-nth &*ct-bodies* index))))

  (private stored-head)
  (hidden stored-head)
  (defn stored-head [index]
    (let [items (stored-items index)]
      (match (head-key &items) (Maybe.Just name) name (Maybe.Nothing) @"")))

  (private fixed-parameters)
  (hidden fixed-parameters)
  (doc fixed-parameters "the names bound positionally, in order. The rest
parameter and anything after it is left out: an argument’s position in a rest
list is not its position in the call.")
  (defn fixed-parameters [items]
    (let-do [names (if (Int.> (Array.length items) 2)
               (parameter-names (Box.peek (Array.unsafe-nth items 2)))
               (the (Array String) []))
             kept (the (Array String) [])
             stop false]
      (for [i 0 (Array.length &names)]
        (let [name (Array.unsafe-nth &names i)]
          (if (rest-marker? name)
            (set! stop true)
            (unless stop (set! kept (Array.push-back kept @name))))))
      kept))

  (private defers-arguments?)
  (hidden defers-arguments?)
  (doc defers-arguments? "whether a builtin takes its arguments unevaluated. A
use inside one is not a use: the syntax may never run.")
  (defn defers-arguments? [name]
    (match (dynamic-key name)
      (Maybe.Nothing) false
      (Maybe.Just n) (one-of? &n &[@"with-test-internal"])))

  (private macro-call?)
  (hidden macro-call?)
  (defn macro-call? [name]
    (if (builtin? name)
      false
      (match (known-definition-index name)
        (Maybe.Nothing) false
        (Maybe.Just index)
          @(CtDefinition.macro? (Array.unsafe-nth &*ct-definitions* index)))))

  (private constrain-argument!)
  (hidden constrain-argument!)
  (doc constrain-argument! "records what a call forces on a parameter passed
to it bare. Only a bare symbol is recorded: `(car (f x))` constrains what `f`
answers with, not `x`.")
  (defn constrain-argument! [argument name index params domains]
    (match (symbol-key argument)
      (Maybe.Nothing) ()
      (Maybe.Just spelling)
        (match (position-of params &spelling)
          (Maybe.Nothing) ()
          (Maybe.Just position)
            (let [required (call-domain name index)]
              (unless (CtShape.equal? required (CtShape.top))
                (let-do [current @(Array.unsafe-nth domains position)
                         refined (CtShape.intersection current required)]
                  (Array.aset! domains position refined)))))))

  (doc scan-spine "walks the part of a form that is certain to be evaluated,
intersecting into `domains` what each call forces on a parameter it receives
bare. Answers whether evaluation can reach past this form: a form that can
only answer ⊥ ends the sequence it sits in, and a use after it says nothing,
because it is never reached.")
  (defn scan-spine [node params domains]
    (if (not (CtShape.equal? (node-kind node) (CtShape.leaf (CtShape.i-list))))
      true
      (let [items (items-of node)]
        (if (Int.= 0 (Array.length &items))
          true
          (match (head-key &items)
            ;; a computed head: the head and every argument are evaluated
            (Maybe.Nothing)
            (scan-spine-each &items 0 params domains)
            (Maybe.Just name)
            (cond
              ;; quoted syntax is data, and an unquote inside it is code the
              ;; expansion runs, not code this body runs
              (or (= &name "quote") (= &name "quasiquote"))
              true
              ;; only the test of a conditional is certain to run. `cond`
              ;; always runs its first test; `case` always evaluates its
              ;; subject
              (or (= &name "if")
                  (or (= &name "when")
                      (or (= &name "unless")
                          (or (= &name "cond")
                              (or (= &name "case") (= &name "while"))))))
              (if (Int.> (Array.length &items) 1)
                (scan-spine (Box.peek (Array.unsafe-nth &items 1))
                            params
                            domains)
                true)
              ;; a short circuit runs its first operand and decides the rest
              (or (= &name "and") (= &name "or"))
              (if (Int.> (Array.length &items) 1)
                (scan-spine (Box.peek (Array.unsafe-nth &items 1))
                            params
                            domains)
                true)
              (= &name "do")
              (scan-spine-each &items 1 params domains)
              (or (= &name "let") (= &name "let-do"))
              (scan-spine-let &items params domains)
              ;; a lambda body runs when the lambda is called, which may be
              ;; never and is in any case not here
              (or (= &name "fn") (= &name "λ"))
              true
              (= &name "for")
              (scan-spine-for &items params domains)
              (= &name "set!")
              (if (Int.> (Array.length &items) 2)
                (scan-spine (Box.peek (Array.unsafe-nth &items 2))
                            params
                            domains)
                true)
              (= &name "macro-error")
              ;; the annotation is for the reference compiler, which cannot
              ;; infer `ignore`'s binding type for this call and fails emit with
              ;; an unresolved generic in Macros.carp; metacarp types it fine
              (let-do [reached (the Bool
                                    (scan-spine-each &items 1 params domains))]
                (ignore reached)
                false)
              ;; a definition is not an expression this body evaluates
              (definition-form? &name)
              true
              ;; a special form the scanner does not model says nothing,
              ;; rather than being read as a call whose arguments all run
              (special-form? &name)
              true
              (scan-spine-call &items params domains &name)))))))

  (defn scan-spine-each [items from params domains]
    (let-do [n (Array.length items)
             continues true
             i from]
      (while-do (and continues (Int.< i n))
        (set! continues
              (scan-spine (Box.peek (Array.unsafe-nth items i)) params domains))
        (set! i (Int.inc i)))
      continues))

  (defn scan-spine-let [items params domains]
    (let-do [n (Array.length items)
             visible @params
             continues true]
      (when (Int.> n 1)
        (let-do [bindings (items-of (Box.peek (Array.unsafe-nth items 1)))
                 bn (Array.length &bindings)
                 b 0]
          (while-do (and continues (Int.< (Int.inc b) bn))
            (set! continues
                  (scan-spine
                    (Box.peek (Array.unsafe-nth &bindings (Int.inc b)))
                    &visible
                    domains))
            (match (symbol-key (Box.peek (Array.unsafe-nth &bindings b)))
              (Maybe.Just bound) (set! visible (hide &bound &visible))
              (Maybe.Nothing) ())
            (set! b (Int.+ b 2)))))
      (if continues (scan-spine-each items 2 &visible domains) false)))

  (defn scan-spine-for [items params domains]
    ;; the bounds are evaluated once before the loop; the body may run zero
    ;; times
    (if (Int.> (Array.length items) 1)
      (let [bindings (items-of (Box.peek (Array.unsafe-nth items 1)))]
        (scan-spine-each &bindings 1 params domains))
      true))

  (defn scan-spine-call [items params domains name]
    (if (or (defers-arguments? name) (macro-call? name))
      true
      (let-do [n (Array.length items)
               continues true]
        ;; applicative order: every argument is evaluated before the call
        (for [i 1 n]
          (let-do [argument (Box.peek (Array.unsafe-nth items i))]
            (constrain-argument! argument name (Int.dec i) params domains)
            (unless (scan-spine argument params domains) (set! continues false))))
        (and continues (not (CtShape.bottom? (call-range name)))))))

  (private collect-callees)
  (hidden collect-callees)
  (doc collect-callees "every compile-time definition a body mentions in head
position, conditional or not. The graph is only used to find the cycles, so it
over-approximates on purpose.")
  (defn collect-callees [node out]
    (let-do [items (items-of node)]
      (when (CtShape.equal? (node-kind node) (CtShape.leaf (CtShape.i-list)))
        (match (head-key &items)
          (Maybe.Nothing) ()
          (Maybe.Just name)
            (unless (builtin? &name)
              (match (known-definition-index &name)
                (Maybe.Just callee) (Array.push-back! out callee)
                (Maybe.Nothing) ()))))
      (for [i 0 (Array.length &items)]
        (collect-callees (Box.peek (Array.unsafe-nth &items i)) out))))

  (private dependency-order)
  (hidden dependency-order)
  (doc dependency-order "the definitions ordered callees first, cycles kept
together. Summaries derived in this order reach a fixed point in one pass
wherever the call graph is acyclic.")
  (defn dependency-order []
    (let-do [n (Array.length &*ct-definitions*)
             edges (the (Array (Array Int)) [])
             order (the (Array Int) [])]
      (for [i 0 n]
        (let-do [row (the (Array Int) [])]
          (set! *ct-current-module*
                @(Array.unsafe-nth &*ct-definition-modules* i))
          (collect-callees (Box.peek (Array.unsafe-nth &*ct-bodies* i)) &row)
          (set! edges (Array.push-back edges row))))
      (let [components (IntGraph.strong-components &(IntGraph.init edges))]
        (for [c 0 (Array.length &components)]
          (let [component (Array.unsafe-nth &components c)]
            (for [k 0 (Array.length component)]
              (set! order
                    (Array.push-back order @(Array.unsafe-nth component k)))))))
      order))

  (private summarizable?)
  (hidden summarizable?)
  (doc summarizable? "whether a stored definition is a compile-time function.
A macro is not, for the reason `CtSummary` gives; a `defdynamic` is a value
rather than something callable.")
  (defn summarizable? [index]
    (and
      (not @(CtDefinition.macro? (Array.unsafe-nth &*ct-definitions* index)))
      (/= &(stored-head index) "defdynamic")))

  (private compute-domain)
  (hidden compute-domain)
  (doc compute-domain "the shapes the body forces on its parameters, read off
the uses it is certain to reach.")
  (defn compute-domain [index]
    (let-do [items (stored-items index)
             params (fixed-parameters &items)
             count (Array.length &params)
             top (CtShape.top)
             domains (Array.replicate count &top)]
      (set! *ct-current-module*
            @(Array.unsafe-nth &*ct-definition-modules* index))
      (set! *ct-current-definition*
            @(CtDefinition.name (Array.unsafe-nth &*ct-definitions* index)))
      ;; annotated for the reference compiler; see scan-spine's macro-error arm
      (let-do [reached (the Bool (scan-spine-each &items 3 &params &domains))]
        (ignore reached))
      ;; a parameter required to be two disjoint things at once makes the
      ;; function uncallable. That is a claim about the callee, not about any
      ;; call site, and propagating ⊥ would reject every call it has. The pass
      ;; does not report it yet, so the domain is dropped and counted.
      (for [i 0 count]
        (when-do (CtShape.bottom? @(Array.unsafe-nth &domains i))
          (set! *ct-summary-contradictory* (Int.inc *ct-summary-contradictory*))
          (Array.aset! &domains i (CtShape.top))))
      domains))

  (private compute-result)
  (hidden compute-result)
  (doc compute-result "the shape the body answers with, under parameters typed
by the domain its call sites are checked against.

Typing the parameters by the domain is the refinement step: a call passing
something outside it is rejected at the call site, so the body only has to
answer for the arguments that survive.")
  (defn compute-result [index domains]
    (let-do [items (stored-items index)
             params (fixed-parameters &items)
             env (the (Array CtShapeBinding) [])
             names (if (Int.> (Array.length &items) 2)
               (parameter-names (Box.peek (Array.unsafe-nth &items 2)))
               (the (Array String) []))
             seen-rest false]
      (set! *ct-current-module*
            @(Array.unsafe-nth &*ct-definition-modules* index))
      (for [i 0 (Array.length &params)]
        (set! env
              (bind &env
                    (Array.unsafe-nth &params i)
                    @(Array.unsafe-nth domains i))))
      ;; a rest parameter is a sequence, as it is when the body is checked
      (for [i 0 (Array.length &names)]
        (let [name (Array.unsafe-nth &names i)]
          (if (rest-marker? name)
            (set! seen-rest true)
            (when seen-rest (set! env (bind &env name (CtShape.listy)))))))
      (check-do &items &env 3)))

  (private domains-differ?)
  (hidden domains-differ?)
  (doc domains-differ? "whether two domain vectors describe different shapes.
Element-wise, because a shape is not an identity: on the algebra backend two ids
can mean the same thing, and a vector compared by identity would report a change
every round and never converge.")
  (defn domains-differ? [a b]
    (if (Int./= (Array.length a) (Array.length b))
      true
      (let-do [answer false]
        (for [i 0 (Array.length a)]
          (unless (CtShape.equal? @(Array.unsafe-nth a i)
                                  @(Array.unsafe-nth b i))
            (set! answer true)))
        answer)))

  (doc summary-depth "how much structure a summary keeps. A fixed point over
summaries is not guaranteed to converge — a function that wraps its result grows
a level a round — so what it carries is cut off here.")
  (defn summary-depth [] 3)

  (private widened-domain)
  (hidden widened-domain)
  (defn widened-domain [domain]
    (let-do [out (the (Array Int) [])]
      (for [i 0 (Array.length domain)]
        (set! out
              (Array.push-back out
                               (CtShape.widen @(Array.unsafe-nth domain i)
                                              (summary-depth)))))
      out))

  (private refine!)
  (hidden refine!)
  (doc refine! "recomputes one summary, answering whether it moved.")
  (defn refine! [index]
    (let-do [changed false]
      (when (summarizable? index)
        (let-do [before-result (summary-result-at index)
                 before-domain (summary-domain-array index)
                 raw-domain (compute-domain index)
                 domain (widened-domain &raw-domain)
                 result (CtShape.widen (compute-result index &domain)
                                       (summary-depth))]
          (when (or
              (not (CtShape.equal? result before-result))
              (domains-differ? &domain &before-domain))
            (set! changed true))
          (Array.aset! &*ct-summaries* index (CtSummary.init domain result))))
      changed))

  (private tally-summaries!)
  (hidden tally-summaries!)
  (defn tally-summaries! []
    (let-do [n (Array.length &*ct-summaries*)]
      (for [i 0 n]
        (when-do (summarizable? i)
          (set! *ct-summary-functions* (Int.inc *ct-summary-functions*))
          (unless (CtShape.equal? (summary-result-at i) (CtShape.top))
            (set! *ct-summary-results* (Int.inc *ct-summary-results*)))
          (let [domain (summary-domain-array i)]
            (for [k 0 (Array.length &domain)]
              (unless (CtShape.equal? @(Array.unsafe-nth &domain k)
                                      (CtShape.top))
                (set! *ct-summary-domains* (Int.inc *ct-summary-domains*)))))))))

  (doc compute-summaries! "derives a summary for every compile-time function,
callees first, and iterates until nothing moves.

Every summary starts at ⊤, which claims nothing, and every step derives a
summary from summaries that are already sound, so every intermediate state is
sound as well. That is what lets the iteration stop on a round count rather
than on a proof of convergence: stopping early loses precision and nothing
else. Cycles need no special case for the same reason.

Must run after `collect` has seen every module and before anything is
checked.")
  (defn compute-summaries! []
    (let-do [n (Array.length &*ct-definitions*)
             empty-domain (the (Array Int) [])]
      (set! *ct-summaries*
            (Array.replicate n &(CtSummary.init @&empty-domain (CtShape.top))))
      (when (and *ct-summaries-enabled* (Int.> n 0))
        (let-do [order (dependency-order)
                 changed true
                 round 0]
          (set! *ct-quiet* true)
          (while-do (and changed (Int.< round 6))
            (set! changed false)
            (for [k 0 (Array.length &order)]
              (when (refine! @(Array.unsafe-nth &order k)) (set! changed true)))
            (set! round (Int.inc round)))
          (set! *ct-quiet* false)
          (set! *ct-summary-rounds* round)
          (set! *ct-current-module* @"")
          (set! *ct-current-definition* @"")
          (tally-summaries!)))))

  (doc collect "records every compile-time definition in a module, descending
into `defmodule`. A definition is registered under its full path; only a
top-level one is also reachable unqualified.")
  (defn collect [node prefix]
    (let [items (items-of node)]
      (when (Int.> (Array.length &items) 0)
        (match (head-key &items)
          (Maybe.Nothing) ()
          (Maybe.Just head)
            (cond
              (= &head "defmodule")
                (when (Int.> (Array.length &items) 1)
                  (match (symbol-key (Box.peek (Array.unsafe-nth &items 1)))
                    (Maybe.Just module)
                      (let [inner (if (String.empty? prefix)
                              module
                              (String.concat &[@prefix @"." @&module]))]
                        (for [i 2 (Array.length &items)]
                          (collect (Box.peek (Array.unsafe-nth &items i)) &inner)))
                    (Maybe.Nothing) ()))
              (or (= &head "defmacro")
                  (or (= &head "defndynamic") (= &head "defdynamic")))
                (when (Int.> (Array.length &items) 1)
                  (match (symbol-key (Box.peek (Array.unsafe-nth &items 1)))
                    (Maybe.Just short)
                      (let-do [template (definition-of &items
                                                       (= &head "defmacro"))
                               path (if (String.empty? prefix)
                                 @&short
                                 (String.concat &[@prefix @"." @&short]))]
                        (Array.push-back! &*ct-definitions*
                                          (CtDefinition.init path
                                                             @(CtDefinition.arity &template)
                                                             @(CtDefinition.rest? &template)
                                                             @(CtDefinition.macro? &template)))
                        ;; the body and the module it was written in, so the
                        ;; summary pass can walk it without the module tree
                        (Array.push-back! &*ct-bodies* (Box.init @node))
                        (Array.push-back! &*ct-definition-modules* @prefix))
                    (Maybe.Nothing) ()))
              ())))))

  (doc check-module "checks every compile-time definition in one parsed
module. `collect` must have run over every module first, so that calls
between files can be checked for arity.")
  (defn check-module [node prefix]
    (let [items (items-of node)]
      (when (Int.> (Array.length &items) 0)
        (match (head-key &items)
          (Maybe.Nothing) ()
          (Maybe.Just head)
            (cond
              (= &head "defmodule")
                (when (Int.> (Array.length &items) 1)
                  (match (symbol-key (Box.peek (Array.unsafe-nth &items 1)))
                    (Maybe.Just module)
                      (let [inner (if (String.empty? prefix)
                              module
                              (String.concat &[@prefix @"." @&module]))]
                        (for [i 2 (Array.length &items)]
                          (check-module (Box.peek (Array.unsafe-nth &items i))
                                        &inner)))
                    (Maybe.Nothing) ()))
              (or (= &head "defmacro") (= &head "defndynamic"))
                (when (Int.> (Array.length &items) 1)
                  (match (symbol-key (Box.peek (Array.unsafe-nth &items 1)))
                    (Maybe.Just short)
                      (do
                        (set! *ct-current-module* @prefix)
                        (set! *ct-current-definition*
                              (if (String.empty? prefix)
                                @&short
                                (String.concat &[@prefix @"." @&short])))
                        (check-definition &items (= &head "defmacro")))
                    (Maybe.Nothing) ()))
              ())))))

  (doc check-parsed "collects and then checks one parsed module. Callers with
several modules should run `collect` over all of them first, so that calls
between files resolve.")
  (defn check-parsed [module]
    (let-do [forms (SurfaceModule.forms module)]
      (for [i 0 (Array.length forms)]
        (collect (Box.peek (Array.unsafe-nth forms i)) ""))
      (compute-summaries!)
      (for [i 0 (Array.length forms)]
        (check-module (Box.peek (Array.unsafe-nth forms i)) ""))))

  (doc check-source "checks every compile-time definition in one source
string, returning whether it parsed. Findings accumulate in `findings`.")
  (defn check-source [source]
    (match (Surface.parse source)
      (Result.Success module) (do (check-parsed &module) true)
      (Result.Error _) false))

  (doc check-parsed-all "collects every definition across a set of parsed
modules and then checks them all, so that a call from one file into another
resolves. Modules are checked in the order given.")
  (defn check-parsed-all [modules]
    (do
      (for [i 0 (Array.length modules)]
        (let [forms (SurfaceModule.forms (Array.unsafe-nth modules i))]
          (for [f 0 (Array.length forms)]
            (collect (Box.peek (Array.unsafe-nth forms f)) ""))))
      (compute-summaries!)
      (for [i 0 (Array.length modules)]
        (let [forms (SurfaceModule.forms (Array.unsafe-nth modules i))]
          (for [f 0 (Array.length forms)]
            (check-module (Box.peek (Array.unsafe-nth forms f)) "")))))))

(doc CtCheck "the experimental compile-time shape phase.

It is opt-in: nothing in the compiler calls it. A caller hands it parsed
surface modules and gets back either nothing to say or the rejections, in the
same shape the other phases report — a message and the span it belongs to.

The phase is a *checking* phase, like the borrow check rather than like
inference: it produces no type and changes no representation, so a caller that
ignores it loses only the diagnostics. That is what makes it safe to leave
unwired while it is still experimental.")
(defmodule CtCheck
  (doc name "the phase name, for a driver that tags diagnostics by phase.")
  (defn name [] @"ct-shape")

  (doc module "checks one parsed module on its own. Calls between files will
not resolve; use `modules` for a whole program.")
  (defn module [surface]
    (do
      (CtInfer.reset!)
      (CtInfer.check-parsed surface)
      (if (Int.= 0 (Array.length (CtInfer.findings)))
        (Result.Success ())
        (Result.Error @(CtInfer.findings)))))

  (doc modules "checks a whole program: every definition is registered before
anything is checked, so a call into another file resolves.")
  (defn modules [surfaces]
    (do
      (CtInfer.reset!)
      (CtInfer.check-parsed-all surfaces)
      (if (Int.= 0 (Array.length (CtInfer.findings)))
        (Result.Success ())
        (Result.Error @(CtInfer.findings)))))

  (doc render "renders one rejection the way a phase-tagged diagnostic reads:
`ct-shape:<file>:<line>: <definition>: <message>`. The file is empty for a
module parsed without an identity; use `Surface.parse-in` to give it one.")
  (defn render [error]
    (let [span (CtShapeError.span error)]
      (String.concat
        &[@"ct-shape:"
          (Surface.source-name @(SurfaceSpan.source span))
          @":"
          (Int.str @(Info.line (SurfaceSpan.start span)))
          @": "
          (String.copy (CtShapeError.definition error))
          @": "
          (String.copy (CtShapeError.message error))])))

  (doc render-all "renders every rejection, one per line.")
  (defn render-all [errors]
    (let-do [lines (the (Array String) [])]
      (for [i 0 (Array.length errors)]
        (set! lines (Array.push-back lines (render (Array.unsafe-nth errors i)))))
      (String.join "
" &lines))))
