;; Checks the result shape of every form the walker decides itself, rather than
;; through the builtin table in `corpus/oracle.carp`.
;;
;;   carp -x corpus/forms.carp
;;
;; The oracle probes builtins by calling them. That cannot reach a special
;; form, because a special form is not a call the walker forwards to the
;; table: `and`, `or`, `if`, `let`, `do`, `when`, `case`, `quote` and
;; `quasiquote` all get their result shape from the walker's own code. `or`
;; answering with a Bool instead of with its operand survived every other
;; check in this library until this file existed.
;;
;; A result shape that is too wide is imprecise. One that is too narrow is
;; unsound, because everything downstream is checked against it.
;;
;; This is a separate program from the oracle only to keep each one small and
;; quick to run; there is no dependency between them.

(load "../../carp-ct-eval/carp-ct-eval.carp")
(load "../carp-ct-infer.carp")
(Project.no-echo)

(def *state* (CtEval.state))

(defn evaluate [source]
  (match (Surface.parse source)
    (Result.Error _) (Maybe.Nothing)
    (Result.Success m)
      (let [forms (SurfaceModule.forms &m)]
        (if (Int.= 0 (Array.length forms))
          (Maybe.Nothing)
          (let-do [root (CtEval.root &*state*)]
            (match (CtEval.eval-value (Box.peek (Array.unsafe-nth forms 0))
                                      &*state*
                                      &root)
              (Result.Error _) (Maybe.Nothing)
              (Result.Success value)
                (Maybe.Just
                  (match value
                    (CtValue.Syntax node) (CtInfer.data-shape (Box.peek &node))
                    (CtValue.Closure _) (CtShape.leaf (CtShape.i-closure))
                    (CtValue.Macro _) (CtShape.leaf (CtShape.i-macro))
                    (CtValue.Builtin _) (CtShape.leaf (CtShape.i-builtin))
                    (CtValue.Collection _)
                      (CtShape.leaf (CtShape.i-collection))))))))))

;; Expressions whose result shape the walker decides itself rather than
;; through the builtin table: special forms, and calls whose result the walker
;; computes from its parts. The builtin probes above cannot reach these, and
;; `or` answering with a Bool instead of with its operand survived every other
;; check until this list existed.
(def *form-probes*
  [@"(and true false)" @"(and true 7)" @"(and false 7)" @"(and true \"s\")"
   @"(or false 7)" @"(or true 7)" @"(or false \"s\")"
   @"(if true 1 2)" @"(if false 1 \"s\")"
   @"(do 1 \"s\")" @"(let [x 1] x)" @"(let [x (quote (1 2))] (cdr x))"
   @"(when true 1)" @"(when false 1)" @"(while false 1)"
   @"(case 1 1 \"a\" \"b\")"
   @"(quote (1 2))" @"(quote sym)" @"(quote 1)"
   ;; `quasiquote` is absent: the evaluator has no bare `quasiquote` form to
   ;; probe, because expansion drives quasiquotation through carp-expand. The
   ;; walker still tracks quotation depth, which the `quote` probes cover.
   @"(fn [x] x)"
   @"(cdr (quote (1 2 3)))" @"(cons 1 (quote (2)))"
   @"(append (quote (1)) (quote (2)))" @"(list 1 2)" @"(array 1 2)"
   @"(str 1)" @"(String.append \"a\" \"b\")" @"(String.length \"ab\")"
   @"(String.to-list \"ab\")" @"(String.to-array \"ab\")"
   @"(Symbol.from \"a\")" @"(dynamic-type 1)"
   @"(= 1 1)" @"(< 1 2)" @"(not true)" @"(list? (quote (1)))"
   @"(+ 1 2)" @"(inc 1)" @"(length (quote (1 2)))"])

(def *form-wrong* 0)

(doc check-forms "requires the walker's result shape to contain what the
evaluator actually returned. A shape that is too wide is imprecise; one that is
too narrow is unsound, because everything downstream is checked against it.")
(defn check-forms []
  (let-do [total (Array.length &*form-probes*)]
    (for [i 0 total]
    ;; the source is copied and both answers are taken before the match: the
    ;; borrowed-and-matched form of this loop miscompiles into a segfault on
    ;; the current Carp, and this shape does not depend on that going away
    (let-do [source @(Array.unsafe-nth &*form-probes* i)
             observed (evaluate &source)
             declared (CtInfer.shape-of-source &source)]
      (match observed
        (Maybe.Nothing) (IO.println &(fmt "FORM FAILS       %s" &source))
        (Maybe.Just shape)
          (when (not (CtShape.subshape? shape declared))
            (do (set! *form-wrong* (Int.inc *form-wrong*))
                (IO.println &(fmt "FORM RANGE WRONG %-32s returns %s, walker says %s"
                                  &source
                                  &(CtShape.render shape)
                                  &(CtShape.render declared))))))))))

(defn main []
  (do (IO.println "=== result shapes of forms the walker decides itself ===")
      (check-forms)
      (IO.println "")
      (IO.println &(fmt "form probes       : %d" (Array.length &*form-probes*)))
      (IO.println &(fmt "wrong form shapes : %d" *form-wrong*))))
