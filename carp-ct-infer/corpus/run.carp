;; Runs the shape pass over a whole Carp standard library and reports how much
;; of it the pass rejects.
;;
;;   CARP_CORE=<core-dir> carp -x corpus/run.carp
;;
;; The corpus is discovered from the Core.carp load order rather than from a
;; directory listing, so the set checked is the set the compiler would load.

(load "../carp-ct-infer.carp")
(Project.no-echo)

(def *core-dir* @"")

(defn core-path [file] (String.concat &[@&*core-dir* @"/" @file]))

(defn read-source [path]
  (match (IO.read-file path)
    (Result.Success source) (Maybe.Just source)
    (Result.Error _) (Maybe.Nothing)))

(doc load-order "the files Core.carp loads, in the order it loads them.")
(defn load-order [source]
  (let-do [files (the (Array String) [])]
    (match (Surface.parse source)
      (Result.Error _) ()
      (Result.Success module)
        (let [forms (SurfaceModule.forms &module)]
          (for [i 0 (Array.length forms)]
            (let [items (CtInfer.items-of (Box.peek (Array.unsafe-nth forms i)))]
              (when (Int.= 2 (Array.length &items))
                (match (CtInfer.head-key &items)
                  (Maybe.Nothing) ()
                  (Maybe.Just head)
                    (when (or (= &head "load-once") (= &head "load"))
                      (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth &items
                                                                               1)))
                        (SurfaceForm.StringLit name)
                          (when (String.ends-with? name ".carp")
                            (set! files (Array.push-back files @name)))
                        _ ()))))))))
    files))

(doc definition-count "how many compile-time definitions a module holds,
counted the same way the checker walks them.")
(defn definition-count [node]
  (let [items (CtInfer.items-of node)]
    (if (Int.= 0 (Array.length &items))
      0
      (match (CtInfer.head-key &items)
        (Maybe.Nothing) 0
        (Maybe.Just head)
          (cond
            (= &head "defmodule")
              (let-do [total 0]
                (for [i 2 (Array.length &items)]
                  (set! total
                        (Int.+ total
                               (definition-count (Box.peek (Array.unsafe-nth &items
                                                                             i))))))
                total)
            (or (= &head "defmacro") (= &head "defndynamic")) 1
            0)))))

(defn report [checked]
  (let-do [findings (CtInfer.findings)
           n (Array.length findings)
           rejected (the (Array String) [])]
    (for [i 0 n]
      (let-do [f (Array.unsafe-nth findings i)]
        (IO.println &(fmt "[%s] %s" (CtShapeError.kind f) &(CtCheck.render f)))
        (unless (Array.any?
            &(fn [d] (= d (CtShapeError.definition f)))
            &rejected)
          (set! rejected (Array.push-back rejected @(CtShapeError.definition f))))))
    (IO.println &(fmt "definitions checked           : %d" checked))
    (IO.println
      &(fmt "definitions rejected          : %d" (Array.length &rejected)))
    (IO.println &(fmt "findings                      : %d" n))
    (IO.println
      &(fmt
        "definitions with a constrained position: %d"
        (CtInfer.definitions-constrained)))
    (IO.println
      &(fmt
        "definitions where a contradiction was possible: %d"
        (CtInfer.definitions-decided)))
    (IO.println
      &(fmt "argument positions walked     : %d" (CtInfer.argument-positions)))
    (IO.println
      &(fmt "constrained positions examined: %d" (CtInfer.constrained-positions)))
    (IO.println
      &(fmt "  of those, shape was known   : %d" (CtInfer.decided-positions)))
    (IO.println &(fmt "narrowings applied            : %d" (CtInfer.narrowings)))))

(defn run [files precise?]
  (let-do [modules (the (Array SurfaceModule) [])
           present (the (Array String) [])
           checked 0]
    (CtInfer.reset!)
    (set! *ct-precise-macro-parameters* precise?)
    (IO.println "")
    (IO.println
      &(fmt "=== macro parameters start at %s ==="
            (if precise? "Syntax" "Obj (conservative)")))
    ;; every definition is registered before anything is checked, so that a
    ;; call into another file resolves
    (for [i 0 (Array.length files)]
      (match (read-source &(core-path (Array.unsafe-nth files i)))
        (Maybe.Nothing) ()
        (Maybe.Just source)
          (match (Surface.parse-in (Array.unsafe-nth files i) &source)
            (Result.Error _)
              (IO.println &(fmt "  unparsed: %s" (Array.unsafe-nth files i)))
            (Result.Success module)
              (let-do [forms (SurfaceModule.forms &module)]
                (for [f 0 (Array.length forms)]
                  (let-do [node (Box.peek (Array.unsafe-nth forms f))]
                    (CtInfer.collect node "")
                    (set! checked (Int.+ checked (definition-count node)))))
                (set! present
                      (Array.push-back present @(Array.unsafe-nth files i)))
                (set! modules (Array.push-back modules module))))))
    (for [i 0 (Array.length &modules)]
      (do
        (set! *ct-current-file* @(Array.unsafe-nth &present i))
        (let [forms (SurfaceModule.forms (Array.unsafe-nth &modules i))]
          (for [f 0 (Array.length forms)]
            (CtInfer.check-module (Box.peek (Array.unsafe-nth forms f)) "")))))
    (report checked)))

(defn main []
  (let [supplied (IO.getenv "CARP_CORE")]
    (match supplied
      (Maybe.Nothing)
        (IO.println "set CARP_CORE to a Carp standard-library directory")
      (Maybe.Just dir)
        (do
          (set! *core-dir* dir)
          (match (read-source &(core-path "Core.carp"))
            (Maybe.Nothing)
              (IO.println "could not read Core.carp in that directory")
            (Maybe.Just source)
              (let-do [files (load-order &source)]
                (IO.println
                  &(fmt
                    "corpus: %d files from Core.carp load order"
                    (Array.length &files)))
                (run &files false)
                (run &files true)))))))
