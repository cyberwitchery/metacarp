;; expect: accept
;; why: a bare name inside a module is the global definition, not the module's
;; own, which is reachable only qualified. Reading it the other way made this
;; pass reject `carpentry-org/match-utils`, where `OrderedTree.reduce` calls the
;; global `reduce` with its own arity shifted
(defndynamic reduce [f x xs] x)

(defmodule OrderedTree (defndynamic reduce [t f acc] (reduce f acc (car t))))

(defndynamic fold-a-tree [tree]
  (OrderedTree.reduce tree (quote a-symbol) (quote ())))
