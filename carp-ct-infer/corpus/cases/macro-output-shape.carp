;; expect: reject
;; why: the macro emits an `if` holding a test and nothing else, and no `if` is
;; well formed with fewer than three forms. This is a claim about the syntax a
;; macro produces rather than about the macro as a program, and it needs three
;; things the tag lattice has none of: singleton types, so the head is `if` and
;; not merely a symbol; a container that carries what it holds, so the length is
;; known; and a minimum arity, which is the part of a form's grammar that cannot
;; drift from the expander. It was the third `gap` in this corpus to close.
(defmacro broken-if [test] (list (quote if) test))
