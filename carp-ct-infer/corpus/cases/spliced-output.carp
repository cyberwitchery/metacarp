;; expect: accept
;; why: the emitted form is written around a splice, so how many forms it ends up
;; holding is not known here and nothing is claimed about its length. This is the
;; guard on the check that `macro-output-shape` closed: a macro building a form
;; out of a body it was handed must not be second-guessed.
(defmacro with-one [:rest body] (quasiquote (let [x 1] (unquote-splicing body))))
