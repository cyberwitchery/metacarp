;; expect: reject
;; why: neither definition constrains its parameter on its own. `walk` passes it
;; to `descend`, which takes it apart, so the domain only appears once a round of
;; the fixpoint has gone through the cycle
(defmodule Tree
  (defndynamic walk [node] (Tree.descend node))

  (defndynamic descend [node] (Tree.walk (cdr node))))

(defndynamic start [] (Tree.walk 7))
