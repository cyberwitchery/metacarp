;; expect: reject
;; why: three levels. `car` is a builtin and forces a sequence, `caar` passes its
;; parameter straight into it, `first-key` passes its own into `caar`, and the
;; call site hands that an Int. Nothing intra-procedural sees it: every single
;; definition is fine on its own, and the contradiction only exists end to end.
;;
;; Written out rather than relying on Core's `caar`, because a case is checked on
;; its own: the only names the pass knows here are the builtins and the
;; definitions in this file.
(defndynamic caar [pair] (car (car pair)))

(defndynamic first-key [pairs] (caar pairs))

(defndynamic lookup-head [] (first-key 3))
