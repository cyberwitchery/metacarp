;; Shows what the shape pass actually knows about a standard library, rather
;; than only whether it complained.
;;
;;   CARP_CORE=$CARP_DIR/core carp -x corpus/explain.carp
;;   CARP_CORE=$CARP_DIR/core CT_DEFN=Dynamic.zip carp -x corpus/explain.carp
;;
;; With no `CT_DEFN` it ranks definitions by how much the pass decided in
;; them. With one, it prints every position the pass had something to say
;; about, and what it said.

(load "../carp-ct-infer.carp")
(Project.no-echo)

(def *core-dir* @"")

(defn read-source [path]
  (match (IO.read-file path)
    (Result.Success source) (Maybe.Just source)
    (Result.Error _) (Maybe.Nothing)))

(defn load-order [source]
  (let-do [files (the (Array String) [])]
    (match (Surface.parse source)
      (Result.Error _) ()
      (Result.Success module)
        (let [forms (SurfaceModule.forms &module)]
          (for [i 0 (Array.length forms)]
            (let [items (CtInfer.items-of (Box.peek (Array.unsafe-nth forms i)))]
              (when (Int.= 2 (Array.length &items))
                (match (CtInfer.head-key &items)
                  (Maybe.Nothing) ()
                  (Maybe.Just head)
                    (when (or (= &head "load-once") (= &head "load"))
                      (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth &items
                                                                               1)))
                        (SurfaceForm.StringLit name)
                          (when (String.ends-with? name ".carp")
                            (set! files (Array.push-back files @name)))
                        _ ()))))))))
    files))

(defn decided? [observation]
  (and
    (Int./= @(CtObservation.actual observation) (CtShape.top))
    (not (String.starts-with? (CtObservation.operation observation) "narrow"))))

(defn narrowing? [observation]
  (String.starts-with? (CtObservation.operation observation) "narrow"))

(defn rank []
  (let-do [names (the (Array String) [])
           counts (the (Array Int) [])
           observations (CtInfer.observations)]
    (for [i 0 (Array.length observations)]
      (let [o (Array.unsafe-nth observations i)]
        (when (or (decided? o) (narrowing? o))
          (let-do [found -1]
            (for [j 0 (Array.length &names)]
              (when (= (Array.unsafe-nth &names j) (CtObservation.definition o))
                (set! found j)))
            (if (Int.< found 0)
              (do
                (set! names
                      (Array.push-back names @(CtObservation.definition o)))
                (set! counts (Array.push-back counts 1)))
              (Array.aset! &counts
                           found
                           (Int.inc @(Array.unsafe-nth &counts found))))))))
    ;; selection sort over a short list, printed highest first
    (IO.println "definitions the pass decided the most in:")
    (for [k 0 20]
      (let-do [best -1
               best-count 0]
        (for [j 0 (Array.length &names)]
          (when-do (Int.> @(Array.unsafe-nth &counts j) best-count)
            (set! best j)
            (set! best-count @(Array.unsafe-nth &counts j))))
        (when-do (Int.>= best 0)
          (IO.println
            &(fmt "  %3d  %s" best-count (Array.unsafe-nth &names best)))
          (Array.aset! &counts best 0))))))

(defn detail [wanted]
  (let-do [observations (CtInfer.observations)
           shown 0]
    (IO.println &(fmt "what the pass knows about %s:" wanted))
    (for [i 0 (Array.length observations)]
      (let [o (Array.unsafe-nth observations i)]
        (when-do (= (CtObservation.definition o) wanted)
          (set! shown (Int.inc shown))
          (if (narrowing? o)
            (IO.println
              &(fmt "  line %-4d %-12s %-22s %s  ->  %s"
                    @(CtObservation.line o)
                    (CtObservation.operation o)
                    (CtObservation.detail o)
                    &(CtShape.render @(CtObservation.actual o))
                    &(CtShape.render @(CtObservation.required o))))
            (IO.println
              &(fmt
                "  line %-4d %-12s %-22s is %s, needs %s%s"
                @(CtObservation.line o)
                (CtObservation.operation o)
                (CtObservation.detail o)
                &(CtShape.render @(CtObservation.actual o))
                &(CtShape.render @(CtObservation.required o))
                (if (Int.= @(CtObservation.actual o) (CtShape.top))
                  " (nothing known)"
                  " <- decided")))))))
    (when (Int.= 0 shown)
      (IO.println "  no such definition, or nothing constrained in it"))))

(defn all-decided []
  (let [observations (CtInfer.observations)]
    (for [i 0 (Array.length observations)]
      (let [o (Array.unsafe-nth observations i)]
        (when (or (decided? o) (narrowing? o))
          (IO.println
            &(fmt "%-34s line %-4d %-12s %-20s %s | %s"
                  (CtObservation.definition o)
                  @(CtObservation.line o)
                  (CtObservation.operation o)
                  (CtObservation.detail o)
                  &(CtShape.render @(CtObservation.actual o))
                  &(CtShape.render @(CtObservation.required o)))))))))

(defn main []
  (match (IO.getenv "CARP_CORE")
    (Maybe.Nothing)
      (IO.println "set CARP_CORE to a Carp standard-library directory")
    (Maybe.Just dir)
      (do
        (set! *core-dir* dir)
        (match (read-source &(String.concat &[@&*core-dir* @"/Core.carp"]))
          (Maybe.Nothing) (IO.println "could not read Core.carp there")
          (Maybe.Just core)
            (let-do [files (load-order &core)
                     modules (the (Array SurfaceModule) [])]
              (CtInfer.reset!)
              (set! *ct-explain* true)
              (for [i 0 (Array.length &files)]
                (match (read-source
                    &(String.concat
                      &[@&*core-dir* @"/" @(Array.unsafe-nth &files i)]))
                  (Maybe.Nothing) ()
                  (Maybe.Just source)
                    (match (Surface.parse &source)
                      (Result.Error _) ()
                      (Result.Success module)
                        (do
                          (let [forms (SurfaceModule.forms &module)]
                            (for [f 0 (Array.length forms)]
                              (CtInfer.collect (Box.peek (Array.unsafe-nth forms
                                                                           f))
                                               "")))
                          (set! modules (Array.push-back modules module))))))
              (for [i 0 (Array.length &modules)]
                (let [forms (SurfaceModule.forms (Array.unsafe-nth &modules i))]
                  (for [f 0 (Array.length forms)]
                    (CtInfer.check-module (Box.peek (Array.unsafe-nth forms f))
                                          ""))))
              (match (IO.getenv "CT_DEFN")
                (Maybe.Just wanted) (detail &wanted)
                (Maybe.Nothing)
                  (match (IO.getenv "CT_DECIDED")
                    (Maybe.Just _) (all-decided)
                    (Maybe.Nothing) (rank))))))))
