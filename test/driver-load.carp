(load "../carp-compiler.carp")
(load "../driver-load.carp")
(load "Test.carp")
(Project.no-echo)
(use-all Test)

(defn reads-local-package? []
  (let-do [name "git@github.com:carpentry-org/example@development"]
    (ignore
      (add-package-override!
        "git@github.com:carpentry-org/example@development=test/load-fixtures/package-entry.carp"))
    (match (read-git-source name)
      (Maybe.Nothing) false
      (Maybe.Just entry)
        (and
          (String.= (Pair.a &entry) "test/load-fixtures/package-entry.carp")
          (Int.>= (String.index-of-string (Pair.b &entry) "override-answer") 0)))))

(defn missing-override-does-not-fall-back? []
  (let-do [name "git@github.com:carpentry-org/carp-reader@0.4.3"]
    (ignore
      (add-package-override!
        "git@github.com:carpentry-org/carp-reader@0.4.3=test/load-fixtures/does-not-exist.carp"))
    (match (read-git-source name) (Maybe.Nothing) true _ false)))

(defn defaults-preserve-explicit? []
  (let-do [_added (add-package-override!
             "git@example.org:package@local=explicit.carp")
           defaults (add-default-package-overrides!
             "git@example.org:package@local=default.carp
git@example.org:package@another=another.carp")]
    (and (Result.success? &defaults)
         (and
           (match (package-override "git@example.org:package@local")
             (Maybe.Just path) (String.= &path "explicit.carp")
             _ false)
           (match (package-override "git@example.org:package@another")
             (Maybe.Just path) (String.= &path "another.carp")
             _ false)))))

(deftest test
  (assert-true test
    (defaults-preserve-explicit?)
    "environment defaults apply to new references and preserve explicit overrides")
  (assert-true test
    (Result.error? &(add-default-package-overrides! "malformed"))
    "a malformed environment override fails explicitly")
  (assert-true test
    (Result.error? &(add-package-override! "invalid"))
    "override requires a reference and source path")
  (assert-true test
    (Result.error? &(add-package-override! "name=source.carp"))
    "plain source loads are not package overrides")
  (assert-true test
    (Result.error? &(add-package-override! "git@example.org:repo@dev="))
    "empty source path is invalid")
  (assert-true test
    (reads-local-package?)
    "override reads the local package entry point")
  (assert-true test
    (Result.error?
      &(add-package-override!
        "git@github.com:carpentry-org/example@development=other.carp"))
    "duplicate overrides are rejected")
  (assert-true test
    (match (package-override "git@github.com:carpentry-org/example@other")
      (Maybe.Nothing) true
      _ false)
    "overrides match exact versioned references")
  (assert-true test
    (missing-override-does-not-fall-back?)
    "a missing override never silently reads a released cached package"))
