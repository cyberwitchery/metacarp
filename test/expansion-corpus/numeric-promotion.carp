(Project.no-echo)
; compile-time arithmetic must match the reference's two-domain numbers:
; width promotion (Byte < Int < Long < Float < Double), floor division for
; integral operands (Core's dynamic `imod` depends on it), half-to-even
; rounding, and width-blind numeric equality. Every result is turned into a
; string AT EXPANSION TIME, so the printed program text is the semantics.
(defmacro p01 [] (str (+ 1.5 2.25)))
(defmacro p02 [] (str (+ 1 2.5)))
(defmacro p03 [] (str (- 1 2.5)))
(defmacro p04 [] (str (* 2 3.5)))
(defmacro p05 [] (str (+ 1 2f)))
(defmacro p06 [] (str (+ 2l 3)))
(defmacro p07 [] (str (/ 7 2)))
(defmacro p08 [] (str (/ -7 2)))
(defmacro p09 [] (str (/ 7 2.0)))
(defmacro p10 [] (str (= 1 1.0)))
(defmacro p11 [] (str (= (list 1 2) (list 1.0 2))))
(defmacro p12 [] (str (< 1 1.5)))
(defmacro p13 [] (str (round 2.5)))
(defmacro p14 [] (str (round 3.5)))
(defmacro p15 [] (str (round -2.5)))
(defmacro p16 [] (str (round 5l)))
(defmacro p17 [] (str (inc 1.5)))
(defmacro p18 [] (str (mod 7 2)))
(defmacro p19 [] (str (imod -7 2)))
(defmacro p20 [] (str (neg 2.5)))
(defmacro p21 [] (str (* 2 3.5f)))
(defmacro p22 [] (str (- 2f 1)))
(defndynamic nested-half [] 2.25)
(defmacro p23 [] (str (+ 1.5 (nested-half))))
(defn main []
  (do
    (println* (p01))
    (println* (p02))
    (println* (p03))
    (println* (p04))
    (println* (p05))
    (println* (p06))
    (println* (p07))
    (println* (p08))
    (println* (p09))
    (println* (p10))
    (println* (p11))
    (println* (p12))
    (println* (p13))
    (println* (p14))
    (println* (p15))
    (println* (p16))
    (println* (p17))
    (println* (p18))
    (println* (p19))
    (println* (p20))
    (println* (p21))
    (println* (p22))
    (println* (p23))))
