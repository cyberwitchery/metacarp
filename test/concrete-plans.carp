(load "../carp-compiler.carp")
(Project.no-echo)
(load "Test.carp")
(use-all Test)

(defn emits-echo? [module]
  (match (CBackend.executable-translation-unit module)
    (Result.Success c)
      (and
        (Int.>= (String.index-of-string &c "show_int(") 0)
        (Int.>= (String.index-of-string &c "println_string(") 0))
    (Result.Error _) false))

(defn retains-complete-cache? [source echo expected-count expected-echo]
  (match (Surface.parse source)
    (Result.Success surface)
      (match (CompilerFrontend.infer-module-with &surface
                                                 &(ExpandConfig.init []))
        (Result.Success (AnnotatedModule.init core inferred))
          (match (CarpCompiler.lower-inferred-module-with-known &core
                                                                &inferred
                                                                echo
                                                                &(the (Array Specialization)
                                                                      []))
            (Result.Success first)
              (let [known (IncrementalLowering.instances &first)]
                (and
                  (Int.= expected-count (Array.length known))
                  (and
                    (Bool.= expected-echo
                            (emits-echo? (IncrementalLowering.module &first)))
                    (match (CarpCompiler.lower-inferred-module-with-known &core
                                                                          &inferred
                                                                          echo
                                                                          known)
                      (Result.Success second)
                        (and
                          (Int.= expected-count
                                 (Array.length (IncrementalLowering.instances &second)))
                          (and
                            (Int.= 0
                                   (Array.length
                                     (BackendModule.declarations (IncrementalLowering.module &second))))
                            (Bool.= expected-echo
                                    (emits-echo? (IncrementalLowering.module &second)))))
                      (Result.Error _) false))))
            (Result.Error _) false)
        (Result.Error _) false)
    (Result.Error _) false))

(deftest t
  (assert-true t
    (retains-complete-cache? "(defn answer [] 42) (answer)" false 1 false)
    "plain lowering retains the complete cache and emits only a definition delta")
  (assert-true t
    (retains-complete-cache? "(defn answer [] ()) (answer)" true 1 false)
    "unit echo is a no-op and retains the complete cache")
  (assert-true t
    (retains-complete-cache? "(defn answer [] 42) (answer)" true 1 false)
    "an unavailable str implementation leaves lowering and its cache intact")
  (assert-true t
    (retains-complete-cache? "(register show (Fn [Int] String) \"show_int\")
(implements str show)
(register release (Fn [String] ()) \"release_string\")
(implements delete release)
(defmodule IO
  (register println (Fn [(Ref String)] ()) \"println_string\"))
(defn answer [] 42)
(answer)" true 4 true)
    "echo re-closes the whole delta and reuses its str, println and delete cache"))
