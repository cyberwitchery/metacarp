(load "../carp-compiler.carp")
(load "../driver-load.carp")
(Project.no-echo)
(load "Test.carp")

;; core files come from $CARP_DIR (the reference checkout, as setup-carp
;; exports it), falling back to the sibling layout used for local development.
(defn core-prefix []
  (match (IO.getenv "CARP_DIR")
    (Maybe.Just dir) (String.append &dir "/core/")
    (Maybe.Nothing) @"../../carp/core/"))

(defn core-path [name] (String.append &(core-prefix) name))

(use-all Test)

(defn contains-text? [text fragment]
  (Int.>= (String.index-of-string text fragment) 0))

(defn text-occurrences [text fragment]
  (let-do [remaining (String.copy text)
           count 0
           index (String.index-of-string &remaining fragment)]
    (while-do (Int.>= index 0)
      (set! count (Int.inc count))
      (set! remaining
            (String.suffix &remaining (Int.+ index (String.length fragment))))
      (set! index (String.index-of-string &remaining fragment)))
    count))

;; an accessor whose builtin the resolver never declared would otherwise just
;; go missing and surface as a c link error.
(defn missing-accessor-builtin-fails-derivation? []
  (match (Surface.parse "(register-type Point [x Int])")
    (Result.Success surface)
      (match (Resolve.module &surface)
        (Result.Success core)
          (let [kept (Array.copy-filter
                  &(fn [builtin]
                    (not
                      (String.=
                        (CoreRef.name (CoreBuiltin.reference builtin))
                        "Point.x")))
                  (CoreModule.builtins &core))
                without-getter (CoreModule.set-builtins core kept)]
            (match (CarpCompiler.derive-module-for-inference &without-getter)
              (Result.Success _) false
              (Result.Error error)
                (and
                  (String.= (CompileError.phase &error) "derive")
                  (contains-text? (CompileError.message &error) "Point.x"))))
        (Result.Error _) false)
    (Result.Error _) false))

;; a module may define one of those names itself, as Core does for
;; `Pattern.MatchResult.str`; its definition replaces the derived accessor.
(defn own-accessor-definition-satisfies-derivation? []
  (match (Surface.parse "(register-type Point [x Int])
(register point-str (Fn [(Ref Point)] String) \"point_str\")
(defmodule Point (defn str [p] (point-str p)))") (Result.Success surface)
      (match (Resolve.module &surface)
        (Result.Success core)
          (Result.success? &(CarpCompiler.derive-module-for-inference &core))
        (Result.Error _) false) (Result.Error _) false))

;; a module that registers an accessor name itself keeps its own c: the
;; generated accessor must not replace a registered or templated builtin.
(defn registered-accessor-name-keeps-its-own-c? []
  (match (CarpCompiler.compile-source "(register-type Point [x Int])
(defmodule Point (register str (Fn [(Ref Point)] String) \"my_point_str\"))
(sig show (Fn [(Ref Point)] String))
(defn show [p] (Point.str p))
(defn run [] (let [p (Point.init 1)] (show &p)))
(run)") (Result.Success c)
      (and (contains-text? &c "my_point_str")
           (not (contains-text? &c "snprintf(NULL, 0, \"(Point"))) (Result.Error _)
      false))

(defn optional-copy-branch-count []
  (match (Surface.parse "(deftype (Optional a) (Some [a]) (None))")
    (Result.Success surface)
      (match (Resolve.module &surface)
        (Result.Success core)
          (match (CarpCompiler.derive-module-for-inference &core)
            (Result.Success derived)
              (let-do [count -1
                       functions (CoreModule.functions &derived)]
                (for [i 0 (Array.length functions)]
                  (let [function (Array.unsafe-nth functions i)]
                    (when (String.=
                        (CoreRef.name (CoreFunction.reference function))
                        "Optional.copy")
                      (match-ref (Box.peek (CoreFunction.body function))
                        (CoreExpr.Match _ _ _ branches)
                          (set! count (Array.length branches))
                        _ ()))))
                count)
            (Result.Error _) -1)
        (Result.Error _) -1)
    (Result.Error _) -1))

(defn compiles-source-through-expansion? []
  (match (CarpCompiler.compile-source "(defmacro pass [x] x)
(register int-inc (Fn [Int] Int) \"int_inc\")
(defn increment [x] (pass (int-inc x)))
(increment 1)") (Result.Success c)
      (and (contains-text? &c "#include <core.h>")
           (and (contains-text? &c "return int_inc(")
                (and
                  (contains-text? &c "int main(int argc, char** argv) {")
                  (contains-text? &c "(1);")))) (Result.Error _) false))

(defn compiles-loaded-source-registry? []
  (let [sources [(ModuleSource.init (String.copy "root.carp")
                                    (String.copy "root.carp")
                                    (String.copy "(load \"defs.carp\")
(twice 1)"))
                 (ModuleSource.init (String.copy "defs.carp")
                                    (String.copy "defs.carp")
                                    (String.copy
                                      "(register int-inc (Fn [Int] Int) \"int_inc\")
(defn twice [x] (int-inc (int-inc x)))"))]
        root (String.copy "root.carp")]
    (Result.success? &(CarpCompiler.compile-sources &sources &root))))

(defn emits-library-without-process-entry? []
  (match (Surface.parse "(defn answer [] 42)")
    (Result.Success module)
      (let [config (ExpandConfig.init [])
            roots (the (Array String) [@"answer"])
            symbol (CAbi.mangle "answer" &(Type.function [] (Type.integer)))]
        (match (CarpCompiler.compile-module-library-full &module &config &roots)
          (Result.Success c)
            (and (contains-text? &c &symbol)
                 (not (contains-text? &c "int main(int argc, char** argv)")))
          (Result.Error _) false))
    (Result.Error _) false))

(defn library-roots-result [source roots]
  (match (Surface.parse source)
    (Result.Success module)
      (let [config (ExpandConfig.init [])]
        (match (CarpCompiler.infer-module-with &module &config)
          (Result.Success annotated)
            (CarpCompiler.compile-inferred-library-roots (AnnotatedModule.core &annotated)
                                                         (AnnotatedModule.inferred &annotated)
                                                         roots)
          (Result.Error error) (Result.Error error)))
    (Result.Error _)
      (Result.Error (CompileError.init @"parse" @"test source did not parse"))))

(defn library-roots-emit-the-requested-entry? []
  (match (library-roots-result "(defn answer [] 42)" &[@"answer"])
    (Result.Success c)
      (and
        (contains-text? &c
                        &(CAbi.mangle "answer"
                                      &(Type.function [] (Type.integer))))
        (not (contains-text? &c "int main(int argc, char** argv)")))
    (Result.Error _) false))

;; a root specialization cannot produce is an error naming it, not a library
;; that quietly lacks the entry point: an unknown name, or a generic function.
(defn library-roots-reject-what-they-cannot-emit? []
  (match (library-roots-result "(defn answer [] 42)
(defn same [x] x)" &[@"answer" @"missing" @"same"]) (Result.Success _) false (Result.Error error)
      (and
        (contains-text? (CompileError.message &error) "missing")
        (contains-text? (CompileError.message &error) "same")
        (not (contains-text? (CompileError.message &error) "answer")))))

;; a library has no main to call `carp_init_globals`; it runs when the library
;; loads instead, so a host never sees an uninitialized global.
(defn library-initializes-globals-at-load? []
  (match (library-roots-result "(register compute (Fn [] Int) \"compute\")
(def value (compute))
(defn read-value [] value)" &[@"read-value"]) (Result.Success c)
      (and
        (contains-text? &c "__attribute__((constructor))")
        (contains-text? &c "carp_init_globals(0, NULL);")) (Result.Error _)
      false))

(defn library-rejects-top-level-expressions? []
  (match (library-roots-result "(defn answer [] 42)
(answer)" &[@"answer"]) (Result.Success _) false (Result.Error error)
      (contains-text? (CompileError.message &error) "top-level expressions")))

;; only a library's roots are visible outside it: with default linkage a
;; second library's calls and globals bind to the first one's on ELF.
(defn library-exports-only-its-roots? []
  (match (library-roots-result "(register compute (Fn [] Int) \"compute\")
(def value (compute))
(defn helper [] value)
(defn read-value [] (helper))" &[@"read-value"]) (Result.Success c)
      (let [root (CAbi.mangle "read-value" &(Type.function [] (Type.integer)))
            helper (CAbi.mangle "helper" &(Type.function [] (Type.integer)))]
        (and
          (contains-text? &c
                          &(String.concat
                            &[@"__attribute__((visibility(\"default\"))) int "
                              root]))
          (contains-text? &c &(String.concat &[@"static int " helper]))
          (contains-text? &c "static void carp_init_globals(")
          (contains-text? &c "#pragma GCC visibility push(hidden)")
          (contains-text? &c "#pragma GCC visibility pop")
          (not (contains-text? &c "extern int ")))) (Result.Error _) false))

;; a registered type's accessors are the c sources of the builtins the
;; resolver declares for them, so they take a library's linkage like any other
;; definition, and only the ones the library uses are emitted.
(defn library-registered-accessors-are-static? []
  (match (library-roots-result "(register-type Point [x Int])
(sig read-x (Fn [(Ref Point)] (Ref Int)))
(defn read-x [p] (Point.x p))" &[@"read-x"]) (Result.Success c)
      (and (contains-text? &c "static int* ")
           (contains-text? &c "return &(p->x); }")
           (not (contains-text? &c "set_x45_x"))
           (not (contains-text? &c "//registered accessor"))) (Result.Error _)
      false))

(defn executable-keeps-external-linkage? []
  (match (CarpCompiler.compile-source "(defn answer [] 42)
(answer)") (Result.Success c)
      (and
        (not (contains-text? &c "static void carp_init_globals("))
        (not (contains-text? &c "visibility("))
        (not (contains-text? &c "#pragma GCC visibility"))) (Result.Error _)
      false))

;; every program's roots hold inert values (Core ends on `()`), which a
;; library may carry: only a top-level expression that does something fails.
(defn library-accepts-inert-top-level-values? []
  (Result.success? &(library-roots-result "(defn answer [] 42)
42
()" &[@"answer"])))

;; a registered builtin is not the library's to define, even though
;; specialization can demand it by name.
(defn library-rejects-builtin-roots? []
  (match (library-roots-result "(register emit (Fn [Int] ()) \"emit\")
(defn answer [] 42)" &[@"answer" @"emit"]) (Result.Success _) false (Result.Error error)
      (and
        (contains-text? (CompileError.message &error) "emit")
        (not (contains-text? (CompileError.message &error) "answer")))))

;; the CLI roots a library at the definitions a file makes public; a private
;; helper, generic or not, is reached through them.
(defn cli-library-roots-are-public-definitions? []
  (let [roots (collect-library-roots "(defn answer [] 42)
(private helper)
(defn helper [x] x)
(defn- other [x] x)
(defmodule M (defn inner [] 1) (private hidden-one) (defn hidden-one [] 2))")] (= &roots
                                                                                  &[@"answer"
                                                                                    @"M.inner"])))

(defn preserves-system-includes? []
  (match (CarpCompiler.compile-source "(system-include \"assert.h\")
1") (Result.Success c) (contains-text? &c "#include <assert.h>") (Result.Error _)
      false))

(defn compiles-scalar-global-values? []
  (match (CarpCompiler.compile-source "(def answer 42)
(deftemplate emit (Fn [Int] ()) \"void $NAME(int value)\" \"$DECL { (void)value; }\")
(emit answer)") (Result.Success c)
      (let [symbol (CAbi.mangle "answer" &(Type.integer))]
        (and
          (contains-text? &c
                          &(String.concat
                            &[@"extern int " (String.copy &symbol) @";"]))
          (contains-text? &c
                          &(String.concat
                            &[@"int " (String.copy &symbol) @" = 42;"])))) (Result.Error _)
      false))

(defn compiles-runtime-global-initializers? []
  (match (CarpCompiler.compile-source
      "(register inc (Fn [Int] Int) \"increment\")
(register less? (Fn [Int Int] Bool) \"less\")
(def answer
  (let [value 40]
    (do
      (while (less? value 42)
        (set! value (inc value)))
      (if (less? value 43) value 0))))
answer")
    (Result.Success c)
      (let [symbol (CAbi.mangle "answer" &(Type.integer))]
        (and (contains-text? &c "while (less(")
             (and
               (contains-text? &c
                               &(String.concat &[(String.copy &symbol) @" = L"]))
               (contains-text? &c "  carp_init_globals(argc, argv);"))))
    (Result.Error _) false))

(defn reports-phase-errors? []
  (and
    (match (CarpCompiler.compile-source "(")
      (Result.Error error) (= (CompileError.phase &error) "parse")
      (Result.Success _) false)
    (match (CarpCompiler.compile-source
        "(register use-len (Fn [Int] Int) \"use_len\")
(use-len true)")
      (Result.Error error) (= (CompileError.phase &error) "infer")
      (Result.Success _) false)))

;; the reference takes a registered type's C name and its fields together:
;; `(register-type B "b_type" [x Int])`.
(def point-uses "(sig read-x (Fn [(Ref Point)] (Ref Int)))
(defn read-x [p] (Point.x p))
(defn make [] (Point.init 3))
(make)")

(defn register-type-keeps-fields-after-a-c-name? []
  (match (CarpCompiler.compile-source
      &(String.append "(register-type Point \"point_t\" [x Int])
" point-uses))
    (Result.Success c) (contains-text? &c "point_t")
    (Result.Error _) false))

(defn register-type-keeps-fields-without-a-c-name? []
  (Result.success?
    &(CarpCompiler.compile-source &(String.append "(register-type Point [x Int])
" point-uses))))

(defn emits-managed-delete? []
  (match (CarpCompiler.compile-source "(register-type Widget)
(register make-widget (Fn [] Widget) \"make_widget\")
(defmodule Widget (register delete (Fn [Widget] ()) \"widget_delete\"))
(implements delete Widget.delete)
(defn drop-it [] (let [w (make-widget)] 0))
(drop-it)") (Result.Success c)
      (and (contains-text? &c "= make_widget();")
           (contains-text? &c "widget_delete(")) (Result.Error _) false))

(defn emits-delete-after-owned-self-rebind? []
  (match (CarpCompiler.compile-source "(register-type Widget)
(register make-widget (Fn [] Widget) \"make_widget\")
(register update-widget (Fn [Widget] Widget) \"update_widget\")
(defmodule Widget (register delete (Fn [Widget] ()) \"widget_delete\"))
(implements delete Widget.delete)
(defn update-it []
  (let [w (make-widget)]
    (do (set! w (update-widget w)) 0)))
(update-it)") (Result.Success c)
      (and
        (contains-text? &c "w = update_widget(w);")
        (contains-text? &c "widget_delete(w);")) (Result.Error _) false))

(defn emits-scope-delete-after-owned-overwrite? []
  (match (CarpCompiler.compile-source "(register-type Widget)
(register make-widget (Fn [] Widget) \"make_widget\")
(defmodule Widget (register delete (Fn [Widget] ()) \"widget_delete\"))
(implements delete Widget.delete)
(defn replace-it []
  (let [w (make-widget)]
    (do (set! w (make-widget)) ())))
(replace-it)") (Result.Success c) (contains-text? &c "widget_delete(w);
  w = setold;
  ((void)0);
  widget_delete(w);") (Result.Error _) false))

(defn compiles-managed-return-with-root-cleanup? []
  (match (CarpCompiler.compile-source "(register-type Widget)
(register make-widget (Fn [] Widget) \"make_widget\")
(defmodule Widget (register delete (Fn [Widget] ()) \"widget_delete\"))
(implements delete Widget.delete)
(defn keep-it [] (let [w (make-widget)] w))
(keep-it)") (Result.Success c)
      (and (contains-text? &c "return w") (contains-text? &c "widget_delete(")) (Result.Error _)
      false))

(defn compiles-managed-parameter-cleanup? []
  (match (CarpCompiler.compile-source "(register-type Widget)
(register make-widget (Fn [] Widget) \"make_widget\")
(register inspect-widget (Fn [(Ref Widget)] Int) \"inspect_widget\")
(defmodule Widget (register delete (Fn [Widget] ()) \"widget_delete\"))
(implements delete Widget.delete)
(defn inspect [w] (inspect-widget &(the Widget w)))
(inspect (make-widget))") (Result.Success c)
      (and
        (contains-text? &c "inspect_widget((&w))")
        (Int.= 1 (text-occurrences &c "widget_delete("))) (Result.Error _) false))

(defn compiles-discarded-temporary-cleanup? []
  ;; a do-statement must be Unit (as in the reference), so the discarded owned
  ;; value lives inside a unit-typed let statement.
  (match (CarpCompiler.compile-source "(register-type Widget)
(register make-widget (Fn [] Widget) \"make_widget\")
(defmodule Widget (register delete (Fn [Widget] ()) \"widget_delete\"))
(implements delete Widget.delete)
(defn f [] (do (let [w (make-widget)] ()) 0))
(f)") (Result.Success c)
      (and (contains-text? &c "= make_widget();")
           (and (contains-text? &c "widget_delete(")
                (contains-text? &c "return 0;"))) (Result.Error _) false))

(defn compiles-match-branch-cleanup? []
  (match (CarpCompiler.compile-source "(register-type Widget)
(register make-widget (Fn [] Widget) \"make_widget\")
(defmodule Widget (register delete (Fn [Widget] ()) \"widget_delete\"))
(implements delete Widget.delete)
(deftype Flag (On []) (Off []))
(defn f [flag] (match flag (Flag.On) (let [w (make-widget)] 0) (Flag.Off) 0))
(f (Flag.On))") (Result.Success c)
      (and (contains-text? &c "= make_widget();")
           (contains-text? &c "widget_delete(")) (Result.Error _) false))

(defn derives-managed-deftype-deleter? []
  (match (CarpCompiler.compile-source "(register-type Widget)
(defmodule Widget (register delete (Fn [Widget] ()) \"widget_delete\"))
(implements delete Widget.delete)
(register make-widget (Fn [] Widget) \"make_widget\")
(deftype Boxx [contents Widget])
(register box-it (Fn [Widget] Boxx) \"box_it\")
(defn drop-box [] (let [b (box-it (make-widget))] 0))
(drop-box)") (Result.Success c)
      (and (contains-text? &c "Boxx_x46_delete")
           (contains-text? &c "widget_delete(")) (Result.Error _) false))

(defn derives-sum-deftype-deleter? []
  (match (CarpCompiler.compile-source "(register-type Widget)
(defmodule Widget (register delete (Fn [Widget] ()) \"widget_delete\"))
(implements delete Widget.delete)
(register make-widget (Fn [] Widget) \"make_widget\")
(deftype Thing (Full [Widget]) (Empty []))
(register make-full (Fn [Widget] Thing) \"make_full\")
(defn drop-thing [] (let [t (make-full (make-widget))] 0))
(drop-thing)") (Result.Success c)
      (and (contains-text? &c "Thing_x46_delete")
           (and (contains-text? &c "widget_delete(")
                (contains-text? &c "tag == 1"))) (Result.Error _) false))

(defn derives-generic-deftype-deleter? []
  (match (CarpCompiler.compile-source "(register-type Widget)
(defmodule Widget (register delete (Fn [Widget] ()) \"widget_delete\"))
(implements delete Widget.delete)
(register make-widget (Fn [] Widget) \"make_widget\")
(deftype (Maybe a) (Just [a]) (Nothing []))
(defn drop-maybe [] (let [m (Maybe.Just (make-widget))] 0))
(drop-maybe)") (Result.Success c)
      (and (contains-text? &c "Maybe_x46_delete")
           (contains-text? &c "widget_delete(")) (Result.Error _) false))

(defn derives-mixed-generic-deleter? []
  (match (CarpCompiler.compile-source "(register-type Widget)
(defmodule Widget (register delete (Fn [Widget] ()) \"widget_delete\"))
(implements delete Widget.delete)
(register make-widget (Fn [] Widget) \"make_widget\")
(deftype (Pair a b) (Init [a b]))
(register mk-pair (Fn [Widget Int] (Pair Widget Int)) \"mk_pair\")
(defn drop-pair [] (let [p (mk-pair (make-widget) 3)] 0))
(drop-pair)")
    (Result.Success c)
      (and (contains-text? &c "Pair_x46_delete")
           ;; the unmanaged Int field is an Ignore slot now, so no `int field1`
           ;; binding is emitted; only the managed Widget field is deleted.
           (and (not (contains-text? &c "int field1"))
                (contains-text? &c "widget_delete(")))
    (Result.Error _) false))

(defn lowers-by-reference-match? []
  (match (CarpCompiler.compile-source "(deftype Point [x Int])
(defn get-x [p] (match-ref p (Point.init px) (deref px)))
(get-x &(Point.init 5))")
    (Result.Success c)
    ;; Point has one constructor, so its pattern is irrefutable and its
    ;; generated layout carries no redundant sum tag. The field binding is
    ;; still a pointer because this is match-ref.
    (and
      (not (contains-text? &c "(*match_0).tag"))
      (and
        (contains-text? &c "typedef struct Point")
        (contains-text? &c "int* L")))
    (Result.Error _)
    false))

(defn derives-managed-deftype-copier? []
  (match (CarpCompiler.compile-source "(register-type Widget)
(defmodule Widget (register copy (Fn [(Ref Widget)] Widget) \"widget_copy\"))
(implements copy Widget.copy)
(defmodule Widget (register delete (Fn [Widget] ()) \"widget_delete\"))
(implements delete Widget.delete)
(register make-widget (Fn [] Widget) \"make_widget\")
(deftype Boxx [contents Widget])
(register box-it (Fn [Widget] Boxx) \"box_it\")
(defn dup [b] (copy &b))
(dup (box-it (make-widget)))") (Result.Success c)
      (and (contains-text? &c "Boxx_x46_copy")
           (and (contains-text? &c "widget_copy(")
                (contains-text? &c "= &(*match_0)"))) (Result.Error _) false))

(defn derives-generic-deftype-copier? []
  (match (CarpCompiler.compile-source "(register-type Widget)
(defmodule Widget (register copy (Fn [(Ref Widget)] Widget) \"widget_copy\"))
(implements copy Widget.copy)
(defmodule Widget (register delete (Fn [Widget] ()) \"widget_delete\"))
(implements delete Widget.delete)
(register make-widget (Fn [] Widget) \"make_widget\")
(deftype (Pair a b) (Init [a b]))
(register mk-pair (Fn [Widget Int] (Pair Widget Int)) \"mk_pair\")
(defn dup-pair [p] (copy &p))
(dup-pair (mk-pair (make-widget) 7))") (Result.Success c)
      (and (contains-text? &c "Pair_x46_copy")
           (and (contains-text? &c "widget_copy(") (contains-text? &c "deref"))) (Result.Error _)
      false))

(defn emits-single-constructor-sum-copier? []
  ;; A sum with ONE constructor has only tag 0. Deciding "is a sum" from the
  ;; tags therefore skipped it, and an unmanaged one had no other source of a
  ;; copier: the program emitted a call and a prototype for `<T>.copy` and
  ;; failed to link. `(deftype SerializeError (NonFiniteNumber [Double]))` in
  ;; the json library is exactly this shape.
  (match (CarpCompiler.compile-source "(deftype Fault (Bad [Double]))
(defn duplicate []
  (let [value (Fault.Bad 1.0)]
    (ignore @&value)))
(duplicate)")
    (Result.Success c)
      (let [signature (Type.function
              [(Box.init
                 (Type.reference (Type.named "Fault" []) (Type.lifetime 0)))]
              (Type.named "Fault" []))
            symbol (CAbi.mangle "Fault.copy" &signature)]
        ;; a prototype and a call make two occurrences; the definition is the
        ;; third, and its absence is what the linker used to report
        (let-do [count (text-occurrences &c &symbol)]
          (when (Int.< count 3)
            (IO.println
              &(fmt
                "single-constructor copier symbol=%s occurrences=%d"
                &symbol
                count)))
          (Int.>= count 3)))
    (Result.Error error)
      (do
        (IO.println
          &(String.concat
            &[(String.copy (CompileError.phase &error))
              @": "
              (String.copy (CompileError.message &error))]))
        false)))

(defn emits-concrete-generic-sum-copier? []
  (match (CarpCompiler.compile-source
      "(defmodule Int (register copy (Fn [(Ref Int)] Int) \"int_copy\"))
(implements copy Int.copy)
(deftype (Optional a) (Some [a]) (None))
(defn duplicate []
  (let [value (Optional.Some 1)]
    (ignore @&value)))
(duplicate)")
    (Result.Success c)
      (let [signature (Type.function
              [(Box.init
                 (Type.reference
                   (Type.named "Optional" [(Box.init (Type.integer))])
                   (Type.lifetime 0)))]
              (Type.named "Optional" [(Box.init (Type.integer))]))
            symbol (CAbi.mangle "Optional.copy" &signature)]
        ;; A missing body still leaves one prototype and one call. The emitted
        ;; definition is the third occurrence.
        (let-do [count (text-occurrences &c &symbol)]
          (when-do (or (Int.< count 3) (Int./= 2 (optional-copy-branch-count)))
            (IO.println
              &(fmt
                "optional copier symbol=%s occurrences=%d generic=%d branches=%d"
                &symbol
                count
                (text-occurrences &c "Optional_x46_copy")
                (optional-copy-branch-count))))
          (and (Int.>= count 3) (Int.= 2 (optional-copy-branch-count)))))
    (Result.Error error)
      (do
        (IO.println
          &(String.concat
            &[(String.copy (CompileError.phase &error))
              @": "
              (String.copy (CompileError.message &error))]))
        false)))

(defn emits-closure-environment-copier? []
  (match (CarpCompiler.compile-source "(register add (Fn [Int Int] Int) \"add\")
(let [v 1
       adder (fn [x] (add v x))
       copied (copy &adder)]
   (copied 10))") (Result.Success c)
      (and
        (contains-text? &c "_env_copy(void* _raw)")
        (and
          (contains-text? &c ".copy = (void*)_carp_lambda_")
          (contains-text? &c "_copy->f0 = _env->f0;"))) (Result.Error _) false))

(defn initializes-recursive-closure-self-edge? []
  (match (CarpCompiler.compile-source
      "(register int-eq (Fn [Int Int] Bool) \"int_eq\")
(register int-dec (Fn [Int] Int) \"int_dec\")
(let [countdown (fn [n]
                   (if (int-eq n 1) n (countdown (int-dec n))))]
   (countdown 10))")
    (Result.Success c)
      (and
        (contains-text? &c ".f0 = ((Lambda){0})")
        (and
          (contains-text? &c
                          "_carp_env->f0 = ((Lambda){ .callback = _carp_self.callback")
          (contains-text? &c ".env = _copy, .delete = NULL, .copy = NULL")))
    (Result.Error _) false))

(defn array-set-deletes-replaced-element? []
  (match (CarpCompiler.compile-source
      "(register string-copy (Fn [(Ref String)] String) \"String_copy\")
(implements copy string-copy)
(register string-delete (Fn [String] ()) \"String_delete\")
(implements delete string-delete)
(let [xs [@\"a\"]]
   (aset! &xs 0 @\"b\"))")
    (Result.Success c)
      (contains-text? &c "String_delete(((String*)arg0->data)[arg1]);")
    (Result.Error _) false))

(defn compiles-polymorphic-nominal-applications? []
  (match (CarpCompiler.compile-source "(deftype (Choice a) (Some [a]) (None))
(defn int-code [choice] (match choice (Choice.Some value) value (Choice.None) 0))
(defn bool-code [choice] (match choice (Choice.Some value) (if value 84 70) (Choice.None) 78))
(int-code (Choice.Some 73))
(bool-code (Choice.Some true))") (Result.Success c)
      (let [int-name (Result.from-success
              (CAbi.nominal-name "Choice" &[(Box.init (Type.integer))])
              @"")
            bool-name (Result.from-success
              (CAbi.nominal-name "Choice" &[(Box.init (Type.boolean))])
              @"")]
        (and
          (contains-text? &c
                          &(String.concat
                            &[@"typedef struct " (String.copy &int-name)]))
          (and
            (contains-text? &c
                            &(String.concat
                              &[@"typedef struct " (String.copy &bool-name)]))
            (and (contains-text? &c "int member_0;")
                 (contains-text? &c "bool member_0;"))))) (Result.Error _) false))

(defn compiles-nested-constructor-patterns? []
  (match (CarpCompiler.compile-source "(deftype Inner (Value [Int]) (Empty))
(deftype Outer (Wrap [Inner]) (Other))
(defn code [outer] (match outer (Outer.Wrap (Inner.Value value)) value (Outer.Wrap (Inner.Empty)) 69 (Outer.Other) 79))
(code (Outer.Wrap (Inner.Value 78)))") (Result.Success c)
      (and
        (contains-text? &c
                        "match_0.tag == 0 && (match_0.data.variant_0.member_0.tag == 0)")
        (contains-text? &c
                        "match_0.data.variant_0.member_0.data.variant_0.member_0;")) (Result.Error _)
      false))

(defn compiles-signature-only-nominal-layouts? []
  (match (CarpCompiler.compile-source "(deftype Inner (Value [Int]) (Empty))
(deftype Outer (Wrap [Inner]) (Other))
(deftemplate make-outer (Fn [] Outer) \"Outer $NAME(void)\" \"$DECL { Outer outer; return outer; }\")
(defn code [outer] (match outer (Outer.Wrap (Inner.Value value)) value (Outer.Wrap (Inner.Empty)) 69 (Outer.Other) 79))
(code (make-outer))") (Result.Success c)
      (let [inner-at (String.index-of-string &c "struct Inner {")
            outer-at (String.index-of-string &c "struct Outer {")]
        (and (Int.>= inner-at 0)
             (and (Int.> outer-at inner-at)
                  (contains-text? &c "Inner member_0;")))) (Result.Error _)
      false))

(defn loads-real-core-gensym? []
  ;; quasiquote is real Core code now, so the backtick in the probe macro
  ;; needs Quasiquote.carp (and the List/Dynamic helpers its expansion calls)
  ;; loaded exactly like Gensym.carp itself.
  (let [macros-source (IO.unsafe-read-file &(core-path "Macros.carp"))
        gensym-source (IO.unsafe-read-file &(core-path "Gensym.carp"))
        quasiquote-source (IO.unsafe-read-file &(core-path "Quasiquote.carp"))
        list-source (IO.unsafe-read-file &(core-path "List.carp"))
        dynamic-source (IO.unsafe-read-file &(core-path "Dynamic.carp"))
        sources [(ModuleSource.init (String.copy "root.carp")
                                    (String.copy "root.carp")
                                    (String.copy "(load \"Macros.carp\")
(load \"List.carp\")
(load \"Gensym.carp\")
(load \"Quasiquote.carp\")
(load \"Dynamic.carp\")
(defmacro answer [] (let [g (gensym)] `(let [%g 42] %g)))
(answer)"))
                 (ModuleSource.init (String.copy "Macros.carp")
                                    (String.copy "Macros.carp")
                                    macros-source)
                 (ModuleSource.init (String.copy "Gensym.carp")
                                    (String.copy "Gensym.carp")
                                    gensym-source)
                 (ModuleSource.init (String.copy "Quasiquote.carp")
                                    (String.copy "Quasiquote.carp")
                                    quasiquote-source)
                 (ModuleSource.init (String.copy "List.carp")
                                    (String.copy "List.carp")
                                    list-source)
                 (ModuleSource.init (String.copy "Dynamic.carp")
                                    (String.copy "Dynamic.carp")
                                    dynamic-source)]
        root (String.copy "root.carp")
        ;; the driver marks Dynamic as a prelude so quasiquote's helpers
        ;; resolve bare; this standalone registry compile mirrors that.
        config (ExpandConfig.init [@"Dynamic"])]
    (match (CarpCompiler.compile-sources-with &sources &root &config)
      (Result.Success c) (contains-text? &c "42")
      (Result.Error _) false)))

(defn deep-deletes-managed-array-element-payloads? []
  ;; regression guard for the shallow-free class: an inline lowering that
  ;; frees an (Array String)'s data without deleting the elements leaks every
  ;; payload (the gen-2 self-compile balloon). Both owned-array sites -- a
  ;; let-bound local and a hoisted literal temporary -- must be freed through
  ;; the per-instance deep deleter (element loop, then data), never through a
  ;; bare data free at the scope exit.
  (match (CarpCompiler.compile-source "(defmodule String
  (register delete (Fn [String] ()) \"String_delete\")
  (register copy (Fn [&String] String) \"String_copy\"))
(implements delete String.delete)
(implements copy String.copy)
(defn f [] (let [xs [@\"a\" @\"bb\"]] 0))
(defn g [] (Array.length &[@\"a\" @\"bb\"]))
(f)
(g)") (Result.Success c)
      (and (contains-text? &c "Array_x46_delete")
           (and
             (contains-text? &c "String_delete(((String*)")
             (and
               (not (contains-text? &c "CARP_FREE((xs"))
               (not (contains-text? &c "CARP_FREE((_hoist"))))) (Result.Error _)
      false))

(defn never-silently-defers-primitive-value-lowering? []
  ;; a primitive whose call sites are inlined has a prototype but no body, so
  ;; referencing it as a VALUE must either be rejected with a diagnostic (the
  ;; current behavior) or come with an emitted definition -- it must never
  ;; type-check into a translation unit that cannot link. The occurrence count
  ;; approximates linkability: prototype + definition + construction site.
  (match (CarpCompiler.compile-source
      "(defn use-it [] (let [f Array.unsafe-nth xs [10 20 30]] 0))
(use-it)")
    (Result.Error _) true
    (Result.Success c) (Int.>= (text-occurrences &c "unsafe_x45_nth") 3)))

;; load resolution follows the reference: the name as given (relative to the
;; working directory), then the loading file's directory, then Core. a local
;; file therefore shadows the Core file it is named after.
(defn core-dir []
  (let [prefix (core-prefix)]
    (String.prefix &prefix (Int.dec (String.length &prefix)))))

(defn resolved-load-path [requester name]
  (match (resolve-load-target &(core-dir) requester name)
    (Maybe.Just found) (String.copy (Pair.a &found))
    (Maybe.Nothing) @""))

(defn loads-a-neighbouring-file-before-core? []
  (let [path (resolved-load-path "test/load-fixtures/root.carp" "Maybe.carp")]
    (and
      (contains-text? &path "test/load-fixtures/Maybe.carp")
      (not (contains-text? &path "core")))))

(defn loads-the-working-directory-before-the-loading-file? []
  (let [path (resolved-load-path "test/load-fixtures/root.carp"
                                 "test/load-fixtures/Maybe.carp")]
    (and
      (contains-text? &path "test/load-fixtures/Maybe.carp")
      (not (contains-text? &path "load-fixtures/test")))))

(defn falls-back-to-core-for-unshadowed-names? []
  (contains-text?
    &(resolved-load-path "test/other/root.carp" "Maybe.carp")
    "core/Maybe.carp"))

(defn expands-float-macro-arithmetic? []
  ;; compile-time numbers are two-domain with width promotion, like the
  ;; reference's (commandArith/promoteNumber): (+ 1.5 2.25) computes at
  ;; expansion time. Reference parity across the numeric surface is guarded
  ;; by test/expansion-corpus/numeric-promotion.carp through diff-expansion.
  (match (CarpCompiler.compile-source "(defmacro f [] (+ 1.5 2.25))
(register sink (Fn [Double] Int) \"sink\")
(defn main [] (sink (f)))") (Result.Success c) (contains-text? &c "3.75") (Result.Error _)
      false))

(defn rejects-sequential-move-after-move? []
  ;; regression guard: the flow-sensitive check flags a second consuming move
  ;; of an owned value (the reference rejects this as "Using a given-away
  ;; value"). Before 2026-08-24 only borrows-after-move were detected and the
  ;; emitted C consumed the value twice.
  (match (CarpCompiler.compile-source "(register-type Widget)
(register make-widget (Fn [] Widget) \"make_widget\")
(register consume (Fn [Widget] ()) \"consume_widget\")
(defmodule Widget (register delete (Fn [Widget] ()) \"widget_delete\"))
(implements delete Widget.delete)
(defn f [] (let [w (make-widget)] (do (consume w) (consume w))))
(f)") (Result.Error _) true (Result.Success _) false))

(defn rejects-loop-carried-move? []
  ;; the loop pass re-analyzes a while body against the first pass's moved
  ;; set, so a move that repeats across iterations is a use-after-move even
  ;; though each single iteration looks fine.
  (match (CarpCompiler.compile-source "(register-type Widget)
(register make-widget (Fn [] Widget) \"make_widget\")
(register consume (Fn [Widget] ()) \"consume_widget\")
(register flip (Fn [] Bool) \"flip2\")
(defmodule Widget (register delete (Fn [Widget] ()) \"widget_delete\"))
(implements delete Widget.delete)
(defn f [] (let [w (make-widget)] (while (flip) (consume w))))
(f)") (Result.Error _) true (Result.Success _) false))

(defn rejects-set-after-move? []
  ;; a `set!` into a binding whose value was given away is rejected, as the
  ;; reference does ("Using a given-away value"). Accepting it made the set!
  ;; site free the moved value a second time and leak the new one.
  (match (CarpCompiler.compile-source "(register-type Widget)
(register make-widget (Fn [] Widget) \"make_widget\")
(register consume (Fn [Widget] ()) \"consume_widget\")
(register flip (Fn [] Bool) \"flip2\")
(defmodule Widget (register delete (Fn [Widget] ()) \"widget_delete\"))
(implements delete Widget.delete)
(defn f [] (let [w (make-widget)] (do (consume w) (set! w (make-widget)) 0)))
(f)") (Result.Error _) true (Result.Success _) false))

(defn rejects-set-after-conditional-move? []
  ;; moved on one path is enough: the old value is dead on that path, live on
  ;; the other, and the set! site cannot tell which.
  (match (CarpCompiler.compile-source "(register-type Widget)
(register make-widget (Fn [] Widget) \"make_widget\")
(register consume (Fn [Widget] ()) \"consume_widget\")
(register flip (Fn [] Bool) \"flip2\")
(defmodule Widget (register delete (Fn [Widget] ()) \"widget_delete\"))
(implements delete Widget.delete)
(defn f [] (let [w (make-widget)] (do (if (flip) (consume w) ()) (set! w (make-widget)) 0)))
(f)") (Result.Error _) true (Result.Success _) false))

(defn rejects-loop-carried-set-after-move? []
  ;; the second iteration's set! sees the first iteration's move.
  (match (CarpCompiler.compile-source "(register-type Widget)
(register make-widget (Fn [] Widget) \"make_widget\")
(register consume (Fn [Widget] ()) \"consume_widget\")
(register flip (Fn [] Bool) \"flip2\")
(defmodule Widget (register delete (Fn [Widget] ()) \"widget_delete\"))
(implements delete Widget.delete)
(defn f [] (let [w (make-widget)] (do (while (flip) (do (set! w (make-widget)) (consume w))) 0)))
(f)") (Result.Error _) true (Result.Success _) false))

(defn accepts-loop-self-rebind? []
  ;; a self-rebind consumes the old value inside the new one, so every
  ;; iteration's set! finds the binding owned again.
  (match (CarpCompiler.compile-source "(register-type Widget)
(register make-widget (Fn [] Widget) \"make_widget\")
(register consume (Fn [Widget] ()) \"consume_widget\")
(register flip (Fn [] Bool) \"flip2\")
(defmodule Widget (register delete (Fn [Widget] ()) \"widget_delete\"))
(implements delete Widget.delete)
(register update-widget (Fn [Widget] Widget) \"update_widget\")
(defn f [] (let [w (make-widget)] (do (while (flip) (set! w (update-widget w))) 0)))
(f)") (Result.Success _) true (Result.Error _) false))

(defn qualified-member-falls-back-to-unique-member? []
  ;; `A.join` names a member module A lacks: the reference's last lookup is
  ;; the bare name everywhere, and one module has it (`Array.join` is core's
  ;; `String.join`).
  (match (CarpCompiler.compile-source "(defmodule S (defn join [x] x))
(defmodule A (defn other [] 0))
(defn f [] (A.join 1))
(f)") (Result.Success _) true (Result.Error _) false))

(defn rejects-qualified-member-with-several-candidates? []
  ;; several modules have it: a qualified multisym, which the reference
  ;; rejects rather than dispatching
  (match (CarpCompiler.compile-source "(defmodule S (defn join [x] x))
(defmodule R (defn join [x] x))
(defmodule A (defn other [] 0))
(defn f [] (A.join 1))
(f)") (Result.Error _) true (Result.Success _) false))

(defn module-scoped-use-pins-its-candidate? []
  ;; a `use` inside a module picks its lone candidate outright, like a
  ;; top-level one. Joining every module's `make` into a type-dispatched set
  ;; left the result type free here, so `U.f` never specialized.
  (match (CarpCompiler.compile-source "(defmodule P (defn make [] 1))
(defmodule Q (defn make [] true))
(defmodule U (use P) (defn f [] (make)))
(U.f)") (Result.Success _) true (Result.Error _) false))

(defn scoped-use-joins-the-implicit-string-use? []
  ;; the reference starts every program with `(use String)`, so a module's own
  ;; `use` shares a name with String's rather than pinning it, and the types
  ;; decide (core's Filepath calls `concat` on strings under `(use Array)`)
  (match (CarpCompiler.compile-source
      "(defmodule A (register cat (Fn [Int] Int) \"a_cat\"))
(defmodule String (register cat (Fn [Bool] Bool) \"s_cat\"))
(register bool-sink (Fn [Bool] Int) \"bool_sink\")
(defmodule U (use A) (defn f [] (bool-sink (cat true))))
(U.f)")
    (Result.Success c) (contains-text? &c "s_cat")
    (Result.Error _) false))

(def overload-prelude "(defmodule A (register wrap (Fn [Int] Int) \"a_wrap\"))
(defmodule B (register wrap (Fn [Bool] Bool) \"b_wrap\"))
(use A) (use B)
(register sink (Fn [a] Int) \"sink\")
")

(defn overload-narrowed-by-argument? []
  ;; `wrap` is ambiguous between A's and B's; the argument leaves B's, and
  ;; inference commits to it, so the result has a type even though only a
  ;; generic sink consumes it (the choice used to wait for specialization,
  ;; which found the result still free)
  (match (CarpCompiler.compile-source
      &(String.append overload-prelude "(defn f [] (sink (wrap true)))
(f)"))
    (Result.Success c) (contains-text? &c "b_wrap(")
    (Result.Error _) false))

(defn overload-choice-travels-with-a-generic-caller? []
  ;; `g` is generic over the open choice; its scheme carries it, so the use
  ;; `(g true)` settles it there (a qualified type)
  (match (CarpCompiler.compile-source
      &(String.append overload-prelude "(defn g [x] (wrap x))
(defn f [] (sink (g true)))
(f)"))
    (Result.Success c) (contains-text? &c "b_wrap(")
    (Result.Error _) false))

(defn rejects-undecidable-overload? []
  ;; nothing constrains `make`'s result, so no candidate can ever be chosen
  (match (CarpCompiler.compile-source
      &(String.append overload-prelude
                      "(defmodule P (register make (Fn [] Int) \"p_make\"))
(defmodule Q (register make (Fn [] Bool) \"q_make\"))
(use P) (use Q)
(defn f [] (sink (make)))
(f)"))
    (Result.Success _) false
    (Result.Error error)
      (contains-text? (CompileError.message &error) "ambiguous make")))

(defn rejects-overload-no-candidate-fits? []
  (match (CarpCompiler.compile-source
      &(String.append overload-prelude "(register str-lit (Fn [] String) \"s\")
(defn f [] (sink (wrap (str-lit))))
(f)"))
    (Result.Success _) false
    (Result.Error error)
      (contains-text? (CompileError.message &error) "no candidate of wrap")))

(defn with-uses-its-module-only-inside? []
  ;; `(with G ...)` is a `use` for its own body, as the reference's
  ;; `qualifyWith` makes it. It used to be recorded as a top-level `use`, so
  ;; `pick` outside the block was ambiguous between G's and H's (core's
  ;; `(with Generics ...)` did the same to every program).
  (match (CarpCompiler.compile-source
      "(defmodule G (register pick (Fn [Int] Int) \"g_pick\"))
(defmodule H (register pick (Fn [Int] Int) \"h_pick\"))
(use H)
(with G (defn a [] (pick 1)))
(defn b [] (pick 2))
(b)")
    (Result.Success c) (contains-text? &c "h_pick(")
    (Result.Error _) false))

(defn matches-a-constructor-two-types-share? []
  ;; `X` names a constructor of both used types: the subject decides which
  (match (CarpCompiler.compile-source "(deftype A (X []) (Y []))
(deftype B (X []) (Z []))
(use A) (use B)
(register sink (Fn [Int] Int) \"sink\")
(defn f [v] (match v X 1 _ 2))
(defn g [] (sink (f (A.Y))))
(g)") (Result.Success _) true (Result.Error _) false))

(defn types-a-field-mutator-by-its-field? []
  ;; `set-xs!` writes through `field-set!`, which takes any value: only the
  ;; field's declared type can type `[]` here. The derived body used to drop
  ;; that signature, leaving the setter generic in its value.
  (match (CarpCompiler.compile-source "(deftype T [x Int])
(deftype S [xs (Array T)])
(defn f [s] (S.set-xs! s []))
(defn g [] (let [s (S.init [])] (do (f &s) 0)))
(g)") (Result.Success _) true (Result.Error _) false))

(def global-initializer-source "(deftype M (J [Int]) (N []))
(register mk (Fn [] M) \"mk\")
(register plus (Fn [Int Int] Int) \"plus\")
(def x (match (mk) (M.J v) v (M.N) 0))
(def y (match (mk) (M.J v) v (M.N) 0))
(defn early [] x)
(def z (plus (early) 1))
(defn use-it [] (plus y z))
(use-it)")

(defn scopes-each-global-initializer? []
  ;; both initializers render a `match_0`; they share `carp_init_globals`, so
  ;; each needs a block of its own or the second is a C redeclaration
  (match (CarpCompiler.compile-source global-initializer-source)
    (Result.Success c) (contains-text? &c "argv;
  {
    M match_0")
    (Result.Error _) false))

(defn orders-a-global-after-what-its-functions-read? []
  ;; `z` calls `early`, which reads `x`: `x` has to be initialized first
  (match (CarpCompiler.compile-source global-initializer-source)
    (Result.Success c)
      (let [x-at (String.index-of-string &c "C1_x__I = ")
            z-at (String.index-of-string &c "C1_z__I = ")]
        (and (Int.>= x-at 0) (Int.< x-at z-at)))
    (Result.Error _) false))

(defn records-a-flag-a-top-level-when-selects? []
  ;; the reference evaluates what a top-level macro expands to at the top
  ;; level: `when` becomes an `if`, which picks its branch at compile time, and
  ;; the command in it runs. Only the literal `(add-cflag ...)` form used to
  ;; register, so a platform-conditional flag was dropped.
  (let-do [compiled (CarpCompiler.compile-source
             "(defmacro when [c body] (list (quote if) c body (quote ())))
(when true (add-cflag \"-DCARP_WHEN_TAKEN\"))
(when false (add-cflag \"-DCARP_WHEN_SKIPPED\"))
(defn f [] 0)
(f)")
           flags (CtEval.collected-cflags)]
    (and (Result.success? &compiled)
         (and
           (Array.contains? &flags "-DCARP_WHEN_TAKEN")
           (not (Array.contains? &flags "-DCARP_WHEN_SKIPPED"))))))

(defn deletes-generically-declared-owners? []
  ;; `(Cell a)` owns a heap cell no field of it accounts for, and says so with
  ;; one deleter written for every instance — the shape core's `Box` has. The
  ;; instance has to reach THAT body: a deleter derived beside it frees only
  ;; what the declaration shows, which here is a `Ptr`, and so nothing at all.
  (match (CarpCompiler.compile-source "(deftype (Cell a) [data (Ptr a)])
(register cell-alloc (Fn [a] (Ptr a)))
(register cell-free (Fn [(Ptr a)] ()))
(defmodule Cell
  (sig delete (Fn [(Cell a)] ()))
  (defn delete [c] (cell-free @(Cell.data &c)))
  (implements delete Cell.delete)
  (sig make (Fn [a] (Cell a)))
  (defn make [v] (Cell.init (cell-alloc v))))
(defn run [] (let [c (Cell.make 1)] 0))
(run)")
    (Result.Success c)
      (and
        ;; the user's body ran...
        (contains-text? &c "cell_MINUS_free")
        ;; ...and the deleter is declared, defined and called once each, so it
        ;; is not the deleter calling itself
        (Int.= 3
               (text-occurrences &c
                                 "C15_Cell_x46_delete__F1_12_N4_Cell1_1_IZ1_U(")))
    (Result.Error _) false))

(defn lays-records-out-flat? []
  ;; a record carries its own named fields, which is what a C template that
  ;; names them (`c.data = p`, as core's `Box.from-ptr` does) compiles against
  (match (CarpCompiler.compile-source "(deftype (Cell a) [data (Ptr a)])
(register null-ptr (Fn [] (Ptr Int)) \"null_ptr\")
(deftemplate raw (Fn [(Ptr a)] (Cell a)) \"Cell__$a $NAME($a* p)\"
  \"$DECL { Cell__$a c; c.data = p; return c; }\")
(defn code [] (Cell.data &(raw (null-ptr))))
(code)") (Result.Success c) (contains-text? &c "struct Cell__int {
  int* data;
};") (Result.Error _) false))

(defn deletes-a-root-scope-binding? []
  ;; a top-level `let` is a scope like any other. The ownership plan always
  ;; scheduled this delete; lowering dropped it, because the roots array was
  ;; the one place that never ran the cleanup pass a definition body and a
  ;; lifted closure both get.
  (match (CarpCompiler.compile-source "(register make (Fn [] String))
(register drop-it (Fn [String] ()))
(implements delete drop-it)
(let [s (make)] 0)") (Result.Success c) (contains-text? &c "drop_MINUS_it(s)") (Result.Error _)
      false))

(defn reads-back-recorded-metadata? []
  ;; `meta-set!` annotates a binding and `meta` reads it back inside a later
  ;; macro — the shape core's `docexample` and `print-docexample` are built
  ;; from. Expansion is the only pass that sees both in source order.
  (match (CarpCompiler.compile-source "(meta-set! answer \"seed\" 7)
(defmacro example [] (meta answer \"seed\"))
(defn answer [] (example))
(answer)") (Result.Success c) (contains-text? &c "return 7;") (Result.Error _)
      false))

(defn answers-nil-for-an-annotation-never-made? []
  ;; an annotation the program never made answers with the empty list, so the
  ;; function it is spliced into types as unit rather than failing to compile
  (match (CarpCompiler.compile-source
      "(defmacro example [] (meta answer \"nope\"))
(defn answer [] (example))
(answer)")
    (Result.Success c) (contains-text? &c "void C6_answer__F0_Z1_U(void)")
    (Result.Error _) false))

(defn deletes-what-a-container-element-owns? []
  ;; a field typed `(Array (Cell Owned))` needs the CELL's deleter too:
  ;; `Array` declares no constructors, so the worklist skipped it, nothing
  ;; derived one for the element, and the array deleter freed its buffer and
  ;; leaked everything the elements owned
  (match (CarpCompiler.compile-source "(register-type Owned)
(register own-free (Fn [Owned] ()))
(implements delete own-free)
(deftype (Cell a) [value a])
(deftype Holder [cells (Array (Cell Owned))])
(register make (Fn [] Holder))
(defn use-it [] (let [h (make)] 0))
(use-it)")
    (Result.Success c)
      (and (contains-text? &c "Cell_x46_delete")
           ;; the array deleter walks its elements rather than only freeing
           ;; the buffer
           (contains-text? &c "own_MINUS_free"))
    (Result.Error _) false))
(defn types-an-expression? []
  ;; `type` infers an expression against everything expansion has finished,
  ;; and hands the type back as syntax a macro can splice
  (match (CarpCompiler.compile-source "(register seed (Fn [] Int))
(defmacro kind [] (type (seed)))
(defn answer [] (the (kind) (seed)))
(answer)") (Result.Success c) (contains-text? &c "int C6_answer__F0_Z1_I(void)") (Result.Error _)
      false))

(defn static-aset-deletes-the-displaced-element? []
  ;; `StaticArray.aset!` overwrites a slot in place, so the element it
  ;; replaces has to be freed at the write, as the reference does. The
  ;; array's scope-exit delete frees elements too, so look for the delete of
  ;; the written slot itself.
  (match (CarpCompiler.compile-source "(register-type Owned)
(register own-free (Fn [Owned] ()))
(implements delete own-free)
(register make (Fn [] Owned))
(defn use-it []
  (let [a $[(make) (make)]]
    (do (StaticArray.aset! a 0 (make)) 0)))
(use-it)") (Result.Success c)
      (contains-text? &c
                      "own_MINUS_free(((Owned*)(*_carp_asa).data)[_carp_asi])") (Result.Error _)
      false))

(defn static-array-literal-owns-frame-storage? []
  ;; a function's `$[...]` is a temporary of the enclosing scope, as in the
  ;; reference: every evaluation gets its own storage (a `static` buffer made
  ;; recursive calls share one array), and the elements are deleted when the
  ;; scope ends (they used to leak on every call).
  (match (CarpCompiler.compile-source "(register-type Owned)
(register own-free (Fn [Owned] ()))
(implements delete own-free)
(register make (Fn [] Owned))
(defn use-it [] (let [a $[(make) (make)]] 0))
(use-it)") (Result.Success c)
      (and (not (contains-text? &c "static Owned"))
           (contains-text? &c "StaticArray_x46_delete")) (Result.Error _) false))

(defn unmanaged-static-array-literal-has-no-delete? []
  ;; elements that own nothing leave the array owning nothing
  (match (CarpCompiler.compile-source "(defn use-it [] (let [a $[1 2]] 0))
(use-it)") (Result.Success c)
      (and (not (contains-text? &c "static int"))
           (not (contains-text? &c "StaticArray_x46_delete"))) (Result.Error _)
      false))

(defn global-static-array-keeps-static-storage? []
  ;; a global's value outlives any scope, so its literal stays static
  (match (CarpCompiler.compile-source "(def nums $[1 2])
(defn use-it [] (StaticArray.length nums))
(use-it)") (Result.Success c)
      (contains-text? &c "static int _carp_static_array_data") (Result.Error _)
      false))

(deftest t
  (assert-true t
    (register-type-keeps-fields-after-a-c-name?)
    "a registered type with a C name keeps its fields")
  (assert-true t
    (register-type-keeps-fields-without-a-c-name?)
    "a registered type without a C name keeps its fields")
  (assert-true t
    (compiles-source-through-expansion?)
    "compiler composes expansion through C assembly")
  (assert-true t
    (compiles-loaded-source-registry?)
    "compiler composes deterministic module loading")
  (assert-true t
    (emits-library-without-process-entry?)
    "library emission retains named roots without a process entry point")
  (assert-true t
    (library-roots-emit-the-requested-entry?)
    "an embedder's library keeps the root it asked for and has no main")
  (assert-true t
    (library-roots-reject-what-they-cannot-emit?)
    "an unknown or generic library root is an error that names it")
  (assert-true t
    (library-initializes-globals-at-load?)
    "a library initializes its globals when it loads")
  (assert-true t
    (library-rejects-top-level-expressions?)
    "a library with top-level expressions is an error")
  (assert-true t
    (library-accepts-inert-top-level-values?)
    "a library may carry inert top-level values")
  (assert-true t
    (library-exports-only-its-roots?)
    "a library gives everything but its roots internal linkage")
  (assert-true t
    (registered-accessor-name-keeps-its-own-c?)
    "a registered accessor name keeps the module's own c")
  (assert-true t
    (own-accessor-definition-satisfies-derivation?)
    "a module's own definition of an accessor name satisfies derivation")
  (assert-true t
    (missing-accessor-builtin-fails-derivation?)
    "an accessor without its builtin fails derivation, not the c link")
  (assert-true t
    (library-registered-accessors-are-static?)
    "a registered type's accessors are internal to a library")
  (assert-true t
    (executable-keeps-external-linkage?)
    "an executable's linkage is unchanged")
  (assert-true t
    (library-rejects-builtin-roots?)
    "a registered builtin is not a library root")
  (assert-true t
    (cli-library-roots-are-public-definitions?)
    "the CLI roots a library at its public definitions")
  (assert-true t
    (preserves-system-includes?)
    "compiler preserves source-requested system includes")
  (assert-true t
    (compiles-scalar-global-values?)
    "compiler emits reachable scalar global values")
  (assert-true t
    (compiles-runtime-global-initializers?)
    "compiler emits startup initialization for nonconstant scalar globals")
  (assert-true t (reports-phase-errors?) "compiler reports the rejecting phase")
  (assert-true t
    (emits-managed-delete?)
    "an owned local is initialized and its scheduled deleter is emitted")
  (assert-true t
    (emits-delete-after-owned-self-rebind?)
    "an owned local remains owned and is deleted after rebinding through itself")
  (assert-true t
    (emits-scope-delete-after-owned-overwrite?)
    "an owned replacement is deleted at scope exit after set! drops the old value")
  (assert-true t
    (array-set-deletes-replaced-element?)
    "array set deletes a managed element before replacing it")
  (assert-true t
    (compiles-managed-return-with-root-cleanup?)
    "an owned value is moved out through a managed return and deleted at the root")
  (assert-true t
    (compiles-managed-parameter-cleanup?)
    "an owned parameter the body does not consume is deleted at function exit")
  (assert-true t
    (compiles-discarded-temporary-cleanup?)
    "an owned temporary discarded mid-body is deleted at the discard point")
  (assert-true t
    (compiles-match-branch-cleanup?)
    "an owned local inside a match branch is deleted before the branch returns")
  (assert-true t
    (derives-managed-deftype-deleter?)
    "a deftype owning memory through a field gets a derived deleter that frees it")
  (assert-true t
    (derives-sum-deftype-deleter?)
    "a sum deftype gets a derived deleter with a branch per constructor")
  (assert-true t
    (derives-generic-deftype-deleter?)
    "a generic deftype instance gets a per-instance derived deleter")
  (assert-true t
    (derives-mixed-generic-deleter?)
    "a mixed generic instance deletes only its managed field, ignoring the rest")
  (assert-true t
    (lowers-by-reference-match?)
    "a match-ref lowers to pointer member access with reference bindings")
  (assert-true t
    (derives-managed-deftype-copier?)
    "a managed deftype gets a derived copy that deep-copies managed fields")
  (assert-true t
    (derives-generic-deftype-copier?)
    "a mixed generic instance gets a copy that copies managed and blits the rest")
  (assert-true t
    (emits-concrete-generic-sum-copier?)
    "a concrete generic sum copy emits the derived copier body")
  (assert-true t
    (emits-single-constructor-sum-copier?)
    "a sum with a single constructor emits the derived copier body")
  (assert-true t
    (emits-closure-environment-copier?)
    "capturing closures expose a deep-copy callback for their environment")
  (assert-true t
    (initializes-recursive-closure-self-edge?)
    "recursive closures initialize and copy their self edge without ownership")
  (assert-true t
    (compiles-polymorphic-nominal-applications?)
    "compiler specializes distinct polymorphic nominal applications")
  (assert-true t
    (compiles-nested-constructor-patterns?)
    "compiler preserves and lowers nested constructor patterns")
  (assert-true t
    (compiles-signature-only-nominal-layouts?)
    "compiler discovers dependency-ordered nominal layouts from signatures")
  (assert-true t
    (loads-real-core-gensym?)
    "a user macro drives gensym loaded from the reference Core Gensym.carp")
  (assert-true t
    (deep-deletes-managed-array-element-payloads?)
    "an owned managed-element array is freed through the deep per-instance deleter")
  (assert-true t
    (never-silently-defers-primitive-value-lowering?)
    "a primitive referenced as a value is rejected or emitted with a definition")
  (assert-true t
    (rejects-sequential-move-after-move?)
    "moving an owned value twice in sequence is rejected")
  (assert-true t
    (rejects-loop-carried-move?)
    "moving an owned value inside a loop body is rejected")
  (assert-true t
    (records-a-flag-a-top-level-when-selects?)
    "a command a top-level when selects runs at compile time")
  (assert-true t
    (scopes-each-global-initializer?)
    "each global initializer gets a block of its own")
  (assert-true t
    (orders-a-global-after-what-its-functions-read?)
    "a global initializes after what its called functions read")
  (assert-true t
    (types-a-field-mutator-by-its-field?)
    "a field mutator's value is typed by the field")
  (assert-true t
    (qualified-member-falls-back-to-unique-member?)
    "a qualified member the module lacks resolves to the one module that has it")
  (assert-true t
    (rejects-qualified-member-with-several-candidates?)
    "a qualified member several modules have is rejected")
  (assert-true t
    (module-scoped-use-pins-its-candidate?)
    "a module-scoped use pins its lone candidate")
  (assert-true t
    (scoped-use-joins-the-implicit-string-use?)
    "a module-scoped use shares a name with the implicit use of String")
  (assert-true t
    (overload-narrowed-by-argument?)
    "inference chooses an overload candidate by argument type")
  (assert-true t
    (overload-choice-travels-with-a-generic-caller?)
    "an open overload choice is part of a generic caller's scheme")
  (assert-true t
    (rejects-undecidable-overload?)
    "an overload nothing can decide is ambiguous")
  (assert-true t
    (rejects-overload-no-candidate-fits?)
    "an overload with no fitting candidate is an error")
  (assert-true t
    (with-uses-its-module-only-inside?)
    "a with block uses its module only inside itself")
  (assert-true t
    (matches-a-constructor-two-types-share?)
    "a constructor two used types share is chosen by the subject")
  (assert-true t
    (rejects-set-after-move?)
    "a set! into a binding whose value was moved is rejected")
  (assert-true t
    (rejects-set-after-conditional-move?)
    "a set! into a binding moved on one path is rejected")
  (assert-true t
    (rejects-loop-carried-set-after-move?)
    "a set! into a binding moved by the previous iteration is rejected")
  (assert-true t
    (accepts-loop-self-rebind?)
    "a self-rebind in a loop is accepted")
  (assert-true t
    (loads-a-neighbouring-file-before-core?)
    "a file next to the loading file shadows the Core file it is named after")
  (assert-true t
    (loads-the-working-directory-before-the-loading-file?)
    "a working-directory path wins over the loading file's directory")
  (assert-true t
    (falls-back-to-core-for-unshadowed-names?)
    "an unshadowed name still resolves to Core")
  (assert-true t
    (expands-float-macro-arithmetic?)
    "compile-time arithmetic handles floats the way the reference does")
  (assert-true t
    (deletes-generically-declared-owners?)
    "a deleter declared once for every instance of a type still runs")
  (assert-true t
    (deletes-a-root-scope-binding?)
    "a top-level let frees what it binds")
  (assert-true t
    (types-an-expression?)
    "type infers an expression and hands back the type")
  (assert-true t
    (reads-back-recorded-metadata?)
    "meta reads back what meta-set! recorded")
  (assert-true t
    (answers-nil-for-an-annotation-never-made?)
    "meta answers an unrecorded annotation with nil")
  (assert-true t
    (deletes-what-a-container-element-owns?)
    "a container element's deleter is derived, not skipped")
  (assert-true t
    (static-aset-deletes-the-displaced-element?)
    "StaticArray.aset! deletes the element it overwrites")
  (assert-true t
    (static-array-literal-owns-frame-storage?)
    "a static array literal gets frame storage and its elements are deleted")
  (assert-true t
    (unmanaged-static-array-literal-has-no-delete?)
    "a static array of unmanaged elements needs no delete")
  (assert-true t
    (global-static-array-keeps-static-storage?)
    "a global static array literal keeps static storage")
  (assert-true t
    (lays-records-out-flat?)
    "a record is laid out with its own named fields, like the reference"))
