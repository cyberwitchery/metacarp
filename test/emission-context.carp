(load "../carp-compiler.carp")
(Project.no-echo)
(load "Test.carp")
(use-all Test)

(defn capture-source [] @"(register-type Widget)
(register make-widget (Fn [] Widget) \"make_widget\")
(register copy-widget (Fn [(Ref Widget)] Widget) \"widget_copy\")
(implements copy copy-widget)
(register free-widget (Fn [Widget] ()) \"widget_delete\")
(implements delete free-widget)
(register read-widget (Fn [(Ref Widget)] Int) \"widget_read\")
(defn capture [] (let [value (make-widget)] (fn [] (read-widget &value))))
(capture)")

(defn stable-emission? [interleave sections]
  (match (CarpCompiler.lower-source &(capture-source))
    (Result.Success first)
      (match (if sections
          (CBackend.function-definitions &first)
          (CBackend.executable-translation-unit &first))
        (Result.Success before)
          (let [ready (if interleave
                  (Result.success?
                    &(CarpCompiler.lower-source "(defn answer [] 42) (answer)"))
                  true)]
            (and ready
                 (match (if sections
                     (CBackend.function-definitions &first)
                     (CBackend.executable-translation-unit &first))
                   (Result.Success after)
                     (and
                       (Int.>=
                         (String.index-of-string &before ".f0 = widget_copy(")
                         0)
                       (String.= &before &after))
                   (Result.Error _) false)))
        (Result.Error _) false)
    (Result.Error _) false))

(defn standalone-setter-deletes-displaced-field? []
  (match (CarpCompiler.lower-source "(register-type Gadget)
(register make-gadget (Fn [] Gadget) \"make_gadget\")
(register free-gadget (Fn [Gadget] ()) \"gadget_delete\")
(implements delete free-gadget)
(deftype Holder [value Gadget])
(defn replace [holder] (Holder.set-value! holder (make-gadget)))
(def held (Holder.init (make-gadget)))
(replace &held)") (Result.Success module)
      (match (CBackend.function-definitions &module)
        (Result.Success c)
          (Int.>= (String.index-of-string &c "gadget_delete(") 0)
        (Result.Error _) false) (Result.Error _) false))

(deftest t
  (assert-true t
    (stable-emission? false false)
    "rendering a module twice produces the same C")
  (assert-true t
    (stable-emission? true false)
    "lowering another module cannot change deferred C emission")
  (assert-true t
    (stable-emission? true true)
    "standalone function emission reads its own module's capture copiers")
  (assert-true t
    (standalone-setter-deletes-displaced-field?)
    "standalone function emission reads its own module's field deleters"))
