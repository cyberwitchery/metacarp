(load "../carp-types/pattern-typing.carp")
(load "../carp-specialize/carp-specialize.carp")

(doc OwnershipSite "is one expression in a specialization context. `context` is
the context's index and `expression` the expression's id. Ids repeat across
instances of one definition, so the context is needed.")
(deftype OwnershipSite [context Int
                        expression Int])

(doc OwnershipContext "is the namespace of `OwnershipSite` ids. `Definition`
holds an instance: the definition, its concrete type, its symbol, and the number
of ids it uses. `Roots` holds the number of ids of the top-level forms, which
share one context.")
(deftype OwnershipContext
  (Definition [CoreRef (Box MonoType) String Int])
  (Roots [Int]))

(doc OwnershipResource "is what owns a value. `Binding` holds a named binder.
`Temporary` holds the id of an unnamed temporary. `Result` is the value a body
returns.")
(deftype OwnershipResource
  (Binding [CoreRef])
  (Temporary [Int])
  (Result []))

(doc OwnershipBorrowMode "is the kind of a borrow. `Shared` allows other reads.
`Unique` is exclusive and allows mutation. No borrows are planned yet.")
(deftype OwnershipBorrowMode
  (Shared [])
  (Unique []))

(doc OwnershipProjection "is one step from a place to a part of it. `Deref` goes
through a reference. `Field` holds a field name. `Index` holds an array index,
and `Slice` the bounds of a slice. An unknown index or bound is `Nothing` and
overlaps every value.")
(deftype OwnershipProjection
  (Deref [])
  (Field [String])
  (Index [(Maybe Int)])
  (Slice [(Maybe Int) (Maybe Int)]))

(doc OwnershipPlace "is a place in memory: `root` and the `projections` from it.
Whoever builds a place must add a `Deref` for each step through a reference,
including from a reference-typed root, because `places-overlap?` only sees
aliasing through `Deref`s.")
(deftype OwnershipPlace
  [root OwnershipResource
   projections (Array OwnershipProjection)])

(doc OwnershipAction "is one step of an ownership plan. `Move` holds the site,
the resource moved from, the one moved to, and the type. `Borrow` holds the
site, the mode and the place; the planner does not make borrows yet. `Delete`
holds the site, the resource and the type. Copies are explicit calls, so there
is no copy action.")
(deftype OwnershipAction
  (Move [OwnershipSite OwnershipResource OwnershipResource (Box MonoType)])
  (Borrow [OwnershipSite OwnershipBorrowMode OwnershipPlace])
  (Delete [OwnershipSite OwnershipResource (Box MonoType)]))

(doc OwnershipRequirement "is work ownership planning adds. `DeleteFunction`
holds a type whose `delete` must be specialized before lowering.")
(deftype OwnershipRequirement (DeleteFunction [(Box MonoType)]))

(doc OwnershipPlan "is the ownership plan of a specialized module, kept beside
it. `contexts` holds the site namespaces. `actions` holds the moves and deletes.
`requirements` holds the deletes to specialize.")
(deftype OwnershipPlan
  [contexts (Array OwnershipContext)
   actions (Array OwnershipAction)
   requirements (Array OwnershipRequirement)])

(doc SpannedOwnershipAction "is an ownership `action` with the source `span` of
its site. Actions of generated code have no span.")
(deftype SpannedOwnershipAction [action OwnershipAction
                                 span (Maybe SourceSpan)])

(doc OwnershipError "is an ownership error. `message` describes it.")
(deftype OwnershipError [message String])

(doc BorrowOrigin "is where a reference borrows from. `Static` is a global or a
literal. `External` is a reference parameter, which outlives the body. `Local`
holds the local owners the borrow is into, which die at scope exit, so it must
not escape or outlive a move of them. An empty `Local` is a frame temporary.
`Param` is the same for by-value parameters. `None` means the value is not a
borrow.")
(deftype BorrowOrigin
  (Static [])
  (External [])
  (Local [(Array CoreRef)])
  (Param [(Array CoreRef)])
  (None []))

(doc BorrowState "is the borrow check state at one point. `moved` holds the
owners moved so far, including binders whose scope has ended and owned
parameters. `origins` holds the origin of every let binder in scope, which
`set!` can change.")
(deftype BorrowState
  [moved (Array CoreRef)
   origins (Array (Pair CoreRef BorrowOrigin))])

(doc OwnershipClass "is how a concrete type holds memory. `Owned` values must be
deleted. `Borrowed` values are references to memory others own. `Unmanaged`
values are plain data.")
(deftype OwnershipClass
  (Unmanaged [])
  (Owned [])
  (Borrowed []))

(doc OwnershipTypeFacts "says which concrete types own memory, by ABI key.
`owned` holds the types with a `delete`, including generic keys for deleters
declared for all instances. `unmanaged-override` holds types forced back to
unmanaged; nothing fills it yet. `deleters` holds the ids of the functions that
implement `delete`.")
(deftype OwnershipTypeFacts
  [owned (Array String)
   unmanaged-override (Array String)
   deleters (Array Int)])

(doc OwnershipClassify "classifies concrete types by how they hold memory.")
(defmodule OwnershipClassify
  (private has-key?)
  (hidden has-key?)
  (defn has-key? [keys key]
    (let-do [found false
             n (Array.length keys)]
      (for [i 0 n]
        (when (String.= (Array.unsafe-nth keys i) key) (set! found true)))
      found))

  (doc classify "returns how the concrete `type` holds memory, using `facts`.
References are borrowed. Functions and arrays are owned. A static array is owned
if its elements are. Other types are owned if they have a `delete`, for their
key or their generic key.")
  (defn classify [type facts]
    (match-ref type
      (MonoType.Reference _ _)
      (OwnershipClass.Borrowed)
      ;; A function value may carry a heap-allocated closure environment. Its
      ;; arity-specific runtime deleter is harmless for non-capturing lambdas
      ;; and required for capturing ones, so all concrete functions are owned.
      (MonoType.Function _ _)
      (OwnershipClass.Owned)
      ;; `Array` is a heap-managed builtin: it owns its allocation,
      ;; so a concrete instance always owns memory regardless of declared
      ;; deletes. A `StaticArray` value (a literal's scope storage) lives in
      ;; the frame, so it owns exactly what its elements own.
      (MonoType.Named name arguments)
      (cond
        (and (String.= name "Array") (Int.> (Array.length arguments) 0))
          (OwnershipClass.Owned)
        (and (String.= name "StaticArray") (Int.= (Array.length arguments) 1))
          (match (classify (Box.peek (Array.unsafe-nth arguments 0)) facts)
            (OwnershipClass.Owned) (OwnershipClass.Owned)
            _ (OwnershipClass.Unmanaged))
        (let [key (CAbi.type-key type)]
          (cond
            (has-key? (OwnershipTypeFacts.unmanaged-override facts) &key)
            (OwnershipClass.Unmanaged)
            (has-key? (OwnershipTypeFacts.owned facts) &key)
            (OwnershipClass.Owned)
            ; a `delete` declared once for every instance of a type, such
            ; as Core's `(sig delete (Fn [(Box a)] ()))`, is recorded under
            ; the generic key, so an instance asks for that key too
            (has-key? (OwnershipTypeFacts.owned facts) &(CAbi.generic-key type))
            (OwnershipClass.Owned)
            (OwnershipClass.Unmanaged))))
      _
      (let [key (CAbi.type-key type)]
        (cond
          (has-key? (OwnershipTypeFacts.unmanaged-override facts) &key)
            (OwnershipClass.Unmanaged)
          (has-key? (OwnershipTypeFacts.owned facts) &key)
            (OwnershipClass.Owned)
          (OwnershipClass.Unmanaged)))))

  (private signature-arg0)
  (hidden signature-arg0)
  (defn signature-arg0 [core reference]
    (let-do [result (the (Maybe CoreType) (Maybe.Nothing))
             builtins (CoreModule.builtins core)
             signatures (CoreModule.signatures core)
             n (Array.length builtins)
             m (Array.length signatures)]
      (for [i 0 n]
        (let [b (Array.unsafe-nth builtins i)]
          (when (CoreIR.same-ref? (CoreBuiltin.reference b) reference)
            (match-ref (Box.peek (CoreBuiltin.signature b))
              (CoreType.Function arguments _)
                (when (Int.> (Array.length arguments) 0)
                  (set! result
                        (Maybe.Just
                          (CoreType.copy
                            (Box.peek (Array.unsafe-nth arguments 0))))))
              _ ()))))
      (for [i 0 m]
        (let [sg (Array.unsafe-nth signatures i)]
          (when (CoreIR.same-ref? (CoreSignature.reference sg) reference)
            (match-ref (Box.peek (CoreSignature.signature sg))
              (CoreType.Function arguments _)
                (when (Int.> (Array.length arguments) 0)
                  (set! result
                        (Maybe.Just
                          (CoreType.copy
                            (Box.peek (Array.unsafe-nth arguments 0))))))
              _ ()))))
      result))

  (private resolved->mono)
  (hidden resolved->mono)

  (sig resolved->mono (Fn [(Ref CoreType)] MonoType))

  (private unresolved-variable)
  (hidden unresolved-variable)
  (defn unresolved-variable [_bindings _name]
    (Result.Success (MonoType.Variable 0)))

  (doc resolved->mono "returns the resolved `type` as a `MonoType`, with every
type variable as variable 0, to key a deleter's argument type.")
  (defn resolved->mono [type]
    (Result.from-success
      (CoreInstantiation.type-with type
                                   &(the (Array (Pair String MonoType)) [])
                                   &unresolved-variable)
      (MonoType.Variable 0)))

  (private indirect-generic-target?)
  (hidden indirect-generic-target?)
  (doc indirect-generic-target? "checks whether `type` applies a generic type
whose members are all indirections, such as `Box`.")
  (defn indirect-generic-target? [core type]
    (match-ref type
      (CoreType.Named name arguments)
        (and (Int.> (Array.length arguments) 0)
             (CoreIR.indirection-nominal? (CoreModule.constructors core) name))
      _ false))

  (private deleted-type-key)
  (hidden deleted-type-key)
  (defn deleted-type-key [core-type]
    (match-ref core-type
      (CoreType.String) (Maybe.Just (CAbi.type-key &(MonoType.String)))
      (CoreType.Named name arguments)
        (if (Int.= 0 (Array.length arguments))
          (Maybe.Just (CAbi.type-key &(MonoType.Named (String.copy name) [])))
          (Maybe.Just (CAbi.type-key &(resolved->mono core-type))))
      _ (Maybe.Nothing)))

  (doc facts-from-module "returns the ownership facts of `core`: the type each
implementation of `delete` deletes, by key. A generic target is keyed with its
type variables as variable 0. A deleter for every instance of a type of
indirections is also keyed generically. Functions are classified without facts.")
  (defn facts-from-module [core]
    (let-do [owned (the (Array String) [])
             deleters (the (Array Int) [])
             delete-ref (PrimitiveRegistry.delete-reference)
             impls (CoreModule.implementations core)
             n (Array.length impls)]
      (for [i 0 n]
        (let [im (Array.unsafe-nth impls i)]
          (when-do (CoreIR.same-ref? (CoreImplementation.interface im)
                                     &delete-ref)
            (Array.push-back! &deleters
                              @(CoreRef.id (CoreImplementation.implementation im)))
            (match (signature-arg0 core (CoreImplementation.implementation im))
              (Maybe.Just arg0)
                (do
                  (match (deleted-type-key &arg0)
                    (Maybe.Just key)
                      (unless (has-key? &owned &key)
                        (set! owned (Array.push-back owned key)))
                    (Maybe.Nothing) ())
                  ;; a deleter written once for every instance of a type whose
                  ;; members are all indirections — core's `Box` — is the only
                  ;; thing that can free what such a type owns, since nothing
                  ;; derived from its declaration would free anything. Record
                  ;; it generically so every instance finds it. Any other
                  ;; generic deleter is left to the per-instance deriver.
                  (when (indirect-generic-target? core &arg0)
                    (let [generic (CAbi.generic-key &(resolved->mono &arg0))]
                      (unless (has-key? &owned &generic)
                        (set! owned (Array.push-back owned generic))))))
              (Maybe.Nothing) ()))))
      (OwnershipTypeFacts.init owned [] deleters))))

(doc Ownership "plans the moves and deletes of a specialized module and checks
its borrows.")
(defmodule Ownership
  (private same-resource?)
  (hidden same-resource?)
  (defn same-resource? [left right]
    (match-ref left
      (OwnershipResource.Binding l)
        (match-ref right
          (OwnershipResource.Binding r) (CoreIR.same-ref? l r)
          _ false)
      (OwnershipResource.Temporary l)
        (match-ref right (OwnershipResource.Temporary r) (Int.= @l @r) _ false)
      (OwnershipResource.Result)
        (match-ref right (OwnershipResource.Result) true _ false)))

  (private known-le?)
  (hidden known-le?)
  (doc known-le? "checks whether both bounds are known and `a` is at most `b`.")
  (defn known-le? [a b]
    (match-ref a
      (Maybe.Just x) (match-ref b (Maybe.Just y) (Int.<= @x @y) _ false)
      _ false))

  (private index-outside-slice?)
  (hidden index-outside-slice?)
  (defn index-outside-slice? [index start end]
    (or (known-le? end index)
        (match-ref index
          (Maybe.Just i) (known-le? &(Maybe.Just (Int.inc @i)) start)
          _ false)))

  (private projections-disjoint?)
  (hidden projections-disjoint?)
  (defn projections-disjoint? [left right]
    (match-ref left
      (OwnershipProjection.Field l)
        (match-ref right
          (OwnershipProjection.Field r) (not (String.= l r))
          _ false)
      (OwnershipProjection.Index l)
        (match-ref right
          (OwnershipProjection.Index r)
            (and (Maybe.just? l) (Maybe.just? r) (/= l r))
          (OwnershipProjection.Slice start end)
            (index-outside-slice? l start end)
          _ false)
      (OwnershipProjection.Slice lstart lend)
        (match-ref right
          (OwnershipProjection.Index index)
            (index-outside-slice? index lstart lend)
          (OwnershipProjection.Slice rstart rend)
            (or (known-le? lend rstart) (known-le? rend lstart))
          _ false)
      _ false))

  (private aligned-projection?)
  (hidden aligned-projection?)
  (doc aligned-projection? "checks whether two steps that may differ still leave
the steps after them counting from the same offset: two indices reach one
element each, and two slices with the same known start number their elements
alike.")
  (defn aligned-projection? [left right]
    (match-ref left
      (OwnershipProjection.Index _)
        (match-ref right (OwnershipProjection.Index _) true _ false)
      (OwnershipProjection.Slice ls _)
        (match-ref right
          (OwnershipProjection.Slice rs _) (and (Maybe.just? ls) (= ls rs))
          _ false)
      _ false))

  (private same-projection?)
  (hidden same-projection?)
  (doc same-projection? "checks whether two steps reach the same part for
certain. An unknown index or bound never does.")
  (defn same-projection? [left right]
    (match-ref left
      (OwnershipProjection.Deref)
        (match-ref right (OwnershipProjection.Deref) true _ false)
      (OwnershipProjection.Field l)
        (match-ref right (OwnershipProjection.Field r) (String.= l r) _ false)
      (OwnershipProjection.Index l)
        (match-ref right
          (OwnershipProjection.Index r) (and (Maybe.just? l) (= l r))
          _ false)
      (OwnershipProjection.Slice ls le)
        (match-ref right
          (OwnershipProjection.Slice rs re)
            (and (Maybe.just? ls) (= ls rs) (Maybe.just? le) (= le re))
          _ false)))

  (private deref-from?)
  (hidden deref-from?)
  (defn deref-from? [projections start]
    (let-do [found false]
      (for [i start (Array.length projections)]
        (match-ref (Array.unsafe-nth projections i)
          (OwnershipProjection.Deref) (set! found true)
          _ ()))
      found))

  (doc places-overlap? "checks whether two places may share bytes. Different
roots are separate unless either place goes through a reference. Under one root,
places overlap unless their steps lead apart for certain.")
  (defn places-overlap? [left right]
    (let-do [left-projections (OwnershipPlace.projections left)
             right-projections (OwnershipPlace.projections right)
             n (Int.min (Array.length left-projections)
                        (Array.length right-projections))
             same-root (same-resource? (OwnershipPlace.root left)
                                       (OwnershipPlace.root right))
             ;; 0 undecided, 1 overlap, 2 separate
             verdict 0
             i 0]
      (if (not same-root)
        (or (deref-from? left-projections 0) (deref-from? right-projections 0))
        (do
          (while-do (and (Int.= verdict 0) (Int.< i n))
            (let [l (Array.unsafe-nth left-projections i)
                  r (Array.unsafe-nth right-projections i)]
              (cond
                (same-projection? l r) (set! i (Int.inc i))
                (or (deref-from? left-projections i)
                    (deref-from? right-projections i))
                  (set! verdict 1)
                (projections-disjoint? l r) (set! verdict 2)
                (aligned-projection? l r) (set! i (Int.inc i))
                (set! verdict 1))))
          (Int./= verdict 2)))))

  (private invalid-id)
  (hidden invalid-id)
  (private mark-id!)
  (hidden mark-id!)
  (private validate-expression)
  (hidden validate-expression)
  (private validate-expressions)
  (hidden validate-expressions)
  (private validate-branches)
  (hidden validate-branches)

  (sig validate-expression
       (Fn
         [(Ref SpecializedExpr) (Ref (Array Bool)) (Ref String)]
         (Result () OwnershipError)))
  (sig validate-expressions
       (Fn
         [(Ref (Array (Box SpecializedExpr))) (Ref (Array Bool)) (Ref String)]
         (Result () OwnershipError)))
  (sig validate-branches
       (Fn
         [(Ref (Array SpecializedMatchBranch)) (Ref (Array Bool)) (Ref String)]
         (Result () OwnershipError)))
  (sig collect-context-deletes
       (Fn
         [(Ref SpecializedExpr)
          (Ref OwnershipTypeFacts)
          Int
          (Ref (Array CoreConstructorDeclaration))]
         (Array OwnershipAction)))

  (doc spanned-actions "returns the actions of `plan` with the spans of their
sites from `provenance`. Actions without a span are kept.")
  (defn spanned-actions [plan provenance]
    (let-do [result (the (Array SpannedOwnershipAction) [])
             actions (OwnershipPlan.actions plan)]
      (for [i 0 (Array.length actions)]
        (let [action (Array.unsafe-nth actions i)
              id (match-ref action
                (OwnershipAction.Move site _ _ _)
                  @(OwnershipSite.expression site)
                (OwnershipAction.Borrow site _ _)
                  @(OwnershipSite.expression site)
                (OwnershipAction.Delete site _ _)
                  @(OwnershipSite.expression site))]
          (Array.push-back! &result
                            (SpannedOwnershipAction.init (OwnershipAction.copy action)
                                                         (CoreProvenance.node-span provenance
                                                                                   id)))))
      result))

  (defn invalid-id [context id reason]
    (OwnershipError.init
      (String.concat
        &[@"invalid specialized expression ID in "
          (String.copy context)
          @": "
          (Int.str id)
          @" "
          (String.copy reason)])))

  (defn mark-id! [seen context id]
    (if (Int.< id 0)
      (Result.Error (invalid-id context id "is negative"))
      (do
        (while-do (Int.<= (Array.length seen) id) (Array.push-back! seen false))
        (if @(Array.unsafe-nth seen id)
          (Result.Error (invalid-id context id "is duplicated"))
          (do (Array.aset! seen id true) (Result.Success ()))))))

  (defn validate-expressions [expressions seen context]
    (let-do [result (the (Result () OwnershipError) (Result.Success ()))
             n (Array.length expressions)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success _)
            (set! result
                  (validate-expression
                    (Box.peek (Array.unsafe-nth expressions i))
                    seen
                    context))
          (Result.Error _) ()))
      result))

  (defn validate-branches [branches seen context]
    (let-do [result (the (Result () OwnershipError) (Result.Success ()))
             n (Array.length branches)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success _)
            (set! result
                  (validate-expression
                    (Box.peek
                      (SpecializedMatchBranch.body (Array.unsafe-nth branches i)))
                    seen
                    context))
          (Result.Error _) ()))
      result))

  (defn validate-expression [expression seen context]
    (let [actual (Specialize.expression-id expression)]
      (match (mark-id! seen context actual)
        (Result.Success _)
          (match-ref expression
            (SpecializedExpr.ArrayLit _ _ expressions)
              (validate-expressions expressions seen context)
            (SpecializedExpr.StaticArrayLit _ _ expressions)
              (validate-expressions expressions seen context)
            (SpecializedExpr.Call _ _ callee arguments)
              (match (validate-expression (Box.peek callee) seen context)
                (Result.Success _) (validate-expressions arguments seen context)
                (Result.Error error) (Result.Error error))
            (SpecializedExpr.GlobalCall _ _ _ _ _ arguments)
              (validate-expressions arguments seen context)
            (SpecializedExpr.Do _ _ expressions)
              (validate-expressions expressions seen context)
            (SpecializedExpr.If _ _ condition then-branch else-branch)
              (match (validate-expression (Box.peek condition) seen context)
                (Result.Success _)
                  (match (validate-expression (Box.peek then-branch)
                                              seen
                                              context)
                    (Result.Success _)
                      (validate-expression (Box.peek else-branch) seen context)
                    (Result.Error error) (Result.Error error))
                (Result.Error error) (Result.Error error))
            (SpecializedExpr.Let _ _ _ value body)
              (match (validate-expression (Box.peek value) seen context)
                (Result.Success _)
                  (validate-expression (Box.peek body) seen context)
                (Result.Error error) (Result.Error error))
            (SpecializedExpr.Set _ _ _ value)
              (validate-expression (Box.peek value) seen context)
            (SpecializedExpr.While _ _ condition body)
              (match (validate-expression (Box.peek condition) seen context)
                (Result.Success _)
                  (validate-expression (Box.peek body) seen context)
                (Result.Error error) (Result.Error error))
            (SpecializedExpr.Lambda _ _ _ body)
              (validate-expression (Box.peek body) seen context)
            (SpecializedExpr.Match _ _ _ scrutinee branches)
              (match (validate-expression (Box.peek scrutinee) seen context)
                (Result.Success _) (validate-branches branches seen context)
                (Result.Error error) (Result.Error error))
            (SpecializedExpr.Annotation _ _ inner _)
              (validate-expression (Box.peek inner) seen context)
            _ (Result.Success ()))
        (Result.Error error) (Result.Error error))))

  (private append-actions)
  (hidden append-actions)
  (sig append-actions
       (Fn
         [(Array OwnershipAction) (Array OwnershipAction)]
         (Array OwnershipAction)))
  (defn append-actions [left right]
    (let-do [result left
             n (Array.length &right)]
      (for [i 0 n]
        (set! result (Array.push-back result @(Array.unsafe-nth &right i))))
      result))

  (private owned-type?)
  (hidden owned-type?)
  (defn owned-type? [type facts]
    (match (OwnershipClassify.classify type facts)
      (OwnershipClass.Owned) true
      _ false))

  (private consumed-in-any?)
  (hidden consumed-in-any?)
  (private consumed-in-branches?)
  (hidden consumed-in-branches?)
  (private reference-place?)
  (hidden reference-place?)
  (sig consumed? (Fn [(Ref CoreRef) (Ref SpecializedExpr)] Bool))
  (sig consumed-in-any?
       (Fn [(Ref CoreRef) (Ref (Array (Box SpecializedExpr)))] Bool))
  (sig consumed-in-branches?
       (Fn [(Ref CoreRef) (Ref (Array SpecializedMatchBranch))] Bool))

  (defn reference-place? [expr]
    (match-ref expr
      (SpecializedExpr.Reference _ _ _) true
      (SpecializedExpr.Annotation _ _ inner _)
        (reference-place? (Box.peek inner))
      _ false))

  ;; `consumed?` is intentionally an any-path query. Cleanup planning also
  ;; needs the dual question: is ownership transferred on every path that
  ;; leaves this expression? A conditional move must be deleted on the paths
  ;; that do not take it.
  (sig consumed-on-all-paths? (Fn [(Ref CoreRef) (Ref SpecializedExpr)] Bool))
  (sig consumed-on-all-paths-in-any?
       (Fn [(Ref CoreRef) (Ref (Array (Box SpecializedExpr)))] Bool))
  (sig consumed-on-all-paths-in-branches?
       (Fn [(Ref CoreRef) (Ref (Array SpecializedMatchBranch))] Bool))

  (defn consumed-in-any? [binder es]
    (let-do [found false
             n (Array.length es)]
      (for [i 0 n]
        (when (consumed? binder (Box.peek (Array.unsafe-nth es i)))
          (set! found true)))
      found))

  (defn consumed-in-branches? [binder branches]
    (let-do [found false
             n (Array.length branches)]
      (for [i 0 n]
        (when (consumed? binder
                         (Box.peek
                           (SpecializedMatchBranch.body (Array.unsafe-nth branches
                                                                          i))))
          (set! found true)))
      found))

  (doc consumed-on-all-paths-in-any? "checks whether evaluating `es` in order
moves `binder` on every path. After an element that moves it only on some paths,
the answer is false.")
  (defn consumed-on-all-paths-in-any? [binder es]
    (let-do [result false
             uncertain false
             n (Array.length es)]
      ;; Elements are evaluated left-to-right. A guaranteed move in any
      ;; element guarantees a move for the sequence. Once an earlier element
      ;; moves only conditionally, later evaluation is path-dependent and we
      ;; conservatively stop claiming all-path consumption.
      (for [i 0 n]
        (unless (or result uncertain)
          (let [element (Box.peek (Array.unsafe-nth es i))]
            (if (consumed-on-all-paths? binder element)
              (set! result true)
              (when (consumed? binder element) (set! uncertain true))))))
      result))

  (doc consumed-on-all-paths-in-branches? "checks whether every one of
`branches` moves `binder` on every path. No branches is false.")
  (defn consumed-on-all-paths-in-branches? [binder branches]
    (let-do [result (Int.> (Array.length branches) 0)
             n (Array.length branches)]
      (for [i 0 n]
        (unless (consumed-on-all-paths? binder
                                        (Box.peek
                                          (SpecializedMatchBranch.body (Array.unsafe-nth branches
                                                                                         i))))
          (set! result false)))
      result))

  (private captured?)
  (hidden captured?)
  (private captured-in-any?)
  (hidden captured-in-any?)
  (private captured-in-branches?)
  (hidden captured-in-branches?)

  (sig captured? (Fn [(Ref CoreRef) (Ref SpecializedExpr)] Bool))
  (doc captured? "checks whether `binder` occurs anywhere in `expr`, including
under `&`. A lambda copies what it captures into its environment.")
  (defn captured? [binder expr]
    (match-ref expr
      (SpecializedExpr.Reference _ _ r) (CoreIR.same-ref? r binder)
      (SpecializedExpr.GlobalCall _ _ _ _ _ args) (captured-in-any? binder args)
      (SpecializedExpr.Call _ _ callee args)
        (or (captured? binder (Box.peek callee)) (captured-in-any? binder args))
      (SpecializedExpr.Let _ _ _ value body)
        (or (captured? binder (Box.peek value))
            (captured? binder (Box.peek body)))
      (SpecializedExpr.Do _ _ es) (captured-in-any? binder es)
      (SpecializedExpr.If _ _ c t e)
        (or (captured? binder (Box.peek c))
            (or (captured? binder (Box.peek t)) (captured? binder (Box.peek e))))
      (SpecializedExpr.While _ _ c b)
        (or (captured? binder (Box.peek c)) (captured? binder (Box.peek b)))
      (SpecializedExpr.Set _ _ _ value) (captured? binder (Box.peek value))
      (SpecializedExpr.Match _ _ _ scrutinee branches)
        (or (captured? binder (Box.peek scrutinee))
            (captured-in-branches? binder branches))
      (SpecializedExpr.Annotation _ _ inner _)
        (captured? binder (Box.peek inner))
      (SpecializedExpr.ArrayLit _ _ es) (captured-in-any? binder es)
      (SpecializedExpr.StaticArrayLit _ _ es) (captured-in-any? binder es)
      (SpecializedExpr.Lambda _ _ _ b) (captured? binder (Box.peek b))
      _ false))

  (defn captured-in-any? [binder es]
    (let-do [found false
             n (Array.length es)]
      (for [i 0 n]
        (when (captured? binder (Box.peek (Array.unsafe-nth es i)))
          (set! found true)))
      found))

  (defn captured-in-branches? [binder branches]
    (let-do [found false
             n (Array.length branches)]
      (for [i 0 n]
        (when (captured? binder
                         (Box.peek
                           (SpecializedMatchBranch.body (Array.unsafe-nth branches
                                                                          i))))
          (set! found true)))
      found))

  (doc consumed? "checks whether `binder` is moved somewhere in `expr`: a plain
reference to it as a value, such as a call argument, a `let` value or a result,
moves it. The operand of `&` is only borrowed. The backend also asks this about
its own temporaries.")
  (defn consumed? [binder expr]
    (match-ref expr
      (SpecializedExpr.Reference _ _ r)
      (CoreIR.same-ref? r binder)
      (SpecializedExpr.GlobalCall id _ callee _ _ args)
      (cond
        ;; Backend-generated delete calls use id -1 and carry the deleted
        ;; binder as their synthetic callee reference. They must not look like
        ;; a second user move to a surrounding path-cleanup rewrite.
        (and (Int.= @id -1) (CoreIR.same-ref? callee binder))
        false
        (and
          (CoreIR.same-ref? callee &(PrimitiveRegistry.ref-reference))
          (Int.= 1 (Array.length args)))
        (let [operand (Box.peek (Array.unsafe-nth args 0))]
          (if (reference-place? operand) false (consumed? binder operand)))
        (consumed-in-any? binder args))
      (SpecializedExpr.Call _ _ callee args)
      ;; Invoking a closure borrows its callable value; only its arguments are
      ;; passed by value. Treating the callee as consumed would move a captured
      ;; function out of its environment on the first invocation.
      (consumed-in-any? binder args)
      (SpecializedExpr.Let _ _ _ value body)
      (or (consumed? binder (Box.peek value)) (consumed? binder (Box.peek body)))
      (SpecializedExpr.Do _ _ es)
      (consumed-in-any? binder es)
      (SpecializedExpr.If _ _ c t e)
      (or (consumed? binder (Box.peek c))
          (or (consumed? binder (Box.peek t)) (consumed? binder (Box.peek e))))
      (SpecializedExpr.While _ _ c b)
      (or (consumed? binder (Box.peek c)) (consumed? binder (Box.peek b)))
      (SpecializedExpr.Set _ _ target value)
      ;; A self-rebind transfers the old value through `value`, then restores
      ;; ownership to the same binding. It therefore does not move ownership
      ;; out of the binding's scope. A set! of some other target still does.
      (and (not (CoreIR.same-ref? target binder))
           (consumed? binder (Box.peek value)))
      (SpecializedExpr.Match _ _ _ scrutinee branches)
      (or (consumed? binder (Box.peek scrutinee))
          (consumed-in-branches? binder branches))
      (SpecializedExpr.Annotation _ _ inner _)
      (consumed? binder (Box.peek inner))
      (SpecializedExpr.ArrayLit _ _ es)
      (consumed-in-any? binder es)
      (SpecializedExpr.StaticArrayLit _ _ es)
      (consumed-in-any? binder es)
      ;; a lambda captures by COPYING the binder into its environment, so the
      ;; enclosing scope still owns the original and still frees it. Two
      ;; closures may capture one value, which is why the copy exists; calling
      ;; the capture a move would leave the original owned by nobody.
      (SpecializedExpr.Lambda _ _ _ _)
      false
      _
      false))

  (doc consumed-on-all-paths? "checks whether every path out of `expr` moves
`binder`. Unlike `consumed?`, the branches of a conditional must agree. Cleanup
uses it to delete a value on the paths that do not move it.")
  (defn consumed-on-all-paths? [binder expr]
    (match-ref expr
      (SpecializedExpr.Reference _ _ r)
      (CoreIR.same-ref? r binder)
      (SpecializedExpr.GlobalCall _ _ callee _ _ args)
      (if (and
          (CoreIR.same-ref? callee &(PrimitiveRegistry.ref-reference))
          (Int.= 1 (Array.length args)))
        (let [operand (Box.peek (Array.unsafe-nth args 0))]
          (if (reference-place? operand)
            false
            (consumed-on-all-paths? binder operand)))
        (consumed-on-all-paths-in-any? binder args))
      (SpecializedExpr.Call _ _ callee args)
      (consumed-on-all-paths-in-any? binder args)
      (SpecializedExpr.Let _ _ _ value body)
      (cond
        (consumed-on-all-paths? binder (Box.peek value)) true
        (consumed? binder (Box.peek value)) false
        (consumed-on-all-paths? binder (Box.peek body)))
      (SpecializedExpr.Do _ _ es)
      (consumed-on-all-paths-in-any? binder es)
      (SpecializedExpr.If _ _ c t e)
      (if (consumed-on-all-paths? binder (Box.peek c))
        true
        (and (not (consumed? binder (Box.peek c)))
             (and
               (consumed-on-all-paths? binder (Box.peek t))
               (consumed-on-all-paths? binder (Box.peek e)))))
      (SpecializedExpr.While _ _ c _)
      ;; The condition runs at least once; the body may run zero times.
      (consumed-on-all-paths? binder (Box.peek c))
      (SpecializedExpr.Set _ _ target value)
      (and (not (CoreIR.same-ref? target binder))
           (consumed-on-all-paths? binder (Box.peek value)))
      (SpecializedExpr.Match _ _ _ scrutinee branches)
      (if (consumed-on-all-paths? binder (Box.peek scrutinee))
        true
        (and
          (not (consumed? binder (Box.peek scrutinee)))
          (consumed-on-all-paths-in-branches? binder branches)))
      (SpecializedExpr.Annotation _ _ inner _)
      (consumed-on-all-paths? binder (Box.peek inner))
      (SpecializedExpr.ArrayLit _ _ es)
      (consumed-on-all-paths-in-any? binder es)
      (SpecializedExpr.StaticArrayLit _ _ es)
      (consumed-on-all-paths-in-any? binder es)
      ;; see `consumed?`: a capture copies, so it never consumes the original.
      (SpecializedExpr.Lambda _ _ _ _)
      false
      _
      false))

  (doc owned-reference-in? "checks whether `expr` mentions `binder` with an
owned type.")
  (private owned-reference-in?)
  (hidden owned-reference-in?)
  (private owned-reference-in-any?)
  (hidden owned-reference-in-any?)
  (private owned-reference-in-branches?)
  (hidden owned-reference-in-branches?)
  (sig owned-reference-in?
       (Fn [(Ref SpecializedExpr) (Ref CoreRef) (Ref OwnershipTypeFacts)] Bool))
  (sig owned-reference-in-any?
       (Fn
         [(Ref (Array (Box SpecializedExpr)))
          (Ref CoreRef)
          (Ref OwnershipTypeFacts)]
         Bool))
  (sig owned-reference-in-branches?
       (Fn
         [(Ref (Array SpecializedMatchBranch))
          (Ref CoreRef)
          (Ref OwnershipTypeFacts)]
         Bool))
  (defn owned-reference-in? [expr binder facts]
    (match-ref expr
      (SpecializedExpr.Reference _ node-type r)
        (and (CoreIR.same-ref? r binder)
             (owned-type? (Box.peek node-type) facts))
      (SpecializedExpr.GlobalCall _ _ _ _ _ args)
        (owned-reference-in-any? args binder facts)
      (SpecializedExpr.Call _ _ callee args)
        (or
          (owned-reference-in? (Box.peek callee) binder facts)
          (owned-reference-in-any? args binder facts))
      (SpecializedExpr.Let _ _ _ value body)
        (or
          (owned-reference-in? (Box.peek value) binder facts)
          (owned-reference-in? (Box.peek body) binder facts))
      (SpecializedExpr.Do _ _ es) (owned-reference-in-any? es binder facts)
      (SpecializedExpr.If _ _ c t e)
        (or
          (owned-reference-in? (Box.peek c) binder facts)
          (or
            (owned-reference-in? (Box.peek t) binder facts)
            (owned-reference-in? (Box.peek e) binder facts)))
      (SpecializedExpr.While _ _ c b)
        (or
          (owned-reference-in? (Box.peek c) binder facts)
          (owned-reference-in? (Box.peek b) binder facts))
      (SpecializedExpr.Set _ _ _ value)
        (owned-reference-in? (Box.peek value) binder facts)
      (SpecializedExpr.Match _ _ _ scrutinee branches)
        (or
          (owned-reference-in? (Box.peek scrutinee) binder facts)
          (owned-reference-in-branches? branches binder facts))
      (SpecializedExpr.Annotation _ _ inner _)
        (owned-reference-in? (Box.peek inner) binder facts)
      (SpecializedExpr.ArrayLit _ _ es)
        (owned-reference-in-any? es binder facts)
      (SpecializedExpr.StaticArrayLit _ _ es)
        (owned-reference-in-any? es binder facts)
      (SpecializedExpr.Lambda _ _ _ b)
        (owned-reference-in? (Box.peek b) binder facts)
      _ false))

  (defn owned-reference-in-any? [es binder facts]
    (let-do [found false
             n (Array.length es)]
      (for [i 0 n]
        (when (owned-reference-in? (Box.peek (Array.unsafe-nth es i))
                                   binder
                                   facts)
          (set! found true)))
      found))

  (defn owned-reference-in-branches? [branches binder facts]
    (let-do [found false
             n (Array.length branches)]
      (for [i 0 n]
        (when (owned-reference-in?
            (Box.peek
              (SpecializedMatchBranch.body (Array.unsafe-nth branches i)))
            binder
            facts)
          (set! found true)))
      found))

  (private make-delete-action)
  (hidden make-delete-action)
  (private contains-ref?)
  (hidden contains-ref?)
  (defn contains-ref? [refs target]
    (let-do [found false
             n (Array.length refs)]
      (for [i 0 n]
        (when (CoreIR.same-ref? (Array.unsafe-nth refs i) target)
          (set! found true)))
      found))

  (private ref-type?)
  (hidden ref-type?)
  (defn ref-type? [type] (match-ref type (MonoType.Reference _ _) true _ false))

  (private same-lt?)
  (hidden same-lt?)
  (defn same-lt? [left right]
    (match-ref left
      (MonoLifetime.Variable left-id)
        (match-ref right
          (MonoLifetime.Variable right-id) (Int.= @left-id @right-id)
          _ false)
      (MonoLifetime.Static) (match-ref right (MonoLifetime.Static) true _ false)))

  ;; every lifetime VARIABLE carried by a reference anywhere inside a type;
  ;; static lifetimes are omitted (they constrain nothing).
  (private collect-ref-lifetimes!)
  (hidden collect-ref-lifetimes!)
  (sig collect-ref-lifetimes!
       (Fn [(Ref MonoType) (Ref (Array MonoLifetime))] ()))
  (defn collect-ref-lifetimes! [type acc]
    (match-ref type
      (MonoType.Reference inner lt)
        (do
          (match-ref lt
            (MonoLifetime.Variable _) (Array.push-back! acc @lt)
            _ ())
          (collect-ref-lifetimes! (Box.peek inner) acc))
      (MonoType.Named _ args)
        (for [i 0 (Array.length args)]
          (collect-ref-lifetimes! (Box.peek (Array.unsafe-nth args i)) acc))
      (MonoType.Function args ret)
        (do
          (for [i 0 (Array.length args)]
            (collect-ref-lifetimes! (Box.peek (Array.unsafe-nth args i)) acc))
          (collect-ref-lifetimes! (Box.peek ret) acc))
      _ ()))

  (private any-lifetime-shared?)
  (hidden any-lifetime-shared?)
  (defn any-lifetime-shared? [left right]
    (let-do [found false]
      (for [i 0 (Array.length left)]
        (for [j 0 (Array.length right)]
          (when (same-lt? (Array.unsafe-nth left i) (Array.unsafe-nth right j))
            (set! found true))))
      found))

  (private external?)
  (hidden external?)
  (defn external? [origin]
    (match-ref origin (BorrowOrigin.External) true _ false))

  (private static?)
  (hidden static?)
  (defn static? [origin] (match-ref origin (BorrowOrigin.Static) true _ false))

  (private origin-locals)
  (hidden origin-locals)
  (defn origin-locals [origin]
    (match-ref origin
      (BorrowOrigin.Local locals) @locals
      _ (the (Array CoreRef) [])))

  ;; a `Local` origin's list already includes any parameters folded into it by
  ;; a join, so only the pure `Param` variant reports here.
  (private origin-params)
  (hidden origin-params)
  (defn origin-params [origin]
    (match-ref origin
      (BorrowOrigin.Param params) @params
      _ (the (Array CoreRef) [])))

  ;; every binding an origin borrows from, local or parameter — the set a
  ;; use-after-move check must test against the moved set.
  (private origin-owners)
  (hidden origin-owners)
  (defn origin-owners [origin]
    (match-ref origin
      (BorrowOrigin.Local locals) @locals
      (BorrowOrigin.Param params) @params
      _ (the (Array CoreRef) [])))

  (private union-refs)
  (hidden union-refs)
  (defn union-refs [left right]
    (let-do [result (Array.copy left)
             n (Array.length right)]
      (for [i 0 n]
        (let [x (Array.unsafe-nth right i)]
          (unless (contains-ref? &result x)
            (set! result (Array.push-back result (CoreRef.copy x))))))
      result))

  (private single-local)
  (hidden single-local)
  (defn single-local [x] (BorrowOrigin.Local [(CoreRef.copy x)]))

  (private temporary-origin)
  (hidden temporary-origin)
  (doc temporary-origin "returns the origin of a borrow of `operand`, which is
not a named binding. String and pattern literals and globals are `Static`. Other
temporaries, such as array literals and call results, live in the frame and give
an empty `Local`, so returning the borrow escapes.")
  (defn temporary-origin [operand]
    (match-ref operand
      (SpecializedExpr.StringLit _ _ _)
      (BorrowOrigin.Static)
      (SpecializedExpr.PatternLit _ _ _)
      (BorrowOrigin.Static)
      ;; a `def` global lives for the whole program, so borrowing one is no
      ;; more a frame borrow than borrowing a literal is
      (SpecializedExpr.GlobalValue _ _ _ _ _ _)
      (BorrowOrigin.Static)
      _
      (BorrowOrigin.Local [])))

  (private join-origin)
  (hidden join-origin)
  (defn join-origin [left right]
    (let [ll (origin-locals left)
          rl (origin-locals right)
          lp (origin-params left)
          rp (origin-params right)]
      (cond
        ;; any local participation makes the join Local (escape-relevant), even
        ;; a binder-less temporary (`Local []`); the param refs ride along so
        ;; use-after-move still sees them.
        (or
          (match-ref left (BorrowOrigin.Local _) true _ false)
          (match-ref right (BorrowOrigin.Local _) true _ false))
        (BorrowOrigin.Local
          (union-refs &(union-refs &ll &rl) &(union-refs &lp &rp)))
        (or (Int.> (Array.length &lp) 0) (Int.> (Array.length &rp) 0))
        (BorrowOrigin.Param (union-refs &lp &rp))
        (or (external? left) (external? right))
        (BorrowOrigin.External)
        (or (static? left) (static? right))
        (BorrowOrigin.Static)
        (BorrowOrigin.None))))

  (private origins-lookup)
  (hidden origins-lookup)
  (defn origins-lookup [origins binder]
    (let-do [result (BorrowOrigin.None)
             n (Array.length origins)]
      (for [i 0 n]
        (when (CoreIR.same-ref? (Pair.a (Array.unsafe-nth origins i)) binder)
          (set! result @(Pair.b (Array.unsafe-nth origins i)))))
      result))

  (private origins-has?)
  (hidden origins-has?)
  (defn origins-has? [origins binder]
    (let-do [found false
             n (Array.length origins)]
      (for [i 0 n]
        (when (CoreIR.same-ref? (Pair.a (Array.unsafe-nth origins i)) binder)
          (set! found true)))
      found))

  (private state-origin)
  (hidden state-origin)
  (defn state-origin [state binder]
    (origins-lookup (BorrowState.origins state) binder))

  (private state-set-origin)
  (hidden state-set-origin)
  (private state-unmove)
  (hidden state-unmove)
  ;; a `set!` stores a fresh value in the binding, so a previous move out of it
  ;; no longer poisons later uses: the binding is re-initialized.
  (defn state-unmove [state binder]
    (let-do [moved (the (Array CoreRef) [])
             old (BorrowState.moved state)
             n (Array.length old)]
      (for [i 0 n]
        (unless (CoreIR.same-ref? (Array.unsafe-nth old i) binder)
          (set! moved (Array.push-back moved @(Array.unsafe-nth old i)))))
      (BorrowState.init moved @(BorrowState.origins state))))

  (defn state-set-origin [state binder origin]
    (let-do [origins (the (Array (Pair CoreRef BorrowOrigin)) [])
             old (BorrowState.origins state)
             n (Array.length old)]
      (for [i 0 n]
        (unless (CoreIR.same-ref? (Pair.a (Array.unsafe-nth old i)) binder)
          (set! origins (Array.push-back origins @(Array.unsafe-nth old i)))))
      (set! origins
            (Array.push-back origins (Pair.init (CoreRef.copy binder) origin)))
      (BorrowState.init @(BorrowState.moved state) origins)))

  ;; a match branch re-binds its pattern bindings from the scrutinee on every
  ;; entry, so like a loop-re-entered let binder they must not inherit a
  ;; previous pass's moved marks.
  (private state-unmove-all)
  (hidden state-unmove-all)
  (defn state-unmove-all [state bindings]
    (let-do [current @state
             n (Array.length bindings)]
      (for [i 0 n]
        (set! current (state-unmove &current (Array.unsafe-nth bindings i))))
      current))

  (private state-mark-moved)
  (hidden state-mark-moved)
  (defn state-mark-moved [state local]
    (if (contains-ref? (BorrowState.moved state) local)
      @state
      (BorrowState.init
        (Array.push-back @(BorrowState.moved state) (CoreRef.copy local))
        @(BorrowState.origins state))))

  (private state-mark-moved-checked)
  (hidden state-mark-moved-checked)
  ;; a genuine consuming move: moving a value that was already moved is a
  ;; use-after-move. The loop pass re-runs a `while` body against the first
  ;; pass's moved set, so a loop-carried second move lands here too. The
  ;; `Let` scope-death mark stays on the unchecked variant -- dying after
  ;; being consumed is the normal case, not an error.
  (defn state-mark-moved-checked [state local flags]
    (do
      (when-do (contains-ref? (BorrowState.moved state) local)
        (match (IO.getenv "CARP_DEBUG_OWNERSHIP")
          (Maybe.Just _)
            (IO.errorln
              &(fmt "  move-after-move: owner %s (id %d)"
                    (CoreRef.name local)
                    @(CoreRef.id local)))
          (Maybe.Nothing) ())
        (Array.aset! flags 3 true))
      (state-mark-moved state local)))

  (private join-origins)
  (hidden join-origins)
  (defn join-origins [left right]
    (let-do [result (the (Array (Pair CoreRef BorrowOrigin)) [])
             ln (Array.length left)
             rn (Array.length right)]
      (for [i 0 ln]
        (let [pair (Array.unsafe-nth left i)
              binder (Pair.a pair)
              lo @(Pair.b pair)
              ro (origins-lookup right binder)]
          (set! result
                (Array.push-back result
                                 (Pair.init (CoreRef.copy binder)
                                            (join-origin &lo &ro))))))
      (for [i 0 rn]
        (let [binder (Pair.a (Array.unsafe-nth right i))]
          (unless (origins-has? left binder)
            (set! result (Array.push-back result @(Array.unsafe-nth right i))))))
      result))

  (private state-join)
  (hidden state-join)
  (defn state-join [left right]
    (BorrowState.init
      (union-refs (BorrowState.moved left) (BorrowState.moved right))
      (join-origins (BorrowState.origins left) (BorrowState.origins right))))

  (private refs-subset?)
  (hidden refs-subset?)
  (defn refs-subset? [left right]
    (let-do [result true
             n (Array.length left)]
      (for [i 0 n]
        (unless (contains-ref? right (Array.unsafe-nth left i))
          (set! result false)))
      result))

  (private refs-same?)
  (hidden refs-same?)
  (doc refs-same? "checks whether two binder lists hold the same binders, in any
order.")
  (defn refs-same? [left right]
    (and (refs-subset? left right) (refs-subset? right left)))

  (private origin-same?)
  (hidden origin-same?)
  (defn origin-same? [left right]
    (match-ref left
      (BorrowOrigin.Static) (match-ref right (BorrowOrigin.Static) true _ false)
      (BorrowOrigin.External)
        (match-ref right (BorrowOrigin.External) true _ false)
      (BorrowOrigin.None) (match-ref right (BorrowOrigin.None) true _ false)
      (BorrowOrigin.Local ls)
        (match-ref right (BorrowOrigin.Local rs) (refs-same? ls rs) _ false)
      (BorrowOrigin.Param ls)
        (match-ref right (BorrowOrigin.Param rs) (refs-same? ls rs) _ false)))

  (private origins-within?)
  (hidden origins-within?)
  (defn origins-within? [left right]
    (let-do [result true
             n (Array.length left)]
      (for [i 0 n]
        (let [pair (Array.unsafe-nth left i)]
          (unless (and (origins-has? right (Pair.a pair))
                       (origin-same? (Pair.b pair)
                                     &(origins-lookup right (Pair.a pair))))
            (set! result false))))
      result))

  (private state-same?)
  (hidden state-same?)
  (doc state-same? "checks whether two borrow states have the same moved owners
and the same origin for every binder.")
  (defn state-same? [left right]
    (and
      (refs-same? (BorrowState.moved left) (BorrowState.moved right))
      (and
        (origins-within? (BorrowState.origins left) (BorrowState.origins right))
        (origins-within? (BorrowState.origins right) (BorrowState.origins left)))))

  (private is-ref-call?)
  (hidden is-ref-call?)
  (defn is-ref-call? [callee args]
    (and
      (CoreIR.same-ref? callee &(PrimitiveRegistry.ref-reference))
      (Int.= 1 (Array.length args))))

  (private check-escape!)
  (hidden check-escape!)
  ;; any frame-Local origin escapes, including one that names no binder: a
  ;; borrow of an unnamed temporary (`&[1 2 3]`) is just as dead on return as a
  ;; borrow of a named local. A by-value parameter lives in the same frame and
  ;; is deleted on return, so borrowing it escapes too (the reference accepts
  ;; this and reads freed memory).
  (defn check-escape! [origin flags]
    (when (match-ref origin
        (BorrowOrigin.Local _) true
        (BorrowOrigin.Param _) true
        _ false)
      (Array.aset! flags 0 true)))

  (private check-use-after-move!)
  (hidden check-use-after-move!)
  (defn check-use-after-move! [origin state flags]
    (let-do [owners (origin-owners origin)
             n (Array.length &owners)]
      (for [i 0 n]
        (when-do (contains-ref? (BorrowState.moved state)
                                (Array.unsafe-nth &owners i))
          (match (IO.getenv "CARP_DEBUG_OWNERSHIP")
            (Maybe.Just _)
              (IO.errorln
                &(fmt "  borrow-after-move: owner %s (id %d)"
                      (CoreRef.name (Array.unsafe-nth &owners i))
                      @(CoreRef.id (Array.unsafe-nth &owners i))))
            (Maybe.Nothing) ())
          (Array.aset! flags 1 true)))))

  (sig origin-of
       (Fn
         [(Ref SpecializedExpr) (Ref BorrowState) (Ref (Array CoreRef))]
         BorrowOrigin))
  (sig call-result-origin
       (Fn
         [(Ref MonoType)
          (Ref (Array (Box SpecializedExpr)))
          (Ref BorrowState)
          (Ref (Array CoreRef))]
         BorrowOrigin))
  (sig analyze
       (Fn
         [(Ref SpecializedExpr)
          (Ref BorrowState)
          (Ref (Array CoreRef))
          (Ref OwnershipTypeFacts)
          (Ref (Array Bool))
          Bool]
         BorrowState))
  (sig analyze-call-args
       (Fn
         [(Ref (Box MonoType))
          (Ref (Array (Box SpecializedExpr)))
          (Ref BorrowState)
          (Ref (Array CoreRef))
          (Ref OwnershipTypeFacts)
          (Ref (Array Bool))]
         BorrowState))

  (sig lambda-captured-origin
       (Fn [(Ref SpecializedExpr) (Ref BorrowState)] BorrowOrigin))
  (sig check-capture-moves!
       (Fn
         [(Ref SpecializedExpr)
          (Ref BorrowState)
          (Ref (Array CoreRef))
          (Ref OwnershipTypeFacts)
          (Ref (Array Bool))]
         ()))

  (private origin-of)
  (hidden origin-of)
  (private call-result-origin)
  (hidden call-result-origin)
  (private lambda-captured-origin)
  (hidden lambda-captured-origin)
  (private analyze)
  (hidden analyze)
  (private analyze-call-args)
  (hidden analyze-call-args)

  (defn call-result-origin [signature args state parameters]
    (match-ref signature
      (MonoType.Function arg-types result-type)
        (let-do [result-lts (the (Array MonoLifetime) [])]
          (collect-ref-lifetimes! (Box.peek result-type) &result-lts)
          (if (Int.= 0 (Array.length &result-lts))
            ;; no lifetime-variable reference anywhere in the result: a direct
            ;; static-lifetime reference result is a Static borrow, anything
            ;; else is not a borrow at all.
            (match-ref (Box.peek result-type)
              (MonoType.Reference _ result-lt)
                (match-ref result-lt
                  (MonoLifetime.Static) (BorrowOrigin.Static)
                  _ (BorrowOrigin.None))
              _ (BorrowOrigin.None))
            ;; the result borrows from every argument whose type shares one of
            ;; the result's lifetime variables — whether the reference sits
            ;; directly in the argument type or inside a struct it carries.
            (let-do [origin (BorrowOrigin.None)
                     n (Int.min (Array.length arg-types) (Array.length args))]
              (for [i 0 n]
                (let-do [arg-lts (the (Array MonoLifetime) [])]
                  (collect-ref-lifetimes!
                    (Box.peek (Array.unsafe-nth arg-types i))
                    &arg-lts)
                  (when (any-lifetime-shared? &arg-lts &result-lts)
                    (set! origin
                          (join-origin &origin
                                       &(origin-of (Box.peek (Array.unsafe-nth args
                                                                               i))
                                                   state
                                                   parameters))))))
              origin)))
      _ (BorrowOrigin.None)))

  (defn origin-of [expr state parameters]
    (match-ref expr
      (SpecializedExpr.GlobalCall _ _ callee signature _ args)
      (if (is-ref-call? callee args)
        (let [operand (Box.peek (Array.unsafe-nth args 0))]
          (match-ref operand
            (SpecializedExpr.Reference _ _ x)
            (cond
              @(CoreRef.global x) (BorrowOrigin.Static)
              (contains-ref? parameters x)
                (BorrowOrigin.Param [(CoreRef.copy x)])
              (single-local x))
            ; `&<temporary>`: see `temporary-origin`
            _
            (temporary-origin operand)))
        (call-result-origin (Box.peek signature) args state parameters))
      (SpecializedExpr.Reference _ node-type binder)
      (match-ref (Box.peek node-type)
        (MonoType.Reference _ _)
        (cond
          @(CoreRef.global binder) (BorrowOrigin.Static)
          (contains-ref? parameters binder) (BorrowOrigin.External)
          (state-origin state binder))
        ;; a closure value carries the origins of the borrows it captured;
        ;; ref-containing structs bound to a local do too.
        _
        (if (or @(CoreRef.global binder) (contains-ref? parameters binder))
          (BorrowOrigin.None)
          (state-origin state binder)))
      ;; a lambda's environment holds copies of its captures; any borrows those
      ;; copies contain still point at the enclosing frame's bindings.
      (SpecializedExpr.Lambda _ _ _ body)
      (lambda-captured-origin (Box.peek body) state)
      _
      (BorrowOrigin.None)))

  (defn lambda-captured-origin [body state]
    (let-do [origin (BorrowOrigin.None)
             origins (BorrowState.origins state)
             n (Array.length origins)]
      (for [i 0 n]
        (let [pair (Array.unsafe-nth origins i)]
          (when (captured? (Pair.a pair) body)
            (set! origin (join-origin &origin (Pair.b pair))))))
      origin))

  (private borrowish?)
  (hidden borrowish?)
  (defn borrowish? [origin]
    (match-ref origin
      (BorrowOrigin.Local _) true
      (BorrowOrigin.Param _) true
      _ false))

  (doc syntactic-borrow-origin "returns the locals and `parameters` that the
value `expr` borrows from by its shape, without using lifetimes. Unification can
turn a result lifetime static, so the shape is needed too.")
  (private syntactic-borrow-origin)
  (hidden syntactic-borrow-origin)
  (sig syntactic-borrow-origin
       (Fn
         [(Ref SpecializedExpr) (Ref BorrowState) (Ref (Array CoreRef))]
         BorrowOrigin))
  (defn syntactic-borrow-origin [expr state parameters]
    (match-ref expr
      (SpecializedExpr.GlobalCall _ _ callee _ _ args)
        (if (is-ref-call? callee args)
          (origin-of expr state parameters)
          (let-do [origin (BorrowOrigin.None)
                   n (Array.length args)]
            (for [i 0 n]
              (let [arg (Box.peek (Array.unsafe-nth args i))]
                (when (ref-type? &(Specialize.expression-type arg))
                  (set! origin
                        (join-origin &origin
                                     &(syntactic-borrow-origin arg
                                                               state
                                                               parameters))))))
            origin))
      (SpecializedExpr.Call _ _ callee args)
        (let-do [origin (syntactic-borrow-origin (Box.peek callee)
                                                 state
                                                 parameters)
                 n (Array.length args)]
          (for [i 0 n]
            (let [arg (Box.peek (Array.unsafe-nth args i))]
              (when (ref-type? &(Specialize.expression-type arg))
                (set! origin
                      (join-origin &origin
                                   &(syntactic-borrow-origin arg
                                                             state
                                                             parameters))))))
          origin)
      (SpecializedExpr.Reference _ _ _) (origin-of expr state parameters)
      (SpecializedExpr.Let _ _ _ _ body)
        (syntactic-borrow-origin (Box.peek body) state parameters)
      (SpecializedExpr.Do _ _ es)
        (let [n (Array.length es)]
          (if (Int.> n 0)
            (syntactic-borrow-origin
              (Box.peek (Array.unsafe-nth es (Int.dec n)))
              state
              parameters)
            (BorrowOrigin.None)))
      (SpecializedExpr.If _ _ _ t e)
        (join-origin
          &(syntactic-borrow-origin (Box.peek t) state parameters)
          &(syntactic-borrow-origin (Box.peek e) state parameters))
      (SpecializedExpr.Annotation _ _ inner _)
        (syntactic-borrow-origin (Box.peek inner) state parameters)
      _ (BorrowOrigin.None)))

  (doc binding-value-origin "returns the origin to record for a binding of
`value`: the origin of its lifetime if that names owners, else the syntactic
origin of a reference-typed value.")
  (private binding-value-origin)
  (hidden binding-value-origin)
  (defn binding-value-origin [value state parameters]
    (let [precise (origin-of value state parameters)]
      (cond
        (borrowish? &precise) precise
        (ref-type? &(Specialize.expression-type value))
          (let [fallback (syntactic-borrow-origin value state parameters)]
            (if (borrowish? &fallback) fallback precise))
        precise)))

  (private callee-function-type)
  (hidden callee-function-type)
  (doc callee-function-type "returns the function type of a callee of `type`,
through any references.")
  (defn callee-function-type [type]
    (match-ref type
      (MonoType.Reference inner _) (callee-function-type (Box.peek inner))
      _ (MonoType.copy type)))

  (defn analyze-call-args [signature args state parameters facts flags]
    (match-ref (Box.peek signature)
      (MonoType.Function arg-types _)
        (let-do [current @state
                 pending (the (Array CoreRef) [])
                 n (Array.length args)]
          (for [i 0 n]
            (do
              (set! current
                    (analyze (Box.peek (Array.unsafe-nth args i))
                             &current
                             parameters
                             facts
                             flags
                             false))
              (let [arg (Box.peek (Array.unsafe-nth args i))]
                (if (and (Int.< i (Array.length arg-types))
                         (ref-type? (Box.peek (Array.unsafe-nth arg-types i))))
                  (check-use-after-move! &(origin-of arg &current parameters)
                                         &current
                                         flags)
                  (match-ref arg
                    ;; owned params are consumed exactly like owned locals: a
                    ;; by-value pass moves them, and later borrows must notice.
                    (SpecializedExpr.Reference _ node-type x)
                    (when (and (owned-type? (Box.peek node-type) facts)
                               (not @(CoreRef.global x)))
                      (Array.push-back! &pending (CoreRef.copy x)))
                    _
                    ())))))
          ;; a by-value argument is consumed by the CALL itself, which happens
          ;; only after every argument expression has been evaluated. Marking
          ;; the move mid-loop would poison borrows used by later arguments.
          (for [i 0 (Array.length &pending)]
            (set! current
                  (state-mark-moved-checked &current
                                            (Array.unsafe-nth &pending i)
                                            flags)))
          current)
      _ @state))

  (defn analyze [expr state parameters facts flags tail?]
    (match-ref expr
      (SpecializedExpr.Let _ _ binder value body)
        (let [after-value (analyze (Box.peek value)
                                   state
                                   parameters
                                   facts
                                   flags
                                   false)
              vo (binding-value-origin (Box.peek value) &after-value parameters)
              ;; unmove first: a loop re-enters the binding with a fresh value,
              ;; so the previous iteration's scope-death mark must not linger.
              bound (state-set-origin &(state-unmove &after-value binder)
                                      binder
                                      vo)
              after-body (analyze (Box.peek body)
                                  &bound
                                  parameters
                                  facts
                                  flags
                                  tail?)]
          ;; the binding dies at scope exit: any borrow into it still held by
          ;; an outer binding is dangling from here on.
          (state-mark-moved &after-body binder))
      (SpecializedExpr.Do _ _ es)
        (let-do [current @state
                 n (Array.length es)]
          (for [i 0 n]
            (set! current
                  (analyze (Box.peek (Array.unsafe-nth es i))
                           &current
                           parameters
                           facts
                           flags
                           (and tail? (Int.= i (Int.dec n))))))
          current)
      (SpecializedExpr.If _ _ c t e)
        (let [after-c (analyze (Box.peek c) state parameters facts flags false)
              st (analyze (Box.peek t) &after-c parameters facts flags tail?)
              se (analyze (Box.peek e) &after-c parameters facts flags tail?)]
          (state-join &st &se))
      (SpecializedExpr.Match _ _ _ scrutinee branches)
        (let-do [after-s (analyze (Box.peek scrutinee)
                                  state
                                  parameters
                                  facts
                                  flags
                                  false)
                 joined @&after-s
                 seen false
                 n (Array.length branches)]
          ;; a by-value match gives the scrutinee away: constructor patterns
          ;; bind its fields, so the value must not be used afterwards. A
          ;; `match-ref` scrutinee is reference-typed, which is never owned,
          ;; so it is naturally exempt.
          (match-ref (Box.peek scrutinee)
            (SpecializedExpr.Reference _ node-type sbinder)
              (when-do (and (owned-type? (Box.peek node-type) facts)
                            (not @(CoreRef.global sbinder)))
                (set! after-s (state-mark-moved-checked &after-s sbinder flags))
                (set! joined @&after-s))
            _ ())
          (for [i 0 n]
            (let [branch (Array.unsafe-nth branches i)
                  entry (state-unmove-all &after-s
                                          (SpecializedMatchBranch.bindings branch))
                  branch-state (analyze
                    (Box.peek (SpecializedMatchBranch.body branch))
                    &entry
                    parameters
                    facts
                    flags
                    tail?)]
              (if seen
                (set! joined (state-join &joined &branch-state))
                (do (set! joined @&branch-state) (set! seen true)))))
          joined)
      (SpecializedExpr.While _ _ c body)
        (let-do [entry @state
                 done false]
          ; the condition can be reached after any number of iterations, so
          ; its state is the join over all of them: iterate until it stops
          ; changing. a borrow handed along n `set!`s takes n passes to reach
          ; its use. joins only grow, over the binders in scope, so this ends.
          (while (not done)
            (let [after-c (analyze (Box.peek c)
                                   &entry
                                   parameters
                                   facts
                                   flags
                                   false)
                  after-body (analyze (Box.peek body)
                                      &after-c
                                      parameters
                                      facts
                                      flags
                                      false)
                  next (state-join &entry &after-body)]
              (if (state-same? &next &entry) (set! done true) (set! entry next))))
          (analyze (Box.peek c) &entry parameters facts flags false))
      (SpecializedExpr.Set _ _ binder value)
        (let-do [after-value (analyze (Box.peek value)
                                      state
                                      parameters
                                      facts
                                      flags
                                      false)
                 vo (binding-value-origin (Box.peek value)
                                          &after-value
                                          parameters)
                 reinitialized (state-unmove &after-value binder)]
          ;; the set! drops the binding's old value, so the binding must still
          ;; own one: a move on any path before it is a use-after-move, as in
          ;; the reference. A self-rebind consumes the old value inside
          ;; `value`, after this check.
          (when (contains-ref? (BorrowState.moved state) binder)
            (Array.aset! flags 3 true))
          (state-set-origin &reinitialized binder vo))
      (SpecializedExpr.GlobalCall _ _ callee signature _ args)
        (if (is-ref-call? callee args)
          (let-do [current (analyze (Box.peek (Array.unsafe-nth args 0))
                                    state
                                    parameters
                                    facts
                                    flags
                                    false)]
            (check-use-after-move! &(origin-of expr &current parameters)
                                   &current
                                   flags)
            (when tail?
              (check-escape! &(origin-of expr &current parameters) flags))
            current)
          (let-do [current (analyze-call-args signature
                                              args
                                              state
                                              parameters
                                              facts
                                              flags)]
            (when tail?
              (check-escape! &(origin-of expr &current parameters) flags))
            current))
      (SpecializedExpr.Call _ _ callee args)
        (let-do [current (analyze (Box.peek callee)
                                  state
                                  parameters
                                  facts
                                  flags
                                  false)
                 signature (Box.init
                   (callee-function-type
                     &(Specialize.expression-type (Box.peek callee))))]
          ;; invoking a closure uses every borrow its environment captured;
          ;; if any captured borrow's owner has been moved, this call dangles.
          (check-use-after-move!
            &(origin-of (Box.peek callee) &current parameters)
            &current
            flags)
          ;; its arguments are passed like a named call's: by value moves.
          ;; a callee without a function type would leave them unchecked, so
          ;; it is an error rather than a gap.
          (match-ref (Box.peek &signature)
            (MonoType.Function _ _)
              (analyze-call-args &signature args &current parameters facts flags)
            _ (do (Array.aset! flags 4 true) current)))
      (SpecializedExpr.Reference _ _ _)
        (do
          (when tail? (check-escape! &(origin-of expr state parameters) flags))
          @state)
      (SpecializedExpr.Annotation _ _ inner _)
        (analyze (Box.peek inner) state parameters facts flags tail?)
      (SpecializedExpr.ArrayLit _ _ es)
        (let-do [current @state
                 n (Array.length es)]
          (for [i 0 n]
            (set! current
                  (analyze (Box.peek (Array.unsafe-nth es i))
                           &current
                           parameters
                           facts
                           flags
                           false)))
          current)
      (SpecializedExpr.StaticArrayLit _ _ es)
        (let-do [current @state
                 n (Array.length es)]
          (for [i 0 n]
            (set! current
                  (analyze (Box.peek (Array.unsafe-nth es i))
                           &current
                           parameters
                           facts
                           flags
                           false)))
          current)
      (SpecializedExpr.Lambda _ _ _ body)
        (do
          ;; a capture lives in the closure environment; a consuming use inside
          ;; the body would move it out of that environment, which must be
          ;; rejected because the closure can run more than once.
          (check-capture-moves! (Box.peek body) state parameters facts flags)
          ;; the body runs when the closure is called, not here, so its state
          ;; stays inside it. Returning it would leak the body's own bindings
          ;; into the enclosing frame: a `let` borrow in the body would look
          ;; like a capture of a local its scope exit had killed, and every
          ;; call of the closure a use after move.
          (ignore (analyze (Box.peek body) state parameters facts flags false))
          @state)
      _ @state))

  (private check-capture-moves!)
  (hidden check-capture-moves!)
  (defn check-capture-moves! [body state parameters facts flags]
    (let-do [origins (BorrowState.origins state)
             n (Array.length origins)]
      (for [i 0 n]
        (let [binder (Pair.a (Array.unsafe-nth origins i))]
          (when (and (consumed? binder body)
                     (owned-reference-in? body binder facts))
            (Array.aset! flags 2 true))))
      (for [i 0 (Array.length parameters)]
        (let [p (Array.unsafe-nth parameters i)]
          (when (and (consumed? p body) (owned-reference-in? body p facts))
            (Array.aset! flags 2 true))))))

  (doc check-borrows "checks the borrows of one definition `body` with
`parameters`. It returns five flags: 0 if a borrow into a local or by-value
parameter escapes, 1 if a borrow is used after its owner moved, 2 if a lambda
moves a captured value out, 3 if an owned value is moved again or `set!` on a
moved binder, and 4 if a call goes through a callee that is not a function. Loop
bodies are checked twice.")
  (defn check-borrows [body parameters facts]
    (let-do [flags [false false false false false]
             state (BorrowState.init [] [])]
      (ignore (analyze body &state parameters facts &flags true))
      flags))

  (defn make-delete-action [context id reference type]
    (OwnershipAction.Delete (OwnershipSite.init context id)
                            (OwnershipResource.Binding reference)
                            (Box.init type)))

  (private make-temporary-delete)
  (hidden make-temporary-delete)
  (defn make-temporary-delete [context id type]
    (OwnershipAction.Delete (OwnershipSite.init context id)
                            (OwnershipResource.Temporary id)
                            (Box.init type)))

  (private make-move-action)
  (hidden make-move-action)
  (defn make-move-action [context id from to type]
    (OwnershipAction.Move (OwnershipSite.init context id)
                          (OwnershipResource.Binding from)
                          (OwnershipResource.Binding to)
                          (Box.init type)))

  (doc mentions? "checks whether `binder` occurs anywhere in `expr`, borrowed or
not.")
  (private mentions?)
  (hidden mentions?)
  (sig mentions? (Fn [(Ref CoreRef) (Ref SpecializedExpr)] Bool))
  (sig mentions-in-any?
       (Fn [(Ref CoreRef) (Ref (Array (Box SpecializedExpr)))] Bool))
  (sig mentions-in-branches?
       (Fn [(Ref CoreRef) (Ref (Array SpecializedMatchBranch))] Bool))
  (private mentions-in-any?)
  (hidden mentions-in-any?)
  (private mentions-in-branches?)
  (hidden mentions-in-branches?)
  (defn mentions-in-any? [binder es]
    (let-do [found false]
      (for [i 0 (Array.length es)]
        (when (mentions? binder (Box.peek (Array.unsafe-nth es i)))
          (set! found true)))
      found))
  (defn mentions-in-branches? [binder branches]
    (let-do [found false]
      (for [i 0 (Array.length branches)]
        (when (mentions? binder
                         (Box.peek
                           (SpecializedMatchBranch.body (Array.unsafe-nth branches
                                                                          i))))
          (set! found true)))
      found))
  (defn mentions? [binder expr]
    (match-ref expr
      (SpecializedExpr.Reference _ _ r) (CoreIR.same-ref? r binder)
      (SpecializedExpr.Set _ _ target value)
        (or (CoreIR.same-ref? target binder) (mentions? binder (Box.peek value)))
      (SpecializedExpr.Call _ _ callee args)
        (or (mentions? binder (Box.peek callee)) (mentions-in-any? binder args))
      (SpecializedExpr.GlobalCall _ _ _ _ _ args) (mentions-in-any? binder args)
      (SpecializedExpr.Let _ _ _ value body)
        (or (mentions? binder (Box.peek value))
            (mentions? binder (Box.peek body)))
      (SpecializedExpr.Do _ _ es) (mentions-in-any? binder es)
      (SpecializedExpr.If _ _ c t e)
        (or (mentions? binder (Box.peek c))
            (or (mentions? binder (Box.peek t)) (mentions? binder (Box.peek e))))
      (SpecializedExpr.While _ _ c b)
        (or (mentions? binder (Box.peek c)) (mentions? binder (Box.peek b)))
      (SpecializedExpr.Match _ _ _ scrutinee branches)
        (or (mentions? binder (Box.peek scrutinee))
            (mentions-in-branches? binder branches))
      (SpecializedExpr.Annotation _ _ inner _)
        (mentions? binder (Box.peek inner))
      (SpecializedExpr.ArrayLit _ _ es) (mentions-in-any? binder es)
      (SpecializedExpr.StaticArrayLit _ _ es) (mentions-in-any? binder es)
      (SpecializedExpr.Lambda _ _ _ b) (mentions? binder (Box.peek b))
      _ false))

  (doc type-can-alias? "checks whether a value of `type` can hold a reference:
it contains a reference, or it is a function, whose environment can hold one.")
  (private type-can-alias?)
  (hidden type-can-alias?)
  (sig type-can-alias? (Fn [(Ref MonoType)] Bool))
  (defn type-can-alias? [type]
    (match-ref type
      (MonoType.Reference _ _) true
      (MonoType.Function _ _) true
      (MonoType.Named _ arguments)
        (let-do [found false]
          (for [i 0 (Array.length arguments)]
            (when (type-can-alias? (Box.peek (Array.unsafe-nth arguments i)))
              (set! found true)))
          found)
      _ false))

  (doc reflift? "checks whether `binder` is a temporary that RefLift made. A
borrow of it outlives every mention, so its delete stays at scope exit.")
  (private reflift?)
  (hidden reflift?)
  (defn reflift? [binder] (String.starts-with? (CoreRef.name binder) "_reflift"))

  (doc live-past-here? "checks whether `binder` occurs anywhere in the rest of
the scope, borrowed or not.")
  (sig live-past-here? (Fn [(Ref CoreRef) (Ref SpecializedExpr)] Bool))
  (defn live-past-here? [binder expr] (mentions? binder expr))

  (doc alias-binding? "checks whether binding `value` could keep a reference to
`binder`: it mentions the binder and its type can hold a reference.")
  (private alias-binding?)
  (hidden alias-binding?)
  (sig alias-binding? (Fn [(Ref CoreRef) (Ref SpecializedExpr)] Bool))
  (defn alias-binding? [binder value]
    (and (mentions? binder value)
         (type-can-alias? &(Specialize.expression-type value))))

  (doc aliased-in-scope? "checks whether anything in the scope could keep a
reference to `binder`, so it must live to scope exit. It looks at `let` and
`set!` forms and their nested scopes, but not into call arguments, array
literals or lambda bodies.")
  (private aliased-in-scope?)
  (hidden aliased-in-scope?)
  (sig aliased-in-scope? (Fn [(Ref CoreRef) (Ref SpecializedExpr)] Bool))
  (sig aliased-in-any?
       (Fn [(Ref CoreRef) (Ref (Array (Box SpecializedExpr)))] Bool))
  (sig aliased-in-branches?
       (Fn [(Ref CoreRef) (Ref (Array SpecializedMatchBranch))] Bool))
  (private aliased-in-any?)
  (hidden aliased-in-any?)
  (private aliased-in-branches?)
  (hidden aliased-in-branches?)
  (defn aliased-in-any? [binder es]
    (let-do [found false]
      (for [i 0 (Array.length es)]
        (when (aliased-in-scope? binder (Box.peek (Array.unsafe-nth es i)))
          (set! found true)))
      found))
  (defn aliased-in-branches? [binder branches]
    (let-do [found false]
      (for [i 0 (Array.length branches)]
        (when (aliased-in-scope? binder
                                 (Box.peek
                                   (SpecializedMatchBranch.body (Array.unsafe-nth branches
                                                                                  i))))
          (set! found true)))
      found))
  (defn aliased-in-scope? [binder expr]
    (match-ref expr
      (SpecializedExpr.Let _ _ _ value inner)
      (or (alias-binding? binder (Box.peek value))
          (aliased-in-scope? binder (Box.peek inner)))
      ;; a set! can put an alias into a binding that outlives this scope
      (SpecializedExpr.Set _ _ _ value)
      (alias-binding? binder (Box.peek value))
      (SpecializedExpr.Do _ _ es)
      (aliased-in-any? binder es)
      (SpecializedExpr.If _ _ c t e)
      (or (aliased-in-scope? binder (Box.peek c))
          (or (aliased-in-scope? binder (Box.peek t))
              (aliased-in-scope? binder (Box.peek e))))
      (SpecializedExpr.While _ _ c b)
      (or (aliased-in-scope? binder (Box.peek c))
          (aliased-in-scope? binder (Box.peek b)))
      (SpecializedExpr.Match _ _ _ scrutinee branches)
      (or
        (aliased-in-scope? binder (Box.peek scrutinee))
        (aliased-in-branches? binder branches))
      (SpecializedExpr.Annotation _ _ inner _)
      (aliased-in-scope? binder (Box.peek inner))
      _
      false))

  (doc delete-movable? "checks whether a planned delete of `binder` may move
from the end of `body` to just after its last use.")
  (sig delete-movable? (Fn [(Ref CoreRef) (Ref SpecializedExpr)] Bool))
  (defn delete-movable? [binder body]
    (cond
      (reflift? binder)
      false
      ;; a conditional move needs path-sensitive placement instead: the paths
      ;; that gave the value away must not also free it.
      (consumed? binder body)
      false
      (aliased-in-scope? binder body)
      false
      true))

  (private collect-into!)
  (hidden collect-into!)
  (defn collect-into! [expr facts context constructors acc]
    (match-ref expr
      (SpecializedExpr.Let id _ binder value body)
        (do
          (collect-into! (Box.peek value) facts context constructors acc)
          (collect-into! (Box.peek body) facts context constructors acc)
          (let [value-type (Specialize.expression-type (Box.peek value))]
            (when-do (owned-type? &value-type facts)
              (match-ref (Box.peek value)
                (SpecializedExpr.Reference _ _ target)
                  (Array.push-back! acc
                                    (make-move-action context
                                                      @id
                                                      (CoreRef.copy target)
                                                      (CoreRef.copy binder)
                                                      (MonoType.copy &value-type)))
                _ ())
              (unless (consumed-on-all-paths? binder (Box.peek body))
                (Array.push-back! acc
                                  (make-delete-action context
                                                      @id
                                                      (CoreRef.copy binder)
                                                      (MonoType.copy &value-type)))))))
      (SpecializedExpr.Do _ _ es)
        (let-do [n (Array.length es)]
          (for [i 0 n]
            (let-do [el (Box.peek (Array.unsafe-nth es i))]
              (collect-into! el facts context constructors acc)
              (when (Int.< i (Int.dec n))
                (let [el-type (Specialize.expression-type el)]
                  (when (owned-type? &el-type facts)
                    (Array.push-back! acc
                                      (make-temporary-delete context
                                                             (Specialize.expression-id el)
                                                             (MonoType.copy &el-type)))))))))
      (SpecializedExpr.If _ _ c t e)
        (do
          (collect-into! (Box.peek c) facts context constructors acc)
          (collect-into! (Box.peek t) facts context constructors acc)
          (collect-into! (Box.peek e) facts context constructors acc))
      (SpecializedExpr.Call _ _ callee args)
        (do
          (collect-into! (Box.peek callee) facts context constructors acc)
          (for [i 0 (Array.length args)]
            (collect-into! (Box.peek (Array.unsafe-nth args i))
                           facts
                           context
                           constructors
                           acc)))
      (SpecializedExpr.GlobalCall id _ callee _ _ args)
        (do
          (for [i 0 (Array.length args)]
            (collect-into! (Box.peek (Array.unsafe-nth args i))
                           facts
                           context
                           constructors
                           acc))
          ;; `StaticArray.aset!` drops the element it overwrites at the write
          ;; site: demand a deleter for an owned element type (requirement
          ;; only, the backend emits the delete).
          (when (and
              (CoreIR.same-ref? callee
                                &(PrimitiveRegistry.reference 21
                                                              "StaticArray.aset!"))
              (Int.= (Array.length args) 3))
            (let [value-type (Specialize.expression-type (Box.peek (Array.unsafe-nth args
                                                                                     2)))]
              (when (owned-type? &value-type facts)
                (Array.push-back! acc
                                  (make-temporary-delete context @id value-type)))))
          ;; `field-set!` (a mutating setter) drops the field value it
          ;; overwrites the same way: without the requirement the backend has
          ;; no deleter for a type nothing else deletes, and writes over it.
          (when (and
              (CoreIR.same-ref? callee
                                &(PrimitiveRegistry.reference 49 "field-set!"))
              (Int.= (Array.length args) 4))
            (let [value-type (Specialize.expression-type (Box.peek (Array.unsafe-nth args
                                                                                     3)))]
              (when (owned-type? &value-type facts)
                (Array.push-back! acc
                                  (make-temporary-delete context @id value-type))))))
      (SpecializedExpr.While _ _ c body)
        (do
          (collect-into! (Box.peek c) facts context constructors acc)
          (collect-into! (Box.peek body) facts context constructors acc))
      (SpecializedExpr.Set id _ target value)
        (do
          (collect-into! (Box.peek value) facts context constructors acc)
          ;; overwriting an owned binding drops its previous value: schedule a
          ;; delete of the old value at the set site unless the new value's
          ;; expression consumes the binding (rebind-through idioms).
          (let [value-type (Specialize.expression-type (Box.peek value))]
            (when (and (owned-type? &value-type facts)
                       (not (consumed? target (Box.peek value))))
              (Array.push-back! acc
                                (make-delete-action context
                                                    @id
                                                    (CoreRef.copy target)
                                                    (MonoType.copy &value-type))))))
      (SpecializedExpr.Annotation _ _ inner _)
        (collect-into! (Box.peek inner) facts context constructors acc)
      (SpecializedExpr.ArrayLit _ _ es)
        (for [i 0 (Array.length es)]
          (collect-into! (Box.peek (Array.unsafe-nth es i))
                         facts
                         context
                         constructors
                         acc))
      (SpecializedExpr.StaticArrayLit _ _ es)
        (for [i 0 (Array.length es)]
          (collect-into! (Box.peek (Array.unsafe-nth es i))
                         facts
                         context
                         constructors
                         acc))
      (SpecializedExpr.Match _ _ by-reference scrutinee branches)
        (do
          (collect-into! (Box.peek scrutinee) facts context constructors acc)
          (for [i 0 (Array.length branches)]
            (let-do [branch (Array.unsafe-nth branches i)
                     body (Box.peek (SpecializedMatchBranch.body branch))]
              (collect-into! body facts context constructors acc)
              ;; a by-value match moves each payload into its binding; a
              ;; binding the branch body does not consume must be deleted at
              ;; branch exit — including bindings the body never mentions
              ;; (setter-displaced fields), which is why the types come from
              ;; the pattern, not from body references. `match-ref` bindings
              ;; only borrow — never delete.
              (unless @by-reference
                (let-do [scrutinee-type (Specialize.expression-type (Box.peek scrutinee))
                         slot-types (PatternTyping.analyze (SpecializedMatchBranch.pattern branch)
                                                           &scrutinee-type
                                                           constructors)
                         bound (PatternSlotTypes.bound &slot-types)
                         ignored (PatternSlotTypes.unbound &slot-types)]
                  ; Bound payloads receive scope cleanup before ignored payload
                  ; demands, retaining the existing ownership action order.
                  (for [j 0 (Array.length bound)]
                    (let [slot (Array.unsafe-nth bound j)
                          binder (Pair.a slot)
                          slot-type (Pair.b slot)]
                      (when (and (owned-type? slot-type facts)
                                 (not (consumed-on-all-paths? binder body)))
                        (Array.push-back! acc
                                          (make-delete-action context
                                                              (Specialize.expression-id body)
                                                              (CoreRef.copy binder)
                                                              (MonoType.copy slot-type))))))
                  (for [j 0 (Array.length ignored)]
                    (let [slot (Array.unsafe-nth ignored j)]
                      (when (owned-type? slot facts)
                        (Array.push-back! acc
                                          (make-temporary-delete context
                                                                 (Specialize.expression-id body)
                                                                 (MonoType.copy slot)))))))))))
      (SpecializedExpr.Lambda _ signature parameters body)
        (do
          (collect-into! (Box.peek body) facts context constructors acc)
          ; lambda lifting runs after ownership planning, so the deletes of
          ; owned lambda parameters not consumed on every path are recorded
          ; here, at the root. the backend treats them as parameter cleanup
          ; once the lambda is a body of its own.
          (match-ref (Box.peek signature)
            (MonoType.Function argument-types _)
              (let [n (Int.min (Array.length parameters)
                               (Array.length argument-types))]
                (for [i 0 n]
                  (let [parameter (Array.unsafe-nth parameters i)
                        parameter-type (Box.peek (Array.unsafe-nth argument-types
                                                                   i))]
                    (when (and (owned-type? parameter-type facts)
                               (not
                                 (consumed-on-all-paths? parameter
                                                         (Box.peek body))))
                      (Array.push-back! acc
                                        (make-delete-action context
                                                            (Specialize.expression-id (Box.peek body))
                                                            (CoreRef.copy parameter)
                                                            (MonoType.copy parameter-type)))))))
            _ ()))
      _ ()))

  (private collect-context-deletes)
  (hidden collect-context-deletes)
  (defn collect-context-deletes [expr facts context constructors]
    (let-do [acc (the (Array OwnershipAction) [])]
      (collect-into! expr facts context constructors &acc)
      acc))

  (private deleter-function?)
  (hidden deleter-function?)
  (doc deleter-function? "checks whether `reference` implements the `delete`
interface, according to `facts`.")
  (defn deleter-function? [facts reference]
    (let-do [found false
             ids (OwnershipTypeFacts.deleters facts)
             n (Array.length ids)]
      (for [i 0 n]
        (when (Int.= @(Array.unsafe-nth ids i) @(CoreRef.id reference))
          (set! found true)))
      found))

  (private collect-param-deletes)
  (hidden collect-param-deletes)
  (doc collect-param-deletes "plans a delete for every owned parameter that
`body` does not move on every path. If `deleter?` is true, the body is a
`delete` implementation and gets none, because the value it is given is the one
it frees, as in the reference.")
  (defn collect-param-deletes [parameters signature body facts context deleter?]
    (match-ref signature
      (MonoType.Function arg-types _)
        (let-do [result (the (Array OwnershipAction) [])
                 n (Int.min (Array.length parameters) (Array.length arg-types))]
          (for [i 0 n]
            (let [param (Array.unsafe-nth parameters i)
                  param-type (Box.peek (Array.unsafe-nth arg-types i))]
              (when (and (not (and deleter? (Int.= i 0)))
                         (and (owned-type? param-type facts)
                              (not (consumed-on-all-paths? param body))))
                (Array.push-back! &result
                                  (make-delete-action context
                                                      (Specialize.expression-id body)
                                                      (CoreRef.copy param)
                                                      (MonoType.copy param-type))))))
          result)
      _ (the (Array OwnershipAction) [])))

  (private collect-roots-deletes)
  (hidden collect-roots-deletes)
  (defn collect-roots-deletes [expressions facts context constructors]
    (let-do [result (the (Array OwnershipAction) [])
             n (Array.length expressions)]
      (for [i 0 n]
        (let-do [root (Box.peek (Array.unsafe-nth expressions i))
                 root-type (Specialize.expression-type root)]
          (set! result
                (append-actions result
                                (collect-context-deletes root
                                                         facts
                                                         context
                                                         constructors)))
          (when (owned-type? &root-type facts)
            (set! result
                  (Array.push-back result
                                   (make-temporary-delete context
                                                          (Specialize.expression-id root)
                                                          (MonoType.copy &root-type)))))))
      result))

  (private delete-requirements)
  (hidden delete-requirements)
  (doc delete-requirements "returns one `DeleteFunction` requirement for each
type that `actions` delete, so the driver can specialize those deletes before
lowering.")
  (defn delete-requirements [actions]
    (let-do [result (the (Array OwnershipRequirement) [])
             keys (the (Array String) [])
             n (Array.length actions)]
      (for [i 0 n]
        (match-ref (Array.unsafe-nth actions i)
          (OwnershipAction.Delete _ _ type)
            (let-do [key (CAbi.type-key (Box.peek type))
                     seen false
                     m (Array.length &keys)]
              (for [j 0 m]
                (when (String.= (Array.unsafe-nth &keys j) &key)
                  (set! seen true)))
              (unless-do seen
                (set! keys (Array.push-back keys @&key))
                (set! result
                      (Array.push-back result
                                       (OwnershipRequirement.DeleteFunction
                                         (Box.init (MonoType.copy (Box.peek type))))))))
          _ ()))
      result))

  (register check-root-borrows
    (Fn
      [(Ref (Array (Box SpecializedExpr))) (Ref OwnershipTypeFacts)]
      (Result Unit OwnershipError)))

  (doc prepare "plans the ownership of `specialized`: it checks that expression
ids are unique and non-negative within each context, makes the contexts, checks
borrows, and plans moves and deletes. Types are classified with `facts`.")
  (defn prepare [specialized facts]
    (let-do [contexts (the (Array OwnershipContext) [])
             actions (the (Array OwnershipAction) [])
             result (the (Result OwnershipPlan OwnershipError)
                         (Result.Success (OwnershipPlan.init [] [] [])))
             bodies (SpecializationModule.bodies specialized)
             body-count (Array.length bodies)]
      (for [i 0 body-count]
        (match-ref &result
          (Result.Success _)
            (let [body (Array.unsafe-nth bodies i)
                  instance (SpecializedBody.specialization body)
                  seen (the (Array Bool) [])
                  label (String.concat
                    &[@"definition "
                      (String.copy
                        (CoreRef.name (Specialization.reference instance)))
                      @":"
                      (Type.render
                        (Box.peek (Specialization.signature instance)))])]
              (match (validate-expression (Box.peek (SpecializedBody.body body))
                                          &seen
                                          &label)
                (Result.Success _)
                  (let [flags (check-borrows (Box.peek (SpecializedBody.body body))
                                             (SpecializedBody.parameters body)
                                             facts)]
                    (cond
                      @(Array.unsafe-nth &flags 0)
                        (set! result
                              (Result.Error
                                (OwnershipError.init
                                  (String.concat
                                    &[@"a reference to a local value escapes "
                                      (String.copy
                                        (CoreRef.name (Specialization.reference instance)))]))))
                      @(Array.unsafe-nth &flags 1)
                        (set! result
                              (Result.Error
                                (OwnershipError.init
                                  (String.concat
                                    &[@"a borrow is used after its owner is moved in "
                                      (String.copy
                                        (CoreRef.name (Specialization.reference instance)))]))))
                      @(Array.unsafe-nth &flags 2)
                        (set! result
                              (Result.Error
                                (OwnershipError.init
                                  (String.concat
                                    &[@"a captured value is moved out of a lambda in "
                                      (String.copy
                                        (CoreRef.name (Specialization.reference instance)))]))))
                      @(Array.unsafe-nth &flags 3)
                        (set! result
                              (Result.Error
                                (OwnershipError.init
                                  (String.concat
                                    &[@"an owned value is used after it was moved in "
                                      (String.copy
                                        (CoreRef.name (Specialization.reference instance)))]))))
                      @(Array.unsafe-nth &flags 4)
                        (set! result
                              (Result.Error
                                (OwnershipError.init
                                  (String.concat
                                    &[@"a call goes through a value that is not a function in "
                                      (String.copy
                                        (CoreRef.name (Specialization.reference instance)))]))))
                      (do
                        (set! contexts
                              (Array.push-back contexts
                                               (OwnershipContext.Definition
                                                 (CoreRef.copy (Specialization.reference instance))
                                                 (Box.init
                                                   (MonoType.copy
                                                     (Box.peek (Specialization.signature instance))))
                                                 (String.copy (Specialization.symbol instance))
                                                 (Array.length &seen))))
                        (set! actions
                              (append-actions
                                (append-actions actions
                                                (collect-context-deletes (Box.peek (SpecializedBody.body body))
                                                                         facts
                                                                         i
                                                                         (SpecializationModule.constructors specialized)))
                                (collect-param-deletes (SpecializedBody.parameters body)
                                                       (Box.peek (Specialization.signature instance))
                                                       (Box.peek (SpecializedBody.body body))
                                                       facts
                                                       i
                                                       (deleter-function? facts
                                                                          (Specialization.reference instance))))))))
                (Result.Error error) (set! result (Result.Error error))))
          (Result.Error _) ()))
      (match-ref &result
        (Result.Success _)
          (let [root-label (String.copy "roots")
                seen (the (Array Bool) [])]
            (match (validate-expressions (SpecializationModule.roots specialized)
                                         &seen
                                         &root-label)
              (Result.Success _)
                (match (check-root-borrows (SpecializationModule.roots specialized)
                                           facts)
                  (Result.Error error) (set! result (Result.Error error))
                  (Result.Success _)
                    (let [all-actions (append-actions actions
                                                      (collect-roots-deletes (SpecializationModule.roots specialized)
                                                                             facts
                                                                             body-count
                                                                             (SpecializationModule.constructors specialized)))
                          reqs (delete-requirements &all-actions)]
                      (set! result
                            (Result.Success
                              (OwnershipPlan.init
                                (Array.push-back contexts
                                                 (OwnershipContext.Roots (Array.length &seen)))
                                all-actions
                                reqs)))))
              (Result.Error error) (set! result (Result.Error error))))
        (Result.Error _) ())
      result)))

(defmodule Ownership
  (private check-root-borrows)
  (hidden check-root-borrows)
  (defn check-root-borrows [roots facts]
    (let-do [answer (Result.Success ())
             parameters (the (Array CoreRef) [])
             messages [@"a reference to a local value escapes"
                       @"a borrow is used after its owner is moved in"
                       @"a captured value is moved out of a lambda in"
                       @"an owned value is used after it was moved in"
                       @"a call goes through a value that is not a function in"]]
      (for [i 0 (Array.length roots)]
        (when (Result.success? &answer)
          (let [flags (check-borrows (Box.peek (Array.unsafe-nth roots i))
                                     &parameters
                                     facts)]
            (for [j 0 (Array.length &flags)]
              (when (and (Result.success? &answer) @(Array.unsafe-nth &flags j))
                (set! answer
                      (Result.Error
                        (OwnershipError.init
                          (String.append (Array.unsafe-nth &messages j) " roots")))))))))
      answer)))
