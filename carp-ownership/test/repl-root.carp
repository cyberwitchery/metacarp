(load "../carp-ownership.carp")
(load "../../carp-resolve/carp-resolve.carp")
(load "Test.carp")
(Project.no-echo)
(use-all Test)

(defn prepare-root [source]
  (match (Surface.parse source)
    (Result.Success surface)
      (match (Resolve.module &surface)
        (Result.Success core)
          (match (Infer.module &core)
            (Result.Success inferred)
              (match (Specialize.module &core &inferred)
                (Result.Success specialized)
                  (Ownership.prepare &specialized
                                     &(OwnershipClassify.facts-from-module &core))
                (Result.Error error)
                  (Result.Error
                    (OwnershipError.init @(SpecializeError.message &error))))
            (Result.Error error)
              (Result.Error (OwnershipError.init @(InferError.message &error))))
        (Result.Error error)
          (Result.Error (OwnershipError.init @(ResolveError.message &error))))
    (Result.Error _) (Result.Error (OwnershipError.init @"parse error"))))

(def fixture "(register-type Widget)
(register make-widget (Fn [] Widget) \"make_widget\")
(defmodule Widget (register delete (Fn [Widget] ()) \"widget_delete\"))
(implements delete Widget.delete)
(register consume (Fn [Widget] ()) \"consume\")
(register inspect (Fn [(Ref Widget)] ()) \"inspect\")
")

(defn root-rejects-after-move? []
  (match (prepare-root
      &(String.append fixture
                      "(let [w (make-widget) r &w] (do (consume w) (inspect r)))"))
    (Result.Success _) false
    (Result.Error error)
      (String.contains-string? (OwnershipError.message &error)
                               "borrow is used after")))

(deftest test
  (assert-true test
    (root-rejects-after-move?)
    "top-level runtime roots reject a borrow used after its owner is moved")
  (assert-true test (valid-root?) "a root may borrow before moving its owner")
  (assert-true test
    (escaping-root-rejected?)
    "a root cannot return a borrow into a destroyed local")
  (assert-true test (repeated-move-root-rejected?) "roots reject repeated moves")
  (assert-true test
    (captured-borrow-root-rejected?)
    "roots check borrows captured by closures"))

(defn valid-root? []
  (Result.success?
    &(prepare-root
      &(String.append fixture
                      "(let [w (make-widget) r &w] (do (inspect r) (consume w)))"))))

(defn escaping-root-rejected? []
  (match (prepare-root &(String.append fixture "(let [w (make-widget)] &w)"))
    (Result.Success _) false
    (Result.Error error)
      (String.contains-string? (OwnershipError.message &error)
                               "local value escapes")))

(defn repeated-move-root-rejected? []
  (match (prepare-root
      &(String.append fixture
                      "(let [w (make-widget)] (do (consume w) (consume w)))"))
    (Result.Success _) false
    (Result.Error error)
      (String.contains-string? (OwnershipError.message &error)
                               "owned value is used after")))

(defn captured-borrow-root-rejected? []
  (match (prepare-root
      &(String.append fixture
                      "(let [w (make-widget) r &w f (fn [] (inspect r))] (do (consume w) (f)))"))
    (Result.Success _) false
    (Result.Error error)
      (String.contains-string? (OwnershipError.message &error)
                               "borrow is used after")))
