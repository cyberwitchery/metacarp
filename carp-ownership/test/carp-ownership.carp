(load "../carp-ownership.carp")
(load "../../carp-resolve/carp-resolve.carp")
(Project.no-echo)
(load "Test.carp")

(use-all Test)

(defn prepare-source [source]
  (match (Surface.parse source)
    (Result.Success surface)
      (match (Resolve.module &surface)
        (Result.Success core)
          (match (Infer.module &core)
            (Result.Success inferred)
              (match (Specialize.module &core &inferred)
                (Result.Success specialized)
                  (Ownership.prepare &specialized
                                     &(OwnershipClassify.facts-from-module &core))
                (Result.Error error)
                  (Result.Error
                    (OwnershipError.init @(SpecializeError.message &error))))
            (Result.Error error)
              (Result.Error (OwnershipError.init @(InferError.message &error))))
        (Result.Error error)
          (Result.Error (OwnershipError.init @(ResolveError.message &error))))
    (Result.Error _) (Result.Error (OwnershipError.init @"parse error"))))

(defn ownership-actions-retain-source-spans? []
  (let [span (SourceSpan.init (String.copy "cell:ownership") 4 9)
        provenance (CoreProvenance.init
          [(NodeProvenance.init 42 (SourceSpan.copy &span))]
          []
          [])
        plan (OwnershipPlan.init []
                                 [(OwnershipAction.Borrow (OwnershipSite.init 0
                                                                              42)
                                                          (OwnershipBorrowMode.Shared)
                                                          (OwnershipPlace.init
                                                            (OwnershipResource.Temporary 42)
                                                            []))]
                                 []
                                 []
                                 []
                                 [])
        actions (Ownership.spanned-actions &plan &provenance)]
    (and (Int.= 1 (Array.length &actions))
         (match-ref (SpannedOwnershipAction.span (Array.unsafe-nth &actions 0))
           (Maybe.Just action-span)
             (and
               (String.= (SourceSpan.source-id action-span) "cell:ownership")
               (and
                 (Int.= @(SourceSpan.start action-span) 4)
                 (Int.= @(SourceSpan.end action-span) 9)))
           (Maybe.Nothing) false))))

(defn generated-ownership-actions-use-derived-provenance? []
  (let-do [span (SourceSpan.init (String.copy "cell:derived-ownership") 0 17)
           fallback (the (Maybe SourceSpan) (Maybe.Just (SourceSpan.copy &span)))
           function (CoreFunction.init
             (CoreRef.init 1 (String.copy "derived") true)
             []
             (Box.init (CoreExpr.UnitLit -1)))
           core (CoreModule.init [function] [] [] [] [] [] [] [] [] [] [] [] [])
           provenance (CoreProvenance.init [] [] [])
           allocator (IdAllocator.init [100])
           identified (CoreIR.identify-generated &core
                                                 &provenance
                                                 &allocator
                                                 &fallback)
           plan (OwnershipPlan.init []
                                    [(OwnershipAction.Borrow (OwnershipSite.init 0
                                                                                 100)
                                                             (OwnershipBorrowMode.Shared)
                                                             (OwnershipPlace.init
                                                               (OwnershipResource.Temporary 100)
                                                               []))]
                                    []
                                    []
                                    []
                                    [])
           actions (Ownership.spanned-actions &plan
                                              (ProvenancedCoreModule.provenance &identified))]
    (match-ref (SpannedOwnershipAction.span (Array.unsafe-nth &actions 0))
      (Maybe.Just action-span)
        (String.= (SourceSpan.source-id action-span) "cell:derived-ownership")
      (Maybe.Nothing) false)))

(defn structured-place-overlap-is-projection-sensitive? []
  (let [root (CoreRef.init 70 (String.copy "buffer") false)
        other-root (CoreRef.init 71 (String.copy "other") false)
        whole (OwnershipPlace.init
                (OwnershipResource.Binding (CoreRef.copy &root)) [])
        x (OwnershipPlace.init
            (OwnershipResource.Binding (CoreRef.copy &root))
            [(OwnershipProjection.Field (String.copy "x"))])
        x-again (OwnershipPlace.init
                  (OwnershipResource.Binding (CoreRef.copy &root))
                  [(OwnershipProjection.Field (String.copy "x"))])
        y (OwnershipPlace.init
            (OwnershipResource.Binding (CoreRef.copy &root))
            [(OwnershipProjection.Field (String.copy "y"))])
        i0 (OwnershipPlace.init
             (OwnershipResource.Binding (CoreRef.copy &root))
             [(OwnershipProjection.Index (Maybe.Just 0))])
        i1 (OwnershipPlace.init
             (OwnershipResource.Binding (CoreRef.copy &root))
             [(OwnershipProjection.Index (Maybe.Just 1))])
        unknown (OwnershipPlace.init
                  (OwnershipResource.Binding (CoreRef.copy &root))
                  [(OwnershipProjection.Index (Maybe.Nothing))])
        low-slice (OwnershipPlace.init
                    (OwnershipResource.Binding (CoreRef.copy &root))
                    [(OwnershipProjection.Slice (Maybe.Just 0)
                                                (Maybe.Just 4))])
        high-slice (OwnershipPlace.init
                     (OwnershipResource.Binding (CoreRef.copy &root))
                     [(OwnershipProjection.Slice (Maybe.Just 4)
                                                 (Maybe.Just 8))])
        other (OwnershipPlace.init
                (OwnershipResource.Binding other-root)
                [(OwnershipProjection.Field (String.copy "x"))])]
    (and (Ownership.places-overlap? &x &x-again)
         (and (not (Ownership.places-overlap? &x &y))
              (and (not (Ownership.places-overlap? &i0 &i1))
                   (and (Ownership.places-overlap? &i0 &unknown)
                        (and (not
                               (Ownership.places-overlap?
                                 &low-slice
                                 &high-slice))
                             (and (Ownership.places-overlap? &whole &x)
                                  (not
                                    (Ownership.places-overlap?
                                      &x
                                      &other))))))))))

(defn creates-specialization-aware-contexts? []
  (match (prepare-source "(defn identity [x] x)
(identity 1)
(identity \"borrowed\")") (Result.Success plan)
      (let-do [contexts (OwnershipPlan.contexts &plan)
               definitions 0
               int-instance false
               string-ref-instance false
               root-nodes 0
               n (Array.length contexts)]
        (for [i 0 n]
          (match-ref (Array.unsafe-nth contexts i)
            (OwnershipContext.Definition reference signature _ nodes)
              (when-do (= (CoreRef.name reference) "identity")
                (set! definitions (Int.inc definitions))
                (when (Int.= @nodes 1)
                  (match-ref (Box.peek signature)
                    (MonoType.Function arguments _)
                      (match-ref (Box.peek (Array.unsafe-nth arguments 0))
                        (MonoType.Integer) (set! int-instance true)
                        (MonoType.Reference inner _)
                          (match-ref (Box.peek inner)
                            (MonoType.String) (set! string-ref-instance true)
                            _ ())
                        _ ())
                    _ ())))
            (OwnershipContext.Roots nodes) (set! root-nodes @nodes)))
        (and (Int.= definitions 2)
             (and int-instance
                  (and string-ref-instance
                       (and (Int.= root-nodes 6)
                            (and
                              (Int.= 0
                                     (Array.length (OwnershipPlan.actions &plan)))
                              (Int.= 0
                                     (Array.length (OwnershipPlan.requirements &plan))))))))) (Result.Error _)
      false))

(defn rejects-duplicate-expression-ids? []
  (let [first-root (SpecializedExpr.IntLit 0 (Box.init (Type.integer)) 1)
        second-root (SpecializedExpr.IntLit 0 (Box.init (Type.integer)) 2)
        specialized (SpecializationModule.init []
                                               []
                                               []
                                               [(Box.init first-root)
                                                (Box.init second-root)]
                                               []
                                               [])]
    (Result.error?
      &(Ownership.prepare &specialized &(OwnershipTypeFacts.init [] [] [] [])))))

(defn ownership-facts []
  (let [string-key (CAbi.type-key &(MonoType.String))
        widget-key (CAbi.type-key &(MonoType.Named @"Widget" []))
        handle-key (CAbi.type-key &(MonoType.Named @"Handle" []))]
    (OwnershipTypeFacts.init [string-key widget-key @&handle-key] [handle-key] [] [])))

(defn classified [type facts]
  (match (OwnershipClassify.classify type facts)
    (OwnershipClass.Unmanaged) 0
    (OwnershipClass.Owned) 1
    (OwnershipClass.Borrowed) 2))

(defn classify-cases-pass? []
  (let [facts (ownership-facts)
        string-t (MonoType.String)
        widget-t (MonoType.Named @"Widget" [])
        gadget-t (MonoType.Named @"Gadget" [])
        handle-t (MonoType.Named @"Handle" [])
        byte-t (MonoType.Named @"Byte" [])
        int-t (MonoType.Integer)
        fn-t (MonoType.Function [(Box.init (MonoType.Integer))]
                                (Box.init (MonoType.Boolean)))
        ref-t (MonoType.Reference (Box.init (MonoType.String))
                                  (MonoLifetime.Static))]
    (and (Int.= 1 (classified &string-t &facts))
         (and (Int.= 1 (classified &widget-t &facts))
              (and (Int.= 1 (classified &fn-t &facts))
                   (and (Int.= 2 (classified &ref-t &facts))
                        (and (Int.= 0 (classified &int-t &facts))
                             (and (Int.= 0 (classified &byte-t &facts))
                                  (and (Int.= 0 (classified &gadget-t &facts))
                                       (Int.= 0 (classified &handle-t &facts)))))))))))

(defn facts-derivation? [] (match (Surface.parse "(register-type Widget)
(defmodule Widget (register delete (Fn [Widget] ()) \"Widget_delete\"))
(implements delete Widget.delete)") (Result.Success surface)
      (match (Resolve.module &surface)
        (Result.Success core)
          (let [facts (OwnershipClassify.facts-from-module &core)
                widget-t (MonoType.Named @"Widget" [])
                gadget-t (MonoType.Named @"Gadget" [])]
            (and (Int.= 1 (classified &widget-t &facts))
                 (Int.= 0 (classified &gadget-t &facts))))
        (Result.Error _) false) (Result.Error _) false))

(defn delete-implementation-discharges-its-parameter? []
  (match (prepare-source "(register-type Widget \"void*\")
(defmodule Widget
  (sig delete (Fn [Widget] ()))
  (defn delete [widget] ())
  (implements delete Widget.delete))")
    (Result.Success plan) (Int.= 0 (count-deletes &plan))
    (Result.Error _) false))

(defn nested-facts-derivation? []
  (match (prepare-source "(defmodule Types
  (register-type Widget \"void*\")
  (register destroy-widget (Fn [Widget] ()) \"Widget_delete\" [take])
  (implements delete Types.destroy-widget))
(defmodule Bindings
  (register make-widget (Fn [] Types.Widget) \"make_widget\" []))
(defn owns-widget [] (let [widget (Bindings.make-widget)] ()))
(owns-widget)")
    (Result.Success plan)
      (Int.= 1 (count-deletes &plan))
    (Result.Error _) false))

(defn accepts-calling-captured-function? []
  (match (prepare-source "(defn wrap [f] (fn [x] (f x)))
(let [f (wrap (fn [x] x))] (f 1))") (Result.Success _) true (Result.Error _)
      false))

(defn count-deletes [plan]
  (let-do [actions (OwnershipPlan.actions plan)
           count 0
           n (Array.length actions)]
    (for [i 0 n]
      (match-ref (Array.unsafe-nth actions i)
        (OwnershipAction.Delete _ _ _) (set! count (Int.inc count))
        _ ()))
    count))

(defn count-binding-deletes [plan]
  (let-do [actions (OwnershipPlan.actions plan)
           count 0
           n (Array.length actions)]
    (for [i 0 n]
      (match-ref (Array.unsafe-nth actions i)
        (OwnershipAction.Delete _ resource _)
          (match-ref resource
            (OwnershipResource.Binding _) (set! count (Int.inc count))
            _ ())
        _ ()))
    count))

(def owned-widget-prelude "(register-type Widget)
(register make-widget (Fn [] Widget) \"make_widget\")
(defmodule Widget (register delete (Fn [Widget] ()) \"widget_delete\"))
(implements delete Widget.delete)
")

(defn plans-delete-requirement? []
  (match (prepare-source
      &(String.append owned-widget-prelude
                      "(defn drop-it [] (let [w (make-widget)] 0))
(drop-it)"))
    (Result.Success plan)
      (and (Int.= 1 (count-deletes &plan))
           (Int.= 1 (Array.length (OwnershipPlan.requirements &plan))))
    (Result.Error _) false))

(defn plans-delete-for-unused-owned? []
  (match (prepare-source
      &(String.append owned-widget-prelude
                      "(defn drop-it [] (let [w (make-widget)] 0))
(drop-it)"))
    (Result.Success plan) (Int.= 1 (count-deletes &plan))
    (Result.Error _) false))

(defn plans-delete-after-owned-self-rebind? []
  (match (prepare-source
      &(String.append owned-widget-prelude
                      "(register update-widget (Fn [Widget] Widget) \"update_widget\")
(defn update-it []
  (let [w (make-widget)]
    (do (set! w (update-widget w)) 0)))
(update-it)"))
    (Result.Success plan) (Int.= 1 (count-binding-deletes &plan))
    (Result.Error _) false))

(defn no-delete-when-moved-out? []
  (match (prepare-source
      &(String.append owned-widget-prelude
                      "(defn keep-it [] (let [w (make-widget)] w))
(keep-it)"))
    (Result.Success plan)
      (and (Int.= 0 (count-binding-deletes &plan))
           (Int.= 1 (count-deletes &plan)))
    (Result.Error _) false))

(defn plans-delete-for-conditionally-moved-match-binding? []
  (match (prepare-source
      &(String.append owned-widget-prelude "(deftype Holder (Held [Widget]))
(deftype Choice (Keep [Widget]) (Drop))
(defn choose [holder keep]
  (match holder
    (Holder.Held widget)
      (if keep (Choice.Keep widget) (Choice.Drop))))
(choose (Holder.Held (make-widget)) true)"))
    (Result.Success plan) (Int.= 1 (count-binding-deletes &plan))
    (Result.Error _) false))

(defn plans-delete-for-conditionally-moved-local? []
  (match (prepare-source
      &(String.append owned-widget-prelude
                      "(deftype Choice (Keep [Widget]) (Drop))
(defn choose [keep]
  (let [widget (make-widget)]
    (if keep (Choice.Keep widget) (Choice.Drop))))
(choose true)"))
    (Result.Success plan) (Int.= 1 (count-binding-deletes &plan))
    (Result.Error _) false))

(defn plans-delete-for-conditionally-moved-parameter? []
  (match (prepare-source
      &(String.append owned-widget-prelude
                      "(deftype Choice (Keep [Widget]) (Drop))
(defn choose [widget keep]
  (if keep (Choice.Keep widget) (Choice.Drop)))
(choose (make-widget) true)"))
    (Result.Success plan) (Int.= 1 (count-binding-deletes &plan))
    (Result.Error _) false))

(defn count-moves [plan]
  (let-do [actions (OwnershipPlan.actions plan)
           count 0
           n (Array.length actions)]
    (for [i 0 n]
      (match-ref (Array.unsafe-nth actions i)
        (OwnershipAction.Move _ _ _ _) (set! count (Int.inc count))
        _ ()))
    count))

(defn plans-move-for-aliased-owned? []
  (match (prepare-source
      &(String.append owned-widget-prelude "(defn alias [w] (let [a w] a))
(alias (make-widget))"))
    (Result.Success plan)
      (and (Int.= 1 (count-moves &plan)) (Int.= 0 (count-binding-deletes &plan)))
    (Result.Error _) false))

(defn normalizes-actions-to-place-accesses? []
  (match (prepare-source
      &(String.append owned-widget-prelude "(defn alias [w] (let [a w] a))
(alias (make-widget))"))
    (Result.Success plan)
      (let-do [found-move false
               found-drop false
               accesses (OwnershipPlan.accesses &plan)]
        (for [i 0 (Array.length accesses)]
          (let [access (Array.unsafe-nth accesses i)
                place (OwnershipAccess.place access)]
            (when (Int.= 0 (Array.length (OwnershipPlace.projections place)))
              (match-ref (OwnershipAccess.kind access)
                (OwnershipAccessKind.Move)
                  (match-ref (OwnershipPlace.root place)
                    (OwnershipResource.Binding _) (set! found-move true)
                    _ ())
                (OwnershipAccessKind.Drop) (set! found-drop true)
                _ ()))))
        (and found-move
             (and found-drop
                  (Int.= (Array.length (OwnershipPlan.actions &plan))
                         (Array.length accesses)))))
    (Result.Error _) false))

(defn accepts-parameter-borrow? []
  (Result.success?
    &(prepare-source &(String.append owned-widget-prelude "(defn borrow [w] &w)
(borrow (make-widget))"))))

(defn summarizes-parameter-and-result-contract? []
  (match (prepare-source &(String.append owned-widget-prelude
                                        "(defn borrow [w] &w)
(borrow (make-widget))"))
    (Result.Success plan)
      (let-do [ok false
               summaries (OwnershipPlan.summaries &plan)]
        (for [i 0 (Array.length summaries)]
          (let [summary (Array.unsafe-nth summaries i)]
            (when (String.= (CoreRef.name (OwnershipFunctionSummary.reference summary))
                            "borrow")
              (let [parameters (OwnershipFunctionSummary.parameters summary)
                    effect (OwnershipFunctionSummary.result summary)]
                (set! ok
                      (and (Int.= 1 (Array.length parameters))
                           (and
                             (match-ref
                               (OwnershipParameterEffect.mode
                                 (Array.unsafe-nth parameters 0))
                               (OwnershipParameterMode.Take) true
                               _ false)
                             (and
                               (match-ref (OwnershipResultEffect.ownership effect)
                                 (OwnershipResultMode.Borrowed) true
                                 _ false)
                               (and
                                 (Int.= 1
                                        (Array.length
                                          (OwnershipResultEffect.borrows-from effect)))
                                 (Int.= 0
                                        @(Array.unsafe-nth
                                           (OwnershipResultEffect.borrows-from effect)
                                           0)))))))))))
        ok)
    (Result.Error _) false))

(defn strict-loans-reject-taken-result-borrow? []
  (match (prepare-source &(String.append owned-widget-prelude
                                        "(defn borrow [w] &w)
(borrow (make-widget))"))
    (Result.Success plan) (Result.error? &(Ownership.validate-strict-loans &plan))
    (Result.Error _) false))

