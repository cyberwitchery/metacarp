      &(String.append owned-widget-prelude
                      "(register peek (Fn [(Ref Widget a)] (Ref Widget a)) \"peek\")
(defn f [] (let [local (make-widget)] (peek &local)))
(f)"))))

(def borrow-move-prelude "(register-type Widget)
(register make-widget (Fn [] Widget) \"make_widget\")
(defmodule Widget (register delete (Fn [Widget] ()) \"widget_delete\"))
(implements delete Widget.delete)
(register consume (Fn [Widget] ()) \"consume\")
(register inspect (Fn [(Ref Widget)] ()) \"inspect\")
")

(defn infers-default-foreign-contract? []
  (match (prepare-source
           &(String.append borrow-move-prelude
                           "(defn observe [w] (inspect &w))
(observe (make-widget))"))
    (Result.Success plan)
      (let-do [ok false
               contracts (OwnershipPlan.foreign-contracts &plan)]
        (for [i 0 (Array.length contracts)]
          (let [contract (Array.unsafe-nth contracts i)]
            (when (String.= (OwnershipForeignContract.symbol contract) "inspect")
              (let [parameters (OwnershipForeignContract.parameters contract)]
                (set! ok
                      (and (not @(OwnershipForeignContract.declared contract))
                           (and (Int.= 1 (Array.length parameters))
                           (and
                             (match-ref (Array.unsafe-nth parameters 0)
                               (OwnershipParameterMode.SharedBorrow) true
                               _ false)
                             (match-ref
                               (OwnershipResultEffect.ownership
                                 (OwnershipForeignContract.result contract))
                               (OwnershipResultMode.Unmanaged) true
                               _ false)))))))))
        ok)
    (Result.Error _) false))

(defn retains-explicit-unique-foreign-contract? []
  (match (prepare-source
           &(String.append owned-widget-prelude
                           "(register mutate (Fn [(Ref Widget)] ()) \"mutate\" [unique])
(defn invoke [w] (mutate &w))
(invoke (make-widget))"))
    (Result.Success plan)
      (let-do [ok false
               contracts (OwnershipPlan.foreign-contracts &plan)]
        (for [i 0 (Array.length contracts)]
          (let [contract (Array.unsafe-nth contracts i)]
            (when (String.= (OwnershipForeignContract.symbol contract) "mutate")
              (set! ok
                    (and @(OwnershipForeignContract.declared contract)
                         (match-ref
                           (Array.unsafe-nth
                             (OwnershipForeignContract.parameters contract)
                             0)
                           (OwnershipParameterMode.UniqueBorrow) true
                           _ false))))))
        ok)
    (Result.Error _) false))

(defn rejects-copy-contract-for-owned-parameter? []
  (Result.error?
    &(prepare-source
      &(String.append owned-widget-prelude
        "(register false-copy (Fn [Widget] ()) \"false_copy\" [copy])
(false-copy (make-widget))"))))

(defn rejects-take-contract-for-unmanaged-parameter? []
  (Result.error?
    &(prepare-source
      "(register false-take (Fn [Int] ()) \"false_take\" [take])
(false-take 1)")))

(defn infers-phantom-view-result-borrow? []
  (match (prepare-source
           &(String.append owned-widget-prelude
             "(register-type View \"carp_view\")
(register view (Fn [(Ref Widget owner)] (View (Ref Widget owner))) \"view\" [shared])
(defn use-view [w] (view &w))
(use-view (make-widget))"))
    (Result.Success plan)
      (let-do [ok false
               contracts (OwnershipPlan.foreign-contracts &plan)]
        (for [i 0 (Array.length contracts)]
          (let [contract (Array.unsafe-nth contracts i)]
            (when (String.= (OwnershipForeignContract.symbol contract) "view")
              (let [effect (OwnershipForeignContract.result contract)]
                (set! ok
                  (and
                    (match-ref (OwnershipResultEffect.ownership effect)
                      (OwnershipResultMode.Unmanaged) true
                      _ false)
                    (and
                      (Int.= 1 (Array.length
                                  (OwnershipResultEffect.borrows-from effect)))
                      (Int.= 0 @(Array.unsafe-nth
                                  (OwnershipResultEffect.borrows-from effect)
                                  0)))))))))
        ok)
    (Result.Error _) false))

