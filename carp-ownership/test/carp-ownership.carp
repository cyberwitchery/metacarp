(defn accepts-unique-foreign-call-after-alias-scope? []
  (Result.success?
    &(prepare-source
      &(String.append borrow-move-prelude
                      "(register mutate (Fn [(Ref Widget)] ()) \"mutate\" [unique])
(defn good [w] (do (let [alias &w] (inspect alias)) (mutate &w)))
(good (make-widget))"))))

(defn summarizes-forwarded-reference-as-unique? []
  (match (prepare-source
           &(String.append owned-widget-prelude
                           "(register mutate (Fn [(Ref Widget)] ()) \"mutate\" [unique])
(defn forward [point] (mutate point))
(defn invoke [w] (forward &w))
(invoke (make-widget))"))
    (Result.Success plan)
      (let-do [ok false
               summaries (OwnershipPlan.summaries &plan)]
        (for [i 0 (Array.length summaries)]
          (let [summary (Array.unsafe-nth summaries i)]
            (when (String.= (CoreRef.name
                              (OwnershipFunctionSummary.reference summary))
                            "forward")
              (set! ok
                    (match-ref
                      (OwnershipParameterEffect.mode
                        (Array.unsafe-nth
                          (OwnershipFunctionSummary.parameters summary)
                          0))
                      (OwnershipParameterMode.UniqueBorrow) true
                      _ false)))))
        ok)
    (Result.Error _) false))

(defn transitive-unique-requirements-reach-wrappers? []
  (match (prepare-source
           &(String.append owned-widget-prelude
                           "(register mutate (Fn [(Ref Widget)] ()) \"mutate\" [unique])
(defn leaf [point] (mutate point))
(defn middle [point] (leaf point))
(defn invoke [w] (middle &w))
(invoke (make-widget))"))
    (Result.Success plan)
      (let-do [leaf-unique false
               middle-unique false
               summaries (OwnershipPlan.summaries &plan)]
        (for [i 0 (Array.length summaries)]
          (let [summary (Array.unsafe-nth summaries i)
                name (CoreRef.name
                       (OwnershipFunctionSummary.reference summary))
                unique (match-ref
                         (OwnershipParameterEffect.mode
                           (Array.unsafe-nth
                             (OwnershipFunctionSummary.parameters summary)
                             0))
                         (OwnershipParameterMode.UniqueBorrow) true
                         _ false)]
            (do
              (when (String.= name "leaf") (set! leaf-unique unique))
              (when (String.= name "middle") (set! middle-unique unique)))))
        (and leaf-unique middle-unique))
    (Result.Error _) false))

(defn rejects-alias-before-transitively-unique-call? []
  (Result.error?
    &(prepare-source
      &(String.append owned-widget-prelude
                      "(register mutate (Fn [(Ref Widget)] ()) \"mutate\" [unique])
(defn leaf [point] (mutate point))
(defn bad [point] (let [alias point] (leaf point)))
(defn invoke [w] (bad &w))
(invoke (make-widget))"))))

(defn mutation-intrinsics-require-unique-parameters? []
  (match (prepare-source
           "(defn mutate-first [values] (Array.aset! values 0 7))
(defn invoke [] (let [values [1 2]] (mutate-first &values)))
(invoke)")
    (Result.Success plan)
      (let-do [ok false
               summaries (OwnershipPlan.summaries &plan)]
        (for [i 0 (Array.length summaries)]
          (let [summary (Array.unsafe-nth summaries i)]
            (when (String.= (CoreRef.name
                              (OwnershipFunctionSummary.reference summary))
                            "mutate-first")
              (set! ok
                    (match-ref
                      (OwnershipParameterEffect.mode
                        (Array.unsafe-nth
                          (OwnershipFunctionSummary.parameters summary)
                          0))
                      (OwnershipParameterMode.UniqueBorrow) true
                      _ false)))))
        ok)
    (Result.Error _) false))

(defn rejects-borrow-after-move? []
  (Result.error?
    &(prepare-source
      &(String.append borrow-move-prelude
                      "(defn bad [] (let [s (make-widget) r &s] (do (consume s) (inspect r))))
(bad)"))))

(defn accepts-borrow-before-move? []
  (Result.success?
    &(prepare-source
      &(String.append borrow-move-prelude
                      "(defn ok [] (let [s (make-widget) r &s] (do (inspect r) (consume s))))
(ok)"))))

(defn accepts-unmanaged-borrow-after-pass? []
  (Result.success? &(prepare-source "(register-type Gauge)
(register make-gauge (Fn [] Gauge) \"mg\")
(register take-gauge (Fn [Gauge] ()) \"tg\")
(register read-gauge (Fn [(Ref Gauge)] ()) \"rg\")
(defn f [] (let [g (make-gauge) r &g] (do (take-gauge g) (read-gauge r))))
(f)")))

(defn rejects-owned-reuse-after-dynamic-closure-call? []
  (Result.error?
    &(prepare-source
      &(String.append owned-widget-prelude
                      "(defn bad []
  (let [w (make-widget) consume-it (fn [x] ())]
    (do (consume-it w) (inspect &w))))
(bad)"))))

(defn rejects-mutation-escape? []
  (Result.error?
    &(prepare-source
      &(String.append borrow-move-prelude
                      "(defn m [w] (let-do [local (make-widget) r &w] (set! r &local) r))
(m (make-widget))"))))

(defn rejects-branch-borrow-after-move? []
  (Result.error?
    &(prepare-source
      &(String.append borrow-move-prelude
                      "(defn b [c] (let [s (make-widget) r &s] (do (if c (consume s) ()) (inspect r))))
(b true)"))))

(defn accepts-branch-move-after-use? []
  (Result.success?
    &(prepare-source
      &(String.append borrow-move-prelude
                      "(defn ok2 [c] (let [s (make-widget) r &s] (do (inspect r) (if c (consume s) ()))))
(ok2 true)"))))

(deftest t
  (assert-true t
    (ownership-actions-retain-source-spans?)
    "ownership actions join back to caller source spans")
  (assert-true t
    (generated-ownership-actions-use-derived-provenance?)
    "ownership actions on generated nodes inherit the declaration span")
  (assert-true t
    (structured-place-overlap-is-projection-sensitive?)
    "structured places prove known fields, indices, and slices disjoint")
  (assert-true t
    (creates-specialization-aware-contexts?)
    "ownership contexts distinguish concrete instances and share the root ID space")
  (assert-true t
    (rejects-duplicate-expression-ids?)
    "ownership preparation rejects duplicate specialized expression IDs")
  (assert-true t
    (classify-cases-pass?)
    "type ownership is classified from declared delete/blit, not from spelling")
  (assert-true t
    (facts-derivation?)
    "ownership facts are derived from a module's declared delete implementations")
  (assert-true t
    (delete-implementation-discharges-its-parameter?)
    "a delete implementation discharges its parameter without recursive implicit cleanup")
  (assert-true t
    (nested-facts-derivation?)
    "nested registered types retain their qualified delete ownership facts")
  (assert-true t
    (accepts-calling-captured-function?)
    "invoking a captured function borrows rather than consumes the closure")
  (assert-true t
    (infers-default-foreign-contract?)
    "reachable external functions receive explicit default ownership contracts")
  (assert-true t
    (retains-explicit-unique-foreign-contract?)
    "declared unique foreign parameters survive specialization and ownership planning")
  (assert-true t
    (rejects-copy-contract-for-owned-parameter?)
    "an explicit copy contract cannot disguise an owned parameter move")
  (assert-true t
    (rejects-take-contract-for-unmanaged-parameter?)
    "an explicit take contract cannot claim consumption of an unmanaged parameter")
  (assert-true t
    (infers-phantom-view-result-borrow?)
    "registered by-value views retain phantom owner-reference lifetimes")
  (assert-true t
    (rejects-unique-foreign-call-with-live-alias?)
    "a unique foreign borrow rejects an overlapping live alias")
  (assert-true t
    (rejects-unique-foreign-call-through-alias?)
    "a unique foreign argument must be a direct borrow of its owner")
  (assert-true t
    (rejects-unique-foreign-call-with-overlapping-argument?)
    "a unique foreign borrow rejects another argument derived from the same owner")
  (assert-true t
    (rejects-take-before-unique-of-same-owner?)
    "a taken value cannot also be uniquely borrowed later in the same call")
  (assert-true t
    (rejects-unique-before-take-of-same-owner?)
    "a unique borrow cannot also be taken later in the same call")
  (assert-true t
    (accepts-unique-foreign-call-after-alias-scope?)
    "a unique foreign borrow is accepted once an earlier alias leaves scope")
  (assert-true t
    (summarizes-forwarded-reference-as-unique?)
    "forwarding a reference into a unique foreign call upgrades the wrapper contract")
  (assert-true t
    (transitive-unique-requirements-reach-wrappers?)
    "unique requirements propagate through ordinary Carp wrappers")
  (assert-true t
    (rejects-alias-before-transitively-unique-call?)
    "transitively unique Carp calls reject an overlapping alias")
  (assert-true t
    (mutation-intrinsics-require-unique-parameters?)
    "in-place array mutation upgrades its reference parameter to unique")
  (assert-true t
    (plans-delete-for-unused-owned?)
    "an unused owned local is scheduled for deletion at scope exit")
  (assert-true t
    (plans-delete-after-owned-self-rebind?)
    "an owned local is deleted after ownership is rebound through itself")
  (assert-true t
    (plans-delete-requirement?)
    "a planned delete reports a DeleteFunction requirement for its type")
  (assert-true t
    (plans-move-for-aliased-owned?)
    "an owned value aliased into a let binding is planned as a move")
  (assert-true t
    (normalizes-actions-to-place-accesses?)
    "ownership actions are normalized into structured place accesses")
  (assert-true t
    (accepts-parameter-borrow?)
    "a reference to a parameter may be returned")
  (assert-true t
    (summarizes-parameter-and-result-contract?)
    "function summaries retain parameter ownership and result borrow relations")
  (assert-true t
    (strict-loans-reject-taken-result-borrow?)
    "strict loan contracts reject returning a borrow into a taken parameter")
  (assert-true t
    (rejects-escaped-borrow?)
    "a reference to a local value that escapes its scope is rejected")
  (assert-true t
    (rejects-indirect-escaped-borrow?)
    "a local borrow escaping through a binding is rejected")
  (assert-true t
    (accepts-indirect-parameter-borrow?)
    "a parameter borrow passed through a binding may be returned")
  (assert-true t
    (accepts-call-returned-borrow?)
    "a borrow obtained from a call is not falsely rejected as an escape")
  (assert-true t
    (rejects-accessor-into-local?)
    "a reference returned from a call that borrows a local (shared lifetime) is rejected")
  (assert-true t
    (rejects-borrow-after-move?)
    "a borrow used after its owner is moved is rejected")
  (assert-true t
    (accepts-borrow-before-move?)
    "a borrow used before its owner is moved is accepted")
  (assert-true t
    (accepts-unmanaged-borrow-after-pass?)
    "borrowing an unmanaged value and using it after passing it (a copy) is accepted")
  (assert-true t
    (rejects-owned-reuse-after-dynamic-closure-call?)
    "passing an owned value to a dynamic closure moves it")
  (assert-true t
    (rejects-mutation-escape?)
    "a set! that repoints a returned reference at a local is rejected")
  (assert-true t
    (rejects-branch-borrow-after-move?)
    "a borrow used after its owner is moved in one branch is rejected")
  (assert-true t
    (accepts-branch-move-after-use?)
    "using a borrow before a branch that moves its owner is accepted")
  (assert-true t
    (no-delete-when-moved-out?)
    "an owned local moved to the result is not deleted in its body; the discarding root deletes it")
  (assert-true t
    (plans-delete-for-conditionally-moved-match-binding?)
    "an owned match binding moved on only one branch is deleted on the other branch")
  (assert-true t
    (plans-delete-for-conditionally-moved-local?)
    "an owned local moved on only one branch is deleted on the other branch")
  (assert-true t
    (plans-delete-for-conditionally-moved-parameter?)
    "an owned parameter moved on only one branch is deleted on the other branch"))
