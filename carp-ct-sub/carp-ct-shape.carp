(load "carp-ct-sub.carp")

(doc CtShape "the tag lattice, implemented over the set-theoretic algebra in
`CtSub`.

This is a drop-in stand-in for the `CtShape` of `carp-ct-types`: same names,
same meanings, and a type is still an `Int`, so a pass written against the tag
lattice runs on the full algebra by loading this file instead. The point is to
separate two questions that would otherwise land at once — whether the algebra
can carry the existing pass unchanged, and whether structure buys the pass
anything — and to answer the first one with a measurement rather than a guess.

What changes underneath: a shape is an arena id rather than a bitmask, so the
nineteen tags are no longer nineteen bits. A container tag becomes the whole
container (the empty one and every product of that kind), and a callable tag
becomes every function of that sort. Tag-level answers come out identical; what
the algebra adds is that a caller can now say more than a tag, and this module
simply does not.

Identity is the one thing a caller must not assume: two structurally equal types
may be different arena ids, so `equal?` decides sameness and `Int.=` does not.
`carp-ct-types` grew the same function, spelled `Int.=`, so a pass using it runs
on either.

Every constant is interned once by `init!` and handed out from a cache, both so
that the arena does not grow on repeated calls and so that identity comparisons
against a constant keep working for a caller that has not been migrated yet.")

(def *ct-shape-leaves* (the (Array Int) []))
(def *ct-shape-groups* (the (Array Int) []))

(defmodule CtShape
  (private ensure!)
  (hidden ensure!)
  (sig ensure! (Fn [] ()))
  (sig init! (Fn [] ()))
  (sig leaf (Fn [Int] Int))
  (sig group (Fn [Int] Int))

  (doc leaf-count "the number of leaves in the tag lattice.")
  (defn leaf-count [] 19)

  (defn i-int-lit [] 0)
  (defn i-byte-lit [] 1)
  (defn i-long-lit [] 2)
  (defn i-float-lit [] 3)
  (defn i-double-lit [] 4)
  (defn i-bool-lit [] 5)
  (defn i-char-lit [] 6)
  (defn i-string-lit [] 7)
  (defn i-pattern-lit [] 8)
  (defn i-symbol [] 9)
  (defn i-list [] 10)
  (defn i-array [] 11)
  (defn i-static-array [] 12)
  (defn i-dictionary [] 13)
  (defn i-comment [] 14)
  (defn i-closure [] 15)
  (defn i-macro [] 16)
  (defn i-builtin [] 17)
  (defn i-collection [] 18)

  (private build-leaf)
  (hidden build-leaf)
  ;; the mapping from a tag of the old lattice onto the algebra. The atomic tags
  ;; line up one for one; a container tag is the whole container, because "a
  ;; list" is the empty list and every pair alike; a callable tag is every
  ;; function of that sort.
  (defn build-leaf [index]
    (cond
      (Int.< index 10) (CtSub.tags (CtSub.leaf index))
      (Int.= index (i-list)) (CtSub.container (CtSub.k-list))
      (Int.= index (i-array)) (CtSub.container (CtSub.k-array))
      (Int.= index (i-static-array)) (CtSub.container (CtSub.k-static-array))
      (Int.= index (i-dictionary)) (CtSub.container (CtSub.k-dictionary))
      (Int.= index (i-comment)) (CtSub.tags (CtSub.leaf (CtSub.i-comment)))
      (Int.= index (i-closure)) (CtSub.callable (CtSub.s-closure))
      (Int.= index (i-macro)) (CtSub.callable (CtSub.s-macro))
      (Int.= index (i-builtin)) (CtSub.callable (CtSub.s-builtin))
      (CtSub.container (CtSub.k-collection))))

  ;; a caller that asks for a constant before `init!` gets one anyway: the
  ;; lattice of `carp-ct-types` needs no setup, so code written against it has no
  ;; reason to call one, and reading an unfilled cache would be an out-of-bounds
  ;; index rather than an error
  (defn ensure! [] (when (Int.= 0 (Array.length &*ct-shape-leaves*)) (init!)))

  (doc leaf "the shape containing exactly the leaf tag at `index`.")
  (defn leaf [index] (do (ensure!) @(Array.unsafe-nth &*ct-shape-leaves* index)))

  (doc bottom "⊥, the empty shape.")
  (defn bottom [] (CtSub.bottom))

  (doc top "⊤, every tag in the lattice, which is every value the algebra has:
every leaf of the old lattice taken together leaves nothing out, because a
container tag covers every container of that kind whatever it holds. Using the
algebra's own ⊤ rather than the union of nineteen leaves keeps the two spellings
one id, which is what lets the cheap laws about ⊤ fire.")
  (defn top [] (CtSub.top))

  (doc union "τ ⊔ π.")
  (defn union [a b] (CtSub.union a b))

  (doc intersection "τ ⊓ π.")
  (defn intersection [a b] (CtSub.intersection a b))

  (doc negation "¬τ, complemented within the lattice.")
  (defn negation [a] (CtSub.difference (top) a))

  (doc difference "τ ⊓ ¬π.")
  (defn difference [a b] (CtSub.difference a b))

  (doc bottom? "whether a shape is ⊥. This is the whole soundness test the
checker performs.")
  (defn bottom? [a] (CtSub.uninhabited? a))

  (doc subshape? "τ ≤ π, inclusion in the target Boolean algebra.")
  (defn subshape? [a b] (CtSub.subtype? a b))

  (doc equal? "whether two shapes hold the same values. Two arena ids can
describe the same shape, so this is not `Int.=`.")
  (defn equal? [a b] (CtSub.equivalent? a b))

  (private group)
  (hidden group)
  (defn group [index]
    (do (ensure!) @(Array.unsafe-nth &*ct-shape-groups* index)))

  (doc num "the numeric literals.")
  (defn num [] (group 1))

  (doc lit "every literal, numeric or not.")
  (defn lit [] (group 2))

  (doc seq "the syntax containers: a list, array, static array or dictionary
read from source.")
  (defn seq [] (group 3))

  (doc syntax "every syntax node.")
  (defn syntax [] (group 4))

  (doc callable "the values that can appear in head position: a compile-time
closure, a macro, or a builtin.")
  (defn callable [] (group 5))

  (doc listy "everything the list operations accept: syntax containers and
computed collections alike.")
  (defn listy [] (group 6))

  (doc array-like "everything `array?` answers true for.")
  (defn array-like [] (group 7))

  (private span)
  (hidden span)
  (defn span [from to]
    (let-do [result (CtSub.bottom)]
      (for [i from (Int.inc to)] (set! result (CtSub.union result (leaf i))))
      result))

  (doc init! "interns the constants. Must run before anything else, and after
`CtSub.reset!`, which it calls itself.")
  (defn init! []
    (do
      (CtSub.reset!)
      (set! *ct-shape-leaves* [])
      (for [i 0 (leaf-count)]
        (Array.push-back! &*ct-shape-leaves* (build-leaf i)))
      (set! *ct-shape-groups* [])
      ;; index 0 is ⊤: every tag of the old lattice, which is every value the
      ;; algebra has except the structures no tag names
      (Array.push-back! &*ct-shape-groups* (span 0 (Int.dec (leaf-count))))
      (Array.push-back! &*ct-shape-groups* (span (i-int-lit) (i-double-lit)))
      (Array.push-back! &*ct-shape-groups* (span (i-int-lit) (i-pattern-lit)))
      (Array.push-back! &*ct-shape-groups* (span (i-list) (i-dictionary)))
      (Array.push-back! &*ct-shape-groups* (span (i-int-lit) (i-comment)))
      (Array.push-back! &*ct-shape-groups* (span (i-closure) (i-builtin)))
      (Array.push-back! &*ct-shape-groups*
                        (CtSub.union (span (i-list) (i-dictionary))
                                     (leaf (i-collection))))
      (Array.push-back! &*ct-shape-groups*
                        (CtSub.union
                          (CtSub.union (leaf (i-array)) (leaf (i-static-array)))
                          (leaf (i-collection))))))

  (private node-name)
  (hidden node-name)
  ;; the same names the tag lattice prints, recognised by equivalence rather
  ;; than by identity: a shape built by the pass is a fresh arena id, so the
  ;; named groups have to be matched for what they hold
  (defn node-name [shape]
    (cond
      (bottom? shape) (Maybe.Just @"⊥")
      (equal? shape (top)) (Maybe.Just @"Obj")
      (equal? shape (syntax)) (Maybe.Just @"Syntax")
      (equal? shape (listy)) (Maybe.Just @"Seq ⊔ Collection")
      (equal? shape (seq)) (Maybe.Just @"Seq")
      (equal? shape (lit)) (Maybe.Just @"Lit")
      (equal? shape (num)) (Maybe.Just @"Num")
      (equal? shape (callable)) (Maybe.Just @"Callable")
      (equal? shape (array-like))
        (Maybe.Just @"Array ⊔ StaticArray ⊔ Collection")
      (let-do [single (Maybe.Nothing)]
        (for [i 0 (leaf-count)]
          (when (equal? shape (leaf i))
            (set! single (Maybe.Just (CtSub.leaf-name-of i)))))
        single)))

  ;; ------------------------------------------------- what a function takes
  ;;
  ;; The tag lattice has `Closure` and nothing more, so a pass written against it
  ;; cannot ask what a function takes or answers. These four say it can, and the
  ;; lattice answers "nothing known" while the algebra answers properly. That is
  ;; what keeps one pass running on either.

  (doc closure-of "a closure taking these argument shapes and answering with
that one.")
  (defn closure-of [domains result]
    (CtSub.function-of (CtSub.s-closure) domains result))

  (doc closure? "whether the domain and result of a callable can be read back.")
  (defn closure? [t] (CtSub.function? t))

  (doc closure-domain "the shape required of argument `index`.")
  (defn closure-domain [t index] (CtSub.function-domain t index))

  (doc closure-result "the shape a call to it answers with.")
  (defn closure-result [t] (CtSub.function-result t))

  ;; ------------------------------------------------ what a container holds

  (private kind-of)
  (hidden kind-of)
  ;; the container kind behind one of the old container tags
  (defn kind-of [index]
    (cond
      (Int.= index (i-list)) (CtSub.k-list)
      (Int.= index (i-array)) (CtSub.k-array)
      (Int.= index (i-static-array)) (CtSub.k-static-array)
      (Int.= index (i-dictionary)) (CtSub.k-dictionary)
      (CtSub.k-collection)))

  (doc container-of "a container of the kind at `index` holding exactly these
element shapes, in order.")
  (defn container-of [index elements]
    (CtSub.list-of-kind (kind-of index) elements))

  (doc every-of "a container of the kind at `index` whose every element is in
`element`, at any length.")
  (defn every-of [index element] (CtSub.every-of (kind-of index) element))

  (doc every-listy "everything the list operations accept, restricted to
containers whose every element is in `element`.")
  (defn every-listy [element]
    (let-do [result (CtSub.bottom)]
      (for [i (i-list) (Int.inc (i-dictionary))]
        (set! result (CtSub.union result (every-of i element))))
      (set! result (CtSub.union result (every-of (i-collection) element)))
      (CtSub.describe-as result
                         (String.concat
                           &[@"Seq ⊔ Collection of " (CtSub.describe element)]))
      result))

  ;; --------------------------------------------- what a form is made of

  (doc symbol-literal "exactly the symbol with this spelling.")
  (defn symbol-literal [text] (CtSub.literal (CtSub.i-symbol) text))

  (doc chain-of "a container of the kind at `index` holding these elements and
then whatever `tail` is.")
  (defn chain-of [index elements tail]
    (CtSub.chain-of (kind-of index) elements tail))

  (doc head-spelling "the symbol a form starts with, when it starts with one
particular symbol.")
  (defn head-spelling [t] (CtSub.head-spelling t))

  (doc form-length "how many forms a container holds, when that is fixed, and -1
when it is not.")
  (defn form-length [t] (CtSub.chain-exact t))

  (doc widen "the same shape with its structure cut off below `depth`, which is
what keeps a fixed point over summaries from climbing for ever.")
  (defn widen [t depth] (CtSub.widen t depth))

  (doc render "renders a shape the way the checker reports it.

A shape that is exactly one node of the lattice prints as that node, one that is
exactly the complement of a node prints as its negation, and anything else prints
as the union of the leaves it contains. A shape the old lattice could not hold at
all — one that says something about the contents of a container — falls through to
the algebra's own rendering.")
  (defn render [shape]
    (match (node-name shape)
      (Maybe.Just name) name
      (Maybe.Nothing)
        (match (node-name (negation shape))
          (Maybe.Just name) (String.concat &[@"¬(" @&name @")"])
          (Maybe.Nothing)
            (let-do [parts (the (Array String) [])]
              (for [i 0 (leaf-count)]
                (when (subshape? (leaf i) shape)
                  (set! parts (Array.push-back parts (CtSub.leaf-name-of i)))))
              (if (Int.= 0 (Array.length &parts))
                (CtSub.describe shape)
                (String.join " ⊔ " &parts)))))))
