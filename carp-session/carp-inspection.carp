(load "carp-session.carp")

(defmodule Specialize
  (doc query-implementation
    "queries ordinary interface selection outside a specialization pass.")
  (defn query-implementation [core inferred call]
    (let [context (prepare core inferred)]
      (implementation-search &context core inferred call))))

(defmodule Session
  (doc view-provider "selects a declarative view provider through ordinary
interface dispatch for the concrete borrowed source type.")
  (defn view-provider [session type]
    (let-do [overlay (Array.unsafe-nth (CompilerSession.overlay session) 0)
             _context (prepare-lowering-context! session overlay)
             core (Array.unsafe-nth (CompilerSession.lowering-core session) 0)
             inferred (Array.unsafe-nth
               (CompilerSession.lowering-inferred session)
               0)
             interfaces (Rc.value-ref (CompilerSession.base-interfaces session))
             answer (the (Maybe CoreRef) (Maybe.Nothing))]
      (for [i 0 (Array.length interfaces)]
        (let [interface (Array.unsafe-nth interfaces i)
              reference (CoreInterface.reference interface)]
          (when (String.= (CoreRef.name reference) "views")
            (let [signature (Type.function
                    [(Box.init
                       (MonoType.Reference (Box.init @type)
                                           (MonoLifetime.Static)))]
                    (MonoType.Named @"Array"
                                    [(Box.init
                                       (MonoType.Named @"ViewSpec"
                                                       [(Box.init @type)]))]))
                  call (CallSite.init -1
                                      @reference
                                      (Box.init signature)
                                      (Maybe.Nothing))]
              (match (Specialize.query-implementation core inferred &call)
                (Result.Success selected)
                  (set! answer (Maybe.Just @(CallSite.reference &selected)))
                (Result.Error error) ())))))
      answer)))
