(load "../carp-module/carp-module.carp")
(load "../carp-source/carp-source.carp")

(deftemplate session-host-arch (Fn [] String) "String $NAME(void)" "$DECL {
  String value =
#if defined(__aarch64__) || defined(_M_ARM64)
    \"aarch64\";
#elif defined(__x86_64__) || defined(_M_X64)
    \"x86_64\";
#elif defined(__i386__) || defined(_M_IX86)
    \"i386\";
#elif defined(__arm__) || defined(_M_ARM)
    \"arm\";
#elif defined(__wasm32__)
    \"wasm32\";
#else
    \"unknown\";
#endif
  return String_copy(&value);
}")

(deftemplate session-host-os (Fn [] String) "String $NAME(void)" "$DECL {
  String value =
#if defined(__APPLE__) && defined(__MACH__)
    \"darwin\";
#elif defined(_WIN32)
    \"mingw32\";
#elif defined(__linux__)
    \"linux\";
#elif defined(__FreeBSD__)
    \"freebsd\";
#elif defined(__NetBSD__)
    \"netbsd\";
#elif defined(__OpenBSD__)
    \"openbsd\";
#else
    \"unknown\";
#endif
  return String_copy(&value);
}")

(def session-core-files
  [@"Core.carp"
   @"Interfaces.carp"
   @"Blitable.carp"
   @"Bool.carp"
   @"Box.carp"
   @"Macros.carp"
   @"BoolExtras.carp"
   @"List.carp"
   @"Derive.carp"
   @"Gensym.carp"
   @"ControlMacros.carp"
   @"Project.carp"
   @"Platform.carp"
   @"Introspect.carp"
   @"Quasiquote.carp"
   @"Pointer.carp"
   @"Unsafe.carp"
   @"Function.carp"
   @"Generics.carp"
   @"Maybe.carp"
   @"Result.carp"
   @"Dynamic.carp"
   @"Format.carp"
   @"Byte.carp"
   @"Int.carp"
   @"Long.carp"
   @"Double.carp"
   @"Float.carp"
   @"Tuples.carp"
   @"Array.carp"
   @"StaticArray.carp"
   @"StdInt.carp"
   @"Char.carp"
   @"String.carp"
   @"ArrayExt.carp"
   @"System.carp"
   @"IO.carp"
   @"Pattern.carp"
   @"Debug.carp"
   @"Random.carp"
   @"Map.carp"
   @"Heap.carp"
   @"Sort.carp"
   @"Binary.carp"
   @"Control.carp"
   @"Opaque.carp"
   @"Unit.carp"])

(defmodule SessionCoreLoader
  (private diagnostic)
  (hidden diagnostic)
  (defn diagnostic [message]
    (Diagnostic.init (String.copy "load") message (Maybe.Nothing)))

  (private boot-source)
  (hidden boot-source)
  (defn boot-source []
    (let [arch (session-host-arch)
          os (session-host-os)]
      (String.concat &[@"(defndynamic host-arch [] \"" (String.copy &arch) @"\")
(defndynamic host-os [] \"" (String.copy &os) @"\")
(def target-arch \"" arch @"\")
(def target-os \"" os @"\")
(def target-abi \"unknown\")
(defmodule Project
  (defndynamic config [key value] ())
  (defndynamic no-echo [] ())
  (defndynamic get-config [key]
    (cond
      (= key \"echo-c\") false
      (= key \"title\") \"Untitled\"
      (= key \"output-directory\") \"out\"
      (= key \"load-stack\") (Unsafe.load-stack)
      (= key \"cflag\") '()
      (= key \"libflag\") '()
      (= key \"pkgconfigflag\") '()
      \"native\")))
(load \"Core.carp\")
(defmacro add-c [relpath]
  (list (quote Unsafe.preproc)
        (list (quote Unsafe.emit-c)
              (String.concat [\"#include \\\"\" (relative-to (current-file) relpath) \"\\\"\"]))))
(defmacro relative-include [path]
  (list (quote Unsafe.preproc)
        (list (quote Unsafe.emit-c)
              (String.concat [\"#include \\\"\" (relative-to (current-file) path) \"\\\"\"]))))
"])))

  (doc load-core "loads the standard library under `core-dir` into the same
deterministic surface stream used by the compiler CLI.")
  (defn load-core [core-dir]
    (let-do [sources (the (Array ModuleSource) [])
             failure (the (Maybe Diagnostic) (Maybe.Nothing))]
      (for [i 0 (Array.length &session-core-files)]
        (match-ref &failure
          (Maybe.Nothing)
            (let [name (Array.unsafe-nth &session-core-files i)
                  path (String.concat
                    &[(String.copy core-dir) @"/" (String.copy name)])]
              (match (IO.read-file &path)
                (Result.Success source)
                  (Array.push-back! &sources
                                    (ModuleSource.init (String.copy name)
                                                       path
                                                       source))
                (Result.Error message)
                  (set! failure
                        (Maybe.Just
                          (diagnostic
                            (String.concat &[@"cannot read " path @": " message]))))))
          (Maybe.Just _) ()))
      (match failure
        (Maybe.Just error) (Result.Error error)
        (Maybe.Nothing)
          (let-do [root-name (String.copy "__carp-session-core__.carp")
                   root-source (boot-source)]
            (Array.push-back! &sources
                              (ModuleSource.init (String.copy &root-name)
                                                 (String.copy &root-name)
                                                 root-source))
            (match (ModuleLoader.load &sources &root-name)
              (Result.Success loaded)
                (Result.Success (ModuleLoader.with-compiler-prelude &loaded))
              (Result.Error error)
                (Result.Error
                  (diagnostic
                    (String.concat
                      &[(String.copy (ModuleError.path &error))
                        @": "
                        (String.copy (ModuleError.message &error))])))))))))
