(load "carp-session.carp")

(defmodule MacroExpand
  (doc outer-macro? "checks whether `node` is a `defmacro` or a call of a macro
visible in `snapshot`, without running the macro.")
  (defn outer-macro? [snapshot node]
    (or (defmacro? node)
        (match-ref (SurfaceNode.form node)
          (SurfaceForm.List items)
            (if (Array.empty? items)
              false
              (match (macro-by-name (ExpandSnapshot.macros snapshot)
                                    (ExpandSnapshot.modules snapshot)
                                    (ExpandSnapshot.preludes snapshot)
                                    (ExpandSnapshot.scope snapshot)
                                    (Box.peek (Array.unsafe-nth items 0)))
                (MacroLookup.Missing) false
                _ true))
          _ false))))

(defmodule Session
  (defn- submission-node? [snapshot node]
    (cond
      (String.= &(SessionSyntax.head node) "defmodule") true
      (SessionSyntax.declaration? node) false
      (or (MacroExpand.outer-macro? snapshot node)
          (match-ref (SurfaceNode.form node)
            (SurfaceForm.List items)
              (let-do [needed false
                       sequence (and (not (Array.empty? items))
                                     (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth items
                                                                                              0)))
                                       (SurfaceForm.Symbol name)
                                         (String.= &(String.join "." name) "do")
                                       _ false))]
                (when sequence
                  (for [i 1 (Array.length items)]
                    (let [child (Box.peek (Array.unsafe-nth items i))]
                      (when (or (SessionSyntax.declaration? child)
                                (submission-node? snapshot child))
                        (set! needed true)))))
                needed)
            _ false))))

  (doc input-preparation-needed? "checks whether `module` must be prepared
before it is submitted: it has a `defmodule`, a top-level macro call, a `do`
with declarations, or both declarations and runtime forms. No macro is run.")
  (defn input-preparation-needed? [session module]
    (let-do [overlay (Array.unsafe-nth (CompilerSession.overlay session) 0)
             snapshot (Rc.value-ref (SessionOverlay.expansion overlay))
             needed false
             declarations false
             runtime false
             forms (SurfaceModule.forms module)]
      (for [i 0 (Array.length forms)]
        (let-do [node (Box.peek (Array.unsafe-nth forms i))]
          (when (submission-node? snapshot node) (set! needed true))
          (match-ref (SurfaceNode.form node)
            (SurfaceForm.Comment _) ()
            _
              (if (SessionSyntax.declaration? node)
                (set! declarations true)
                (set! runtime true)))))
      (or needed (and declarations runtime))))

  (doc input-expansion "returns `module` with all macros expanded against the
session, if any top-level form is a macro call, and `module` unchanged
otherwise. Expanded forms keep the spans of the calls they came from.")
  (defn input-expansion [session module source-id]
    (let-do [overlay (Array.unsafe-nth (CompilerSession.overlay session) 0)
             snapshot (Rc.value-ref (SessionOverlay.expansion overlay))
             needed false
             forms (SurfaceModule.forms module)]
      (for [i 0 (Array.length forms)]
        (let [node (Box.peek (Array.unsafe-nth forms i))]
          (when (MacroExpand.outer-macro? snapshot node) (set! needed true))))
      (if needed
        (match (MacroExpand.expand-module-against module snapshot)
          (Result.Success expanded) (Result.Success expanded)
          (Result.Error error)
            (Result.Error (expand-diagnostic &error source-id)))
        (Result.Success @module)))))
