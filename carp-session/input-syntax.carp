(load "../carp-surface/carp-surface.carp")

(doc SessionSyntax "classifies expanded top-level forms, without rendering or
parsing them again. Forms keep their spans.")
(defmodule SessionSyntax
  (doc head "returns the qualified head name of the list `node`, or the empty
string.")
  (defn head [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List items)
        (if (Array.empty? items)
          @""
          (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth items 0)))
            (SurfaceForm.Symbol segments) (String.join "." segments)
            _ @""))
      _ @""))

  (doc symbol-name "returns the qualified name of the symbol `node`, or the
empty string.")
  (defn symbol-name [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.Symbol segments) (String.join "." segments)
      _ @""))

  (doc declaration? "checks whether `node` is a declaration or metadata form,
such as `defn`, `deftype`, `doc` or `use`.")
  (defn declaration? [node]
    (Array.contains?
      &[@"def"
        @"defn"
        @"defmacro"
        @"defdynamic"
        @"defndynamic"
        @"deftype"
        @"definterface"
        @"implements"
        @"deftemplate"
        @"register"
        @"register-type"
        @"defmodule"
        @"doc"
        @"sig"
        @"meta-set!"
        @"private"
        @"hidden"
        @"c-name"
        @"deprecated"
        @"todo"
        @"annotate"
        @"include"
        @"system-include"
        @"Unsafe.preproc"
        @"use"
        @"use-all"]
      &(head node)))

  (defn- separate! [node declarations roots]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.Comment _) ()
      (SurfaceForm.List items)
        (cond
          (String.= &(head node) "do")
            (for [i 1 (Array.length items)]
              (separate! (Box.peek (Array.unsafe-nth items i))
                         declarations
                         roots))
          (and (String.= &(head node) "defmodule")
               (Int.>= (Array.length items) 2))
            (let-do [declared [@(Array.unsafe-nth items 0)
                               @(Array.unsafe-nth items 1)]
                     runtime [@(Array.unsafe-nth items 0)
                              @(Array.unsafe-nth items 1)]
                     body (the (Array (Box SurfaceNode)) [])
                     effects (the (Array (Box SurfaceNode)) [])]
              (for [i 2 (Array.length items)]
                (separate! (Box.peek (Array.unsafe-nth items i)) &body &effects))
              (for [i 0 (Array.length &body)]
                (Array.push-back! &declared @(Array.unsafe-nth &body i)))
              (Array.push-back! declarations
                                (Box.init
                                  (SurfaceNode.init @(SurfaceNode.span node)
                                                    (SurfaceForm.List declared))))
              (unless-do (Array.empty? &effects)
                (for [i 0 (Array.length &effects)]
                  (Array.push-back! &runtime @(Array.unsafe-nth &effects i)))
                (Array.push-back! roots
                                  (Box.init
                                    (SurfaceNode.init @(SurfaceNode.span node)
                                                      (SurfaceForm.List runtime))))))
          (or (String.= &(head node) "use") (String.= &(head node) "use-all"))
            (do
              (Array.push-back! declarations (Box.init @node))
              (Array.push-back! roots (Box.init @node)))
          (Array.push-back!
            (if (declaration? node) declarations roots)
            (Box.init @node)))
      _ (Array.push-back! roots (Box.init @node))))

  (doc separate "splits `module` into its declarations and its runtime forms.
Modules and `do` forms are split into both. A `use` goes to both.")
  (defn separate [module]
    (let-do [declarations (the (Array (Box SurfaceNode)) [])
             roots (the (Array (Box SurfaceNode)) [])
             forms (SurfaceModule.forms module)]
      (for [i 0 (Array.length forms)]
        (separate! (Box.peek (Array.unsafe-nth forms i)) &declarations &roots))
      (Pair.init (SurfaceModule.init declarations) (SurfaceModule.init roots)))))
