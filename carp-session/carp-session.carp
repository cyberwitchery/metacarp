(load "../carp-compiler.carp")
(load "carp-core-loader.carp")
(load "git@github.com:carpentry-org/rc@0.3.0")

(deftype SessionDefKind
  (Function [])
  (Value [])
  (External [])
  (Interface [])
  (Other [String]))

(deftype SessionDefInfo
  [name String
   kind SessionDefKind
   scheme String
   source SourceInput
   span SourceSpan])

(deftype SessionTypedEntity
  [kind String
   name (Maybe String)
   type String
   span SourceSpan])

(deftype CellReport
  [forms (Array SessionTypedEntity)
   definitions (Array SessionDefInfo)
   locals (Array SessionTypedEntity)
   expressions (Array SessionTypedEntity)])

(deftype UpsertReport [definition SessionDefInfo
                       invalidated (Array String)])

(deftype RemoveReport [name String
                       invalidated (Array String)])

(deftype Candidate
  [name String
   kind SessionDefKind
   scheme String
   documentation (Maybe String)])

(deftype DocInfo
  [name String
   kind SessionDefKind
   scheme String
   documentation String
   span SourceSpan])

(deftype OwnershipReport
  [name String
   scheme String
   actions (Array SpannedOwnershipAction)
   accesses (Array SpannedOwnershipAccess)
   summaries (Array OwnershipFunctionSummary)
   foreign-contracts (Array OwnershipForeignContract)
   type-capabilities (Array CoreTypeCapability)
   transfer-requirements (Array CoreTransferRequirement)])

(deftype LibraryArtifact
  [c String
   ownership (Array OwnershipReport)
   include-directories (Array String)
   link-libraries (Array String)])

(deftype SessionDocument [name String
                          documentation String
                          span SourceSpan])

(deftype SessionOverlay
  [expansion (Rc ExpandSnapshot)
   resolution ResolveSnapshot
   inferred InferredModule
   core CoreModule
   provenance CoreProvenance
   node-allocator IdAllocator
   interfaces (Rc (Array CoreInterface))
   implementations (Rc (Array CoreImplementation))
   references (Array (Maybe CoreRef))
   inputs (Array SourceInput)
   definitions (Array SessionDefInfo)
   dependencies (Array (Array String))])

(doc CompilerSession "holds the immutable warm compiler base used by transient
notebook cells. Mutable identity allocation is the only state changed by
`infer-cell`; failed calls may consume IDs but cannot alter the warm semantic
environment.")
(deftype CompilerSessionBase
  [expansion (Rc ExpandSnapshot)
   resolution ResolveSnapshot
   core CoreModule
   provenance CoreProvenance
   documents (Array SessionDocument)
   inferred InferredModule
   interfaces (Rc (Array CoreInterface))
   implementations (Rc (Array CoreImplementation))
   ;; a shared one-slot cache of normalized base inference traces
   analysis (Array InferredModule)])

(deftype CompilerSession
  [base (Rc CompilerSessionBase)
   overlay (Array SessionOverlay)])

(defmodule Session
  (doc api-version "is the stable carp-session API revision.")
  (defn api-version [] 2)

  (private session-base)
  (hidden session-base)
  (defn session-base [session]
    (Rc.value-ref (CompilerSession.base session)))

  (private append-inferred-analysis)
  (hidden append-inferred-analysis)
  (private normalized-analysis)
  (hidden normalized-analysis)
  (doc normalized-analysis "one module's inference traces, each normalized with
the substitution of the run that produced it. A merged module carries an empty
substitution, so normalization has to happen before modules are combined: a
trace that kept its solver variables fails specialization later, when a
committed definition makes a dormant polymorphic call reachable.")
  (defn normalized-analysis [module]
    (let-do [environment (Array.copy (InferredModule.environment module))
             expression-types (the (Array (Box MonoType)) [])
             calls (the (Array CallSite) [])
             node-types (the (Array InferredNodeType) [])
             binding-types (the (Array InferredBindingType) [])
             substitution (InferredModule.substitution module)
             solver (Type.solver-from-substitution substitution)]
      (for [i 0 (Array.length (InferredModule.expression-types module))]
        (Array.push-back! &expression-types
                          (Box.init
                            (Type.solver-apply &solver
                                               (Box.peek
                                                 (Array.unsafe-nth (InferredModule.expression-types module)
                                                                   i))))))
      (for [i 0 (Array.length (InferredModule.calls module))]
        (let [call (Array.unsafe-nth (InferredModule.calls module) i)]
          (Array.push-back! &calls
                            (CallSite.init @(CallSite.id call)
                                           (CoreRef.copy (CallSite.reference call))
                                           (Box.init
                                             (Type.solver-apply &solver
                                                                (Box.peek (CallSite.type call))))
                                           (match-ref (CallSite.owner call)
                                             (Maybe.Just owner)
                                               (Maybe.Just (CoreRef.copy owner))
                                             (Maybe.Nothing) (Maybe.Nothing))))))
      (for [i 0 (Array.length (InferredModule.node-types module))]
        (let [node (Array.unsafe-nth (InferredModule.node-types module) i)]
          (Array.push-back! &node-types
                            (InferredNodeType.init @(InferredNodeType.id node)
                                                   (match-ref (InferredNodeType.owner node)
                                                     (Maybe.Just owner)
                                                       (Maybe.Just (CoreRef.copy owner))
                                                     (Maybe.Nothing)
                                                       (Maybe.Nothing))
                                                   (Box.init
                                                     (Type.solver-apply &solver
                                                                        (Box.peek (InferredNodeType.type node))))))))
      (for [i 0 (Array.length (InferredModule.binding-types module))]
        (let [binding (Array.unsafe-nth (InferredModule.binding-types module) i)]
          (Array.push-back! &binding-types
                            (InferredBindingType.init
                              (CoreRef.copy (InferredBindingType.reference binding))
                              (match-ref (InferredBindingType.owner binding)
                                (Maybe.Just owner)
                                  (Maybe.Just (CoreRef.copy owner))
                                (Maybe.Nothing) (Maybe.Nothing))
                              (Box.init
                                (Type.solver-apply &solver
                                                   (Box.peek (InferredBindingType.type binding))))))))
      (InferredModule.init environment
                           expression-types
                           calls
                           node-types
                           binding-types
                           (Type.empty-substitution))))

  (private concat-analysis)
  (hidden concat-analysis)
  (doc concat-analysis "two already-normalized trace sets as one.")
  (defn concat-analysis [base overlay]
    (let-do [environment (Array.copy (InferredModule.environment base))
             expression-types (Array.copy (InferredModule.expression-types base))
             calls (Array.copy (InferredModule.calls base))
             node-types (Array.copy (InferredModule.node-types base))
             binding-types (Array.copy (InferredModule.binding-types base))]
      (for [i 0 (Array.length (InferredModule.environment overlay))]
        (Array.push-back! &environment
                          (SchemeBinding.copy
                            (Array.unsafe-nth (InferredModule.environment overlay)
                                              i))))
      (for [i 0 (Array.length (InferredModule.expression-types overlay))]
        (Array.push-back! &expression-types
                          (Box.copy
                            (Array.unsafe-nth
                              (InferredModule.expression-types overlay)
                              i))))
      (for [i 0 (Array.length (InferredModule.calls overlay))]
        (Array.push-back! &calls
                          (CallSite.copy
                            (Array.unsafe-nth (InferredModule.calls overlay) i))))
      (for [i 0 (Array.length (InferredModule.node-types overlay))]
        (Array.push-back! &node-types
                          (InferredNodeType.copy
                            (Array.unsafe-nth (InferredModule.node-types overlay)
                                              i))))
      (for [i 0 (Array.length (InferredModule.binding-types overlay))]
        (Array.push-back! &binding-types
                          (InferredBindingType.copy
                            (Array.unsafe-nth (InferredModule.binding-types overlay)
                                              i))))
      (InferredModule.init environment
                           expression-types
                           calls
                           node-types
                           binding-types
                           (Type.empty-substitution))))

  (doc append-inferred-analysis "retains normalized inference traces for
committed user definitions while extending the compact warm environment.")
  (defn append-inferred-analysis [base overlay]
    (concat-analysis &(normalized-analysis base) &(normalized-analysis overlay)))

  (private inferred-environment-with-analysis)
  (hidden inferred-environment-with-analysis)
  (doc inferred-environment-with-analysis "uses the visible warm schemes with
an explicitly assembled set of inference traces. This keeps the resident
overlay compact while allowing transient code generation to restore the base
traces retained once by `CompilerSession`.")
  (defn inferred-environment-with-analysis [environment analysis]
    (InferredModule.init
      (Array.copy (InferredModule.environment environment))
      (Array.copy (InferredModule.expression-types analysis))
      (Array.copy (InferredModule.calls analysis))
      (Array.copy (InferredModule.node-types analysis))
      (Array.copy (InferredModule.binding-types analysis))
      (Type.empty-substitution)))

  (private session-surface-items)
  (hidden session-surface-items)
  (defn session-surface-items [items]
    (let-do [result (the (Array (Box SurfaceNode)) [])]
      (for [i 0 (Array.length items)]
        (let [item (Array.unsafe-nth items i)]
          (match-ref (SurfaceNode.form (Box.peek item))
            (SurfaceForm.Comment _) ()
            _ (Array.push-back! &result (Box.copy item)))))
      result))

  (private session-symbol-name)
  (hidden session-symbol-name)
  (defn session-symbol-name [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.Symbol segments) (Maybe.Just (String.join "." segments))
      _ (Maybe.Nothing)))

  (private qualified-document-name)
  (hidden qualified-document-name)
  (defn qualified-document-name [scope name]
    (if (or (String.= scope "") (String.contains? name \.))
      (String.copy name)
      (String.concat &[(String.copy scope) @"." (String.copy name)])))

  (private collect-documents-node!)
  (hidden collect-documents-node!)
  (defn collect-documents-node! [node source-id scope result]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List raw-items)
        (let [items (session-surface-items raw-items)]
          (when (Int.> (Array.length &items) 0)
            (match (session-symbol-name (Box.peek (Array.unsafe-nth &items 0)))
              (Maybe.Just head)
                (cond
                  (and (String.= &head "doc") (Int.= (Array.length &items) 3))
                    (match (session-symbol-name (Box.peek (Array.unsafe-nth &items
                                                                            1)))
                      (Maybe.Just name)
                        (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth &items
                                                                                 2)))
                          (SurfaceForm.StringLit documentation)
                            (Array.push-back! result
                                              (SessionDocument.init (qualified-document-name scope
                                                                                             &name)
                                                                    (String.copy documentation)
                                                                    (SurfaceSpan.in-source (SurfaceNode.span node)
                                                                                           source-id)))
                          _ ())
                      (Maybe.Nothing) ())
                  (and (String.= &head "defmodule")
                       (Int.> (Array.length &items) 1))
                    (match (session-symbol-name (Box.peek (Array.unsafe-nth &items
                                                                            1)))
                      (Maybe.Just module-name)
                        (let [next-scope (qualified-document-name scope
                                                                  &module-name)]
                          (for [i 2 (Array.length &items)]
                            (collect-documents-node! (Box.peek (Array.unsafe-nth &items
                                                                                 i))
                                                     source-id
                                                     &next-scope
                                                     result)))
                      (Maybe.Nothing) ())
                  (String.= &head "do")
                    (for [i 1 (Array.length &items)]
                      (collect-documents-node! (Box.peek (Array.unsafe-nth &items
                                                                           i))
                                               source-id
                                               scope
                                               result))
                  ())
              (Maybe.Nothing) ())))
      _ ()))

  (private documents-from-module)
  (hidden documents-from-module)
  (defn documents-from-module [input module]
    (let-do [result (the (Array SessionDocument) [])]
      (for [i 0 (Array.length (SurfaceModule.forms module))]
        (collect-documents-node!
          (Box.peek (Array.unsafe-nth (SurfaceModule.forms module) i))
          (SourceInput.id input)
          ""
          &result))
      result))

  (private documents-from-input)
  (hidden documents-from-input)
  (defn documents-from-input [input]
    (match (Surface.parse-input input)
      (Result.Success sourced)
        (documents-from-module (SourcedSurfaceModule.input &sourced)
                               (SourcedSurfaceModule.module &sourced))
      (Result.Error _) (the (Array SessionDocument) [])))

  (private expand-diagnostic)
  (hidden expand-diagnostic)
  (sig expand-diagnostic (Fn [(Ref CtError) (Ref String)] Diagnostic))
  (defn expand-diagnostic [error source-id]
    (Diagnostic.init (String.copy "expand")
                     (String.copy (CtError.message error))
                     (Maybe.Just
                       (SurfaceSpan.in-source (CtError.span error) source-id))))

  (private definition-kind)
  (hidden definition-kind)
  (defn definition-kind [core reference]
    (let-do [result (the SessionDefKind (SessionDefKind.Other @"definition"))]
      (for [i 0 (Array.length (CoreModule.functions core))]
        (when (CoreIR.same-ref?
            (CoreFunction.reference
              (Array.unsafe-nth (CoreModule.functions core) i))
            reference)
          (set! result (SessionDefKind.Function))))
      (for [i 0 (Array.length (CoreModule.values core))]
        (when (CoreIR.same-ref?
            (CoreValue.reference (Array.unsafe-nth (CoreModule.values core) i))
            reference)
          (set! result (SessionDefKind.Value))))
      (for [i 0 (Array.length (CoreModule.builtins core))]
        (when (CoreIR.same-ref?
            (CoreBuiltin.reference
              (Array.unsafe-nth (CoreModule.builtins core) i))
            reference)
          (set! result (SessionDefKind.External))))
      (for [i 0 (Array.length (CoreModule.builtin-sources core))]
        (let [source (Array.unsafe-nth (CoreModule.builtin-sources core) i)]
          (when (CoreIR.same-ref? (CoreBuiltinSource.reference source) reference)
            (match-ref (CoreBuiltinSource.payload source)
              (CoreBuiltinPayload.Template _ _)
                (set! result (SessionDefKind.Other (String.copy "template")))
              (CoreBuiltinPayload.External _ _)
                (set! result (SessionDefKind.External))))))
      (for [i 0 (Array.length (CoreModule.constructors core))]
        (when (CoreIR.same-ref?
            (CoreConstructorDeclaration.reference
              (Array.unsafe-nth (CoreModule.constructors core) i))
            reference)
          (set! result (SessionDefKind.Other (String.copy "constructor")))))
      (for [i 0 (Array.length (CoreModule.interfaces core))]
        (when (CoreIR.same-ref?
            (CoreInterface.reference
              (Array.unsafe-nth (CoreModule.interfaces core) i))
            reference)
          (set! result (SessionDefKind.Interface))))
      result))

  (private definitions-report)
  (hidden definitions-report)
  (sig definitions-report
       (Fn
         [(Ref SourceInput)
          (Ref CoreModule)
          (Ref InferredModule)
          (Ref CoreProvenance)]
         (Array SessionDefInfo)))
  (private rendered-type)
  (hidden rendered-type)
  (doc rendered-type "the type to show for a definition. A signature the
author wrote is shown as they wrote it, type variables and all; without one
there is nothing to quote, so what inference generalized is shown in letters
of its own.")
  (defn rendered-type [core reference scheme]
    (let-do [result (Type.render-scheme scheme)
             signatures (CoreModule.signatures core)]
      (for [i 0 (Array.length signatures)]
        (let [candidate (Array.unsafe-nth signatures i)]
          (when (CoreIR.same-ref? (CoreSignature.reference candidate) reference)
            (set! result
                  (Type.render-scheme
                    &(Infer.declaration-scheme
                      (Box.peek (CoreSignature.signature candidate))))))))
      result))

  (defn definitions-report [input core inferred provenance]
    (let-do [result (the (Array SessionDefInfo) [])
             definitions (Infer.spanned-definition-schemes inferred provenance)]
      (for [i 0 (Array.length &definitions)]
        (let [definition (Array.unsafe-nth &definitions i)
              reference (SpannedSchemeBinding.reference definition)]
          (Array.push-back! &result
                            (SessionDefInfo.init (String.copy (CoreRef.name reference))
                                                 (definition-kind core reference)
                                                 (rendered-type core
                                                                reference
                                                                (SpannedSchemeBinding.scheme definition))
                                                 (SourceInput.copy input)
                                                 (SourceSpan.copy (SpannedSchemeBinding.span definition))))))
      result))

  (private expressions-report)
  (hidden expressions-report)
  (defn expressions-report [inferred provenance]
    (let-do [result (the (Array SessionTypedEntity) [])
             nodes (Infer.spanned-node-types inferred provenance)]
      (for [i 0 (Array.length &nodes)]
        (let [node (Array.unsafe-nth &nodes i)]
          (Array.push-back! &result
                            (SessionTypedEntity.init (String.copy "expression")
                                                     (Maybe.Nothing)
                                                     (Type.render (Box.peek (SpannedNodeType.type node)))
                                                     (SourceSpan.copy (SpannedNodeType.span node))))))
      result))

  (private forms-report)
  (hidden forms-report)
  (defn forms-report [core inferred provenance]
    (let-do [result (the (Array SessionTypedEntity) [])
             nodes (Infer.spanned-node-types inferred provenance)
             roots (CoreModule.expressions core)]
      (for [i 0 (Array.length roots)]
        (let [id (CoreIR.expression-id (Box.peek (Array.unsafe-nth roots i)))]
          (for [j 0 (Array.length &nodes)]
            (let [node (Array.unsafe-nth &nodes j)]
              (when (Int.= id @(SpannedNodeType.id node))
                (Array.push-back! &result
                                  (SessionTypedEntity.init (String.copy "form")
                                                           (Maybe.Nothing)
                                                           (Type.render (Box.peek (SpannedNodeType.type node)))
                                                           (SourceSpan.copy (SpannedNodeType.span node)))))))))
      result))

  (private locals-report)
  (hidden locals-report)
  (defn locals-report [inferred provenance]
    (let-do [result (the (Array SessionTypedEntity) [])
             bindings (Infer.spanned-binding-types inferred provenance)]
      (for [i 0 (Array.length &bindings)]
        (let [binding (Array.unsafe-nth &bindings i)]
          (Array.push-back! &result
                            (SessionTypedEntity.init (String.copy "local")
                                                     (Maybe.Just
                                                       (String.copy
                                                         (CoreRef.name (SpannedBindingType.reference binding))))
                                                     (Type.render
                                                       (Box.peek (SpannedBindingType.type binding)))
                                                     (SourceSpan.copy (SpannedBindingType.span binding))))))
      result))

  (private report)
  (hidden report)
  (defn report [input core inferred provenance]
    (let-do [definitions (definitions-report input core inferred provenance)
             forms (forms-report core inferred provenance)]
      (for [i 0 (Array.length &definitions)]
        (let [definition (Array.unsafe-nth &definitions i)]
          (Array.push-back! &forms
                            (SessionTypedEntity.init (String.copy "definition")
                                                     (Maybe.Just
                                                       (String.copy (SessionDefInfo.name definition)))
                                                     (String.copy (SessionDefInfo.scheme definition))
                                                     (SourceSpan.copy (SessionDefInfo.span definition))))))
      (CellReport.init forms
                       definitions
                       (locals-report inferred provenance)
                       (expressions-report inferred provenance))))

  (private session-diagnostic)
  (hidden session-diagnostic)
  (sig session-diagnostic (Fn [String (Maybe SourceSpan)] Diagnostic))
  (defn session-diagnostic [message span]
    (Diagnostic.init (String.copy "session") message span))

  (private macro-definition-info)
  (hidden macro-definition-info)
  (sig macro-definition-info
       (Fn
         [(Ref SessionOverlay) (Ref SourceInput) (Ref PreparedExpansion)]
         (Array SessionDefInfo)))
  (defn macro-definition-info [overlay input prepared]
    (let-do [before (ExpandSnapshot.macros
               (Rc.value-ref (SessionOverlay.expansion overlay)))
             after (ExpandSnapshot.macros (PreparedExpansion.snapshot prepared))
             result (the (Array SessionDefInfo) [])]
      (when (Int.= (Array.length after) (Int.inc (Array.length before)))
        (let [macro (Array.unsafe-nth after (Int.dec (Array.length after)))]
          (Array.push-back! &result
                            (SessionDefInfo.init (String.copy (ExpandMacro.name macro))
                                                 (SessionDefKind.Other (String.copy "macro"))
                                                 (String.copy "macro")
                                                 (SourceInput.copy input)
                                                 (SourceSpan.init (String.copy (SourceInput.id input))
                                                                  0
                                                                  (String.length (SourceInput.source input)))))))
      result))

  (private has-interface?)
  (hidden has-interface?)
  (defn has-interface? [interfaces candidate]
    (let-do [found false]
      (for [i 0 (Array.length interfaces)]
        (when (CoreIR.same-ref?
            (CoreInterface.reference (Array.unsafe-nth interfaces i))
            (CoreInterface.reference candidate))
          (set! found true)))
      found))

  (private has-implementation?)
  (hidden has-implementation?)
  (defn has-implementation? [implementations candidate]
    (let-do [found false]
      (for [i 0 (Array.length implementations)]
        (let [existing (Array.unsafe-nth implementations i)]
          (when (and
              (CoreIR.same-ref? (CoreImplementation.interface existing)
                                (CoreImplementation.interface candidate))
              (CoreIR.same-ref?
                (CoreImplementation.implementation existing)
                (CoreImplementation.implementation candidate)))
            (set! found true))))
      found))

  (private merged-interfaces)
  (hidden merged-interfaces)
  (defn merged-interfaces [overlay core]
    (let-do [current (Rc.value-ref (SessionOverlay.interfaces overlay))
             additions (the (Array CoreInterface) [])]
      (for [i 0 (Array.length (CoreModule.interfaces core))]
        (let [candidate (Array.unsafe-nth (CoreModule.interfaces core) i)]
          (unless (or (has-interface? current candidate)
                      (has-interface? &additions candidate))
            (Array.push-back! &additions (CoreInterface.copy candidate)))))
      (if (Int.= 0 (Array.length &additions))
        (Rc.copy (SessionOverlay.interfaces overlay))
        (let-do [result (Array.copy current)]
          (for [i 0 (Array.length &additions)]
            (Array.push-back! &result
                              (CoreInterface.copy (Array.unsafe-nth &additions i))))
          (Rc.new result)))))

  (private merged-implementations)
  (hidden merged-implementations)
  (defn merged-implementations [overlay core]
    (let-do [current (Rc.value-ref (SessionOverlay.implementations overlay))
             additions (the (Array CoreImplementation) [])]
      (for [i 0 (Array.length (CoreModule.implementations core))]
        (let [candidate (Array.unsafe-nth (CoreModule.implementations core) i)]
          (unless (or (has-implementation? current candidate)
                      (has-implementation? &additions candidate))
            (Array.push-back! &additions (CoreImplementation.copy candidate)))))
      (if (Int.= 0 (Array.length &additions))
        (Rc.copy (SessionOverlay.implementations overlay))
        (let-do [result (Array.copy current)]
          (for [i 0 (Array.length &additions)]
            (Array.push-back! &result
                              (CoreImplementation.copy (Array.unsafe-nth &additions
                                                                         i))))
          (Rc.new result)))))

  (private new-implementations)
  (hidden new-implementations)
  (defn new-implementations [overlay core]
    (let-do [result (the (Array CoreImplementation) [])]
      (for [i 0 (Array.length (CoreModule.implementations core))]
        (let [candidate (Array.unsafe-nth (CoreModule.implementations core) i)]
          (unless (has-implementation?
              (Rc.value-ref (SessionOverlay.implementations overlay))
              candidate)
            (Array.push-back! &result (CoreImplementation.copy candidate)))))
      result))

  (private finish-macro-overlay)
  (hidden finish-macro-overlay)
  (sig finish-macro-overlay
       (Fn
         [(Ref SessionOverlay)
          (Ref SourceInput)
          (Ref PreparedExpansion)
          SessionDefInfo]
         SessionOverlay))
  (defn finish-macro-overlay [overlay input prepared info]
    (let-do [inputs (Array.copy (SessionOverlay.inputs overlay))
             definitions (Array.copy (SessionOverlay.definitions overlay))
             dependencies (Array.copy (SessionOverlay.dependencies overlay))
             references (Array.copy (SessionOverlay.references overlay))
             _ignored-input (Array.push-back! &inputs (SourceInput.copy input))
             _ignored-definition (Array.push-back! &definitions info)
             _ignored-dependency (Array.push-back! &dependencies [])
             _ignored-reference (Array.push-back! &references (Maybe.Nothing))]
      (SessionOverlay.init
        (Rc.new (ExpandSnapshot.copy (PreparedExpansion.snapshot prepared)))
        (ResolveSnapshot.copy (SessionOverlay.resolution overlay))
        (Infer.compact-environment (SessionOverlay.inferred overlay))
        (CoreModule.copy (SessionOverlay.core overlay))
        (CoreProvenance.copy (SessionOverlay.provenance overlay))
        (IdAllocator.copy (SessionOverlay.node-allocator overlay))
        (Rc.copy (SessionOverlay.interfaces overlay))
        (Rc.copy (SessionOverlay.implementations overlay))
        references
        inputs
        definitions
        dependencies)))

  (private finish-type-overlay)
  (hidden finish-type-overlay)
  (sig finish-type-overlay
       (Fn
         [(Ref SessionOverlay)
          (Ref SourceInput)
          (Ref PreparedExpansion)
          (Ref ProvenancedCoreModule)
          (Ref CoreModule)
          (Ref InferredModule)]
         SessionOverlay))
  (defn finish-type-overlay [overlay input prepared resolved core inferred]
    (let-do [inputs (Array.copy (SessionOverlay.inputs overlay))
             definitions (Array.copy (SessionOverlay.definitions overlay))
             dependencies (Array.copy (SessionOverlay.dependencies overlay))
             references (Array.copy (SessionOverlay.references overlay))
             declaration (Array.unsafe-nth
               (CoreModule.constructors (ProvenancedCoreModule.core resolved))
               0)
             type-name (String.copy "")
             _ignored-type-name (match-ref (Box.peek
                 (CoreConstructorDeclaration.result declaration))
               (CoreType.Named name _) (set! type-name (String.copy name))
               _ ())
             info (SessionDefInfo.init type-name
                                       (SessionDefKind.Other (String.copy "type"))
                                       (String.copy "type")
                                       (SourceInput.copy input)
                                       (SourceSpan.init (String.copy (SourceInput.id input))
                                                        0
                                                        (String.length (SourceInput.source input))))
             _ignored-input (Array.push-back! &inputs (SourceInput.copy input))
             _ignored-definition (Array.push-back! &definitions info)
             _ignored-dependency (Array.push-back! &dependencies [])
             _ignored-reference (Array.push-back! &references (Maybe.Nothing))
             resolution (Resolve.snapshot-with-module (SessionOverlay.resolution overlay)
                                                      core)]
      (SessionOverlay.init
        (Rc.new (ExpandSnapshot.copy (PreparedExpansion.snapshot prepared)))
        resolution
        (append-inferred-analysis (SessionOverlay.inferred overlay) inferred)
        (CoreIR.append-modules (SessionOverlay.core overlay) core)
        (CoreProvenance.append (SessionOverlay.provenance overlay)
                               (ProvenancedCoreModule.provenance resolved))
        (IdAllocator.copy (SessionOverlay.node-allocator overlay))
        (merged-interfaces overlay core)
        (merged-implementations overlay core)
        references
        inputs
        definitions
        dependencies)))

  (private finish-implementation-overlay)
  (hidden finish-implementation-overlay)
  (sig finish-implementation-overlay
       (Fn
         [(Ref SessionOverlay)
          (Ref SourceInput)
          (Ref PreparedExpansion)
          (Ref ProvenancedCoreModule)
          (Ref CoreModule)
          (Ref InferredModule)
          CoreImplementation]
         SessionOverlay))
  (defn finish-implementation-overlay [overlay
                                       input
                                       prepared
                                       resolved
                                       core
                                       inferred
                                       entry]
    (let-do [inputs (Array.copy (SessionOverlay.inputs overlay))
             definitions (Array.copy (SessionOverlay.definitions overlay))
             dependencies (Array.copy (SessionOverlay.dependencies overlay))
             references (Array.copy (SessionOverlay.references overlay))
             interface-name (CoreRef.name (CoreImplementation.interface &entry))
             implementation-name (CoreRef.name
               (CoreImplementation.implementation &entry))
             display-name (String.concat
               &[(String.copy interface-name)
                 (String.copy " -> ")
                 (String.copy implementation-name)])
             info (SessionDefInfo.init (String.copy &display-name)
                                       (SessionDefKind.Other (String.copy "implementation"))
                                       display-name
                                       (SourceInput.copy input)
                                       (SourceSpan.init (String.copy (SourceInput.id input))
                                                        0
                                                        (String.length (SourceInput.source input))))
             _ignored-input (Array.push-back! &inputs (SourceInput.copy input))
             _ignored-definition (Array.push-back! &definitions info)
             _ignored-dependency (Array.push-back! &dependencies
                                                   [(String.copy interface-name)
                                                    (String.copy implementation-name)])]
      (Array.push-back! &references (Maybe.Nothing))
      (SessionOverlay.init
        (Rc.new (ExpandSnapshot.copy (PreparedExpansion.snapshot prepared)))
        (ResolveSnapshot.copy (SessionOverlay.resolution overlay))
        (append-inferred-analysis (SessionOverlay.inferred overlay) inferred)
        (CoreIR.append-modules (SessionOverlay.core overlay) core)
        (CoreProvenance.append (SessionOverlay.provenance overlay)
                               (ProvenancedCoreModule.provenance resolved))
        (IdAllocator.copy (SessionOverlay.node-allocator overlay))
        (merged-interfaces overlay core)
        (merged-implementations overlay core)
        references
        inputs
        definitions
        dependencies)))

  (private finish-overlay)
  (hidden finish-overlay)
  (sig finish-overlay
       (Fn
         [(Ref SessionOverlay)
          (Ref SourceInput)
          (Ref PreparedExpansion)
          (Ref CoreProvenance)
          (Ref ProvenancedCoreModule)
          (Ref CoreModule)
          (Ref InferredModule)]
         (Result SessionOverlay Diagnostic)))
  (defn finish-overlay [overlay
                        input
                        prepared
                        source-provenance
                        resolved
                        core
                        inferred]
    (let [found (definitions-report input core inferred source-provenance)
          schemes (Infer.spanned-definition-schemes inferred source-provenance)]
      ;; one entry per definition the input contributes, all pointing at that
      ;; input: a cell holds one, a file holds many, and both are provenance
      ;; for the same bookkeeping
      (if (Int.> (Array.length &found) 0)
        (let-do [inputs (Array.copy (SessionOverlay.inputs overlay))
                 definitions (Array.copy (SessionOverlay.definitions overlay))
                 dependencies (Array.copy (SessionOverlay.dependencies overlay))
                 stored-references (Array.copy (SessionOverlay.references overlay))
                 found-count (Array.length &found)
                 _ignored-definitions (for [d 0 found-count]
                   (let-do [reference (SpannedSchemeBinding.reference (Array.unsafe-nth &schemes
                                                                                        d))
                            references (CoreIR.global-dependencies core
                                                                   reference)
                            dependency-names (the (Array String) [])]
                     (for [i 0 (Array.length &references)]
                       (Array.push-back! &dependency-names
                                         (String.copy
                                           (CoreRef.name (Array.unsafe-nth &references
                                                                           i)))))
                     (Array.push-back! &inputs (SourceInput.copy input))
                     (Array.push-back! &definitions
                                       (SessionDefInfo.copy (Array.unsafe-nth &found
                                                                              d)))
                     (Array.push-back! &dependencies dependency-names)
                     (Array.push-back! &stored-references
                                       (Maybe.Just (CoreRef.copy reference)))))
                 resolution (Resolve.snapshot-with-module (SessionOverlay.resolution overlay)
                                                          core)]
          (Result.Success
            (SessionOverlay.init
              (Rc.new
                (ExpandSnapshot.copy (PreparedExpansion.snapshot prepared)))
              resolution
              (append-inferred-analysis (SessionOverlay.inferred overlay)
                                        inferred)
              (CoreIR.append-modules (SessionOverlay.core overlay) core)
              (CoreProvenance.append (SessionOverlay.provenance overlay)
                                     (ProvenancedCoreModule.provenance resolved))
              (IdAllocator.copy (SessionOverlay.node-allocator overlay))
              (merged-interfaces overlay core)
              (merged-implementations overlay core)
              stored-references
              inputs
              definitions
              dependencies)))
        (let [implementations (new-implementations overlay
                                                   (ProvenancedCoreModule.core resolved))]
          (if (Int.= 1 (Array.length &implementations))
            (Result.Success
              (finish-implementation-overlay overlay
                                             input
                                             prepared
                                             resolved
                                             core
                                             inferred
                                             (CoreImplementation.copy (Array.unsafe-nth &implementations
                                                                                        0))))
            (Result.Error
              (session-diagnostic
                (String.copy "upsert expects exactly one definition")
                (the (Maybe SourceSpan) (Maybe.Nothing)))))))))

  (private infer-overlay)
  (hidden infer-overlay)
  (sig infer-overlay
       (Fn
         [(Ref SessionOverlay)
          (Ref SourceInput)
          (Ref PreparedExpansion)
          (Ref ProvenancedCoreModule)]
         (Result SessionOverlay Diagnostic)))
  (defn infer-overlay [overlay input prepared resolved]
    (let [origin (the (Maybe SourceSpan)
                      (Maybe.Just
                        (SourceSpan.init (String.copy (SourceInput.id input))
                                         0
                                         (String.length (SourceInput.source input)))))]
      (match (CarpCompiler.derive-module-for-inference-provenanced resolved
                                                                   (SessionOverlay.node-allocator overlay)
                                                                   &origin)
        (Result.Success derived)
          (match (Infer.module-against-diagnosed (ProvenancedCoreModule.core &derived)
                                                 (ProvenancedCoreModule.provenance &derived)
                                                 (SessionOverlay.inferred overlay))
            (Result.Success inferred)
              (if (Int.>
                  (Array.length
                    (CoreModule.constructors (ProvenancedCoreModule.core &derived)))
                  0)
                (Result.Success
                  (finish-type-overlay overlay
                                       input
                                       prepared
                                       &derived
                                       (ProvenancedCoreModule.core &derived)
                                       &inferred))
                (finish-overlay overlay
                                input
                                prepared
                                (ProvenancedCoreModule.provenance resolved)
                                &derived
                                (ProvenancedCoreModule.core &derived)
                                &inferred))
            (Result.Error diagnostic) (Result.Error diagnostic))
        (Result.Error error)
          (Result.Error
            (Diagnostic.init
              (String.copy (CompileError.phase &error))
              (String.copy (CompileError.message &error))
              (match-ref &origin
                (Maybe.Just span) (Maybe.Just (SourceSpan.copy span))
                (Maybe.Nothing) (Maybe.Nothing)))))))

  (private resolve-overlay)
  (hidden resolve-overlay)
  (sig resolve-overlay
       (Fn
         [(Ref SessionOverlay)
          (Ref SourceInput)
          (Ref PreparedExpansion)
          (Maybe CoreRef)]
         (Result SessionOverlay Diagnostic)))
  (defn resolve-overlay [overlay input prepared reuse]
    (let [sourced (SourcedSurfaceModule.init (SourceInput.copy input)
                                             (SurfaceModule.copy (PreparedExpansion.module prepared)))]
      (match (match-ref &reuse
          (Maybe.Just reference)
            (let [references [(CoreRef.copy reference)]]
              (Resolve.module-with-provenance-against-reusing &sourced
                                                              (SessionOverlay.node-allocator overlay)
                                                              (SessionOverlay.resolution overlay)
                                                              &references))
          (Maybe.Nothing)
            (Resolve.module-with-provenance-against &sourced
                                                    (SessionOverlay.node-allocator overlay)
                                                    (SessionOverlay.resolution overlay)))
        (Result.Success resolved)
          (infer-overlay overlay input prepared &resolved)
        (Result.Error error)
          (Result.Error (Resolve.diagnostic &error (SourceInput.id input))))))

  (private expand-overlay)
  (hidden expand-overlay)
  (sig expand-overlay
       (Fn
         [(Ref SessionOverlay)
          (Ref SourceInput)
          (Ref SourcedSurfaceModule)
          (Maybe CoreRef)]
         (Result SessionOverlay Diagnostic)))
  (defn expand-overlay [overlay input parsed reuse]
    (match (MacroExpand.prepare-module-against (SourcedSurfaceModule.module parsed)
                                               (Rc.value-ref (SessionOverlay.expansion overlay)))
      (Result.Success prepared)
        (let [macro-infos (macro-definition-info overlay input &prepared)]
          (if (Int.= 1 (Array.length &macro-infos))
            (Result.Success
              (finish-macro-overlay overlay
                                    input
                                    &prepared
                                    (SessionDefInfo.copy (Array.unsafe-nth &macro-infos
                                                                           0))))
            (resolve-overlay overlay input &prepared reuse)))
      (Result.Error error)
        (Result.Error (expand-diagnostic &error (SourceInput.id input)))))

  (private extend-overlay)
  (hidden extend-overlay)
  (sig extend-overlay
       (Fn
         [(Ref SessionOverlay) (Ref SourceInput) (Maybe CoreRef)]
         (Result SessionOverlay Diagnostic)))
  (defn extend-overlay [overlay input reuse]
    (match (Surface.parse-input-diagnosed input)
      (Result.Success parsed) (expand-overlay overlay input &parsed reuse)
      (Result.Error diagnostic) (Result.Error diagnostic)))

  (private rebuild-overlay-at)
  (hidden rebuild-overlay-at)
  (sig rebuild-overlay-at
       (Fn
         [(Ref CompilerSession)
          (Ref (Array SourceInput))
          (Ref (Array (Maybe CoreRef)))
          Int
          (Ref SessionOverlay)]
         (Result SessionOverlay Diagnostic)))
  ;; an input that contributed several definitions appears once per
  ;; definition, so rebuilding extends it once and skips its repeats —
  ;; extending it again would define everything in it twice
  (private repeats-previous?)
  (hidden repeats-previous?)
  (sig repeats-previous? (Fn [(Ref (Array SourceInput)) Int] Bool))
  (defn repeats-previous? [inputs index]
    (if (Int.= index 0)
      false
      (let [current (Array.unsafe-nth inputs index)
            previous (Array.unsafe-nth inputs (Int.dec index))]
        (and
          (String.= (SourceInput.id current) (SourceInput.id previous))
          (String.= (SourceInput.source current) (SourceInput.source previous))))))

  (defn rebuild-overlay-at [session inputs reuse index overlay]
    (cond
      (Int.= index (Array.length inputs))
        (Result.Success (SessionOverlay.copy overlay))
      (repeats-previous? inputs index)
        (rebuild-overlay-at session inputs reuse (Int.inc index) overlay)
      (match (extend-overlay overlay
                             (Array.unsafe-nth inputs index)
                             @(Array.unsafe-nth reuse index))
        (Result.Success next)
          (rebuild-overlay-at session inputs reuse (Int.inc index) &next)
        (Result.Error diagnostic) (Result.Error diagnostic))))

  (private rebuild-overlay)
  (hidden rebuild-overlay)
  (sig rebuild-overlay
       (Fn
         [(Ref CompilerSession)
          (Ref (Array SourceInput))
          (Ref (Array (Maybe CoreRef)))
          Int]
         (Result SessionOverlay Diagnostic)))
  (defn rebuild-overlay [session inputs reuse next-id]
    (let [initial (SessionOverlay.init
            (Rc.copy (CompilerSessionBase.expansion (session-base session)))
            (ResolveSnapshot.copy
              (CompilerSessionBase.resolution (session-base session)))
            (Infer.compact-environment
              (CompilerSessionBase.inferred (session-base session)))
            (CoreIR.empty-module)
            (CoreProvenance.init [] [] [])
            (IdAllocator.init [next-id])
            (Rc.copy (CompilerSessionBase.interfaces (session-base session)))
            (Rc.copy (CompilerSessionBase.implementations (session-base session)))
            []
            []
            []
            [])]
      (rebuild-overlay-at session inputs reuse 0 &initial)))

  (private definition-index)
  (hidden definition-index)
  (defn definition-index [definitions name]
    (let-do [result -1]
      (for [i 0 (Array.length definitions)]
        (when (String.=
            (SessionDefInfo.name (Array.unsafe-nth definitions i))
            name)
          (set! result i)))
      result))

  (private string-in?)
  (hidden string-in?)
  (sig string-in? (Fn [(Ref (Array String)) (Ref String)] Bool))
  (defn string-in? [items value]
    (let-do [found false]
      (for [i 0 (Array.length items)]
        (when (String.= (Array.unsafe-nth items i) value) (set! found true)))
      found))

  (private depends-on-any?)
  (hidden depends-on-any?)
  (sig depends-on-any? (Fn [(Ref (Array String)) (Ref (Array String))] Bool))
  (defn depends-on-any? [dependencies affected]
    (let-do [found false]
      (for [i 0 (Array.length dependencies)]
        (when (string-in? affected (Array.unsafe-nth dependencies i))
          (set! found true)))
      found))

  (private invalidated-by)
  (hidden invalidated-by)
  (sig invalidated-by (Fn [(Ref SessionOverlay) Int] (Array String)))
  (defn invalidated-by [overlay index]
    (let-do [definitions (SessionOverlay.definitions overlay)
             dependencies (SessionOverlay.dependencies overlay)
             target (SessionDefInfo.name (Array.unsafe-nth definitions index))
             affected [(String.copy target)]
             result (the (Array String) [])
             semantic-boundary? (match-ref (SessionDefInfo.kind (Array.unsafe-nth definitions
                                                                                  index))
               (SessionDefKind.Interface) true
               (SessionDefKind.Other label)
                 (or (String.= label "macro")
                     (or (String.= label "type")
                         (String.= label "implementation")))
               _ false)
             changed true]
      (if semantic-boundary?
        (for [i (Int.inc index) (Array.length definitions)]
          (Array.push-back! &result
                            (String.copy
                              (SessionDefInfo.name (Array.unsafe-nth definitions
                                                                     i)))))
        (while-do changed
          (set! changed false)
          (for [i 0 (Array.length definitions)]
            (let [name (SessionDefInfo.name (Array.unsafe-nth definitions i))]
              (when-do (and (Int./= i index)
                            (and (not (string-in? &affected name))
                                 (depends-on-any? (Array.unsafe-nth dependencies
                                                                    i)
                                                  &affected)))
                (Array.push-back! &affected (String.copy name))
                (Array.push-back! &result (String.copy name))
                (set! changed true))))))
      result))

  (doc create-from-module "creates a warm session from an already loaded base
module. Loading files remains a host concern in this initial library slice;
the expensive expansion, resolution, and inference happen exactly once here.")
  (defn create-from-module [base config]
    (match (MacroExpand.prepare-module-with (SourcedSurfaceModule.module base)
                                            config)
      (Result.Success prepared)
        (let-do [allocator (IdAllocator.init [0])
                 expanded-base (SourcedSurfaceModule.init
                   (SourceInput.copy (SourcedSurfaceModule.input base))
                   @(PreparedExpansion.module &prepared))]
          (match (Resolve.module-with-provenance &expanded-base &allocator)
            (Result.Success resolved)
              (let [origin (the (Maybe SourceSpan) (Maybe.Nothing))]
                (match (CarpCompiler.derive-module-for-inference-provenanced &resolved
                                                                             &allocator
                                                                             &origin)
                  (Result.Success derived)
                    (let-do [base-resolution (Resolve.last-snapshot)
                             resolution (Resolve.snapshot-with-module &base-resolution
                                                                      (ProvenancedCoreModule.core &derived))]
                      (match (Infer.module-diagnosed (ProvenancedCoreModule.core &derived)
                                                     (ProvenancedCoreModule.provenance &derived))
                        (Result.Success inferred)
                          (let-do [base-documents (documents-from-module (SourcedSurfaceModule.input base)
                                                                         (SourcedSurfaceModule.module base))
                                   base-expansion (Rc.new @(PreparedExpansion.snapshot &prepared))
                                   base-resolution resolution
                                   base-interfaces (Rc.new
                                     (Array.copy
                                       (CoreModule.interfaces (ProvenancedCoreModule.core &derived))))
                                   base-implementations (Rc.new
                                     (Array.copy
                                       (CoreModule.implementations (ProvenancedCoreModule.core &derived))))
                                   current (SessionOverlay.init (Rc.copy &base-expansion)
                                                                (ResolveSnapshot.copy &base-resolution)
                                                                (Infer.compact-environment &inferred)
                                                                (CoreIR.empty-module)
                                                                (CoreProvenance.init []
                                                                                     []
                                                                                     [])
                                                                (IdAllocator.copy &allocator)
                                                                (Rc.copy &base-interfaces)
                                                                (Rc.copy &base-implementations)
                                                                []
                                                                []
                                                                []
                                                                [])]
                            (Result.Success
                              (CompilerSession.init
                                (Rc.new
                                  (CompilerSessionBase.init
                                    base-expansion
                                    base-resolution
                                    @(ProvenancedCoreModule.core &derived)
                                    (CoreProvenance.copy
                                      (ProvenancedCoreModule.provenance &derived))
                                    base-documents
                                    inferred
                                    base-interfaces
                                    base-implementations
                                    []))
                                [current])))
                        (Result.Error diagnostic) (Result.Error diagnostic)))
                  (Result.Error error)
                    (Result.Error
                      (Diagnostic.init
                        (String.copy (CompileError.phase &error))
                        (String.copy (CompileError.message &error))
                        (Maybe.Nothing)))))
            (Result.Error error)
              (Result.Error
                (Resolve.diagnostic &error
                                    (SourceInput.id (SourcedSurfaceModule.input base))))))
      (Result.Error error)
        (Result.Error
          (expand-diagnostic &error
                             (SourceInput.id (SourcedSurfaceModule.input base))))))

  (doc create "loads, expands, derives, resolves, and infers the standard
library under `core-dir` once, producing a warm compiler session.")
  (defn create [core-dir]
    (match (SessionCoreLoader.load-core core-dir)
      (Result.Success module)
        (let [input (SourceInput.init (String.copy "session:core")
                                      (String.copy ""))
              sourced (SourcedSurfaceModule.init input module)
              config (ExpandConfig.init [@"Dynamic"])]
          (create-from-module &sourced &config))
      (Result.Error diagnostic) (Result.Error diagnostic)))

  (private set-overlay!)
  (hidden set-overlay!)
  (doc set-overlay!
    "replaces the session's overlay — the one place it changes,
so anything later derived from it has a single place to be invalidated from.")
  (defn set-overlay! [session next]
    (Array.aset! (CompilerSession.overlay session) 0 next))

  (private session-analysis)
  (hidden session-analysis)
  (doc session-analysis "the base and overlay inference traces as one set.
Normalizing the base half means walking every trace the base holds and
applying its substitution: on a project the size of a compiler that is half a
minute of work, and the base is fixed when the session is created — so it is
normalized once and kept, and each call only normalizes the overlay, which
holds what the user has committed since.")
  (defn session-analysis [session overlay]
    (do
      (when (Int.= (Array.length
                     (CompilerSessionBase.analysis (session-base session))) 0)
        (Array.push-back!
          (CompilerSessionBase.analysis (session-base session))
          (normalized-analysis
            (CompilerSessionBase.inferred (session-base session)))))
      (concat-analysis
        (Array.unsafe-nth (CompilerSessionBase.analysis (session-base session)) 0)
        &(normalized-analysis (SessionOverlay.inferred overlay)))))

  (doc reset "drops committed user definitions while retaining the warm core.")
  (defn reset [session]
    (let-do [old (Array.unsafe-nth (CompilerSession.overlay session) 0)
             next-id @(Array.unsafe-nth
               (IdAllocator.cell (SessionOverlay.node-allocator old))
               0)
             fresh (SessionOverlay.init
               (Rc.copy (CompilerSessionBase.expansion (session-base session)))
               (ResolveSnapshot.copy
                 (CompilerSessionBase.resolution (session-base session)))
               (Infer.compact-environment
                 (CompilerSessionBase.inferred (session-base session)))
               (CoreIR.empty-module)
               (CoreProvenance.init [] [] [])
               (IdAllocator.init [next-id])
               (Rc.copy (CompilerSessionBase.interfaces (session-base session)))
               (Rc.copy (CompilerSessionBase.implementations (session-base session)))
               []
               []
               []
               [])]
      (set-overlay! session fresh)))

  (doc fork "creates an independent compiler session by sharing the immutable
warm base and its normalized-analysis cache while copying only the mutable
  overlay. This is the cheap session-clone operation used by interactive hosts.")
  (defn fork [session]
    (CompilerSession.init
      (Rc.copy (CompilerSession.base session))
      [(SessionOverlay.copy
         (Array.unsafe-nth (CompilerSession.overlay session) 0))]))

  (doc definitions "returns committed user definitions in dependency order.")
  (defn definitions [session]
    (Array.copy
      (SessionOverlay.definitions
        (Array.unsafe-nth (CompilerSession.overlay session) 0))))

  (private completion-documents)
  (hidden completion-documents)
  (defn completion-documents [session overlay]
    (let-do [result (Array.copy
                      (CompilerSessionBase.documents (session-base session)))]
      (for [i 0 (Array.length (SessionOverlay.inputs overlay))]
        (let [documents (documents-from-input
                (Array.unsafe-nth (SessionOverlay.inputs overlay) i))]
          (for [j 0 (Array.length &documents)]
            (Array.push-back! &result
                              (SessionDocument.copy (Array.unsafe-nth &documents
                                                                      j))))))
      result))

  (private documentation-for)
  (hidden documentation-for)
  (defn documentation-for [documents name]
    (let-do [result (the (Maybe String) (Maybe.Nothing))]
      (for [i 0 (Array.length documents)]
        (let [document (Array.unsafe-nth documents i)]
          (when (String.= (SessionDocument.name document) name)
            (set! result
                  (Maybe.Just
                    (String.copy (SessionDocument.documentation document)))))))
      result))

  (private candidate-index)
  (hidden candidate-index)
  (defn candidate-index [candidates name]
    (let-do [result -1]
      (for [i 0 (Array.length candidates)]
        (let [candidate (Array.unsafe-nth candidates i)]
          (when (String.= (Candidate.name candidate) name) (set! result i))))
      result))

  (private add-candidate!)
  (hidden add-candidate!)
  (defn add-candidate! [candidates prefix candidate]
    (when (String.starts-with? (Candidate.name candidate) prefix)
      (let [index (candidate-index candidates (Candidate.name candidate))]
        (if (Int.>= index 0)
          (Array.aset! candidates index (Candidate.copy candidate))
          (Array.push-back! candidates (Candidate.copy candidate))))))

  (private scheme-for-reference)
  (hidden scheme-for-reference)
  (defn scheme-for-reference [inferred reference]
    (let-do [result (String.copy "")
             environment (InferredModule.environment inferred)]
      (for [i 0 (Array.length environment)]
        (let [binding (Array.unsafe-nth environment i)]
          (when (CoreIR.same-ref? (SchemeBinding.reference binding) reference)
            (set! result (Type.render-scheme (SchemeBinding.scheme binding))))))
      result))

  (doc complete "returns deterministic prefix matches from the warm visible
runtime, type, interface, implementation, template, and macro environments.")
  (defn complete [session prefix]
    (let-do [overlay (Array.unsafe-nth (CompilerSession.overlay session) 0)
             core (CoreIR.append-modules
                     (CompilerSessionBase.core (session-base session))
                                         (SessionOverlay.core overlay))
             documents (completion-documents session overlay)
             candidates (the (Array Candidate) [])
             globals (ResolveSnapshot.globals (SessionOverlay.resolution overlay))]
      (for [i 0 (Array.length globals)]
        (let [reference (Array.unsafe-nth globals i)
              name (CoreRef.name reference)
              kind (definition-kind &core reference)]
          (add-candidate! &candidates
                          prefix
                          &(Candidate.init (String.copy name)
                                           kind
                                           (scheme-for-reference (SessionOverlay.inferred overlay)
                                                                 reference)
                                           (documentation-for &documents name)))))
      (for [i 0 (Array.length (SessionOverlay.definitions overlay))]
        (let [definition (Array.unsafe-nth (SessionOverlay.definitions overlay)
                                           i)
              name (SessionDefInfo.name definition)]
          (add-candidate! &candidates
                          prefix
                          &(Candidate.init (String.copy name)
                                           @(SessionDefInfo.kind definition)
                                           (String.copy (SessionDefInfo.scheme definition))
                                           (documentation-for &documents name)))))
      (for [i 0 (Array.length (CoreModule.type-declarations &core))]
        (let [name (CoreTypeDeclaration.name
                (Array.unsafe-nth (CoreModule.type-declarations &core) i))]
          (add-candidate! &candidates
                          prefix
                          &(Candidate.init (String.copy name)
                                           (SessionDefKind.Other (String.copy "type"))
                                           (String.copy "type")
                                           (documentation-for &documents name)))))
      (let [implementations (Rc.value-ref (SessionOverlay.implementations overlay))]
        (for [i 0 (Array.length implementations)]
          (let [implementation (Array.unsafe-nth implementations i)
                interface-name (CoreRef.name
                  (CoreImplementation.interface implementation))
                implementation-name (CoreRef.name
                  (CoreImplementation.implementation implementation))
                name (String.concat
                  &[(String.copy interface-name)
                    (String.copy " -> ")
                    (String.copy implementation-name)])]
            (add-candidate! &candidates
                            prefix
                            &(Candidate.init name
                                             (SessionDefKind.Other (String.copy "implementation"))
                                             (scheme-for-reference (SessionOverlay.inferred overlay)
                                                                   (CoreImplementation.implementation implementation))
                                             (documentation-for &documents
                                                                interface-name))))))
      (let [macros (ExpandSnapshot.macros
              (Rc.value-ref (SessionOverlay.expansion overlay)))]
        (for [i 0 (Array.length macros)]
          (let [name (ExpandMacro.name (Array.unsafe-nth macros i))]
            (add-candidate! &candidates
                            prefix
                            &(Candidate.init (String.copy name)
                                             (SessionDefKind.Other (String.copy "macro"))
                                             (String.copy "macro")
                                             (documentation-for &documents name))))))
      candidates))

  (doc doc "returns structured documentation for the exact visible name.")
  (defn doc [session name]
    (let-do [overlay (Array.unsafe-nth (CompilerSession.overlay session) 0)
             documents (completion-documents session overlay)
             candidates (complete session name)
             result (the (Maybe DocInfo) (Maybe.Nothing))]
      (for [i 0 (Array.length &candidates)]
        (let [candidate (Array.unsafe-nth &candidates i)]
          (when (String.= (Candidate.name candidate) name)
            (for [j 0 (Array.length &documents)]
              (let [document (Array.unsafe-nth &documents j)]
                (when (String.= (SessionDocument.name document) name)
                  (set! result
                        (Maybe.Just
                          (DocInfo.init (String.copy name)
                                        @(Candidate.kind candidate)
                                        (String.copy (Candidate.scheme candidate))
                                        (String.copy (SessionDocument.documentation document))
                                        (SourceSpan.copy (SessionDocument.span document)))))))))))
      result))

  (private visible-reference)
  (hidden visible-reference)
  (defn visible-reference [overlay name]
    (let-do [result (the (Maybe CoreRef) (Maybe.Nothing))
             globals (ResolveSnapshot.globals (SessionOverlay.resolution overlay))]
      (for [i 0 (Array.length globals)]
        (let [reference (Array.unsafe-nth globals i)]
          (when (String.= (CoreRef.name reference) name)
            (set! result (Maybe.Just (CoreRef.copy reference))))))
      result))

  (private ownership-requests)
  (hidden ownership-requests)
  (defn ownership-requests [inferred reference]
    (let-do [requests (the (Array SpecializationRequest) [])]
      (for [i 0 (Array.length (InferredModule.calls inferred))]
        (let [call (Array.unsafe-nth (InferredModule.calls inferred) i)]
          (when (CoreIR.same-ref? (CallSite.reference call) reference)
            (Array.push-back! &requests
                              (SpecializationRequest.init (CallSite.copy call)
                                                          (String.copy "session ownership query"))))))
      (when (Int.= 0 (Array.length &requests))
        (let [environment (InferredModule.environment inferred)]
          (for [i 0 (Array.length environment)]
            (let [binding (Array.unsafe-nth environment i)]
              (when (CoreIR.same-ref? (SchemeBinding.reference binding)
                                      reference)
                (Array.push-back! &requests
                                  (SpecializationRequest.init
                                    (CallSite.init -1
                                                   (CoreRef.copy reference)
                                                   (Box.init
                                                     (MonoType.copy
                                                       (Box.peek
                                                         (TypeScheme.body (SchemeBinding.scheme binding)))))
                                                   (Maybe.Nothing))
                                    (String.copy "session ownership query"))))))))
      requests))

  (private ownership-action-context)
  (hidden ownership-action-context)
  (defn ownership-action-context [action]
    (match-ref action
      (OwnershipAction.Move site _ _ _) @(OwnershipSite.context site)
      (OwnershipAction.Borrow site _ _) @(OwnershipSite.context site)
      (OwnershipAction.Delete site _ _) @(OwnershipSite.context site)))

  (private ownership-access-context)
  (hidden ownership-access-context)
  (defn ownership-access-context [access]
    @(OwnershipSite.context (OwnershipAccess.site access)))

  (private int-member?)
  (hidden int-member?)
  (defn int-member? [values value]
    (let-do [found false]
      (for [i 0 (Array.length values)]
        (when (Int.= @(Array.unsafe-nth values i) value) (set! found true)))
      found))

  (private target-ownership-actions)
  (hidden target-ownership-actions)
  (defn target-ownership-actions [plan provenance reference]
    (let-do [contexts (the (Array Int) [])
             plan-contexts (OwnershipPlan.contexts plan)]
      (for [i 0 (Array.length plan-contexts)]
        (match-ref (Array.unsafe-nth plan-contexts i)
          (OwnershipContext.Definition candidate _ _ _)
            (when (CoreIR.same-ref? candidate reference)
              (Array.push-back! &contexts i))
          (OwnershipContext.Roots _) ()))
      (let-do [spanned (Ownership.spanned-actions plan provenance)
               result (the (Array SpannedOwnershipAction) [])]
        (for [i 0 (Array.length &spanned)]
          (let [action (Array.unsafe-nth &spanned i)]
            (when (int-member? &contexts
                               (ownership-action-context (SpannedOwnershipAction.action action)))
              (Array.push-back! &result (SpannedOwnershipAction.copy action)))))
        result)))

  (private target-ownership-accesses)
  (hidden target-ownership-accesses)
  (defn target-ownership-accesses [plan provenance reference]
    (let-do [contexts (the (Array Int) [])
             plan-contexts (OwnershipPlan.contexts plan)]
      (for [i 0 (Array.length plan-contexts)]
        (match-ref (Array.unsafe-nth plan-contexts i)
          (OwnershipContext.Definition candidate _ _ _)
            (when (CoreIR.same-ref? candidate reference)
              (Array.push-back! &contexts i))
          (OwnershipContext.Roots _) ()))
      (let-do [spanned (Ownership.spanned-accesses plan provenance)
               result (the (Array SpannedOwnershipAccess) [])]
        (for [i 0 (Array.length &spanned)]
          (let [access (Array.unsafe-nth &spanned i)]
            (when (int-member?
                    &contexts
                    (ownership-access-context
                      (SpannedOwnershipAccess.access access)))
              (Array.push-back! &result
                                (SpannedOwnershipAccess.copy access)))))
        result)))

  (private target-ownership-summaries)
  (hidden target-ownership-summaries)
  (defn target-ownership-summaries [plan reference]
    (let-do [result (the (Array OwnershipFunctionSummary) [])
             summaries (OwnershipPlan.summaries plan)]
      (for [i 0 (Array.length summaries)]
        (let [summary (Array.unsafe-nth summaries i)]
          (when (CoreIR.same-ref? (OwnershipFunctionSummary.reference summary)
                                  reference)
            (Array.push-back! &result (OwnershipFunctionSummary.copy summary)))))
      result))

  (private ownership-foreign-contracts)
  (hidden ownership-foreign-contracts)
  (defn ownership-foreign-contracts [plan]
    (let-do [result (the (Array OwnershipForeignContract) [])
             contracts (OwnershipPlan.foreign-contracts plan)]
      (for [i 0 (Array.length contracts)]
        (Array.push-back! &result
                          (OwnershipForeignContract.copy
                            (Array.unsafe-nth contracts i))))
      result))

  (private root-reference)
  (hidden root-reference)
  (defn root-reference [core name]
    (let-do [result (the (Maybe CoreRef) (Maybe.Nothing))
             functions (CoreModule.functions core)]
      (for [i 0 (Array.length functions)]
        (let [reference (CoreFunction.reference
                          (Array.unsafe-nth functions i))]
          (when (String.= (CoreRef.name reference) name)
            (set! result (Maybe.Just (CoreRef.copy reference))))))
      result))

  (private library-ownership-reports)
  (hidden library-ownership-reports)
  (defn library-ownership-reports [core inferred provenance plan roots]
    (let-do [reports (the (Array OwnershipReport) [])]
      (for [i 0 (Array.length roots)]
        (let [name (Array.unsafe-nth roots i)]
          (match (root-reference core name)
            (Maybe.Just reference)
              (Array.push-back! &reports
                (OwnershipReport.init
                  (String.copy name)
                  (scheme-for-reference inferred &reference)
                  (target-ownership-actions plan provenance &reference)
                  (target-ownership-accesses plan provenance &reference)
                  (target-ownership-summaries plan &reference)
                  (ownership-foreign-contracts plan)
                  (Array.copy (CoreModule.type-capabilities core))
                  (Array.copy (CoreModule.transfer-requirements core))))
            (Maybe.Nothing) ())))
      reports))

  (private diagnostic-at-reference)
  (hidden diagnostic-at-reference)
  (defn diagnostic-at-reference [phase message provenance reference]
    (Diagnostic.init (String.copy phase)
                     message
                     (CoreProvenance.binding-span provenance reference)))

  (doc ownership "specializes and ownership-plans the requested visible
definition against the warm inferred environment, returning only that
definition's moves, borrows, and deletes joined to caller source spans.")
  (defn ownership [session name]
    (let [overlay (Array.unsafe-nth (CompilerSession.overlay session) 0)]
      (match (visible-reference overlay name)
        (Maybe.Nothing)
          (Result.Error
            (session-diagnostic
              (String.concat
                &[@"unknown session definition: " (String.copy name)])
              (Maybe.Nothing)))
        (Maybe.Just reference)
          (let-do [core (CoreIR.append-modules
                          (CompilerSessionBase.core (session-base session))
                                               (SessionOverlay.core overlay))
                     provenance (CoreProvenance.append
                     (CompilerSessionBase.provenance (session-base session))
                     (SessionOverlay.provenance overlay))
                   inferred (session-analysis session overlay)
                   requests (ownership-requests (SessionOverlay.inferred overlay)
                                                &reference)]
            (if (Int.= 0 (Array.length &requests))
              (Result.Error
                (diagnostic-at-reference "specialize"
                                         (String.concat
                                           &[@"no inferred specialization for "
                                             (String.copy name)])
                                         &provenance
                                         &reference))
              (match (Specialize.module-with &core
                                             &inferred
                                             &requests)
                (Result.Error error)
                  (Result.Error
                    (diagnostic-at-reference "specialize"
                                             (String.copy (SpecializeError.message &error))
                                             &provenance
                                             &reference))
                (Result.Success specialized)
                  (match (Ownership.prepare &specialized
                                            &(OwnershipClassify.facts-from-module &core))
                    (Result.Error error)
                      (Result.Error
                        (diagnostic-at-reference "ownership"
                                                 (String.copy (OwnershipError.message &error))
                                                 &provenance
                                                 &reference))
                    (Result.Success plan)
                      (Result.Success
                        (OwnershipReport.init (String.copy name)
                                              (scheme-for-reference (SessionOverlay.inferred overlay)
                                                                    &reference)
                                              (target-ownership-actions &plan
                                                                        &provenance
                                                                        &reference)
                                              (target-ownership-accesses &plan
                                                                         &provenance
                                                                         &reference)
                                              (target-ownership-summaries &plan
                                                                          &reference)
                                              (ownership-foreign-contracts &plan)
                                              (Array.copy
                                                (CoreModule.type-capabilities &core))
                                              (Array.copy
                                                (CoreModule.transfer-requirements &core)))))))))))

  (private compatible-definition-kind?)
  (hidden compatible-definition-kind?)
  (defn compatible-definition-kind? [left right]
    (match-ref left
      (SessionDefKind.Function)
        (match-ref right (SessionDefKind.Function) true _ false)
      (SessionDefKind.Value)
        (match-ref right (SessionDefKind.Value) true _ false)
      (SessionDefKind.External)
        (match-ref right (SessionDefKind.External) true _ false)
      (SessionDefKind.Interface)
        (match-ref right (SessionDefKind.Interface) true _ false)
      _ false))

  (doc upsert "atomically inserts or replaces one runtime definition and
reports its transitive resolved dependents.")
  (defn upsert [session input]
    (let [current (Array.unsafe-nth (CompilerSession.overlay session) 0)
          probe (SessionOverlay.copy current)]
      (match (extend-overlay &probe input (Maybe.Nothing))
        (Result.Success probed)
          (if (Int./=
                (Int.- (Array.length (SessionOverlay.definitions &probed))
                       (Array.length (SessionOverlay.definitions current)))
                1)
            (Result.Error
              (session-diagnostic
                (String.copy "upsert expects exactly one definition; use upsert-input for a complete source input")
                (Maybe.Just
                  (SourceSpan.init (String.copy (SourceInput.id input))
                                   0
                                   (String.length (SourceInput.source input))))))
            (let [candidate (Array.unsafe-nth (SessionOverlay.definitions &probed)
                                            (Int.dec
                                              (Array.length (SessionOverlay.definitions &probed))))
                name (SessionDefInfo.name candidate)
                old-index (definition-index (SessionOverlay.definitions current)
                                            name)
                inputs (Array.copy (SessionOverlay.inputs current))
                references (Array.copy (SessionOverlay.references current))
                invalidated (if (Int.>= old-index 0)
                  (invalidated-by current old-index)
                  (the (Array String) []))
                _ignored-candidate (if (Int.>= old-index 0)
                  (do
                    (Array.aset! &inputs old-index (SourceInput.copy input))
                    (unless (compatible-definition-kind?
                        (SessionDefInfo.kind
                          (Array.unsafe-nth (SessionOverlay.definitions current)
                                            old-index))
                        (SessionDefInfo.kind candidate))
                      (Array.aset! &references old-index (Maybe.Nothing))))
                  (do
                    (Array.push-back! &inputs (SourceInput.copy input))
                    (Array.push-back! &references (Maybe.Nothing))))
                next-id @(Array.unsafe-nth
                  (IdAllocator.cell (SessionOverlay.node-allocator current))
                  0)]
            (let [rebuilt-result (rebuild-overlay session
                                                  &inputs
                                                  &references
                                                  next-id)]
              (match-ref &rebuilt-result
                (Result.Success rebuilt)
                  (let-do [committed (Array.unsafe-nth (SessionOverlay.definitions rebuilt)
                                                       (if (Int.>= old-index 0)
                                                         old-index
                                                         (Int.dec
                                                           (Array.length (SessionOverlay.definitions rebuilt)))))]
                    (set-overlay! session (SessionOverlay.copy rebuilt))
                    (Result.Success
                      (UpsertReport.init (SessionDefInfo.copy committed)
                                         invalidated)))
                (Result.Error diagnostic)
                  (Result.Error (Diagnostic.copy diagnostic))))))
        (Result.Error diagnostic) (Result.Error diagnostic))))

  (private without-input)
  (hidden without-input)
  (doc without-input "the overlay's inputs and their reuse references with
every entry belonging to an input id dropped.")
  (sig without-input
       (Fn [(Ref SessionOverlay) (Ref String)]
           (Pair (Array SourceInput) (Array (Maybe CoreRef)))))
  (defn without-input [overlay id]
    (let-do [inputs (the (Array SourceInput) [])
             reuse (the (Array (Maybe CoreRef)) [])
             old-inputs (SessionOverlay.inputs overlay)
             old-reuse (SessionOverlay.references overlay)
             n (Array.length old-inputs)]
      (for [i 0 n]
        (unless-do (String.= (SourceInput.id (Array.unsafe-nth old-inputs i)) id)
          (Array.push-back! &inputs
                            (SourceInput.copy (Array.unsafe-nth old-inputs i)))
          (Array.push-back! &reuse @(Array.unsafe-nth old-reuse i))))
      (Pair.init inputs reuse)))

  (private definitions-of-input)
  (hidden definitions-of-input)
  (defn definitions-of-input [overlay id]
    (let-do [result (the (Array SessionDefInfo) [])
             definitions (SessionOverlay.definitions overlay)
             n (Array.length definitions)]
      (for [i 0 n]
        (let [definition (Array.unsafe-nth definitions i)]
          (when (String.= (SourceInput.id (SessionDefInfo.source definition)) id)
            (Array.push-back! &result (SessionDefInfo.copy definition)))))
      result))

  (doc upsert-input "upserts a whole input — a file, say — with however many
definitions it holds, and answers them. Everything that input contributed
before is replaced: definitions that have vanished from it are dropped, so a
rename leaves no ghost behind. Use `upsert` for a single definition whose
identity is its name rather than its file.")
  (sig upsert-input
       (Fn
         [(Ref CompilerSession) (Ref SourceInput)]
         (Result (Array SessionDefInfo) Diagnostic)))
  (defn upsert-input [session input]
    (let [current (Array.unsafe-nth (CompilerSession.overlay session) 0)
          kept (without-input current (SourceInput.id input))
          next-id @(Array.unsafe-nth
            (IdAllocator.cell (SessionOverlay.node-allocator current))
            0)]
      (let-do [inputs (Array.copy (Pair.a &kept))
               reuse (Array.copy (Pair.b &kept))]
        (Array.push-back! &inputs (SourceInput.copy input))
        (Array.push-back! &reuse (the (Maybe CoreRef) (Maybe.Nothing)))
        (match (rebuild-overlay session &inputs &reuse next-id)
          (Result.Success rebuilt)
            (let-do [committed (definitions-of-input &rebuilt
                                                     (SourceInput.id input))]
              (set-overlay! session rebuilt)
              (Result.Success committed))
          (Result.Error diagnostic) (Result.Error diagnostic)))))

  (doc remove-input "drops everything an input contributed, as deleting the
file would.")
  (sig remove-input
       (Fn [(Ref CompilerSession) (Ref String)] (Result () Diagnostic)))
  (defn remove-input [session id]
    (let [current (Array.unsafe-nth (CompilerSession.overlay session) 0)
          kept (without-input current id)
          next-id @(Array.unsafe-nth
            (IdAllocator.cell (SessionOverlay.node-allocator current))
            0)]
      (match (rebuild-overlay session (Pair.a &kept) (Pair.b &kept) next-id)
        (Result.Success rebuilt)
          (do (set-overlay! session rebuilt) (Result.Success ()))
        (Result.Error diagnostic) (Result.Error diagnostic))))

  (doc remove "removes a definition and its transitive resolved dependents.")
  (defn remove [session name]
    (let [current (Array.unsafe-nth (CompilerSession.overlay session) 0)
          index (definition-index (SessionOverlay.definitions current) name)]
      (if (Int.< index 0)
        (Result.Error
          (session-diagnostic
            (String.concat &[@"unknown session definition: " (String.copy name)])
            (the (Maybe SourceSpan) (Maybe.Nothing))))
        (let-do [invalidated (invalidated-by current index)
                 inputs (the (Array SourceInput) [])
                 references (the (Array (Maybe CoreRef)) [])
                 _ignored-input-filter (for [i
                                             0
                                             (Array.length (SessionOverlay.inputs current))]
                   (let [candidate-name (SessionDefInfo.name
                           (Array.unsafe-nth (SessionOverlay.definitions current)
                                             i))]
                     (when-do (and (Int./= i index)
                                   (not (string-in? &invalidated candidate-name)))
                       (Array.push-back! &inputs
                                         (SourceInput.copy
                                           (Array.unsafe-nth (SessionOverlay.inputs current)
                                                             i)))
                       (Array.push-back! &references
                                         @(Array.unsafe-nth (SessionOverlay.references current)
                                                            i)))))
                 next-id @(Array.unsafe-nth
                   (IdAllocator.cell (SessionOverlay.node-allocator current))
                   0)]
          (let [rebuilt-result (rebuild-overlay session
                                                &inputs
                                                &references
                                                next-id)]
            (match-ref &rebuilt-result
              (Result.Success rebuilt)
                (do
                  (set-overlay! session (SessionOverlay.copy rebuilt))
                  (Result.Success
                    (RemoveReport.init (String.copy name) invalidated)))
              (Result.Error diagnostic)
                (Result.Error (Diagnostic.copy diagnostic))))))))

  (doc infer-cell "expands, resolves, and infers transient caller source
against the warm base without committing compile-time or semantic changes.")
  (private rendered-expansion)
  (hidden rendered-expansion)
  (defn rendered-expansion [module]
    (if (Int.= 0 (Array.length (SurfaceModule.forms module)))
      (Maybe.Nothing)
      (Maybe.Just (Surface.render-module module))))

  (doc expand "fully expands transient caller source against the warm
compile-time environment. Compile-time mutation occurs only in a private
snapshot copy and is discarded after the query.")
  (defn expand [session input]
    (let [overlay (Array.unsafe-nth (CompilerSession.overlay session) 0)]
      (match (Surface.parse-input-diagnosed input)
        (Result.Success parsed)
          (match (MacroExpand.expand-module-against (SourcedSurfaceModule.module &parsed)
                                                    (Rc.value-ref (SessionOverlay.expansion overlay)))
            (Result.Success expanded)
              (Result.Success (rendered-expansion &expanded))
            (Result.Error error)
              (Result.Error (expand-diagnostic &error (SourceInput.id input))))
        (Result.Error diagnostic) (Result.Error diagnostic))))

  (doc trace-expand "expands caller source against the warm environment and
answers every compile-time step it took, in order, paired with the failure
that ended it when one did.

Compile-time evaluation is deterministic, so a debugger does not need to stop
it: this runs it once, recording each form as it is entered, and stepping is
then walking the recording — backwards as easily as forwards.

A failed expansion is exactly when a trace is worth having: it ran up to the
failure, and that is where the reader is looking. The failure comes back
alongside the steps rather than instead of them, because the last step says
where the evaluation stopped and only the diagnostic says why.")
  (defn trace-expand [session input]
    (let-do [_on (CtEval.trace-on!)
             ;; the caller's own forms are written in the caller's source, and
             ;; nothing else will say so: it arrived as text, so no load of a
             ;; file ever named it
             _pushed (CtEval.push-step-file! (SourceInput.id input))
             expansion (expand session input)
             _popped (CtEval.pop-step-file!)
             _off (CtEval.trace-off!)]
      (the (Pair (Array CtStep) (Maybe Diagnostic))
           (match expansion
             (Result.Success _) (Pair.init (CtEval.trace) (Maybe.Nothing))
             (Result.Error diagnostic)
               (Pair.init (CtEval.trace) (Maybe.Just diagnostic))))))

  (doc expand-1 "performs one outermost macro-expansion step per transient
top-level form. Returns `Nothing` when no top-level form is a macro call.")
  (defn expand-1 [session input]
    (let [overlay (Array.unsafe-nth (CompilerSession.overlay session) 0)]
      (match (Surface.parse-input-diagnosed input)
        (Result.Success parsed)
          (match (MacroExpand.expand-module-1-against (SourcedSurfaceModule.module &parsed)
                                                      (Rc.value-ref (SessionOverlay.expansion overlay)))
            (Result.Success maybe-expanded)
              (match maybe-expanded
                (Maybe.Just expanded)
                  (Result.Success (rendered-expansion &expanded))
                (Maybe.Nothing) (Result.Success (Maybe.Nothing)))
            (Result.Error error)
              (Result.Error (expand-diagnostic &error (SourceInput.id input))))
        (Result.Error diagnostic) (Result.Error diagnostic))))

  (private compile-diagnostic)
  (hidden compile-diagnostic)
  (defn compile-diagnostic [error input]
    (Diagnostic.init (String.copy (CompileError.phase error))
                     (String.copy (CompileError.message error))
                     (Maybe.Just
                       (SourceSpan.init (String.copy (SourceInput.id input))
                                        0
                                        (String.length (SourceInput.source input))))))

  (doc emit-cell "emits a deterministic executable C translation unit for a
transient cell against the warm committed environment. Expansion, identity
allocation, inference, and code generation occur on private copies and cannot
mutate the session. A cell is a top level, so a value it ends on is echoed the
way the driver echoes one, and a client does not have to guess whether a type's
`str` takes its argument by reference or by value.")
  (doc emit-library "emits the same transient program as `emit-cell`, but as a
C library translation unit without a process entry point or top-level echo.
`roots` names every source-level function that the native host will export.")
  (private emit-mark!)
  (hidden emit-mark!)
  ;; Prints elapsed milliseconds per emit-cell step under CARP_DEBUG_EMIT, the
  ;; way the compiler's own pipeline reports phases under CARP_DEBUG_PHASES.
  ;; Emission cost is dominated by whole-program work, so it is worth being
  ;; able to see which step a session is spending its time in.
  (defn emit-mark! [name since]
    (match (IO.getenv "CARP_DEBUG_EMIT")
      (Maybe.Just _)
        (IO.errorln
          &(fmt "emit %s: %.0f ms"
                name
                (Double./
                  (Double.from-long
                    (Uint64.to-long (Uint64.- (System.nanotime) since)))
                  1000000.0)))
      (Maybe.Nothing) ()))

  (doc prepare-emit "does the session-wide work that emitting a cell needs —
normalizing the base's inference traces — so the first cell does not pay for
it. Optional: emit-cell does it on demand.")
  (defn prepare-emit [session]
    (when (Int.= (Array.length
                   (CompilerSessionBase.analysis (session-base session))) 0)
      (Array.push-back!
        (CompilerSessionBase.analysis (session-base session))
        (normalized-analysis
          (CompilerSessionBase.inferred (session-base session))))))

  (private emit-cell-with)
  (hidden emit-cell-with)
  (defn emit-cell-with [session input executable roots]
    (let [overlay (Array.unsafe-nth (CompilerSession.overlay session) 0)]
      (match (Surface.parse-input-diagnosed input)
        (Result.Success parsed)
          (match (MacroExpand.expand-module-against (SourcedSurfaceModule.module &parsed)
                                                    (Rc.value-ref (SessionOverlay.expansion overlay)))
            (Result.Success expanded)
              (let-do [started (System.nanotime)
                       _m0 (emit-mark! "expanded" started)
                       sourced (SourcedSurfaceModule.init (SourceInput.copy input)
                                                          expanded)
                       allocator (IdAllocator.copy (SessionOverlay.node-allocator overlay))
                       _m1 (emit-mark! "allocator-copied" started)]
                (match (Resolve.module-with-provenance-against &sourced
                                                               &allocator
                                                               (SessionOverlay.resolution overlay))
                  (Result.Success resolved)
                    (let [origin (the (Maybe SourceSpan)
                                      (Maybe.Just
                                        (SourceSpan.init (String.copy (SourceInput.id input))
                                                         0
                                                         (String.length (SourceInput.source input)))))]
                      (match (CarpCompiler.derive-module-for-inference-provenanced &resolved
                                                                                   &allocator
                                                                                   &origin)
                        (Result.Success derived)
                          (match (Infer.module-against-diagnosed (ProvenancedCoreModule.core &derived)
                                                                 (ProvenancedCoreModule.provenance &derived)
                                                                 (SessionOverlay.inferred overlay))
                            (Result.Success inferred)
                              (let-do [_m2 (emit-mark! "inferred" started)
                                       core (CoreIR.append-modules
                                              (CompilerSessionBase.core
                                                (session-base session))
                                                                   (SessionOverlay.core overlay))
                                       complete-core (CoreIR.append-modules &core
                                                                            (ProvenancedCoreModule.core &derived))
                                       _m3 (emit-mark! "core-appended" started)
                                       warm-inferred (inferred-environment-with-analysis (SessionOverlay.inferred overlay)
                                                                                         &(session-analysis session
                                                                                                            overlay))
                                       complete-inferred (append-inferred-analysis &warm-inferred
                                                                                   &inferred)
                                       _m4 (emit-mark! "analysis-appended"
                                                       started)]
                                (match (if executable
                                         (match
                                           (CarpCompiler.compile-inferred-module-echoed
                                             &complete-core
                                             &complete-inferred)
                                           (Result.Success c)
                                             (Result.Success
                                               (LibraryArtifact.init c [] [] []))
                                           (Result.Error error)
                                             (Result.Error error))
                                         (match
                                           (CarpCompiler.compile-inferred-library-artifact-roots
                                             &complete-core
                                             &complete-inferred
                                             roots)
                                           (Result.Success artifact)
                                             (let [provenance (CoreProvenance.append
                                                   &(CoreProvenance.append
                                                      (CompilerSessionBase.provenance
                                                        (session-base session))
                                                      (SessionOverlay.provenance overlay))
                                                   (ProvenancedCoreModule.provenance &derived))]
                                               (Result.Success
                                                 (LibraryArtifact.init
                                                   (String.copy (Pair.a &artifact))
                                                   (library-ownership-reports
                                                     &complete-core
                                                     &complete-inferred
                                                     &provenance
                                                     (Pair.b &artifact)
                                                     roots)
                                                   []
                                                   [])))
                                           (Result.Error error)
                                             (Result.Error error)))
                                  (Result.Success artifact)
                                    (do
                                      (emit-mark! "compiled" started)
                                      (Result.Success artifact))
                                  (Result.Error error)
                                    (Result.Error (compile-diagnostic &error
                                                                      input))))
                            (Result.Error diagnostic) (Result.Error diagnostic))
                        (Result.Error error)
                          (Result.Error (compile-diagnostic &error input))))
                  (Result.Error error)
                    (Result.Error
                      (Resolve.diagnostic &error (SourceInput.id input)))))
            (Result.Error error)
              (Result.Error (expand-diagnostic &error (SourceInput.id input))))
        (Result.Error diagnostic) (Result.Error diagnostic))))

  (defn emit-cell [session input]
    (match (emit-cell-with session input true &(the (Array String) []))
      (Result.Success artifact)
        (Result.Success (String.copy (LibraryArtifact.c &artifact)))
      (Result.Error diagnostic) (Result.Error diagnostic)))

  (defn emit-library [session input roots]
    (emit-cell-with session input false roots))

  (doc emit-library-with-build "emits a rooted library artifact and carries
the host-resolved include directories and native libraries with it as data.
The compiler never executes these values or treats source text as build
authority; a host resolves, validates, fingerprints, and supplies them.")
  (defn emit-library-with-build [session input roots include-directories link-libraries]
    (match (emit-cell-with session input false roots)
      (Result.Error diagnostic) (Result.Error diagnostic)
      (Result.Success artifact)
        (Result.Success
          (LibraryArtifact.init
            (String.copy (LibraryArtifact.c &artifact))
            (Array.copy (LibraryArtifact.ownership &artifact))
            (Array.copy include-directories)
            (Array.copy link-libraries)))))

  (defn infer-cell [session input]
    (let [overlay (Array.unsafe-nth (CompilerSession.overlay session) 0)]
      (match (Surface.parse-input-diagnosed input)
        (Result.Success parsed)
          (match (MacroExpand.expand-module-against (SourcedSurfaceModule.module &parsed)
                                                    (Rc.value-ref (SessionOverlay.expansion overlay)))
            (Result.Success expanded)
              (let [sourced (SourcedSurfaceModule.init (SourceInput.copy input)
                                                       expanded)]
                (match (Resolve.module-with-provenance-against &sourced
                                                               (SessionOverlay.node-allocator overlay)
                                                               (SessionOverlay.resolution overlay))
                  (Result.Success resolved)
                    (match (Infer.module-against-diagnosed (ProvenancedCoreModule.core &resolved)
                                                           (ProvenancedCoreModule.provenance &resolved)
                                                           (SessionOverlay.inferred overlay))
                      (Result.Success inferred)
                        (Result.Success
                          (report input
                                  (ProvenancedCoreModule.core &resolved)
                                  &inferred
                                  (ProvenancedCoreModule.provenance &resolved)))
                      (Result.Error diagnostic) (Result.Error diagnostic))
                  (Result.Error error)
                    (Result.Error
                      (Resolve.diagnostic &error (SourceInput.id input)))))
            (Result.Error error)
              (Result.Error (expand-diagnostic &error (SourceInput.id input))))
        (Result.Error diagnostic) (Result.Error diagnostic)))))
