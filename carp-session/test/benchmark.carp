(load "../carp-session.carp")
(Project.no-echo)

(deftemplate monotonic-ms (Fn [] Double) "#include <time.h>
double $NAME(void)" "$DECL {
  struct timespec now;
  clock_gettime(CLOCK_MONOTONIC, &now);
  return ((double)now.tv_sec * 1000.0) + ((double)now.tv_nsec / 1000000.0);
}")

(defn core-dir []
  (match (IO.getenv "CARP_DIR")
    (Maybe.Just root)
      (if (or (String.ends-with? &root "/core")
              (String.ends-with? &root "/core/"))
        root
        (String.append &root (if (String.ends-with? &root "/") "core" "/core")))
    (Maybe.Nothing) (String.copy "../../../carp/Carp/core")))

(defn main []
  (let-do [dir (core-dir)
           cold-start (monotonic-ms)]
    (match (Session.create &dir)
      (Result.Success session)
        (let-do [cold-ms (Double.- (monotonic-ms) cold-start)
                 iterations 100
                 cell-source (String.copy
                   "(let [xs [1 2 3]] (Array.unsafe-nth &xs 1))")
                 warm-start (monotonic-ms)
                 failures 0]
          (for [i 0 iterations]
            (let [cell (SourceInput.init (String.concat &[@"bench:" (Int.str i)])
                                         (String.copy &cell-source))]
              (match (Session.infer-cell &session &cell)
                (Result.Success _) ()
                (Result.Error diagnostic)
                  (do
                    (set! failures (Int.inc failures))
                    (IO.println
                      &(String.concat
                        &[(String.copy (Diagnostic.phase &diagnostic))
                          @": "
                          (String.copy (Diagnostic.message &diagnostic))]))))))
          (let-do [warm-ms (Double.- (monotonic-ms) warm-start)]
            (IO.println &(fmt "cold-create-ms=%.3f" cold-ms))
            (IO.println &(fmt "cell-bytes=%d" (String.length &cell-source)))
            (IO.println
              &(fmt
                "warm-cells=%d total-ms=%.3f mean-ms=%.3f failures=%d"
                iterations
                warm-ms
                (Double./ warm-ms (Double.from-int iterations))
                failures))))
      (Result.Error diagnostic)
        (IO.println
          &(String.concat
            &[(String.copy (Diagnostic.phase &diagnostic))
              @": "
              (String.copy (Diagnostic.message &diagnostic))])))))
