(load "../carp-session.carp")
(Project.no-echo)
(load "Test.carp")

(use-all Test)

(defn memory-session []
  (let [input (SourceInput.init (String.copy "base:memory")
                                (String.copy "(defn warm-id [x] x)"))]
    (match (Surface.parse-input &input)
      (Result.Success base)
        (let [config (ExpandConfig.init [])]
          (Session.create-from-module &base &config))
      (Result.Error error)
        (Result.Error
          (Diagnostic.init (String.copy "parse")
                           (Parser.format-error &error)
                           (Maybe.Nothing))))))

(defn lifecycle-failure [label] (do (IO.println label) false))

(defn lifecycle-cycle [session iteration]
  (let-do [ok true
           suffix (Int.str iteration)
           runtime-source (SourceInput.init
             (String.concat &[@"memory:runtime:" (String.copy &suffix)])
             (String.copy "(defn churn [x] (warm-id x))"))
           bad-runtime-source (SourceInput.init
             (String.concat &[@"memory:bad-runtime:" (String.copy &suffix)])
             (String.copy "(defn churn [x] (if 1 x x))"))
           type-source (SourceInput.init
             (String.concat &[@"memory:type:" (String.copy &suffix)])
             (String.copy "(deftype ChurnBox [value Int])"))
           interface-source (SourceInput.init
             (String.concat &[@"memory:interface:" (String.copy &suffix)])
             (String.copy "(definterface choose (Fn [a a] a))"))
           implementation-source (SourceInput.init
             (String.concat &[@"memory:implementation:" (String.copy &suffix)])
             (String.copy "(implements choose churn)"))
           cell-source (SourceInput.init
             (String.concat &[@"memory:cell:" (String.copy &suffix)])
             (String.copy "(churn 1)"))
           bad-cell-source (SourceInput.init
             (String.concat &[@"memory:bad-cell:" (String.copy &suffix)])
             (String.copy "(churn missing-name)"))]
    (match (Session.upsert session &runtime-source)
      (Result.Success _) ()
      (Result.Error _) (set! ok (lifecycle-failure "runtime upsert failed")))
    (match (Session.upsert session &bad-runtime-source)
      (Result.Success _) (set! ok false)
      (Result.Error _) ())
    (match (Session.infer-cell session &cell-source)
      (Result.Success _) ()
      (Result.Error _) (set! ok (lifecycle-failure "valid cell failed")))
    (match (Session.expand session &cell-source)
      (Result.Success rendered)
        (match rendered
          (Maybe.Just text)
            (when (Int.= 0 (String.length &text))
              (set! ok (lifecycle-failure "empty expansion result")))
          (Maybe.Nothing)
            (set! ok (lifecycle-failure "missing expansion result")))
      (Result.Error _) (set! ok (lifecycle-failure "expansion query failed")))
    (let [candidates (Session.complete session "churn")]
      (when (Int.= 0 (Array.length &candidates))
        (set! ok (lifecycle-failure "completion query failed"))))
    (match (Session.ownership session "churn")
      (Result.Success _) ()
      (Result.Error _) ())
    (match (Session.infer-cell session &bad-cell-source)
      (Result.Success _) (set! ok false)
      (Result.Error _) ())
    (match (Session.upsert session &type-source)
      (Result.Success _) ()
      (Result.Error _) (set! ok (lifecycle-failure "type upsert failed")))
    (match (Session.upsert session &interface-source)
      (Result.Success _) ()
      (Result.Error _) (set! ok (lifecycle-failure "interface upsert failed")))
    (match (Session.upsert session &implementation-source)
      (Result.Success _) ()
      (Result.Error _)
        (set! ok (lifecycle-failure "implementation upsert failed")))
    (Session.reset session)
    ok))

(defn repeated-session-lifecycle-is-balanced? []
  (match (memory-session)
    (Result.Success session)
      (let-do [ok (lifecycle-cycle &session -1)
               before (Debug.memory-balance)
               iterations 20]
        (for [i 0 iterations]
          (unless (lifecycle-cycle &session i) (set! ok false)))
        (let-do [after (Debug.memory-balance)]
          (when (Long./= before after)
            (IO.println
              &(fmt "session lifecycle memory delta: %d" (Long.- after before))))
          (and ok (Long.= before after))))
    (Result.Error _) false))

(deftest t
  (assert-true t
    (repeated-session-lifecycle-is-balanced?)
    "repeated successful and failed session cycles return to baseline"))
