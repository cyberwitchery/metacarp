(load "../carp-session.carp")
(Project.no-echo)
(load "Test.carp")

(use-all Test)

(defn diagnostic-false [diagnostic]
  (do
    (IO.println
      &(String.concat
        &[(String.copy (Diagnostic.phase diagnostic))
          @": "
          (String.copy (Diagnostic.message diagnostic))]))
    false))

(defn diagnostic-from? [diagnostic phase source-id]
  (and
    (String.= (Diagnostic.phase diagnostic) phase)
    (match-ref (Diagnostic.span diagnostic)
      (Maybe.Just span) (String.= (SourceSpan.source-id span) source-id)
      (Maybe.Nothing) false)))

(defn session-dispatch-pair? [session interface-name implementation-name]
  (let-do [found false
           overlay (Array.unsafe-nth (CompilerSession.overlay session) 0)
           implementations (Rc.value-ref (SessionOverlay.implementations overlay))]
    (for [i 0 (Array.length implementations)]
      (let [entry (Array.unsafe-nth implementations i)]
        (when (and
            (String.=
              (CoreRef.name (CoreImplementation.interface entry))
              interface-name)
            (String.=
              (CoreRef.name (CoreImplementation.implementation entry))
              implementation-name))
          (set! found true))))
    found))

(defn session-reference-id [session name]
  (let-do [result (the (Maybe Int) (Maybe.Nothing))
           overlay (Array.unsafe-nth (CompilerSession.overlay session) 0)
           definitions (SessionOverlay.definitions overlay)
           references (SessionOverlay.references overlay)]
    (for [i 0 (Array.length definitions)]
      (when (String.=
          (SessionDefInfo.name (Array.unsafe-nth definitions i))
          name)
        (match-ref (Array.unsafe-nth references i)
          (Maybe.Just reference)
            (set! result (Maybe.Just @(CoreRef.id reference)))
          (Maybe.Nothing) ())))
    result))

(defn candidate-kind-is? [candidate expected]
  (match-ref (Candidate.kind candidate)
    (SessionDefKind.Function) (String.= expected "function")
    (SessionDefKind.Value) (String.= expected "value")
    (SessionDefKind.External) (String.= expected "external")
    (SessionDefKind.Interface) (String.= expected "interface")
    (SessionDefKind.Other label) (String.= label expected)))

(defn has-candidate? [candidates name kind]
  (let-do [found false]
    (for [i 0 (Array.length candidates)]
      (let [candidate (Array.unsafe-nth candidates i)]
        (when (and
            (String.= (Candidate.name candidate) name)
            (candidate-kind-is? candidate kind))
          (set! found true))))
    found))

(defn candidate-count [candidates name]
  (let-do [count 0]
    (for [i 0 (Array.length candidates)]
      (when (String.= (Candidate.name (Array.unsafe-nth candidates i)) name)
        (set! count (Int.inc count))))
    count))

(defn has-string? [values expected]
  (let-do [found false]
    (for [i 0 (Array.length values)]
      (when (String.= (Array.unsafe-nth values i) expected) (set! found true)))
    found))

(defn make-session []
  (let [input (SourceInput.init (String.copy "base:test")
                                (String.copy "(defdynamic n 0)
(defmacro next [] (do (set! n (+ n 1)) n))
(defn warm-id [x] x)
(register-type OwnedWidget)
(register make-owned-widget (Fn [] OwnedWidget) \"make_owned_widget\")
(defmodule OwnedWidget
  (register delete (Fn [OwnedWidget] ()) \"owned_widget_delete\"))
(implements delete OwnedWidget.delete)"))]
    (match (Surface.parse-input &input)
      (Result.Success base)
        (let [config (ExpandConfig.init [])]
          (Session.create-from-module &base &config))
      (Result.Error error)
        (Result.Error
          (Diagnostic.init (String.copy "parse")
                           (Parser.format-error &error)
                           (Maybe.Nothing))))))

(defn warm-cells-are-transactional-and-spanned? []
  (match (make-session)
    (Result.Success session)
      (let [input (SourceInput.init (String.copy "cell:one")
                                    (String.copy "(warm-id (next))"))]
        (match (Session.infer-cell &session &input)
          (Result.Success first)
            (match (Session.infer-cell &session &input)
              (Result.Success second)
                (and
                  (Int.= 1 (Array.length (CellReport.forms &first)))
                  (and
                    (Int.> (Array.length (CellReport.expressions &first)) 0)
                    (and
                      (String.=
                        (SessionTypedEntity.type
                          (Array.unsafe-nth (CellReport.forms &first) 0))
                        "Int")
                      (and
                        (String.=
                          (SourceSpan.source-id
                            (SessionTypedEntity.span
                              (Array.unsafe-nth (CellReport.forms &first) 0)))
                          "cell:one")
                        (String.=
                          (SessionTypedEntity.type
                            (Array.unsafe-nth (CellReport.forms &second) 0))
                          "Int")))))
              (Result.Error diagnostic) (diagnostic-false &diagnostic))
          (Result.Error diagnostic) (diagnostic-false &diagnostic)))
    (Result.Error diagnostic) (diagnostic-false &diagnostic)))

(defn failed-cell-does-not-poison-session? []
  (match (make-session)
    (Result.Success session)
      (let [bad (SourceInput.init (String.copy "cell:bad")
                                  (String.copy "(defn bad [] (if 1 true false))"))
            good (SourceInput.init (String.copy "cell:good")
                                   (String.copy "(warm-id 7)"))]
        (match (Session.infer-cell &session &bad)
          (Result.Success _) false
          (Result.Error diagnostic)
            (and
              (String.= (Diagnostic.phase &diagnostic) "infer")
              (match (Session.infer-cell &session &good)
                (Result.Success report)
                  (String.=
                    (SessionTypedEntity.type
                      (Array.unsafe-nth (CellReport.forms &report) 0))
                    "Int")
                (Result.Error next-diagnostic)
                  (diagnostic-false &next-diagnostic)))))
    (Result.Error diagnostic) (diagnostic-false &diagnostic)))

(defn cell-errors-retain-submitted-source? []
  (match (make-session)
    (Result.Success session)
      (let-do [ok true
               parse-input (SourceInput.init (String.copy "cell:parse-error")
                                             (String.copy "("))
               resolve-input (SourceInput.init (String.copy "cell:resolve-error")
                                               (String.copy "(missing-name 1)"))
               infer-input (SourceInput.init (String.copy "cell:infer-error")
                                             (String.copy "(defn cell-bad [] (if 1 true false))"))]
        (match (Session.infer-cell &session &parse-input)
          (Result.Success _) (set! ok false)
          (Result.Error diagnostic)
            (unless (diagnostic-from? &diagnostic "parse" "cell:parse-error")
              (set! ok (diagnostic-false &diagnostic))))
        (match (Session.infer-cell &session &resolve-input)
          (Result.Success _) (set! ok false)
          (Result.Error diagnostic)
            (unless (diagnostic-from? &diagnostic "resolve" "cell:resolve-error")
              (set! ok (diagnostic-false &diagnostic))))
        (match (Session.infer-cell &session &infer-input)
          (Result.Success _) (set! ok false)
          (Result.Error diagnostic)
            (unless (diagnostic-from? &diagnostic "infer" "cell:infer-error")
              (set! ok (diagnostic-false &diagnostic))))
        ok)
    (Result.Error diagnostic) (diagnostic-false &diagnostic)))

(defn warm-expansion-queries-are-transactional? []
  (match (make-session)
    (Result.Success session)
      (let-do [ok true
               outer (SourceInput.init (String.copy "definition:outer-macro")
                                       (String.copy "(defmacro outer [] (parse \"(next)\"))"))]
        (match (Session.upsert &session &outer)
          (Result.Success _) ()
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (let [input (SourceInput.init (String.copy "cell:expand-step")
                                      (String.copy "(outer)"))]
          (match (Session.expand-1 &session &input)
            (Result.Success maybe-text)
              (match maybe-text
                (Maybe.Just text)
                  (unless (String.= &text "(next)") (set! ok false))
                (Maybe.Nothing) (set! ok false))
            (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic))))
        (let [input (SourceInput.init (String.copy "cell:expand-full")
                                      (String.copy "(outer)"))]
          (for [i 0 2]
            (match (Session.expand &session &input)
              (Result.Success maybe-text)
                (match maybe-text
                  (Maybe.Just text)
                    (unless (String.= &text "1") (set! ok false))
                  (Maybe.Nothing) (set! ok false))
              (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))))
        (let [plain (SourceInput.init (String.copy "cell:no-expansion")
                                      (String.copy "(warm-id 1)"))]
          (match (Session.expand-1 &session &plain)
            (Result.Success maybe-text)
              (match maybe-text
                (Maybe.Nothing) ()
                (Maybe.Just _) (set! ok false))
            (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic))))
        ok)
    (Result.Error diagnostic) (diagnostic-false &diagnostic)))

(defn completion-and-docs-track-session-lifecycle? []
  (match (make-session)
    (Result.Success session)
      (let-do [ok true
               first (SourceInput.init (String.copy "definition:noted:v1")
                                       (String.copy
                                         "(do (doc noted \"Notebook value v1.\") (defn noted [x] (warm-id x)))"))
               second (SourceInput.init (String.copy "definition:noted:v2")
                                        (String.copy
                                          "(do (doc noted \"Notebook value v2.\") (defn noted [x] (warm-id x)))"))]
        (match (Session.upsert &session &first)
          (Result.Success _) ()
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (let [candidates (Session.complete &session "not")]
          (unless (has-candidate? &candidates "noted" "function")
            (set! ok false)))
        (match (Session.doc &session "noted")
          (Maybe.Just info)
            (unless (and
                (String.= (DocInfo.documentation &info) "Notebook value v1.")
                (String.=
                  (SourceSpan.source-id (DocInfo.span &info))
                  "definition:noted:v1"))
              (set! ok false))
          (Maybe.Nothing) (set! ok false))
        (match (Session.upsert &session &second)
          (Result.Success _) ()
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (match (Session.doc &session "noted")
          (Maybe.Just info)
            (unless (and
                (String.= (DocInfo.documentation &info) "Notebook value v2.")
                (String.=
                  (SourceSpan.source-id (DocInfo.span &info))
                  "definition:noted:v2"))
              (set! ok false))
          (Maybe.Nothing) (set! ok false))
        (let [all (Session.complete &session "")]
          (unless (and
              (has-candidate? &all "warm-id" "function")
              (has-candidate? &all "next" "macro"))
            (set! ok false)))
        (match (Session.remove &session "noted")
          (Result.Success _) ()
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (when (has-candidate? &(Session.complete &session "noted")
                              "noted"
                              "function")
          (set! ok false))
        (match (Session.doc &session "noted")
          (Maybe.Nothing) ()
          (Maybe.Just _) (set! ok false))
        ok)
    (Result.Error diagnostic) (diagnostic-false &diagnostic)))

(defn completion-prefers-and-removes-session-shadow? []
  (match (make-session)
    (Result.Success session)
      (let-do [ok true
               shadow (SourceInput.init
                 (String.copy "definition:warm-id:shadow")
                 (String.copy "(defn warm-id [x] true)"))
               cell (SourceInput.init (String.copy "cell:warm-id:shadow")
                                      (String.copy "(warm-id 1)"))]
        (match (Session.upsert &session &shadow)
          (Result.Success _) ()
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (let [candidates (Session.complete &session "warm-id")]
          (unless (Int.= 1 (candidate-count &candidates "warm-id"))
            (set! ok false)))
        (match (Session.infer-cell &session &cell)
          (Result.Success report)
            (unless (String.=
                (SessionTypedEntity.type
                  (Array.unsafe-nth (CellReport.forms &report) 0))
                "Bool")
              (set! ok false))
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (match (Session.remove &session "warm-id")
          (Result.Success _) ()
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (let [candidates (Session.complete &session "warm-id")]
          (unless (Int.= 1 (candidate-count &candidates "warm-id"))
            (set! ok false)))
        (match (Session.infer-cell &session &cell)
          (Result.Success report)
            (unless (String.=
                (SessionTypedEntity.type
                  (Array.unsafe-nth (CellReport.forms &report) 0))
                "Int")
              (set! ok false))
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        ok)
    (Result.Error diagnostic) (diagnostic-false &diagnostic)))

(defn emit-cell-is-deterministic-and-non-mutating? []
  (match (make-session)
    (Result.Success session)
      (let-do [ok true
               definition (SourceInput.init (String.copy "definition:emit")
                                            (String.copy "(defn emitted-id [x] (warm-id x))"))
               cell (SourceInput.init (String.copy "cell:emit")
                                      (String.copy "(emitted-id 42)"))
               bad-cell (SourceInput.init (String.copy "cell:emit:error")
                                          (String.copy "(emitted-id missing)"))]
        (match (Session.upsert &session &definition)
          (Result.Success _) ()
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (let-do [overlay (Array.unsafe-nth (CompilerSession.overlay &session) 0)
                 allocator-before @(Array.unsafe-nth
                   (IdAllocator.cell (SessionOverlay.node-allocator overlay))
                   0)
                 definitions-before (Array.length (SessionOverlay.definitions overlay))]
          (match (Session.emit-cell &session &cell)
            (Result.Success first)
              (do
                (unless (String.contains-string? &first
                                                 "int main(int argc, char** argv)")
                  (set! ok false))
                (match (Session.emit-cell &session &cell)
                  (Result.Success second)
                    (unless (String.= &first &second) (set! ok false))
                  (Result.Error diagnostic)
                    (set! ok (diagnostic-false &diagnostic))))
            (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
          (match (Session.emit-cell &session &bad-cell)
            (Result.Success _) (set! ok false)
            (Result.Error diagnostic)
              (unless (diagnostic-from? &diagnostic "resolve" "cell:emit:error")
                (set! ok false)))
          (let [after (Array.unsafe-nth (CompilerSession.overlay &session) 0)]
            (unless (and
                (Int.= allocator-before
                       @(Array.unsafe-nth
                         (IdAllocator.cell (SessionOverlay.node-allocator after))
                         0))
                (Int.= definitions-before
                       (Array.length (SessionOverlay.definitions after))))
              (set! ok false))))
        ok)
    (Result.Error diagnostic) (diagnostic-false &diagnostic)))

(defn emit-library-omits-process-entry? []
  (match (make-session)
    (Result.Success session)
      (let [cell (SourceInput.init (String.copy "cell:library")
                                   (String.copy
                                     "(sig exported-id (Fn [Int] Int))
(defn exported-id [x] (warm-id x))"))]
        (match (Session.emit-library-with-build
                 &session
                 &cell
                 &[(String.copy "exported-id")]
                 &[(String.copy "/opt/example/include")]
                 &[(String.copy "/opt/example/libexample.so")])
          (Result.Success artifact)
            (let [c (LibraryArtifact.c &artifact)
                  ownership (LibraryArtifact.ownership &artifact)
                  includes (LibraryArtifact.include-directories &artifact)
                  links (LibraryArtifact.link-libraries &artifact)]
              (and (String.contains-string? c "exported")
                   (and (not (String.contains-string?
                               c
                               "int main(int argc, char** argv)"))
                        (and (Int.= 1 (Array.length ownership))
                             (and (String.= (OwnershipReport.name
                                              (Array.unsafe-nth ownership 0))
                                            "exported-id")
                                  (and (String.= (Array.unsafe-nth includes 0)
                                                "/opt/example/include")
                                       (String.= (Array.unsafe-nth links 0)
                                                 "/opt/example/libexample.so")))))))
          (Result.Error diagnostic) (diagnostic-false &diagnostic)))
    (Result.Error diagnostic) (diagnostic-false &diagnostic)))

(defn ownership-query-tracks-replacement-and-spans? []
  (match (make-session)
    (Result.Success session)
      (let-do [ok true
               owned (SourceInput.init
                 (String.copy "definition:ownership:owned")
                 (String.copy
                   "(defn owns-widget [] (let [widget (make-owned-widget)] ()))"))
               empty (SourceInput.init
                 (String.copy "definition:ownership:empty")
                 (String.copy "(defn owns-widget [] ())"))]
        (match (Session.upsert &session &owned)
          (Result.Success _) ()
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (match (Session.ownership &session "owns-widget")
          (Result.Success report)
            (if (Int.= 0 (Array.length (OwnershipReport.actions &report)))
              (set! ok false)
              (for [i 0 (Array.length (OwnershipReport.actions &report))]
                (match-ref (SpannedOwnershipAction.span
                    (Array.unsafe-nth (OwnershipReport.actions &report) i))
                  (Maybe.Just span)
                    (unless (String.= (SourceSpan.source-id span)
                                      "definition:ownership:owned")
                      (set! ok false))
                  (Maybe.Nothing) (set! ok false))))
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (match (Session.upsert &session &empty)
          (Result.Success _) ()
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (match (Session.ownership &session "owns-widget")
          (Result.Success report)
            (unless (Int.= 0 (Array.length (OwnershipReport.actions &report)))
              (set! ok false))
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (match (Session.remove &session "owns-widget")
          (Result.Success _) ()
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (match (Session.ownership &session "owns-widget")
          (Result.Success _) (set! ok false)
          (Result.Error diagnostic)
            (unless (String.= (Diagnostic.phase &diagnostic) "session")
              (set! ok false)))
        ok)
    (Result.Error diagnostic) (diagnostic-false &diagnostic)))

(defn definition-cell-has-structured-report? []
  (match (make-session)
    (Result.Success session)
      (let [input (SourceInput.init (String.copy "cell:def")
                                    (String.copy
                                      "(defn cell-value [x] (ignore (the String x)))"))]
        (match (Session.infer-cell &session &input)
          (Result.Success report)
            (and
              (Int.= 1 (Array.length (CellReport.forms &report)))
              (and
                (Int.= 1 (Array.length (CellReport.definitions &report)))
                (and
                  (Int.= 1 (Array.length (CellReport.locals &report)))
                  (let [definition (Array.unsafe-nth (CellReport.definitions &report)
                                                     0)
                        local (Array.unsafe-nth (CellReport.locals &report) 0)]
                    (and
                      (String.= (SessionDefInfo.name definition) "cell-value")
                      (and
                        (String.= (SessionDefInfo.scheme definition)
                                  "(Fn [String] Unit)")
                        (and
                          (match-ref (SessionTypedEntity.name local)
                            (Maybe.Just name) (String.= name "x")
                            (Maybe.Nothing) false)
                          (String.=
                            (SourceSpan.source-id (SessionDefInfo.span definition))
                            "cell:def"))))))))
          (Result.Error diagnostic) (diagnostic-false &diagnostic)))
    (Result.Error diagnostic) (diagnostic-false &diagnostic)))

(defn definition-named? [definitions name]
  (let-do [found false]
    (for [i 0 (Array.length definitions)]
      (when (String.=
          (SessionDefInfo.name (Array.unsafe-nth definitions i))
          name)
        (set! found true)))
    found))

(defn definition-source-id [definitions name]
  (let-do [id @""]
    (for [i 0 (Array.length definitions)]
      (let [definition (Array.unsafe-nth definitions i)]
        (when (String.= (SessionDefInfo.name definition) name)
          (set! id @(SourceInput.id (SessionDefInfo.source definition))))))
    id))

(defn forked-sessions-isolate-overlays? []
  (match (make-session)
    (Result.Success parent)
      (let-do [child (Session.fork &parent)
               parent-source (SourceInput.init
                               (String.copy "cell:parent-only")
                               (String.copy "(defn parent-only [] 1)"))
               child-source (SourceInput.init
                              (String.copy "cell:child-only")
                              (String.copy "(defn child-only [] 2)"))
               ok true]
        (match (Session.upsert &parent &parent-source)
          (Result.Success _) ()
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (match (Session.upsert &child &child-source)
          (Result.Success _) ()
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (let [parent-definitions (Session.definitions &parent)
              child-definitions (Session.definitions &child)]
          (unless (definition-named? &parent-definitions "parent-only")
            (set! ok false))
          (when (definition-named? &parent-definitions "child-only")
            (set! ok false))
          (unless (definition-named? &child-definitions "child-only")
            (set! ok false))
          (when (definition-named? &child-definitions "parent-only")
            (set! ok false)))
        ok)
    (Result.Error diagnostic) (diagnostic-false &diagnostic)))

(defn upsert-rejects-multiple-definitions? []
  (match (make-session)
    (Result.Success session)
      (let [input (SourceInput.init
                    (String.copy "cell:too-many")
                    (String.copy "(defn first-definition [] 1)\n(defn second-definition [] 2)"))]
        (match (Session.upsert &session &input)
          (Result.Success _) false
          (Result.Error diagnostic)
            (and (String.= (Diagnostic.phase &diagnostic) "session")
                 (and (String.=
                        (Diagnostic.message &diagnostic)
                        "upsert expects exactly one definition; use upsert-input for a complete source input")
                      (Int.= 0
                        (Array.length &(Session.definitions &session)))))))
    (Result.Error diagnostic) (diagnostic-false &diagnostic)))

(defn multi-definition-inputs-reconcile-by-id? []
  (match (make-session)
    (Result.Success session)
      (let-do [ok true
               file (SourceInput.init (String.copy "module.carp")
                                      (String.copy "(defn alpha [x] (warm-id x))
(defn beta [x] (alpha x))
(defn gamma [x] (beta x))"))]
        ;; one input, every definition it holds, each with its own provenance
        (match (Session.upsert-input &session &file)
          (Result.Success committed)
            (do
              (unless (Int.= 3 (Array.length &committed)) (set! ok false))
              (unless (and (definition-named? &committed "alpha")
                           (and (definition-named? &committed "beta")
                                (definition-named? &committed "gamma")))
                (set! ok false))
              (unless (String.=
                  &(definition-source-id &committed "beta")
                  "module.carp")
                (set! ok false))
              ;; distinct spans: each definition points at its own text
              (unless (Int./=
                  @(SourceSpan.start
                    (SessionDefInfo.span (Array.unsafe-nth &committed 0)))
                  @(SourceSpan.start
                    (SessionDefInfo.span (Array.unsafe-nth &committed 1))))
                (set! ok false)))
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        ;; re-upserting the same id replaces what that input contributed, so a
        ;; renamed definition leaves no ghost behind
        (let [renamed (SourceInput.init (String.copy "module.carp")
                                        (String.copy "(defn alpha [x] (warm-id x))
(defn delta [x] (alpha x))"))]
          (match (Session.upsert-input &session &renamed)
            (Result.Success committed)
              (do
                (unless (Int.= 2 (Array.length &committed)) (set! ok false))
                (let-do [definitions (Session.definitions &session)]
                  (when (definition-named? &definitions "beta") (set! ok false))
                  (when (definition-named? &definitions "gamma") (set! ok false))
                  (unless (definition-named? &definitions "delta")
                    (set! ok false))))
            (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic))))
        ;; and removing the input drops everything it contributed
        (match (Session.remove-input &session "module.carp")
          (Result.Success _)
            (let-do [definitions (Session.definitions &session)]
              (when (definition-named? &definitions "alpha") (set! ok false))
              (when (definition-named? &definitions "delta") (set! ok false)))
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        ok)
    (Result.Error diagnostic) (diagnostic-false &diagnostic)))

(defn committed-overlay-lifecycle-is-transactional? []
  (match (make-session)
    (Result.Success session)
      (let-do [ok true
               first (SourceInput.init (String.copy "definition:first")
                                       (String.copy "(defn first [x] (warm-id x))"))
               second (SourceInput.init (String.copy "definition:second")
                                        (String.copy "(defn second [x] (first x))"))
               unrelated (SourceInput.init (String.copy "definition:unrelated")
                                           (String.copy "(defn unrelated [x] (warm-id x))"))]
        (match (Session.upsert &session &first)
          (Result.Success report)
            (unless (String.=
                (SessionDefInfo.name (UpsertReport.definition &report))
                "first")
              (set! ok false))
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (match (Session.upsert &session &second)
          (Result.Success _) ()
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (match (Session.upsert &session &unrelated)
          (Result.Success _) ()
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (let [replacement (SourceInput.init (String.copy "definition:first:v2")
                                            (String.copy "(defn first [x] x)"))]
          (match (Session.upsert &session &replacement)
            (Result.Success report)
              (let [invalidated (UpsertReport.invalidated &report)]
                (unless (and (Int.= 1 (Array.length invalidated))
                             (String.= (Array.unsafe-nth invalidated 0) "second"))
                  (set! ok false)))
            (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic))))
        (let [bad (SourceInput.init (String.copy "definition:first:bad")
                                    (String.copy "(defn first [x] (if 1 x x))"))]
          (match (Session.upsert &session &bad)
            (Result.Success _) (set! ok false)
            (Result.Error diagnostic)
              (unless (String.= (Diagnostic.phase &diagnostic) "infer")
                (set! ok false))))
        (unless (Int.= 3 (Array.length &(Session.definitions &session)))
          (set! ok false))
        (let [cell (SourceInput.init (String.copy "cell:committed")
                                     (String.copy "(second 9)"))]
          (match (Session.infer-cell &session &cell)
            (Result.Success report)
              (unless (String.=
                  (SessionTypedEntity.type
                    (Array.unsafe-nth (CellReport.forms &report) 0))
                  "Int")
                (set! ok false))
            (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic))))
        (match (Session.remove &session "first")
          (Result.Success report)
            (unless (and
                (Int.= 1 (Array.length (RemoveReport.invalidated &report)))
                (String.=
                  (Array.unsafe-nth (RemoveReport.invalidated &report) 0)
                  "second"))
              (set! ok false))
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (unless (Int.= 1 (Array.length &(Session.definitions &session)))
          (set! ok false))
        (let [cell (SourceInput.init (String.copy "cell:unrelated")
                                     (String.copy "(unrelated 9)"))]
          (match (Session.infer-cell &session &cell)
            (Result.Success _) ()
            (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic))))
        (match (Session.remove &session "missing")
          (Result.Success _) (set! ok false)
          (Result.Error diagnostic)
            (unless (String.= (Diagnostic.phase &diagnostic) "session")
              (set! ok false)))
        (match (Session.upsert &session &first)
          (Result.Success _) ()
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (Session.reset &session)
        (unless (Int.= 0 (Array.length &(Session.definitions &session)))
          (set! ok false))
        ok)
    (Result.Error diagnostic) (diagnostic-false &diagnostic)))

(defn compatible-replacements-reuse-global-identities? []
  (match (make-session)
    (Result.Success session)
      (let-do [ok true
               first (SourceInput.init (String.copy "definition:stable")
                                       (String.copy "(defn stable [x] (warm-id x))"))
               dependent (SourceInput.init (String.copy "definition:stable-user")
                                           (String.copy "(defn stable-user [x] (stable x))"))]
        (match (Session.upsert &session &first)
          (Result.Success _) ()
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (match (Session.upsert &session &dependent)
          (Result.Success _) ()
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (let-do [first-id (session-reference-id &session "stable")
                 dependent-id (session-reference-id &session "stable-user")
                 replacement (SourceInput.init (String.copy "definition:stable:v2")
                                               (String.copy "(defn stable [x] x)"))]
          (match (Session.upsert &session &replacement)
            (Result.Success _) ()
            (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
          (unless (and
              (Maybe.= &first-id &(session-reference-id &session "stable"))
              (Maybe.= &dependent-id
                       &(session-reference-id &session "stable-user")))
            (set! ok false)))
        ok)
    (Result.Error diagnostic) (diagnostic-false &diagnostic)))

(defn committed-macros-are-transactional? []
  (match (make-session)
    (Result.Success session)
      (let-do [ok true
               macro (SourceInput.init (String.copy "definition:macro")
                                       (String.copy "(defmacro cell-id [x] x)"))
               consumer (SourceInput.init
                 (String.copy "definition:macro-consumer")
                 (String.copy "(defn via-macro [x] (cell-id x))"))]
        (match (Session.upsert &session &macro)
          (Result.Success report)
            (unless (String.=
                (SessionDefInfo.scheme (UpsertReport.definition &report))
                "macro")
              (set! ok false))
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (match (Session.upsert &session &consumer)
          (Result.Success _) ()
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (let [replacement (SourceInput.init (String.copy "definition:macro:v2")
                                            (String.copy "(defmacro cell-id [value] value)"))]
          (match (Session.upsert &session &replacement)
            (Result.Success report)
              (unless (and
                  (Int.= 1 (Array.length (UpsertReport.invalidated &report)))
                  (String.=
                    (Array.unsafe-nth (UpsertReport.invalidated &report) 0)
                    "via-macro"))
                (set! ok false))
            (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic))))
        (let [cell (SourceInput.init (String.copy "cell:macro")
                                     (String.copy "(via-macro 9)"))]
          (match (Session.infer-cell &session &cell)
            (Result.Success _) ()
            (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic))))
        (let [bad (SourceInput.init (String.copy "definition:macro:bad")
                                    (String.copy "(defmacro cell-id [])"))]
          (match (Session.upsert &session &bad)
            (Result.Success _) (set! ok false)
            (Result.Error _) ()))
        (unless (Int.= 2 (Array.length &(Session.definitions &session)))
          (set! ok false))
        (match (Session.remove &session "cell-id")
          (Result.Success report)
            (unless (and
                (Int.= 1 (Array.length (RemoveReport.invalidated &report)))
                (String.=
                  (Array.unsafe-nth (RemoveReport.invalidated &report) 0)
                  "via-macro"))
              (set! ok false))
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (unless (Int.= 0 (Array.length &(Session.definitions &session)))
          (set! ok false))
        ok)
    (Result.Error diagnostic) (diagnostic-false &diagnostic)))

(defn macro-generated-errors-anchor-to-invocations? []
  (match (make-session)
    (Result.Success session)
      (let [macro (SourceInput.init (String.copy "definition:bad-expansion")
                                    (String.copy
                                      "(defmacro ill-typed [] (parse \"missing-name\"))"))]
        (match (Session.upsert &session &macro)
          (Result.Success _)
            (let [cell (SourceInput.init (String.copy "cell:bad-expansion")
                                         (String.copy "(ill-typed)"))]
              (match (Session.infer-cell &session &cell)
                (Result.Success _) false
                (Result.Error diagnostic)
                  (and
                    (String.= (Diagnostic.phase &diagnostic) "resolve")
                    (match-ref (Diagnostic.span &diagnostic)
                      (Maybe.Just span)
                        (and
                          (String.= (SourceSpan.source-id span)
                                    "cell:bad-expansion")
                          (and (Int.= @(SourceSpan.start span) 0)
                               (Int.= @(SourceSpan.end span) 11)))
                      (Maybe.Nothing) false))))
          (Result.Error diagnostic) (diagnostic-false &diagnostic)))
    (Result.Error diagnostic) (diagnostic-false &diagnostic)))

(defn macro-evaluation-errors-anchor-to-invocations? []
  (match (make-session)
    (Result.Success session)
      (let [macro (SourceInput.init
              (String.copy "definition:broken-template")
              (String.copy "(defmacro broken-template [] `(if 1 true false))"))]
        (match (Session.upsert &session &macro)
          (Result.Success _)
            (let [cell (SourceInput.init (String.copy "cell:broken-template")
                                         (String.copy "(broken-template)"))]
              (match (Session.infer-cell &session &cell)
                (Result.Success _) false
                (Result.Error diagnostic)
                  (and
                    (String.= (Diagnostic.phase &diagnostic) "expand")
                    (match-ref (Diagnostic.span &diagnostic)
                      (Maybe.Just span)
                        (and
                          (String.= (SourceSpan.source-id span)
                                    "cell:broken-template")
                          (and (Int.= @(SourceSpan.start span) 0)
                               (Int.= @(SourceSpan.end span) 17)))
                      (Maybe.Nothing) false))))
          (Result.Error diagnostic) (diagnostic-false &diagnostic)))
    (Result.Error diagnostic) (diagnostic-false &diagnostic)))

(defn committed-types-expose-derived-bindings? []
  (match (make-session)
    (Result.Success session)
      (let-do [ok true
               type-source (SourceInput.init (String.copy "definition:type")
                                             (String.copy "(deftype CellBox [value Int])"))
               consumer (SourceInput.init (String.copy "definition:type-consumer")
                                          (String.copy
                                            "(defn make-cell-box [x] (CellBox.init x))"))]
        (match (Session.upsert &session &type-source)
          (Result.Success report)
            (unless (and
                (String.=
                  (SessionDefInfo.name (UpsertReport.definition &report))
                  "CellBox")
                (String.=
                  (SessionDefInfo.scheme (UpsertReport.definition &report))
                  "type"))
              (set! ok false))
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (let [candidates (Session.complete &session "CellBox")]
          (unless (and
              (has-candidate? &candidates "CellBox" "type")
              (has-candidate? &candidates "CellBox.init" "constructor"))
            (set! ok false)))
        (match (Session.upsert &session &consumer)
          (Result.Success _) ()
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (let [cell (SourceInput.init (String.copy "cell:type")
                                     (String.copy "(make-cell-box 9)"))]
          (match (Session.infer-cell &session &cell)
            (Result.Success _) ()
            (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic))))
        (let [replacement (SourceInput.init (String.copy "definition:type:v2")
                                            (String.copy "(deftype CellBox [value Bool])"))]
          (match (Session.upsert &session &replacement)
            (Result.Success report)
              (unless (and
                  (Int.= 1 (Array.length (UpsertReport.invalidated &report)))
                  (String.=
                    (Array.unsafe-nth (UpsertReport.invalidated &report) 0)
                    "make-cell-box"))
                (set! ok false))
            (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic))))
        (match (Session.remove &session "CellBox")
          (Result.Success report)
            (unless (and
                (Int.= 1 (Array.length (RemoveReport.invalidated &report)))
                (String.=
                  (Array.unsafe-nth (RemoveReport.invalidated &report) 0)
                  "make-cell-box"))
              (set! ok false))
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (unless (Int.= 0 (Array.length &(Session.definitions &session)))
          (set! ok false))
        ok)
    (Result.Error diagnostic) (diagnostic-false &diagnostic)))

(defn committed-interfaces-retain-dispatch? []
  (match (make-session)
    (Result.Success session)
      (let-do [ok true
               initial-implementation-count (Array.length
                 (Rc.value-ref
                   (SessionOverlay.implementations
                     (Array.unsafe-nth (CompilerSession.overlay &session) 0))))
               interface-source (SourceInput.init (String.copy "definition:interface")
                                                  (String.copy "(definterface choose (Fn [a a] a))"))
               function-source (SourceInput.init
                 (String.copy "definition:implementation-function")
                 (String.copy "(defn choose-left [x y] (the Int x))"))
               implementation-source (SourceInput.init
                 (String.copy "definition:implementation")
                 (String.copy "(implements choose choose-left)"))
               bool-function-source (SourceInput.init
                 (String.copy "definition:bool-implementation-function")
                 (String.copy "(defn choose-bool [x y] (the Bool x))"))
               bool-implementation-source (SourceInput.init
                 (String.copy "definition:bool-implementation")
                 (String.copy "(implements choose choose-bool)"))]
        (match (Session.upsert &session &interface-source)
          (Result.Success report)
            (unless (match-ref (SessionDefInfo.kind (UpsertReport.definition &report))
                (SessionDefKind.Interface) true
                _ false)
              (set! ok false))
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (match (Session.upsert &session &function-source)
          (Result.Success _) ()
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (match (Session.upsert &session &implementation-source)
          (Result.Success report)
            (unless (and
                (String.=
                  (SessionDefInfo.name (UpsertReport.definition &report))
                  "choose -> choose-left")
                (match-ref (SessionDefInfo.kind (UpsertReport.definition &report))
                  (SessionDefKind.Other label) (String.= label "implementation")
                  _ false))
              (set! ok false))
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (match (Session.upsert &session &bool-function-source)
          (Result.Success _) ()
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (match (Session.upsert &session &bool-implementation-source)
          (Result.Success _) ()
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (unless (and
            (Int.= (Int.+ initial-implementation-count 2)
                   (Array.length
                     (Rc.value-ref
                       (SessionOverlay.implementations
                         (Array.unsafe-nth (CompilerSession.overlay &session) 0)))))
            (session-dispatch-pair? &session "choose" "choose-left"))
          (set! ok false))
        (unless (session-dispatch-pair? &session "choose" "choose-bool")
          (set! ok false))
        (let [candidates (Session.complete &session "choose")]
          (unless (and
              (has-candidate? &candidates "choose" "interface")
              (and
                (has-candidate? &candidates "choose-left" "function")
                (and
                  (has-candidate? &candidates
                                  "choose -> choose-left"
                                  "implementation")
                  (and
                    (has-candidate? &candidates "choose-bool" "function")
                    (has-candidate? &candidates
                                    "choose -> choose-bool"
                                    "implementation")))))
            (set! ok false)))
        (let [cell (SourceInput.init (String.copy "cell:interface")
                                     (String.copy "(choose 1 2)"))]
          (match (Session.infer-cell &session &cell)
            (Result.Success report)
              (unless (String.=
                  (SessionTypedEntity.type
                    (Array.unsafe-nth (CellReport.forms &report) 0))
                  "Int")
                (set! ok false))
            (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic))))
        (let [cell (SourceInput.init (String.copy "cell:bool-interface")
                                     (String.copy "(choose true false)"))]
          (match (Session.infer-cell &session &cell)
            (Result.Success report)
              (unless (String.=
                  (SessionTypedEntity.type
                    (Array.unsafe-nth (CellReport.forms &report) 0))
                  "Bool")
                (set! ok false))
            (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic))))
        (match (Session.remove &session "choose")
          (Result.Success report)
            (unless (and
                (Int.= 4 (Array.length (RemoveReport.invalidated &report)))
                (and
                  (has-string? (RemoveReport.invalidated &report) "choose-left")
                  (and
                    (has-string? (RemoveReport.invalidated &report)
                                 "choose -> choose-left")
                    (and
                      (has-string? (RemoveReport.invalidated &report)
                                   "choose-bool")
                      (has-string? (RemoveReport.invalidated &report)
                                   "choose -> choose-bool")))))
              (set! ok false))
          (Result.Error diagnostic) (set! ok (diagnostic-false &diagnostic)))
        (unless (Int.= 0 (Array.length &(Session.definitions &session)))
          (set! ok false))
        (unless (Int.= initial-implementation-count
                       (Array.length
                         (Rc.value-ref
                           (SessionOverlay.implementations
                             (Array.unsafe-nth (CompilerSession.overlay &session)
                                               0)))))
          (set! ok false))
        ok)
    (Result.Error diagnostic) (diagnostic-false &diagnostic)))

(deftest t
  (assert-equal t 4 (Session.api-version) "session API version is explicit")
  (assert-true t
    (forked-sessions-isolate-overlays?)
    "forked sessions share the warm base and isolate committed overlays")
  (assert-true t
    (upsert-rejects-multiple-definitions?)
    "upsert rejects ambiguous multi-definition inputs without mutation")
  (assert-true t
    (definition-cell-has-structured-report?)
    "definition cells report their name, scheme, kind, and caller span")
  (assert-true t
    (warm-cells-are-transactional-and-spanned?)
    "warm cells reuse the base, discard effects, and report caller spans")
  (assert-true t
    (failed-cell-does-not-poison-session?)
    "a failed cell leaves the warm session usable")
  (assert-true t
    (cell-errors-retain-submitted-source?)
    "parse, resolve, and infer diagnostics retain the submitted source ID")
  (assert-true t
    (warm-expansion-queries-are-transactional?)
    "full and one-step expansion share warm macros without committing effects")
  (assert-true t
    (completion-and-docs-track-session-lifecycle?)
    "completion and structured docs track replacement and removal")
  (assert-true t
    (completion-prefers-and-removes-session-shadow?)
    "completion deterministically prefers a session shadow over its base name")
  (assert-true t
    (emit-cell-is-deterministic-and-non-mutating?)
    "cell emission is deterministic and leaves committed session state untouched")
  (assert-true t
    (emit-library-omits-process-entry?)
    "library cell emission retains compiled roots but omits the process entry")
  (assert-true t
    (ownership-query-tracks-replacement-and-spans?)
    "ownership queries track replacement and return caller-relative spans")
  (assert-true t
    (committed-overlay-lifecycle-is-transactional?)
    "upsert, replacement, rollback, removal, and reset are transactional")
  (assert-true t
    (compatible-replacements-reuse-global-identities?)
    "compatible replacements retain global identities across rebuilds")
  (assert-true t
    (committed-macros-are-transactional?)
    "committed macros expand later definitions and remain transactional")
  (assert-true t
    (macro-generated-errors-anchor-to-invocations?)
    "macro-generated syntax errors anchor to the invocation span")
  (assert-true t
    (macro-evaluation-errors-anchor-to-invocations?)
    "macro evaluation errors anchor to the invocation span")
  (assert-true t
    (committed-types-expose-derived-bindings?)
    "committed types expose derived bindings and invalidate consumers")
  (assert-true t
    (committed-interfaces-retain-dispatch?)
    "committed interfaces and implementations retain dispatch state")
  (assert-true t
    (multi-definition-inputs-reconcile-by-id?)
    "a whole input commits every definition it holds and reconciles by id"))
