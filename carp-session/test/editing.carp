(load "../carp-editing.carp")
(load "Test.carp")
(Project.no-echo)
(when (= (host-os) "darwin") (add-cflag "-Wl,-stack_size,0x20000000"))
(use-all Test)

(defn core-dir []
  (match (IO.getenv "CARP_DIR")
    (Maybe.Just root)
      (if (or (String.ends-with? &root "/core")
              (String.ends-with? &root "/core/"))
        root
        (String.append &root (if (String.ends-with? &root "/") "core" "/core")))
    (Maybe.Nothing) @"../../../carp/core"))

(defn model [session source]
  (let-do [input (SourceInput.init @"editing:test" (String.copy source))
           editing (Surface.editing-input &input)
           saved (CtEval.checkpoint)
           _budget (WorkBudget.begin! 200000 true (fn [] false))
           result (SessionEditing.analyze session &editing &[] "result")
           _done (WorkBudget.end!)]
    (CtEval.restore! saved)
    result))

(defn local-types [model name]
  (let-do [bindings (ResolutionObservations.bindings (EditingModel.observations model))
           types (the (Array String) [])]
    (for [i 0 (Array.length bindings)]
      (let [reference (ResolvedSourceBinding.reference (Array.unsafe-nth bindings
                                                                         i))]
        (when (and (not @(CoreRef.global reference))
                   (String.= (CoreRef.name reference) name))
          (match (SessionEditing.type-of model reference)
            (Maybe.Just text) (Array.push-back! &types text)
            (Maybe.Nothing) ()))))
    types))

(deftest test
  (assert-true test
    (match (Session.create &(core-dir))
      (Result.Error diagnostic)
        (do (IO.errorln (Diagnostic.message &diagnostic)) false)
      (Result.Success session)
        (let [typed (model &session "(let [x 1] (let [x true] x))")
              broken (model &session "(let [x 1] missing)")
              types (local-types &typed "x")]
          (and @(EditingModel.complete &typed)
               (and (not @(EditingModel.complete &broken))
                    (and (Array.contains? &types &@"Int")
                         (Array.contains? &types &@"Bool"))))))
    "compiler inference distinguishes shadowed bindings and reports failed resolution as partial")
  (assert-true test
    (metadata-cell-contract)
    "metadata cells preserve the single-form contract without creating values"))

(defn metadata-cell-contract []
  (match (Session.create &(core-dir))
    (Result.Error _) false
    (Result.Success session)
      (let [metadata (SourceInput.init @"metadata:one" @"(doc Future \"kept\")")
            multiple (SourceInput.init @"metadata:many" @"(def x 1) (def y 2)")]
        (and
          (Result.success? &(Session.upsert-cell &session &metadata))
          (and
            (Result.error? &(Session.upsert-cell &session &multiple))
            (and
              (Array.empty? &(Session.definitions &session))
              (Result.error? &(Session.upsert &session &metadata))))))))
