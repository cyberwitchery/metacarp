(load "../carp-session.carp")
(Project.no-echo)
(load "Test.carp")

(use-all Test)

(defn core-dir []
  (match (IO.getenv "CARP_DIR")
    (Maybe.Just root)
      (if (or (String.ends-with? &root "/core")
              (String.ends-with? &root "/core/"))
        root
        (String.append &root (if (String.ends-with? &root "/") "core" "/core")))
    (Maybe.Nothing) (String.copy "../../../carp/Carp/core")))

(defn creates-real-core-session? []
  (let [dir (core-dir)]
    (match (Session.create &dir)
      (Result.Success session)
        (let [cell (SourceInput.init (String.copy "cell:core-smoke")
                                     (String.copy "(Int.+ 1 2)"))]
          (match (Session.infer-cell &session &cell)
            (Result.Success report)
              (and
                (Int.= 1 (Array.length (CellReport.forms &report)))
                (String.=
                  (SessionTypedEntity.type
                    (Array.unsafe-nth (CellReport.forms &report) 0))
                  "Int"))
            (Result.Error diagnostic)
              (do
                (IO.println
                  &(String.concat
                    &[(String.copy (Diagnostic.phase &diagnostic))
                      @": "
                      (String.copy (Diagnostic.message &diagnostic))]))
                false)))
      (Result.Error diagnostic)
        (do
          (IO.println
            &(String.concat
              &[(String.copy (Diagnostic.phase &diagnostic))
                @": "
                (String.copy (Diagnostic.message &diagnostic))]))
          false))))

(deftest t
  (assert-true t
    (creates-real-core-session?)
    "Session.create loads core once and checks a cell against it"))
