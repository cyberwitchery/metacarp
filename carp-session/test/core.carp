(load "../carp-session.carp")
(Project.no-echo)
(load "Test.carp")

(use-all Test)

(defn core-dir []
  (match (IO.getenv "CARP_DIR")
    (Maybe.Just root)
      (if (or (String.ends-with? &root "/core")
              (String.ends-with? &root "/core/"))
        root
        (String.append &root (if (String.ends-with? &root "/") "core" "/core")))
    (Maybe.Nothing) (String.copy "../../../carp/Carp/core")))

(defn creates-real-core-session? []
  (let [dir (core-dir)]
    (match (Session.create &dir)
      (Result.Success session)
        (let [cell (SourceInput.init (String.copy "cell:core-smoke")
                                     (String.copy "(Int.+ 1 2)"))]
          (match (Session.infer-cell &session &cell)
            (Result.Success report)
              (and
                (and
                  (Int.= 1 (Array.length (CellReport.forms &report)))
                  (String.=
                    (SessionTypedEntity.type
                      (Array.unsafe-nth (CellReport.forms &report) 0))
                    "Int"))
                (match (Session.emit-cell &session &cell)
                  (Result.Success c)
                    (String.contains-string? &c
                                             "int main(int argc, char** argv)")
                  (Result.Error diagnostic)
                    (do
                      (IO.println
                        &(String.concat
                          &[(String.copy (Diagnostic.phase &diagnostic))
                            @": "
                            (String.copy (Diagnostic.message &diagnostic))]))
                      false)))
            (Result.Error diagnostic)
              (do
                (IO.println
                  &(String.concat
                    &[(String.copy (Diagnostic.phase &diagnostic))
                      @": "
                      (String.copy (Diagnostic.message &diagnostic))]))
                false)))
      (Result.Error diagnostic)
        (do
          (IO.println
            &(String.concat
              &[(String.copy (Diagnostic.phase &diagnostic))
                @": "
                (String.copy (Diagnostic.message &diagnostic))]))
          false))))

(defn emits-after-committed-empty-map? []
  (let [dir (core-dir)]
    (match (Session.create &dir)
      (Result.Success session)
        (let [definition (SourceInput.init (String.copy "definition:memo")
                                           (String.copy "(def memo (the (Map String Int) {}))"))]
          (match (Session.upsert &session &definition)
            (Result.Success _)
              (let [cell (SourceInput.init (String.copy "cell:map-emission")
                                           (String.copy "(+ 1 2)"))]
                (match (Session.emit-cell &session &cell)
                  (Result.Success c)
                    (String.contains-string? &c
                                             "int main(int argc, char** argv)")
                  (Result.Error diagnostic)
                    (do
                      (IO.println
                        &(String.concat
                          &[(String.copy (Diagnostic.phase &diagnostic))
                            @": "
                            (String.copy (Diagnostic.message &diagnostic))]))
                      false)))
            (Result.Error diagnostic)
              (do
                (IO.println
                  &(String.concat
                    &[(String.copy (Diagnostic.phase &diagnostic))
                      @": "
                      (String.copy (Diagnostic.message &diagnostic))]))
                false)))
      (Result.Error diagnostic)
        (do
          (IO.println
            &(String.concat
              &[(String.copy (Diagnostic.phase &diagnostic))
                @": "
                (String.copy (Diagnostic.message &diagnostic))]))
          false))))

(doc copies-shared-closure-captures?
  "checks that two closures capturing one owned array receive independent
copied environments.")
(defn copies-shared-closure-captures? []
  (let [dir (core-dir)]
    (match (Session.create &dir)
      (Result.Success session)
        (let [cell (SourceInput.init (String.copy "cell:shared-capture")
                                     (String.copy
                                       "(deftype Two [a (Fn [Int] String) b (Fn [Int] String)])
(defn probe []
  (let [items [10 20 30]
        t (Two.init (fn [i] (str (Array.unsafe-nth &items i)))
                    (fn [i] (str (Array.unsafe-nth &items i))))]
    (~(Two.a &t) 1)))
(probe)"))]
          (match (Session.emit-cell &session &cell)
            (Result.Success c)
              (and
                (String.contains-string? &c ".f0 = C14_Array_x46_copy")
                (not (String.contains-string? &c ".f0 = items }")))
            (Result.Error diagnostic)
              (do
                (IO.println
                  &(String.concat
                    &[(String.copy (Diagnostic.phase &diagnostic))
                      @": "
                      (String.copy (Diagnostic.message &diagnostic))]))
                false)))
      (Result.Error diagnostic)
        (do
          (IO.println
            &(String.concat
              &[(String.copy (Diagnostic.phase &diagnostic))
                @": "
                (String.copy (Diagnostic.message &diagnostic))]))
          false))))

(doc echoes-a-derived-value?
  "checks top-level echoing of a derived value through its by-reference `str`
implementation.")
(defn echoes-a-derived-value? []
  (let [dir (core-dir)]
    (match (Session.create &dir)
      (Result.Success session)
        (let [cell (SourceInput.init (String.copy "cell:echo")
                                     (String.copy "(deftype Point [x Int])
(Point.init 3)"))]
          (match (Session.emit-cell &session &cell)
            (Result.Success c)
              (and
                (String.contains-string? &c "String echo = C13_Point_x46_str")
                (String.contains-string? &c "IO_println((&echo))"))
            (Result.Error diagnostic)
              (do
                (IO.println
                  &(String.concat
                    &[(String.copy (Diagnostic.phase &diagnostic))
                      @": "
                      (String.copy (Diagnostic.message &diagnostic))]))
                false)))
      (Result.Error diagnostic)
        (do
          (IO.println
            &(String.concat
              &[(String.copy (Diagnostic.phase &diagnostic))
                @": "
                (String.copy (Diagnostic.message &diagnostic))]))
          false))))

(deftest t
  (assert-true t
    (creates-real-core-session?)
    "Session.create loads core once and checks a cell against it")
  (assert-true t
    (echoes-a-derived-value?)
    "Session.emit-cell echoes a cell's result through the str the driver picks")
  (assert-true t
    (emits-after-committed-empty-map?)
    "Session.emit-cell specializes Core calls reached through committed values")
  (assert-true t
    (copies-shared-closure-captures?)
    "a closure environment owns its captures rather than aliasing them"))
