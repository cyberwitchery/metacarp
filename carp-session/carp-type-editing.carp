(load "carp-editing.carp")

(defmodule Session
  (doc type-heads "returns the type constructors of the session's base and
overlay.")
  (defn type-heads [session]
    (let [overlay (Array.unsafe-nth (CompilerSession.overlay session) 0)
          core (CoreIR.append-modules (CompilerSession.base-core session)
                                      (SessionOverlay.core overlay))]
      (TypeCatalogue.module &core)))

  (doc type-documentation "returns the documentation of `name` from its `doc`
forms, if it has any.")
  (defn type-documentation [session name]
    (let [overlay (Array.unsafe-nth (CompilerSession.overlay session) 0)
          documents (completion-documents session overlay)]
      (documentation-for &documents name))))

(defmodule Resolve
  (doc query-type "resolves the type name `name` in `scope`, at the type
generation live there. Type and value names are separate.")
  (sig query-type
       (Fn
         [(Ref ResolutionObservations) (Ref ResolvedSourceScope) (Ref String)]
         (Result CoreType ResolveError)))
  (defn query-type [observations scope name]
    (let-do [saved (Array.copy &*type-redefinitions*)
             stamp *resolve-stamp*
             _generations (set! *type-redefinitions*
                                @(ResolveEditingEnvironment.generations
                                  (ResolutionObservations.environment observations)))
             _stamp (set! *resolve-stamp* @(ResolvedSourceScope.stamp scope))
             node (SurfaceNode.generated (SurfaceSpan.anywhere)
                                         (SurfaceForm.Symbol [(String.copy name)]))
             result (resolve-type-name &node name)
             _restore (set! *type-redefinitions* saved)
             _site (set! *resolve-stamp* stamp)]
      result)))

(defmodule Resolve
  (doc type-spelling "returns how the type `canonical` is written in `scope`:
the plain name of a redefined type if it is the generation live there. A
generation that is not live there gives `Nothing`.")
  (defn type-spelling [observations scope canonical]
    (let-do [generations (ResolveEditingEnvironment.generations
               (ResolutionObservations.environment observations))
             answer (Maybe.Just @canonical)]
      (for [i 0 (Array.length generations)]
        (let [entry (Array.unsafe-nth generations i)
              name (Pair.a entry)
              stamps (Pair.b entry)]
          (for [j 1 (Int.inc (Array.length stamps))]
            (let [identity (if (Int.= j (Array.length stamps))
                    @name
                    (generation-suffixed name j))]
              (when (String.= canonical &identity)
                (set! answer
                      (match (query-type observations scope name)
                        (Result.Success resolved)
                          (if (String.= canonical
                                        &(TypeCatalogue.name &resolved))
                            (Maybe.Just @name)
                            (Maybe.Nothing))
                        (Result.Error _) (Maybe.Nothing))))))))
      answer)))
