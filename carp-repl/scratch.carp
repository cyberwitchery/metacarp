(load "native.carp")
(system-include "fts.h")
(system-include "sys/stat.h")
(register-type ReplScratchWalk "FTS")
(register-type ReplScratchEntry "FTSENT" [fts_path (Ptr CChar)])
(defmodule ReplScratchNative
  (register open
    (Fn [(Ptr (Ptr CChar)) Int (Ptr ())] (Ptr ReplScratchWalk))
    "fts_open")
  (register read (Fn [(Ptr ReplScratchWalk)] (Ptr ReplScratchEntry)) "fts_read")
  (register close (Fn [(Ptr ReplScratchWalk)] Int) "fts_close")
  (register PHYSICAL Int "FTS_PHYSICAL")
  (register NO-CHDIR Int "FTS_NOCHDIR")
  (register mkdir (Fn [(Ptr CChar) Int] Int) "mkdir")
  (register rmdir (Fn [(Ptr CChar)] Int) "rmdir"))

(defmodule ReplScratch
  (defn- compiler-file? [relative]
    (cond
      (and
        (String.starts-with? relative "carp-jit-shim-")
        (Int.< (String.index-of relative \/) 0))
        (or (String.ends-with? relative ".c") (String.ends-with? relative ".ll"))
      (String.starts-with? relative "carp-layout-")
        (let [slash (String.index-of relative \/)]
          (and (Int.>= slash 0)
               (let [tail (String.byte-slice relative
                                             slash
                                             (String.length relative))]
                 (or (String.= &tail "/probe.c") (String.= &tail "/probe.ll")))))
      false))

  (doc clean "removes only compiler artifacts in one owned worker directory.
The physical traversal never follows symlinks and never changes the host cwd.
Unknown files keep their directory alive rather than being removed recursively.")
  (defn clean [directory]
    (let-do [paths [(String.cstr directory)
                    (the (Ptr CChar) (Pointer.from-long 0l))]
             walk (ReplScratchNative.open
               (Pointer.address (Array.unsafe-nth &paths 0))
               (Int.bit-or ReplScratchNative.PHYSICAL ReplScratchNative.NO-CHDIR)
               (Pointer.from-long 0l))]
      (unless-do (null? walk)
        (let-do [entry (ReplScratchNative.read walk)
                 prefix (String.append directory "/")]
          (while-do (not (null? entry))
            (let [path (String.from-cstr
                    @(ReplScratchEntry.fts_path (Pointer.to-ref entry)))]
              (when (String.starts-with? &path &prefix)
                (let [relative (String.byte-slice &path
                                                  (String.length &prefix)
                                                  (String.length &path))]
                  (cond
                    (compiler-file? &relative) (IO.Raw.unlink! &path)
                    (and
                      (String.starts-with? &relative "carp-layout-")
                      (Int.< (String.index-of &relative \/) 0))
                      (ignore (ReplScratchNative.rmdir (String.cstr &path)))
                    ()))))
            (set! entry (ReplScratchNative.read walk))))
        (ignore (ReplScratchNative.close walk)))
      (ignore (ReplScratchNative.rmdir (String.cstr directory))))))
