(load "../carp-source/carp-source.carp")
(load "journal.carp")
(load "wire-macros.carp")

(wire-record SourceInput)
(wire-record SourceSpan)
(wire-record Diagnostic)
(wire-record ReplEntry)

; A source checkpoint has no compiler graphs, ORC ownership, live results, or
; native addresses. Projected inputs rebuild declarations and discard runtime
; roots, including when a macro originally produced both.
(defwire ReplCheckpoint
         [inputs
          (Array SourceInput)
          projected
          (Array String)
          serial
          Int
          next-result
          Int
          entries
          (Array ReplEntry)
          events
          (Array ReplEntry)
          editing
          Int
          last-input
          String
          generation
          Int
          definitions
          String])

(defmodule ReplCheckpoints
  (defn accepted? [inputs input]
    (let-do [accepted false]
      (for [i 0 (Array.length inputs)]
        (let [current (Array.unsafe-nth inputs i)]
          (when (and
              (String.= (SourceInput.id current) (SourceInput.id input))
              (String.= (SourceInput.source current) (SourceInput.source input)))
            (set! accepted true))))
      accepted))
  (defn empty [] (ReplCheckpoint.init [] [] 1 1 [] [] 0 @"" 0 @""))

  (defn source [checkpoint transcript]
    (if transcript
      (ReplJournal.transcript (ReplCheckpoint.events checkpoint))
      (let-do [parts (the (Array String) [])
               inputs (ReplCheckpoint.inputs checkpoint)]
        (for [i 0 (Array.length inputs)]
          (Array.push-back! &parts
                            @(SourceInput.source (Array.unsafe-nth inputs i))))
        (String.append &(String.join "

" &parts) "
"))))

  (defn invalidate! [checkpoint]
    (do
      (ReplCheckpoint.set-editing! checkpoint 0)
      (for [i 0 (Array.length (ReplCheckpoint.entries checkpoint))]
        (ReplEntry.set-stale!
          (Array.unsafe-nth (ReplCheckpoint.entries checkpoint) i)
          true)))))
