(load "../carp-source/carp-source.carp")
(load "journal.carp")
(load "wire-macros.carp")

(wire-record SourceInput)
(wire-record SourceSpan)
(wire-record Diagnostic)
(wire-record ReplEntry)

(doc ReplCheckpoint "is the source state of a repl session, which a worker can
rebuild. It holds no compiled code or results. `inputs` are the committed
inputs. `projected` are the ids of inputs committed for their declarations
only. `serial` numbers the next input. `next-result` is the number of the next
result. `entries` and `events` are the journal. `editing` is the number of the
entry being edited, or 0. `last-input` is the id of the last input.
`generation` counts resets and restores. `definitions` lists the definitions
for display.")
(defwire ReplCheckpoint
         [inputs
          (Array SourceInput)
          projected
          (Array String)
          serial
          Int
          next-result
          Int
          entries
          (Array ReplEntry)
          events
          (Array ReplEntry)
          editing
          Int
          last-input
          String
          generation
          Int
          definitions
          String])

(defmodule ReplCheckpoints
  (doc empty "returns the checkpoint of an empty session.")
  (defn empty [] (ReplCheckpoint.init [] [] 1 1 [] [] 0 @"" 0 @""))

  (doc source "returns the source of `checkpoint`, or its transcript if
`transcript` is true.")
  (defn source [checkpoint transcript]
    (ReplJournal.source (ReplCheckpoint.inputs checkpoint)
                        (ReplCheckpoint.events checkpoint)
                        transcript))

  (doc invalidate! "marks every entry of `checkpoint` stale and ends any edit.")
  (defn invalidate! [checkpoint]
    (do
      (ReplCheckpoint.set-editing! checkpoint 0)
      (for [i 0 (Array.length (ReplCheckpoint.entries checkpoint))]
        (ReplEntry.set-stale!
          (Array.unsafe-nth (ReplCheckpoint.entries checkpoint) i)
          true)))))
