(load "../wire-macros.carp")
(load "Test.carp")
(Project.no-echo)
(use-all Test)
(defwire WireEmpty [])
(defwire WirePoint [label String x Int])
(defwire WireEvent
         (Empty [])
         (Point [WirePoint])
         (Values [(Array (Maybe String))]))
(deftype WireExisting [value String
                       number Long])
(wire-record WireExisting)
(sig roundtrip? (Fn [(Ref a) (Fn [(Ref (Array Byte))] (Result a String))] Bool))
(defn roundtrip? [value decode]
  (let [bytes (ReplWire.encode value)]
    (match (decode &bytes)
      (Result.Error _) false
      (Result.Success decoded) (Array.= &bytes &(ReplWire.encode &decoded)))))
(deftest test
  (assert-true test
    (roundtrip? &[(WireEmpty.init) (WireEmpty.init)]
                (fn [bytes]
                  (the (Result (Array WireEmpty) String) (ReplWire.decode bytes))))
    "arrays of empty records roundtrip")
  (assert-true test
    (roundtrip? &(WirePoint.init @"hello" 4)
                (fn [bytes]
                  (the (Result WirePoint String) (ReplWire.decode bytes))))
    "derived records roundtrip")
  (assert-true test
    (roundtrip? &(WireEvent.Empty)
                (fn [bytes]
                  (the (Result WireEvent String) (ReplWire.decode bytes))))
    "empty cases roundtrip")
  (assert-true test
    (roundtrip?
      &(WireEvent.Point (WirePoint.init @"x" -12))
      (fn [bytes] (the (Result WireEvent String) (ReplWire.decode bytes))))
    "owned nested cases roundtrip")
  (assert-true test
    (roundtrip?
      &(WireEvent.Values [(Maybe.Just @"🐟") (Maybe.Nothing)])
      (fn [bytes] (the (Result WireEvent String) (ReplWire.decode bytes))))
    "nested containers roundtrip")
  (assert-true test
    (roundtrip? &(WireExisting.init @"existing" 17l)
                (fn [bytes]
                  (the (Result WireExisting String) (ReplWire.decode bytes))))
    "existing records derive codecs")
  (assert-true test
    (Result.error?
      &(the (Result WireEvent String) (ReplWire.decode &(String.to-bytes "99
"))))
    "unknown cases are rejected")
  (assert-true test
    (Result.error?
      &(the (Result WireEvent String) (ReplWire.decode &(String.to-bytes "1
3
ab"))))
    "truncated nested records are rejected"))
