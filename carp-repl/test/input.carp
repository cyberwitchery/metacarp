(load "../input.carp")
(load "Test.carp")
(Project.no-echo)
(use-all Test)
(defn newline-text [source]
  (let [edit (ReplIndentation.newline source (String.length source))]
    @(Array.unsafe-nth (ReplEditingReply.replacements &edit) 0)))

(deftest test
  (assert-equal test
    Int.MAX
    (match (ReplInput.nonnegative-int "2147483647")
      (Maybe.Just value) value
      (Maybe.Nothing) -1)
    "maximum decimal index is accepted")
  (assert-nothing test
                  &(ReplInput.nonnegative-int "2147483648")
                  "overflow cannot produce a negative index")
  (assert-nothing test
                  &(ReplInput.nonnegative-int "999999999999999999999999999")
                  "large indices cannot wrap")
  (assert-nothing test
                  &(ReplInput.nonnegative-int "-1")
                  "indices are nonnegative")
  (assert-nothing test
                  &(ReplInput.nonnegative-int "1x")
                  "the entire index must be numeric")
  (assert-nothing test
                  &(ReplInput.nonnegative-int "")
                  "empty indices are refused")
  (assert-true test (ReplInput.incomplete? "(Int.+ 1") "open list continues")
  (assert-true test (ReplInput.incomplete? "[1
2") "open array continues")
  (assert-true test (ReplInput.incomplete? "\"a
") "open string continues")
  (assert-true test (ReplInput.incomplete? "r\"raw") "open raw string continues")
  (assert-true test
    (ReplInput.incomplete? "#\"pattern")
    "open pattern continues")
  (assert-true test (ReplInput.incomplete? "'") "quote prefix continues")
  (assert-true test (ReplInput.incomplete? "\\") "character prefix continues")
  (assert-false test (ReplInput.incomplete? "(Int.+ 1 2)") "closed list submits")
  (assert-false test
    (ReplInput.incomplete? "(x]")
    "mismatched delimiter submits an error")
  (assert-false test
    (ReplInput.incomplete? "x)")
    "extra delimiter submits an error")
  (assert-false test
    (ReplInput.incomplete? "\"(\"")
    "quoted opening delimiter is complete")
  (assert-false test
    (ReplInput.incomplete? "\\(")
    "character delimiter is complete")
  (assert-false test (ReplInput.incomplete? "; (
42") "comment delimiters do not continue")
  (assert-false test
    (ReplInput.incomplete? "r\"a\"\"(\"")
    "raw-string escaped quote is complete")
  (assert-true test (ReplInput.blank? "
 \t") "whitespace is blank")
  (assert-false test (ReplInput.blank? "0") "a value is not blank")
  (assert-equal test "
       " &(newline-text "(Int.+ 40") "calls align with their first argument")
  (assert-equal test "
  " &(newline-text "(fn [x]") "function bodies indent from their opener")
  (assert-equal test "
    " &(newline-text "(fn [x]
  (let [y x]") "nested bodies indent from the nested opener")
  (assert-equal test "
      " &(newline-text "(let [x 1") "binding vectors align with their first binding")
  (assert-equal test "
    " &(newline-text "[1 [2") "nested collections use their own element column")
  (assert-equal test "
 " &(newline-text "{a 1") "dictionary entries align with their first key")
  (assert-equal test "
  " &(newline-text "$[1") "static-array openers retain their full width")
  (assert-equal test "
     " &(newline-text "(foo 1 ; [( ") "comment delimiters never affect indentation")
  (assert-equal test "
  " &(newline-text "'(a") "quoted lists align data elements rather than call arguments")
  (assert-equal test "
     " &(newline-text "(foo \"(\"") "closed string contents do not open groups")
  (assert-equal test "
" &(newline-text "(foo \"hello") "unfinished strings do not gain whitespace")
  (assert-equal test "
" &(newline-text "(foo #\"hello") "unfinished patterns do not gain whitespace")
  (assert-equal test "
" &(newline-text "(foo r\"hello") "unfinished raw strings do not gain whitespace")
  (assert-equal test "
" &(newline-text "'") "a reader prefix does not invent an enclosing group")
  (assert-equal test "
" &(newline-text "(foo)") "a complete top-level form starts a new top-level line")
  (assert-equal test
    7
    @(ReplEditingReply.end &(ReplIndentation.newline "(foo   )" 4))
    "newline replaces existing horizontal whitespace at the cursor")
  (assert-equal test "
" (Array.unsafe-nth
      (ReplEditingReply.replacements &(ReplIndentation.newline "(foo   )" 4))
      0) "closing delimiters align with their opener")
  (assert-equal test "
     " (Array.unsafe-nth
      (ReplEditingReply.replacements &(ReplIndentation.newline "(foo a b)" 6))
      0) "mid-buffer newlines use the cursor's enclosing call")
  (assert-equal test
    6
    @(ReplEditingReply.end &(ReplIndentation.newline "\"hello world\"" 6))
    "literal whitespace after the cursor is preserved")
  (assert-equal test "
       " &(newline-text "`(a %(fn [x]") "unquote restores expression indentation inside quasiquote")
  (assert-equal test "
          " &(newline-text "`(a `(b %(fn [x]") "nested quasiquotes retain data indentation until fully unquoted"))
