(load "../wire.carp")
(load "Test.carp")
(Project.no-echo)
(use-all Test)

(sig roundtrip? (Fn [(Ref a)] Bool))
(defn roundtrip? [value]
  (let [bytes (ReplWire.encode value)]
    (match (ReplWire.decode &bytes)
      (Result.Error _) false
      (Result.Success decoded) (= value &decoded))))

(defn rejects-long? [source]
  (Result.error?
    &(the (Result Long String) (ReplWire.decode &(String.to-bytes source)))))

(deftest test
  (let [value Long.MIN]
    (assert-true test
      (roundtrip? &value)
      "the full negative Long range roundtrips"))
  (let [value Long.MAX]
    (assert-true test
      (roundtrip? &value)
      "the full positive Long range roundtrips"))
  (assert-true test (roundtrip? &Int.MIN) "negative Int values roundtrip")
  (assert-true test (roundtrip? &Int.MAX) "positive Int values roundtrip")
  (assert-true test (roundtrip? "Grüße
\"🐟\"") "strings preserve UTF-8, quotes, and newlines")
  (assert-true test
    (roundtrip? &[(Maybe.Just @"first") (Maybe.Nothing) (Maybe.Just @"last")])
    "nested arrays and optional owners roundtrip")
  (assert-true test (rejects-long? "9223372036854775808
") "positive overflow is rejected")
  (assert-true test (rejects-long? "-9223372036854775809
") "negative overflow is rejected")
  (assert-true test (rejects-long? "-
") "a sign without digits is rejected")
  (assert-true test (rejects-long? "12") "truncated fields are rejected")
  (assert-true test (rejects-long? "12x
") "invalid numeric data is rejected")
  (assert-true test (rejects-long? "12
0
") "trailing fields are rejected")
  (assert-true test
    (Result.error?
      &(the (Result Bool String) (ReplWire.decode &(String.to-bytes "2
"))))
    "unknown boolean tags are rejected")
  (assert-true test
    (Result.error?
      &(the (Result (Array Int) String)
            (ReplWire.decode &(String.to-bytes "999999
"))))
    "an impossible array count is rejected before allocating elements")
  (assert-true test
    (Result.error?
      &(the (Result String String) (ReplWire.decode &(String.to-bytes "10
abc"))))
    "string lengths are checked against the remaining payload"))
