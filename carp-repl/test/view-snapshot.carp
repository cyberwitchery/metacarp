(load "../../carp-views/carp-views.carp")
(load "../view-protocol.carp")
(load "../view-snapshot.carp")
(load "Test.carp")
(Project.no-echo)
(use-all Test)

(def *snapshot-rows* (the (Array Int) []))
(def *snapshot-children* 0)

(defview tracked-items
         [xs (Array Int)]
         (=> (View.list)
             (View.title @"Tracked")
             (View.value-items (fn [value] (Array.length value)))
             (View.value-format
               (fn [value row request]
                 (do
                   (ignore request)
                   (Array.push-back! &*snapshot-rows* row)
                   (str @(Array.unsafe-nth value row)))))
             (View.value-send
               (fn [value row owner]
                 (View.unsafe-borrow-register (Array.unsafe-nth value row) owner)))))

(deftype Caption [text String])
(defview caption
         [value Caption]
         (=> (View.text) (View.content @(Caption.text value))))

(deftype Branch [])
(defview descendants
         [value Branch]
         (do
           (ignore value)
           (=> (View.tree)
               (View.children
                 (fn []
                   (do
                     (set! *snapshot-children* (Int.inc *snapshot-children*))
                     [(view-register 10) (view-register 20) (view-register 30)]))))))

(deftype Swatch [])
(defview image
         [value Swatch]
         (do
           (ignore value)
           (=> (View.bitmap)
               (View.extent 2 2)
               (View.pixels
                 [255b
                  0b
                  0b
                  255b
                  0b
                  255b
                  0b
                  255b
                  0b
                  0b
                  255b
                  255b
                  255b
                  255b
                  255b
                  255b]))))

(deftype BrokenImage [])
(defview broken-image
         [value BrokenImage]
         (do
           (ignore value)
           (=> (View.bitmap) (View.extent 2 2) (View.pixels [1b]))))

(defn object-id [reply]
  (Long.to-int
    @(ReplViewHandle.id (ReplViewPage.handle (ReplViewReply.page reply)))))

(defn snapshot-tests [initial]
  (let-do [test @initial
           values [10 20 30 40]
           request (View.request @"tracked-items" 1 2 6 1024)
           reply (ReplView.open 7l &values &(views &values) &request 80)
           page (ReplViewReply.page &reply)
           root (object-id &reply)]
    (set! test
          (assert-equal &test
            ""
            (ReplViewReply.error &reply)
            "a structured view opens"))
    (set! test
          (assert-equal &test
            7l
            @(ReplViewHandle.generation (ReplViewPage.handle page))
            "handles identify their runtime generation"))
    (set! test
          (assert-equal &test
            4
            @(ReplViewPage.total page)
            "the page reports the complete item count"))
    (set! test
          (assert-equal &test
            2
            (Array.length (ReplViewPage.items page))
            "only the requested rows are returned"))
    (set! test
          (assert-equal &test
            &[1 2]
            &*snapshot-rows*
            "only requested formatters run"))
    (set! test
          (assert-equal &test
            1
            @(Array.unsafe-nth &*view-refs* root)
            "rendering does not select or register child values"))
    (let-do [selected (ReplView.operate 7l 2 root 1 &request 80)
             child (object-id &selected)]
      (ReplView.close root)
      (set! test
            (assert-true &test
              (View.valid-id? root)
              "a selected borrowed child keeps its root lease"))
      (set! test
            (assert-equal &test
              "20"
              (ReplViewPage.text (ReplViewReply.page &selected))
              "selection returns an owned presentation, not a callback"))
      (ReplView.close child)
      (set! test
            (assert-false &test
              (View.valid-id? root)
              "closing the final child releases the borrowed root")))
    (set! test
          (assert-equal &test
            4
            (Array.length &values)
            "inspection leaves caller-owned storage alive"))
    (let-do [bad (ReplView.open 7l
                                &values
                                &(views &values)
                                &(View.request @"missing" 0 1 6 100)
                                80)]
      (set! test
            (assert-false &test
              (String.empty? (ReplViewReply.error &bad))
              "unknown views report an error"))
      (set! test
            (assert-false &test
              (View.valid-id? (object-id &bad))
              "failed open releases its new lease")))
    (let-do [value (Caption.init @"hello")
             text (ReplView.open 7l
                                 &value
                                 &(views &value)
                                 &(View.request @"caption" 2 1 6 3)
                                 80)]
      (set! test
            (assert-equal &test
              "llo"
              (ReplViewPage.text (ReplViewReply.page &text))
              "closed text providers respect byte windows"))
      (ReplView.close (object-id &text)))
    (let-do [value (Branch.init)
             window (View.request @"descendants" 1 1 6 1024)
             tree (ReplView.open 7l &value &(views &value) &window 80)
             parent (object-id &tree)
             repeated (ReplView.operate 7l 1 parent 0 &window 80)
             selected (ReplView.operate 7l 2 parent 1 &window 80)]
      (set! test
            (assert-equal &test
              ""
              (ReplViewReply.error &repeated)
              "tree windows can be revisited"))
      (set! test
            (assert-equal &test
              1
              *snapshot-children*
              "revisiting and selecting a tree page reuses its child leases"))
      (set! test
            (assert-equal &test
              "20"
              (ReplViewPage.text (ReplViewReply.page &selected))
              "tree selection follows the displayed child"))
      (ReplView.close parent)
      (set! test
            (assert-equal &test
              0
              (Array.length &*repl-view-children*)
              "closing a tree releases its page cache"))
      (ReplView.close (object-id &selected)))
    (let-do [value (Swatch.init)
             bitmap (ReplView.open 7l
                                   &value
                                   &(views &value)
                                   &(View.request @"image" 0 1 6 4)
                                   2)
             image (ReplViewPage.image (ReplViewReply.page &bitmap))]
      (set! test
            (assert-equal &test
              ""
              (ReplViewReply.error &bitmap)
              "bitmap metadata is validated"))
      (set! test
            (assert-equal &test
              2
              @(ReplViewImage.width image)
              "the original image dimensions are retained"))
      (set! test
            (assert-equal &test
              &[255b 0b 0b 255b]
              (ReplViewImage.pixels image)
              "bitmap sampling fits the requested byte and viewport budget"))
      (ReplView.close (object-id &bitmap)))
    (let-do [value (BrokenImage.init)
             invalid (ReplView.open 7l
                                    &value
                                    &(views &value)
                                    &(View.request @"broken-image" 0 1 6 100)
                                    80)]
      (set! test
            (assert-false &test
              (String.empty? (ReplViewReply.error &invalid))
              "invalid bitmap storage is refused"))
      (set! test
            (assert-false &test
              (View.valid-id? (object-id &invalid))
              "an invalid view does not retain its borrowed owner")))
    (let-do [value (Swatch.init)
             reply (ReplView.open 7l
                                  &value
                                  &(views &value)
                                  &(View.request @"image" 0 4 6 0)
                                  80)]
      (set! test
            (assert-equal &test
              ""
              (ReplViewReply.error &reply)
              "a zero bitmap byte budget is a valid empty window"))
      (set! test
            (assert-true &test
              (Array.empty?
                (ReplViewImage.pixels
                  (ReplViewPage.image (ReplViewReply.page &reply))))
              "an empty bitmap window allocates no pixels"))
      (ReplView.close (object-id &reply)))
    (let-do [value (Branch.init)
             request (View.request @"descendants" 0 1 6 1024)
             roots (the (Array Int) [])]
      (for [i 0 20]
        (Array.push-back! &roots
                          (object-id
                            &(ReplView.open 7l
                                            &value
                                            &(views &value)
                                            &request
                                            80))))
      (let-do [before *snapshot-children*
               child (ReplView.operate 7l
                                       2
                                       @(Array.unsafe-nth &roots 0)
                                       0
                                       &request
                                       80)]
        (set! test
              (assert-equal &test
                before
                *snapshot-children*
                "another live tree cannot evict displayed child leases"))
        (ReplView.close (object-id &child)))
      (for [i 0 (Array.length &roots)]
        (ReplView.close @(Array.unsafe-nth &roots i))))
    (View.clear!)
    test))

(deftest test (snapshot-tests test))
