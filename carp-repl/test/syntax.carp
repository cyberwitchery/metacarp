(load "../syntax.carp")
(load "../language-syntax.carp")
(load "Test.carp")
(Project.no-echo)
(use-all Test)

(defn word [source cursor]
  (ReplLanguageSyntax.word &(Reader.read-syntax source) cursor))

(defn analysis [source]
  (let [request (ReplLanguageRequest.init (ReplQuery.Analyze)
                                          @"syntax:test"
                                          1l
                                          1l
                                          1l
                                          (String.copy source)
                                          0)]
    (ReplLanguageSyntax.analysis &request &(Reader.read-syntax source))))

(deftest test
  (assert-equal test
    2
    (Array.length (ReplAnalysis.pairs &(analysis "([x])")))
    "delimiter pairs come from the reader tree")
  (assert-equal test
    0
    (Array.length (ReplAnalysis.pairs &(analysis "(x]")))
    "recovery does not invent a matching closer")
  (assert-equal test
    0
    (Array.length (ReplAnalysis.diagnostics &(analysis "(\"[\" ; ]
\\))")))
    "literal and comment delimiters are opaque")
  (assert-equal test
    1
    @(ReplWord.start &(word "(λ.Int.inx 41)" 10))
    "UTF-8 replacement starts at the reader byte boundary")
  (assert-equal test
    11
    @(ReplWord.end &(word "(λ.Int.inx 41)" 10))
    "replacement includes text right of the cursor")
  (assert-equal test
    "λ.Int.in"
    (ReplWord.prefix &(word "(λ.Int.inx 41)" 10))
    "the prefix preserves Unicode source")
  (assert-false test
    @(ReplWord.active &(word "\"Int.inc" 8))
    "no completion inside strings")
  (assert-false test
    @(ReplWord.active &(word "; Int.inc" 9))
    "no completion inside comments")
  (assert-false test
    @(ReplWord.active &(word "r\"a\"\"Int.inc" 12))
    "no completion inside raw strings")
  (assert-equal test
    "λ."
    &(ReplSyntax.common-prefix &[@"λ.a" @"λ.b"])
    "shared completion prefixes end on character boundaries"))
