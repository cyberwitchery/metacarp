(load "../../display.carp")
(load "Test.carp")
(Project.no-echo)
(use-all Test)
(system-include "locale.h")
(register display-locale (Fn [Int (Ptr CChar)] (Ptr CChar)) "setlocale")
(register display-ctype Int "LC_CTYPE")
(def *display-locale* (display-locale display-ctype (String.cstr "")))

(defn provided [highlights pairs]
  (ReplAnalysis.init @"display:test"
                     1l
                     1l
                     highlights
                     pairs
                     []
                     (ReplCompleteness.Complete)
                     (ReplAnalysisState.Ready)))

(deftest test (assert-true test (let [frame (ReplDisplay.frame "λ> " "(Int.+
  20 22)" 16 12 5 "Int
source checked" false &[])] (and (Int.< @(ReplFrame.cursor-row &frame) 5)
                                 (and
                                   (Int.< @(ReplFrame.cursor-column &frame) 12)
                                   (Int.< @(ReplFrame.end-row &frame) 5)))) "multiline source, caret, and feedback fit the viewport") (assert-true test
    (let [frame (ReplDisplay.frame "λ> " "\"\u001b\"" 3 80 24 "" false &[])]
      (and
        (String.contains-string? (ReplFrame.text &frame) "^[")
        (not (String.contains-string? (ReplFrame.text &frame) "\u001b"))))
    "input controls are displayed as text") (assert-equal test
    0
    @(Array.unsafe-nth
      (ReplStyledText.styles &(ReplDisplay.styled "if" 2 &[]))
      0)
    "the renderer does not classify keyword spellings") (assert-equal test
    10
    @(Array.unsafe-nth
      (ReplStyledText.styles
        &(ReplDisplay.styled "if"
                             2
                             &[(provided
                                 [(ReplHighlight.init (ReplRange.init 0 2)
                                                      (ReplHighlightKind.Local))]
                                 [])]))
      0)
    "a supplied local binding controls the style even when named if") (assert-equal test
    9
    @(Array.unsafe-nth
      (ReplStyledText.styles
        &(ReplDisplay.styled "λx"
                             3
                             &[(provided
                                 [(ReplHighlight.init (ReplRange.init 2 3)
                                                      (ReplHighlightKind.Function))]
                                 [])]))
      1)
    "UTF-8 semantic byte ranges select the intended character") (assert-equal test
    6
    @(Array.unsafe-nth
      (ReplStyledText.styles
        &(ReplDisplay.styled "(x)"
                             3
                             &[(provided []
                                         [(ReplDelimiterPair.init (ReplRange.init 0
                                                                                  1)
                                                                  (ReplRange.init 2
                                                                                  3))])]))
      0)
    "cursor matching uses only supplied delimiter pairs") (assert-true test
    (let [text (ReplDisplay.styled "((x))"
                                   1
                                   &[(provided []
                                               [(ReplDelimiterPair.init (ReplRange.init 0
                                                                                        1)
                                                                        (ReplRange.init 4
                                                                                        5))
                                                (ReplDelimiterPair.init (ReplRange.init 1
                                                                                        2)
                                                                        (ReplRange.init 3
                                                                                        4))])])
          styles (ReplStyledText.styles &text)]
      (and (Int./= @(Array.unsafe-nth styles 0) 6)
           (Int.= @(Array.unsafe-nth styles 1) 6)))
    "a delimiter under the caret wins over the preceding delimiter") (assert-true test
    (let [text (ReplDisplay.styled "#[x]"
                                   1
                                   &[(provided []
                                               [(ReplDelimiterPair.init (ReplRange.init 0
                                                                                        2)
                                                                        (ReplRange.init 3
                                                                                        4))])])
          styles (ReplStyledText.styles &text)]
      (and (Int.= @(Array.unsafe-nth styles 0) 6)
           (Int.= @(Array.unsafe-nth styles 1) 6)))
    "a multi-character static-array opener is one delimiter") (assert-equal test
    "λ> (Int.+\r\n·>   20 22)"
    (ReplFrame.text &(ReplDisplay.frame "λ> " "(Int.+
  20 22)" 9 80 24 "" false &[]))
    "logical continuation lines retain the prompt margin") (assert-equal test
    5
    @(ReplFrame.cursor-column &(ReplDisplay.frame "λ> " "(Int.+
  20 22)" 9 80 24 "" false &[]))
    "a source cursor after indentation includes the continuation prompt width") (assert-equal test
    "λ> (\r\n·> "
    (ReplFrame.text &(ReplDisplay.frame "λ> " "(
" 2 80 24 "" false &[]))
    "an empty continuation line still has a prompt") (assert-equal test
    "λ[12]> (\r\n    ·>   x)"
    (ReplFrame.text &(ReplDisplay.frame "λ[12]> " "(
  x)" 6 80 24 "" false &[]))
    "continuations align with the wider history editing prompt") (assert-equal test
    "\r\u001b[1A\u001b[3C"
    &(let [before (ReplDisplay.frame "λ> " "abc
  xyz" 10 80 24 "" false &[])
           after (ReplDisplay.frame "λ> " "abc
  xyz" 0 80 24 "" false &[])] (ReplDisplay.patch (ReplFrame.rows &before)
                                                 1
                                                 &after
                                                 80))
    "cursor-only changes emit movement without repainting source") (assert-true test
    (let [before (ReplDisplay.frame "λ> " "a
  b" 6 80 24 "" false &[])
          after (ReplDisplay.frame "λ> " "a
  bc" 7 80 24 "" false &[])
          patch (ReplDisplay.patch (ReplFrame.rows &before) 1 &after 80)] (and
        (not (String.contains-string? &patch "λ> a"))
        (and
          (and (String.contains-string? &patch "c")
               (not (String.contains-string? &patch "·> ")))
          (not (String.contains-string? &patch "\u001b[J")))))
    "editing a continuation updates only that row without clearing the frame") (assert-true test
    (let [before (ReplDisplay.frame "λ> " "a
  b" 6 80 24 "" false &[])
          after (ReplDisplay.frame "λ> " "a" 1 80 24 "" false &[])] (String.contains-string?
        &(ReplDisplay.patch (ReplFrame.rows &before) 1 &after 80)
        "\u001b[2K"))
    "removing a row clears the retired row") (assert-true test
    (let [frame (ReplDisplay.frame "λ> " "12345" 5 8 24 "type" false &[])
          patch (ReplDisplay.patch &[] 0 &frame 8)]
      (and
        (String.contains-string? &patch "λ> 12345\r")
        (and
          (not (String.contains-string? &patch "12345\u001b[K"))
          (and (Int.= @(ReplFrame.cursor-row &frame) 1)
               (Int.= @(ReplFrame.cursor-column &frame) 0)))))
    "an exact-width line retains its last glyph and reserves a caret row before feedback") (assert-equal test
    "λ> 12345\r\n6"
    (ReplFrame.text &(ReplDisplay.frame "λ> " "123456" 6 8 24 "" false &[]))
    "soft wraps do not add logical continuation prompts") (assert-true test
    (let [analysis (provided
            [(ReplHighlight.init (ReplRange.init 0 3) (ReplHighlightKind.Local))]
            [])
          frame (ReplDisplay.frame "λ> " "x
x" 3 80 24 "" true &[analysis])
          rows (ReplFrame.rows &frame)]
      (and
        (String.starts-with?
          (ReplDisplayRow.text (Array.unsafe-nth rows 1))
          "\u001b[0m·> ")
        (String.contains-string?
          (ReplDisplayRow.text (Array.unsafe-nth rows 1))
          "\u001b[3mx")))
    "independent rows preserve supplied source styles after prompt decoration") (assert-true test
    (let [before (ReplDisplay.frame "λ> " "abc" 3 80 24 "" false &[])
          after (ReplDisplay.frame "λ> " "axc" 2 80 24 "" false &[])
          patch (ReplDisplay.patch (ReplFrame.rows &before) 0 &after 80)]
      (and
        (String.contains-string? &patch "\u001b[4Cxc")
        (not (String.contains-string? &patch "\u001b[K"))))
    "equal-width edits overwrite the changed suffix without erasing visible text") (assert-true test
    (let [before (ReplDisplay.frame "λ> " "abcd" 4 80 24 "" false &[])
          after (ReplDisplay.frame "λ> " "ab" 2 80 24 "" false &[])
          patch (ReplDisplay.patch (ReplFrame.rows &before) 0 &after 80)]
      (String.contains-string? &patch "\u001b[5C\u001b[K"))
    "shortened rows erase only the retired tail after the retained prefix") (assert-true test
    (let [before (ReplDisplay.frame "λ> " "é" 3 80 24 "" false &[])
          after (ReplDisplay.frame "λ> " "è" 3 80 24 "" false &[])
          patch (ReplDisplay.patch (ReplFrame.rows &before) 0 &after 80)]
      (String.contains-string? &patch "\u001b[3Cè"))
    "changing a combining mark repaints its base glyph") (assert-true test
    (let [before (ReplDisplay.frame "λ> " "🐟a" 5 80 24 "" false &[])
          after (ReplDisplay.frame "λ> " "🐟b" 5 80 24 "" false &[])
          patch (ReplDisplay.patch (ReplFrame.rows &before) 0 &after 80)]
      (String.contains-string? &patch "\u001b[5Cb"))
    "retained prefixes count wide glyphs in terminal columns") (assert-true test
    (let [analyses [(provided
                      [(ReplHighlight.init (ReplRange.init 0 1)
                                           (ReplHighlightKind.Local))]
                      [])]
          before (ReplDisplay.frame "λ> " "x" 1 80 24 "" true &analyses)
          after (ReplDisplay.frame "λ> " "x " 2 80 24 "" true &analyses)
          patch (ReplDisplay.patch (ReplFrame.rows &before) 0 &after 80)]
      (and
        (not (String.contains-string? &patch "x"))
        (not (String.contains-string? &patch "\u001b[K"))))
    "unchanged styled prefixes remain on screen during an append") (assert-true test
    (let [analysis (provided
            [(ReplHighlight.init (ReplRange.init 0 1) (ReplHighlightKind.Local))]
            [])
          frame (ReplDisplay.frame "λ> " "x" 1 80 24 "" true &[analysis])]
      (and
        (String.contains-string? (ReplFrame.text &frame) "\u001b[0m\u001b[3mx")
        (not (String.contains-string? (ReplFrame.text &frame) "\u001b[37m"))))
    "local bindings use the terminal's default foreground with independent attributes"))
