(load "../../transport.carp")
(load "Test.carp")
(Project.no-echo)
(use-all Test)

(defn decode-frame [bytes eof]
  (let-do [channel (ReplChannel.init -1 -1 bytes [] 0 eof @"")]
    (ReplTransport.poll! &channel)))
(defn complete? [bytes expected]
  (match (decode-frame bytes false)
    (Result.Success (Maybe.Just value)) (Array.= &value expected)
    _ false))
(defn rejected? [bytes eof] (Result.error? &(decode-frame bytes eof)))
(defn loopback? []
  (let-do [descriptors [-1 -1]]
    (if (Int./=
        (ReplNative.pipe (Pointer.address (Array.unsafe-nth &descriptors 0)))
        0)
      false
      (let-do [reader @(Array.unsafe-nth &descriptors 0)
               writer @(Array.unsafe-nth &descriptors 1)
               channel (ReplTransport.create reader writer)
               payload (Array.replicate 200000 &97b)
               got false
               until (Long.+ (ReplNative.now) 1000000000l)]
        (ReplTransport.send! &channel &payload)
        (while-do (and (not got) (Long.< (ReplNative.now) until))
          (ReplTransport.pump! &channel)
          (match (ReplTransport.poll! &channel)
            (Result.Success (Maybe.Just bytes))
              (set! got (Array.= &bytes &payload))
            (Result.Error _) (set! until 0l)
            _ ()))
        (ignore (ReplNative.close reader))
        (ignore (ReplNative.close writer))
        got))))
(deftest test
  (assert-true test
    (complete? [0b 0b 0b 3b 97b 98b 99b] &[97b 98b 99b])
    "complete frames retain exact bytes")
  (assert-true test
    (match (decode-frame [0b 0b 0b] false)
      (Result.Success (Maybe.Nothing)) true
      _ false)
    "split headers remain pending")
  (assert-true test
    (match (decode-frame [0b 0b 0b 3b 97b] false)
      (Result.Success (Maybe.Nothing)) true
      _ false)
    "split payloads remain pending")
  (assert-true test
    (rejected? [0b 0b 0b 0b] false)
    "zero length frames are rejected")
  (assert-true test
    (rejected? [255b 255b 255b 255b] false)
    "unbounded lengths are rejected without allocation")
  (assert-true test (rejected? [0b 0b] true) "EOF in a header is rejected")
  (assert-true test
    (rejected? [0b 0b 0b 3b 97b] true)
    "EOF in a payload is rejected")
  (assert-true test
    (loopback?)
    "partial writes and pipe backpressure preserve a large frame"))
