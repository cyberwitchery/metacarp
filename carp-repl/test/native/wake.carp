(load "../../wake.carp")
(load "../../transport.carp")
(load "Test.carp")
(Project.no-echo)
(use-all Test)
(defn wake-retains-readiness? []
  (let-do [queue (ReplWake.create)
           fds [-1 -1]
           made (Int.=
             (ReplNative.pipe (Pointer.address (Array.unsafe-nth &fds 0)))
             0)]
    (if (or (Int.< queue 0) (not made))
      false
      (let-do [reader @(Array.unsafe-nth &fds 0)
               writer @(Array.unsafe-nth &fds 1)
               watched (ReplWake.descriptor queue reader)
               idle (Int.= (ReplTransport.wait &[queue] -1 0) 0)
               bytes [1b 2b]
               byte 0b]
        (ignore
          (ReplNative.write writer
                            (Pointer.address (Array.unsafe-nth &bytes 0))
                            2l))
        (let-do [first (Int.> (ReplTransport.wait &[queue] -1 100) 0)]
          (ReplWake.acknowledge! queue)
          (ignore (ReplNative.read reader (Pointer.address &byte) 1l))
          (let-do [still-ready (Int.> (ReplTransport.wait &[queue] -1 100) 0)]
            (ignore (ReplNative.read reader (Pointer.address &byte) 1l))
            (ReplWake.acknowledge! queue)
            (let-do [drained (Int.= (ReplTransport.wait &[queue] -1 0) 0)]
              (ignore (ReplNative.close reader))
              (ignore (ReplNative.close writer))
              (ignore (ReplNative.close queue))
              (and watched (and idle (and first (and still-ready drained)))))))))))
(deftest test
  (assert-true test
    (wake-retains-readiness?)
    "the stable wake descriptor stays ready until bounded reads consume the data"))
