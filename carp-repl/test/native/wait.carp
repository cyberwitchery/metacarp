(load "../../native.carp")
(load "Test.carp")
(Project.no-echo)
(use-all Test)

(defn waits-for-notification? []
  (let-do [descriptors [0 0]
           _pipe (ReplNative.pipe
             (Pointer.address (Array.unsafe-nth &descriptors 0)))
           reader @(Array.unsafe-nth &descriptors 0)
           writer @(Array.unsafe-nth &descriptors 1)
           set (the (Ptr ReplNativeFdSet)
                    (ReplNative.allocate
                      (Pointer.width
                        (the (Ptr ReplNativeFdSet) (Pointer.from-long 0l)))))
           timeout (the (Ptr ReplNativeTimeout)
                        (ReplNative.allocate
                          (Pointer.width
                            (the (Ptr ReplNativeTimeout) (Pointer.from-long 0l)))))
           byte 1b]
    (ReplNativeTimeout.set-tv_sec! (Pointer.to-ref timeout) 0l)
    (ReplNativeTimeout.set-tv_usec! (Pointer.to-ref timeout) 1000)
    (ReplNative.clear-fds set)
    (ReplNative.add-fd reader set)
    (let-do [before (ReplNative.now)
             empty (ReplNative.select (Int.inc reader)
                                      set
                                      (Pointer.from-long 0l)
                                      (Pointer.from-long 0l)
                                      timeout)
             _written (ReplNative.write writer (Pointer.address &byte) 1l)]
      (ReplNative.clear-fds set)
      (ReplNative.add-fd reader set)
      (let-do [ready (ReplNative.select (Int.inc reader)
                                        set
                                        (Pointer.from-long 0l)
                                        (Pointer.from-long 0l)
                                        (Pointer.from-long 0l))
               okay (and (Int.= empty 0)
                         (and (Int.= ready 1)
                              (and
                                (Int./= (ReplNative.has-fd reader set) 0)
                                (Long.>= (ReplNative.now) before))))]
        (ignore (ReplNative.close reader))
        (ignore (ReplNative.close writer))
        (ReplNative.release set)
        (ReplNative.release timeout)
        okay))))

(deftest test
  (assert-true test
    (waits-for-notification?)
    "the editor can wait for input or a worker notification without changing stdin flags"))
