(load "../../scratch.carp")
(load "Test.carp")
(Project.no-echo)
(use-all Test)
(register scratch-test-temp (Fn [(Ptr CChar)] (Ptr CChar)) "mkdtemp")
(register scratch-test-link (Fn [(Ptr CChar) (Ptr CChar)] Int) "symlink")
(register scratch-test-access (Fn [(Ptr CChar) Int] Int) "access")
(defn exists? [path] (Int.= (scratch-test-access (String.cstr path) 0) 0))
(defn cleanup-is-scoped? []
  (let-do [root @"/tmp/metacarp-clean-test-XXXXXX"
           outside @"/tmp/metacarp-clean-outside-XXXXXX"]
    (if (or
        (null? (scratch-test-temp (String.cstr &root)))
        (null? (scratch-test-temp (String.cstr &outside))))
      false
      (let-do [shim (String.append &root "/carp-jit-shim-4.c")
               keep (String.append &root "/keep.txt")
               directory (String.append &root "/carp-layout-test")
               probe (String.append &directory "/probe.c")
               external (String.append &outside "/probe.c")
               link (String.append &root "/carp-layout-link")]
        (ignore (IO.write-file "compiler" &shim))
        (ignore (IO.write-file "user" &keep))
        (ignore (ReplScratchNative.mkdir (String.cstr &directory) 448))
        (ignore (IO.write-file "compiler" &probe))
        (ignore (IO.write-file "outside" &external))
        (ignore (scratch-test-link (String.cstr &outside) (String.cstr &link)))
        (ReplScratch.clean &root)
        (let-do [correct (and (not (exists? &shim))
                              (and (not (exists? &directory))
                                   (and (exists? &keep) (exists? &external))))]
          (IO.Raw.unlink! &link)
          (IO.Raw.unlink! &keep)
          (IO.Raw.unlink! &external)
          (ignore (ReplScratchNative.rmdir (String.cstr &root)))
          (ignore (ReplScratchNative.rmdir (String.cstr &outside)))
          correct)))))
(deftest test
  (assert-true test
    (cleanup-is-scoped?)
    "cleanup removes compiler artifacts, retains unknown files, and never follows directory symlinks"))
