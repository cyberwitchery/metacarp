(load "../../pager.carp")
(load "Test.carp")
(Project.no-echo)
(use-all Test)
(system-include "locale.h")
(register pager-locale (Fn [Int (Ptr CChar)] (Ptr CChar)) "setlocale")
(register pager-ctype Int "LC_CTYPE")
(def *pager-locale* (pager-locale pager-ctype (String.cstr "")))

(deftest test
  (assert-equal test
    3
    (Array.length (ReplPagerLayout.lines &(ReplPager.layout "ab界cde
λ" 4)))
    "wrapping measures wide characters and explicit newlines")
  (assert-equal test
    3
    @(ReplPagerLine.start
      (Array.unsafe-nth (ReplPagerLayout.lines &(ReplPager.layout "ab界cde
λ" 4)) 1))
    "wrapped anchors name Unicode characters rather than bytes")
  (assert-equal test
    "abcd́"
    (ReplDisplayRow.text
      (ReplPagerLine.row
        (Array.unsafe-nth
          (ReplPagerLayout.lines &(ReplPager.layout "abcd́x" 4))
          0)))
    "combining marks stay with the base at the right margin")
  (assert-equal test
    "^[^?"
    (ReplDisplayRow.text
      (ReplPagerLine.row
        (Array.unsafe-nth
          (ReplPagerLayout.lines &(ReplPager.layout "\u001b\u007f" 80))
          0)))
    "document controls cannot escape the output frame")
  (assert-equal test 4 (ReplPager.move &(ReplPager.layout "0
1
2
3
4" 10) 0 100 4) "moving beyond the end leaves a complete final page")
  (assert-equal test 0 (ReplPager.move &(ReplPager.layout "0
1
2
3
4" 10) 4 -100 4) "moving before the beginning clamps to the first page")
  (assert-equal test
    1
    (ReplPager.row-at &(ReplPager.layout "abcdefgh" 4) 5)
    "resize can recover the row containing the prior source anchor")
  (assert-equal test
    0
    (ReplPager.row-at &(ReplPager.layout "abcdefgh" 8) 5)
    "a wider viewport preserves the source anchor")
  (assert-equal test
    &(Maybe.Just 2)
    &(ReplPager.find "λ needle λ needle" "needle" -1 false)
    "search positions count characters")
  (assert-equal test
    &(Maybe.Just 2)
    &(ReplPager.find "λ needle λ needle" "needle" 11 false)
    "forward search wraps once")
  (assert-equal test
    &(Maybe.Just 11)
    &(ReplPager.find "λ needle λ needle" "needle" 2 true)
    "backward search wraps once")
  (assert-nothing test
                  &(ReplPager.find "λ" "missing" 0 false)
                  "a missing search returns no fabricated position")
  (assert-true test (let [frame (ReplPager.frame &(ReplPager.layout "a
b
c
d
e" 20) 0 20 3 "")] (and
        (Int.= (Array.length (ReplFrame.rows &frame)) 3)
        (Int.= @(ReplFrame.cursor-row &frame) 2))) "the visible window and status fit the viewport"))
