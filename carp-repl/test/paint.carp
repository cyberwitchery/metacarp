(load "../paint.carp")
(load "Test.carp")
(Project.no-echo)
(use-all Test)

(defn analysis [state highlights]
  (ReplAnalysis.init @"paint:test"
                     1l
                     1l
                     highlights
                     []
                     []
                     (ReplCompleteness.Complete)
                     state))

(defn lexical []
  [(ReplHighlight.init (ReplRange.init 1 3) (ReplHighlightKind.Symbol))
   (ReplHighlight.init (ReplRange.init 5 6) (ReplHighlightKind.Symbol))
   (ReplHighlight.init (ReplRange.init 8 9) (ReplHighlightKind.Symbol))])

(defn ready []
  (let-do [facts (lexical)]
    (Array.push-back! &facts
                      (ReplHighlight.init (ReplRange.init 1 3)
                                          (ReplHighlightKind.Syntax)))
    (Array.push-back! &facts
                      (ReplHighlight.init (ReplRange.init 5 6)
                                          (ReplHighlightKind.Parameter)))
    (Array.push-back! &facts
                      (ReplHighlight.init (ReplRange.init 8 9)
                                          (ReplHighlightKind.Local)))
    (analysis (ReplAnalysisState.Ready) facts)))

(defn initial []
  (ReplPaint.accept &(ReplPaint.init @"(fn [x] x)" [] false)
                    "(fn [x] x)"
                    &(ready)))

(defn at [paint start end]
  (let-do [spans (ReplPaint.spans paint)
           style 0]
    (for [i 0 (Array.length spans)]
      (let [span (Array.unsafe-nth spans i)
            range (ReplPaintSpan.range span)]
        (when (and (Int.= start @(ReplRange.start range))
                   (Int.= end @(ReplRange.end range)))
          (set! style @(ReplPaintSpan.style span)))))
    style))

(deftest test
  (assert-equal test 10 (at &(initial) 8 9) "exact semantic roles produce paint")
  (assert-equal test
    10
    (at &(ReplPaint.rebase &(initial) "(fn [x] x) ") 8 9)
    "untouched spans retain paint while a revision is pending")
  (assert-true test
    @(ReplPaint.provisional &(ReplPaint.rebase &(initial) "(fn [x] x) "))
    "rebased paint is explicitly provisional")
  (assert-equal test
    0
    (at &(ReplPaint.rebase &(initial) "(fn [y] x)") 5 6)
    "editing a token invalidates its old presentation span")
  (assert-equal test
    10
    (at &(ReplPaint.rebase &(initial) "(fn [y] x)") 8 9)
    "unmodified formatting remains provisional until current semantics arrive")
  (assert-equal test
    10
    (at
      &(ReplPaint.accept
        &(ReplPaint.rebase &(initial) "(fn [x] x) ")
        "(fn [x] x) "
        &(analysis (ReplAnalysisState.SyntaxOnly) (lexical)))
      8
      9)
    "reader-only replies do not downgrade intact semantic formatting")
  (assert-equal test
    0
    (at
      &(ReplPaint.accept
        &(ReplPaint.rebase &(initial) "(fn [y] x)")
        "(fn [y] x)"
        &(analysis (ReplAnalysisState.Partial) (lexical)))
      8
      9)
    "current partial semantics replace provisional formatting even when a name becomes unknown")
  (assert-false test
    @(ReplPaint.provisional
      &(ReplPaint.accept &(initial)
                         "(fn [x] x)"
                         &(analysis
                           (ReplAnalysisState.Unavailable @"stopped")
                           (lexical))))
    "unavailable semantics cannot preserve provisional facts indefinitely")
  (assert-equal test
    0
    (at
      &(ReplPaint.accept
        &(ReplPaint.rebase &(initial) ";(fn [x] x)")
        ";(fn [x] x)"
        &(analysis (ReplAnalysisState.SyntaxOnly)
                   [(ReplHighlight.init (ReplRange.init 0 11)
                                        (ReplHighlightKind.Comment))]))
      9
      10)
    "reader categories override cached roles when source becomes a comment")
  (assert-equal test
    10
    (at &(ReplPaint.rebase &(initial) "λ (fn [x] x)") 11 12)
    "UTF-8 prefix edits translate surviving byte ranges")
  (assert-equal test
    0
    (at
      &(ReplPaint.rebase
        &(ReplPaint.init @"(fn [α] α)"
                         [(ReplPaintSpan.init (ReplRange.init 5 7) 10 true)]
                         false)
        "(fn [β] α)")
      5
      7)
    "shared UTF-8 leading bytes do not preserve an edited token")
  (assert-equal test
    10
    (at
      &(ReplPaint.rebase
        &(ReplPaint.init @"(fn [α] α)"
                         [(ReplPaintSpan.init (ReplRange.init 9 11) 10 true)]
                         false)
        "(fn [β] α)")
      9
      11)
    "UTF-8 suffix ranges remain on character boundaries")
  (assert-equal test
    10
    (at &(ReplPaint.rebase &(initial) "(fn [x]  x)") 9 10)
    "whitespace inserted immediately before a symbol translates its paint")
  (assert-equal test
    10
    (at &(ReplPaint.rebase &(initial) "(fn [x] x )") 8 9)
    "whitespace inserted immediately after a symbol preserves its paint")
  (assert-equal test
    0
    (at
      &(ReplPaint.accept
        &(ReplPaint.rebase &(initial) "(fn [x] xx)")
        "(fn [x] xx)"
        &(analysis (ReplAnalysisState.SyntaxOnly)
                   [(ReplHighlight.init (ReplRange.init 8 10)
                                        (ReplHighlightKind.Symbol))]))
      8
      9)
    "reader token boundaries invalidate a role when a symbol is extended"))
