; glibc gates wcwidth behind X/Open; retain the runtime's default interfaces.
(when (= (host-os) "linux") (add-cflag "-D_XOPEN_SOURCE=700 -D_DEFAULT_SOURCE"))

(system-include "wchar.h")
(system-include "locale.h")

(doc ReplTextWidth
  "shares terminal column measurements between layout and indentation.")
(defmodule ReplTextWidth
  (private native)
  (hidden native)
  ; Source is UTF-8 whatever the process locale is, and glibc's wcwidth knows
  ; no character beyond ASCII in the C locale every program starts in. Measure
  ; under C.UTF-8 when the system has it; macOS's C locale already measures
  ; Unicode, so plain wcwidth is the fallback.
  (deftemplate native (Fn [Char] Int) "int $NAME(Char c)" "$DECL {
  static locale_t utf8 = (locale_t)0;
  if (utf8 == (locale_t)0) utf8 = newlocale(LC_CTYPE_MASK, \"C.UTF-8\", (locale_t)0);
  if (utf8 == (locale_t)0) return wcwidth((wchar_t)c);
  locale_t previous = uselocale(utf8);
  int width = wcwidth((wchar_t)c);
  uselocale(previous);
  return width;
}")

  (doc character "measures the editor's rendered width of one source character.")
  (defn character [c]
    (let [code (Char.to-int c)]
      (cond
        (Int.= code 9) 4
        (or (Int.< code 32) (Int.= code 127)) 2
        (Int.max 0 (native c)))))

  (doc column "measures a source position from its logical line's beginning.")
  (defn column [source position]
    (let-do [start position
             width 0]
      (while-do (and (Int.> start 0)
                     (not
                       (Char.= (String.char-at source (Int.dec start)) \newline)))
        (set! start (Int.dec start)))
      (let [characters (String.chars &(String.byte-slice source start position))]
        (for [i 0 (Array.length &characters)]
          (set! width
                (Int.+ width (character @(Array.unsafe-nth &characters i))))))
      width)))
