(system-include "wchar.h")

(doc ReplTextWidth
  "shares terminal column measurements between layout and indentation.")
(defmodule ReplTextWidth
  (private native)
  (hidden native)
  (register native (Fn [Char] Int) "wcwidth")

  (doc character "measures the editor's rendered width of one source character.")
  (defn character [c]
    (let [code (Char.to-int c)]
      (cond
        (Int.= code 9) 4
        (or (Int.< code 32) (Int.= code 127)) 2
        (Int.max 0 (native c)))))

  (doc column "measures a source position from its logical line's beginning.")
  (defn column [source position]
    (let-do [start position
             width 0]
      (while-do (and (Int.> start 0)
                     (not
                       (Char.= (String.char-at source (Int.dec start)) \newline)))
        (set! start (Int.dec start)))
      (let [characters (String.chars &(String.byte-slice source start position))]
        (for [i 0 (Array.length &characters)]
          (set! width
                (Int.+ width (character @(Array.unsafe-nth &characters i))))))
      width)))
