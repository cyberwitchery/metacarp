(load "../carp-source/carp-source.carp")

(deftype ReplEntry
  [number Int
   input SourceInput
   status String
   definitions (Array String)
   dependencies (Array String)
   stale Bool])

(doc ReplJournal
  "The input transcript and dependency status, separate from active source.")
(defmodule ReplJournal
  (doc render
    "Shows failed and superseded inputs as well as active definitions.")
  (defn render [entries]
    (let-do [lines (the (Array String) [])]
      (for [i 0 (Array.length entries)]
        (let [entry (Array.unsafe-nth entries i)]
          (Array.push-back! &lines
                            (fmt "%d [%s%s]  %s"
                                 @(ReplEntry.number entry)
                                 (ReplEntry.status entry)
                                 (if @(ReplEntry.stale entry) ", stale" "")
                                 (SourceInput.source (ReplEntry.input entry))))))
      (String.join "
" &lines)))

  (doc affected
    "Computes conservative transitive input impact from resolved names.")
  (defn affected [entries names]
    (let-do [changed (Array.copy names)
             affected (the (Array Int) [])
             progress true]
      (while-do progress
        (set! progress false)
        (for [i 0 (Array.length entries)]
          (let-do [entry (Array.unsafe-nth entries i)
                   hit false]
            (for [d 0 (Array.length (ReplEntry.dependencies entry))]
              (when (Array.contains? &changed
                                     (Array.unsafe-nth (ReplEntry.dependencies entry)
                                                       d))
                (set! hit true)))
            (when-do (and hit
                          (not
                            (Array.contains? &affected (ReplEntry.number entry))))
              (Array.push-back! &affected @(ReplEntry.number entry))
              (for [d 0 (Array.length (ReplEntry.definitions entry))]
                (let [name (Array.unsafe-nth (ReplEntry.definitions entry) d)]
                  (unless (Array.contains? &changed name)
                    (Array.push-back! &changed (String.copy name)))))
              (set! progress true)))))
      affected))

  (doc transcript "Exports caller source, with entry statuses as comments.")
  (defn transcript [entries]
    (let-do [parts (the (Array String) [])]
      (for [i 0 (Array.length entries)]
        (let [entry (Array.unsafe-nth entries i)]
          (Array.push-back! &parts (fmt "; input %d: %s%s
%s
" @(ReplEntry.number entry) (ReplEntry.status entry) (if @(ReplEntry.stale entry)
                                          ", stale"
                                          "") (SourceInput.source (ReplEntry.input entry))))))
      (String.join "
" &parts))))
