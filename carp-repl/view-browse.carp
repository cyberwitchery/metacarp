(load "view-query.carp")
(load "view-decode.carp")
(load "view-native.carp")

(doc ReplBrowseOwner "is a view the engine keeps open for browsing. `handle`
identifies it to the client. `object` is its view object. `result` is the
number of the result it shows. `query` is the index of the compiled view
function that serves it, or -1 if there is none. `original` is the native view
of the value, if it has one. `request` and `columns` are the request and the
width it was opened with. `choices` are the views the client can switch to.")
(deftype ReplBrowseOwner
  [handle ReplViewHandle
   object Int
   result Int
   query Int
   original (Maybe NativeView)
   request InspectRequest
   columns Int
   choices (Array ReplViewChoice)])
