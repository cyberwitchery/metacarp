(load "view-query.carp")
(load "view-decode.carp")
(load "view-native.carp")

(deftype ReplBrowseInput
  [source Long
   request InspectRequest
   generation Long
   operation Int
   object Int
   row Int
   columns Int])
(deftype ReplBrowseQuery
  [key String
   input (Ptr ReplBrowseInput)
   prepared ReplPreparedResult])
(deftype ReplBrowseOwner
  [handle ReplViewHandle
   object Int
   result Int
   query Int
   original (Maybe NativeView)
   request InspectRequest
   columns Int
   choices (Array ReplViewChoice)])

(defmodule ReplViewQueries
  (doc browse-source "builds a query over host-owned request channels. Root
providers run only when opening a root; subsequent operations use its leases.")
  (defn browse-source [channel type provider]
    (let-do [input (Pointer.to-ref channel)
             request (ReplBrowseInput.request input)
             generation (read-field "Long"
                                    (Pointer.to-long
                                      (Pointer.address (ReplBrowseInput.generation input)))
                                    false)
             operation (read-field "Int"
                                   (Pointer.to-long
                                     (Pointer.address (ReplBrowseInput.operation input)))
                                   false)
             object (read-field "Int"
                                (Pointer.to-long
                                  (Pointer.address (ReplBrowseInput.object input)))
                                false)
             row (read-field "Int"
                             (Pointer.to-long
                               (Pointer.address (ReplBrowseInput.row input)))
                             false)
             columns (read-field "Int"
                                 (Pointer.to-long
                                   (Pointer.address (ReplBrowseInput.columns input)))
                                 false)
             window (fmt "(View.request (copy %s) %s %s 6 %s)"
                         &(read-field "String"
                                      (Pointer.to-long
                                        (Pointer.address (InspectRequest.view request)))
                                      true)
                         &(read-field "Int"
                                      (Pointer.to-long
                                        (Pointer.address (InspectRequest.offset request)))
                                      false)
                         &(read-field "Int"
                                      (Pointer.to-long
                                        (Pointer.address (InspectRequest.count request)))
                                      false)
                         &(read-field "Int"
                                      (Pointer.to-long
                                        (Pointer.address (InspectRequest.bytes request)))
                                      false))]
      (fmt
        "(if (Int.= %s 0) (let [value (Pointer.to-ref (the (Ptr %s) (Pointer.from-long %s)))] (ReplView.open %s value &(%s value) &%s %s)) (ReplView.operate %s %s %s %s &%s %s))"
        &operation
        type
        &(read-field "Long"
                     (Pointer.to-long
                       (Pointer.address (ReplBrowseInput.source input)))
                     false)
        &generation
        provider
        &window
        &columns
        &generation
        &operation
        &object
        &row
        &window
        &columns)))

  (doc clear-browse-queries! "releases typed result storage and channels while
their publication code and cleanup callbacks are still live.")
  (defn clear-browse-queries! [queries]
    (do
      (for [i (Array.length queries) 0 -1]
        (let-do [query (Array.unsafe-nth queries (Int.dec i))
                 prepared (ReplBrowseQuery.prepared query)
                 input @(ReplBrowseQuery.input query)]
          (ReplValues.reset-slot! @(ReplPreparedResult.slot prepared))
          (ReplValues.discard-slot @(ReplPreparedResult.slot prepared))
          (let [-owned (Pointer.to-value input)] (Pointer.free input))))
      (while-do (not (Array.empty? queries)) (ignore (Array.pop-back! queries))))))
