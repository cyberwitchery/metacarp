(load "protocol.carp")

(doc ReplSyntax "contains source-independent editing operations.")
(defmodule ReplSyntax
  (defn common-prefix [names]
    (if (Array.empty? names)
      (String.copy "")
      (let-do [prefix (String.chars (Array.unsafe-nth names 0))]
        (for [i 1 (Array.length names)]
          (let-do [candidate (String.chars (Array.unsafe-nth names i))
                   count 0
                   maximum (Int.min (Array.length &prefix)
                                    (Array.length &candidate))]
            (while-do (and (Int.< count maximum)
                           (Char.= @(Array.unsafe-nth &prefix count)
                                   @(Array.unsafe-nth &candidate count)))
              (set! count (Int.inc count)))
            (set! prefix (Array.take count &prefix))))
        (String.from-chars &prefix)))))
