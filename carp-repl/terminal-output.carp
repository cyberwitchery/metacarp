; Loaded by terminal.carp. Output owns neither compiler state nor native values.
(load "pager.carp")

(deftype ReplPagerState
  [anchor Int
   query String
   searching Bool
   found Int
   message String])

(defmodule ReplTerminal
  (defn- output-key [editor milliseconds]
    (if @(ReplEditor.cancelled (state editor))
      3
      (let-do [_ (receive-signals editor)
               descriptors (the (Ptr ReplNativeFdSet)
                                (ReplNative.allocate
                                  (Pointer.width
                                    (the (Ptr ReplNativeFdSet)
                                         (Pointer.from-long 0l)))))
               timeout (the (Ptr ReplNativeTimeout)
                            (ReplNative.allocate
                              (Pointer.width
                                (the (Ptr ReplNativeTimeout)
                                     (Pointer.from-long 0l)))))
               key -1]
        (ReplNative.clear-fds descriptors)
        (ReplNative.add-fd 0 descriptors)
        (ReplNativeTimeout.set-tv_sec! (Pointer.to-ref timeout) 0l)
        (ReplNativeTimeout.set-tv_usec! (Pointer.to-ref timeout)
                                        (Int.* milliseconds 1000))
        (let [ready (if (queued-input? editor)
                1
                (ReplNative.select 1
                                   descriptors
                                   (Pointer.from-long 0l)
                                   (Pointer.from-long 0l)
                                   timeout))]
          (cond
            (or (queued-input? editor) (Int.> ready 0))
              (when (Int.<=
                  (read-codepoint editor (Pointer.address &key) false)
                  0)
                (set! key -1))
            (or (Int.= ready 0)
                (Int.= (Pointer.to-value (ReplEdit.errno)) ReplEdit.INTERRUPTED))
              (set! key -2)
            ()))
        (ReplNative.release timeout)
        (ReplNative.release descriptors)
        key)))

  (defn- output-escape [editor]
    (let [first (output-key editor 40)]
      (cond
        (or (Int.= first 91) (Int.= first 79))
          (let [next (output-key editor 40)]
            (cond
              (Int.= next 65) 301
              (Int.= next 66) 302
              (Int.= next 68) 307
              (Int.= next 67) 308
              (Int.= next 72) 303
              (Int.= next 70) 304
              (or (Int.= next 53) (Int.= next 54))
                (let [end (output-key editor 40)]
                  (if (Int.= end 126) (if (Int.= next 53) 305 306) -2))
              -2))
        (Int.= first -2) 27
        -2)))

  (defn- output-search! [state text backwards]
    (let [query (ReplPagerState.query state)]
      (unless (String.empty? query)
        (match (ReplPager.find text
                               query
                               (if (Int.>= @(ReplPagerState.found state) 0)
                                 @(ReplPagerState.found state)
                                 (Int.dec @(ReplPagerState.anchor state)))
                               backwards)
          (Maybe.Nothing)
            (ReplPagerState.set-message! state
                                         (String.append "not found: " query))
          (Maybe.Just position)
            (do
              (ReplPagerState.set-anchor! state position)
              (ReplPagerState.set-found! state position))))))

  (defn- output-edit-search! [state key text]
    (cond
      (or (Int.= key 13) (Int.= key 10))
        (do
          (ReplPagerState.set-searching! state false)
          (ReplPagerState.set-found! state -1)
          (output-search! state text false))
      (Int.= key 27) (ReplPagerState.set-searching! state false)
      (or (Int.= key 127) (Int.= key 8))
        (let [characters (String.chars (ReplPagerState.query state))]
          (ReplPagerState.set-query! state
                                     (String.from-chars
                                       &(Array.slice &characters
                                                     0
                                                     (Int.max 0
                                                              (Int.dec (Array.length &characters)))))))
      (and (Int.>= key 32)
           (Int.< (String.length (ReplPagerState.query state)) 256))
        (ReplPagerState.set-query! state
                                   (String.append (ReplPagerState.query state)
                                                  &(String.from-chars &[(Char.from-int key)])))
      ()))

  (defn- output-step! [state layout key height text]
    (cond
      (or (Int.= key -1) (or (Int.= key 3) (Int.= key 4))) false
      @(ReplPagerState.searching state)
        (do (output-edit-search! state key text) true)
      (or (Int.= key 113) (Int.= key 27)) false
      (do
        (ReplPagerState.set-message! state @"")
        (cond
          (Int.= key 47)
            (do
              (ReplPagerState.set-searching! state true)
              (ReplPagerState.set-query! state @""))
          (or (Int.= key 110) (Int.= key 78))
            (output-search! state text (Int.= key 78))
          (do
            (ReplPagerState.set-found! state -1)
            (let [anchor @(ReplPagerState.anchor state)
                  page (Int.max 1 (Int.- height 2))
                  rows (Array.length (ReplPagerLayout.lines layout))]
              (ReplPagerState.set-anchor! state
                                          (cond
                                            (or (Int.= key 103) (Int.= key 303))
                                              0
                                            (or (Int.= key 71) (Int.= key 304))
                                              (ReplPager.move layout
                                                              0
                                                              rows
                                                              height)
                                            (or (Int.= key 32)
                                                (or (Int.= key 6)
                                                    (Int.= key 306)))
                                              (ReplPager.move layout
                                                              anchor
                                                              page
                                                              height)
                                            (or (Int.= key 98)
                                                (or (Int.= key 2)
                                                    (Int.= key 305)))
                                              (ReplPager.move layout
                                                              anchor
                                                              (Int.- 0 page)
                                                              height)
                                            (or (Int.= key 106)
                                                (or (Int.= key 302)
                                                    (or (Int.= key 13)
                                                        (Int.= key 10))))
                                              (ReplPager.move layout
                                                              anchor
                                                              1
                                                              height)
                                            (or (Int.= key 107) (Int.= key 301))
                                              (ReplPager.move layout
                                                              anchor
                                                              -1
                                                              height)
                                            anchor)))))
        true)))

  (defn- output-loop [editor text]
    (let-do [size (dimensions)
             layout (ReplPager.layout text @(Pair.a &size))
             state (ReplPagerState.init 0 @"" false -1 @"")
             previous (the (Array ReplDisplayRow) [])
             cursor 0
             running true
             dirty true]
      (prepare-character-input)
      (while-do running
        (let-do [current (dimensions)
                 resized (or
                   (Int./= @(Pair.a &size) @(Pair.a &current))
                   (Int./= @(Pair.b &size) @(Pair.b &current)))]
          (when-do resized
            (set! size current)
            (set! layout (ReplPager.layout text @(Pair.a &size)))
            (IO.print "\r\u001b[H\u001b[J")
            (set! previous [])
            (set! cursor 0)
            (set! dirty true))
          (when-do dirty
            (let-do [status (if @(ReplPagerState.searching &state)
                       (String.append "/" (ReplPagerState.query &state))
                       @(ReplPagerState.message &state))
                     frame (ReplPager.frame &layout
                                            @(ReplPagerState.anchor &state)
                                            @(Pair.a &size)
                                            @(Pair.b &size)
                                            &status)
                     update (ReplDisplay.patch &previous
                                               cursor
                                               &frame
                                               @(Pair.a &size))]
              (IO.print &update)
              (IO.Raw.fflush! IO.Raw.stdout)
              (set! previous @(ReplFrame.rows &frame))
              (set! cursor @(ReplFrame.cursor-row &frame)))
            (set! dirty false))
          (let-do [input (output-key editor 100)
                   key (if (Int.= input 27) (output-escape editor) input)]
            (unless-do (Int.= key -2)
              (set! dirty true)
              (set! running
                    (output-step! &state &layout key @(Pair.b &size) text))))))))

  ; el_gets owns signal installation and tty restoration while this callback
  ; runs. Its nested character reads use libedit's built-in Unicode decoder.
  (defn- output-reader [editor destination]
    (let-do [source @(ReplEditor.output-source (state editor))]
      (ignore
        (ReplEdit.set-wide-pointer editor ReplEdit.GETCFN (Pointer.from-long 0l)))
      (let [browser @(ReplEditor.output-browser (state editor))]
        (if (null? browser)
          (output-loop editor (Pointer.to-ref source))
          (browse-loop editor (Pointer.to-ref browser))))
      (Pointer.set destination 13)
      1))

  (defn- page-output [terminal text]
    (let-do [data (Pointer.to-ref terminal)
             editor @(ReplEditor.editor data)
             count 0]
      (ReplEdit.reset editor)
      (ReplEditor.set-output-source! data (Pointer.address text))
      (ignore
        (ReplEdit.set-wide-pointer editor
                                   ReplEdit.GETCFN
                                   (Function.unsafe-ptr &output-reader)))
      (ignore (read-native editor (Pointer.address &count)))
      (ignore
        (ReplEdit.set-wide-pointer editor
                                   ReplEdit.GETCFN
                                   (Function.unsafe-ptr &read-character)))
      (ReplEditor.set-output-source! data (Pointer.from-long 0l))
      (ReplEdit.reset editor)
      (IO.print "\r\n")
      (IO.Raw.fflush! IO.Raw.stdout)))

  (doc output "presents output through the bounded viewer when it exceeds an
interactive terminal. Pipes and simple terminals receive the original text.")
  (defn output [terminal text]
    (if (or (null? terminal)
            (not
              @(ReplPresentation.rich
                (ReplEditor.presentation (Pointer.to-ref terminal)))))
      (IO.println text)
      (let [size (dimensions)]
        (let [layout (ReplPager.layout text @(Pair.a &size))]
          (if (Int.>
              (Array.length (ReplPagerLayout.lines &layout))
              (Int.dec @(Pair.b &size)))
            (page-output terminal text)
            (IO.println text)))))))
