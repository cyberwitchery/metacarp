; Owned presentation data. Compiler objects and value-storage addresses stay
; behind the client. A future execution worker can transport the same pages
; and requests; native view callbacks execute inside that worker.
(deftype ReplViewHandle [generation Long
                         id Long])
(deftype ReplViewChoice [selector String
                         title String
                         kind String
                         priority Int])
(deftype ReplViewItem [index Int
                       cells (Array String)
                       selectable Bool])
(deftype ReplViewImage
  [width Int
   height Int
   sample-width Int
   sample-height Int
   pixels (Array Byte)])
(deftype ReplViewPage
  [handle ReplViewHandle
   type String
   choices (Array ReplViewChoice)
   selector String
   title String
   kind String
   total Int
   offset Int
   text String
   columns (Array String)
   items (Array ReplViewItem)
   image ReplViewImage])

(deftype ReplViewOperation
  (Page [String Int Int Int Int])
  (Select [String Int])
  (Release []))
(deftype ReplViewRequest [handle ReplViewHandle
                          operation ReplViewOperation])
(deftype ReplViewClient
  [request (Fn [(Ref ReplViewRequest)] (Result ReplViewPage String))])

; Native query output is decoded through its publication's recorded layout.
(deftype ReplViewReply [page ReplViewPage
                        error String])
