(load "wire-macros.carp")

; the presentation types are also part of the jit prelude, so compiled views
; can build them. clients, which hold functions, stay in one process.
(doc ReplViewHandle "identifies an open view. `generation` is the engine
generation it belongs to. `id` identifies it within that generation.")
(doc ReplViewChoice "is a view the client can switch to. `selector`, `title`,
`kind` and `priority` are those of the view.")
(doc ReplViewItem "is an item of a list or columned view. `index` is its index.
`cells` are its columns. `selectable` is whether it can be opened.")
(doc ReplViewImage "is the bitmap of a bitmap view. `width` and `height` are its
size. `pixels` is a smaller RGBA copy of `sample-width` by `sample-height`
pixels, or empty.")
(doc ReplViewPage "is a page of a view, for the client. `handle` identifies the
open view. `type` is the type name of the value. `choices` are the views the
client can switch to. `selector`, `title` and `kind` are those of the shown
view. `total` is its number of items and `offset` the index of the first item on
the page. `text` is the content of a text view. `columns` are the column titles.
`items` are the items on the page. `image` is the bitmap of a bitmap view.")
(doc ReplViewOperation "is an operation on an open view. `Page` asks for a page
of the named view, with the offset, count, width and byte limit. `Select` opens
the item at an index of the named view. `Release` closes the view.")
(doc ReplViewRequest "applies `operation` to the view `handle`.")
(doc ReplViewReply "is the answer to a view request. `page` is the new page.
`error` is an error message, or empty.")
(doc ReplViewClient "sends view requests. `request` sends one and returns the
new page or an error.")
(defwire-group repl-views
               (deftype ReplViewHandle [generation Long
                                        id Long])
               (deftype ReplViewChoice
                 [selector String
                  title String
                  kind String
                  priority Int])
               (deftype ReplViewItem
                 [index Int
                  cells (Array String)
                  selectable Bool])
               (deftype ReplViewImage
                 [width Int
                  height Int
                  sample-width Int
                  sample-height Int
                  pixels (Array Byte)])
               (deftype ReplViewPage
                 [handle ReplViewHandle
                  type String
                  choices (Array ReplViewChoice)
                  selector String
                  title String
                  kind String
                  total Int
                  offset Int
                  text String
                  columns (Array String)
                  items (Array ReplViewItem)
                  image ReplViewImage])
               (deftype ReplViewOperation
                 (Page [String Int Int Int Int])
                 (Select [String Int])
                 (Release []))
               (deftype ReplViewRequest
                 [handle ReplViewHandle
                  operation ReplViewOperation])
               (deftype ReplViewReply [page ReplViewPage
                                       error String]))
(deftype ReplViewClient
  [request (Fn [(Ref ReplViewRequest)] (Result ReplViewPage String))])
