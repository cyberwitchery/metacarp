(load "wire-macros.carp")

; Owned presentation types are also embedded as plain declarations in the JIT
; prelude. Callback-bearing clients remain local to each process.
(defwire-group repl-views
               (deftype ReplViewHandle [generation Long
                                        id Long])
               (deftype ReplViewChoice
                 [selector String
                  title String
                  kind String
                  priority Int])
               (deftype ReplViewItem
                 [index Int
                  cells (Array String)
                  selectable Bool])
               (deftype ReplViewImage
                 [width Int
                  height Int
                  sample-width Int
                  sample-height Int
                  pixels (Array Byte)])
               (deftype ReplViewPage
                 [handle ReplViewHandle
                  type String
                  choices (Array ReplViewChoice)
                  selector String
                  title String
                  kind String
                  total Int
                  offset Int
                  text String
                  columns (Array String)
                  items (Array ReplViewItem)
                  image ReplViewImage])
               (deftype ReplViewOperation
                 (Page [String Int Int Int Int])
                 (Select [String Int])
                 (Release []))
               (deftype ReplViewRequest
                 [handle ReplViewHandle
                  operation ReplViewOperation])
               (deftype ReplViewReply [page ReplViewPage
                                       error String]))

(deftype ReplViewClient
  [request (Fn [(Ref ReplViewRequest)] (Result ReplViewPage String))])
