(system-include "pthread.h")
(system-include "time.h")
(system-include "fcntl.h")
(system-include "errno.h")
(system-include "stdlib.h")
(system-include "signal.h")
(register-type ReplNativeSignalSet "sigset_t")
(defmodule ReplNative
  (register signal-empty (Fn [(Ptr ReplNativeSignalSet)] Int) "sigemptyset")
  (register signal-add (Fn [(Ptr ReplNativeSignalSet) Int] Int) "sigaddset")
  (register signal-member (Fn [(Ptr ReplNativeSignalSet) Int] Int) "sigismember")
  (register signal-mask
    (Fn [Int (Ptr ReplNativeSignalSet) (Ptr ReplNativeSignalSet)] Int)
    "pthread_sigmask")
  (register signal-pending (Fn [(Ptr ReplNativeSignalSet)] Int) "sigpending")
  (register signal-wait (Fn [(Ptr ReplNativeSignalSet) (Ptr Int)] Int) "sigwait")
  (register raise-signal (Fn [Int] Int) "raise")
  (register SIGNAL-BLOCK Int "SIG_BLOCK")
  (register SIGNAL-SET Int "SIG_SETMASK")
  (register SIGNAL-INTERRUPT Int "SIGINT")
  (register SIGNAL-STOP Int "SIGTSTP")
  (register SIGNAL-QUIT Int "SIGQUIT")
  (register SIGNAL-HANGUP Int "SIGHUP")
  (register SIGNAL-TERMINATE Int "SIGTERM")
  (register SIGNAL-CONTINUE Int "SIGCONT")
  (register SIGNAL-RESIZE Int "SIGWINCH")

  (doc terminal-signals "the job-control signals whose handlers belong to the
terminal thread while libedit owns input.")
  (defn terminal-signals []
    [SIGNAL-INTERRUPT
     SIGNAL-STOP
     SIGNAL-QUIT
     SIGNAL-HANGUP
     SIGNAL-TERMINATE
     SIGNAL-CONTINUE
     SIGNAL-RESIZE]))

(system-include "sys/select.h")
(system-include "unistd.h")

(register-type ReplNativeThread "pthread_t")
(register-type ReplNativeAttributes "pthread_attr_t")
(register-type ReplNativeMutex "pthread_mutex_t")
(register-type ReplNativeCondition "pthread_cond_t")
(register-type ReplNativeFdSet "fd_set")
(register-type ReplNativeTimeout "struct timeval" [tv_sec Long
                                                   tv_usec Int])

(doc ReplNative "contains direct system primitives. Scheduling, ownership, and
analysis policy are implemented in Carp.")
(defmodule ReplNative
  (register allocate (Fn [Long] (Ptr a)) "malloc")
  (register release (Fn [(Ptr a)] ()) "free")
  (register attributes-init
    (Fn [(Ptr ReplNativeAttributes)] Int)
    "pthread_attr_init")
  (register attributes-stack
    (Fn [(Ptr ReplNativeAttributes) Long] Int)
    "pthread_attr_setstacksize")
  (register attributes-destroy
    (Fn [(Ptr ReplNativeAttributes)] Int)
    "pthread_attr_destroy")
  (register thread-create
    (Fn
      [(Ptr ReplNativeThread) (Ptr ReplNativeAttributes) (Ptr ()) (Ptr ())]
      Int)
    "pthread_create")
  (register thread-join
    (Fn [ReplNativeThread (Ptr (Ptr ()))] Int)
    "pthread_join")
  (register mutex-init
    (Fn [(Ptr ReplNativeMutex) (Ptr ())] Int)
    "pthread_mutex_init")
  (register mutex-destroy
    (Fn [(Ptr ReplNativeMutex)] Int)
    "pthread_mutex_destroy")
  (register mutex-lock (Fn [(Ptr ReplNativeMutex)] Int) "pthread_mutex_lock")
  (register mutex-unlock (Fn [(Ptr ReplNativeMutex)] Int) "pthread_mutex_unlock")
  (register condition-init
    (Fn [(Ptr ReplNativeCondition) (Ptr ())] Int)
    "pthread_cond_init")
  (register condition-destroy
    (Fn [(Ptr ReplNativeCondition)] Int)
    "pthread_cond_destroy")
  (register condition-wait
    (Fn [(Ptr ReplNativeCondition) (Ptr ReplNativeMutex)] Int)
    "pthread_cond_wait")
  (register condition-broadcast
    (Fn [(Ptr ReplNativeCondition)] Int)
    "pthread_cond_broadcast")
  (register flags (Fn [Int Int Int] Int) "fcntl")
  (register GET-FLAGS Int "F_GETFL")
  (register SET-FLAGS Int "F_SETFL")
  (register NONBLOCK Int "O_NONBLOCK")
  (register AGAIN Int "EAGAIN")
  (register FD-LIMIT Int "FD_SETSIZE")
  (register clear-fds (Fn [(Ptr ReplNativeFdSet)] ()) "FD_ZERO")
  (register add-fd (Fn [Int (Ptr ReplNativeFdSet)] ()) "FD_SET")
  (register has-fd (Fn [Int (Ptr ReplNativeFdSet)] Int) "FD_ISSET")
  (register select
    (Fn
      [Int
       (Ptr ReplNativeFdSet)
       (Ptr ReplNativeFdSet)
       (Ptr ReplNativeFdSet)
       (Ptr ReplNativeTimeout)]
      Int)
    "select")
  (register pipe (Fn [(Ptr Int)] Int) "pipe")
  (register read (Fn [Int (Ptr a) Long] Long) "read")
  (register write (Fn [Int (Ptr a) Long] Long) "write")
  (register close (Fn [Int] Int) "close")
  (register MONOTONIC Int "CLOCK_MONOTONIC_RAW")
  (register clock (Fn [Int] Long) "clock_gettime_nsec_np")

  (doc now "reads the monotonic system clock in nanoseconds.")
  (defn now [] (clock MONOTONIC))

  (doc block-terminal-signals "blocks terminal signals and returns the caller's
previous mask. The caller must restore and release the returned mask.")
  (defn block-terminal-signals []
    (let-do [mask (the (Ptr ReplNativeSignalSet)
                       (allocate
                         (Pointer.width
                           (the (Ptr ReplNativeSignalSet) (Pointer.from-long 0l)))))
             previous (the (Ptr ReplNativeSignalSet)
                           (allocate
                             (Pointer.width
                               (the (Ptr ReplNativeSignalSet)
                                    (Pointer.from-long 0l)))))
             signals (terminal-signals)]
      (ignore (signal-empty mask))
      (for [i 0 (Array.length &signals)]
        (ignore (signal-add mask @(Array.unsafe-nth &signals i))))
      (let-do [status (signal-mask SIGNAL-BLOCK mask previous)]
        (release mask)
        (if (Int.= status 0)
          (Result.Success previous)
          (do (release previous) (Result.Error status))))))

  (doc pending-terminal-signal
    "consumes one terminal signal newly blocked by the current scope.
Signals already blocked in previous remain owned by the caller. Zero means no
owned signal is pending; no asynchronous handler is installed.")
  (defn pending-terminal-signal [previous]
    (let-do [pending (the (Ptr ReplNativeSignalSet)
                          (allocate
                            (Pointer.width
                              (the (Ptr ReplNativeSignalSet)
                                   (Pointer.from-long 0l)))))
             selection (the (Ptr ReplNativeSignalSet)
                            (allocate
                              (Pointer.width
                                (the (Ptr ReplNativeSignalSet)
                                     (Pointer.from-long 0l)))))
             signals (terminal-signals)
             found 0]
      (ignore (signal-pending pending))
      (for [i 0 (Array.length &signals)]
        (when (and
            (and (Int.= found 0)
                 (Int.=
                   (signal-member previous @(Array.unsafe-nth &signals i))
                   0))
            (Int.= (signal-member pending @(Array.unsafe-nth &signals i)) 1))
          (let-do [signal @(Array.unsafe-nth &signals i)]
            (ignore (signal-empty selection))
            (ignore (signal-add selection signal))
            (ignore (signal-wait selection (Pointer.address &found))))))
      (release selection)
      (release pending)
      found))

  (doc thread-create-worker "creates a compiler worker with terminal signals
blocked from its first instruction. Restores the creator's mask before return.")
  (defn thread-create-worker [thread attributes callback context]
    (match (block-terminal-signals)
      (Result.Error status) status
      (Result.Success previous)
        (let-do [created (thread-create thread attributes callback context)]
          (ignore (signal-mask SIGNAL-SET previous (Pointer.from-long 0l)))
          (release previous)
          created))))
