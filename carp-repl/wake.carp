(load "native.carp")
(if (= (host-os) "linux")
  (do (system-include "sys/epoll.h") (system-include "sys/pidfd.h"))
  (system-include "sys/event.h"))
(doc ReplWakeTimeout "is C's `struct timespec`. `tv_sec` and `tv_nsec` are its
seconds and nanoseconds.")
(register-type ReplWakeTimeout "struct timespec" [tv_sec Long
                                                  tv_nsec Long])
(doc ReplWakeEvent "is an event of the wake queue: C's `struct epoll_event` on
Linux, with its event mask `events`, and `struct kevent` elsewhere.")
(if-linux
  (register-type ReplWakeEvent "struct epoll_event" [events Uint32])
  (register-type ReplWakeEvent "struct kevent"))
(if-linux
  (defmodule ReplWakeNative
    (register create (Fn [Int] Int) "epoll_create1")
    (register control (Fn [Int Int Int (Ptr ReplWakeEvent)] Int) "epoll_ctl")
    (register wait (Fn [Int (Ptr ReplWakeEvent) Int Int] Int) "epoll_wait")
    (register process-descriptor (Fn [Int Uint32] Int) "pidfd_open")
    (register ADD Int "EPOLL_CTL_ADD")
    (register READ Uint32 "EPOLLIN")
    (register ONCE Uint32 "EPOLLONESHOT")
    (register SET-FD Int "F_SETFD")
    (register CLOSE-ON-EXEC Int "FD_CLOEXEC"))
  (defmodule ReplWakeNative
    (register create (Fn [] Int) "kqueue")
    (register set
      (Fn [(Ptr ReplWakeEvent) Uint64 Int Int Int Long (Ptr ())] ())
      "EV_SET")
    (register event
      (Fn
        [Int
         (Ptr ReplWakeEvent)
         Int
         (Ptr ReplWakeEvent)
         Int
         (Ptr ReplWakeTimeout)]
        Int)
      "kevent")
    (register READ Int "EVFILT_READ")
    (register PROCESS Int "EVFILT_PROC")
    (register ADD Int "EV_ADD")
    (register ENABLE Int "EV_ENABLE")
    (register ONCE Int "EV_ONESHOT")
    (register EXIT Int "NOTE_EXIT")
    (register SET-FD Int "F_SETFD")
    (register CLOSE-ON-EXEC Int "FD_CLOEXEC")))

(doc ReplWake "is a wake queue: a descriptor that becomes readable while a
watched descriptor is readable or when a watched process exits. It is a kqueue
on macOS and the BSDs and an epoll instance on Linux. It stays the same when
the worker is replaced.")
(defmodule ReplWake
  (doc create "returns a new wake queue, or -1 if it cannot be created.")
  (defn create []
    (let [queue (if-linux (ReplWakeNative.create 0) (ReplWakeNative.create))]
      (cond
        (Int.< queue 0) -1
        (Int.>= queue ReplNative.FD-LIMIT)
          (do (ignore (ReplNative.close queue)) -1)
        (Int.=
          (ReplNative.flags queue
                            ReplWakeNative.SET-FD
                            ReplWakeNative.CLOSE-ON-EXEC)
          0)
          queue
        (do (ignore (ReplNative.close queue)) -1))))

  (defn- new-event []
    (the (Ptr ReplWakeEvent)
         (ReplNative.allocate
           (Pointer.width (the (Ptr ReplWakeEvent) (Pointer.from-long 0l))))))

  (if-linux
    (defn- watch [queue fd events]
      (let-do [change (new-event)]
        ; the event's data is never read back, so only its mask is set
        (ReplWakeEvent.set-events! (Pointer.to-ref change) events)
        (let-do [status (ReplWakeNative.control queue
                                                ReplWakeNative.ADD
                                                fd
                                                change)]
          (ReplNative.release change)
          (Int.= status 0))))
    (defn- watch [queue identifier filter flags notes]
      (let-do [change (new-event)]
        (ReplWakeNative.set change
                            (Uint64.from-long (Long.from-int identifier))
                            filter
                            flags
                            notes
                            0l
                            (Pointer.from-long 0l))
        (let-do [status (ReplWakeNative.event queue
                                              change
                                              1
                                              (Pointer.from-long 0l)
                                              0
                                              (Pointer.from-long 0l))]
          (ReplNative.release change)
          (Int.= status 0)))))

  (doc descriptor "watches `fd`, so `queue` is readable while `fd` is. Returns
whether the watch was installed.")
  (defn descriptor [queue fd]
    (if-linux (watch queue fd ReplWakeNative.READ)
              (watch queue
                     fd
                     ReplWakeNative.READ
                     (Int.bit-or ReplWakeNative.ADD ReplWakeNative.ENABLE)
                     0)))

  (doc process "watches the process `pid`, so `queue` wakes once when it exits.
Returns the descriptor of the watch, which the caller closes with the process,
or -1 if there is none. Returns `Nothing` if the watch cannot be installed.")
  (defn process [queue pid]
    (if-linux
      (let [owned (ReplWakeNative.process-descriptor pid (Uint32.from-long 0l))]
        (cond
          (Int.< owned 0) (the (Maybe Int) (Maybe.Nothing))
          (watch queue
                 owned
                 (Uint32.bit-or ReplWakeNative.READ ReplWakeNative.ONCE))
            (Maybe.Just owned)
          (do (ignore (ReplNative.close owned)) (Maybe.Nothing))))
      (if (watch queue
                 pid
                 ReplWakeNative.PROCESS
                 (Int.bit-or ReplWakeNative.ADD ReplWakeNative.ONCE)
                 ReplWakeNative.EXIT)
        (Maybe.Just -1)
        (Maybe.Nothing))))

  (doc acknowledge! "takes one pending event from `queue`, so a process exit
stops waking it. A readable descriptor wakes the queue until it is read.")
  (defn acknowledge! [queue]
    (when (Int.>= queue 0)
      (let-do [event (new-event)]
        (if-linux
          (ignore (ReplWakeNative.wait queue event 1 0))
          (let-do [timeout (the (Ptr ReplWakeTimeout)
                                (ReplNative.allocate
                                  (Pointer.width
                                    (the (Ptr ReplWakeTimeout)
                                         (Pointer.from-long 0l)))))]
            (ReplWakeTimeout.set-tv_sec! (Pointer.to-ref timeout) 0l)
            (ReplWakeTimeout.set-tv_nsec! (Pointer.to-ref timeout) 0l)
            (ignore
              (ReplWakeNative.event queue
                                    (Pointer.from-long 0l)
                                    0
                                    event
                                    1
                                    timeout))
            (ReplNative.release timeout)))
        (ReplNative.release event)))))
