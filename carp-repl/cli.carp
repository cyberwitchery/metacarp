(load "worker.carp")
(load "frontend.carp")

(load "terminal.carp")

(defn repl-help [terminal command]
  (repl-print terminal &(repl-help-text command)))

(defn repl-print [terminal text]
  (unless (String.empty? text) (ReplTerminal.output terminal text)))

(defn repl-error [diagnostic source]
  (do
    (IO.errorln
      &(fmt "%s: %s"
            (Diagnostic.phase diagnostic)
            (Diagnostic.message diagnostic)))
    (match-ref (Diagnostic.span diagnostic)
      (Maybe.Nothing) ()
      (Maybe.Just span)
        (if (String.empty? source)
          (IO.errorln
            &(fmt "  %s at byte %d"
                  (SourceSpan.source-id span)
                  @(SourceSpan.start span)))
          (let-do [position @(SourceSpan.start span)
                   length (String.length source)
                   line 1
                   start 0]
            (for [i 0 (Int.min position length)]
              (when-do (Char.= (String.char-at source i) \newline)
                (set! line (Int.inc line))
                (set! start (Int.inc i))))
            (IO.errorln
              &(fmt "  %s:%d:%d"
                    (SourceSpan.source-id span)
                    line
                    (Int.inc
                      (Array.length
                        &(String.chars
                          &(String.byte-slice source
                                              start
                                              (Int.min position length))))))))))))

(defn repl-abort? [source]
  (let [lines (String.lines &(ReplInput.trim source))]
    (String.=
      &(ReplInput.trim (Array.unsafe-nth &lines (Int.dec (Array.length &lines))))
      ":abort")))

(defn repl-needs-more? [source]
  (and (not (repl-abort? source))
       (and (ReplCommands.continue? source) (ReplInput.incomplete? source))))

(defn repl-local-command [remote terminal source]
  (let [input (ReplCommands.parse source)]
    (let-do [command (ReplCommandInput.name &input)
             argument (ReplCommandInput.arguments &input)
             offline (not (ReplRemoteHost.online? remote))
             checkpoint (ReplRemote.checkpoint remote)]
      (cond
        (String.= command ":help")
          (do (repl-help terminal "metacarp repl") true)
        (String.= command ":reinit")
          (do (ReplFrontend.reinitialize! remote terminal) true)
        (and offline (String.= command ":history"))
          (do
            (repl-print terminal
                        &(ReplJournal.render (ReplCheckpoint.entries checkpoint)))
            true)
        (and offline (String.= command ":defs"))
          (do (repl-print terminal (ReplCheckpoint.definitions checkpoint)) true)
        (and offline
             (or (String.= command ":export")
                 (String.= command ":export-transcript")))
          (do
            (match (IO.write-file
                &(ReplCheckpoints.source checkpoint
                                         (String.= command ":export-transcript"))
                &(ReplInput.trim argument))
              (Result.Error error) (IO.errorln &error)
              (Result.Success _)
                (repl-print terminal &(fmt "exported %s" argument)))
            true)
        (and offline (String.= command ":reset"))
          (do
            (ReplCheckpoint.set-inputs! checkpoint [])
            (ReplCheckpoint.set-projected! checkpoint [])
            (ReplCheckpoint.set-definitions! checkpoint @"")
            (repl-print terminal "session reset; use :reinit to start execution")
            true)
        false))))

(defn repl-cancel [remote terminal interactive]
  (do
    (when (ReplRemoteHost.online? remote)
      (ReplFrontend.report! remote
                            terminal
                            (ReplFrontend.request remote
                                                  terminal
                                                  &(ReplWorkerRequest.CancelEdit)
                                                  false
                                                  1000000000l)))
    (when interactive (IO.println ""))))

(defn repl-submit [remote terminal source]
  (unless (and (ReplCommands.command? source)
               (repl-local-command remote terminal source))
    (if (ReplRemoteHost.online? remote)
      (ReplFrontend.report! remote
                            terminal
                            (ReplFrontend.request remote
                                                  terminal
                                                  &(ReplWorkerRequest.Command @source)
                                                  true
                                                  0l))
      (IO.errorln
        "repl: execution worker is stopped; source is retained. Use :reinit."))))

(defn repl-loop [pointer interactive history-path]
  (let-do [remote (Pointer.to-ref pointer)
           terminal (ReplTerminal.create repl-needs-more?
                                         ReplIndentation.newline
                                         history-path
                                         (ReplRemoteHost.language-client pointer))
           _io (ReplTerminal.attach-io! terminal
                                        (ReplTerminalIO.init
                                          (fn []
                                            (ReplRemoteHost.read-output! (Pointer.to-ref pointer)))
                                          (fn []
                                            (ReplRemoteHost.take-byte! (Pointer.to-ref pointer)))))
           pending @""
           running true
           status 0]
    (while-do running
      (when (and interactive (ReplRemoteHost.online? remote))
        (ReplFrontend.report! remote
                              terminal
                              (ReplFrontend.resume! remote terminal)))
      (let-do [prompt (if interactive
                 (if (Int.> @(ReplRemote.editing remote) 0)
                   (fmt "λ[%d]> " @(ReplRemote.editing remote))
                   @"λ> ")
                 @"")
               read (ReplTerminal.read-input terminal &prompt &pending)]
        (when (and interactive (ReplRemoteHost.online? remote))
          (ReplFrontend.report! remote
                                terminal
                                (ReplFrontend.request remote
                                                      terminal
                                                      &(ReplWorkerRequest.Pause)
                                                      false
                                                      (match-ref &read
                                                        (ReplRead.Cancelled)
                                                          1000000000l
                                                        _ 0l))))
        (match read
          (ReplRead.Cancelled)
            (do (set! pending @"") (repl-cancel remote terminal interactive))
          (ReplRead.Error message)
            (do (IO.errorln &message) (set! status 1) (set! running false))
          (ReplRead.End)
            (do
              (unless (ReplInput.blank? &pending)
                (repl-submit remote terminal &pending))
              (unless (ReplInput.blank? &pending) (set! status 1))
              (when interactive (IO.println ""))
              (set! running false))
          (ReplRead.Line source)
            (cond
              (repl-abort? &source)
                (do (set! pending @"") (repl-cancel remote terminal false))
              (ReplInput.blank? &source) ()
              (and (not interactive) (repl-needs-more? &source))
                (set! pending source)
              (do
                (set! pending @"")
                (ReplTerminal.remember terminal &source)
                (let [name (ReplCommandInput.name &(ReplCommands.parse &source))]
                  (if (or (String.= name ":q") (String.= name ":quit"))
                    (set! running false)
                    (repl-submit remote terminal &source))))))))
    (ReplFrontend.shutdown! remote terminal)
    (ReplTerminal.dispose terminal)
    status))

(defn repl-run [core-dir history-path first]
  (let [scratch (ReplTerminal.scratch)]
    (if (String.empty? &scratch)
      (do (IO.errorln "repl: could not create JIT scratch directory") 1)
      (match (ReplProcessHost.executable)
        (Result.Error error) (do (IO.errorln &error) 1)
        (Result.Success program)
          (let-do [interactive (ReplTerminal.interactive?)
                   arguments (the (Array String) [])]
            (for [i 1 first]
              (Array.push-back! &arguments
                                @(StaticArray.unsafe-nth &System.args i)))

            (unless interactive
              (ignore
                (ReplProcessNative.set-buffer IO.Raw.stdin
                                              (Pointer.from-long 0l)
                                              ReplProcessNative.UNBUFFERED
                                              0l)))
            (let-do [remote (Pointer.unsafe-alloc
                       (ReplRemoteHost.create &program
                                              &arguments
                                              core-dir
                                              &scratch
                                              interactive))
                     started (ReplFrontend.start! (Pointer.to-ref remote)
                                                  (Pointer.from-long 0l))
                     status (match started
                       (Result.Error error) (do (IO.errorln &error) 1)
                       (Result.Success _)
                         (do
                           (when interactive
                             (IO.println "Metacarp REPL. :help for commands."))
                           (repl-loop remote interactive history-path)))]
              (ReplRemoteHost.dispose (Pointer.to-ref remote))
              (Pointer.free remote)
              (ignore (ReplTerminal.remove-directory &scratch))
              status))))))

(defn repl-main [first command]
  (if (and
      (Int.< first (StaticArray.length &System.args))
      (String.= (StaticArray.unsafe-nth &System.args first) "--repl-worker"))
    (if (Int.= (StaticArray.length &System.args) (Int.+ first 4))
      (ReplWorker.run
        (StaticArray.unsafe-nth &System.args (Int.inc first))
        (StaticArray.unsafe-nth &System.args (Int.+ first 2))
        (String.= (StaticArray.unsafe-nth &System.args (Int.+ first 3)) "1"))
      2)
    (let-do [core (match (IO.getenv "CARP_DIR")
               (Maybe.Just root) (String.append &root "/core")
               (Maybe.Nothing) (String.copy ""))
             history (match (IO.getenv "METACARP_HISTORY")
               (Maybe.Just path) path
               (Maybe.Nothing)
                 (match (IO.getenv "XDG_STATE_HOME")
                   (Maybe.Just root) (String.append &root "/metacarp/history")
                   (Maybe.Nothing)
                     (match (IO.getenv "HOME")
                       (Maybe.Just root)
                         (String.append &root "/.local/state/metacarp/history")
                       (Maybe.Nothing) (String.copy ""))))
             help false
             valid true
             i first
             count (StaticArray.length &System.args)]
      (while-do (Int.< i count)
        (let [argument (StaticArray.unsafe-nth &System.args i)]
          (cond
            (or (String.= argument "--help") (String.= argument "-h"))
              (set! help true)
            (String.= argument "--no-history") (set! history (String.copy ""))
            (String.= argument "--history")
              (if (Int.< (Int.inc i) count)
                (do
                  (set! i (Int.inc i))
                  (set! history
                        (String.copy (StaticArray.unsafe-nth &System.args i))))
                (do
                  (IO.errorln "repl: --history needs a file")
                  (set! valid false)))
            (or (String.= argument "--core") (String.= argument "-c"))
              (if (Int.< (Int.inc i) count)
                (do
                  (set! i (Int.inc i))
                  (set! core
                        (String.copy (StaticArray.unsafe-nth &System.args i))))
                (do
                  (IO.errorln "repl: --core needs a directory")
                  (set! valid false)))
            (do
              (IO.errorln &(fmt "repl: unknown option %s" argument))
              (set! valid false))))
        (set! i (Int.inc i)))
      (cond
        (not valid) 2
        help
          (do
            (repl-help (the (Ptr ReplEditor) (Pointer.from-long 0l)) command)
            0)
        (String.empty? &core)
          (do (IO.errorln "repl: set CARP_DIR or pass --core <dir>") 2)
        (repl-run &core &history first)))))
