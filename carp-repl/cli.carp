(load "engine.carp")
(load "language.carp")
(load "terminal.carp")

(defn repl-help [terminal command]
  (repl-print terminal
              &(String.concat
                &[(fmt
                    "usage: %s [--core <dir>] [--history <file> | --no-history]"
                    command)
                  @"

Core defaults to $CARP_DIR/core. Requires macOS, LLVM, and clang.

"
                  (ReplCommands.help)
                  @"

Enter submits complete input; incomplete input continues on a new line.
Ctrl-J inserts a newline; Alt-Enter forces submission for a diagnostic.
Up/Down recall history; arrows, Home/End, Ctrl-A/E, Ctrl-W/K/Y edit.
Ctrl-R searches history. Ctrl-_ undoes buffer changes.
Tab completes the symbol at the cursor; F1 shows docs; F2 checks without
executing. Feedback disappears when its source or cursor changes.
Pasted newlines stay editable. Ctrl-C cancels; Ctrl-D exits an empty prompt.
NO_COLOR disables highlighting.

History persists at $METACARP_HISTORY, or under $XDG_STATE_HOME/metacarp
(default $HOME/.local/state/metacarp). Loading history never evaluates it.
Owned results have _1, _2, ... aliases; _ is the newest, with 32 live slots.
Owned aliases borrow their values; scalar aliases copy. Use @ to copy an owner.
Replacing definitions, compile-time declarations, removal, and reset release
live results and reset native globals. Unrelated runtime additions preserve them.
Compiler failures preserve accepted definitions; runtime effects cannot roll back."])))

(defn repl-print [terminal text]
  (unless (String.empty? text) (ReplTerminal.output terminal text)))

(defn repl-error [diagnostic source]
  (do
    (IO.errorln
      &(fmt "%s: %s"
            (Diagnostic.phase diagnostic)
            (Diagnostic.message diagnostic)))
    (match-ref (Diagnostic.span diagnostic)
      (Maybe.Nothing) ()
      (Maybe.Just span)
        (if (String.empty? source)
          (IO.errorln
            &(fmt "  %s at byte %d"
                  (SourceSpan.source-id span)
                  @(SourceSpan.start span)))
          (let-do [position @(SourceSpan.start span)
                   length (String.length source)
                   line 1
                   start 0]
            (for [i 0 (Int.min position length)]
              (when-do (Char.= (String.char-at source i) \newline)
                (set! line (Int.inc line))
                (set! start (Int.inc i))))
            (IO.errorln
              &(fmt "  %s:%d:%d"
                    (SourceSpan.source-id span)
                    line
                    (Int.inc
                      (Array.length
                        &(String.chars
                          &(String.byte-slice source
                                              start
                                              (Int.min position length))))))))))))

(defn repl-answer [terminal engine answer source]
  (match answer
    (Result.Success text) (repl-print terminal &text)
    (Result.Error diagnostic)
      (repl-error &diagnostic
                  &(ReplEngine.error-source engine &diagnostic source))))

(defn repl-command [engine source terminal]
  (let-do [input (ReplCommands.parse source)
           command (ReplCommandInput.name &input)
           argument @(ReplCommandInput.arguments &input)
           arguments (String.words &argument)
           name (String.join " " &arguments)]
    (cond
      (or (String.= command ":quit") (String.= command ":q")) false
      (String.= command ":help") (do (repl-help terminal "metacarp repl") true)
      (String.= command ":abort") true
      (String.= command ":defs")
        (do (repl-print terminal &(ReplEngine.definitions engine)) true)
      (String.= command ":reset")
        (do
          (repl-answer terminal engine (ReplEngine.reset engine) &argument)
          true)
      (String.= command ":type")
        (do
          (repl-answer terminal
                       engine
                       (ReplEngine.type-of engine &argument)
                       &argument)
          true)
      (String.= command ":expand")
        (do
          (repl-answer terminal
                       engine
                       (ReplEngine.expand engine &argument)
                       &argument)
          true)
      (String.= command ":expand-1")
        (do
          (repl-answer terminal
                       engine
                       (ReplEngine.expand-once engine &argument)
                       &argument)
          true)
      (String.= command ":ownership")
        (do
          (repl-answer terminal
                       engine
                       (ReplEngine.ownership engine &name)
                       &argument)
          true)
      (String.= command ":c")
        (do
          (repl-answer terminal
                       engine
                       (ReplEngine.emit-c engine &argument)
                       &argument)
          true)
      (String.= command ":c-render")
        (do
          (repl-answer terminal
                       engine
                       (ReplEngine.render-c engine &argument)
                       &argument)
          true)
      (String.= command ":llvm")
        (do
          (repl-answer terminal
                       engine
                       (ReplEngine.emit-llvm engine &argument)
                       &argument)
          true)
      (String.= command ":doc")
        (do
          (repl-answer terminal
                       engine
                       (ReplEngine.documentation engine &name)
                       &argument)
          true)
      (String.= command ":complete")
        (do (repl-print terminal &(ReplEngine.complete engine &name)) true)
      (String.= command ":results")
        (do (repl-print terminal &(ReplEngine.results engine)) true)
      (String.= command ":browse")
        (do
          (match (if (Array.empty? &arguments)
              (Maybe.Nothing)
              (ReplInput.nonnegative-int (Array.unsafe-nth &arguments 0)))
            (Maybe.Nothing) (IO.errorln "repl: expected a result number")
            (Maybe.Just number)
              (match (ReplEngine.open-view engine
                                           number
                                           &(Array.slice &arguments
                                                         1
                                                         (Array.length &arguments))
                                           80
                                           20)
                (Result.Error error) (IO.errorln &error)
                (Result.Success page)
                  (ReplTerminal.browse terminal
                                       (ReplEngine.view-client engine)
                                       page)))
          true)
      (or (String.= command ":inspect") (String.= command ":drop"))
        (do
          (match (if (Array.empty? &arguments)
              (Maybe.Nothing)
              (ReplInput.nonnegative-int (Array.unsafe-nth &arguments 0)))
            (Maybe.Just number)
              (repl-answer terminal
                           engine
                           (if (String.= command ":inspect")
                             (ReplEngine.inspect-path engine
                                                      number
                                                      &(Array.slice &arguments
                                                                    1
                                                                    (Array.length &arguments)))
                             (ReplEngine.drop-result engine number))
                           &argument)
            (Maybe.Nothing) (IO.errorln "repl: expected a result number"))
          true)
      (String.= command ":history")
        (do (repl-print terminal &(ReplEngine.history engine)) true)
      (or (String.= command ":edit") (String.= command ":replay"))
        (do
          (match (ReplInput.nonnegative-int &name)
            (Maybe.Nothing) (IO.errorln "repl: expected an input number")
            (Maybe.Just number)
              (match (ReplEngine.begin-edit engine number)
                (Result.Error error) (repl-error &error &argument)
                (Result.Success previous)
                  (if (String.= command ":edit")
                    (ReplTerminal.seed terminal &previous)
                    (repl-answer terminal
                                 engine
                                 (ReplEngine.submit engine &previous)
                                 &previous))))
          true)
      (or (String.= command ":remove") (String.= command ":remove!"))
        (do
          (match (ReplInput.nonnegative-int &name)
            (Maybe.Nothing) (IO.errorln "repl: expected an input number")
            (Maybe.Just number)
              (repl-answer terminal
                           engine
                           (if (String.= command ":remove")
                             (ReplEngine.preview-remove engine number)
                             (ReplEngine.remove-entry engine number))
                           &argument))
          true)
      (or (String.= command ":export") (String.= command ":export-transcript"))
        (do
          (if (String.empty? &name)
            (IO.errorln "repl: expected an export path")
            (repl-answer terminal
                         engine
                         (ReplEngine.export engine
                                            &(ReplInput.trim &argument)
                                            (String.= command
                                                      ":export-transcript"))
                         &argument))
          true)
      (do (IO.errorln &(fmt "repl: unknown command %s; use :help" command)) true))))

(defn repl-abort? [source]
  (let [lines (String.lines &(ReplInput.trim source))]
    (String.=
      &(ReplInput.trim (Array.unsafe-nth &lines (Int.dec (Array.length &lines))))
      ":abort")))

(defn repl-needs-more? [source]
  (and (not (repl-abort? source))
       (and (ReplCommands.continue? source) (ReplInput.incomplete? source))))

(defn repl-loop [engine interactive history-path]
  (if interactive
    (let [context (ReplLanguage.create (Pointer.address engine))]
      (match (ReplService.create
          (fn [request cancelled publish]
            (ReplLanguage.backend context request cancelled publish)))
        (Result.Error message)
          (do (IO.errorln &message) (ReplLanguage.dispose context) 1)
        (Result.Success worker)
          (let-do [status (repl-loop-with-worker engine
                                                 interactive
                                                 history-path
                                                 worker)]
            (ReplService.close! worker)
            (ReplLanguage.dispose context)
            status)))
    (repl-loop-with-worker engine
                           interactive
                           history-path
                           (the (Ptr ReplLanguageWorker) (Pointer.from-long 0l)))))

(defn repl-loop-with-worker [engine interactive history-path worker]
  (let-do [terminal (ReplTerminal.create repl-needs-more?
                                         ReplIndentation.newline
                                         history-path
                                         (if interactive
                                           (ReplService.client worker)
                                           (ReplLanguageClient.init (fn [request]
                                                                      ())
                                                                    (fn []
                                                                      (the (Maybe ReplLanguageUpdate)
                                                                           (Maybe.Nothing)))
                                                                    (fn [] 0l)
                                                                    -1)))
           pending (String.copy "")
           running true
           status 0]
    (while-do running
      (let-do [prompt (if interactive
                 (if (Int.> @(ReplEngineState.editing engine) 0)
                   (fmt "λ[%d]> " @(ReplEngineState.editing engine))
                   (String.copy "λ> "))
                 (String.copy ""))]
        (when interactive (ReplService.resume! worker))
        (let-do [read (ReplTerminal.read-input terminal &prompt &pending)]
          (when interactive (ReplService.pause! worker))
          (match read
            (ReplRead.Cancelled)
              (do
                (set! pending (String.copy ""))
                (ReplEngine.cancel-edit engine)
                (when interactive (IO.println "")))
            (ReplRead.Error message)
              (do (IO.errorln &message) (set! status 1) (set! running false))
            (ReplRead.End)
              (do
                (unless-do (ReplInput.blank? &pending)
                  (repl-answer terminal
                               engine
                               (ReplEngine.submit engine &pending)
                               &pending)
                  (set! status 1))
                (when interactive (IO.println ""))
                (set! running false))
            (ReplRead.Line source)
              (cond
                (repl-abort? &source)
                  (do
                    (set! pending (String.copy ""))
                    (ReplEngine.cancel-edit engine))
                (ReplInput.blank? &source) ()
                (and (not interactive) (repl-needs-more? &source))
                  (set! pending source)
                (do
                  (set! pending (String.copy ""))
                  (ReplTerminal.remember terminal &source)
                  (if (ReplCommands.command? &source)
                    (set! running (repl-command engine &source terminal))
                    (repl-answer terminal
                                 engine
                                 (ReplEngine.submit engine &source)
                                 &source))))))))
    (ReplTerminal.dispose terminal)
    status))

(defn repl-run [core-dir history-path]
  (let [scratch (ReplTerminal.scratch)]
    (if (String.empty? &scratch)
      (do (IO.errorln "repl: could not create JIT scratch directory") 1)
      (match (ReplEngine.create core-dir &scratch)
        (Result.Error diagnostic)
          (do
            (repl-error &diagnostic "")
            (ignore (ReplTerminal.remove-directory &scratch))
            1)
        (Result.Success engine)
          (let-do [interactive (ReplTerminal.interactive?)
                   _welcome (when interactive
                     (IO.println "Metacarp REPL. :help for commands."))
                   status (repl-loop &engine interactive history-path)]
            (do
              (ReplEngine.dispose &engine)
              (ignore (ReplTerminal.remove-directory &scratch)))

            status)))))

(defn repl-main [first command]
  (let-do [core (match (IO.getenv "CARP_DIR")
             (Maybe.Just root) (String.append &root "/core")
             (Maybe.Nothing) (String.copy ""))
           history (match (IO.getenv "METACARP_HISTORY")
             (Maybe.Just path) path
             (Maybe.Nothing)
               (match (IO.getenv "XDG_STATE_HOME")
                 (Maybe.Just root) (String.append &root "/metacarp/history")
                 (Maybe.Nothing)
                   (match (IO.getenv "HOME")
                     (Maybe.Just root)
                       (String.append &root "/.local/state/metacarp/history")
                     (Maybe.Nothing) (String.copy ""))))
           help false
           valid true
           i first
           count (StaticArray.length &System.args)]
    (while-do (Int.< i count)
      (let [argument (StaticArray.unsafe-nth &System.args i)]
        (cond
          (or (String.= argument "--help") (String.= argument "-h"))
            (set! help true)
          (String.= argument "--no-history") (set! history (String.copy ""))
          (String.= argument "--history")
            (if (Int.< (Int.inc i) count)
              (do
                (set! i (Int.inc i))
                (set! history
                      (String.copy (StaticArray.unsafe-nth &System.args i))))
              (do (IO.errorln "repl: --history needs a file") (set! valid false)))
          (or (String.= argument "--core") (String.= argument "-c"))
            (if (Int.< (Int.inc i) count)
              (do
                (set! i (Int.inc i))
                (set! core (String.copy (StaticArray.unsafe-nth &System.args i))))
              (do
                (IO.errorln "repl: --core needs a directory")
                (set! valid false)))
          (do
            (IO.errorln &(fmt "repl: unknown option %s" argument))
            (set! valid false))))
      (set! i (Int.inc i)))
    (cond
      (not valid) 2
      help
        (do (repl-help (the (Ptr ReplEditor) (Pointer.from-long 0l)) command) 0)
      (String.empty? &core)
        (do (IO.errorln "repl: set CARP_DIR or pass --core <dir>") 2)
      (repl-run &core &history))))
