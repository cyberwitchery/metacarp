(defmodule ReplTerminal
  (defn attach-io! [terminal client]
    (unless (null? terminal)
      (ReplEditor.set-io! (Pointer.to-ref terminal) [client])))

  (defn- queued-input? [editor]
    (let-do [data (state editor)
             clients (ReplEditor.io data)]
      (when (and (Int.< @(ReplEditor.queued-byte data) 0)
                 (not (Array.empty? clients)))
        (let [next @(ReplTerminalIO.next-byte (Array.unsafe-nth clients 0))]
          (ReplEditor.set-queued-byte! data (next))))
      (Int.>= @(ReplEditor.queued-byte data) 0)))

  (defn- native-output [editor]
    (let-do [data (state editor)
             clients (ReplEditor.io data)]
      (if (Array.empty? clients)
        (the (Array Byte) [])
        (let [read @(ReplTerminalIO.read (Array.unsafe-nth clients 0))] (read)))))

  (defn- write-native-output [bytes]
    (let-do [at 0
             count (Array.length bytes)]
      (while-do (Int.< at count)
        (let [written (ReplNative.write 1
                                        (Pointer.address (Array.unsafe-nth bytes
                                                                           at))
                                        (Long.from-int (Int.- count at)))]
          (cond
            (Long.> written 0l) (set! at (Int.+ at (Long.to-int written)))
            (Int.= (Pointer.to-value (ReplEdit.errno)) ReplEdit.INTERRUPTED) ()
            (set! at count))))))

  (defn- receive-native-output [editor]
    (let [bytes (native-output editor)]
      (unless (Array.empty? &bytes)
        (let-do [presentation (ReplEditor.presentation (state editor))]
          (if @(ReplPresentation.rich presentation)
            (IO.print &(clear-frame presentation))
            (IO.print "\r\n"))
          (IO.Raw.fflush! IO.Raw.stdout)
          (write-native-output &bytes)
          (ReplPresentation.set-row! presentation 0)
          (ReplPresentation.set-screen-rows! presentation [])
          (ReplPresentation.set-dirty! presentation true)
          (unless @(ReplPresentation.rich presentation)
            (ignore (ReplEdit.set-int editor 20 0))))))))
