; Loaded by engine.carp. The host callback must acknowledge a checkpoint before
; returning. Native execution can then start without racing source retention.
(defmodule ReplEngine
  (defn checkpoint [engine session]
    (let-do [overlay (Array.unsafe-nth (CompilerSession.overlay session) 0)
             entries @(ReplEngineState.entries engine)
             events @(ReplEngineState.events engine)
             pending (ReplEngineState.pending-input engine)]
      (unless (Array.empty? pending)
        (let-do [input (Array.unsafe-nth pending 0)
                 accepted (ReplJournal.accepted? (SessionOverlay.inputs overlay)
                                                 input)
                 definitions (the (Array String) [])]
          (when accepted
            (for [i 0 (Array.length (SessionOverlay.definitions overlay))]
              (let [definition (Array.unsafe-nth (SessionOverlay.definitions overlay)
                                                 i)]
                (when (String.= (SourceInput.id input)
                                (SourceInput.id (SessionDefInfo.source definition)))
                  (Array.push-back! &definitions
                                    @(SessionDefInfo.name definition))))))
          (ReplJournal.record! &entries
                               &events
                               (ReplEntry.init 0
                                               @input
                                               @"interrupted"
                                               definitions
                                               @(ReplEngineState.pending-dependencies engine)
                                               true)
                               (if accepted @(ReplEngineState.editing engine) 0))))
      (ReplJournal.supersede! &entries (SessionOverlay.inputs overlay))
      (ReplCheckpoint.init @(SessionOverlay.inputs overlay)
                           @(CompilerSession.projected-inputs session)
                           @(ReplEngineState.serial engine)
                           @(ReplEngineState.next-result engine)
                           entries
                           events
                           @(ReplEngineState.editing engine)
                           @(ReplEngineState.last-input engine)
                           @(ReplEngineState.generation engine)
                           (definition-lines &(Session.definitions session)))))

  (defn checkpoint-session! [engine session]
    (let [callbacks (ReplEngineState.checkpoint engine)]
      (unless (Array.empty? callbacks)
        (let [publish @(Array.unsafe-nth callbacks 0)]
          (publish (checkpoint engine session))))))

  (defn checkpoint! [engine]
    (checkpoint-session! engine (ReplEngineState.session engine)))

  (defn restore [engine checkpoint]
    (let-do [session @(ReplEngineState.session engine)
             inputs (ReplCheckpoint.inputs checkpoint)
             failure (the (Array Diagnostic) [])]
      (for [i 0 (Array.length inputs)]
        (when (Array.empty? &failure)
          (let [input (Array.unsafe-nth inputs i)]
            (match (if (Array.contains? (ReplCheckpoint.projected checkpoint)
                                        (SourceInput.id input))
                (match (Session.prepare-input &session input)
                  (Result.Error error) (Result.Error error)
                  (Result.Success _) (Result.Success ()))
                (match (Session.upsert-input &session input)
                  (Result.Error error) (Result.Error error)
                  (Result.Success _) (Result.Success ())))
              (Result.Error error) (Array.push-back! &failure error)
              (Result.Success _) ()))))
      (if (not (Array.empty? &failure))
        (Result.Error @(Array.unsafe-nth &failure 0))
        (do
          (ReplEngineState.set-session! engine session)
          (ReplEngineState.set-serial! engine
                                       @(ReplCheckpoint.serial checkpoint))
          (ReplEngineState.set-next-result! engine
                                            @(ReplCheckpoint.next-result checkpoint))
          (ReplEngineState.set-entries! engine
                                        @(ReplCheckpoint.entries checkpoint))
          (ReplEngineState.set-events! engine
                                       @(ReplCheckpoint.events checkpoint))
          (ReplEngineState.set-editing! engine 0)
          (ReplEngineState.set-last-input! engine
                                           @(ReplCheckpoint.last-input checkpoint))
          (ReplEngineState.set-generation! engine
                                           (Int.inc @(ReplCheckpoint.generation checkpoint)))
          (Result.Success ()))))))
