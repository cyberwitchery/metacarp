(load "protocol.carp")
(load "view-protocol.carp")
(load "checkpoint.carp")

(doc ReplWorkerStart "is the first message to a worker. `schema` is the wire
schema of the sender. `arguments` are the worker's arguments.")
(defwire ReplWorkerStart [schema (Array String) arguments (Array String)])

(doc ReplConsoleEffect "is output from the worker for the console. `Output` is
text to print. `Diagnostic` is an error and the source it refers to. `Seed` is
source to put into the editor, as `:edit` does. `Browse` is a view page to
browse.")
(defwire ReplConsoleEffect
         (Output [String])
         (Diagnostic [Diagnostic String])
         (Seed [String])
         (Browse [ReplViewPage]))

(doc ReplWorkerRequest "is a request to the worker. `Command` runs a line of
input. `View` operates on an open view. `Language` asks for editor support.
`Pause` and `Resume` stop and restart the background language analysis.
`CancelEdit` ends an `:edit`. `Restore` restores a checkpoint. `Shutdown` stops
the worker.")
(defwire ReplWorkerRequest
         (Command [String])
         (View [ReplViewRequest])
         (Language [ReplLanguageRequest])
         (Pause [])
         (Resume [])
         (CancelEdit [])
         (Restore [ReplCheckpoint])
         (Shutdown []))

(doc ReplWorkerReply "is a message from the worker. `Effect` is output for the
console. `Checkpoint` is a new checkpoint of the session. `Language` is editor
support. `Ready` says the worker is ready, with the revision of its language
session. `Done` says a request is done, with the number of the entry being
edited, or 0. `Page` is a view page. `ViewError` is a failed view request.
`Failure` is a failure of the worker. `LanguageAccepted` acknowledges a
language request by its serial.")
(defwire ReplWorkerReply
         (Effect [ReplConsoleEffect])
         (Checkpoint [ReplCheckpoint])
         (Language [ReplLanguageUpdate])
         (Ready [Long])
         (Done [Int])
         (Page [ReplViewPage])
         (ViewError [String])
         (Failure [String])
         (LanguageAccepted [Long]))

(defmodule ReplWorkerProtocol
  (doc schema "returns the wire schema of the worker protocol: the declarations
of its types and its encoding.")
  (defn schema []
    (let-do [declarations (wire-schema)]
      (Array.push-back! &declarations
                        @"metacarp-repl-wire/1; frame=be32; integer=decimal; record=field-count")
      declarations))
  (doc compatible? "checks whether `received` is the same schema as `schema`,
in any order.")
  (defn compatible? [received]
    (let-do [expected (schema)
             same (Int.= (Array.length received) (Array.length &expected))]
      (for [i 0 (Array.length &expected)]
        (unless (Array.contains? received (Array.unsafe-nth &expected i))
          (set! same false)))
      same)))
