(load "protocol.carp")
(load "view-protocol.carp")
(load "checkpoint.carp")

(defwire ReplWorkerStart [schema (Array String) arguments (Array String)])

(defwire ReplConsoleEffect
         (Output [String])
         (Diagnostic [Diagnostic String])
         (Seed [String])
         (Browse [ReplViewPage]))

(defwire ReplWorkerRequest
         (Command [String])
         (View [ReplViewRequest])
         (Language [ReplLanguageRequest])
         (Pause [])
         (Resume [])
         (CancelEdit [])
         (Restore [ReplCheckpoint])
         (Shutdown []))

(defwire ReplWorkerReply
         (Effect [ReplConsoleEffect])
         (Checkpoint [ReplCheckpoint])
         (Language [ReplLanguageUpdate])
         (Ready [Long])
         (Done [Int])
         (Page [ReplViewPage])
         (ViewError [String])
         (Failure [String])
         (LanguageAccepted [Long]))

(defmodule ReplWorkerProtocol
  (defn schema []
    (let-do [declarations (wire-schema)]
      (Array.push-back! &declarations
                        @"metacarp-repl-wire/1; frame=be32; integer=decimal; record=field-count")
      declarations))
  (defn compatible? [received]
    (let-do [expected (schema)
             same (Int.= (Array.length received) (Array.length &expected))]
      (for [i 0 (Array.length &expected)]
        (unless (Array.contains? received (Array.unsafe-nth &expected i))
          (set! same false)))
      same)))
