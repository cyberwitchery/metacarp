; Loaded by terminal.carp. The editor owns tty and signal state throughout.
(defmodule ReplTerminal
  (defn- browse-loop [editor browser]
    (fullscreen-loop editor
                     browser
                     ReplBrowser.resize!
                     ReplBrowser.frame
                     ReplBrowser.step!))

  (doc browse "runs structured navigation with owned presentation data and
opaque view leases. Noninteractive output prints the bounded initial snapshot.")
  (defn browse [terminal client page]
    (let-do [browser (ReplBrowser.create client page)]
      (if (or (null? terminal)
              (not
                @(ReplPresentation.rich
                  (ReplEditor.presentation (Pointer.to-ref terminal)))))
        (IO.println (ReplFrame.text &(ReplBrowser.frame &browser 80 24 false)))
        (do
          (ReplEditor.set-output-browser! (Pointer.to-ref terminal)
                                          (Pointer.address &browser))
          (page-output terminal "")
          (ReplEditor.set-output-browser! (Pointer.to-ref terminal)
                                          (Pointer.from-long 0l))))
      (ReplBrowser.close! &browser))))
