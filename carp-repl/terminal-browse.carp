; Loaded by terminal.carp. The editor owns tty and signal state throughout.
(defmodule ReplTerminal
  (defn- browse-loop [editor browser]
    (let-do [size (dimensions)
             previous (the (Array ReplDisplayRow) [])
             cursor 0
             running true
             dirty true
             colors @(ReplPresentation.colors (ReplEditor.presentation (state editor)))]
      (prepare-character-input)
      (ReplBrowser.resize! browser @(Pair.a &size) @(Pair.b &size))
      (while-do running
        (let-do [current (dimensions)
                 resized (or
                   (Int./= @(Pair.a &size) @(Pair.a &current))
                   (Int./= @(Pair.b &size) @(Pair.b &current)))]
          (when-do resized
            (set! size current)
            (ReplBrowser.resize! browser @(Pair.a &size) @(Pair.b &size))
            (IO.print "\r\u001b[H\u001b[J")
            (set! previous [])
            (set! cursor 0)
            (set! dirty true))
          (when-do dirty
            (let-do [frame (ReplBrowser.frame browser
                                              @(Pair.a &size)
                                              @(Pair.b &size)
                                              colors)
                     update (ReplDisplay.patch &previous
                                               cursor
                                               &frame
                                               @(Pair.a &size))]
              (IO.print &update)
              (IO.Raw.fflush! IO.Raw.stdout)
              (set! previous @(ReplFrame.rows &frame))
              (set! cursor @(ReplFrame.cursor-row &frame)))
            (set! dirty false))
          (let-do [input (output-key editor 100)
                   key (if (Int.= input 27) (output-escape editor) input)]
            (unless-do (Int.= key -2)
              (set! dirty true)
              (set! running
                    (ReplBrowser.step! browser
                                       key
                                       @(Pair.a &size)
                                       @(Pair.b &size)))))))))

  (doc browse "runs structured navigation with owned presentation data and
opaque view leases. Noninteractive output prints the bounded initial snapshot.")
  (defn browse [terminal client page]
    (let-do [browser (ReplBrowser.create client page)]
      (if (or (null? terminal)
              (not
                @(ReplPresentation.rich
                  (ReplEditor.presentation (Pointer.to-ref terminal)))))
        (IO.println (ReplFrame.text &(ReplBrowser.frame &browser 80 24 false)))
        (do
          (ReplEditor.set-output-browser! (Pointer.to-ref terminal)
                                          (Pointer.address &browser))
          (page-output terminal "")
          (ReplEditor.set-output-browser! (Pointer.to-ref terminal)
                                          (Pointer.from-long 0l))))
      (ReplBrowser.close! &browser))))
