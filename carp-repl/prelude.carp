(load "../carp-views/source.carp")
(load "view-protocol.carp")
(load "../carp-session/carp-inspection.carp")

(doc repl-view-source "expands to the source of the repl's view support: the
view protocol types, view-runtime.carp and view-snapshot.carp.")
(defmacro repl-view-source []
  (list 'copy (String.concat [(ReplWireMacro.group-source 'repl-views) "
" (read-file (relative-to (current-file) "view-runtime.carp")) "
" (read-file (relative-to (current-file) "view-snapshot.carp"))])))

(defmodule ReplPrelude
  (doc source "returns the source the repl adds to core: the view runtime and
the repl's view support. It is part of the session's base, so a reset keeps it
and the journal holds only user input.")
  (defn source [] (String.concat &[(CarpViews.source) @"
" (repl-view-source)]))

  (doc create-session "creates a session whose base is core from `core-dir`
and the repl prelude.")
  (defn create-session [core-dir]
    (match (SessionCoreLoader.load-core core-dir)
      (Result.Error error) (Result.Error error)
      (Result.Success core)
        (let [input (SourceInput.init @"repl:prelude" (source))]
          (match (Surface.parse-input-diagnosed &input)
            (Result.Error error) (Result.Error error)
            (Result.Success parsed)
              (let-do [forms @(SurfaceModule.forms &core)
                       extra (SurfaceModule.forms (SourcedSurfaceModule.module &parsed))]
                (for [i 0 (Array.length extra)]
                  (Array.push-back! &forms @(Array.unsafe-nth extra i)))
                (let [base (SourcedSurfaceModule.init input
                                                      (SurfaceModule.init forms))]
                  (Session.create-from-module &base
                                              &(ExpandConfig.init [@"Dynamic"])))))))))
