(load "values.carp")
(load "inspection.carp")

; One compiled query per source type/provider in a native generation. The
; channel supplies request data and the current source address at invocation;
; neither source values nor their view callbacks escape the synchronous call.
(deftype ReplViewInput [source Long
                        request InspectRequest])
(deftype ReplViewQuery
  [key String
   input (Ptr ReplViewInput)
   prepared ReplPreparedResult])

(defmodule ReplViewQueries
  (defn- read-field [type address borrowed]
    (fmt
      "(Pointer.%s (the (Ptr %s) (Pointer.from-long %sl)))"
      (if borrowed "to-ref" "to-value")
      type
      &(Long.str address)))

  (doc source "builds a typed query over stable request channels. Field
addresses come from actual host accessors; no structure offsets are guessed.")
  (defn source [channel type provider]
    (let [input (Pointer.to-ref channel)
          request (ReplViewInput.request input)]
      (fmt
        "(let [value (Pointer.to-ref (the (Ptr %s) (Pointer.from-long %s))) views (%s value)] (ReplView.present value &views &(View.request (copy %s) %s %s %s %s) %s))"
        type
        &(read-field "Long"
                     (Pointer.to-long
                       (Pointer.address (ReplViewInput.source input)))
                     false)
        provider
        &(read-field "String"
                     (Pointer.to-long
                       (Pointer.address (InspectRequest.view request)))
                     true)
        &(read-field "Int"
                     (Pointer.to-long
                       (Pointer.address (InspectRequest.offset request)))
                     false)
        &(read-field "Int"
                     (Pointer.to-long
                       (Pointer.address (InspectRequest.count request)))
                     false)
        &(read-field "Int"
                     (Pointer.to-long
                       (Pointer.address (InspectRequest.depth request)))
                     false)
        &(read-field "Int"
                     (Pointer.to-long
                       (Pointer.address (InspectRequest.bytes request)))
                     false)
        &(read-field "Bool"
                     (Pointer.to-long
                       (Pointer.address (InspectRequest.views request)))
                     false))))

  (doc discard-input
    "releases a channel after a failed compilation or retirement.")
  (defn discard-input [input]
    (let [owned (Pointer.to-value input)] (Pointer.free input)))

  (doc clear! "retires query results and native callback environments before
the JIT generation that created them is invalidated.")
  (defn clear! [queries]
    (do
      (for [i (Array.length queries) 0 -1]
        (let-do [query (Array.unsafe-nth queries (Int.dec i))
                 prepared (ReplViewQuery.prepared query)]
          (ReplValues.reset-slot! @(ReplPreparedResult.slot prepared))
          (ReplValues.discard-slot @(ReplPreparedResult.slot prepared))
          (discard-input @(ReplViewQuery.input query))))
      (while-do (not (Array.empty? queries)) (ignore (Array.pop-back! queries))))))
