; presents views in the terminal
(doc ReplViewPresentation "is the result of presenting a value. `available` is
false if no view applies. `text` is the rendered view.")
(deftype ReplViewPresentation [available Bool
                               text String])

(defmodule ReplView
  (defn- describe [views]
    (let-do [lines (the (Array String) [])]
      (for [i 0 (Array.length views)]
        (let [view (Array.unsafe-nth views i)]
          (unless (or (String.= (ViewSpec.kind view) "empty")
                      (String.= (ViewSpec.selector view) "gtRawFor"))
            (Array.push-back! &lines
                              (fmt "%s : %s (%s, %d)"
                                   (ViewSpec.selector view)
                                   (ViewSpec.title view)
                                   (ViewSpec.kind view)
                                   @(ViewSpec.priority view))))))
      (Array.push-back! &lines @"gtRawFor : Raw (native, 90)")
      (String.join "
" &lines)))

  (doc present "renders the view of `value` that `request` selects, or lists
the views if `list-views` is true. The result is not available if no view
applies, or if `request` names no view and the preferred one has priority 90
or more. The host then shows its native Raw view.")
  (defn present [value views request list-views]
    (if list-views
      (ReplViewPresentation.init true (describe views))
      (let [index (View.view-index views (ViewRequest.selector request))]
        (cond
          (< index 0) (ReplViewPresentation.init false @"")
          (and
            (String.empty? (ViewRequest.selector request))
            (>= @(ViewSpec.priority (Array.unsafe-nth views index)) 90))
            (ReplViewPresentation.init false @"")
          (ReplViewPresentation.init true (View.render value views request)))))))
