(load "../carp-surface/carp-surface.carp")
(load "indentation.carp")

(doc ReplInput
  "reader-backed input framing, independent of the terminal and JIT.")
(defmodule ReplInput
  (doc incomplete? "asks for another line only when the reader stopped at EOF.
Malformed input before EOF is submitted immediately for a diagnostic.")
  (defn incomplete? [source]
    (match (ReaderDocument.status &(Reader.read-syntax source))
      (ReaderStatus.Incomplete) true
      _ false))

  (doc head "returns a form's leading symbol, or the empty string.")
  (defn head [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List items)
        (if (Int.> (Array.length items) 0)
          (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth items 0)))
            (SurfaceForm.Symbol segments) (String.join "." segments)
            _ (String.copy ""))
          (String.copy ""))
      _ (String.copy "")))

  (doc declaration?
    "recognizes compiler declaration syntax at the input boundary.")
  (defn declaration? [node]
    (or
      (and (String.= &(head node) "do") (declaration-body? node))
      (Array.contains?
        &[@"def"
          @"defn"
          @"defmacro"
          @"deftype"
          @"definterface"
          @"implements"
          @"deftemplate"
          @"register"
          @"register-type"
          @"defmodule"
          @"doc"
          @"sig"
          @"meta-set!"
          @"private"
          @"hidden"]
        &(head node))))

  (doc trim
    "trims command framing whitespace, leaving source buffers untouched.")

  (defn trim [source]
    (let-do [start 0
             end (String.length source)]
      (while-do (and (Int.< start end)
                     (Char.whitespace? (String.char-at source start)))
        (set! start (Int.inc start)))
      (while-do (and (Int.> end start)
                     (Char.whitespace? (String.char-at source (Int.dec end))))
        (set! end (Int.dec end)))

      (String.byte-slice source start end)))

  (doc blank? "recognizes whitespace-only input without changing its bytes.")
  (defn blank? [source] (String.empty? &(trim source))))

(defmodule ReplInput
  (defn- declaration-flags [node]
    (if (declaration? node)
      1
      (match-ref (SurfaceNode.form node)
        (SurfaceForm.Comment _) 0
        (SurfaceForm.List items)
          (if (String.= &(head node) "do")
            (let-do [flags 0]
              (for [i 1 (Array.length items)]
                (set! flags
                      (bit-or flags
                              (declaration-flags (Box.peek (Array.unsafe-nth items
                                                                             i))))))
              flags)
            2)
        _ 2)))

  (defn- declaration-body? [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List items)
        (let-do [answer true]
          (for [i 1 (Array.length items)]
            (unless (declaration? (Box.peek (Array.unsafe-nth items i)))
              (set! answer false)))
          answer)
      _ false))

  (doc declaration-mask "maps expanded declarations back to original caller
forms by their source spans. Macro expansion never changes the journal text.")
  (defn declaration-mask [original expanded source-id]
    (let-do [answer (the (Array Bool) [])
             failure (the (Maybe Diagnostic) (Maybe.Nothing))]
      (for [i 0 (Array.length original)]
        (let-do [node (Box.peek (Array.unsafe-nth original i))
                 start (SurfaceSpan.byte-start (SurfaceNode.span node))
                 end (SurfaceSpan.byte-end (SurfaceNode.span node))
                 flags (if (declaration? node) 1 0)]
          (for [j 0 (Array.length expanded)]
            (let [generated (Box.peek (Array.unsafe-nth expanded j))
                  span (SurfaceNode.span generated)]
              (when (and (>= (SurfaceSpan.byte-start span) start)
                         (<= (SurfaceSpan.byte-end span) end))
                (set! flags (bit-or flags (declaration-flags generated))))))
          (when (= flags 3)
            (set! failure
                  (Maybe.Just
                    (Diagnostic.init @"repl"
                                     @"one form expands to both declarations and expressions; submit them as separate top-level forms"
                                     (Maybe.Just (SourceSpan.init @source-id
                                                                  start
                                                                  end))))))
          (Array.push-back! &answer (/= flags 2))))
      (match failure
        (Maybe.Just error) (Result.Error error)
        (Maybe.Nothing) (Result.Success answer))))

  (doc partition
    "Separates declarations and runtime roots while preserving byte offsets.")
  (defn partition [source forms mask]
    (let-do [declarations (String.to-bytes source)
             expressions (String.to-bytes source)]
      (for [i 0 (Array.length forms)]
        (let [node (Box.peek (Array.unsafe-nth forms i))
              span (SurfaceNode.span node)
              target (if @(Array.unsafe-nth mask i) &expressions &declarations)]
          (for [j (SurfaceSpan.byte-start span) (SurfaceSpan.byte-end span)]
            (let [byte @(Array.unsafe-nth target j)]
              (unless (or (Byte.= byte (Byte.from-int 10))
                          (Byte.= byte (Byte.from-int 13)))
                (Array.aset! target j (Byte.from-int 32)))))))
      (Pair.init (String.from-bytes &declarations)
                 (String.from-bytes &expressions)))))

(defmodule ReplInput
  (doc nonnegative-int "Parses a decimal index without truncation or overflow.")
  (defn nonnegative-int [source]
    (let-do [characters (String.chars source)
             valid (not (Array.empty? &characters))
             value 0]
      (for [i 0 (Array.length &characters)]
        (when valid
          (let [code (Char.to-int @(Array.unsafe-nth &characters i))]
            (if (and (Int.>= code 48) (Int.<= code 57))
              (let [digit (Int.- code 48)]
                (if (Int.> value (Int./ (Int.- Int.MAX digit) 10))
                  (set! valid false)
                  (set! value (Int.+ (Int.* value 10) digit))))
              (set! valid false)))))
      (if valid (Maybe.Just value) (Maybe.Nothing)))))
