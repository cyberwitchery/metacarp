(load "../carp-surface/carp-surface.carp")
(load "indentation.carp")
(load "../carp-session/input-syntax.carp")

(doc ReplInput "decides how the repl reads and splits its input.")
(defmodule ReplInput
  (doc incomplete? "checks whether `source` ends inside a form, so the repl
reads another line. Malformed input is not incomplete.")
  (defn incomplete? [source]
    (match (ReaderDocument.status &(Reader.read-syntax source))
      (ReaderStatus.Incomplete) true
      _ false))

  (doc head "returns a form's leading symbol, or the empty string.")
  (defn head [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List items)
        (if (Int.> (Array.length items) 0)
          (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth items 0)))
            (SurfaceForm.Symbol segments) (String.join "." segments)
            _ (String.copy ""))
          (String.copy ""))
      _ (String.copy "")))

  (doc declaration? "checks whether `node` is a declaration, or a `do` that
holds only declarations.")
  (defn declaration? [node]
    (or (SessionSyntax.declaration? node)
        (and (String.= &(head node) "do") (declaration-body? node))))

  (doc trim "returns `source` without leading and trailing whitespace.")

  (defn trim [source]
    (let-do [start 0
             end (String.length source)]
      (while-do (and (Int.< start end)
                     (Char.whitespace? (String.char-at source start)))
        (set! start (Int.inc start)))
      (while-do (and (Int.> end start)
                     (Char.whitespace? (String.char-at source (Int.dec end))))
        (set! end (Int.dec end)))

      (String.byte-slice source start end)))

  (doc blank? "checks whether `source` is empty or only whitespace.")
  (defn blank? [source] (String.empty? &(trim source))))

(defmodule ReplInput
  (defn- declaration-body? [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List items)
        (let-do [answer true]
          (for [i 1 (Array.length items)]
            (unless (declaration? (Box.peek (Array.unsafe-nth items i)))
              (set! answer false)))
          answer)
      _ false)))

(defmodule ReplInput
  (doc nonnegative-int "parses `source` as a non-negative decimal number.
Returns `Nothing` if it is not one or does not fit in an `Int`.")
  (defn nonnegative-int [source]
    (let-do [characters (String.chars source)
             valid (not (Array.empty? &characters))
             value 0]
      (for [i 0 (Array.length &characters)]
        (when valid
          (let [code (Char.to-int @(Array.unsafe-nth &characters i))]
            (if (and (Int.>= code 48) (Int.<= code 57))
              (let [digit (Int.- code 48)]
                (if (Int.> value (Int./ (Int.- Int.MAX digit) 10))
                  (set! valid false)
                  (set! value (Int.+ (Int.* value 10) digit))))
              (set! valid false)))))
      (if valid (Maybe.Just value) (Maybe.Nothing)))))
