(load "../carp-source/carp-source.carp")
(load "../carp-types/carp-types.carp")
(load "../carp-surface/carp-surface.carp")
(load "../carp-session/input-syntax.carp")

(doc ReplValueSlot "is where native code stores a result. `address` is the
address of the value, or 0. `release` frees the value. Both belong to the code
that stored them, so they must be released before that code is discarded.")
(deftype ReplValueSlot [address Long
                        release (Fn [Long] ())])
(doc ReplValue "is a live result of the repl. `number` is its number, as in
`_1`. `type` is its type as text and `type-info` as a type. `publication`
identifies the native code that produced it. `slot` holds the value.")
(deftype ReplValue
  [number Int
   type String
   type-info (Box MonoType)
   publication Int
   slot (Ptr ReplValueSlot)])
(doc ReplPreparedResult "is compiled code that produces a result. `address` is
the function to call. `slot` is where it stores the result. `type`,
`type-info` and `publication` are as in `ReplValue`. `retain` is whether the
result is kept as a live result.")
(deftype ReplPreparedResult
  [address Long
   slot (Ptr ReplValueSlot)
   type String
   type-info (Box MonoType)
   publication Int
   retain Bool])

(doc ReplValues "keeps the repl's live results and builds the code that refers
to them.")
(defmodule ReplValues
  (private empty-release)
  (hidden empty-release)
  (defn empty-release [unused] (ignore (the Long unused)))

  (doc allocate "returns a new, empty result slot.")
  (defn allocate [] (Pointer.unsafe-alloc (ReplValueSlot.init 0l empty-release)))

  (doc reset-slot! "frees the value in `slot`, if there is one, and empties
the slot for reuse.")
  (defn reset-slot! [slot]
    (let-do [channel (Pointer.to-ref slot)
             drop @(ReplValueSlot.release channel)]
      (when (Long./= @(ReplValueSlot.address channel) 0l) (drop 0l))
      (ReplValueSlot.set-address! channel 0l)
      (ReplValueSlot.set-release! channel empty-release)))

  (doc discard-slot "frees `slot` itself, without freeing a value in it.")
  (defn discard-slot [slot]
    (let [-owned (Pointer.to-value slot)] (Pointer.free slot)))

  (doc release "frees the value of `value` and its slot.")
  (defn release [value]
    (let-do [slot @(ReplValue.slot value)
             drop @(ReplValueSlot.release (Pointer.to-ref slot))]
      (drop 0l)
      (discard-slot slot)))

  (doc clear! "frees every value in `values`, newest first, and empties it.")
  (defn clear! [values]
    (let-do [count (Array.length values)]
      (for [i count 0 -1] (release (Array.unsafe-nth values (Int.dec i))))
      (while-do (not (Array.empty? values)) (ignore (Array.pop-back! values)))))

  (doc primitive? "checks whether `type` is a scalar type, whose aliases copy
the value.")
  (defn primitive? [type]
    (Array.contains?
      &[@"Int"
        @"Long"
        @"Bool"
        @"Float"
        @"Double"
        @"Byte"
        @"Char"
        @"Int8"
        @"Int16"
        @"Int32"
        @"Int64"
        @"Uint8"
        @"Uint16"
        @"Uint32"
        @"Uint64"
        @"CChar"]
      type))

  (doc aliases "returns `let` bindings that bind `_1`, `_2` and so on, and `_`
for the newest, to the live results. A scalar is copied, any other value is
borrowed.")
  (defn aliases [values]
    (let-do [bindings (the (Array String) [])]
      (for [i 0 (Array.length values)]
        (let-do [value (Array.unsafe-nth values i)
                 slot (Pointer.to-ref @(ReplValue.slot value))
                 expression (fmt
                   "(%s (the (Ptr %s) (Pointer.from-long %sl)))"
                   (if (primitive? (ReplValue.type value))
                     "Pointer.to-value"
                     "Pointer.to-ref")
                   (ReplValue.type value)
                   &(Long.str @(ReplValueSlot.address slot)))]
          (Array.push-back! &bindings
                            (fmt "_%d %s" @(ReplValue.number value) &expression))
          (when (Int.= i (Int.dec (Array.length values)))
            (Array.push-back! &bindings (String.append "_ " &expression)))))
      (String.join " " &bindings)))

  (doc prefix "returns the source that opens the `let` of `aliases`. Its length
is the offset of the user's input in the wrapped source.")
  (defn prefix [values] (fmt "(let [%s] (do
" &(aliases values)))

  (doc runtime-input "returns `input` wrapped in the `let` of `aliases`.")
  (defn runtime-input [values input]
    (SourceInput.init (String.copy (SourceInput.id input))
                      (String.concat
                        &[(prefix values)
                          (String.copy (SourceInput.source input))
                          @"
))"])))

  (doc capture-input "returns `input` wrapped in code that evaluates it with
the aliases and stores the result in `slot`, and the offset of the user's
input in it.")
  (defn capture-input [values input slot]
    (let [begin (fmt "(let [%s __repl_value (do
" &(aliases values))
          channel (Pointer.to-ref slot)
          end (fmt "
) __repl_storage (Pointer.unsafe-alloc __repl_value)]
 (do
  (Pointer.set (the (Ptr Long) (Pointer.from-long %sl)) (Pointer.to-long __repl_storage))
  (Pointer.set (the (Ptr (Fn [Long] ())) (Pointer.from-long %sl))
   (fn [unused] (let [owned (Pointer.to-value __repl_storage)]
     (do (Pointer.free __repl_storage) (let [_ owned] ())))))))" &(Long.str
                     (Pointer.to-long
                       (Pointer.address (ReplValueSlot.address channel)))) &(Long.str
                     (Pointer.to-long
                       (Pointer.address (ReplValueSlot.release channel)))))] (Pair.init
        (SourceInput.init (String.copy (SourceInput.id input))
                          (String.concat
                            &[begin (String.copy (SourceInput.source input)) end]))
        (String.length &begin))))

  (defn- splice-node [node body]
    (if (match-ref (SurfaceNode.form node)
        (SurfaceForm.Symbol segments)
          (and (Int.= (Array.length segments) 1)
               (String.= (Array.unsafe-nth segments 0) "__repl_body__"))
        _ false)
      @body
      (let [form (match-ref (SurfaceNode.form node)
              (SurfaceForm.List items)
                (let-do [children (the (Array (Box SurfaceNode)) [])]
                  (for [i 0 (Array.length items)]
                    (Array.push-back! &children
                                      (Box.init
                                        (splice-node (Box.peek (Array.unsafe-nth items
                                                                                 i))
                                                     body))))
                  (SurfaceForm.List children))
              (SurfaceForm.Array items)
                (let-do [children (the (Array (Box SurfaceNode)) [])]
                  (for [i 0 (Array.length items)]
                    (Array.push-back! &children
                                      (Box.init
                                        (splice-node (Box.peek (Array.unsafe-nth items
                                                                                 i))
                                                     body))))
                  (SurfaceForm.Array children))
              form @form)]
        (SurfaceNode.generated (SurfaceSpan.anywhere) form))))

  (doc splice-module "parses `template` and puts the forms of the expanded
`module` in place of `__repl_body__`. The forms keep their source spans.")
  (defn splice-module [input template module]
    (let-do [nodes [(Box.init
                      (SurfaceNode.generated (SurfaceSpan.anywhere)
                                             (SurfaceForm.Symbol [@"do"])))]
             declarations (the (Array (Box SurfaceNode)) [])
             forms (SurfaceModule.forms module)]
      (for [i 0 (Array.length forms)]
        (let [node (Box.peek (Array.unsafe-nth forms i))]
          (Array.push-back!
            (if (SessionSyntax.declaration? node) &declarations &nodes)
            (Box.init @node))))
      (let [body (SurfaceNode.generated (SurfaceSpan.anywhere)
                                        (SurfaceForm.List nodes))
            generated (SourceInput.init @"repl:scaffold" @template)]
        (match (Surface.parse-input-diagnosed &generated)
          (Result.Error error) (Result.Error error)
          (Result.Success parsed)
            (let-do [result declarations
                     scaffold (SurfaceModule.forms (SourcedSurfaceModule.module &parsed))]
              (for [i 0 (Array.length scaffold)]
                (Array.push-back! &result
                                  (Box.init
                                    (splice-node (Box.peek (Array.unsafe-nth scaffold
                                                                             i))
                                                 &body))))
              (Result.Success
                (SourcedSurfaceModule.init @input (SurfaceModule.init result))))))))

  (doc runtime-module "is `runtime-input` for an already expanded `module`.")
  (defn runtime-module [values input module]
    (let [template (runtime-input values
                                  &(SourceInput.init @(SourceInput.id input)
                                                     @"__repl_body__"))]
      (splice-module input (SourceInput.source &template) module)))

  (defn- generated-symbol [name]
    (SurfaceNode.generated (SurfaceSpan.anywhere)
                           (SurfaceForm.Symbol (String.split-by name &[\.]))))

  (defn- scoped-name [scope name]
    (if (String.empty? scope) @name (fmt "%s.%s" scope name)))

  (defn- runtime-scopes [values input forms scope names counter]
    (let-do [declarations (the (Array (Box SurfaceNode)) [])
             roots (the (Array (Box SurfaceNode)) [])
             failure (the (Maybe Diagnostic) (Maybe.Nothing))]
      (for [i 0 (Array.length forms)]
        (when (Maybe.nothing? &failure)
          (let [node (Box.peek (Array.unsafe-nth forms i))]
            (if (String.= &(SessionSyntax.head node) "defmodule")
              (match-ref (SurfaceNode.form node)
                (SurfaceForm.List items)
                  (let-do [local (SessionSyntax.symbol-name (Box.peek (Array.unsafe-nth items
                                                                                        1)))
                           nested (scoped-name scope &local)]
                    (match (runtime-scopes values
                                           input
                                           &(Array.slice items
                                                         2
                                                         (Array.length items))
                                           &nested
                                           names
                                           counter)
                      (Result.Error error) (set! failure (Maybe.Just error))
                      (Result.Success parts)
                        (let-do [number @(Array.unsafe-nth counter 0)
                                 helper (fmt "__repl_scope_%d" number)
                                 full (scoped-name &nested &helper)]
                          (while-do (Array.contains? names &full)
                            (set! number (Int.inc number))
                            (set! helper (fmt "__repl_scope_%d" number))
                            (set! full (scoped-name &nested &helper)))
                          (Array.aset! counter 0 (Int.inc number))
                          (Array.push-back! names @&full)
                          (match (runtime-module values
                                                 input
                                                 &(SurfaceModule.init @(Pair.b &parts)))
                            (Result.Error error)
                              (set! failure (Maybe.Just error))
                            (Result.Success body)
                              (let-do [expressions [(Box.init (generated-symbol "do"))]
                                       body-forms (SurfaceModule.forms (SourcedSurfaceModule.module &body))
                                       module-forms [@(Array.unsafe-nth items 0)
                                                     @(Array.unsafe-nth items 1)]
                                       children (Pair.a &parts)]
                                (for [j 0 (Array.length body-forms)]
                                  (Array.push-back! &expressions
                                                    @(Array.unsafe-nth body-forms
                                                                       j)))
                                (for [j 0 (Array.length children)]
                                  (Array.push-back! &module-forms
                                                    @(Array.unsafe-nth children
                                                                       j)))
                                (Array.push-back! &module-forms
                                                  (Box.init
                                                    (SurfaceNode.generated @(SurfaceNode.span node)
                                                                           (SurfaceForm.List
                                                                             [(Box.init (generated-symbol "defn"))
                                                                              (Box.init (generated-symbol &helper))
                                                                              (Box.init
                                                                                (SurfaceNode.generated (SurfaceSpan.anywhere)
                                                                                                       (SurfaceForm.Array [])))
                                                                              (Box.init
                                                                                (SurfaceNode.generated (SurfaceSpan.anywhere)
                                                                                                       (SurfaceForm.List expressions)))]))))
                                (Array.push-back! &declarations
                                                  (Box.init
                                                    (SurfaceNode.generated @(SurfaceNode.span node)
                                                                           (SurfaceForm.List module-forms))))
                                (Array.push-back! &roots
                                                  (Box.init
                                                    (SurfaceNode.generated @(SurfaceNode.span node)
                                                                           (SurfaceForm.List [(Box.init (generated-symbol &full))])))))))))
                _ ())
              (Array.push-back!
                (if (SessionSyntax.declaration? node) &declarations &roots)
                (Box.init @node))))))
      (match failure
        (Maybe.Just error) (Result.Error error)
        (Maybe.Nothing) (Result.Success (Pair.init declarations roots)))))

  (doc scoped-runtime-module "turns the top-level expressions inside modules of
`source` into functions in those modules, which get the same aliases. Their
names do not clash with any name in `globals`.")
  (defn scoped-runtime-module [values source globals]
    (let-do [names @globals
             counter [0]]
      (match (runtime-scopes values
                             (SourcedSurfaceModule.input source)
                             (SurfaceModule.forms (SourcedSurfaceModule.module source))
                             ""
                             &names
                             &counter)
        (Result.Error error) (Result.Error error)
        (Result.Success parts)
          (let-do [forms @(Pair.a &parts)
                   roots (Pair.b &parts)]
            (for [i 0 (Array.length roots)]
              (Array.push-back! &forms @(Array.unsafe-nth roots i)))
            (Result.Success (SurfaceModule.init forms))))))

  (doc capture-module "is `capture-input` for an already expanded `module`.")
  (defn capture-module [values input module slot]
    (let [template (capture-input values
                                  &(SourceInput.init @(SourceInput.id input)
                                                     @"__repl_body__")
                                  slot)]
      (splice-module input (SourceInput.source (Pair.a &template)) module))))
