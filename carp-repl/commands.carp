(load "protocol.carp")

(deftype ReplCommandArgument
  (None [])
  (Source [])
  (Name [])
  (Text []))
(deftype ReplCommand
  [name String
   usage String
   documentation String
   argument ReplCommandArgument])
(deftype ReplCommandInput [name String
                           arguments String
                           start Int
                           end Int])

(doc ReplCommands "is the host command grammar. Source arguments retain their
positions in the caller buffer when the compiler analyzes them.")
(defmodule ReplCommands
  (defn entries []
    [(ReplCommand.init @":help"
                       @":help"
                       @"show commands"
                       (ReplCommandArgument.None))
     (ReplCommand.init @":quit" @":quit, :q" @"exit" (ReplCommandArgument.None))
     (ReplCommand.init @":q" @":q" @"exit" (ReplCommandArgument.None))
     (ReplCommand.init @":abort"
                       @":abort"
                       @"discard the current input or edit"
                       (ReplCommandArgument.None))
     (ReplCommand.init @":reset"
                       @":reset"
                       @"clear definitions, native state, and live results"
                       (ReplCommandArgument.None))
     (ReplCommand.init @":reinit"
                       @":reinit"
                       @"discard native state and rebuild accepted declarations"
                       (ReplCommandArgument.None))
     (ReplCommand.init @":defs"
                       @":defs"
                       @"list active definitions and types"
                       (ReplCommandArgument.None))
     (ReplCommand.init @":type"
                       @":type <source>"
                       @"infer without executing"
                       (ReplCommandArgument.Source))
     (ReplCommand.init @":expand"
                       @":expand <source>"
                       @"expand without committing"
                       (ReplCommandArgument.Source))
     (ReplCommand.init @":expand-1"
                       @":expand-1 <source>"
                       @"expand one step"
                       (ReplCommandArgument.Source))
     (ReplCommand.init @":doc"
                       @":doc <name>"
                       @"show documentation"
                       (ReplCommandArgument.Name))
     (ReplCommand.init @":complete"
                       @":complete <prefix>"
                       @"list matching names and schemes"
                       (ReplCommandArgument.Name))
     (ReplCommand.init @":ownership"
                       @":ownership <name>"
                       @"show ownership actions"
                       (ReplCommandArgument.Name))
     (ReplCommand.init @":c"
                       @":c [--full] [name]"
                       @"inspect loaded C support artifacts"
                       (ReplCommandArgument.Name))
     (ReplCommand.init @":c-render"
                       @":c-render <source>"
                       @"render an alternate C-backend compilation"
                       (ReplCommandArgument.Source))
     (ReplCommand.init @":llvm"
                       @":llvm [--deps|--full] [name]"
                       @"inspect published LLVM artifacts"
                       (ReplCommandArgument.Name))
     (ReplCommand.init @":results"
                       @":results"
                       @"list live typed results"
                       (ReplCommandArgument.None))
     (ReplCommand.init @":inspect"
                       @":inspect N [selectors] [--offset N --count N --depth N --bytes N --raw --views --view selector]"
                       @"inspect a live value, list its views, or select a view"
                       (ReplCommandArgument.Text))
     (ReplCommand.init @":browse"
                       @":browse N [selectors]"
                       @"navigate a live value's views"
                       (ReplCommandArgument.Text))
     (ReplCommand.init @":drop"
                       @":drop N"
                       @"release result N and newer results"
                       (ReplCommandArgument.Text))
     (ReplCommand.init @":history"
                       @":history"
                       @"show source inputs and dependency status"
                       (ReplCommandArgument.None))
     (ReplCommand.init @":edit"
                       @":edit N"
                       @"edit an input"
                       (ReplCommandArgument.Text))
     (ReplCommand.init @":replay"
                       @":replay N"
                       @"explicitly evaluate an input again"
                       (ReplCommandArgument.Text))
     (ReplCommand.init @":remove"
                       @":remove N"
                       @"preview removal and affected inputs"
                       (ReplCommandArgument.Text))
     (ReplCommand.init @":remove!"
                       @":remove! N"
                       @"apply the current removal preview"
                       (ReplCommandArgument.Text))
     (ReplCommand.init @":export"
                       @":export <file>"
                       @"export active declarations in replay order"
                       (ReplCommandArgument.Text))
     (ReplCommand.init @":export-transcript"
                       @":export-transcript <file>"
                       @"export all source revisions"
                       (ReplCommandArgument.Text))])

  (defn parse [source]
    (let-do [characters (String.chars source)
             start 0
             end 0
             count (Array.length &characters)]
      (while-do (and (Int.< start count)
                     (Char.whitespace? @(Array.unsafe-nth &characters start)))
        (set! start (Int.inc start)))
      (set! end start)
      (while-do (and (Int.< end count)
                     (not (Char.whitespace? @(Array.unsafe-nth &characters end))))
        (set! end (Int.inc end)))
      (let [begin-bytes (String.length
              &(String.from-chars &(Array.prefix &characters start)))
            end-bytes (String.length
              &(String.from-chars &(Array.prefix &characters end)))]
        (ReplCommandInput.init
          (String.from-chars &(Array.slice &characters start end))
          (String.byte-slice source end-bytes (String.length source))
          begin-bytes
          end-bytes))))

  (defn command? [source]
    (let [input (parse source)]
      (String.starts-with? (ReplCommandInput.name &input) ":")))

  (defn definition [name]
    (let-do [commands (entries)
             selected (the (Maybe ReplCommand) (Maybe.Nothing))]
      (for [i 0 (Array.length &commands)]
        (let [command (Array.unsafe-nth &commands i)]
          (when (String.= name (ReplCommand.name command))
            (set! selected (Maybe.Just (ReplCommand.copy command))))))
      selected))

  (defn language? [source]
    (let [input (parse source)]
      (match (definition (ReplCommandInput.name &input))
        (Maybe.Just command)
          (match-ref (ReplCommand.argument &command)
            (ReplCommandArgument.Source) true
            _ false)
        (Maybe.Nothing) false)))

  (defn namespace? [source]
    (let [input (parse source)]
      (match (definition (ReplCommandInput.name &input))
        (Maybe.Just command)
          (match-ref (ReplCommand.argument &command)
            (ReplCommandArgument.Name) true
            _ false)
        (Maybe.Nothing) false)))

  (defn continue? [source]
    (if (command? source)
      (let [input (parse source)]
        (match (definition (ReplCommandInput.name &input))
          (Maybe.Just command)
            (match-ref (ReplCommand.argument &command)
              (ReplCommandArgument.Source) true
              _ false)
          (Maybe.Nothing) false))
      true))

  (defn at-head? [source cursor]
    (let [input (parse source)] (Int.<= cursor @(ReplCommandInput.end &input))))

  (defn help []
    (let-do [commands (entries)
             lines (the (Array String) [])]
      (for [i 0 (Array.length &commands)]
        (let [command (Array.unsafe-nth &commands i)]
          (unless (String.= (ReplCommand.name command) ":q")
            (Array.push-back! &lines
                              (fmt "%s\t%s"
                                   (ReplCommand.usage command)
                                   (ReplCommand.documentation command))))))
      (String.join "
" &lines)))

  (defn highlight [source]
    (let [input (parse source)]
      (ReplHighlight.init
        (ReplRange.init @(ReplCommandInput.start &input)
                        @(ReplCommandInput.end &input))
        (ReplHighlightKind.Command))))

  (defn reply [operation source cursor]
    (let-do [input (parse source)
             start @(ReplCommandInput.start &input)
             end @(ReplCommandInput.end &input)
             names (the (Array String) [])
             lines (the (Array String) [])]
      (if (and
          (match-ref operation (ReplQuery.Complete) true _ false)
          (Int.<= cursor end))
        (let [prefix (String.byte-slice source start (Int.max start cursor))
              commands (entries)]
          (for [i 0 (Array.length &commands)]
            (let [command (Array.unsafe-nth &commands i)]
              (when-do (String.starts-with? (ReplCommand.name command) &prefix)
                (Array.push-back! &names @(ReplCommand.name command))
                (Array.push-back! &lines @(ReplCommand.usage command))))))
        (match (definition (ReplCommandInput.name &input))
          (Maybe.Just command)
            (do
              (Array.push-back! &lines @(ReplCommand.usage &command))
              (Array.push-back! &lines @(ReplCommand.documentation &command)))
          (Maybe.Nothing) ()))
      (ReplEditingReply.init start end names (String.join "
" &lines)))))
