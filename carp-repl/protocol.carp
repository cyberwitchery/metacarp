(load "wire-macros.carp")

(doc ReplRange "is a half-open UTF-8 byte range in the exact request buffer.")
(defwire ReplRange [start Int end Int])

(defwire ReplHighlightKind
         (Symbol [])
         (Number [])
         (Boolean [])
         (String [])
         (Pattern [])
         (Character [])
         (Comment [])
         (Delimiter [])
         (ReaderPrefix [])
         (Syntax [])
         (Macro [])
         (Function [])
         (Value [])
         (Parameter [])
         (Local [])
         (Type [])
         (Module [])
         (Interface [])
         (External [])
         (Result [])
         (Command [])
         (Invalid []))

(defwire ReplHighlight [range ReplRange kind ReplHighlightKind])
(defwire ReplDelimiterPair [opening ReplRange closing ReplRange])
(defwire ReplSeverity (Information []) (Warning []) (Error []))
(defwire ReplDiagnostic
         [range (Maybe ReplRange) severity ReplSeverity message String])

(defwire ReplCompleteness
         (Complete [])
         (Incomplete [])
         (Invalid [])
         (Unknown []))
(defwire ReplAnalysisState
         (SyntaxOnly [])
         (Ready [])
         (Partial [])
         (Unavailable [String]))

(doc ReplAnalysis "contains presentation-neutral language facts. A consumer
must match document, source revision, and session revision before applying it.")
(defwire ReplAnalysis
         [document
          String
          revision
          Long
          session
          Long
          highlights
          (Array ReplHighlight)
          pairs
          (Array ReplDelimiterPair)
          diagnostics
          (Array ReplDiagnostic)
          completeness
          ReplCompleteness
          state
          ReplAnalysisState])

(defwire ReplQuery (Analyze []) (Complete []) (Documentation []) (Check []))
(defwire ReplLanguageRequest
         [operation
          ReplQuery
          document
          String
          revision
          Long
          session
          Long
          request
          Long
          source
          String
          cursor
          Int])

(defwire ReplEditingReply
         [start Int end Int replacements (Array String) information String])
(defwire ReplWord [start Int end Int prefix String name String active Bool])
(defwire ReplEditingResult
         [document
          String
          revision
          Long
          session
          Long
          request
          Long
          cursor
          Int
          reply
          ReplEditingReply])

(defwire ReplLanguageUpdate
         (Analysis [ReplAnalysis])
         (Editing [ReplEditingResult]))

(doc ReplLanguageClient "is the editor's complete language-service interface.
Requests transfer source text; poll transfers completed replies. Neither call
enters the compiler on the editor thread.")
(deftype ReplLanguageClient
  [request (Fn [ReplLanguageRequest] ())
   poll (Fn [] (Maybe ReplLanguageUpdate))
   session (Fn [] Long)
   wake-fd Int])
