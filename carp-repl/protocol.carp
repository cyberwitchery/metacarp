(doc ReplRange "is a half-open UTF-8 byte range in the exact request buffer.")
(deftype ReplRange [start Int
                    end Int])

(deftype ReplHighlightKind
  (Symbol [])
  (Number [])
  (Boolean [])
  (String [])
  (Pattern [])
  (Character [])
  (Comment [])
  (Delimiter [])
  (ReaderPrefix [])
  (Syntax [])
  (Macro [])
  (Function [])
  (Value [])
  (Parameter [])
  (Local [])
  (Type [])
  (Module [])
  (Interface [])
  (External [])
  (Result [])
  (Command [])
  (Invalid []))

(deftype ReplHighlight [range ReplRange
                        kind ReplHighlightKind])
(deftype ReplDelimiterPair [opening ReplRange
                            closing ReplRange])
(deftype ReplSeverity
  (Information [])
  (Warning [])
  (Error []))
(deftype ReplDiagnostic
  [range (Maybe ReplRange)
   severity ReplSeverity
   message String])

(deftype ReplCompleteness
  (Complete [])
  (Incomplete [])
  (Invalid [])
  (Unknown []))
(deftype ReplAnalysisState
  (SyntaxOnly [])
  (Ready [])
  (Partial [])
  (Unavailable [String]))

(doc ReplAnalysis "contains presentation-neutral language facts. A consumer
must match document, source revision, and session revision before applying it.")
(deftype ReplAnalysis
  [document String
   revision Long
   session Long
   highlights (Array ReplHighlight)
   pairs (Array ReplDelimiterPair)
   diagnostics (Array ReplDiagnostic)
   completeness ReplCompleteness
   state ReplAnalysisState])

(deftype ReplQuery
  (Analyze [])
  (Complete [])
  (Documentation [])
  (Check []))
(deftype ReplLanguageRequest
  [operation ReplQuery
   document String
   revision Long
   session Long
   request Long
   source String
   cursor Int])

(deftype ReplEditingReply
  [start Int
   end Int
   replacements (Array String)
   information String])
(deftype ReplWord [start Int
                   end Int
                   prefix String
                   name String
                   active Bool])
(deftype ReplEditingResult
  [document String
   revision Long
   session Long
   request Long
   cursor Int
   reply ReplEditingReply])

(deftype ReplLanguageUpdate
  (Analysis [ReplAnalysis])
  (Editing [ReplEditingResult]))

(doc ReplLanguageClient "is the editor's complete language-service interface.
Requests transfer source text; poll transfers completed replies. Neither call
enters the compiler on the editor thread.")
(deftype ReplLanguageClient
  [request (Fn [ReplLanguageRequest] ())
   poll (Fn [] (Maybe ReplLanguageUpdate))
   session (Fn [] Long)
   wake-fd Int])
