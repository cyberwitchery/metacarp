(load "wire-macros.carp")

(doc ReplRange "is a byte range in a request's source. `start` is the offset
of the first byte and `end` the offset after the last.")
(defwire ReplRange [start Int end Int])

(doc ReplHighlightKind "is the kind of a highlighted piece of source. It is a
literal (`Number`, `Boolean`, `String`, `Pattern` or `Character`), a `Symbol`,
a `Comment`, a `Delimiter`, a reader prefix such as `&` (`ReaderPrefix`), a
special form (`Syntax`), the name of a `Macro`, `Function`, `Value`,
`Parameter`, `Local`, `Type`, `Module`, `Interface` or `External`, a repl
`Result` or `Command`, or `Invalid` source.")
(defwire ReplHighlightKind
         (Symbol [])
         (Number [])
         (Boolean [])
         (String [])
         (Pattern [])
         (Character [])
         (Comment [])
         (Delimiter [])
         (ReaderPrefix [])
         (Syntax [])
         (Macro [])
         (Function [])
         (Value [])
         (Parameter [])
         (Local [])
         (Type [])
         (Module [])
         (Interface [])
         (External [])
         (Result [])
         (Command [])
         (Invalid []))

(doc ReplHighlight "highlights the source in `range` as `kind`.")
(defwire ReplHighlight [range ReplRange kind ReplHighlightKind])
(doc ReplDelimiterPair "is a matching pair of delimiters. `opening` and
`closing` are their ranges.")
(defwire ReplDelimiterPair [opening ReplRange closing ReplRange])
(doc ReplSeverity "is the severity of a diagnostic: `Information`, `Warning` or
`Error`.")
(defwire ReplSeverity (Information []) (Warning []) (Error []))
(doc ReplDiagnostic "is a diagnostic for the editor. `range` is the source it
is about, if any. `severity` is its severity. `message` describes it.")
(defwire ReplDiagnostic
         [range (Maybe ReplRange) severity ReplSeverity message String])

(doc ReplCompleteness "is whether a source is a complete input. `Complete`
is. `Incomplete` ends inside a form. `Invalid` cannot be read. `Unknown` is not
known yet.")
(defwire ReplCompleteness
         (Complete [])
         (Incomplete [])
         (Invalid [])
         (Unknown []))
(doc ReplAnalysisState "is how far an analysis got. `SyntaxOnly` used only
the reader. `Ready` is complete. `Partial` stopped early. `Unavailable` failed,
and holds the reason.")
(defwire ReplAnalysisState
         (SyntaxOnly [])
         (Ready [])
         (Partial [])
         (Unavailable [String]))

(doc ReplAnalysis "is the analysis of a source for the editor. `document`,
`revision` and `session` identify the source and the session it was analysed
in, and a consumer applies the analysis only if all three match. `highlights`
are the highlighted ranges. `pairs` are the matching delimiters. `diagnostics`
are the problems found. `completeness` is whether the source is a complete
input. `state` is how far the analysis got.")
(defwire ReplAnalysis
         [document
          String
          revision
          Long
          session
          Long
          highlights
          (Array ReplHighlight)
          pairs
          (Array ReplDelimiterPair)
          diagnostics
          (Array ReplDiagnostic)
          completeness
          ReplCompleteness
          state
          ReplAnalysisState])

(doc ReplQuery "is what a language request asks for. `Analyze` analyses the
source. `Complete` completes the name at the cursor. `Documentation` returns its
documentation. `Check` type-checks the source.")
(defwire ReplQuery (Analyze []) (Complete []) (Documentation []) (Check []))
(doc ReplLanguageRequest "is a language request from the editor. `operation`
is what it asks for. `document`, `revision` and `session` identify the source.
`request` numbers the request. `source` is the source text. `cursor` is the
byte offset of the cursor.")
(defwire ReplLanguageRequest
         [operation
          ReplQuery
          document
          String
          revision
          Long
          session
          Long
          request
          Long
          source
          String
          cursor
          Int])

(doc ReplEditingReply "is the answer to a completion or documentation
request. `start` and `end` are the range to replace. `replacements` are the
candidates. `information` is text to show, such as documentation.")
(defwire ReplEditingReply
         [start Int end Int replacements (Array String) information String])
(doc ReplWord "is the word at the cursor. `start` and `end` are its range.
`prefix` is the part before the cursor and `name` the whole word. `active` is
false inside a literal or a comment, where nothing is completed.")
(defwire ReplWord [start Int end Int prefix String name String active Bool])
(doc ReplEditingResult "is the reply to an editing request. `document`,
`revision`, `session` and `request` identify the request. `cursor` is the
cursor position it was made at. `reply` is the answer.")
(defwire ReplEditingResult
         [document
          String
          revision
          Long
          session
          Long
          request
          Long
          cursor
          Int
          reply
          ReplEditingReply])

(doc ReplLanguageUpdate "is a message from the language service: an
`Analysis`, or the result of an `Editing` request.")
(defwire ReplLanguageUpdate
         (Analysis [ReplAnalysis])
         (Editing [ReplEditingResult]))

(doc ReplLanguageClient "is the editor's interface to the language service.
`request` sends a request. `poll` returns a finished reply, if there is one.
`session` returns the revision of the service's session. `wake-fd` is a file
descriptor that becomes readable when a reply is ready. No call runs the
compiler on the editor's thread.")
(deftype ReplLanguageClient
  [request (Fn [ReplLanguageRequest] ())
   poll (Fn [] (Maybe ReplLanguageUpdate))
   session (Fn [] Long)
   wake-fd Int])
