(load "display.carp")

(deftype ReplPagerLine [start Int
                        row ReplDisplayRow])
(deftype ReplPagerLayout [lines (Array ReplPagerLine)
                          characters Int])

(doc ReplPager "lays out output independently of terminal input and compiler
state. Positions name source characters, so resizing preserves the same text.")
(defmodule ReplPager
  (defn- line [start pieces cells width]
    (ReplPagerLine.init start
                        (ReplDisplayRow.init (String.concat pieces) width @cells)))

  (doc layout "wraps text at terminal columns, retaining source anchors.
Controls are visible glyphs; combining characters stay on their base's row.")
  (defn layout [source columns]
    (let-do [characters (String.chars source)
             limit (Int.max 4 columns)
             lines (the (Array ReplPagerLine) [])
             pieces (the (Array String) [])
             cells (the (Array ReplDisplayCell) [])
             start 0
             width 0]
      (for [i 0 (Array.length &characters)]
        (let-do [c @(Array.unsafe-nth &characters i)
                 code (Char.to-int c)
                 size (ReplTextWidth.character c)]
          (if (Int.= code 10)
            (do
              (Array.push-back! &lines (line start &pieces &cells width))
              (set! start (Int.inc i))
              (set! pieces [])
              (set! cells [])
              (set! width 0))
            (let-do [glyph (cond
                       (Int.= code 9) @"    "
                       (Int.< code 32)
                         (String.from-chars &[\^ (Char.from-int (Int.+ code 64))])
                       (Int.= code 127) @"^?"
                       (String.from-chars &[c]))]
              (when-do (and (Int.> size 0) (Int.> (Int.+ width size) limit))
                (Array.push-back! &lines (line start &pieces &cells width))
                (set! start i)
                (set! pieces [])
                (set! cells [])
                (set! width 0))
              (Array.push-back! &pieces @&glyph)
              (Array.push-back! &cells (ReplDisplayCell.init glyph size -1))
              (set! width (Int.+ width size))))))
      (Array.push-back! &lines (line start &pieces &cells width))
      (ReplPagerLayout.init lines (Array.length &characters))))

  (doc row-at "finds the wrapped row containing a source character anchor.")
  (defn row-at [layout anchor]
    (let-do [lines (ReplPagerLayout.lines layout)
             row 0]
      (for [i 0 (Array.length lines)]
        (when (Int.<= @(ReplPagerLine.start (Array.unsafe-nth lines i)) anchor)
          (set! row i)))
      row))

  (doc move "moves by display rows, clamping at the document boundaries.")
  (defn move [layout anchor rows height]
    (let [lines (ReplPagerLayout.lines layout)
          last (Int.max 0
                        (Int.- (Array.length lines) (Int.max 1 (Int.dec height))))
          row (Int.max 0 (Int.min last (Int.+ (row-at layout anchor) rows)))]
      @(ReplPagerLine.start (Array.unsafe-nth lines row))))

  (doc find "finds the next literal Unicode match, wrapping once. The starting
position is excluded, so repeating search advances past the previous match.")
  (defn find [source query from backwards]
    (let-do [text (String.chars source)
             needle (String.chars query)
             length (Array.length &text)
             size (Array.length &needle)
             found (the (Maybe Int) (Maybe.Nothing))]
      (when (and (Int.> size 0) (Int.<= size length))
        (for [step 1 (Int.inc length)]
          (when (Maybe.nothing? &found)
            (let-do [position (Int.positive-mod
                       (Int.+ from (if backwards (Int.- 0 step) step))
                       length)
                     same (Int.<= (Int.+ position size) length)]
              (for [i 0 size]
                (when same
                  (unless (Char.=
                      @(Array.unsafe-nth &text (Int.+ position i))
                      @(Array.unsafe-nth &needle i))
                    (set! same false))))
              (when same (set! found (Maybe.Just position)))))))
      found))

  (doc frame "renders only the visible rows plus a status line. Layout and
search never execute a view provider or enter the compiler.")
  (defn frame [layout anchor columns height status]
    (let-do [lines (ReplPagerLayout.lines layout)
             count (Int.max 1 (Int.dec height))
             first (Int.min (row-at layout anchor)
                            (Int.max 0 (Int.- (Array.length lines) count)))
             visible (the (Array ReplDisplayRow) [])
             texts (the (Array String) [])]
      (for [i 0 count]
        (let-do [index (Int.+ first i)
                 row (if (Int.< index (Array.length lines))
                   @(ReplPagerLine.row (Array.unsafe-nth lines index))
                   (ReplDisplayRow.init @"" 0 []))]
          (Array.push-back! &texts @(ReplDisplayRow.text &row))
          (Array.push-back! &visible row)))
      (let-do [caption (if (String.empty? status)
                 (fmt
                   "lines %d-%d/%d  q close  Space next  b back  / find"
                   (Int.inc first)
                   (Int.min (Array.length lines) (Int.+ first count))
                   (Array.length lines))
                 @status)
               wrapped (ReplPager.layout &caption (Int.max 4 (Int.dec columns)))
               row @(ReplPagerLine.row
                 (Array.unsafe-nth (ReplPagerLayout.lines &wrapped) 0))]
        (Array.push-back! &texts @(ReplDisplayRow.text &row))
        (Array.push-back! &visible row))
      (ReplFrame.init (String.join "\r\n" &texts) visible count 0 count 0))))
