(doc FrameId "is a stable index into a compile-time environment's frame store.")
(deftype FrameId [index Int])

(doc CellId "is a stable index into a compile-time environment's cell store.")
(deftype CellId [index Int])

(doc CtEnvLookup "is the result of resolving one name. Ambiguity is explicit
so callers never depend on import order.")
(deftype CtEnvLookup
  (Missing [])
  (Found [CellId])
  (Ambiguous []))

(doc CtEnvBinding "maps a name in one frame to a mutable cell.")
(deftype CtEnvBinding [name String
                       cell CellId])

(doc CtEnvFrame "is one lexical compile-time scope. Parent and import
relationships use stable IDs, so extending an environment does not copy
bindings or values.

A frame that grows past `index-threshold` builds a name index and keeps it
up to date. Call frames and `let` frames hold a handful of bindings and scan
them; a module frame holding all of Core would otherwise be scanned, name by
name, by every reference that has to walk out to it. The index is empty until
the frame outgrows a scan, so the frames created per call cost nothing for
it.")
(deftype CtEnvFrame
  [parent (Maybe FrameId)
   imports (Array FrameId)
   bindings (Array CtEnvBinding)
   index (Map String CellId)
   indexed Bool])

;; the source of binding-epoch stamps. One counter for the process, never
;; reset: see the note on `CtEnvStore`.
(def *ct-env-epoch* 0)

(doc CtEnvCell "holds one mutable compile-time value.")
(deftype (CtEnvCell a) [value (Box a)])

(doc CtEnvStore "owns all frames and cells for one compile-time session.

`epoch` stamps the changes that can alter what a name RESOLVES to: a new
binding in a frame a body can see out to, or a new import. It does not count
writes through `set!`, which change a value without moving a name, and it does
not count local bindings, which a lowered body has already classified and
never looks up by name. Callers cache resolutions against it.

Stamps come from one process-wide counter rather than from a per-store one,
because stores are COPIED: a warm session expands transient source against a
snapshot copy, and two copies that diverge from one base would otherwise
reach the same number with different bindings, letting a cache filled against
one answer for the other. A global counter cannot collide. Two copies that
never diverge share a stamp, which is correct — they hold the same frames and
the same cells.")
(deftype (CtEnvStore a)
  [frames (Array CtEnvFrame)
   cells (Array (CtEnvCell a))
   epoch Int])

(defmodule CtEnv
  (private next-epoch!)
  (hidden next-epoch!)
  (defn next-epoch! []
    (let-do [stamp (Int.inc *ct-env-epoch*)] (set! *ct-env-epoch* stamp) stamp))

  (doc empty "creates an environment with no frames or cells.")
  (defn empty [] (CtEnvStore.init [] [] (next-epoch!)))

  (doc epoch "the environment's current binding epoch.")
  (defn epoch [store] @(CtEnvStore.epoch store))

  (private bump!)
  (hidden bump!)
  (defn bump! [store] (CtEnvStore.set-epoch! store (next-epoch!)))

  (private valid-frame?)
  (hidden valid-frame?)
  (defn valid-frame? [store frame]
    (let [index @(FrameId.index frame)]
      (and (Int.>= index 0)
           (Int.< index (Array.length (CtEnvStore.frames store))))))

  (private valid-cell?)
  (hidden valid-cell?)
  (defn valid-cell? [store cell]
    (let [index @(CellId.index cell)]
      (and (Int.>= index 0)
           (Int.< index (Array.length (CtEnvStore.cells store))))))

  (doc root! "allocates a root frame.")
  (defn root! [store]
    (let-do [id (FrameId.init (Array.length (CtEnvStore.frames store)))]
      (Array.push-back! (CtEnvStore.frames store)
                        (CtEnvFrame.init (Maybe.Nothing)
                                         []
                                         []
                                         (Map.init 0 0 [])
                                         false))
      id))

  (doc child! "allocates a lexical child of `parent`.")
  (defn child! [store parent]
    (let-do [id (FrameId.init (Array.length (CtEnvStore.frames store)))]
      (Array.push-back! (CtEnvStore.frames store)
                        (CtEnvFrame.init (Maybe.Just @parent)
                                         []
                                         []
                                         (Map.init 0 0 [])
                                         false))
      id))

  (doc index-threshold "the number of bindings past which a frame indexes its
names instead of scanning them.")
  (defn index-threshold [] 8)

  (private local-cell)
  (hidden local-cell)
  (defn local-cell [store frame name]
    (if (valid-frame? store frame)
      (let [stored (Array.unsafe-nth (CtEnvStore.frames store)
                                     @(FrameId.index frame))]
        (if @(CtEnvFrame.indexed stored)
          (Map.get-maybe (CtEnvFrame.index stored) name)
          (let-do [result (the (Maybe CellId) (Maybe.Nothing))
                   bindings (CtEnvFrame.bindings stored)
                   i (Int.dec (Array.length bindings))]
            (while-do (Int.>= i 0)
              (match-ref &result
                (Maybe.Nothing)
                  (let [binding (Array.unsafe-nth bindings i)]
                    (when (= (CtEnvBinding.name binding) name)
                      (set! result (Maybe.Just @(CtEnvBinding.cell binding)))))
                (Maybe.Just _) ())
              (set! i (Int.dec i)))
            result)))
      (Maybe.Nothing)))

  (private record-binding!)
  (hidden record-binding!)
  (doc record-binding! "appends a binding and keeps the frame's name index in
step, building it the first time the frame outgrows a scan. A later binding
of a name shadows an earlier one, which the index reproduces by overwriting
the entry.")
  (defn record-binding! [store frame name cell]
    (let-do [stored (Array.unsafe-nth (CtEnvStore.frames store)
                                      @(FrameId.index frame))]
      (Array.push-back! (CtEnvFrame.bindings stored)
                        (CtEnvBinding.init @name @cell))
      (if @(CtEnvFrame.indexed stored)
        (ignore (Map.put! (CtEnvFrame.index stored) name cell))
        (when (Int.>
            (Array.length (CtEnvFrame.bindings stored))
            (index-threshold))
          (let-do [_fresh (CtEnvFrame.set-index! stored
                                                 (the (Map String CellId)
                                                      (Map.create)))
                   bindings (CtEnvFrame.bindings stored)
                   n (Array.length bindings)]
            (for [i 0 n]
              (let [binding (Array.unsafe-nth bindings i)]
                (ignore
                  (Map.put! (CtEnvFrame.index stored)
                            (CtEnvBinding.name binding)
                            (CtEnvBinding.cell binding)))))
            (CtEnvFrame.set-indexed! stored true))))))

  (doc bind-cell! "adds a name in `frame` that refers to an existing cell.
This is the primitive used for aliases and imports.")
  (defn bind-cell! [store frame name cell]
    (if (and (valid-frame? store frame) (valid-cell? store cell))
      (do (record-binding! store frame name cell) (bump! store) true)
      false))

  (private bind-cell-local!)
  (hidden bind-cell-local!)
  (defn bind-cell-local! [store frame name cell]
    (if (and (valid-frame? store frame) (valid-cell? store cell))
      (do (record-binding! store frame name cell) true)
      false))

  (doc define! "allocates a cell and binds it in `frame`. A later definition
of the same local name shadows the earlier binding.")
  (defn define! [store frame name value]
    (let-do [cell (CellId.init (Array.length (CtEnvStore.cells store)))]
      (Array.push-back! (CtEnvStore.cells store)
                        (CtEnvCell.init (Box.init value)))
      (ignore (bind-cell! store frame name &cell))
      cell))

  (doc define-local! "binds a name that no free reference can see: a
parameter, a `let` binding, a loop variable. Lowering classifies these names
where they are written, so binding one cannot change what any other name
resolves to, and the epoch stays where it is. Binding them through `define!`
instead would invalidate every cached resolution on every call.")
  (defn define-local! [store frame name value]
    (let-do [cell (CellId.init (Array.length (CtEnvStore.cells store)))]
      (Array.push-back! (CtEnvStore.cells store)
                        (CtEnvCell.init (Box.init value)))
      (ignore (bind-cell-local! store frame name &cell))
      cell))

  (doc add-import! "adds an imported frame searched after lexical parents.")
  (defn add-import! [store frame imported]
    (if (and (valid-frame? store frame) (valid-frame? store imported))
      (do
        (Array.push-back!
          (CtEnvFrame.imports
            (Array.unsafe-nth (CtEnvStore.frames store) @(FrameId.index frame)))
          @imported)
        (bump! store)
        true)
      false))

  (doc local-bindings "the names bound directly in `frame`, innermost
definition of each name last, paired with the cell that holds the value. A
debugger asks this to show what is in scope where it stopped; nothing in the
evaluator needs it, because evaluation looks names up rather than listing
them.")
  (defn local-bindings [store frame]
    (if (valid-frame? store frame)
      (Array.copy
        (CtEnvFrame.bindings
          (Array.unsafe-nth (CtEnvStore.frames store) @(FrameId.index frame))))
      (the (Array CtEnvBinding) [])))

  (doc parent-frame "the frame `frame` was created inside, if it has one.")
  (defn parent-frame [store frame]
    (if (valid-frame? store frame)
      @(CtEnvFrame.parent
        (Array.unsafe-nth (CtEnvStore.frames store) @(FrameId.index frame)))
      (the (Maybe FrameId) (Maybe.Nothing))))

  (doc imports "returns the imported frames visible from `frame`.")
  (defn imports [store frame]
    (if (valid-frame? store frame)
      (Array.copy
        (CtEnvFrame.imports
          (Array.unsafe-nth (CtEnvStore.frames store) @(FrameId.index frame))))
      (the (Array FrameId) [])))

  (private lookup-cell-depth)
  (hidden lookup-cell-depth)
  (defn lookup-cell-depth [store frame name depth]
    (if (or (not (valid-frame? store frame))
            (Int.> depth (Array.length (CtEnvStore.frames store))))
      (CtEnvLookup.Missing)
      (match (local-cell store frame name)
        (Maybe.Just cell) (CtEnvLookup.Found cell)
        (Maybe.Nothing)
          (let [stored (Array.unsafe-nth (CtEnvStore.frames store)
                                         @(FrameId.index frame))]
            (let-do [result (the CtEnvLookup (CtEnvLookup.Missing))
                     imports (CtEnvFrame.imports stored)
                     n (Array.length imports)]
              (for [i 0 n]
                (match-ref &result
                  (CtEnvLookup.Ambiguous) ()
                  _
                    (match (local-cell store (Array.unsafe-nth imports i) name)
                      (Maybe.Just imported-cell)
                        (match-ref &result
                          (CtEnvLookup.Missing)
                            (set! result (CtEnvLookup.Found imported-cell))
                          (CtEnvLookup.Found prior-cell)
                            (when (/= @(CellId.index prior-cell)
                                      @(CellId.index &imported-cell))
                              (set! result (CtEnvLookup.Ambiguous)))
                          (CtEnvLookup.Ambiguous) ())
                      (Maybe.Nothing) ())))
              (match result
                (CtEnvLookup.Found cell) (CtEnvLookup.Found cell)
                (CtEnvLookup.Ambiguous) (CtEnvLookup.Ambiguous)
                (CtEnvLookup.Missing)
                  (match-ref (CtEnvFrame.parent stored)
                    (Maybe.Just parent)
                      (lookup-cell-depth store parent name (Int.inc depth))
                    (Maybe.Nothing) (CtEnvLookup.Missing))))))))

  (doc lookup-status "resolves a name while preserving ambiguity.")
  (defn lookup-status [store frame name] (lookup-cell-depth store frame name 0))

  (doc lookup-cell "resolves a name through the current frame, imports, and
lexical parents.")
  (defn lookup-cell [store frame name]
    (match (lookup-status store frame name)
      (CtEnvLookup.Found cell) (Maybe.Just cell)
      _ (Maybe.Nothing)))

  (doc cell-index "the raw index of a cell, for callers that cache it.")
  (defn cell-index [cell] @(CellId.index cell))

  (doc cell-at "rebuilds a cell id from a cached index.")
  (defn cell-at [index] (CellId.init index))

  (doc peek-cell "borrows the value in a cell. A caller that only needs to
LOOK at a binding — to classify it, not to use it — borrows instead of
copying, which for a compile-time value means not copying a syntax tree.")
  (defn peek-cell [store cell]
    (Box.peek
      (CtEnvCell.value
        (Array.unsafe-nth (CtEnvStore.cells store) @(CellId.index cell)))))

  (doc read-cell "copies the value in a cell.")
  (defn read-cell [store cell]
    (if (valid-cell? store cell)
      (Maybe.Just
        (copy
          (Box.peek
            (CtEnvCell.value
              (Array.unsafe-nth (CtEnvStore.cells store) @(CellId.index cell))))))
      (Maybe.Nothing)))

  (doc lookup "resolves `name` and copies its value.")
  (defn lookup [store frame name]
    (match (lookup-cell store frame name)
      (Maybe.Just cell) (read-cell store &cell)
      (Maybe.Nothing) (Maybe.Nothing)))

  (doc write-cell! "replaces the value in an existing cell.")
  (defn write-cell! [store cell value]
    (if (valid-cell? store cell)
      (do
        (CtEnvCell.set-value!
          (Array.unsafe-nth (CtEnvStore.cells store) @(CellId.index cell))
          (Box.init value))
        true)
      false))

  (doc set! "updates the cell resolved by `name`.")
  (defn set! [store frame name value]
    (match (lookup-cell store frame name)
      (Maybe.Just cell) (write-cell! store &cell value)
      (Maybe.Nothing) false)))
