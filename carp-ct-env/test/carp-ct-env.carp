(load "../carp-ct-env.carp")
(Project.no-echo)
(load "Test.carp")

(use-all Test)

(defn lookup-is? [store frame name expected]
  (match (CtEnv.lookup store frame name)
    (Maybe.Just value) (Int.= value expected)
    (Maybe.Nothing) false))

(defn lexical-parent? []
  (let-do [store (CtEnv.empty)
           root (CtEnv.root! &store)
           _ (CtEnv.define! &store &root "x" 1)
           child (CtEnv.child! &store &root)]
    (lookup-is? &store &child "x" 1)))

(defn shadows-parent? []
  (let-do [store (CtEnv.empty)
           root (CtEnv.root! &store)
           root-binding (CtEnv.define! &store &root "x" 1)
           child (CtEnv.child! &store &root)
           child-binding (CtEnv.define! &store &child "x" 2)]
    (and (lookup-is? &store &child "x" 2) (lookup-is? &store &root "x" 1))))

(defn mutation-persists? []
  (let-do [store (CtEnv.empty)
           root (CtEnv.root! &store)
           x (CtEnv.define! &store &root "x" 1)
           child (CtEnv.child! &store &root)
           changed (CtEnv.set! &store &child "x" 3)]
    (and changed
         (match (CtEnv.read-cell &store &x)
           (Maybe.Just value) (Int.= value 3)
           (Maybe.Nothing) false))))

(defn aliases-share-cell? []
  (let-do [store (CtEnv.empty)
           root (CtEnv.root! &store)
           x (CtEnv.define! &store &root "x" 1)
           alias-frame (CtEnv.root! &store)
           bound (CtEnv.bind-cell! &store &alias-frame "alias" &x)
           changed (CtEnv.set! &store &alias-frame "alias" 4)]
    (and bound (and changed (lookup-is? &store &root "x" 4)))))

(defn imports-work? []
  (let-do [store (CtEnv.empty)
           exported (CtEnv.root! &store)
           _ (CtEnv.define! &store &exported "value" 9)
           consumer (CtEnv.root! &store)
           imported (CtEnv.add-import! &store &consumer &exported)]
    (and imported (lookup-is? &store &consumer "value" 9))))

(defn ambiguous-imports-are-explicit? []
  (let-do [store (CtEnv.empty)
           first (CtEnv.root! &store)
           first-binding (CtEnv.define! &store &first "value" 1)
           second (CtEnv.root! &store)
           second-binding (CtEnv.define! &store &second "value" 2)
           consumer (CtEnv.root! &store)
           first-import (CtEnv.add-import! &store &consumer &first)
           second-import (CtEnv.add-import! &store &consumer &second)]
    (match (CtEnv.lookup-status &store &consumer "value")
      (CtEnvLookup.Ambiguous) true
      _ false)))

(deftest t
  (assert-true t
    (lexical-parent?)
    "children see bindings in their lexical parent")
  (assert-true t
    (shadows-parent?)
    "a child binding shadows without replacing its parent")
  (assert-true t (mutation-persists?) "set! updates the resolved stable cell")
  (assert-true t (aliases-share-cell?) "aliases share mutation")
  (assert-true t (imports-work?) "lookup searches imported frames")
  (assert-true t
    (ambiguous-imports-are-explicit?)
    "two imported cells with the same name are ambiguous"))
