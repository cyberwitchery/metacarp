(load "../carp-ownership/carp-ownership.carp")
(load "../carp-types/core-instantiation.carp")

(doc DeriveContext "is the state of one derivation run.
`preserve-expression-ids` is whether expression ids are kept, as a session
needs, instead of renumbered. `fallback-str-ids` holds the ids of the field-less
`str` functions derived for generic types, which per-instance derivation may
replace.")
(deftype DeriveContext
  [preserve-expression-ids Bool
   fallback-str-ids (Array Int)])

(doc Derive "derives functions that the reference compiler derives for types:
`delete` and `copy` for types that own memory through their fields, `str` and
`prn`, and record accessors, setters and updaters. It also gives
`Pair.init-from-refs` and registered C types their bodies. Each derived function
is a core IR function added before inference, so the normal pipeline handles it.
Generic instances are found from inference and closed over the instances nested
in them.")

(defmodule Derive
  (private finish-indexing)
  (hidden finish-indexing)
  (doc finish-indexing "renumbers the call sites of `core`, unless `context`
keeps expression ids.")
  (defn finish-indexing [context core]
    (if @(DeriveContext.preserve-expression-ids context)
      core
      (CoreIR.index-call-sites core)))

  (private contains-key?)
  (hidden contains-key?)
  (defn contains-key? [keys key]
    (let-do [found false
             i 0
             n (Array.length keys)]
      (while (and (Int.< i n) (not found))
        (if (String.= (Array.unsafe-nth keys i) key)
          (set! found true)
          (set! i (Int.inc i))))
      found))

  (private subst-lookup)
  (hidden subst-lookup)
  (defn subst-lookup [subst var]
    (let-do [result (MonoType.Variable 0)
             found false
             i 0
             n (Array.length subst)]
      (while (and (Int.< i n) (not found))
        (let [entry (Array.unsafe-nth subst i)]
          (if (String.= (Pair.a entry) var)
            (do (set! result (MonoType.copy (Pair.b entry))) (set! found true))
            (set! i (Int.inc i)))))
      (Result.Success result)))

  (private core->mono)
  (hidden core->mono)

  (sig core->mono
       (Fn [(Ref CoreType) (Ref (Array (Pair String MonoType)))] MonoType))

  (doc core->mono "returns the field type `core-type` with the type variables in
`subst` replaced by concrete types.")
  (defn core->mono [core-type subst]
    (Result.from-success
      (CoreInstantiation.type-with core-type subst &subst-lookup)
      (MonoType.Variable 0)))

  (private build-subst)
  (hidden build-subst)
  (doc build-subst "returns the type variable bindings that make `result-type`,
a constructor's result, equal to the concrete `instance`.")
  (defn build-subst [result-type instance]
    (let-do [subst (the (Array (Pair String MonoType)) [])]
      (match-ref result-type
        (CoreType.Named _ rargs)
          (match-ref instance
            (MonoType.Named _ margs)
              (for [i 0 (Int.min (Array.length rargs) (Array.length margs))]
                (match-ref (Box.peek (Array.unsafe-nth rargs i))
                  (CoreType.Variable v)
                    (set! subst
                          (Array.push-back subst
                                           (Pair.init (String.copy v)
                                                      (MonoType.copy (Box.peek (Array.unsafe-nth margs
                                                                                                 i))))))
                  _ ()))
            _ ())
        _ ())
      subst))

  (private managed-mono?)
  (hidden managed-mono?)
  (private managed-instance?)
  (hidden managed-instance?)
  (sig managed-mono?
       (Fn
         [(Ref MonoType)
          (Ref (Array CoreConstructorDeclaration))
          (Ref (Array String))]
         Bool))
  (sig managed-instance?
       (Fn
         [(Ref MonoType)
          (Ref (Array CoreConstructorDeclaration))
          (Ref (Array String))]
         Bool))

  (doc managed-mono? "checks whether the concrete type `mono` owns memory:
strings, functions, arrays, types in `base-managed`, types with a deleter for
all their instances, and generic instances with a managed field.")
  (defn managed-mono? [mono constructors base-managed]
    (match-ref mono
      (MonoType.String) true
      (MonoType.Function _ _) true
      (MonoType.Named name args)
        (cond
          (contains-key? base-managed &(CAbi.type-key mono))
          true
          ;; a deleter declared once for every instance of a type — core's
          ;; `(sig delete (Fn [(Box a)] ()))` — is keyed generically. Without
          ;; this, `(Box Int)` owns a heap cell no field of it accounts for
          ;; and nothing ever frees it. Only an application can carry one, and
          ;; the key allocates, so plain names skip the question.
          (and (Int.> (Array.length args) 0)
               (contains-key? base-managed &(CAbi.generic-key mono)))
          true
          ;; builtin containers own heap storage at every instantiation but
          ;; have no constructor declarations to classify through.
          (or (String.= name "Array") (String.= name "StaticArray"))
          true
          (Int.> (Array.length args) 0)
          (managed-instance? mono constructors base-managed)
          false)
      _ false))

  (defn managed-instance? [mono constructors base-managed]
    (match-ref mono
      (MonoType.Named name _)
        (let-do [found false
                 n (Array.length constructors)]
          (for [i 0 n]
            (let [c (Array.unsafe-nth constructors i)]
              (match-ref (Box.peek (CoreConstructorDeclaration.result c))
                (CoreType.Named rname _)
                  (when (String.= rname name)
                    (let-do [subst (build-subst
                               (Box.peek (CoreConstructorDeclaration.result c))
                               mono)
                             fields (CoreConstructorDeclaration.arguments c)]
                      (for [fi 0 (Array.length fields)]
                        (when (managed-mono?
                            &(core->mono (Box.peek (Array.unsafe-nth fields fi))
                                         &subst)
                            constructors
                            base-managed)
                          (set! found true)))))
                _ ())))
          found)
      _ false))

  (doc core-type-key "returns the ABI key of a field or result type: for a
string or a named type without arguments. Other types give `Nothing`.")
  (private core-type-key)
  (hidden core-type-key)
  (defn core-type-key [core-type]
    (match-ref core-type
      (CoreType.String) (Maybe.Just (CAbi.type-key &(MonoType.String)))
      (CoreType.Named name arguments)
        (if (Int.= 0 (Array.length arguments))
          (Maybe.Just (CAbi.type-key &(MonoType.Named (String.copy name) [])))
          (Maybe.Nothing))
      _ (Maybe.Nothing)))

  (private core-base-type-key)
  (hidden core-base-type-key)
  (defn core-base-type-key [core-type]
    (match-ref core-type
      (CoreType.Named name _)
        (Maybe.Just (CAbi.type-key &(MonoType.Named (String.copy name) [])))
      _ (Maybe.Nothing)))

  (private core-generic-key)
  (hidden core-generic-key)
  ; the key of a named type with every argument generalized away, which is
  ; where a deleter declared for all instances (`(Fn [(Box a)] ())`) is
  ; recorded. see `CAbi.generic-key`.
  (defn core-generic-key [name arity]
    (let-do [arguments (the (Array (Box MonoType)) [])]
      (for [i 0 arity]
        (Array.push-back! &arguments (Box.init (MonoType.Variable 0))))
      (CAbi.generic-key &(MonoType.Named (String.copy name) arguments))))

  (private field-managed?)
  (hidden field-managed?)
  ; a generic application can hold memory though it has no bare type key:
  ; Array and StaticArray always do, a type with a deleter for all its
  ; instances does, and a user generic does when applied to a managed argument.
  ; otherwise a type that holds memory only through containers would get a
  ; shallow copier. `Ptr` is an unmanaged raw pointer.
  (defn field-managed? [field-type managed]
    (match-ref field-type
      ; Strings own storage even when a session delta omits Core's deleters.
      (CoreType.String)
      true
      ;; a function value may carry a heap-allocated closure environment, so a
      ;; field holding one makes its type managed. `managed-mono?` applies the
      ;; same rule on the per-instance path generic types take.
      (CoreType.Function _ _)
      true
      (CoreType.Named name arguments)
      (cond
        (Int.= 0 (Array.length arguments))
        (match (core-type-key field-type)
          (Maybe.Just key) (contains-key? managed &key)
          (Maybe.Nothing) false)
        (String.= name "Ptr")
        false
        (or (String.= name "Array") (String.= name "StaticArray"))
        true
        (contains-key? managed &(core-generic-key name (Array.length arguments)))
        true
        ;; a generic whose own fields hold memory whatever it is applied to
        ;; (`Map`'s bucket array) is managed at every application, not only
        ;; over managed arguments: deciding by the arguments alone derived a
        ;; shallow copier for `(Map Int Int)` members, and copies aliased the
        ;; buckets.
        (match (core-base-type-key field-type)
          (Maybe.Just key) (contains-key? managed &key)
          (Maybe.Nothing) false)
        true
        (let-do [any false]
          (for [i 0 (Array.length arguments)]
            (when (field-managed?
                (Box.peek (Array.unsafe-nth arguments i))
                managed)
              (set! any true)))
          any))
      _
      (match (core-type-key field-type)
        (Maybe.Just key) (contains-key? managed &key)
        (Maybe.Nothing) false)))

  (private constructor-has-managed-field?)
  (hidden constructor-has-managed-field?)
  (defn constructor-has-managed-field? [constructor managed]
    (let-do [found false
             fields (CoreConstructorDeclaration.arguments constructor)
             n (Array.length fields)]
      (for [i 0 n]
        (when (field-managed? (Box.peek (Array.unsafe-nth fields i)) managed)
          (set! found true)))
      found))

  (doc managed-keys "returns the keys of the types that own memory: `owned`, the
types with a deleter, plus every type with a managed field, transitively. A
generic type is keyed by its name and counts if a field owns memory whatever its
type variables are.")
  (private managed-keys)
  (hidden managed-keys)
  (defn managed-keys [core owned]
    (let-do [managed (Array.copy owned)
             constructors (CoreModule.constructors core)
             n (Array.length constructors)
             changed true]
      (while-do changed
        (set! changed false)
        (for [i 0 n]
          (let [c (Array.unsafe-nth constructors i)]
            (match (core-base-type-key
                (Box.peek (CoreConstructorDeclaration.result c)))
              (Maybe.Just rkey)
                (unless-do (contains-key? &managed &rkey)
                  (when-do (constructor-has-managed-field? c &managed)
                    (set! managed (Array.push-back managed rkey))
                    (set! changed true)))
              (Maybe.Nothing) ()))))
      managed))

  (doc derive-target-keys "returns the keys of the concrete types that need a
derived deleter: they own memory through their fields and have no deleter of
their own.")
  (defn derive-target-keys [core]
    (let-do [facts (OwnershipClassify.facts-from-module core)
             owned (OwnershipTypeFacts.owned &facts)
             managed (managed-keys core owned)
             result (the (Array String) [])
             constructors (CoreModule.constructors core)
             n (Array.length constructors)]
      (for [i 0 n]
        (let [c (Array.unsafe-nth constructors i)]
          (match (core-type-key (Box.peek (CoreConstructorDeclaration.result c)))
            (Maybe.Just rkey)
              (unless-do (or (contains-key? owned &rkey)
                             (contains-key? &result &rkey))
                (when (contains-key? &managed &rkey)
                  (set! result (Array.push-back result rkey))))
            (Maybe.Nothing) ())))
      result))

  (private record-declaration?)
  (hidden record-declaration?)
  ;; a record declares its members; a sum type carries its data in its
  ;; constructors and declares none.
  (defn record-declaration? [declarations name]
    (let-do [found false
             n (Array.length declarations)]
      (for [i 0 n]
        (let [declaration (Array.unsafe-nth declarations i)]
          (when (and
              (String.= (CoreTypeDeclaration.name declaration) name)
              (Int.> (Array.length (CoreTypeDeclaration.members declaration)) 0))
            (set! found true))))
      found))

  (doc sum-keys "returns the keys of the types that `copies` derives a `copy`
for besides the managed ones: types with more than one constructor, and concrete
unmanaged types with one constructor and no fields that are not records.")
  (defn sum-keys [core managed]
    (let-do [constructors (CoreModule.constructors core)
             declarations (CoreModule.type-declarations core)
             result (the (Array String) [])
             n (Array.length constructors)]
      (for [i 0 n]
        (let [c (Array.unsafe-nth constructors i)]
          (match-ref (Box.peek (CoreConstructorDeclaration.result c))
            (CoreType.Named name arguments)
              (match (core-base-type-key
                  (Box.peek (CoreConstructorDeclaration.result c)))
                (Maybe.Just rkey)
                  (unless (contains-key? &result &rkey)
                    (when (or
                        (Int.> @(CoreConstructorDeclaration.tag c) 0)
                        (and (Int.= 0 (Array.length arguments))
                             (and
                               (not (record-declaration? declarations name))
                               (not (contains-key? managed &rkey)))))
                      (set! result (Array.push-back result rkey))))
                (Maybe.Nothing) ())
            _ ())))
      result)))

(defmodule Derive
  (private next-id!)
  (hidden next-id!)
  (defn next-id! [cell]
    (let-do [value @(Array.unsafe-nth cell 0)]
      (Array.aset! cell 0 (Int.inc value))
      value))

  (private deftype-name)
  (hidden deftype-name)
  (defn deftype-name [constructors key]
    (let-do [result (String.copy "")
             n (Array.length constructors)]
      (for [i 0 n]
        (match-ref (Box.peek
            (CoreConstructorDeclaration.result (Array.unsafe-nth constructors i)))
          (CoreType.Named name arguments)
            (when (String.=
                &(CAbi.type-key &(MonoType.Named (String.copy name) []))
                key)
              (set! result (String.copy name)))
          _ ()))
      result))

  (private constructor-of?)
  (hidden constructor-of?)
  (defn constructor-of? [constructor key]
    (match (core-base-type-key
        (Box.peek (CoreConstructorDeclaration.result constructor)))
      (Maybe.Just candidate) (String.= &candidate key)
      (Maybe.Nothing) false))

  (private delete-branch)
  (hidden delete-branch)
  (defn delete-branch [constructor managed delete-ref cell]
    (let-do [fields (CoreConstructorDeclaration.arguments constructor)
             nf (Array.length fields)
             patterns (the (Array (Box CorePattern)) [])
             bindings (the (Array CoreRef) [])
             body-exprs (the (Array (Box CoreExpr)) [])]
      (for [fi 0 nf]
        ;; unmanaged fields have nothing to delete: an `Ignore` slot instead
        ;; of an unused binding keeps the emitted C warning-free.
        (if (field-managed? (Box.peek (Array.unsafe-nth fields fi)) managed)
          (let-do [fref (CoreRef.init (next-id! cell)
                                      (String.concat &[@"field" (Int.str fi)])
                                      false)]
            (set! patterns
                  (Array.push-back patterns
                                   (Box.init (CorePattern.Bind (CoreRef.copy &fref)))))
            (set! bindings (Array.push-back bindings (CoreRef.copy &fref)))
            (set! body-exprs
                  (Array.push-back body-exprs
                                   (Box.init
                                     (CoreExpr.Call -1
                                                    (Box.init
                                                      (CoreExpr.Reference -1
                                                                          (CoreRef.copy delete-ref)))
                                                    [(Box.init
                                                       (CoreExpr.Reference -1
                                                                           (CoreRef.copy &fref)))])))))
          (set! patterns
                (Array.push-back patterns (Box.init (CorePattern.Ignore))))))
      (CoreMatchBranch.init
        (CorePattern.Constructor
          (CoreRef.copy (CoreConstructorDeclaration.reference constructor))
          patterns)
        bindings
        (Box.init
          (if (Int.= 0 (Array.length &body-exprs))
            (CoreExpr.UnitLit -1)
            (CoreExpr.Do -1 body-exprs))))))

  (doc deletes "returns `core` with a derived `delete` for every concrete type
that owns memory through its fields and has no deleter of its own. Each matches
over the constructors and deletes every managed field.")
  (defn deletes [context core]
    (let-do [targets (derive-target-keys core)
             facts (OwnershipClassify.facts-from-module core)
             managed (managed-keys core (OwnershipTypeFacts.owned &facts))
             constructors (CoreModule.constructors core)
             new-functions (Array.copy (CoreModule.functions core))
             new-impls (Array.copy (CoreModule.implementations core))
             new-signatures (Array.copy (CoreModule.signatures core))
             delete-ref (PrimitiveRegistry.delete-reference)
             cell (the (Array Int)
                       [(Int.inc (CoreIR.max-declared-global-id core))])]
      (for [t 0 (Array.length &targets)]
        (let-do [tkey (Array.unsafe-nth &targets t)
                 type-name (deftype-name constructors tkey)
                 fn-ref (CoreRef.init (next-id! &cell)
                                      (String.concat &[(String.copy &type-name)
                                                       @".delete"])
                                      true)
                 param-ref (CoreRef.init (next-id! &cell) @"x" false)
                 branches (the (Array CoreMatchBranch) [])
                 cn (Array.length constructors)]
          (for [ci 0 cn]
            (let [c (Array.unsafe-nth constructors ci)]
              (when (constructor-of? c tkey)
                (set! branches
                      (Array.push-back branches
                                       (delete-branch c
                                                      &managed
                                                      &delete-ref
                                                      &cell))))))
          (set! new-functions
                (Array.push-back new-functions
                                 (CoreFunction.init (CoreRef.copy &fn-ref)
                                                    [(CoreRef.copy &param-ref)]
                                                    (Box.init
                                                      (CoreExpr.Match -1
                                                                      false
                                                                      (Box.init
                                                                        (CoreExpr.Reference -1
                                                                                            (CoreRef.copy &param-ref)))
                                                                      branches)))))
          (set! new-impls
                (Array.push-back new-impls
                                 (CoreImplementation.init (CoreRef.copy &delete-ref)
                                                          (CoreRef.copy &fn-ref))))
          (set! new-signatures
                (Array.push-back new-signatures
                                 (CoreSignature.init (CoreRef.copy &fn-ref)
                                                     (Box.init
                                                       (CoreType.Function
                                                         [(Box.init
                                                            (CoreType.Named (String.copy &type-name)
                                                                            []))]
                                                         (Box.init (CoreType.Unit)))))))))
      (finish-indexing context
                       (CoreModule.init new-functions
                                        @(CoreModule.values core)
                                        @(CoreModule.builtins core)
                                        @(CoreModule.builtin-sources core)
                                        new-signatures
                                        @(CoreModule.type-declarations core)
                                        @(CoreModule.constructors core)
                                        @(CoreModule.recursive-types core)
                                        @(CoreModule.interfaces core)
                                        new-impls
                                        @(CoreModule.overloads core)
                                        @(CoreModule.system-includes core)
                                        @(CoreModule.expressions core))))))

(defmodule Derive
  (private mono->core)
  (hidden mono->core)
  (private map-mono->core)
  (hidden map-mono->core)
  (sig mono->core (Fn [(Ref MonoType)] CoreType))
  (sig map-mono->core (Fn [(Ref (Array (Box MonoType)))] (Array (Box CoreType))))
  (defn map-mono->core [args]
    (let-do [result (the (Array (Box CoreType)) [])
             n (Array.length args)]
      (for [i 0 n]
        (set! result
              (Array.push-back result
                               (Box.init
                                 (mono->core (Box.peek (Array.unsafe-nth args i)))))))
      result))

  (doc mono->core "returns `mono` as a core type, for the signatures of
per-instance functions. Every type variable becomes `a`.")
  (defn mono->core [mono]
    (match-ref mono
      (MonoType.Integer) (CoreType.Integer)
      (MonoType.String) (CoreType.String)
      (MonoType.Boolean) (CoreType.Boolean)
      (MonoType.Unit) (CoreType.Unit)
      (MonoType.Named n args)
        (CoreType.Named (String.copy n) (map-mono->core args))
      (MonoType.Reference inner _)
        (CoreType.Reference (Box.init (mono->core (Box.peek inner)))
                            (CoreLifetime.Static))
      (MonoType.Function args ret)
        (CoreType.Function (map-mono->core args)
                           (Box.init (mono->core (Box.peek ret))))
      (MonoType.Variable _) (CoreType.Variable (String.copy "a"))))

  (private generic-instance?)
  (hidden generic-instance?)
  (defn generic-instance? [mono]
    (match-ref mono
      (MonoType.Named _ args) (Int.> (Array.length args) 0)
      _ false))

  (private instance-listed?)
  (hidden instance-listed?)
  (defn instance-listed? [instances mono]
    (let-do [found false
             key (CAbi.type-key mono)
             n (Array.length instances)]
      (for [i 0 n]
        (when (String.= &(CAbi.type-key (Array.unsafe-nth instances i)) &key)
          (set! found true)))
      found))

  (private constructors-declared?)
  (hidden constructors-declared?)
  (defn constructors-declared? [constructors name]
    (let-do [found false
             n (Array.length constructors)]
      (for [i 0 n]
        (match-ref (Box.peek
            (CoreConstructorDeclaration.result (Array.unsafe-nth constructors i)))
          (CoreType.Named rname _)
            (when (String.= rname name) (set! found true))
          _ ()))
      found))

  (private declared-type-names)
  (hidden declared-type-names)
  (doc declared-type-names "returns the names of the types that `constructors`
declare.")
  (defn declared-type-names [constructors]
    (let-do [names (the (Set String) (Set.create))]
      (for [i 0 (Array.length constructors)]
        (match-ref (Box.peek
            (CoreConstructorDeclaration.result (Array.unsafe-nth constructors i)))
          (CoreType.Named name _) (Set.put! &names name)
          _ ()))
      names))

  (private extract-instances!)
  (hidden extract-instances!)
  (sig extract-instances!
       (Fn
         [(Ref MonoType)
          (Ref (Array CoreConstructorDeclaration))
          (Ref (Set String))
          (Ref (Array String))
          (Ref (Set String))
          (Ref (Array MonoType))]
         ()))
  (defn extract-instances! [type constructors declared base-managed keys acc]
    (match-ref type
      (MonoType.Named name args)
        (do
          ; only declared types are derived: Array and StaticArray have no
          ; constructors and use template copy and delete
          ;; `keys` holds every instance already classified, managed or
          ;; not: whether one is managed depends only on the type
          (when (and (Int.> (Array.length args) 0) (Set.contains? declared name))
            (let [key (CAbi.type-key type)]
              (unless-do (Set.contains? keys &key)
                (Set.put! keys &key)
                (when (managed-mono? type constructors base-managed)
                  (Array.push-back! acc (MonoType.copy type))))))
          (for [i 0 (Array.length args)]
            (extract-instances! (Box.peek (Array.unsafe-nth args i))
                                constructors
                                declared
                                base-managed
                                keys
                                acc)))
      (MonoType.Reference inner _)
        (extract-instances! (Box.peek inner)
                            constructors
                            declared
                            base-managed
                            keys
                            acc)
      (MonoType.Function args ret)
        (do
          (for [i 0 (Array.length args)]
            (extract-instances! (Box.peek (Array.unsafe-nth args i))
                                constructors
                                declared
                                base-managed
                                keys
                                acc))
          (extract-instances! (Box.peek ret)
                              constructors
                              declared
                              base-managed
                              keys
                              acc))
      _ ()))

  (doc discover "returns the concrete instances of managed generic types that
the program uses, read from the inferred node types. It runs before the derived
functions those instances need exist.")
  (defn discover [inferred constructors base-managed]
    (let-do [instances (the (Array MonoType) [])
             keys (the (Set String) (Set.create))
             declared (declared-type-names constructors)
             node-types (InferredModule.node-types inferred)
             solver (Type.solver-from-substitution (InferredModule.substitution inferred))]
      (for [i 0 (Array.length node-types)]
        (extract-instances!
          &(Type.solver-apply &solver
                              (Box.peek
                                (InferredNodeType.type (Array.unsafe-nth node-types
                                                                         i))))
          constructors
          &declared
          base-managed
          &keys
          &instances))
      instances))

  (private extract-any-instances!)
  (hidden extract-any-instances!)
  (sig extract-any-instances!
       (Fn
         [(Ref MonoType)
          (Ref (Set String))
          (Ref (Set String))
          (Ref (Array MonoType))]
         ()))
  (defn extract-any-instances! [type declared keys acc]
    (match-ref type
      (MonoType.Named name args)
        (do
          (when (and (Int.> (Array.length args) 0) (Set.contains? declared name))
            (let [key (CAbi.type-key type)]
              (unless-do (Set.contains? keys &key)
                (Set.put! keys &key)
                (Array.push-back! acc (MonoType.copy type)))))
          (for [i 0 (Array.length args)]
            (extract-any-instances! (Box.peek (Array.unsafe-nth args i))
                                    declared
                                    keys
                                    acc)))
      (MonoType.Reference inner _)
        (extract-any-instances! (Box.peek inner) declared keys acc)
      (MonoType.Function args ret)
        (do
          (for [i 0 (Array.length args)]
            (extract-any-instances! (Box.peek (Array.unsafe-nth args i))
                                    declared
                                    keys
                                    acc))
          (extract-any-instances! (Box.peek ret) declared keys acc))
      _ ()))

  (doc discover-any "returns every concrete instance of a generic type that the
program uses, managed or not, for `str`.")
  (private discover-any)
  (hidden discover-any)
  (defn discover-any [inferred constructors]
    (let-do [instances (the (Array MonoType) [])
             keys (the (Set String) (Set.create))
             declared (declared-type-names constructors)
             node-types (InferredModule.node-types inferred)
             solver (Type.solver-from-substitution (InferredModule.substitution inferred))]
      (for [i 0 (Array.length node-types)]
        (extract-any-instances!
          &(Type.solver-apply &solver
                              (Box.peek
                                (InferredNodeType.type (Array.unsafe-nth node-types
                                                                         i))))
          &declared
          &keys
          &instances))
      instances))

  (private constructor-base-is?)
  (hidden constructor-base-is?)
  (defn constructor-base-is? [constructor base-name]
    (match-ref (Box.peek (CoreConstructorDeclaration.result constructor))
      (CoreType.Named rname _) (String.= rname base-name)
      _ false))

  (private queue-instances!)
  (hidden queue-instances!)
  (sig queue-instances!
       (Fn
         [(Ref MonoType)
          (Ref (Array CoreConstructorDeclaration))
          (Ref (Array String))
          (Ref (Array MonoType))]
         ()))
  (doc queue-instances! "adds to the worklist each managed generic instance that
`type` holds, nested ones included, such as the element of `(Array (Bucket
String Int))`. Function types are not searched.")
  (defn queue-instances! [type constructors base-managed acc]
    (match-ref type
      (MonoType.Named _ arguments)
        (do
          ;; only what owns memory: a deleter demanded for an instance that
          ;; owns nothing — `(Pair Bool Double)` — has none to dispatch to
          (when (and
              (managed-mono? type constructors base-managed)
              (and (generic-instance? type) (not (instance-listed? acc type))))
            (Array.push-back! acc (MonoType.copy type)))
          (for [i 0 (Array.length arguments)]
            (queue-instances!
              (Box.peek (Array.unsafe-nth arguments i))
              constructors
              base-managed
              acc)))
      (MonoType.Reference inner _)
        (queue-instances! (Box.peek inner) constructors base-managed acc)
      _ ()))

  (private generic-branch)
  (hidden generic-branch)
  (defn generic-branch [constructor
                        inst
                        constructors
                        base-managed
                        delete-ref
                        cell
                        new-insts]
    (let-do [subst (build-subst
               (Box.peek (CoreConstructorDeclaration.result constructor))
               inst)
             fields (CoreConstructorDeclaration.arguments constructor)
             nf (Array.length fields)
             patterns (the (Array (Box CorePattern)) [])
             bindings (the (Array CoreRef) [])
             body-exprs (the (Array (Box CoreExpr)) [])]
      (for [fi 0 nf]
        (let [field-mono (core->mono (Box.peek (Array.unsafe-nth fields fi))
                                     &subst)]
          ;; unmanaged fields have nothing to delete: an `Ignore` slot instead
          ;; of an unused binding keeps the emitted C warning-free.
          (if (managed-mono? &field-mono constructors base-managed)
            (let-do [fref (CoreRef.init (next-id! cell)
                                        (String.concat &[@"field" (Int.str fi)])
                                        false)]
              (set! patterns
                    (Array.push-back patterns
                                     (Box.init (CorePattern.Bind (CoreRef.copy &fref)))))
              (set! bindings (Array.push-back bindings (CoreRef.copy &fref)))
              (set! body-exprs
                    (Array.push-back body-exprs
                                     (Box.init
                                       (CoreExpr.Call -1
                                                      (Box.init
                                                        (CoreExpr.Reference -1
                                                                            (CoreRef.copy delete-ref)))
                                                      [(Box.init
                                                         (CoreExpr.Reference -1
                                                                             (CoreRef.copy &fref)))]))))
              (queue-instances! &field-mono constructors base-managed new-insts))
            (set! patterns
                  (Array.push-back patterns (Box.init (CorePattern.Ignore)))))))
      (CoreMatchBranch.init
        (CorePattern.Constructor
          (CoreRef.copy (CoreConstructorDeclaration.reference constructor))
          patterns)
        bindings
        (Box.init
          (if (Int.= 0 (Array.length &body-exprs))
            (CoreExpr.UnitLit -1)
            (CoreExpr.Do -1 body-exprs))))))

  (private instance-deleter!)
  (hidden instance-deleter!)
  (doc instance-deleter! "adds the deleter of the managed generic instance
`inst`, with its implementation and signature, and returns the generic instances
its managed fields hold.")
  (defn instance-deleter! [inst
                           constructors
                           base-managed
                           delete-ref
                           cell
                           functions
                           impls
                           sigs]
    (match-ref inst
      (MonoType.Named base-name _)
        (let-do [fn-ref (CoreRef.init (next-id! cell)
                                      (String.concat &[(String.copy base-name)
                                                       @".delete"])
                                      true)
                 param-ref (CoreRef.init (next-id! cell) @"x" false)
                 branches (the (Array CoreMatchBranch) [])
                 new-insts (the (Array MonoType) [])
                 cn (Array.length constructors)]
          (for [ci 0 cn]
            (let [c (Array.unsafe-nth constructors ci)]
              (when (constructor-base-is? c base-name)
                (set! branches
                      (Array.push-back branches
                                       (generic-branch c
                                                       inst
                                                       constructors
                                                       base-managed
                                                       delete-ref
                                                       cell
                                                       &new-insts))))))
          (Array.push-back! functions
                            (CoreFunction.init (CoreRef.copy &fn-ref)
                                               [(CoreRef.copy &param-ref)]
                                               (Box.init
                                                 (CoreExpr.Match -1
                                                                 false
                                                                 (Box.init
                                                                   (CoreExpr.Reference -1
                                                                                       (CoreRef.copy &param-ref)))
                                                                 branches))))
          (Array.push-back! impls
                            (CoreImplementation.init (CoreRef.copy delete-ref)
                                                     (CoreRef.copy &fn-ref)))
          (Array.push-back! sigs
                            (CoreSignature.init (CoreRef.copy &fn-ref)
                                                (Box.init
                                                  (CoreType.Function [(Box.init (mono->core inst))]
                                                                     (Box.init (CoreType.Unit))))))
          new-insts)
      _ (the (Array MonoType) [])))

  (private generic-copy-branch)
  (hidden generic-copy-branch)
  (doc generic-copy-branch "returns a match branch of a per-instance `copy`: it
binds every field by reference and builds a new value, copying managed fields
and blitting the rest. Managed generic fields are added to the worklist.")
  (defn generic-copy-branch [constructor
                             inst
                             constructors
                             base-managed
                             copy-ref
                             deref-ref
                             cell
                             new-insts]
    (let-do [subst (build-subst
               (Box.peek (CoreConstructorDeclaration.result constructor))
               inst)
             fields (CoreConstructorDeclaration.arguments constructor)
             nf (Array.length fields)
             patterns (the (Array (Box CorePattern)) [])
             bindings (the (Array CoreRef) [])
             args (the (Array (Box CoreExpr)) [])]
      (for [fi 0 nf]
        (let-do [fref (CoreRef.init (next-id! cell)
                                    (String.concat &[@"field" (Int.str fi)])
                                    false)
                 field-mono (core->mono (Box.peek (Array.unsafe-nth fields fi))
                                        &subst)
                 managed (managed-mono? &field-mono constructors base-managed)]
          (set! patterns
                (Array.push-back patterns
                                 (Box.init (CorePattern.Bind (CoreRef.copy &fref)))))
          (set! bindings (Array.push-back bindings (CoreRef.copy &fref)))
          (set! args
                (Array.push-back args
                                 (Box.init
                                   (CoreExpr.Call -1
                                                  (Box.init
                                                    (CoreExpr.Reference -1
                                                                        (if managed
                                                                          (CoreRef.copy copy-ref)
                                                                          (CoreRef.copy deref-ref))))
                                                  [(Box.init
                                                     (CoreExpr.Reference -1
                                                                         (CoreRef.copy &fref)))]))))
          (when (and managed
                     (and (generic-instance? &field-mono)
                          (not (instance-listed? new-insts &field-mono))))
            (Array.push-back! new-insts (MonoType.copy &field-mono)))))
      (CoreMatchBranch.init
        (CorePattern.Constructor
          (CoreRef.copy (CoreConstructorDeclaration.reference constructor))
          patterns)
        bindings
        (Box.init
          (CoreExpr.Call -1
                         (Box.init
                           (CoreExpr.Reference -1
                                               (CoreRef.copy
                                                 (CoreConstructorDeclaration.reference constructor))))
                         args)))))

  (private builtin-ref-by-name)
  (hidden builtin-ref-by-name)
  (defn builtin-ref-by-name [builtins name]
    (let-do [result (the (Maybe CoreRef) (Maybe.Nothing))
             n (Array.length builtins)]
      (for [i 0 n]
        (let [reference (CoreBuiltin.reference (Array.unsafe-nth builtins i))]
          (when (String.= (CoreRef.name reference) name)
            (set! result (Maybe.Just (CoreRef.copy reference))))))
      result))

  (private builtins-except)
  (hidden builtins-except)
  (defn builtins-except [builtins names]
    (let-do [result (the (Array CoreBuiltin) [])
             n (Array.length builtins)]
      (for [i 0 n]
        (let [builtin (Array.unsafe-nth builtins i)]
          (unless (contains-key? names
                                 (CoreRef.name (CoreBuiltin.reference builtin)))
            (Array.push-back! &result (CoreBuiltin.copy builtin)))))
      result))

  (private function-named?)
  (hidden function-named?)
  (defn function-named? [functions name]
    (let-do [found false
             n (Array.length functions)]
      (for [i 0 n]
        (when (String.=
            (CoreRef.name
              (CoreFunction.reference (Array.unsafe-nth functions i)))
            name)
          (set! found true)))
      found))

  (private implementation-exists?)
  (hidden implementation-exists?)
  (defn implementation-exists? [implementations interface implementation]
    (let-do [found false
             n (Array.length implementations)]
      (for [i 0 n]
        (let [candidate (Array.unsafe-nth implementations i)]
          (when (and
              (CoreIR.same-ref? (CoreImplementation.interface candidate)
                                interface)
              (CoreIR.same-ref?
                (CoreImplementation.implementation candidate)
                implementation))
            (set! found true))))
      found))

  (private instance-copier!)
  (hidden instance-copier!)
  (doc instance-copier! "adds the `copy` of the managed generic instance `inst`,
with its implementation and a signature for the instance, and returns the
generic instances its managed fields hold.")
  (defn instance-copier! [inst
                          constructors
                          base-managed
                          copy-ref
                          deref-ref
                          cell
                          functions
                          impls
                          sigs
                          builtins
                          removed]
    (match-ref inst
      (MonoType.Named base-name _)
        (let-do [fn-name (String.concat &[(String.copy base-name) @".copy"])
                 builtin (if (contains-key? removed &fn-name)
                   (the (Maybe CoreRef) (Maybe.Nothing))
                   (builtin-ref-by-name builtins &fn-name))
                 fn-ref (match-ref &builtin
                   (Maybe.Just reference) (CoreRef.copy reference)
                   (Maybe.Nothing)
                     (CoreRef.init (next-id! cell) (String.copy &fn-name) true))
                 param-ref (CoreRef.init (next-id! cell) @"ref" false)
                 branches (the (Array CoreMatchBranch) [])
                 new-insts (the (Array MonoType) [])
                 cn (Array.length constructors)]
          (for [ci 0 cn]
            (let [c (Array.unsafe-nth constructors ci)]
              (when (constructor-base-is? c base-name)
                (set! branches
                      (Array.push-back branches
                                       (generic-copy-branch c
                                                            inst
                                                            constructors
                                                            base-managed
                                                            copy-ref
                                                            deref-ref
                                                            cell
                                                            &new-insts))))))
          (Array.push-back! functions
                            (CoreFunction.init (CoreRef.copy &fn-ref)
                                               [(CoreRef.copy &param-ref)]
                                               (Box.init
                                                 (CoreExpr.Match -1
                                                                 true
                                                                 (Box.init
                                                                   (CoreExpr.Annotation -1
                                                                                        (Box.init
                                                                                          (CoreExpr.Reference -1
                                                                                                              (CoreRef.copy &param-ref)))
                                                                                        (Box.init
                                                                                          (CoreType.Reference (Box.init (mono->core inst))
                                                                                                              (CoreLifetime.Inferred 0)))))
                                                                 branches))))
          (match-ref &builtin
            (Maybe.Just _) (Array.push-back! removed (String.copy &fn-name))
            (Maybe.Nothing) ())
          (unless (implementation-exists? impls copy-ref &fn-ref)
            (Array.push-back! impls
                              (CoreImplementation.init (CoreRef.copy copy-ref)
                                                       (CoreRef.copy &fn-ref))))
          ;; Unlike the generic source-level fallback, this function is a
          ;; single concrete instance. Pinning its scheme keeps inference and
          ;; specialization on the same reference; without it a call can be
          ;; assigned the concrete `Maybe.copy` symbol while the generated body
          ;; remains polymorphic and is never emitted.
          (Array.push-back! sigs
                            (CoreSignature.init (CoreRef.copy &fn-ref)
                                                (Box.init
                                                  (CoreType.Function
                                                    [(Box.init
                                                       (CoreType.Reference (Box.init (mono->core inst))
                                                                           (CoreLifetime.Inferred 0)))]
                                                    (Box.init (mono->core inst))))))
          new-insts)
      _ (the (Array MonoType) [])))

  (private value-str-convention?)
  (hidden value-str-convention?)
  ;; whether `str` for this concrete type takes its argument by value
  ;; (primitives and register-backed numerics) rather than by reference.
  (defn value-str-convention? [mono]
    (match-ref mono
      (MonoType.Integer) true
      (MonoType.Boolean) true
      (MonoType.Named name args)
        (and (Int.= 0 (Array.length args))
             (contains-key?
               &[@"Int"
                 @"Long"
                 @"Bool"
                 @"Float"
                 @"Double"
                 @"Byte"
                 @"Char"
                 @"Int8"
                 @"Int16"
                 @"Int32"
                 @"Int64"
                 @"Uint8"
                 @"Uint16"
                 @"Uint32"
                 @"Uint64"]
               name))
      _ false))

  (private constructor-local-name)
  (hidden constructor-local-name)
  (defn constructor-local-name [name]
    (let [segments (String.split-by name &[\.])]
      @(Array.unsafe-nth &segments (Int.dec (Array.length &segments)))))

  (private instance-str-branch)
  (hidden instance-str-branch)
  (doc instance-str-branch "returns a match branch of a per-instance `str`:
`(Ctor field..)`, with each field rendered through `prn`. Generic fields are
added to the worklist.")
  (defn instance-str-branch [constructor
                             inst
                             cell
                             -str-ref
                             deref-ref
                             copy-ref
                             ref-ref
                             concat-ref
                             new-insts]
    (let-do [subst (build-subst
               (Box.peek (CoreConstructorDeclaration.result constructor))
               inst)
             fields (CoreConstructorDeclaration.arguments constructor)
             nf (Array.length fields)
             patterns (the (Array (Box CorePattern)) [])
             bindings (the (Array CoreRef) [])
             parts (the (Array (Box CoreExpr)) [])
             ;; a record's constructor is `Type.init`, displayed as the type
             ;; name; a sum's constructor keeps its own (local) name.
             ctor-name (CoreRef.name
               (CoreConstructorDeclaration.reference constructor))
             local-name (if (String.ends-with? ctor-name ".init")
               (match-ref (Box.peek
                   (CoreConstructorDeclaration.result constructor))
                 (CoreType.Named name _) (String.copy name)
                 _ (constructor-local-name ctor-name))
               (constructor-local-name ctor-name))]
      (Array.push-back! &parts
                        (Box.init
                          (CoreExpr.Call -1
                                         (Box.init
                                           (CoreExpr.Reference -1
                                                               (CoreRef.copy copy-ref)))
                                         [(Box.init
                                            (CoreExpr.StringLit -1
                                                                (String.concat &[@"("
                                                                                 (String.copy &local-name)])))])))
      (for [fi 0 nf]
        (let-do [fref (CoreRef.init (next-id! cell)
                                    (String.concat &[@"field" (Int.str fi)])
                                    false)
                 field-mono (core->mono (Box.peek (Array.unsafe-nth fields fi))
                                        &subst)]
          (Array.push-back! &patterns
                            (Box.init (CorePattern.Bind (CoreRef.copy &fref))))
          (Array.push-back! &bindings (CoreRef.copy &fref))
          (Array.push-back! &parts
                            (Box.init
                              (CoreExpr.Call -1
                                             (Box.init
                                               (CoreExpr.Reference -1
                                                                   (CoreRef.copy copy-ref)))
                                             [(Box.init (CoreExpr.StringLit -1
                                                                            @" "))])))
          (Array.push-back! &parts
                            (Box.init
                              (CoreExpr.Call -1
                                             (Box.init
                                               (CoreExpr.Reference -1
                                                                   ;; the reference renders members through `prn`
                                                                   ;; (StructUtils.memberPrn), so String fields
                                                                   ;; show as @"..." literals.
                                                                   (PrimitiveRegistry.reference 2
                                                                                                "prn")))
                                             [(Box.init
                                                (if (value-str-convention? &field-mono)
                                                  (CoreExpr.Call -1
                                                                 (Box.init
                                                                   (CoreExpr.Reference -1
                                                                                       (CoreRef.copy deref-ref)))
                                                                 [(Box.init
                                                                    (CoreExpr.Reference -1
                                                                                        (CoreRef.copy &fref)))])
                                                  (CoreExpr.Reference -1
                                                                      (CoreRef.copy &fref))))])))
          (when (and (generic-instance? &field-mono)
                     (not (instance-listed? new-insts &field-mono)))
            (Array.push-back! new-insts (MonoType.copy &field-mono)))))
      (Array.push-back! &parts
                        (Box.init
                          (CoreExpr.Call -1
                                         (Box.init
                                           (CoreExpr.Reference -1
                                                               (CoreRef.copy copy-ref)))
                                         [(Box.init (CoreExpr.StringLit -1 @")"))])))
      (CoreMatchBranch.init
        (CorePattern.Constructor
          (CoreRef.copy (CoreConstructorDeclaration.reference constructor))
          patterns)
        bindings
        (Box.init
          (CoreExpr.Call -1
                         (Box.init
                           (CoreExpr.Reference -1 (CoreRef.copy concat-ref)))
                         [(Box.init
                            (CoreExpr.Call -1
                                           (Box.init
                                             (CoreExpr.Reference -1
                                                                 (CoreRef.copy ref-ref)))
                                           [(Box.init (CoreExpr.ArrayLit -1
                                                                         parts))]))])))))

  (private instance-strfn!)
  (hidden instance-strfn!)
  (doc instance-strfn! "adds the `str` of the generic instance `instance`, and
registers it as the `str` and `prn` implementations the user did not write. It
returns the generic instances nested in its fields.")
  (defn instance-strfn! [context
                         inst
                         constructors
                         cell
                         functions
                         impls
                         concat-ref
                         derive-str?
                         derive-prn?]
    (let-do [str-ref (PrimitiveRegistry.reference 1 "str")
             deref-ref (PrimitiveRegistry.reference 6 "deref")
             copy-ref (PrimitiveRegistry.reference 0 "copy")
             ref-ref (PrimitiveRegistry.reference 5 "ref")
             new-insts (the (Array MonoType) [])]
      (match-ref inst
        (MonoType.Named base-name _)
          (let-do [fn-ref (CoreRef.init (next-id! cell)
                                        (String.concat
                                          &[(String.copy base-name)
                                            (if derive-str? @".str" @".prn")])
                                        true)
                   ;; a per-instance str is derived, not user-written: record
                   ;; it so later instances of the same base are still derived.
                   _ignored-provenance (Array.push-back! (DeriveContext.fallback-str-ids context)
                                                         @(CoreRef.id &fn-ref))
                   param-ref (CoreRef.init (next-id! cell) @"self" false)
                   branches (the (Array CoreMatchBranch) [])
                   cn (Array.length constructors)]
            (for [ci 0 cn]
              (let [c (Array.unsafe-nth constructors ci)]
                (when (constructor-base-is? c base-name)
                  (set! branches
                        (Array.push-back branches
                                         (instance-str-branch c
                                                              inst
                                                              cell
                                                              &str-ref
                                                              &deref-ref
                                                              &copy-ref
                                                              &ref-ref
                                                              concat-ref
                                                              &new-insts))))))
            (Array.push-back! functions
                              (CoreFunction.init (CoreRef.copy &fn-ref)
                                                 [(CoreRef.copy &param-ref)]
                                                 (Box.init
                                                   (CoreExpr.Match -1
                                                                   true
                                                                   (Box.init
                                                                     (CoreExpr.Annotation -1
                                                                                          (Box.init
                                                                                            (CoreExpr.Reference -1
                                                                                                                (CoreRef.copy &param-ref)))
                                                                                          (Box.init
                                                                                            (CoreType.Reference (Box.init (mono->core inst))
                                                                                                                (CoreLifetime.Inferred 0)))))
                                                                   branches))))
            (when derive-str?
              (Array.push-back! impls
                                (CoreImplementation.init (CoreRef.copy &str-ref)
                                                         (CoreRef.copy &fn-ref))))
            ;; the reference derives both a `str` and a `prn` binder per deftype
            ;; (Deftype.binderForStrOrPrn), with identical bodies for non-strings,
            ;; and a user-written one replaces only its own.
            (when derive-prn?
              (Array.push-back! impls
                                (CoreImplementation.init (PrimitiveRegistry.reference 2
                                                                                      "prn")
                                                         (CoreRef.copy &fn-ref)))))
        _ ())
      new-insts))

  (private fallback-str-id?)
  (hidden fallback-str-id?)
  (defn fallback-str-id? [context id]
    (let-do [found false]
      (for [i 0 (Array.length (DeriveContext.fallback-str-ids context))]
        (when (Int.=
            @(Array.unsafe-nth (DeriveContext.fallback-str-ids context) i)
            id)
          (set! found true)))
      found))

  (private user-member-defined?)
  (hidden user-member-defined?)
  ;; a `<T>.str` or `<T>.prn` that is NOT one of the recorded derived ones is
  ;; user-written (or accessor-adopted): instance derivation must not
  ;; override it.
  (defn user-member-defined? [context functions base-name member]
    (let-do [found false
             target (String.concat &[(String.copy base-name) @"." @member])]
      (for [i 0 (Array.length functions)]
        (let [reference (CoreFunction.reference (Array.unsafe-nth functions i))]
          (when (and
              (String.= (CoreRef.name reference) &target)
              (not (fallback-str-id? context @(CoreRef.id reference))))
            (set! found true))))
      found))

  (private derive-instance-strs)
  (hidden derive-instance-strs)
  (doc derive-instance-strs "returns `core` with a `str` for every concrete
generic instance the program uses, as the reference derives `str` per instance.
Types with a `str` of their own keep it. Without `String.concat`, it returns
`core` unchanged.")
  (defn derive-instance-strs [context core inferred]
    (let-do [functions (Array.copy (CoreModule.functions core))
             impls (Array.copy (CoreModule.implementations core))
             constructors (CoreModule.constructors core)
             concat-found (the (Maybe CoreRef) (Maybe.Nothing))]
      (for [i 0 (Array.length &functions)]
        (let [reference (CoreFunction.reference (Array.unsafe-nth &functions i))]
          (when (String.= (CoreRef.name reference) "String.concat")
            (set! concat-found (Maybe.Just (CoreRef.copy reference))))))
      (match concat-found
        (Maybe.Nothing) @core
        (Maybe.Just concat-ref)
          (let-do [pending (discover-any inferred constructors)
                   done (the (Array String) [])
                   cell (the (Array Int)
                             [(Int.inc (CoreIR.max-declared-global-id core))])
                   cursor 0]
            (while-do (Int.< cursor (Array.length &pending))
              (let-do [inst (Array.unsafe-nth &pending cursor)
                       key (CAbi.type-key inst)
                       skip (or (contains-key? &done &key)
                                (or
                                  (not
                                    (match-ref inst
                                      (MonoType.Named base-name _)
                                        (constructors-declared? constructors
                                                                base-name)
                                      _ false))
                                  (match-ref inst
                                    (MonoType.Named base-name _)
                                      (and
                                        (user-member-defined? context
                                                              &functions
                                                              base-name
                                                              "str")
                                        (user-member-defined? context
                                                              &functions
                                                              base-name
                                                              "prn"))
                                    _ true)))]
                (unless-do skip
                  (set! done (Array.push-back done key))
                  (let [base (match-ref inst
                          (MonoType.Named base-name _) @base-name
                          _ @"")
                        new-insts (instance-strfn! context
                                                   inst
                                                   constructors
                                                   &cell
                                                   &functions
                                                   &impls
                                                   &concat-ref
                                                   (not
                                                     (user-member-defined? context
                                                                           &functions
                                                                           &base
                                                                           "str"))
                                                   (not
                                                     (user-member-defined? context
                                                                           &functions
                                                                           &base
                                                                           "prn")))]
                    (for [i 0 (Array.length &new-insts)]
                      (set! pending
                            (Array.push-back pending
                                             @(Array.unsafe-nth &new-insts i))))))
                (set! cursor (Int.inc cursor))))
            (finish-indexing context
                             (CoreModule.init functions
                                              @(CoreModule.values core)
                                              @(CoreModule.builtins core)
                                              @(CoreModule.builtin-sources core)
                                              @(CoreModule.signatures core)
                                              @(CoreModule.type-declarations core)
                                              @(CoreModule.constructors core)
                                              @(CoreModule.recursive-types core)
                                              @(CoreModule.interfaces core)
                                              impls
                                              @(CoreModule.overloads core)
                                              @(CoreModule.system-includes core)
                                              @(CoreModule.expressions core)))))))

  (private worklist-generate)
  (hidden worklist-generate)
  (private polymorphic-core-type?)
  (hidden polymorphic-core-type?)
  (private generic-delete-declared?)
  (hidden generic-delete-declared?)
  (doc generic-delete-declared? "checks whether `sigs` declare a
`<base-name>.delete` for every instance of the type, such as Core's for `Box`.
That deleter specializes for every instance, so no per-instance one is derived.")
  (defn generic-delete-declared? [sigs constructors base-name]
    (let-do [found false
             name (String.concat &[(String.copy base-name) @".delete"])
             indirect (CoreIR.indirection-nominal? constructors base-name)
             n (Array.length sigs)]
      (for [i 0 n]
        (let [candidate (Array.unsafe-nth sigs i)]
          (when (and indirect
                     (and
                       (String.=
                         (CoreRef.name (CoreSignature.reference candidate))
                         &name)
                       (polymorphic-core-type?
                         (Box.peek (CoreSignature.signature candidate)))))
            (set! found true))))
      found))

  (defn worklist-generate [context core worklist base-managed]
    (let-do [functions (Array.copy (CoreModule.functions core))
             impls (Array.copy (CoreModule.implementations core))
             sigs (Array.copy (CoreModule.signatures core))
             constructors (CoreModule.constructors core)
             builtins (CoreModule.builtins core)
             delete-ref (PrimitiveRegistry.delete-reference)
             copy-ref (PrimitiveRegistry.reference 0 "copy")
             deref-ref (PrimitiveRegistry.reference 6 "deref")
             cell (the (Array Int)
                       [(Int.inc (CoreIR.max-declared-global-id core))])
             pending (Array.copy worklist)
             done (the (Array String) [])
             removed (the (Array String) [])
             cursor 0]
      (while-do (Int.< cursor (Array.length &pending))
        (let-do [inst (Array.unsafe-nth &pending cursor)
                 key (CAbi.type-key inst)]
          (unless-do (or (contains-key? &done &key)
                         (not
                           (match-ref inst
                             (MonoType.Named base-name _)
                               (constructors-declared? constructors base-name)
                             _ false)))
            (set! done (Array.push-back done key))
            (let-do [base-name (match-ref inst
                       (MonoType.Named name _) (String.copy name)
                       _ (String.copy ""))
                     new-insts (if (generic-delete-declared? &sigs
                                                             constructors
                                                             &base-name)
                       (the (Array MonoType) [])
                       (instance-deleter! inst
                                          constructors
                                          &base-managed
                                          &delete-ref
                                          &cell
                                          &functions
                                          &impls
                                          &sigs))
                     copy-name (match-ref inst
                       (MonoType.Named base-name _)
                         (String.concat &[(String.copy base-name) @".copy"])
                       _ (String.copy ""))]
              ; a generic derived/accessor copier specializes correctly for
              ; every instance and must remain the sole implementation. only
              ; synthesize a concrete copier when the module has no such body.
              ; look in the module as it came in: `functions` also holds the
              ; copiers this loop pinned to earlier instances.
              (unless (function-named? (CoreModule.functions core) &copy-name)
                (ignore
                  (instance-copier! inst
                                    constructors
                                    &base-managed
                                    &copy-ref
                                    &deref-ref
                                    &cell
                                    &functions
                                    &impls
                                    &sigs
                                    builtins
                                    &removed)))
              (for [i 0 (Array.length &new-insts)]
                (set! pending
                      (Array.push-back pending @(Array.unsafe-nth &new-insts i))))))
          (set! cursor (Int.inc cursor))))
      (finish-indexing context
                       (CoreModule.init functions
                                        @(CoreModule.values core)
                                        (builtins-except builtins &removed)
                                        @(CoreModule.builtin-sources core)
                                        sigs
                                        @(CoreModule.type-declarations core)
                                        @(CoreModule.constructors core)
                                        @(CoreModule.recursive-types core)
                                        @(CoreModule.interfaces core)
                                        impls
                                        @(CoreModule.overloads core)
                                        @(CoreModule.system-includes core)
                                        @(CoreModule.expressions core)))))

  (doc close-generics-owned-with "derives as `close-generics` does and passes
the result and the inference base to `finish`. If inference fails, `finish` gets
`core` unchanged and `Nothing`.")
  (defn close-generics-owned-with [context core finish]
    (match (Infer.module-resumable &core)
      (Result.Success base)
        (let-do [inf (InferenceBase.inferred &base)
                 facts (OwnershipClassify.facts-from-module &core)
                 base-managed (managed-keys &core
                                            (OwnershipTypeFacts.owned &facts))]
          (set! core
                (derive-instance-strs context
                                      &(worklist-generate context
                                                          &core
                                                          &(discover inf
                                                                     (CoreModule.constructors &core)
                                                                     &base-managed)
                                                          base-managed)
                                      inf))
          (~finish core (Maybe.Just base)))
      (Result.Error _)
        (~finish core (the (Maybe InferenceBase) (Maybe.Nothing)))))

  (doc close-generics "returns `core` with a `copy`, `delete`, `str` and `prn`
for every concrete managed generic instance the program uses, and the inference
base, as a pair. It infers `core` to find the instances. The derived functions
take over builtin declarations under their ids, so `Infer.module-from-base` can
infer the result from the base. If inference fails, it returns `core` unchanged
and `Nothing`.")
  (defn close-generics [context core]
    (close-generics-owned-with context @core &Pair.init)))

(defmodule Derive
  (private copy-branch)
  (hidden copy-branch)
  (defn polymorphic-core-type? [type]
    (match-ref type
      (CoreType.Variable _) true
      (CoreType.Named _ arguments)
        (let-do [found false]
          (for [i 0 (Array.length arguments)]
            (when (polymorphic-core-type?
                (Box.peek (Array.unsafe-nth arguments i)))
              (set! found true)))
          found)
      (CoreType.Reference inner _) (polymorphic-core-type? (Box.peek inner))
      (CoreType.Function arguments result)
        (let-do [found (polymorphic-core-type? (Box.peek result))]
          (for [i 0 (Array.length arguments)]
            (when (polymorphic-core-type?
                (Box.peek (Array.unsafe-nth arguments i)))
              (set! found true)))
          found)
      _ false))
  (doc copy-branch "returns a match branch of a derived `copy`: it binds every
field by reference and builds a new value, copying managed and polymorphic
fields and blitting the rest.")
  (defn copy-branch [constructor managed copy-ref deref-ref cell]
    (let-do [fields (CoreConstructorDeclaration.arguments constructor)
             nf (Array.length fields)
             patterns (the (Array (Box CorePattern)) [])
             bindings (the (Array CoreRef) [])
             args (the (Array (Box CoreExpr)) [])]
      (for [fi 0 nf]
        (let-do [fref (CoreRef.init (next-id! cell)
                                    (String.concat &[@"field" (Int.str fi)])
                                    false)]
          (set! patterns
                (Array.push-back patterns
                                 (Box.init (CorePattern.Bind (CoreRef.copy &fref)))))
          (set! bindings (Array.push-back bindings (CoreRef.copy &fref)))
          (set! args
                (Array.push-back args
                                 (Box.init
                                   (CoreExpr.Call -1
                                                  (Box.init
                                                    (CoreExpr.Reference -1
                                                                        (if (or
                                                                            (field-managed? (Box.peek (Array.unsafe-nth fields
                                                                                                                        fi))
                                                                                            managed)
                                                                            (polymorphic-core-type? (Box.peek (Array.unsafe-nth fields
                                                                                                                                fi))))
                                                                          (CoreRef.copy copy-ref)
                                                                          (CoreRef.copy deref-ref))))
                                                  [(Box.init
                                                     (CoreExpr.Reference -1
                                                                         (CoreRef.copy &fref)))]))))))
      (CoreMatchBranch.init
        (CorePattern.Constructor
          (CoreRef.copy (CoreConstructorDeclaration.reference constructor))
          patterns)
        bindings
        (Box.init
          (CoreExpr.Call -1
                         (Box.init
                           (CoreExpr.Reference -1
                                               (CoreRef.copy
                                                 (CoreConstructorDeclaration.reference constructor))))
                         args)))))

  (private named-type-name)
  (hidden named-type-name)
  (defn named-type-name [ct]
    (match-ref ct (CoreType.Named name _) (String.copy name) _ (String.copy "")))

  (private builtin-by-name)
  (hidden builtin-by-name)
  (defn builtin-by-name [builtins name]
    (let-do [result (the (Maybe CoreBuiltin) (Maybe.Nothing))]
      (for [i 0 (Array.length builtins)]
        (let [builtin (Array.unsafe-nth builtins i)]
          (when (String.= (CoreRef.name (CoreBuiltin.reference builtin)) name)
            (set! result (Maybe.Just @builtin)))))
      result))

  ; builds a record accessor by kind: 0 getter `(match-ref self (Ctor f..) fN)`,
  ; 1 setter `(match self (Ctor f..) (Ctor f0 .. value .. fk))`, 2 updater with
  ; `(f fN)` at the target, 3 copy `(match-ref self (Ctor f..) (Ctor (copy f0)
  ; ..))`. the getter and copy read by reference. the setter and updater consume
  ; the value and build a new one.
  (private make-field-fn)
  (hidden make-field-fn)
  (defn make-field-fn [fref decl-ref result-type nf fi kind cell]
    (let-do [self-ref (CoreRef.init (next-id! cell) @"self" false)
             extra-ref (CoreRef.init (next-id! cell) @"arg" false)
             deref-ref (PrimitiveRegistry.reference 6 "deref")
             copy-ref (PrimitiveRegistry.reference 0 "copy")
             by-ref (or (Int.= kind 0) (Int.= kind 3))
             patterns (the (Array (Box CorePattern)) [])
             bindings (the (Array CoreRef) [])
             args (the (Array (Box CoreExpr)) [])
             target (CoreRef.init 0 @"" false)]
      (for [k 0 nf]
        (let-do [bref (CoreRef.init (next-id! cell)
                                    (String.concat &[@"f" (Int.str k)])
                                    false)]
          ;; the getter (kind 0) reads one field: binding the others only
          ;; emits unused locals, so they stay `Ignore` slots.
          (if (and (Int.= kind 0) (not (Int.= k fi)))
            (Array.push-back! &patterns (Box.init (CorePattern.Ignore)))
            (do
              (Array.push-back! &patterns
                                (Box.init (CorePattern.Bind (CoreRef.copy &bref))))
              (Array.push-back! &bindings (CoreRef.copy &bref))))
          (when (Int.= k fi) (set! target (CoreRef.copy &bref)))
          (Array.push-back! &args
                            (Box.init
                              (cond
                                (and (Int.= kind 1) (Int.= k fi))
                                (CoreExpr.Reference -1 (CoreRef.copy &extra-ref))
                                (and (Int.= kind 2) (Int.= k fi))
                                (CoreExpr.Call -1
                                               (Box.init
                                                 (CoreExpr.Call -1
                                                                (Box.init
                                                                  (CoreExpr.Reference -1
                                                                                      (CoreRef.copy &deref-ref)))
                                                                [(Box.init
                                                                   (CoreExpr.Reference -1
                                                                                       (CoreRef.copy &extra-ref)))]))
                                               [(Box.init
                                                  (CoreExpr.Reference -1
                                                                      (CoreRef.copy &bref)))])
                                ; the copy body copies every field through
                                ; the `copy` interface, so each instance picks
                                ; a deep copy for managed fields and a blit for
                                ; the rest. a `deref` would alias managed fields.
                                (Int.= kind 3)
                                (CoreExpr.Call -1
                                               (Box.init
                                                 (CoreExpr.Reference -1
                                                                     (CoreRef.copy &copy-ref)))
                                               [(Box.init
                                                  (CoreExpr.Reference -1
                                                                      (CoreRef.copy &bref)))])
                                (CoreExpr.Reference -1 (CoreRef.copy &bref)))))))
      (let [params (if (or (Int.= kind 1) (Int.= kind 2))
              [(CoreRef.copy &self-ref) (CoreRef.copy &extra-ref)]
              [(CoreRef.copy &self-ref)])
            ann-type (if by-ref
              (CoreType.Reference (Box.init (CoreType.copy result-type))
                                  (CoreLifetime.Inferred 0))
              (CoreType.copy result-type))
            body (if (Int.= kind 0)
              (CoreExpr.Reference -1 target)
              (CoreExpr.Call -1
                             (Box.init
                               (CoreExpr.Reference -1 (CoreRef.copy decl-ref)))
                             args))]
        (CoreFunction.init (CoreRef.copy fref)
                           params
                           (Box.init
                             (CoreExpr.Match -1
                                             by-ref
                                             (Box.init
                                               (CoreExpr.Annotation -1
                                                                    (Box.init
                                                                      (CoreExpr.Reference -1
                                                                                          (CoreRef.copy &self-ref)))
                                                                    (Box.init ann-type)))
                                             [(CoreMatchBranch.init
                                                (CorePattern.Constructor (CoreRef.copy decl-ref)
                                                                         patterns)
                                                bindings
                                                (Box.init body))]))))))

  ;; the in-place mutating setter `set-<field>!`: `(field-set! self 0 fi value)`
  ;; writes member `fi` of the record (single constructor, tag 0) behind the
  ;; `(Ref record)` in place. Distinct from make-field-fn because its body is the
  ;; field-set! intrinsic, not a reconstructing match.
  (private make-mutator-fn)
  (hidden make-mutator-fn)
  (defn make-mutator-fn [fref result-type fi cell]
    (let-do [self-ref (CoreRef.init (next-id! cell) @"self" false)
             value-ref (CoreRef.init (next-id! cell) @"value" false)
             field-set-ref (PrimitiveRegistry.reference 49 "field-set!")
             self-ann (CoreType.Reference (Box.init (CoreType.copy result-type))
                                          (CoreLifetime.Inferred 0))]
      (CoreFunction.init (CoreRef.copy fref)
                         [(CoreRef.copy &self-ref) (CoreRef.copy &value-ref)]
                         (Box.init
                           (CoreExpr.Call -1
                                          (Box.init
                                            (CoreExpr.Reference -1
                                                                (CoreRef.copy &field-set-ref)))
                                          [(Box.init
                                             (CoreExpr.Annotation -1
                                                                  (Box.init
                                                                    (CoreExpr.Reference -1
                                                                                        (CoreRef.copy &self-ref)))
                                                                  (Box.init self-ann)))
                                           (Box.init (CoreExpr.IntLit -1 0))
                                           (Box.init (CoreExpr.IntLit -1 fi))
                                           (Box.init
                                             (CoreExpr.Reference -1
                                                                 (CoreRef.copy &value-ref)))])))))

  (private gen-into)
  (hidden gen-into)
  (defn gen-into [builtins name decl-ref result-type nf fi kind cell fns removed]
    (match (builtin-ref-by-name builtins name)
      (Maybe.Just fref)
        (do
          (Array.push-back! fns
                            (make-field-fn &fref
                                           decl-ref
                                           result-type
                                           nf
                                           fi
                                           kind
                                           cell))
          (Array.push-back! removed @name))
      (Maybe.Nothing) ()))

  (doc accessors "returns `core` with bodies for the record accessors that
resolution declared: getters, setters, updaters, mutating setters and
`<T>.copy`. Each replaces the declared builtin under the same reference.")
  (defn accessors [context core]
    (let-do [constructors (CoreModule.constructors core)
             builtins (CoreModule.builtins core)
             new-functions (Array.copy (CoreModule.functions core))
             new-impls (Array.copy (CoreModule.implementations core))
             new-signatures (Array.copy (CoreModule.signatures core))
             removed (the (Array String) [])
             cell (the (Array Int)
                       [(Int.inc (CoreIR.max-declared-global-id core))])
             cn (Array.length constructors)]
      (for [ci 0 cn]
        (let [c (Array.unsafe-nth constructors ci)
              fnames (CoreConstructorDeclaration.field-names c)]
          (when (Int.> (Array.length fnames) 0)
            (let-do [decl-ref (CoreConstructorDeclaration.reference c)
                     result-type (Box.peek (CoreConstructorDeclaration.result c))
                     type-name (named-type-name result-type)
                     nf (Array.length fnames)]
              (for [fi 0 nf]
                (let-do [field (Array.unsafe-nth fnames fi)
                         base (String.concat &[(String.copy &type-name) @"."])]
                  (gen-into builtins
                            &(String.concat &[(String.copy &base) @field])
                            decl-ref
                            result-type
                            nf
                            fi
                            0
                            &cell
                            &new-functions
                            &removed)
                  (gen-into builtins
                            &(String.concat &[(String.copy &base) @"set-" @field])
                            decl-ref
                            result-type
                            nf
                            fi
                            1
                            &cell
                            &new-functions
                            &removed)
                  (gen-into builtins
                            &(String.concat &[(String.copy &base)
                                              @"update-"
                                              @field])
                            decl-ref
                            result-type
                            nf
                            fi
                            2
                            &cell
                            &new-functions
                            &removed)
                  (let [mut-name (String.concat
                          &[(String.copy &base) @"set-" @field @"!"])]
                    (match (builtin-by-name builtins &mut-name)
                      (Maybe.Just builtin)
                        (do
                          (Array.push-back! &new-functions
                                            (make-mutator-fn (CoreBuiltin.reference &builtin)
                                                             result-type
                                                             fi
                                                             &cell))
                          ;; the body writes through `field-set!`, which
                          ;; takes any value, so only the declared signature
                          ;; ties the value to the field: keep it, as the
                          ;; reference's setter is typed by its field
                          (Array.push-back! &new-signatures
                                            (CoreSignature.init @(CoreBuiltin.reference &builtin)
                                                                @(CoreBuiltin.signature &builtin)))
                          (Array.push-back! &removed @&mut-name))
                      (Maybe.Nothing) ()))))
              ;; copy is dispatched through the `copy` interface, so besides the
              ;; body it needs an implementation registration.
              (let [copy-name (String.concat &[(String.copy &type-name) @".copy"])]
                (match (builtin-ref-by-name builtins &copy-name)
                  (Maybe.Just cref)
                    (do
                      (Array.push-back! &new-functions
                                        (make-field-fn &cref
                                                       decl-ref
                                                       result-type
                                                       nf
                                                       0
                                                       3
                                                       &cell))
                      (Array.push-back! &new-impls
                                        (CoreImplementation.init (PrimitiveRegistry.reference 0
                                                                                              "copy")
                                                                 (CoreRef.copy &cref)))
                      (Array.push-back! &removed @&copy-name))
                  (Maybe.Nothing) ()))))))
      (finish-indexing context
                       (CoreModule.init new-functions
                                        @(CoreModule.values core)
                                        (builtins-except builtins &removed)
                                        @(CoreModule.builtin-sources core)
                                        new-signatures
                                        @(CoreModule.type-declarations core)
                                        @(CoreModule.constructors core)
                                        @(CoreModule.recursive-types core)
                                        @(CoreModule.interfaces core)
                                        new-impls
                                        @(CoreModule.overloads core)
                                        @(CoreModule.system-includes core)
                                        @(CoreModule.expressions core)))))

  ;; `Pair.init-from-refs` is registered as a body-less builtin (id 31) but is a
  ;; real Core function `(init (copy a) (copy b))`. Give it that body so it emits
  ;; and links; specialization monomorphizes it per concrete `Pair`.
  (private make-init-from-refs)
  (hidden make-init-from-refs)
  (defn make-init-from-refs [fref cell]
    (let-do [a-ref (CoreRef.init (next-id! cell) @"a" false)
             b-ref (CoreRef.init (next-id! cell) @"b" false)
             init-ref (PrimitiveRegistry.reference 38 "Pair.init")
             copy-ref (PrimitiveRegistry.reference 0 "copy")]
      (CoreFunction.init (CoreRef.copy fref)
                         [(CoreRef.copy &a-ref) (CoreRef.copy &b-ref)]
                         (Box.init
                           (CoreExpr.Call -1
                                          (Box.init
                                            (CoreExpr.Reference -1
                                                                (CoreRef.copy &init-ref)))
                                          [(Box.init
                                             (CoreExpr.Call -1
                                                            (Box.init
                                                              (CoreExpr.Reference -1
                                                                                  (CoreRef.copy &copy-ref)))
                                                            [(Box.init
                                                               (CoreExpr.Reference -1
                                                                                   (CoreRef.copy &a-ref)))]))
                                           (Box.init
                                             (CoreExpr.Call -1
                                                            (Box.init
                                                              (CoreExpr.Reference -1
                                                                                  (CoreRef.copy &copy-ref)))
                                                            [(Box.init
                                                               (CoreExpr.Reference -1
                                                                                   (CoreRef.copy &b-ref)))]))])))))

  (doc pair-refs "returns `core` with a body for the builtin
`Pair.init-from-refs`, if it is declared.")
  (defn pair-refs [context core]
    (let-do [builtins (CoreModule.builtins core)
             new-functions (Array.copy (CoreModule.functions core))
             removed (the (Array String) [])
             cell (the (Array Int)
                       [(Int.inc (CoreIR.max-declared-global-id core))])]
      (match (builtin-ref-by-name builtins "Pair.init-from-refs")
        (Maybe.Just fref)
          (do
            (Array.push-back! &new-functions (make-init-from-refs &fref &cell))
            (Array.push-back! &removed @"Pair.init-from-refs"))
        (Maybe.Nothing) ())
      (finish-indexing context
                       (CoreModule.init new-functions
                                        @(CoreModule.values core)
                                        (builtins-except builtins &removed)
                                        @(CoreModule.builtin-sources core)
                                        @(CoreModule.signatures core)
                                        @(CoreModule.type-declarations core)
                                        @(CoreModule.constructors core)
                                        @(CoreModule.recursive-types core)
                                        @(CoreModule.interfaces core)
                                        @(CoreModule.implementations core)
                                        @(CoreModule.overloads core)
                                        @(CoreModule.system-includes core)
                                        @(CoreModule.expressions core)))))

  ;; whether a deftype declaration is generic (its result type carries type
  ;; arguments). A generic type's fallback `str` must stay field-less so it
  ;; unifies at every instance; per-instance strs render the fields.
  (private generic-constructor?)
  (hidden generic-constructor?)
  (defn generic-constructor? [c]
    (match-ref (Box.peek (CoreConstructorDeclaration.result c))
      (CoreType.Named _ args) (Int.> (Array.length args) 0)
      _ false))

  (private concat-reference)
  (hidden concat-reference)
  (defn concat-reference [core]
    (let-do [found (the (Maybe CoreRef) (Maybe.Nothing))
             functions (CoreModule.functions core)]
      (for [i 0 (Array.length functions)]
        (let [reference (CoreFunction.reference (Array.unsafe-nth functions i))]
          (when (String.= (CoreRef.name reference) "String.concat")
            (set! found (Maybe.Just (CoreRef.copy reference))))))
      found))

  ; one match branch whose body is the constructor's name as a string, without
  ; its fields
  (private str-branch)
  (hidden str-branch)
  (defn str-branch [c -cell]
    (let-do [fields (CoreConstructorDeclaration.arguments c)
             nf (Array.length fields)
             patterns (the (Array (Box CorePattern)) [])
             ctor-ref (CoreConstructorDeclaration.reference c)
             ctor-name @(CoreRef.name ctor-ref)
             ; the name in parentheses. a record's constructor `Type.init`
             ; shows as the type name, a sum's as its qualified name, such as
             ; `(Maybe.Just)`. the reference shows `(Just)`.
             display (if (String.ends-with? &ctor-name ".init")
               (named-type-name (Box.peek (CoreConstructorDeclaration.result c)))
               (String.copy &ctor-name))
             formatted (String.concat &[@"(" display @")"])]
      ;; ignore every field: the body needs no field values, so the match leaves
      ;; the type variables free and `str` stays generic (matches per instance).
      (for [k 0 nf] (Array.push-back! &patterns (Box.init (CorePattern.Ignore))))
      (CoreMatchBranch.init
        (CorePattern.Constructor (CoreRef.copy ctor-ref) patterns)
        []
        (Box.init
          (CoreExpr.Call -1
                         (Box.init
                           (CoreExpr.Reference -1
                                               (PrimitiveRegistry.reference 0
                                                                            "copy")))
                         [(Box.init (CoreExpr.StringLit -1 formatted))])))))

  (doc strs "returns `core` with a `str` and a `prn` for every type that does
not define them. A concrete type renders its fields. A generic type gets a
field-less fallback, `(Ctor)`, which per-instance strs replace.")
  (defn strs [context core]
    (let-do [_ignored-reset (DeriveContext.set-fallback-str-ids! context [])
             constructors (CoreModule.constructors core)
             new-functions (Array.copy (CoreModule.functions core))
             new-impls (Array.copy (CoreModule.implementations core))
             str-ref (PrimitiveRegistry.reference 1 "str")
             deref-ref (PrimitiveRegistry.reference 6 "deref")
             copy-ref (PrimitiveRegistry.reference 0 "copy")
             ref-ref (PrimitiveRegistry.reference 5 "ref")
             concat-found (concat-reference core)
             builtins (CoreModule.builtins core)
             removed (the (Array String) [])
             ;; nested generic field instances surfaced here are discarded:
             ;; close-generics discovers them independently from inference.
             scratch-insts (the (Array MonoType) [])
             seen (the (Array String) [])
             cell (the (Array Int)
                       [(Int.inc (CoreIR.max-declared-global-id core))])
             cn (Array.length constructors)]
      (for [ci 0 cn]
        (let-do [c (Array.unsafe-nth constructors ci)
                 result-type (Box.peek (CoreConstructorDeclaration.result c))
                 type-name (named-type-name result-type)
                 ;; a user-written `<T>.str` or `<T>.prn` replaces only its
                 ;; own member: the other is still derived, as in the reference
                 derive-str? (not
                   (function-named? (CoreModule.functions core)
                                    &(String.concat &[(String.copy &type-name)
                                                      @".str"])))
                 derive-prn? (not
                   (function-named? (CoreModule.functions core)
                                    &(String.concat &[(String.copy &type-name)
                                                      @".prn"])))]
          (unless-do (or (contains-key? &seen &type-name)
                         (not (or derive-str? derive-prn?)))
            (set! seen (Array.push-back seen (String.copy &type-name)))
            (let-do [branches (the (Array CoreMatchBranch) [])
                     fn-name (String.concat
                       &[(String.copy &type-name)
                         (if derive-str? @".str" @".prn")])
                     ;; a qualified call site (`(T.str &x)`) makes resolution
                     ;; register a body-less builtin for the name; bind the
                     ;; derived definition to THAT reference and drop the
                     ;; builtin, exactly as `accessors` does — otherwise the
                     ;; call site points at a declaration with no body and the
                     ;; program fails to link.
                     ;; Only for concrete types: a generic type's fallback
                     ;; keeps a fresh id recorded in the derivation context,
                     ;; which is how per-instance derivation tells a derived
                     ;; str from a user-written one.
                     fn-ref (match (if (generic-constructor? c)
                         (Maybe.Nothing)
                         (builtin-ref-by-name builtins &fn-name))
                       (Maybe.Just existing)
                         (do
                           (Array.push-back! &removed (String.copy &fn-name))
                           existing)
                       (Maybe.Nothing)
                         (CoreRef.init (next-id! &cell)
                                       (String.copy &fn-name)
                                       true))
                     ;; a generic type's fallback is overridable by
                     ;; per-instance derivation: record its identity.
                     _ignored-provenance (when (generic-constructor? c)
                       (Array.push-back! (DeriveContext.fallback-str-ids context)
                                         @(CoreRef.id &fn-ref)))
                     param-ref (CoreRef.init (next-id! &cell) @"self" false)]
              (for [cj 0 cn]
                (let [c2 (Array.unsafe-nth constructors cj)]
                  (when (String.=
                      &(named-type-name
                        (Box.peek (CoreConstructorDeclaration.result c2)))
                      &type-name)
                    ;; a concrete deftype's fields have no type variables, so
                    ;; its `str` can render field values right here (matching
                    ;; the reference, which derives str per concretization).
                    ;; A generic type keeps the field-less fallback so it
                    ;; unifies at every instance; per-instance strs, derived
                    ;; later, render those fields and win dispatch.
                    (set! branches
                          (Array.push-back branches
                                           (match-ref &concat-found
                                             (Maybe.Just concat-ref)
                                               (if (generic-constructor? c2)
                                                 (str-branch c2 &cell)
                                                 (instance-str-branch c2
                                                                      &(MonoType.Named (String.copy &type-name)
                                                                                       [])
                                                                      &cell
                                                                      &str-ref
                                                                      &deref-ref
                                                                      &copy-ref
                                                                      &ref-ref
                                                                      concat-ref
                                                                      &scratch-insts))
                                             (Maybe.Nothing)
                                               (str-branch c2 &cell)))))))
              (set! new-functions
                    (Array.push-back new-functions
                                     (CoreFunction.init (CoreRef.copy &fn-ref)
                                                        [(CoreRef.copy &param-ref)]
                                                        (Box.init
                                                          (CoreExpr.Match -1
                                                                          true
                                                                          (Box.init
                                                                            (CoreExpr.Annotation -1
                                                                                                 (Box.init
                                                                                                   (CoreExpr.Reference -1
                                                                                                                       (CoreRef.copy &param-ref)))
                                                                                                 (Box.init
                                                                                                   (CoreType.Reference (Box.init (CoreType.copy result-type))
                                                                                                                       (CoreLifetime.Inferred 0)))))
                                                                          branches)))))
              (when derive-str?
                (set! new-impls
                      (Array.push-back new-impls
                                       (CoreImplementation.init (CoreRef.copy &str-ref)
                                                                (CoreRef.copy &fn-ref)))))
              (when derive-prn?
                (set! new-impls
                      (Array.push-back new-impls
                                       (CoreImplementation.init (PrimitiveRegistry.reference 2
                                                                                             "prn")
                                                                (CoreRef.copy &fn-ref)))))))))
      (finish-indexing context
                       (CoreModule.init new-functions
                                        @(CoreModule.values core)
                                        (builtins-except builtins &removed)
                                        @(CoreModule.builtin-sources core)
                                        @(CoreModule.signatures core)
                                        @(CoreModule.type-declarations core)
                                        @(CoreModule.constructors core)
                                        @(CoreModule.recursive-types core)
                                        @(CoreModule.interfaces core)
                                        new-impls
                                        @(CoreModule.overloads core)
                                        @(CoreModule.system-includes core)
                                        @(CoreModule.expressions core))))))

(defmodule Derive
  (private replace-function-named)
  (hidden replace-function-named)
  ; replaces the function in place, without copying the others
  (defn replace-function-named [functions name parameter body]
    (let-do [n (Array.length &functions)
             at -1]
      (for [i 0 n]
        (when (and (Int.< at 0)
                   (String.=
                     (CoreRef.name
                       (CoreFunction.reference (Array.unsafe-nth &functions i)))
                     name))
          (set! at i)))
      (when-do (Int.>= at 0)
        (let [replacement (CoreFunction.init
                (CoreRef.copy
                  (CoreFunction.reference (Array.unsafe-nth &functions at)))
                [(CoreRef.copy parameter)]
                (Box.init (CoreExpr.copy body)))]
          (Array.aset! &functions at replacement)))
      functions))

  (private deftype-core-type)
  (hidden deftype-core-type)
  (defn deftype-core-type [constructors key]
    (let-do [result (CoreType.Unit)
             found false
             n (Array.length constructors)]
      (for [i 0 n]
        (let [candidate (Box.peek
                (CoreConstructorDeclaration.result (Array.unsafe-nth constructors
                                                                     i)))]
          (match (core-base-type-key candidate)
            (Maybe.Just candidate-key)
              (when-do (and (not found) (String.= &candidate-key key))
                (set! result (CoreType.copy candidate))
                (set! found true))
            (Maybe.Nothing) ())))
      result))

  (doc copies "returns `core` with a derived `copy` for every managed type and
the types in `sum-keys`. It copies managed and polymorphic fields and blits the
rest. A defined `<T>.copy` gets the derived body in place.")
  (defn copies [context core]
    (let-do [targets (derive-target-keys core)
             facts (OwnershipClassify.facts-from-module core)
             managed (managed-keys core (OwnershipTypeFacts.owned &facts))
             extra (sum-keys core &managed)
             constructors (CoreModule.constructors core)
             builtins (CoreModule.builtins core)
             new-functions (Array.copy (CoreModule.functions core))
             new-impls (Array.copy (CoreModule.implementations core))
             new-signatures (Array.copy (CoreModule.signatures core))
             removed (the (Array String) [])
             copy-ref (PrimitiveRegistry.reference 0 "copy")
             deref-ref (PrimitiveRegistry.reference 6 "deref")
             cell (the (Array Int)
                       [(Int.inc (CoreIR.max-declared-global-id core))])]
      (for [e 0 (Array.length &extra)]
        (let [key (Array.unsafe-nth &extra e)]
          (unless (contains-key? &targets key)
            (set! targets (Array.push-back targets @key)))))
      (for [t 0 (Array.length &targets)]
        (let-do [tkey (Array.unsafe-nth &targets t)
                 type-name (deftype-name constructors tkey)
                 result-type (deftype-core-type constructors tkey)
                 fn-name (String.concat &[(String.copy &type-name) @".copy"])
                 ; whether the module already defines `<T>.copy`, from
                 ; `accessors` or the user
                 already (function-named? (CoreModule.functions core) &fn-name)
                 builtin (builtin-ref-by-name builtins &fn-name)
                 fn-ref (match-ref &builtin
                   (Maybe.Just reference) (CoreRef.copy reference)
                   (Maybe.Nothing)
                     (CoreRef.init (next-id! &cell) (String.copy &fn-name) true))
                 param-ref (CoreRef.init (next-id! &cell) @"ref" false)
                 branches (the (Array CoreMatchBranch) [])
                 cn (Array.length constructors)]
          (for [ci 0 cn]
            (let [c (Array.unsafe-nth constructors ci)]
              (when (constructor-of? c tkey)
                (set! branches
                      (Array.push-back branches
                                       (copy-branch c
                                                    &managed
                                                    &copy-ref
                                                    &deref-ref
                                                    &cell))))))
          (if already
            ; a defined `<T>.copy` gets the derived body in place, under
            ; the same reference, so its implementation and call sites stay
            ; valid
            (when (contains-key? &managed tkey)
              (set! new-functions
                    (replace-function-named new-functions
                                            &fn-name
                                            &param-ref
                                            &(CoreExpr.Match -1
                                                             true
                                                             (Box.init
                                                               (CoreExpr.Reference -1
                                                                                   (CoreRef.copy &param-ref)))
                                                             branches))))
            (do
              (set! new-functions
                    (Array.push-back new-functions
                                     (CoreFunction.init (CoreRef.copy &fn-ref)
                                                        [(CoreRef.copy &param-ref)]
                                                        (Box.init
                                                          (CoreExpr.Match -1
                                                                          true
                                                                          (Box.init
                                                                            (CoreExpr.Reference -1
                                                                                                (CoreRef.copy &param-ref)))
                                                                          branches)))))
              ;; Core's deftype expansion may already have declared a body-less
              ;; `<T>.copy` builtin and registered it with the interface. Adopt
              ;; that exact reference, remove the builtin declaration, and
              ;; attach the derived body so existing call sites materialize it.
              (match-ref &builtin
                (Maybe.Just _)
                  (Array.push-back! &removed (String.copy &fn-name))
                (Maybe.Nothing) ())
              (unless (implementation-exists? &new-impls &copy-ref &fn-ref)
                (set! new-impls
                      (Array.push-back new-impls
                                       (CoreImplementation.init (CoreRef.copy &copy-ref)
                                                                (CoreRef.copy &fn-ref)))))
              ;; Removing a body-less Core builtin also removes the declaration
              ;; that constrained its nominal type. Retain that constraint as
              ;; an explicit signature; otherwise inference generalizes every
              ;; derived sum copier to `&a -> a` and unrelated constructors can
              ;; steal each other's calls during interface dispatch.
              (set! new-signatures
                    (Array.push-back new-signatures
                                     (CoreSignature.init (CoreRef.copy &fn-ref)
                                                         (Box.init
                                                           (CoreType.Function
                                                             [(Box.init
                                                                (CoreType.Reference (Box.init (CoreType.copy &result-type))
                                                                                    (CoreLifetime.Inferred 0)))]
                                                             (Box.init (CoreType.copy &result-type)))))))))))
      (finish-indexing context
                       (CoreModule.init new-functions
                                        @(CoreModule.values core)
                                        (builtins-except builtins &removed)
                                        @(CoreModule.builtin-sources core)
                                        new-signatures
                                        @(CoreModule.type-declarations core)
                                        @(CoreModule.constructors core)
                                        @(CoreModule.recursive-types core)
                                        @(CoreModule.interfaces core)
                                        new-impls
                                        @(CoreModule.overloads core)
                                        @(CoreModule.system-includes core)
                                        @(CoreModule.expressions core))))))
