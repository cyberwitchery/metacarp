;; Times a warm session cell RUN both ways: the LLVM session JIT (lower →
;; emit → persistent ORC LLJIT → call, in-process) against the C path a host uses today
;; (emit-cell's translation unit → clang → run the binary). The JIT's first
;; cell pays the one shim clang; it is timed separately.

(load "../carp-session-jit.carp")
(Project.no-echo)

(deftemplate monotonic-ms (Fn [] Double) "#include <time.h>
double $NAME(void)" "$DECL {
  struct timespec now;
  clock_gettime(CLOCK_MONOTONIC, &now);
  return ((double)now.tv_sec * 1000.0) + ((double)now.tv_nsec / 1000000.0);
}")

(defn core-dir []
  (match (IO.getenv "CARP_DIR")
    (Maybe.Just root)
      (if (or (String.ends-with? &root "/core")
              (String.ends-with? &root "/core/"))
        root
        (String.append &root (if (String.ends-with? &root "/") "core" "/core")))
    (Maybe.Nothing) (String.copy "../../../../carp/core")))

(def *cell-source* "(let [xs [1 2 3]] (Int.* 2 @(Array.unsafe-nth &xs 1)))")

(defn print-diagnostic [diagnostic]
  (IO.errorln &(fmt "%s: %s"
                    (Diagnostic.phase diagnostic)
                    (Diagnostic.message diagnostic))))

(defn jit-once [js session id]
  (let [cell (SourceInput.init id @*cell-source*)]
    (match (SessionJit.run-cell js session &cell)
      (Result.Success _) 0
      (Result.Error diagnostic)
        (do
          (print-diagnostic &diagnostic)
          1))))

(defn jit-lane [js session iterations]
  (let-do [failures 0
           started (monotonic-ms)]
    (for [i 0 iterations]
      (set! failures
            (Int.+ failures
                   (jit-once js session (String.concat &[@"jit:" (Int.str i)])))))
    (let [total (Double.- (monotonic-ms) started)]
      (IO.println
        &(fmt "jit-cells=%d total-ms=%.1f mean-ms=%.1f failures=%d"
              iterations total
              (Double./ total (Double.from-int iterations))
              failures)))))

(defn clang-once [session dir id]
  (let [cell (SourceInput.init id @*cell-source*)]
    (match (Session.emit-cell session &cell)
      (Result.Success c)
        (match (IO.write-file &c "out/bench-cell.c")
          (Result.Success _)
            (if (Int.= 0 (System.system
                           &(fmt "clang -o out/bench-cell out/bench-cell.c -I . -I %s -lm && ./out/bench-cell > /dev/null"
                                 dir)))
              0
              1)
          (Result.Error _) 1)
      (Result.Error diagnostic)
        (do
          (print-diagnostic &diagnostic)
          1))))

(defn clang-lane [session dir iterations]
  (let-do [failures 0
           started (monotonic-ms)]
    (for [i 0 iterations]
      (set! failures
            (Int.+ failures
                   (clang-once session dir (String.concat &[@"c:" (Int.str i)])))))
    (let [total (Double.- (monotonic-ms) started)]
      (IO.println
        &(fmt "clang-cells=%d total-ms=%.1f mean-ms=%.1f failures=%d"
              iterations total
              (Double./ total (Double.from-int iterations))
              failures)))))

(defn main []
  (let-do [dir (core-dir)
           _mk (ignore (System.system "mkdir -p out"))
           js (SessionJit.create &dir "out")]
    (match (Session.create &dir)
      (Result.Error _) (IO.println "session creation failed")
      (Result.Success session)
        (let-do [first-start (monotonic-ms)
                 warmup (SourceInput.init (String.copy "jit:warmup") @*cell-source*)]
          (match (SessionJit.run-cell &js &session &warmup)
            (Result.Success _)
              (IO.println &(fmt "jit-first-cell-ms=%.1f (includes the one shim clang)"
                                (Double.- (monotonic-ms) first-start)))
            (Result.Error diagnostic)
              (do
                (print-diagnostic &diagnostic)
                (IO.println "jit warmup failed")))
          (jit-lane &js &session 20)
          (clang-lane &session &dir 5)
          (SessionJit.dispose &js)))))
