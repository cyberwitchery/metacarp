(load "../carp-llvm-backend.carp")
(load "../../carp-resolve/carp-resolve.carp")
(load "../../carp-compiler.carp")
(Project.no-echo)
(load "Test.carp")

(use-all Test)

(relative-include "spike-support.h")
(system-include "dlfcn.h")

(deftemplate dlopen-global (Fn [(Ptr CChar)] Long)
  "Long $NAME(const char* path)"
  "$DECL { void* h = dlopen(path, RTLD_NOW | RTLD_GLOBAL); return (Long)(intptr_t)h; }")

(defn contains-text? [text fragment]
  (Int.>= (String.index-of-string text fragment) 0))

(defn lower-to-backend [source]
  (match (Surface.parse source)
    (Result.Success surface)
      (match (Resolve.module &surface)
        (Result.Success core)
          (match (Infer.module &core)
            (Result.Success inferred)
              (match (Specialize.module &core &inferred)
                (Result.Success specialized)
                  (BackendLower.module &specialized
                                       &(the (Array ClosureFunction) [])
                                       &(the (Array (Pair String String)) [])
                                       &(the (Array (Pair String String)) []))
                (Result.Error error)
                  (Result.Error
                    (BackendError.init @(SpecializeError.message &error))))
            (Result.Error error)
              (Result.Error (BackendError.init @(InferError.message &error))))
        (Result.Error error)
          (Result.Error (BackendError.init @(ResolveError.message &error))))
    (Result.Error _) (Result.Error (BackendError.init @"parse error"))))

(defn lower-owned-strings [source]
  (match (Surface.parse source)
    (Result.Success surface)
      (match (Resolve.module &surface)
        (Result.Success core)
          (match (Infer.module &core)
            (Result.Success inferred)
              (match (Specialize.module &core &inferred)
                (Result.Success specialized)
                  (match (Ownership.prepare &specialized
                                            &(OwnershipClassify.facts-from-module &core))
                    (Result.Success ownership)
                      (let [deletes [(Pair.init (CAbi.type-key &(Type.string))
                                                @"carp_llvm_str_delete")]
                            copies [(Pair.init (CAbi.type-key &(Type.string))
                                               @"carp_llvm_str_copy")]]
                        (BackendLower.module-with-ownership &specialized
                                                            &ownership
                                                            &deletes
                                                            &copies))
                    (Result.Error error)
                      (Result.Error
                        (BackendError.init @(OwnershipError.message &error))))
                (Result.Error error)
                  (Result.Error
                    (BackendError.init @(SpecializeError.message &error))))
            (Result.Error error)
              (Result.Error (BackendError.init @(InferError.message &error))))
        (Result.Error error)
          (Result.Error (BackendError.init @(ResolveError.message &error))))
    (Result.Error _) (Result.Error (BackendError.init @"parse error"))))

(deftype Spike [emitted Bool
                verify String
                ir String
                c-parity Bool
                twice Int
                choose-true Int
                choose-false Int
                roots Int])

(defn spike-failure [] (Spike.init false @"" @"" false -1 -1 -1 -1))

(defn find-function-symbol [backend fragment]
  (let-do [declarations (BackendModule.declarations backend)
           n (Array.length declarations)
           found @""]
    (for [i 0 n]
      (match-ref (Array.unsafe-nth declarations i)
        (BackendDeclaration.Function symbol _ _ _)
          (when (contains-text? symbol fragment)
            (set! found (String.copy symbol)))
        _ ()))
    found))

(defn install-test-line-map! [backend]
  (let-do [ids (the (Array Int) [])
           highest 0]
    (for [i 0 (Array.length (BackendModule.declarations backend))]
      (match-ref (Array.unsafe-nth (BackendModule.declarations backend) i)
        (BackendDeclaration.Function _ _ _ body)
          (let-do [id (Specialize.expression-id (Box.peek body))]
            (Array.push-back! &ids id)
            (when (Int.> id highest) (set! highest id)))
        _ ()))
    ; This unit fixture bypasses provenanced resolution, so give its complete
    ; owner-local expression-ID space one synthetic location.
    (let-do [size 4096
             files (Array.replicate size &@"examples/simple.carp")
             lines (Array.replicate size &7)
             columns (Array.replicate size &3)]
      (BackendModule.set-line-map! backend
        (BackendLineMap.init files lines columns)))))

(defn run-spike [backend]
  (let-do [ctx (LLVM.context-create)
           builder (LLVM.builder-create ctx)
           mod (LLVM.module-create (String.cstr &@"spike") ctx)
           _init (do (ignore (LLVM.initialize-native-target))
                     (ignore (LLVM.initialize-native-asm-printer))
                     0)
           triple (LLVM.default-target-triple)
           tm (LLVM.create-target-machine (LLVM.target-from-triple (String.cstr &triple))
                                          (String.cstr &triple)
                                          (String.cstr &@"") (String.cstr &@"")
                                          LLVM.codegen-level-default LLVM.reloc-pic
                                          LLVM.codemodel-default)
           td (LLVM.create-target-data-layout tm)
           _setup (do (LLVM.set-target mod (String.cstr &triple))
                      (LLVM.set-module-data-layout mod td)
                      0)
           emitted (match (LLVMBackend.emit-module ctx builder mod td backend)
                     (Result.Success _) true
                     (Result.Error message) (do (IO.errorln &message) false))
           ir (LLVM.print-module mod)
           verify (LLVM.verify-module mod)
           _cleanup (do (LLVM.dispose-target-data td)
                        (LLVM.dispose-target-machine tm)
                        0)
           c-parity (match (CBackend.executable-translation-unit backend)
                      (Result.Success c) (contains-text? &c "int_inc(")
                      (Result.Error _) false)
           twice-symbol (find-function-symbol backend "twice")
           choose-symbol (find-function-symbol backend "choose")
           ok (and emitted (String.empty? &verify))]
    (unless (String.empty? &verify) (IO.errorln &verify))
    (if (not ok)
      (do
        (LLVM.module-dispose mod)
        (LLVM.builder-dispose builder)
        (LLVM.context-dispose ctx)
        (Spike.init emitted verify ir c-parity -1 -1 -1 -1))
      (do
        (LLVM.link-in-mcjit)
        (ignore (LLVM.initialize-native-target))
        (ignore (LLVM.initialize-native-asm-printer))
        (let-do [engine (LLVM.create-execution-engine mod)
                 result
                   (if (LLVM.engine-null? engine)
                     (do
                       (IO.errorln "engine creation failed")
                       (Spike.init emitted verify ir c-parity -1 -1 -1 -1))
                     (let [twice-addr (LLVM.function-address engine (String.cstr &twice-symbol))
                           choose-addr (LLVM.function-address engine (String.cstr &choose-symbol))
                           roots-addr (LLVM.function-address engine (String.cstr &(LLVMBackend.roots-symbol)))]
                       (Spike.init emitted verify ir c-parity
                                   (LLVM.call-i32-i32 twice-addr 20)
                                   (LLVM.call-i32-i32-i32-i32 choose-addr 1 10 0)
                                   (LLVM.call-i32-i32-i32-i32 choose-addr 0 10 0)
                                   (LLVM.call-i32 roots-addr))))]
          (unless (LLVM.engine-null? engine) (LLVM.engine-dispose engine))
          (LLVM.builder-dispose builder)
          (LLVM.context-dispose ctx)
          result)))))

;; --- the nominal tier: sum types, match, set!, while, break ---

(def nominal-source
  @"(deftype Signal (Code [Bool Int]) (End))
(deftype Inner (Value [Int]) (Empty))
(deftype Outer (Wrap [Inner]) (Other))
(register lt (Fn [Int Int] Bool) \"lt\")
(register add (Fn [Int Int] Int) \"add\")
(defn code [signal] (match signal (Signal.Code _ value) value (Signal.End) 0))
(defn ended [signal] (match signal (Signal.Code _ _) 1 (Signal.End) 2))
(defn unwrap [outer]
  (match outer
    (Outer.Wrap (Inner.Value value)) value
    (Outer.Wrap (Inner.Empty)) 69
    (Outer.Other) 79))
(defn codetest [] (code (Signal.Code true 71)))
(defn endtest [] (ended (Signal.End)))
(defn nestedtest [] (unwrap (Outer.Wrap (Inner.Value 78))))
(defn emptytest [] (unwrap (Outer.Wrap (Inner.Empty))))
(defn othertest [] (unwrap (Outer.Other)))
(defn looped [n]
  (let [acc 0
        i 0]
    (do
      (while (lt i n)
        (do
          (set! acc (add acc i))
          (set! i (add i 1))))
      acc)))
(defn early [n]
  (let [i 0]
    (do
      (while true
        (if (lt i n)
          (set! i (add i 1))
          (break)))
      i)))
(codetest)
(endtest)
(nestedtest)
(emptytest)
(othertest)
(early 4)
(looped 5)")

(deftype Nominal [emitted Bool
                  verify String
                  code Int
                  ended Int
                  nested Int
                  empty Int
                  other Int
                  looped Int
                  early Int
                  roots Int])

(defn nominal-failure []
  (Nominal.init false @"" -1 -1 -1 -1 -1 -1 -1 -1))

(defn run-nominal [backend]
  (let-do [ctx (LLVM.context-create)
           builder (LLVM.builder-create ctx)
           mod (LLVM.module-create (String.cstr &@"nominal") ctx)
           _init (do (ignore (LLVM.initialize-native-target))
                     (ignore (LLVM.initialize-native-asm-printer))
                     0)
           triple (LLVM.default-target-triple)
           tm (LLVM.create-target-machine (LLVM.target-from-triple (String.cstr &triple))
                                          (String.cstr &triple)
                                          (String.cstr &@"") (String.cstr &@"")
                                          LLVM.codegen-level-default LLVM.reloc-pic
                                          LLVM.codemodel-default)
           td (LLVM.create-target-data-layout tm)
           _setup (do (LLVM.set-target mod (String.cstr &triple))
                      (LLVM.set-module-data-layout mod td)
                      0)
           emitted (match (LLVMBackend.emit-module ctx builder mod td backend)
                     (Result.Success _) true
                     (Result.Error message) (do (IO.errorln &message) false))
           verify (LLVM.verify-module mod)
           _cleanup (do (LLVM.dispose-target-data td)
                        (LLVM.dispose-target-machine tm)
                        0)
           ok (and emitted (String.empty? &verify))]
    (unless (String.empty? &verify) (IO.errorln &verify))
    (if (not ok)
      (do
        (LLVM.module-dispose mod)
        (LLVM.builder-dispose builder)
        (LLVM.context-dispose ctx)
        (Nominal.init emitted verify -1 -1 -1 -1 -1 -1 -1 -1))
      (do
        (LLVM.link-in-mcjit)
        (ignore (LLVM.initialize-native-target))
        (ignore (LLVM.initialize-native-asm-printer))
        (let-do [engine (LLVM.create-execution-engine mod)
                 result
                   (if (LLVM.engine-null? engine)
                     (do
                       (IO.errorln "engine creation failed")
                       (nominal-failure))
                     (let [codetest (LLVM.function-address engine (String.cstr &(find-function-symbol backend "codetest")))
                           endtest (LLVM.function-address engine (String.cstr &(find-function-symbol backend "endtest")))
                           nestedtest (LLVM.function-address engine (String.cstr &(find-function-symbol backend "nestedtest")))
                           emptytest (LLVM.function-address engine (String.cstr &(find-function-symbol backend "emptytest")))
                           othertest (LLVM.function-address engine (String.cstr &(find-function-symbol backend "othertest")))
                           looped (LLVM.function-address engine (String.cstr &(find-function-symbol backend "looped")))
                           early (LLVM.function-address engine (String.cstr &(find-function-symbol backend "early")))
                           roots (LLVM.function-address engine (String.cstr &(LLVMBackend.roots-symbol)))]
                       (if (or (Long.= 0l codetest)
                               (or (Long.= 0l endtest)
                                   (or (Long.= 0l nestedtest)
                                       (or (Long.= 0l emptytest)
                                           (or (Long.= 0l othertest)
                                               (or (Long.= 0l looped)
                                                   (or (Long.= 0l early)
                                                       (Long.= 0l roots))))))))
                         (do
                           (IO.errorln "a JIT symbol resolved to null")
                           (nominal-failure))
                         (Nominal.init true @""
                                       (LLVM.call-i32 codetest)
                                       (LLVM.call-i32 endtest)
                                       (LLVM.call-i32 nestedtest)
                                       (LLVM.call-i32 emptytest)
                                       (LLVM.call-i32 othertest)
                                       (LLVM.call-i32-i32 looped 5)
                                       (LLVM.call-i32-i32 early 4)
                                       (LLVM.call-i32 roots)))))]
          (unless (LLVM.engine-null? engine) (LLVM.engine-dispose engine))
          (LLVM.builder-dispose builder)
          (LLVM.context-dispose ctx)
          result)))))

(def spike
  (match (IO.read-file &@"../examples/simple.carp")
    (Result.Success source)
      (match (lower-to-backend &source)
        (Result.Success backend)
          (do
            (install-test-line-map! &backend)
            (run-spike &backend))
        (Result.Error error)
          (do
            (IO.errorln (BackendError.message &error))
            (spike-failure)))
    (Result.Error error)
      (do
        (IO.errorln &error)
        (spike-failure))))

;; --- the globals tier: def globals, init function, global set! ---

(def globals-source
  @"(register lt (Fn [Int Int] Bool) \"lt\")
(register add (Fn [Int Int] Int) \"add\")
(def base 40)
(def answer
  (let [value base]
    (do
      (while (lt value 42)
        (set! value (add value 1)))
      (if (lt value 43) value 0))))
(defn bump [] (do (set! answer (add answer 1)) answer))
(defn peekanswer [] answer)
answer
(peekanswer)
(bump)")

(deftype GlobalsRun [emitted Bool verify String roots Int peek Int bump Int])

(defn globals-failure [] (GlobalsRun.init false @"" -1 -1 -1))

(defn run-globals [backend]
  (let-do [ctx (LLVM.context-create)
           builder (LLVM.builder-create ctx)
           mod (LLVM.module-create (String.cstr &@"globals") ctx)
           _init (do (ignore (LLVM.initialize-native-target))
                     (ignore (LLVM.initialize-native-asm-printer))
                     0)
           triple (LLVM.default-target-triple)
           tm (LLVM.create-target-machine (LLVM.target-from-triple (String.cstr &triple))
                                          (String.cstr &triple)
                                          (String.cstr &@"") (String.cstr &@"")
                                          LLVM.codegen-level-default LLVM.reloc-pic
                                          LLVM.codemodel-default)
           td (LLVM.create-target-data-layout tm)
           _setup (do (LLVM.set-target mod (String.cstr &triple))
                      (LLVM.set-module-data-layout mod td)
                      0)
           emitted (match (LLVMBackend.emit-module ctx builder mod td backend)
                     (Result.Success _) true
                     (Result.Error message) (do (IO.errorln &message) false))
           verify (LLVM.verify-module mod)
           _cleanup (do (LLVM.dispose-target-data td)
                        (LLVM.dispose-target-machine tm)
                        0)
           ok (and emitted (String.empty? &verify))]
    (unless (String.empty? &verify) (IO.errorln &verify))
    (if (not ok)
      (do
        (LLVM.module-dispose mod)
        (LLVM.builder-dispose builder)
        (LLVM.context-dispose ctx)
        (GlobalsRun.init emitted verify -1 -1 -1))
      (do
        (LLVM.link-in-mcjit)
        (let-do [engine (LLVM.create-execution-engine mod)
                 result
                   (if (LLVM.engine-null? engine)
                     (do (IO.errorln "engine creation failed") (globals-failure))
                     (let-do [roots-addr (LLVM.function-address engine (String.cstr &(LLVMBackend.roots-symbol)))
                              peek-symbol (find-function-symbol backend "peekanswer")
                              bump-symbol (find-function-symbol backend "bump")
                              peek-addr (LLVM.function-address engine (String.cstr &peek-symbol))
                              bump-addr (LLVM.function-address engine (String.cstr &bump-symbol))]
                       (if (or (Long.= 0l roots-addr)
                               (or (Long.= 0l peek-addr) (Long.= 0l bump-addr)))
                         (do (IO.errorln "a globals JIT symbol resolved to null")
                             (globals-failure))
                         (let-do [roots-value (LLVM.call-i32 roots-addr)
                                  peek-value (LLVM.call-i32 peek-addr)
                                  bump-value (LLVM.call-i32 bump-addr)]
                           (GlobalsRun.init true @"" roots-value peek-value bump-value)))))]
          (unless (LLVM.engine-null? engine) (LLVM.engine-dispose engine))
          (LLVM.builder-dispose builder)
          (LLVM.context-dispose ctx)
          result)))))

(def globals-run
  (match (lower-to-backend &globals-source)
    (Result.Success backend) (run-globals &backend)
    (Result.Error error)
      (do (IO.errorln (BackendError.message &error)) (globals-failure))))

;; --- the template tier: deftemplate via the C shim ---

(deftype TemplateRun [emitted Bool verify String shim-ok Bool roots Int extra Int])

(defn template-failure [] (TemplateRun.init false @"" false -1 -1))

(defn build-shim [backend base]
  (match (LLVMBackend.shim-translation-unit backend)
    (Result.Success shim-c)
      (match (IO.write-file &shim-c &(fmt "%s.c" base))
        (Result.Success _)
          (match (IO.getenv "CARP_DIR")
            (Maybe.Just carp-dir)
              (if (Int./= 0 (System.system &(fmt "clang -dynamiclib -undefined dynamic_lookup -o %s.dylib %s.c -I %s/core"
                                                 base base &carp-dir)))
                (do (IO.errorln "shim clang failed") false)
                (if (Long.= 0l (dlopen-global (String.cstr &(fmt "%s.dylib" base))))
                  (do (IO.errorln "shim dlopen failed") false)
                  true))
            (Maybe.Nothing) (do (IO.errorln "CARP_DIR unset") false))
        (Result.Error error) (do (IO.errorln &error) false))
    (Result.Error error)
      (do (IO.errorln (BackendError.message &error)) false)))

(defn run-template [backend base extra-fragment extra-arg]
  (let-do [ctx (LLVM.context-create)
           builder (LLVM.builder-create ctx)
           mod (LLVM.module-create (String.cstr &@"template") ctx)
           _init (do (ignore (LLVM.initialize-native-target))
                     (ignore (LLVM.initialize-native-asm-printer))
                     0)
           triple (LLVM.default-target-triple)
           tm (LLVM.create-target-machine (LLVM.target-from-triple (String.cstr &triple))
                                          (String.cstr &triple)
                                          (String.cstr &@"") (String.cstr &@"")
                                          LLVM.codegen-level-default LLVM.reloc-pic
                                          LLVM.codemodel-default)
           td (LLVM.create-target-data-layout tm)
           _setup (do (LLVM.set-target mod (String.cstr &triple))
                      (LLVM.set-module-data-layout mod td)
                      0)
           emitted (match (LLVMBackend.emit-module ctx builder mod td backend)
                     (Result.Success _) true
                     (Result.Error message) (do (IO.errorln &message) false))
           verify (LLVM.verify-module mod)
           _cleanup (do (LLVM.dispose-target-data td)
                        (LLVM.dispose-target-machine tm)
                        0)
           shim-ok (build-shim backend base)
           ok (and emitted (and shim-ok (String.empty? &verify)))]
    (unless (String.empty? &verify) (IO.errorln &verify))
    (if (not ok)
      (do
        (LLVM.module-dispose mod)
        (LLVM.builder-dispose builder)
        (LLVM.context-dispose ctx)
        (TemplateRun.init emitted verify shim-ok -1 -1))
      (do
        (LLVM.link-in-mcjit)
        (let-do [engine (LLVM.create-execution-engine mod)
                 result
                   (if (LLVM.engine-null? engine)
                     (do (IO.errorln "engine creation failed") (template-failure))
                     (let-do [roots-addr (LLVM.function-address engine (String.cstr &(LLVMBackend.roots-symbol)))
                              extra-value
                                (if (String.empty? extra-fragment)
                                  -1
                                  (let [extra-symbol (find-function-symbol backend extra-fragment)]
                                    (if (String.empty? &extra-symbol)
                                      -1
                                      (let [addr (LLVM.function-address engine (String.cstr &extra-symbol))]
                                        (if (Long.= 0l addr)
                                          -1
                                          (LLVM.call-i32-i32 addr extra-arg))))))]
                       (if (Long.= 0l roots-addr)
                         (do (IO.errorln "roots symbol resolved to null") (template-failure))
                         (TemplateRun.init true @"" true (LLVM.call-i32 roots-addr) extra-value))))]
          (unless (LLVM.engine-null? engine) (LLVM.engine-dispose engine))
          (LLVM.builder-dispose builder)
          (LLVM.context-dispose ctx)
          result)))))

(def triple-source
  @"(deftemplate triple (Fn [Int] Int) \"int $NAME(int x)\" \"$DECL { return x * 3; }\")
(defn tripled [n] (triple n))
(tripled 4)")

(def hello-run
  (match (IO.read-file &@"../examples/hello.carp")
    (Result.Success source)
      (match (lower-to-backend &source)
        (Result.Success backend) (run-template &backend "out/template-hello" "" 0)
        (Result.Error error)
          (do (IO.errorln (BackendError.message &error)) (template-failure)))
    (Result.Error error) (do (IO.errorln &error) (template-failure))))

(def nominal-example-run
  (match (IO.read-file &@"../examples/nominal.carp")
    (Result.Success source)
      (match (lower-to-backend &source)
        (Result.Success backend) (run-template &backend "out/template-nominal" "" 0)
        (Result.Error error)
          (do (IO.errorln (BackendError.message &error)) (template-failure)))
    (Result.Error error) (do (IO.errorln &error) (template-failure))))

(def triple-run
  (match (lower-to-backend &triple-source)
    (Result.Success backend) (run-template &backend "out/template-triple" "tripled" 4)
    (Result.Error error)
      (do (IO.errorln (BackendError.message &error)) (template-failure))))

;; --- the strings tier: string literals as borrowed static storage ---

(def strings-source
  @"(register strlenof (Fn [(Ref String)] Int) \"strlen_of\")
(defn hellolen [] (strlenof \"hello\"))
(defn worldlen [] (strlenof \"world!!\"))
(hellolen)
(worldlen)")

(def strings-run
  (match (lower-to-backend &strings-source)
    (Result.Success backend) (run-template &backend "out/template-strings" "worldlen" 0)
    (Result.Error error)
      (do (IO.errorln (BackendError.message &error)) (template-failure))))

;; --- the managed tier: owned strings with ownership-planned deletes ---

(def owned-source
  @"(defmodule MyStr
  (register delete (Fn [String] ()) \"carp_llvm_str_delete\")
  (register copy (Fn [(Ref String)] String) \"carp_llvm_str_copy\")
  (register length (Fn [(Ref String)] Int) \"carp_llvm_str_len\"))
(implements delete MyStr.delete)
(implements copy MyStr.copy)
(defn duplen [] (let [s (MyStr.copy \"hello\")] (MyStr.length &s)))
(defn passthrough [s] (MyStr.length &s))
(defn chain [] (passthrough (MyStr.copy \"world!!\")))
(duplen)
(chain)")

(def owned-run
  (match (lower-owned-strings &owned-source)
    (Result.Success backend) (run-template &backend "out/template-owned" "duplen" 0)
    (Result.Error error)
      (do (IO.errorln (BackendError.message &error)) (template-failure))))

;; --- the arrays tier: literals, nth, length, template deleter via wrapper ---

(def arrays-source
  @"(register total3 (Fn [(Ref (Array Int))] Int) \"total3\")
(register derefint (Fn [(Ref Int)] Int) \"deref_int\")
(defn arr [] [1 2 3])
(defn total [] (let [a (arr)] (total3 &a)))
(defn pick [] (let [a [10 20 30]] (derefint (Array.unsafe-nth &a 1))))
(defn alen [] (let [a [5 6 7 8]] (Array.length &a)))
(deftemplate asum (Fn [(Array Int)] Int)
  \"int $NAME(Array a)\"
  \"$DECL { int s = 0; for (size_t i = 0; i < a.len; i++) s += ((int*)a.data)[i]; if (a.data) CARP_FREE(a.data); return s; }\")
(defn sums [] (asum [4 5 6]))
(pick)
(alen)
(total)
(sums)")

(def arrays-run
  (match (lower-owned-strings &arrays-source)
    (Result.Success backend) (run-template &backend "out/template-arrays" "pick" 0)
    (Result.Error error)
      (do (IO.errorln (BackendError.message &error)) (template-failure))))

;; --- the closures tier: lambdas, captures, indirect calls ---

(def closures-source
  @"(register add (Fn [Int Int] Int) \"add\")
(defn apply1 [f x] (f x))
(defn addn [n] (fn [x] (add x n)))
(defn direct [] (apply1 (fn [x] (add x 1)) 10))
(defn captured [] (apply1 (addn 5) 10))
(direct)
(captured)")

(def closures-run
  (match (CarpCompiler.lower-source &closures-source)
    (Result.Success backend) (run-template &backend "out/template-closures" "direct" 0)
    (Result.Error error)
      (do (IO.errorln &(CompileError.render &error)) (template-failure))))

(register c-signal-size (Fn [] Int) "c_signal_size")
(register c-signal-tag-offset (Fn [] Int) "c_signal_tag_offset")
(register c-outer-size (Fn [] Int) "c_outer_size")
(register c-outer-tag-offset (Fn [] Int) "c_outer_tag_offset")

(deftype Parity [signal-size Int signal-tag Int outer-size Int outer-tag Int])

(defn measure-parity [backend]
  (let-do [ctx (LLVM.context-create)
           _init (do (ignore (LLVM.initialize-native-target))
                     (ignore (LLVM.initialize-native-asm-printer))
                     0)
           triple (LLVM.default-target-triple)
           tm (LLVM.create-target-machine (LLVM.target-from-triple (String.cstr &triple))
                                          (String.cstr &triple)
                                          (String.cstr &@"") (String.cstr &@"")
                                          LLVM.codegen-level-default LLVM.reloc-pic
                                          LLVM.codemodel-default)
           td (LLVM.create-target-data-layout tm)
           signal (LLVMBackend.sum-layout ctx td backend "Signal")
           outer (LLVMBackend.sum-layout ctx td backend "Outer")]
    (LLVM.dispose-target-data td)
    (LLVM.dispose-target-machine tm)
    (LLVM.context-dispose ctx)
    (Parity.init @(Pair.a &signal) @(Pair.b &signal)
                 @(Pair.a &outer) @(Pair.b &outer))))

(def parity
  (match (lower-to-backend &nominal-source)
    (Result.Success backend) (measure-parity &backend)
    (Result.Error _) (Parity.init -1 -1 -1 -1)))

(def nominal
  (match (lower-to-backend &nominal-source)
    (Result.Success backend) (run-nominal &backend)
    (Result.Error error)
      (do
        (IO.errorln (BackendError.message &error))
        (nominal-failure))))

(deftest test
  (assert-true test @(Spike.emitted &spike)
    "llvm backend emits the simple tier with no errors")
  (assert-true test (String.empty? (Spike.verify &spike))
    "emitted module passes the LLVM verifier")
  (assert-true test (contains-text? (Spike.ir &spike) "declare i32 @int_inc")
    "registered intrinsic int_inc is declared, not defined")
  (assert-true test (contains-text? (Spike.ir &spike) "twice")
    "twice is defined under its mangled symbol")
  (assert-true test (contains-text? (Spike.ir &spike) "!DICompileUnit")
    "an explicit backend line map emits a DWARF compile unit")
  (assert-true test (contains-text? (Spike.ir &spike) "!DISubprogram")
    "source functions carry DWARF subprograms")
  (assert-true test
    (contains-text? (Spike.ir &spike)
                    "!DISubprogram(name: \"carp_llvm_roots\"")
    "top-level expressions carry a roots-function DWARF scope")
  (assert-true test (contains-text? (Spike.ir &spike) "!DILexicalBlockFile")
    "instruction locations retain their own file inside synthesized functions")
  (assert-true test (contains-text? (Spike.ir &spike) "!DILocation(line: 7, column: 3")
    "expression identities become DWARF line and column locations")
  (assert-true test @(Spike.c-parity &spike)
    "the same BackendModule still renders through the C backend")
  (assert-equal test 22 @(Spike.twice &spike)
    "JIT twice(20) == 22 through the process-resolved int_inc")
  (assert-equal test 12 @(Spike.choose-true &spike)
    "JIT choose(true, 10, 0) == twice(10) == 12")
  (assert-equal test 0 @(Spike.choose-false &spike)
    "JIT choose(false, 10, 0) == 0")
  (assert-equal test 12 @(Spike.roots &spike)
    "roots function returns the last Int-typed top-level value")
  (assert-true test @(Nominal.emitted &nominal)
    "llvm backend emits the nominal tier with no errors")
  (assert-true test (String.empty? (Nominal.verify &nominal))
    "nominal module passes the LLVM verifier")
  (assert-equal test 71 @(Nominal.code &nominal)
    "JIT code(Signal.Code true 71) == 71  (constructor + match + wildcard field)")
  (assert-equal test 2 @(Nominal.ended &nominal)
    "JIT ended(Signal.End) == 2  (nullary constructor + match)")
  (assert-equal test 78 @(Nominal.nested &nominal)
    "JIT unwrap(Outer.Wrap (Inner.Value 78)) == 78  (nested pattern)")
  (assert-equal test 69 @(Nominal.empty &nominal)
    "JIT unwrap(Outer.Wrap (Inner.Empty)) == 69  (nested nullary pattern)")
  (assert-equal test 79 @(Nominal.other &nominal)
    "JIT unwrap(Outer.Other) == 79  (sibling variant)")
  (assert-equal test 10 @(Nominal.looped &nominal)
    "JIT looped(5) == 10  (while + set! slots)")
  (assert-equal test 4 @(Nominal.early &nominal)
    "JIT early(4) == 4  (break out of while true)")
  (assert-equal test 10 @(Nominal.roots &nominal)
    "nominal roots function returns looped(5)")
  (assert-equal test (c-signal-size) @(Parity.signal-size &parity)
    "Signal layout size matches the host C compiler")
  (assert-equal test (c-signal-tag-offset) @(Parity.signal-tag &parity)
    "Signal tag offset matches the host C compiler")
  (assert-equal test (c-outer-size) @(Parity.outer-size &parity)
    "Outer (nested sum) layout size matches the host C compiler")
  (assert-equal test (c-outer-tag-offset) @(Parity.outer-tag &parity)
    "Outer (nested sum) tag offset matches the host C compiler")
  (assert-true test @(TemplateRun.emitted &hello-run)
    "hello.carp: llvm backend emits with the template declared")
  (assert-true test @(TemplateRun.shim-ok &hello-run)
    "hello.carp: C shim renders, compiles, and loads")
  (assert-equal test 0 @(TemplateRun.roots &hello-run)
    "hello.carp: roots runs across the shim boundary (prints OK)")
  (assert-true test @(TemplateRun.shim-ok &nominal-example-run)
    "nominal.carp: C shim renders, compiles, and loads")
  (assert-equal test 0 @(TemplateRun.roots &nominal-example-run)
    "nominal.carp: full example runs (sums + template shim)")
  (assert-true test @(TemplateRun.shim-ok &triple-run)
    "triple: C shim renders, compiles, and loads")
  (assert-equal test 12 @(TemplateRun.extra &triple-run)
    "triple: JIT tripled(4) == 12 through the shim template")
  (assert-equal test 12 @(TemplateRun.roots &triple-run)
    "triple: roots returns tripled(4)")
  (assert-true test @(GlobalsRun.emitted &globals-run)
    "globals: llvm backend emits def globals with no errors")
  (assert-true test (String.empty? (GlobalsRun.verify &globals-run))
    "globals: module passes the LLVM verifier")
  (assert-equal test 43 @(GlobalsRun.roots &globals-run)
    "globals: roots inits base->answer (42), bump makes 43")
  (assert-equal test 43 @(GlobalsRun.peek &globals-run)
    "globals: state persists across JIT calls (peek == 43)")
  (assert-equal test 44 @(GlobalsRun.bump &globals-run)
    "globals: set! on a global from a function (bump == 44)")
  (assert-true test @(TemplateRun.emitted &strings-run)
    "strings: llvm backend emits string literals with no errors")
  (assert-equal test 7 @(TemplateRun.roots &strings-run)
    "strings: roots returns strlen of the last literal")
  (assert-equal test 7 @(TemplateRun.extra &strings-run)
    "strings: JIT worldlen() == 7 (borrowed literal into C)")
  (assert-true test @(TemplateRun.emitted &owned-run)
    "owned strings: llvm backend emits ownership-planned code")
  (assert-equal test 5 @(TemplateRun.extra &owned-run)
    "owned strings: JIT duplen() == 5 (copy, borrow, delete)")
  (assert-equal test 7 @(TemplateRun.roots &owned-run)
    "owned strings: roots returns chain() == 7 (param consumed + deleted)")
  (assert-true test @(TemplateRun.emitted &arrays-run)
    "arrays: llvm backend emits array literals and builtins")
  (assert-true test @(TemplateRun.shim-ok &arrays-run)
    "arrays: shim with generated deleter template and ABI wrapper loads")
  (assert-equal test 20 @(TemplateRun.extra &arrays-run)
    "arrays: JIT pick() == 20 (literal + unsafe-nth borrow)")
  (assert-equal test 15 @(TemplateRun.roots &arrays-run)
    "arrays: roots returns sums() == 15 (Array BY VALUE through the ABI wrapper)")
  (assert-true test @(TemplateRun.emitted &closures-run)
    "closures: llvm backend emits lambdas and indirect calls")
  (assert-true test @(TemplateRun.shim-ok &closures-run)
    "closures: shim with the Lambda arity deleter loads")
  (assert-equal test 11 @(TemplateRun.extra &closures-run)
    "closures: JIT direct() == 11 (non-capturing lambda through apply1)")
  (assert-equal test 15 @(TemplateRun.roots &closures-run)
    "closures: roots returns captured() == 15 (heap env + env-first call)"))
