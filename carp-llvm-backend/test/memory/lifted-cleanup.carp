; The first noncapturing callback must keep cleanup from its source context.
(defn make-reader []
  (fn []
    (let-do [bytes (the (Array Byte) [])
             i 0]
      (while-do (Int.< i 4)
        (set! bytes (Array.push-back bytes (Byte.from-int 65)))
        (set! i (Int.inc i)))
      (String.from-bytes &bytes))))

(defn main []
  (let-do [reader (make-reader)]
    (ignore (reader))
    (let-do [before (Debug.memory-balance)]
      (for [i 0 20]
        (let [text (reader)] (unless (String.= &text "AAAA") (System.exit 1))))
      (let-do [delta (Long.- (Debug.memory-balance) before)]
        (unless-do (Long.= delta 0l)
          (IO.errorln
            &(fmt "assertion failed: callback leaked %d allocations" delta))
          (System.exit 2))
        (IO.println "lifted callback released")))))
