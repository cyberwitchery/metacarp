; Empty literals need no allocation, including when globals outlive a JIT cell.
(def *empty-array-literal* (the (Array Int) []))

(defn main []
  (let-do [before (Debug.memory-balance)]
    (for [i 0 20] (set! *empty-array-literal* []))
    (let [empty (null? (Array.raw *empty-array-literal*))
          balanced (= before (Debug.memory-balance))]
      (if (and empty balanced)
        (IO.println "empty literals use null storage")
        (do
          (IO.errorln "empty literal storage must be null and balanced")
          (System.exit 1))))))
