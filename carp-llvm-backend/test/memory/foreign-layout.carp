(relative-include "foreign-layout.h")
(register-type ForeignWide)
(register-type ForeignPacked [head Byte
                              word Int])
(register-type ForeignAligned)
(register wide (Fn [] ForeignWide) "foreign_wide")
(register packed (Fn [] ForeignPacked) "foreign_packed")
(register aligned (Fn [] ForeignAligned) "foreign_aligned")
(register check
  (Fn [ForeignWide ForeignPacked ForeignAligned] Int)
  "foreign_check")
(register wide-copy (Fn [(Ref ForeignWide)] ForeignWide) "foreign_wide_copy")
(register packed-copy
  (Fn [(Ref ForeignPacked)] ForeignPacked)
  "foreign_packed_copy")
(register aligned-copy
  (Fn [(Ref ForeignAligned)] ForeignAligned)
  "foreign_aligned_copy")
(implements copy wide-copy)
(implements copy packed-copy)
(implements copy aligned-copy)

(deftype Wrapped [flag Bool
                  value ForeignWide])

(defn exercise []
  (let [values [(wide) (wide)]
        wrapped (Wrapped.init true (wide))
        small (packed)
        large (aligned)]
    (and
      (= (check @(Array.unsafe-nth &values 1) small large) 1)
      (= (check @(Wrapped.value &wrapped) (packed) (aligned)) 1))))

(defn main []
  (let-do [before (Debug.memory-balance)]
    (for [i 0 20] (unless (exercise) (System.exit 1)))
    (if (= before (Debug.memory-balance))
      (IO.println "foreign layouts preserved")
      (System.exit 2))))
