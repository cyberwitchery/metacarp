(deftype Payload [text String
                  numbers (Array Int)])

(defn exercise []
  (let [value (Payload.init @"owned" [1 2 3])
        callback (fn [n] (+ n (String.length (Payload.text &value))))
        copied @&callback]
    (Int.+ (callback 10) (copied 20))))

(defn main []
  (let-do [before (Debug.memory-balance)]
    (for [i 0 20] (when (/= (exercise) 40) (System.exit 1)))
    (if (= before (Debug.memory-balance))
      (IO.println "aggregate closure copies released")
      (System.exit 2))))
