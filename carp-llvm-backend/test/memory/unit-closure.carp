; closures with a unit parameter: the parameter has no storage, so it is left
; out of the callback's declaration, its definition and every call through it

(deftype Wide [a Int
               b Int
               c Int
               d Int
               e Int])

(sig apply-it (Fn [(Ref (Fn [() Int] Int)) Int] Int))
(defn apply-it [f x] (~f () x))

(defn exercise []
  (let [k 1
        name @"unit"
        plain (fn [u x] (Int.inc x))
        captured (fn [u x] (Int.+ x k))
        owning (fn [u x] (Int.+ x (String.length &name)))
        wide (fn [u w] (Int.+ k @(Wide.e &w)))
        all-unit (fn [u v] k)]
    (Int.+ (Int.+ (plain () 1) (captured () 2))
           (Int.+
             (Int.+ (apply-it &plain 3) (apply-it &captured 4))
             (Int.+
               (Int.+ (owning () 5) (wide () (Wide.init 1 2 3 4 5)))
               (all-unit () ()))))))

(defn main []
  (let-do [before (Debug.memory-balance)]
    (for [i 0 20] (when (/= (exercise) 30) (System.exit 1)))
    (if (= before (Debug.memory-balance))
      (IO.println "unit-parameter closures called and released")
      (System.exit 2))))
