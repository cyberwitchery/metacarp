; Packed's second Int occupies padding in Aligned's layout. Every active
; payload byte must survive constructor returns, calls, copies, and phi nodes.
(deftype Payload
  (Aligned [Int Long])
  (Packed [Int Int Int Int]))
(defn identity [value] value)
(defn choose [n] (if (= n 0) (Payload.Packed 1 2 3 4) (Payload.Aligned 5 6l)))
(defn second [value]
  (match value (Payload.Packed _ x _ _) x (Payload.Aligned _ _) 0))
(defn exercise []
  (let [value (choose 0)
        copied @&value
        values [(identity value) copied]
        callback (fn [n] (choose n))]
    (+ (second @(Array.unsafe-nth &values 0))
       (+ (second @(Array.unsafe-nth &values 1)) (second (callback 0))))))
(defn main []
  (let-do [before (Debug.memory-balance)]
    (for [i 0 20]
      (let [actual (exercise)]
        (unless-do (= actual 6)
          (IO.errorln
            &(fmt
              "assertion failed: expected preserved sum payload 6, got %d"
              actual))
          (System.exit 1))))
    (if (= before (Debug.memory-balance))
      (IO.println "sum payload bytes preserved")
      (System.exit 2))))
