;; Constructor callbacks use the same C ABI as ordinary function values.
;; Wide returns and aggregate arguments require the pointer protocol.
(deftype Wide [text String
               numbers (Array Int)
               marker Int])
(deftype Tagged
  (Value [Wide])
  (Empty))

(defn make-wide [make text] (make text [1 2 3] 7))
(defn make-tagged [make value] (make value))

(defn exercise []
  (let-do [wide (make-wide Wide.init @"owned")
           tagged (make-tagged Tagged.Value wide)
           empty (Array.repeat 3 &Tagged.Empty)
           strings (the (Map Int String) (Map.create))
           arrays (the (Map Int (Array Int)) (Map.create))]
    (Map.put! &strings &1 "ok")
    (Map.put! &arrays &2 &[4 5])
    (let [payload-ok (match-ref &tagged
            (Tagged.Value value)
              (and (= @(Wide.marker value) 7)
                   (and (= (String.length (Wide.text value)) 5)
                        (= (Array.length (Wide.numbers value)) 3)))
            _ false)
          empty-ok (match-ref (Array.unsafe-nth &empty 2)
            (Tagged.Empty) true
            _ false)]
      (and payload-ok
           (and empty-ok
                (and (= &(Map.get &strings &1) "ok")
                     (= (Array.length &(Map.get &arrays &2)) 2)))))))

(defn main []
  (let-do [before (Debug.memory-balance)]
    (for [i 0 20] (unless (exercise) (System.exit 1)))
    (if (= before (Debug.memory-balance))
      (IO.println "constructor callbacks released")
      (System.exit 2))))
