; Taking a reference to a specialized global must alias its persistent storage,
; including array headers that change when their allocation grows.
(def *global-reference-items* (the (Array Int) []))
(def *global-reference-count* 0)

(defn grow-global [n]
  (for [i 0 n] (Array.push-back! &*global-reference-items* i)))

(defn increment-global [value]
  (Pointer.set (Pointer.address value) (Int.inc @value)))

(defn exercise-globals []
  (let-do [_grow (grow-global 40)
           _increment (increment-global &*global-reference-count*)
           length (Array.length &*global-reference-items*)
           count *global-reference-count*]
    (set! *global-reference-items* [])
    (and (Int.= length 40) (Int.= count 1))))

(defn main []
  (let-do [before (Debug.memory-balance)
           aliased (exercise-globals)
           leaked (Long.- (Debug.memory-balance) before)]
    (IO.println
      &(fmt
        "global-reference: aliased %s, leaked %s"
        &(Bool.str aliased)
        &(Long.str leaked)))
    (if (and aliased (Long.= leaked 0l)) 0 1)))
