;; a derived `set-<field>!` drops the value the field held (#79). The String
;; field frees through a by-value deleter, the struct field through the
;; aggregate pointer protocol. Run with --log-memory under both drivers; the
;; exit code is the check.

(deftype Inner [label String])
(deftype Outer [inner Inner
                name String])

(defn churn [n]
  (let-do [o (Outer.init (Inner.init @"inner") @"outer")]
    (for [i 0 n]
      (do
        (Outer.set-name! &o (fmt "name-%d" i))
        (Outer.set-inner! &o (Inner.init (fmt "label-%d" i)))))
    (+ (String.length (Outer.name &o))
       (String.length (Inner.label (Outer.inner &o))))))

(defn main []
  (let-do [before (Debug.memory-balance)
           lengths (churn 100)
           leaked (Long.- (Debug.memory-balance) before)]
    (IO.println &(fmt "field-set: lengths %d, leaked %d" lengths leaked))
    (if (Long.= leaked 0l) 0 1)))
