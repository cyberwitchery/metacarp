; a let-bound lambda calling itself captures the binding under construction
(defn countdown [n] (let [f (fn [x] (if (= x 1) x (f (dec x))))] (f n)))

(defn main []
  (let-do [before (Debug.memory-balance)]
    (for [i 0 20] (when (/= (countdown 10) 1) (System.exit 1)))
    (if (= before (Debug.memory-balance))
      (IO.println "recursive let closures released")
      (System.exit 2))))
