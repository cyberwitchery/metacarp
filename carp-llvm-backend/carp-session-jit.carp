;; carp-session-jit — the LLVM session JIT: runs a session cell natively
;; through one persistent ORC LLJIT instead of emitting C for a clang round-trip.
;;
;; The split keeps carp-session free of libLLVM: `Session.lower-cell` stops
;; the transactional cell pipeline at the lowered BackendModule, and this
;; component (loaded only by hosts that want the JIT) does the LLVM work.
;;
;; Each cell emits an incremental LLVM module. Native templates and ABI
;; helpers are rendered through the C backend, compiled by the matching clang
;; to IR, and added with that module under one ORC resource tracker. Publication
;; commits code, materialization caches, and artifacts only after lookup succeeds;
;; failure removes the whole transaction. Already published support is imported
;; by later cells, so cells with no new C dependencies avoid clang.
;;
;; Published code and global storage persist across cells. A committed edit
;; retires both C-derived and LLVM modules while retaining the LLJIT and context;
;; the next cell republishes the new dependency world.

(load "../carp-session/carp-session.carp")
(load "inspection-layout.carp")

(load "session-artifacts.carp")

(deftype NativePublication
  [serial Int
   environment NativeLayoutEnvironment
   closures (Array NativeClosureLayout)])
(deftype NativeLayoutCache [publication Int
                            key String
                            layout NativeValueLayout])
(deftype NativeCallbackCache [symbol String
                              address Long])
(deftype JitSession
  [context LLVMContext
   thread-context LLVMOrcThreadSafeContext
   jit LLVMOrcLLJIT
   dylib LLVMOrcJITDylib
   machine LLVMTargetMachine
   data LLVMTargetData
   triple String
   core-dir String
   scratch String
   materialized (Array String)
   code (Array String)
   instances (Array Specialization)
   last-declarations Int
   serial Int
   artifacts (Array JitArtifact)
   c-artifacts (Array JitCArtifact)
   publications (Array NativePublication)
   layouts (Array NativeLayoutCache)
   callbacks (Array NativeCallbackCache)
   context-id Int
   last-executed Long
   generation Int
   foreign-layout-cache ForeignLayoutCache
   versions (Array (Pair String String))
   revision Int
   retired (Array Int)])

(load "native-support.carp")
(load "session-invalidation.carp")

(defmodule SessionJit
  (doc create "creates a warm JIT for one session: one thread-safe LLVM
context, LLJIT, target machine, and data layout are shared by every cell.
`core-dir` locates the runtime
headers native support compiles against; `scratch` holds its C and IR files.")
  (defn create [core-dir scratch]
    (let-do [context-id *jit-context-serial*
             _context (set! *jit-context-serial* (Int.inc context-id))
             _init (do
               (ignore (LLVM.initialize-native-target))
               (ignore (LLVM.initialize-native-asm-printer))
               0)
             ctx (LLVM.context-create)
             thread-context (LLVM.orc-thread-safe-context ctx)
             jit (LLVM.orc-create-lljit)
             dylib (LLVM.orc-main-dylib jit)
             _symbols (LLVM.orc-enable-process-symbols jit)
             triple (LLVM.default-target-triple)
             tm (LLVM.create-target-machine
               (LLVM.target-from-triple (String.cstr &triple))
               (String.cstr &triple)
               (String.cstr &@"")
               (String.cstr &@"")
               LLVM.codegen-level-default
               LLVM.reloc-pic
               LLVM.codemodel-default)
             td (LLVM.create-target-data-layout tm)]
      (LLVMBackend.use-carp-allocator!)
      (BackendLower.use-stable-lambda-symbols! true)
      (JitSession.init ctx
                       thread-context
                       jit
                       dylib
                       tm
                       td
                       triple
                       (String.copy core-dir)
                       (String.copy scratch)
                       (the (Array String) [])
                       (the (Array String) [])
                       (the (Array Specialization) [])
                       0
                       0
                       []
                       []
                       []
                       []
                       []
                       context-id
                       0l
                       0
                       (ForeignLayouts.empty-cache)
                       []
                       0
                       [])))

  (doc reset-code! "removes every published module while retaining the LLJIT,
thread-safe context and target state. C support, LLVM code, materialization
caches, and artifacts share this invalidation boundary.")
  (defn reset-code! [js]
    (let-do [error (LLVM.orc-clear-dylib (LLVM.dup (JitSession.dylib js)))]
      (when-do (String.empty? &error)
        (JitSession.set-code! js (the (Array String) []))
        (JitSession.set-instances! js (the (Array Specialization) []))
        (JitSession.set-versions! js [])
        (JitSession.set-revision! js 0)
        (JitSession.set-retired! js [])
        (JitSession.set-last-declarations! js 0)
        (JitSession.set-artifacts! js [])
        (JitSession.set-materialized! js [])
        (JitSession.set-c-artifacts! js [])
        (JitSession.set-publications! js [])
        (JitSession.set-layouts! js [])
        (JitSession.set-foreign-layout-cache! js (ForeignLayouts.empty-cache))
        (JitSession.set-callbacks! js [])
        (JitSession.set-last-executed! js 0l)
        (JitSession.set-generation! js (Int.inc @(JitSession.generation js))))
      error))

  (doc dispose "frees the persistent JIT, thread-safe context, target data,
and target machine.")
  (defn dispose [js]
    (do
      (LLVM.orc-dispose-lljit (LLVM.dup (JitSession.jit js)))
      (LLVM.orc-dispose-thread-safe-context
        (LLVM.dup (JitSession.thread-context js)))
      (LLVM.dispose-target-data (LLVM.dup (JitSession.data js)))
      (LLVM.dispose-target-machine (LLVM.dup (JitSession.machine js)))))

  (private published?)
  (hidden published?)
  (defn published? [js symbol]
    (let-do [found false]
      (for [i 0 (Array.length (JitSession.code js))]
        (when (String.= (Array.unsafe-nth (JitSession.code js) i) symbol)
          (set! found true)))
      found))

  (private jit-diagnostic)
  (hidden jit-diagnostic)
  (defn jit-diagnostic [message]
    (Diagnostic.init @"jit" message (the (Maybe SourceSpan) (Maybe.Nothing))))

  (private named-f32-function-symbol)
  (hidden named-f32-function-symbol)
  (defn named-f32-function-symbol [backend name]
    (let-do [found (the (Maybe String) (Maybe.Nothing))
             declarations (BackendModule.declarations backend)]
      (for [i 0 (Array.length declarations)]
        (match-ref (Array.unsafe-nth declarations i)
          (BackendDeclaration.Function symbol signature _ _)
            (let-do [rendered (Type.render (Box.peek signature))]
              (match (IO.getenv "CARP_DEBUG_JIT")
                (Maybe.Just _)
                  (IO.errorln
                    &(fmt "jit function candidate: %s %s" symbol &rendered))
                (Maybe.Nothing) ())
              (when (and (String.contains-string? symbol name)
                         (String.= &rendered &(String.copy "(Fn [Float] Float)")))
                (set! found (Maybe.Just (String.copy symbol)))))
          _ ()))
      found))

  (private publish-lowered)
  (hidden publish-lowered)
  (private jit-mark!)
  (hidden jit-mark!)
  (defn jit-mark! [name since]
    (match (IO.getenv "CARP_DEBUG_JIT")
      (Maybe.Just _)
        (IO.errorln
          &(fmt "jit %s: %.1f ms"
                name
                (Double./
                  (Double.from-long
                    (Uint64.to-long (Uint64.- (System.nanotime) since)))
                  1000000.0)))
      (Maybe.Nothing) ()))

  ; Use the compiler from the LLVM installation selected by LLVM.setup.
  ; System clang can produce IR with an incompatible target data layout.
  (defmacro support-clang [] (ForeignLayouts.compiler))

  (private prepare-support)
  (hidden prepare-support)
  (defn prepare-support [js backend input ir serial]
    (match (LLVMBackend.session-support-emission backend
                                                 (JitSession.materialized js))
      (Result.Error error)
        (Result.Error (jit-diagnostic @(BackendError.message &error)))
      (Result.Success emission)
        (if (not
            (JitCBackend.required? ir &emission (JitSession.materialized js)))
          (Result.Success (the (Maybe JitCPrepared) (Maybe.Nothing)))
          (let-do [base (fmt "%s/carp-jit-shim-%d"
                             (JitSession.scratch js)
                             serial)
                   c-path (String.append &base ".c")
                   ir-path (String.append &base ".ll")]
            (match (IO.write-file (CTranslationUnit.source &emission) &c-path)
              (Result.Error error)
                (Result.Error
                  (jit-diagnostic (fmt "cannot write native support: %s" &error)))
              (Result.Success _)
                (if (Int./= 0
                            (System.system
                              &(fmt
                                "%s -S -emit-llvm -fPIC -target %s -o %s %s -I %s %s"
                                (support-clang)
                                (JitSession.triple js)
                                &ir-path
                                &c-path
                                (JitSession.core-dir js)
                                &(String.join " " &(CtEval.collected-cflags)))))
                  (Result.Error (jit-diagnostic @"native support clang failed"))
                  (let [buffer (LLVM.memory-buffer-of-file (String.cstr &ir-path))]
                    (if (LLVM.memory-buffer-null? buffer)
                      (Result.Error
                        (jit-diagnostic @"cannot read native support IR"))
                      (let [mod (LLVM.parse-ir (LLVM.dup (JitSession.context js))
                                               buffer)]
                        (if (LLVM.module-null? mod)
                          (Result.Error
                            (jit-diagnostic @"cannot parse native support IR"))
                          (let-do [symbols (JitCBackend.normalize! mod
                                                                   &emission
                                                                   (JitSession.materialized js))
                                   verify (LLVM.verify-module mod)
                                   bindings (the (Array LLVMArtifactBinding) [])
                                   instances (BackendModule.symbols backend)
                                   entities (the (Array CArtifactEntity) [])]
                            (if (not (String.empty? &verify))
                              (do
                                (LLVM.module-dispose mod)
                                (Result.Error
                                  (jit-diagnostic
                                    (fmt "native support verifier: %s" &verify))))
                              (do
                                (for [i 0 (Array.length instances)]
                                  (let [instance (Array.unsafe-nth instances i)]
                                    (Array.push-back! &bindings
                                                      (LLVMArtifactBinding.init @instance
                                                                                (Array.contains? (BackendModule.resident-symbols backend)
                                                                                                 (Specialization.symbol instance))))))
                                (let [emitted (CTranslationUnit.entities &emission)]
                                  (for [i 0 (Array.length emitted)]
                                    (let [entity (Array.unsafe-nth emitted i)]
                                      (when (Array.contains? &symbols
                                                             (CArtifactEntity.symbol entity))
                                        (Array.push-back! &entities @entity)))))
                                (CTranslationUnit.set-entities! &emission
                                                                entities)
                                (Result.Success
                                  (Maybe.Just
                                    (JitCPrepared.init mod
                                                       (JitCArtifact.init base
                                                                          @(JitSession.context-id js)
                                                                          serial
                                                                          @(JitSession.generation js)
                                                                          (SourceInput.copy input)
                                                                          0
                                                                          emission
                                                                          symbols
                                                                          bindings
                                                                          [])))))))))))))))))

  (private add-module!)
  (hidden add-module!)
  (defn add-module! [js tracker mod]
    (LLVM.orc-add-module-tracked (LLVM.dup (JitSession.jit js))
                                 (LLVM.dup tracker)
                                 (LLVM.orc-thread-safe-module mod
                                                              (LLVM.dup (JitSession.thread-context js)))))

  (private rollback-publication!)
  (hidden rollback-publication!)
  (defn rollback-publication! [tracker message]
    (let [error (LLVM.orc-remove-resources (LLVM.dup tracker))]
      (Result.Error
        (jit-diagnostic
          (if (String.empty? &error)
            (String.copy message)
            (fmt "%s; rollback failed: %s" message &error))))))

  (private publish-prepared!)
  (hidden publish-prepared!)
  (defn publish-prepared! [js
                           input
                           backend
                           instances
                           mod
                           support
                           publication
                           serial
                           cell-name
                           roots-name
                           requested]
    (let-do [artifact-ir (LLVM.print-module mod)
             artifact-entities (LLVMArtifacts.capture backend mod)
             tracker (LLVM.orc-resource-tracker (LLVM.dup (JitSession.dylib js)))
             support-error (match-ref &support
               (Maybe.Nothing) @""
               (Maybe.Just prepared)
                 (add-module! js
                              &tracker
                              (LLVM.dup (JitCPrepared.module prepared))))
             add-error (if (String.empty? &support-error)
               (add-module! js &tracker mod)
               (do (LLVM.module-dispose mod) (String.copy &support-error)))
             result (if (not (String.empty? &add-error))
               (rollback-publication! &tracker
                                      &(fmt "ORC publication: %s" &add-error))
               (let-do [lookup-name (match-ref requested
                          (Maybe.Just name)
                            (match (named-f32-function-symbol backend name)
                              (Maybe.Just symbol) symbol
                              (Maybe.Nothing) @"")
                          (Maybe.Nothing) (String.copy roots-name))
                        address (if (String.empty? &lookup-name)
                          0l
                          (LLVM.orc-lookup (LLVM.dup (JitSession.jit js))
                                           (String.cstr &lookup-name)))]
                 (if (Long.= address 0l)
                   (rollback-publication! &tracker
                                          "requested JIT symbol not found")
                   (let-do [defined (LLVMBackend.defined-symbols backend)]
                     (for [i 0 (Array.length &defined)]
                       (unless (published? js (Array.unsafe-nth &defined i))
                         (Array.push-back! (JitSession.code js)
                                           @(Array.unsafe-nth &defined i))))
                     (Array.push-back! (JitSession.artifacts js)
                                       (JitArtifact.init (String.copy cell-name)
                                                         serial
                                                         @(JitSession.generation js)
                                                         (SourceInput.copy input)
                                                         0
                                                         artifact-entities
                                                         artifact-ir
                                                         (String.copy roots-name)
                                                         address
                                                         []))
                     (match support
                       (Maybe.Nothing) ()
                       (Maybe.Just prepared)
                         (let-do [artifact @(JitCPrepared.artifact &prepared)]
                           (let [symbols (JitCArtifact.symbols &artifact)]
                             (for [i 0 (Array.length symbols)]
                               (Array.push-back! (JitSession.materialized js)
                                                 @(Array.unsafe-nth symbols i))))
                           (Array.push-back! (JitSession.c-artifacts js)
                                             artifact)))
                     (Array.push-back! (JitSession.publications js) publication)
                     (JitSession.set-instances! js (Array.copy instances))
                     (JitSession.set-last-declarations! js
                                                        (Array.length (BackendModule.declarations backend)))
                     (Result.Success address)))))]
      (LLVM.orc-release-resource-tracker tracker)
      result))

  (defn publish-lowered [js input lowered requested]
    (match lowered
      (Result.Error diagnostic) (Result.Error diagnostic)
      (Result.Success incremental)
        (let-do [backend @(IncrementalLowering.module &incremental)
                 predefined (Array.copy (JitSession.code js))
                 instances (IncrementalLowering.instances &incremental)
                 started (System.nanotime)
                 serial @(JitSession.serial js)
                 _reserve (JitSession.set-serial! js (Int.inc serial))
                 ctx (LLVM.dup (JitSession.context js))
                 td (LLVM.dup (JitSession.data js))
                 cell-name (fmt "carp-jit-cell-%d" serial)
                 roots-name (fmt "carp_llvm_roots_%d" serial)
                 init-name (fmt "carp_llvm_init_globals_%d" serial)
                 mod (LLVM.module-create (String.cstr &cell-name) ctx)
                 builder (LLVM.builder-create ctx)]
          ; Include native adapters so implicit capture copies and deletes keep the
          ; ABI of templates materialized by earlier cells.
          (let [native (JitSession.materialized js)]
            (for [i 0 (Array.length native)]
              (Array.push-back! &predefined @(Array.unsafe-nth native i))))
          (LLVM.set-target mod (String.cstr (JitSession.triple js)))
          (LLVM.set-module-data-layout mod td)
          (match (match (ForeignLayouts.query &backend
                                              (JitSession.triple js)
                                              (JitSession.core-dir js)
                                              &(CtEval.collected-cflags)
                                              (JitSession.scratch js)
                                              (JitSession.foreign-layout-cache js))
              (Result.Error message) (Result.Error message)
              (Result.Success cache)
                (do
                  (JitSession.set-foreign-layout-cache! js @&cache)
                  (LLVMBackend.emit-module-incremental-with-layouts ctx
                                                                    builder
                                                                    mod
                                                                    td
                                                                    &backend
                                                                    (ForeignLayoutCache.layouts &cache)
                                                                    &predefined
                                                                    &roots-name
                                                                    &init-name)))
            (Result.Error message)
              (do
                (LLVM.builder-dispose builder)
                (LLVM.module-dispose mod)
                (Result.Error (jit-diagnostic (fmt "llvm backend: %s" &message))))
            (Result.Success _)
              (let-do [publication (NativePublication.init serial
                                                           (LLVMBackend.inspection-environment &backend)
                                                           (LLVMBackend.inspection-closures ctx
                                                                                            td
                                                                                            &backend))
                       _emitted (jit-mark! "emitted" started)
                       _debug (match (IO.getenv "CARP_DEBUG_JIT_IR")
                         (Maybe.Just _) (IO.errorln &(LLVM.print-module mod))
                         (Maybe.Nothing) ())
                       verify (LLVM.verify-module mod)]
                (LLVM.builder-dispose builder)
                (if (not (String.empty? &verify))
                  (do
                    (LLVM.module-dispose mod)
                    (Result.Error
                      (jit-diagnostic (fmt "llvm verifier: %s" &verify))))
                  (match (prepare-support js &backend input mod serial)
                    (Result.Error error)
                      (do (LLVM.module-dispose mod) (Result.Error error))
                    (Result.Success support)
                      (do
                        (jit-mark! "support-ready" started)
                        (let-do [result (publish-prepared! js
                                                           input
                                                           &backend
                                                           instances
                                                           mod
                                                           support
                                                           publication
                                                           serial
                                                           &cell-name
                                                           &roots-name
                                                           requested)]
                          (jit-mark! "published" started)
                          result)))))))))

  (private lower-cell)
  (hidden lower-cell)
  (defn lower-cell [js session input echo]
    (let-do [salt (fmt "jit%d_" @(JitSession.serial js))
             _salt (BackendLower.use-lambda-symbol-salt! &salt)
             _versions (Specialize.use-binding-versions! (JitSession.versions js))
             lowered (Session.lower-cell-with-known-namespaced session
                                                               input
                                                               echo
                                                               (JitSession.instances js)
                                                               &salt)]
      (Specialize.clear-binding-versions!)
      lowered))

  (doc run-cell "checks, lowers, JIT-compiles, and RUNS `input` against the
session: `Session.lower-cell-plain`'s transactional BackendModule is emitted
into a fresh incremental LLVM module, ORC adds only symbols not already
published in the shared LLJIT; C support joins the same publication tracker,
and the roots function executes in-process.
Returns the cell's value: the last integer-typed top-level's result, 0
otherwise.")
  (defn run-cell [js session input]
    (match (publish-lowered js
                            input
                            (lower-cell js session input false)
                            &(the (Maybe String) (Maybe.Nothing)))
      (Result.Success address)
        (let-do [answer (LLVM.call-i32 address)]
          (executed! js address)
          (Result.Success answer))
      (Result.Error diagnostic) (Result.Error diagnostic)))

  (doc run-cell-echoed "as `run-cell`, but with the driver's top-level result
echo: the cell's value is PRINTED to stdout by the same `str` a driver-built
binary would pick, and the returned Int is the echoed roots value (0 — the
echo wrapping consumes the top level).")
  (defn run-cell-echoed [js session input]
    (match (publish-lowered js
                            input
                            (lower-cell js session input true)
                            &(the (Maybe String) (Maybe.Nothing)))
      (Result.Success address)
        (let-do [answer (LLVM.call-i32 address)]
          (executed! js address)
          (Result.Success answer))
      (Result.Error diagnostic) (Result.Error diagnostic)))

  (doc compile-f32-function "checks, lowers, and publishes a transactional
cell, then returns the address of its named `(Fn [Float] Float)` definition.
The cell must make the definition reachable, normally by ending with a dummy
call. Every successful call uses a fresh symbol namespace, so returned
addresses remain valid until reset-code! or disposal.")
  (defn compile-f32-function [js session input name]
    (publish-lowered js
                     input
                     (lower-cell js session input false)
                     &(Maybe.Just (String.copy name))))

  (private invalidated-after)
  (hidden invalidated-after)
  (doc invalidated-after "invalidates published native code once a session
commit has succeeded, answering the commit's own result.")
  (defn invalidated-after [js committed]
    (match committed
      (Result.Error diagnostic) (Result.Error diagnostic)
      (Result.Success answer)
        (let-do [error (reset-code! js)]
          (if (String.empty? &error)
            (Result.Success answer)
            (Result.Error
              (jit-diagnostic
                (fmt "cannot invalidate published code: %s" &error)))))))

  (doc upsert "commits a definition and invalidates published native code.
The LLJIT and shared context remain alive; the next cell republishes the new
definition world.")
  (defn upsert [js session input]
    (invalidated-after js (Session.upsert session input)))

  (doc upsert-input "commits a whole input with however many definitions it
holds, as `Session.upsert-input` does, and invalidates published native code
like `upsert`.")
  (defn upsert-input [js session input]
    (invalidated-after js (Session.upsert-input session input)))

  (doc remove "removes a definition and invalidates published native code,
retaining the LLJIT and shared context.")
  (defn remove [js session name]
    (invalidated-after js (Session.remove session name))))

(defmodule SessionJit
  (doc compile-cell "Publishes a checked cell without running its roots.
The caller may commit a candidate semantic session before calling the returned
address. A preparation failure never executes the cell.")
  (defn compile-cell [js session input echo]
    (publish-lowered js
                     input
                     (lower-cell js session input echo)
                     &(the (Maybe String) (Maybe.Nothing))))

  (doc compile-expanded-cell "publishes already expanded caller syntax
without invoking its macros again. It has the same preparation and ownership
boundaries as compile-cell.")
  (defn compile-expanded-cell [js session sourced]
    (let-do [salt (fmt "jit%d_" @(JitSession.serial js))
             _salt (BackendLower.use-lambda-symbol-salt! &salt)
             _versions (Specialize.use-binding-versions! (JitSession.versions js))
             lowered (Session.lower-expanded-cell-with-known-namespaced session
                                                                        sourced
                                                                        false
                                                                        (JitSession.instances js)
                                                                        &salt)]
      (Specialize.clear-binding-versions!)
      (publish-lowered js
                       (SourcedSurfaceModule.input sourced)
                       lowered
                       &(the (Maybe String) (Maybe.Nothing))))))

(defmodule SessionJit
  (doc value-layout
    "returns a cached layout from the publication that owns a live value.")
  (defn value-layout [js publication type]
    (let-do [key (CAbi.type-key type)
             result (Result.Error @"native publication is no longer live")
             found false
             layouts (JitSession.layouts js)]
      (for [i 0 (Array.length layouts)]
        (let [cached (Array.unsafe-nth layouts i)]
          (when-do (and
              (Int.= publication @(NativeLayoutCache.publication cached))
              (String.= &key (NativeLayoutCache.key cached)))
            (set! found true)
            (set! result (Result.Success @(NativeLayoutCache.layout cached))))))
      (unless-do found
        (let [publications (JitSession.publications js)]
          (for [i 0 (Array.length publications)]
            (let [entry (Array.unsafe-nth publications i)]
              (when (Int.= publication @(NativePublication.serial entry))
                (set! result
                      (LLVMBackend.inspection-layout (LLVM.dup (JitSession.machine js))
                                                     (NativePublication.environment entry)
                                                     type))))))
        (match-ref &result
          (Result.Success layout)
            (Array.push-back! layouts
                              (NativeLayoutCache.init publication key @layout))
          (Result.Error _) ()))
      result))

  (doc closure-layout
    "matches a live callback to its compiler-recorded environment.")
  (defn closure-layout [js callback]
    (let-do [result (the (Maybe NativeClosureLayout) (Maybe.Nothing))
             publications (JitSession.publications js)]
      (for [i 0 (Array.length publications)]
        (let [closures (NativePublication.closures (Array.unsafe-nth publications
                                                                     i))]
          (for [j 0 (Array.length closures)]
            (when (Maybe.nothing? &result)
              (let-do [closure (Array.unsafe-nth closures j)
                       symbol (NativeClosureLayout.symbol closure)
                       address 0l
                       known false
                       callbacks (JitSession.callbacks js)]
                (for [k 0 (Array.length callbacks)]
                  (let [cached (Array.unsafe-nth callbacks k)]
                    (when-do (String.= symbol
                                       (NativeCallbackCache.symbol cached))
                      (set! known true)
                      (set! address @(NativeCallbackCache.address cached)))))
                (unless-do known
                  (set! address
                        (LLVM.orc-lookup (LLVM.dup (JitSession.jit js))
                                         (String.cstr symbol)))
                  (Array.push-back! callbacks
                                    (NativeCallbackCache.init @symbol address)))
                (when (and (Long./= address 0l) (Long.= address callback))
                  (set! result (Maybe.Just @closure))))))))
      result)))
