;; carp-llvm-backend — spike backend: lowers a BackendModule to LLVM IR
;; through the carpentry-org/llvm bindings, leaving verification, JIT
;; execution, and object emission to the caller.
;;
;; Scope (the examples/simple.carp and nominal tiers): concrete functions over
;; Int, Bool, Long, Double, and Unit; if, let, do, set!, while, and break;
;; direct global calls; concrete sum types with constructors and by-value
;; match (nested patterns included); registered intrinsics (declared only —
;; the JIT resolves them from the process, a linked build from an object).
;; Every construct beyond that records an emission error naming itself rather
;; than mis-lowering.
;;
;; Bool lowers to i8 to match the C backend's `bool`, so a mixed C/LLVM link
;; agrees on scalar signatures; conditions compare against zero at branch
;; sites.
;;
;; Sum types mirror the C backend's layout under the module's target data
;; layout: `{ union-rep, i32 tag }` where union-rep is the strictest-aligned
;; variant struct padded with bytes to the union's ABI size, and a nullary
;; variant is `{ i8 }` like the C backend's `unsigned char unused`. Variant
;; access goes through memory — opaque-pointer typed GEPs overlay the active
;; variant struct on the union area — so constructors spill to an alloca and
;; matches read a pre-allocated entry-block spill slot. Layout parity with the
;; host C compiler is asserted by the test against offsetof/sizeof probes.
;;
;; set!-targeted binders get entry-block alloca slots (found by a pre-scan of
;; the body), so mem2reg can promote them; every other binder stays SSA.
;;
;; The helpers live at top level like the C backend's renderers: mutual
;; recursion between defns inside a defmodule loses definitions during
;; emission under the reference compiler, at top level it is reliable.

(load "../carp-backend/carp-backend.carp")
(load "git@github.com:carpentry-org/llvm@0.1.0")
(LLVM.setup)

;; emission errors collected across one emit-module run.
(def *llvm-backend-errors* (the (Array String) []))

;; the SSA environment: parallel arrays of binder id and bound value,
;; innermost last. Lookups scan backwards so shadowing resolves to the
;; nearest binder.
(def *llvm-backend-env-ids* (the (Array Int) []))
(def *llvm-backend-env-values* (the (Array LLVMValue) []))

;; alloca slots for set!-targeted binders, reset per function.
(def *llvm-slot-ids* (the (Array Int) []))
(def *llvm-slot-ptrs* (the (Array LLVMValue) []))

;; the pre-scan's pending slot requests for the function being defined.
(def *llvm-pending-ids* (the (Array Int) []))
(def *llvm-pending-types* (the (Array MonoType) []))

;; break targets, innermost while's exit block last.
(def *llvm-break-blocks* (the (Array LLVMBasicBlock) []))

;; the module's constructor declarations, cached for tag and layout lookups.
(def *llvm-backend-constructors* (the (Array CoreConstructorDeclaration) []))

;; the C-native symbols (templates, source templates, intrinsics) of the
;; module being emitted — calls to them may need the pointer-only ABI wrapper.
(def *llvm-cnative-symbols* (the (Array String) []))

;; non-function header-backed intrinsics (registered C constants like
;; CARP_INT_MAX or errno): referenced through a generated shim getter.
(def *llvm-value-intrinsics* (the (Array String) []))

;; template-dependency functions whose signatures move aggregates: they
;; compile as pointer-only `_carpimpl` definitions (every parameter behind a
;; pointer, result through an out-pointer) and the shim defines the real
;; C-ABI symbol as an adapter — C callers (the templates) get clang's
;; aggregate coercions, LLVM callers use the pointer protocol directly.
(def *llvm-cimpl-symbols* (the (Array String) []))

;; indirect-call signatures that move aggregates: each gets a C invoke helper
;; in the shim performing the env-branched call with clang's ABI.
(def *llvm-invoke-keys* (the (Array String) []))
(def *llvm-invoke-sigs* (the (Array MonoType) []))

;; letrec self-capture fields of the closure construction being emitted.
(def *llvm-selffields* (the (Array Int) []))

;; the module's Function-declaration symbols: only these may be forced into
;; the impl treatment when wrapped as values.
(def *llvm-function-symbols* (the (Array String) []))

; Symbols already published by earlier modules in a persistent JIT. They are
; declarations in the current cell module, never definitions.
(def *llvm-predefined-symbols* (the (Array String) []))

;; every symbol the module itself declares or defines, for spotting calls to
;; preprocessor-provided C functions (register-type accessors ride the
;; verbatim preamble and have no declarations).
(def *llvm-declared-symbols* (the (Array String) []))

;; preprocessor-provided C functions found at call sites: symbol + signature,
;; so aggregate-moving calls get shim wrappers like any C-native callee.
(def *llvm-preproc-syms* (the (Array String) []))
(def *llvm-preproc-sigs* (the (Array MonoType) []))

;; scope-dependent asm macros (`Unsafe.C.asm`): `#define <sym>() __asm__(...)`
;; preamble lines whose expansions reference caller locals by name. Calls
;; route through a generated shim thunk that rebinds those names.
(def *llvm-asm-syms* (the (Array String) []))
(def *llvm-asm-outs* (the (Array (Array String)) []))
(def *llvm-asm-ins* (the (Array (Array String)) []))
(def *llvm-asm-out-types* (the (Array (Array MonoType)) []))
(def *llvm-asm-in-types* (the (Array (Array MonoType)) []))
;; per-call-site operand resolution, keyed by the GlobalCall's id
(def *llvm-asm-call-ids* (the (Array Int) []))
(def *llvm-asm-call-outs* (the (Array (Array Int)) []))
(def *llvm-asm-call-ins* (the (Array (Array Int)) []))
;; closure constructions standing directly as a Let's value: their captures
;; MOVE into the environment (the C backend's recursive-construction path
;; renders `.fi = value` with no copier there)
(def *llvm-letbound-closures* (the (Array Int) []))
;; the prescan's lexical scope (innermost last), for name resolution
(def *llvm-asm-scope-names* (the (Array String) []))
(def *llvm-asm-scope-ids* (the (Array Int) []))
(def *llvm-asm-scope-types* (the (Array MonoType) []))

;; getter-derived external layouts: when a register-returned external type
;; has no reachable init, its field types are recovered from accessor-getter
;; call sites in encounter order (correct whenever the fields share a type;
;; heterogeneous externals normally have a reachable init).
(def *llvm-getterlay-keys* (the (Array String) []))
(def *llvm-getterlay-fields* (the (Array (Array MonoType)) []))
(def *llvm-getterlay-seen* (the (Array String) []))

;; external registered structs (register-type with fields, C-defined): field
;; types recovered from the generated init template's signature, keyed by the
;; type's key. The layout is the plain C struct in declaration order.
(def *llvm-external-keys* (the (Array String) []))
(def *llvm-external-fields* (the (Array (Array MonoType)) []))

;; entry-block spill slots for wrapper-call arguments and returns, keyed by
;; the call expression's id and position (-1 = the return slot).
(def *llvm-argspill-pending-ids* (the (Array Int) []))
(def *llvm-argspill-pending-pos* (the (Array Int) []))
(def *llvm-argspill-pending-types* (the (Array MonoType) []))
(def *llvm-argspill-ids* (the (Array Int) []))
(def *llvm-argspill-pos* (the (Array Int) []))
(def *llvm-argspill-ptrs* (the (Array LLVMValue) []))

;; the module's closure functions, for construction sites and definitions.
(def *llvm-closures* (the (Array ClosureFunction) []))

;; type-key -> deleter/copier C symbols from the ownership plan, for managed
;; captures and environment fields.
(def *llvm-delete-symbols* (the (Array (Pair String String)) []))
(def *llvm-copy-symbols* (the (Array (Pair String String)) []))

;; sum-type layout cache (context-bound, reset per emit-module).
(def *llvm-sum-names* (the (Array String) []))
(def *llvm-sum-types* (the (Array LLVMType) []))

;; the C symbols backing IR-side heap operations. The driver swaps these for
;; the carp_llvm_* shim helpers so CARP_MALLOC/CARP_FREE (and LOG_MEMORY
;; accounting) stay in the loop; the JIT tests keep libc malloc/free.
(def *llvm-malloc-symbol* @"malloc")
(def *llvm-free-symbol* @"free")

;; serial for uniquely naming interned string/pattern literal globals.
(def *llvm-strlit-counter* (the (Array Int) [0]))

;; the target data layout sizing sum types, as a zero-or-one-element array
;; (handles have no default value to give a bare def).
(def *llvm-target-data* (the (Array LLVMTargetData) []))

; Per-emission DWARF state. The source map itself is owned by BackendModule;
; these arrays only cache the DI nodes belonging to the module being emitted.
(def *llvm-line-map* (BackendLineMap.empty))
(def *llvm-di-builders* (the (Array LLVMDIBuilder) []))
(def *llvm-di-file-names* (the (Array String) []))
(def *llvm-di-files* (the (Array LLVMMetadata) []))
(def *llvm-di-units* (the (Array LLVMMetadata) []))
(def *llvm-di-scopes* (the (Array LLVMMetadata) []))
(def *llvm-di-lexical-file-names* (the (Array String) []))
(def *llvm-di-lexical-scopes* (the (Array LLVMMetadata) []))

;; entry-block spill slots for by-value match scrutinees, keyed by the match
;; expression's id: the pre-scan requests them, emit-slots! allocates them.
(def *llvm-matchspill-pending-ids* (the (Array Int) []))
(def *llvm-matchspill-pending-types* (the (Array MonoType) []))
(def *llvm-matchspill-ids* (the (Array Int) []))
(def *llvm-matchspill-ptrs* (the (Array LLVMValue) []))

(hidden llvm-cstr)
(defn llvm-cstr [s] (String.cstr s))

(hidden llvm-debug-enabled?)
(defn llvm-debug-enabled? []
  (Int.> (Array.length (BackendLineMap.lines &*llvm-line-map*)) 0))

(hidden llvm-debug-line)
(defn llvm-debug-line [id]
  (if (and (Int.>= id 0)
           (Int.< id (Array.length (BackendLineMap.lines &*llvm-line-map*))))
    @(Array.unsafe-nth (BackendLineMap.lines &*llvm-line-map*) id)
    -1))

(hidden llvm-debug-column)
(defn llvm-debug-column [id]
  (if (and (Int.>= id 0)
           (Int.< id (Array.length (BackendLineMap.columns &*llvm-line-map*))))
    @(Array.unsafe-nth (BackendLineMap.columns &*llvm-line-map*) id)
    0))

(hidden llvm-debug-file-name)
(defn llvm-debug-file-name [id]
  (if (and (Int.>= id 0)
           (Int.< id (Array.length (BackendLineMap.files &*llvm-line-map*))))
    (String.copy (Array.unsafe-nth (BackendLineMap.files &*llvm-line-map*) id))
    @""))

(hidden llvm-debug-file-index)
(defn llvm-debug-file-index [name]
  (let-do [found -1]
    (for [i 0 (Array.length &*llvm-di-file-names*)]
      (when (String.= (Array.unsafe-nth &*llvm-di-file-names* i) name)
        (set! found i)))
    found))

(hidden llvm-debug-file!)
(defn llvm-debug-file! [name]
  (let-do [known (llvm-debug-file-index name)]
    (if (Int.>= known 0)
      known
      (let-do [dib (LLVM.dup (Array.unsafe-nth &*llvm-di-builders* 0))
               file (LLVM.di-file dib (llvm-cstr name) (llvm-cstr &@"."))
               unit (LLVM.di-compile-unit dib file (llvm-cstr &@"metacarp"))]
        (Array.push-back! &*llvm-di-file-names* (String.copy name))
        (Array.push-back! &*llvm-di-files* file)
        (Array.push-back! &*llvm-di-units* unit)
        (Int.dec (Array.length &*llvm-di-file-names*))))))

(hidden llvm-debug-location)
(defn llvm-debug-location [ctx id]
  (let-do [line (llvm-debug-line id)
           name (llvm-debug-file-name id)]
    (if (and (Int.> line 0) (not (String.empty? &name)))
      (let-do [_file-index (llvm-debug-file! &name)
               lexical-index -1]
        (for [i 0 (Array.length &*llvm-di-lexical-file-names*)]
          (when (String.=
              (Array.unsafe-nth &*llvm-di-lexical-file-names* i)
              &name)
            (set! lexical-index i)))
        (let [scope (if (Int.> (Array.length &*llvm-di-scopes*) 0)
                (if (Int.>= lexical-index 0)
                  (LLVM.dup
                    (Array.unsafe-nth &*llvm-di-lexical-scopes* lexical-index))
                  (let-do [dib (LLVM.dup (Array.unsafe-nth &*llvm-di-builders* 0))
                           lexical (LLVM.di-lexical-block-file dib
                                                               (LLVM.dup (Array.unsafe-nth &*llvm-di-scopes*
                                                                                           0))
                                                               (LLVM.dup
                                                                 (Array.unsafe-nth &*llvm-di-files*
                                                                                   _file-index))
                                                               0)]
                    (Array.push-back! &*llvm-di-lexical-file-names*
                                      (String.copy &name))
                    (Array.push-back! &*llvm-di-lexical-scopes* lexical)
                    (LLVM.dup &lexical)))
                (LLVM.dup (Array.unsafe-nth &*llvm-di-units* _file-index)))]
          (Maybe.Just
            (LLVM.debug-location ctx line (llvm-debug-column id) scope))))
      (the (Maybe LLVMMetadata) (Maybe.Nothing)))))

(hidden llvm-debug-enter-function!)
(defn llvm-debug-enter-function! [ctx func symbol body]
  (do
    (set! *llvm-di-scopes* [])
    (set! *llvm-di-lexical-file-names* [])
    (set! *llvm-di-lexical-scopes* [])
    (when-do (llvm-debug-enabled?)
      (let-do [id (Specialize.expression-id body)
               line (llvm-debug-line id)
               name (llvm-debug-file-name id)]
        (when-do (and (Int.> line 0) (not (String.empty? &name)))
          (let-do [index (llvm-debug-file! &name)
                   dib (LLVM.dup (Array.unsafe-nth &*llvm-di-builders* 0))
                   file (LLVM.dup (Array.unsafe-nth &*llvm-di-files* index))
                   unit (LLVM.dup (Array.unsafe-nth &*llvm-di-units* index))
                   subty (LLVM.di-subroutine-type dib
                                                  file
                                                  &(the (Array LLVMMetadata) []))
                   scope (LLVM.di-function dib
                                           unit
                                           (llvm-cstr symbol)
                                           file
                                           line
                                           subty)]
            (LLVM.set-subprogram func scope)
            (set! *llvm-di-scopes* [scope])))))))

(hidden llvm-debug-set-builder!)
(defn llvm-debug-set-builder! [ctx builder expression]
  (if (llvm-debug-enabled?)
    (match (llvm-debug-location ctx (Specialize.expression-id expression))
      (Maybe.Just location) (LLVM.set-debug-location builder location)
      (Maybe.Nothing) (LLVM.clear-debug-location builder))
    (LLVM.clear-debug-location builder)))

(hidden llvm-debug-attach!)
(defn llvm-debug-attach! [ctx value expression]
  (when-do (and (llvm-debug-enabled?) (LLVM.instruction? value))
    (match (llvm-debug-location ctx (Specialize.expression-id expression))
      (Maybe.Just location) (LLVM.set-instruction-debug-location value location)
      (Maybe.Nothing) ())))

(hidden llvm-debug-begin!)
(defn llvm-debug-begin! [ctx mod line-map]
  (do
    (set! *llvm-line-map* (BackendLineMap.copy line-map))
    (set! *llvm-di-builders* [])
    (set! *llvm-di-file-names* [])
    (set! *llvm-di-files* [])
    (set! *llvm-di-units* [])
    (set! *llvm-di-scopes* [])
    (set! *llvm-di-lexical-file-names* [])
    (set! *llvm-di-lexical-scopes* [])
    (when-do (llvm-debug-enabled?)
      (let-do [dib (LLVM.di-builder-create mod)
               version (LLVM.value-as-metadata
                 (LLVM.const-int (LLVM.int32-type ctx) 3l 0))]
        (set! *llvm-di-builders* [dib])
        (LLVM.add-module-flag mod
                              LLVM.behavior-warning
                              (llvm-cstr &@"Debug Info Version")
                              version)))))

(hidden llvm-debug-finish!)
(defn llvm-debug-finish! []
  (when-do (Int.> (Array.length &*llvm-di-builders*) 0)
    (let-do [dib (LLVM.dup (Array.unsafe-nth &*llvm-di-builders* 0))]
      (LLVM.di-finalize dib)
      (LLVM.di-builder-dispose dib)
      (set! *llvm-di-builders* []))))

(hidden llvm-predefined?)
(defn llvm-predefined? [symbol]
  (let-do [found false]
    (for [i 0 (Array.length &*llvm-predefined-symbols*)]
      (when (String.= (Array.unsafe-nth &*llvm-predefined-symbols* i) symbol)
        (set! found true)))
    found))

(hidden llvm-emit-error!)
(defn llvm-emit-error! [message]
  (Array.push-back! &*llvm-backend-errors* message))

(hidden llvm-env-reset!)
(defn llvm-env-reset! []
  (do (set! *llvm-backend-env-ids* []) (set! *llvm-backend-env-values* [])))

(hidden llvm-env-push!)
(defn llvm-env-push! [id value]
  (do
    (Array.push-back! &*llvm-backend-env-ids* id)
    (Array.push-back! &*llvm-backend-env-values* value)))

(hidden llvm-env-pop!)
(defn llvm-env-pop! []
  (do
    (ignore (Array.pop-back! &*llvm-backend-env-ids*))
    (ignore (Array.pop-back! &*llvm-backend-env-values*))))

(hidden llvm-dummy-value)
(defn llvm-dummy-value [ctx] (LLVM.const-int (LLVM.int32-type ctx) 0l 0))

(hidden llvm-env-lookup)
(defn llvm-env-lookup [ctx id name]
  (let-do [found (llvm-dummy-value ctx)
           hit false
           i (Int.dec (Array.length &*llvm-backend-env-ids*))]
    (while-do (Int.>= i 0)
      (when-do (Int.= @(Array.unsafe-nth &*llvm-backend-env-ids* i) id)
        (set! found (LLVM.dup (Array.unsafe-nth &*llvm-backend-env-values* i)))
        (set! hit true)
        (set! i 0))
      (set! i (Int.dec i)))
    (unless hit (llvm-emit-error! (fmt "unbound local %s in llvm backend" name)))
    found))

(hidden llvm-slot-reset!)
(defn llvm-slot-reset! []
  (do (set! *llvm-slot-ids* []) (set! *llvm-slot-ptrs* [])))

(hidden llvm-slot-add!)
(defn llvm-slot-add! [id pointer]
  (do
    (Array.push-back! &*llvm-slot-ids* id)
    (Array.push-back! &*llvm-slot-ptrs* pointer)))

(hidden llvm-slot-index)
(defn llvm-slot-index [id]
  (let-do [found -1]
    (for [i 0 (Array.length &*llvm-slot-ids*)]
      (when (Int.= @(Array.unsafe-nth &*llvm-slot-ids* i) id) (set! found i)))
    found))

(hidden llvm-slot-ptr)
(defn llvm-slot-ptr [index]
  (LLVM.dup (Array.unsafe-nth &*llvm-slot-ptrs* index)))

(hidden llvm-pending-reset!)
(defn llvm-pending-reset! []
  (do
    (set! *llvm-pending-ids* [])
    (set! *llvm-pending-types* [])
    (set! *llvm-asm-scope-names* [])
    (set! *llvm-asm-scope-ids* [])
    (set! *llvm-asm-scope-types* [])
    (set! *llvm-letbound-closures* [])
    (set! *llvm-matchspill-pending-ids* [])
    (set! *llvm-matchspill-pending-types* [])
    (set! *llvm-matchspill-ids* [])
    (set! *llvm-matchspill-ptrs* [])
    (set! *llvm-argspill-pending-ids* [])
    (set! *llvm-argspill-pending-pos* [])
    (set! *llvm-argspill-pending-types* [])
    (set! *llvm-argspill-ids* [])
    (set! *llvm-argspill-pos* [])
    (set! *llvm-argspill-ptrs* [])))

(hidden llvm-pending-add!)
(defn llvm-pending-add! [id type]
  (let-do [known false]
    (for [i 0 (Array.length &*llvm-pending-ids*)]
      (when (Int.= @(Array.unsafe-nth &*llvm-pending-ids* i) id)
        (set! known true)))
    (unless-do (or known (unit-type? &type))
      (Array.push-back! &*llvm-pending-ids* id)
      (Array.push-back! &*llvm-pending-types* type))))

(hidden llvm-matchspill-add!)
(defn llvm-matchspill-add! [id type]
  (let-do [known false]
    (for [i 0 (Array.length &*llvm-matchspill-pending-ids*)]
      (when (Int.= @(Array.unsafe-nth &*llvm-matchspill-pending-ids* i) id)
        (set! known true)))
    (unless-do known
      (Array.push-back! &*llvm-matchspill-pending-ids* id)
      (Array.push-back! &*llvm-matchspill-pending-types* type))))

(hidden llvm-matchspill-index)
(defn llvm-matchspill-index [id]
  (let-do [found -1]
    (for [i 0 (Array.length &*llvm-matchspill-ids*)]
      (when (Int.= @(Array.unsafe-nth &*llvm-matchspill-ids* i) id)
        (set! found i)))
    found))

(hidden llvm-matchspill-ptr)
(defn llvm-matchspill-ptr [index]
  (LLVM.dup (Array.unsafe-nth &*llvm-matchspill-ptrs* index)))

(hidden llvm-argspill-add!)
(defn llvm-argspill-add! [id pos type]
  (let-do [known false]
    (for [i 0 (Array.length &*llvm-argspill-pending-ids*)]
      (when (and
          (Int.= @(Array.unsafe-nth &*llvm-argspill-pending-ids* i) id)
          (Int.= @(Array.unsafe-nth &*llvm-argspill-pending-pos* i) pos))
        (set! known true)))
    (unless-do (or known (unit-type? &type))
      (Array.push-back! &*llvm-argspill-pending-ids* id)
      (Array.push-back! &*llvm-argspill-pending-pos* pos)
      (Array.push-back! &*llvm-argspill-pending-types* type))))

(hidden llvm-argspill-index)
(defn llvm-argspill-index [id pos]
  (let-do [found -1]
    (for [i 0 (Array.length &*llvm-argspill-ids*)]
      (when (and
          (Int.= @(Array.unsafe-nth &*llvm-argspill-ids* i) id)
          (Int.= @(Array.unsafe-nth &*llvm-argspill-pos* i) pos))
        (set! found i)))
    found))

(hidden llvm-argspill-ptr)
(defn llvm-argspill-ptr [index]
  (LLVM.dup (Array.unsafe-nth &*llvm-argspill-ptrs* index)))

(doc llvm-collect-external-layout! "records an external struct's field types
when a source template's signature looks like its generated init: it returns
the named type and takes neither the type nor a reference to it. The
candidate with the most arguments wins (init carries every field).")
(hidden llvm-collect-external-layout!)
(defn llvm-collect-external-layout! [signature]
  (match-ref signature
    (MonoType.Function fargs fret)
      (match-ref (Box.peek fret)
        (MonoType.Named _ _)
          (let-do [key (CAbi.type-key (Box.peek fret))
                   self-free true]
            (for [i 0 (Array.length fargs)]
              (let-do [arg (Box.peek (Array.unsafe-nth fargs i))]
                (when (String.= &(CAbi.type-key arg) &key)
                  (set! self-free false))
                (match-ref arg
                  (MonoType.Reference inner _)
                    (when (String.= &(CAbi.type-key (Box.peek inner)) &key)
                      (set! self-free false))
                  _ ())))
            (when self-free
              (let-do [existing -1]
                (for [i 0 (Array.length &*llvm-external-keys*)]
                  (when (String.=
                      (Array.unsafe-nth &*llvm-external-keys* i)
                      &key)
                    (set! existing i)))
                (let-do [fields (the (Array MonoType) [])]
                  (for [i 0 (Array.length fargs)]
                    (Array.push-back! &fields
                                      (MonoType.copy (Box.peek (Array.unsafe-nth fargs
                                                                                 i)))))
                  (if (Int.< existing 0)
                    (do
                      (Array.push-back! &*llvm-external-keys* (String.copy &key))
                      (Array.push-back! &*llvm-external-fields* fields))
                    (when (Int.> (Array.length &fields)
                                 (Array.length
                                   (Array.unsafe-nth &*llvm-external-fields*
                                                     existing)))
                      (Array.aset! &*llvm-external-fields* existing fields)))))))
        _ ())
    _ ()))

(doc llvm-intercepted-builtin? "whether a call site is one the emitter
lowers inline (builtins by id, closure constructions, the array-free
sentinel) — such a call never becomes a symbol reference.")
(hidden llvm-intercepted-builtin?)
(defn llvm-intercepted-builtin? [reference symbol]
  (let [id @(CoreRef.id reference)]
    (or
      (String.starts-with? symbol "_carp_closure_")
      (or (String.= symbol "__carp_array_free")
          (or (Int.= id 5)
              (or (Int.= id 6)
                  (or (Int.= id 9)
                      (or (Int.= id 10)
                          (or (Int.= id 12)
                              (or (Int.= id 13)
                                  (or (Int.= id 14)
                                      (or (Int.= id 15)
                                          (or (Int.= id 16)
                                              (or (Int.= id 17)
                                                  (or (Int.= id 18)
                                                      (or (Int.= id 21)
                                                          (or (Int.= id 48)
                                                              (or (Int.= id 49)
                                                                  (or (Int.= id
                                                                             73)
                                                                      (or (Int.= id
                                                                                 74)
                                                                          (or (Int.= id
                                                                                     75)
                                                                              (or (Int.= id
                                                                                         65)
                                                                                  (Int.= id
                                                                                         70)))))))))))))))))))))))

(doc llvm-collect-init-calls! "walks a body recording external layouts from
`.init`-shaped call sites: a registered type's fields are the init's argument
types, and with register-type accessors arriving as raw preprocessor text the
call signature is the only structured copy of them.")
(hidden llvm-collect-init-calls!)
(defn llvm-collect-init-calls! [expression]
  (match-ref expression
    (SpecializedExpr.GlobalValue _ value-type _ _ symbol lambda-var)
    ;; a function wrapped as a value whose signature moves aggregates must
    ;; compile impl-style: its C-side adapter becomes the stored callback
    (when (and (not @lambda-var)
               (and
                 (match-ref (Box.peek value-type)
                   (MonoType.Function _ _) true
                   _ false)
                 (llvm-needs-wrapper? (Box.peek value-type))))
      (let-do [is-function false]
        (for [i 0 (Array.length &*llvm-function-symbols*)]
          (when (String.= (Array.unsafe-nth &*llvm-function-symbols* i) symbol)
            (set! is-function true)))
        (when (and is-function (not (llvm-cimpl? symbol)))
          (Array.push-back! &*llvm-cimpl-symbols* (String.copy symbol)))))
    (SpecializedExpr.GlobalCall _ _ reference callee-signature symbol arguments)
    (do
      (when (Int.>= (String.index-of-string symbol "_x46_init__") 0)
        (llvm-collect-external-layout! (Box.peek callee-signature)))
      ;; a call to a symbol nothing declares (or that only a builtin-style
      ;; declaration covers, like register-type accessors riding the
      ;; preprocessor channel) is a C function; inline-lowered builtins are
      ;; not calls at all
      (unless (llvm-intercepted-builtin? reference symbol)
        (let-do [known false]
          (for [i 0 (Array.length &*llvm-declared-symbols*)]
            (when (String.= (Array.unsafe-nth &*llvm-declared-symbols* i) symbol)
              (set! known true)))
          (for [i 0 (Array.length &*llvm-preproc-syms*)]
            (when (String.= (Array.unsafe-nth &*llvm-preproc-syms* i) symbol)
              (set! known true)))
          (unless-do known
            (Array.push-back! &*llvm-preproc-syms* (String.copy symbol))
            (Array.push-back! &*llvm-preproc-sigs*
                              (MonoType.copy (Box.peek callee-signature))))
          (llvm-record-getter-layout! symbol (Box.peek callee-signature))))
      (for [i 0 (Array.length arguments)]
        (llvm-collect-init-calls! (Box.peek (Array.unsafe-nth arguments i)))))
    (SpecializedExpr.Call _ _ callee arguments)
    (do
      (llvm-collect-init-calls! (Box.peek callee))
      (for [i 0 (Array.length arguments)]
        (llvm-collect-init-calls! (Box.peek (Array.unsafe-nth arguments i)))))
    (SpecializedExpr.Do _ _ elements)
    (for [i 0 (Array.length elements)]
      (llvm-collect-init-calls! (Box.peek (Array.unsafe-nth elements i))))
    (SpecializedExpr.If _ _ condition then else)
    (do
      (llvm-collect-init-calls! (Box.peek condition))
      (llvm-collect-init-calls! (Box.peek then))
      (llvm-collect-init-calls! (Box.peek else)))
    (SpecializedExpr.Let _ _ _ value body)
    (do
      (llvm-collect-init-calls! (Box.peek value))
      (llvm-collect-init-calls! (Box.peek body)))
    (SpecializedExpr.While _ _ condition body)
    (do
      (llvm-collect-init-calls! (Box.peek condition))
      (llvm-collect-init-calls! (Box.peek body)))
    (SpecializedExpr.Set _ _ _ value)
    (llvm-collect-init-calls! (Box.peek value))
    (SpecializedExpr.Match _ _ _ scrutinee branches)
    (do
      (llvm-collect-init-calls! (Box.peek scrutinee))
      (for [i 0 (Array.length branches)]
        (llvm-collect-init-calls!
          (Box.peek (SpecializedMatchBranch.body (Array.unsafe-nth branches i))))))
    (SpecializedExpr.Annotation _ _ inner _)
    (llvm-collect-init-calls! (Box.peek inner))
    (SpecializedExpr.ArrayLit _ _ elements)
    (for [i 0 (Array.length elements)]
      (llvm-collect-init-calls! (Box.peek (Array.unsafe-nth elements i))))
    (SpecializedExpr.StaticArrayLit _ _ elements)
    (for [i 0 (Array.length elements)]
      (llvm-collect-init-calls! (Box.peek (Array.unsafe-nth elements i))))
    (SpecializedExpr.Lambda _ _ _ body)
    (llvm-collect-init-calls! (Box.peek body))
    _
    ()))

(doc llvm-record-getter-layout! "records one accessor-getter call
(`(Ref T) -> (Ref F)`) as a field of T's getter-derived layout, deduplicated
by accessor symbol.")
(hidden llvm-record-getter-layout!)
(defn llvm-record-getter-layout! [symbol signature]
  (match-ref signature
    (MonoType.Function fargs fret)
      (when (Int.= 1 (Array.length fargs))
        (match-ref (Box.peek (Array.unsafe-nth fargs 0))
          (MonoType.Reference self-inner _)
            (match-ref (Box.peek fret)
              (MonoType.Reference field-inner _)
                (match-ref (Box.peek self-inner)
                  (MonoType.Named _ _)
                    (let-do [key (CAbi.type-key (Box.peek self-inner))
                             seen false]
                      (for [i 0 (Array.length &*llvm-getterlay-seen*)]
                        (when (String.=
                            (Array.unsafe-nth &*llvm-getterlay-seen* i)
                            symbol)
                          (set! seen true)))
                      (unless-do seen
                        (Array.push-back! &*llvm-getterlay-seen*
                                          (String.copy symbol))
                        (let-do [existing -1]
                          (for [i 0 (Array.length &*llvm-getterlay-keys*)]
                            (when (String.=
                                (Array.unsafe-nth &*llvm-getterlay-keys* i)
                                &key)
                              (set! existing i)))
                          (if (Int.< existing 0)
                            (do
                              (Array.push-back! &*llvm-getterlay-keys*
                                                (String.copy &key))
                              (Array.push-back! &*llvm-getterlay-fields*
                                                [(MonoType.copy (Box.peek field-inner))]))
                            (let-do [fields @(Array.unsafe-nth &*llvm-getterlay-fields*
                                                               existing)]
                              (Array.push-back! &fields
                                                (MonoType.copy (Box.peek field-inner)))
                              (Array.aset! &*llvm-getterlay-fields*
                                           existing
                                           fields))))))
                  _ ())
              _ ())
          _ ()))
    _ ()))

(hidden llvm-external-index)
(defn llvm-external-index [key]
  (let-do [found -1]
    (for [i 0 (Array.length &*llvm-external-keys*)]
      (when (String.= (Array.unsafe-nth &*llvm-external-keys* i) key)
        (set! found i)))
    found))

(hidden llvm-getterlay-index)
(defn llvm-getterlay-index [key]
  (let-do [found -1]
    (for [i 0 (Array.length &*llvm-getterlay-keys*)]
      (when (String.= (Array.unsafe-nth &*llvm-getterlay-keys* i) key)
        (set! found i)))
    found))

(hidden llvm-value-intrinsic?)
(defn llvm-value-intrinsic? [symbol]
  (let-do [found false]
    (for [i 0 (Array.length &*llvm-value-intrinsics*)]
      (when (String.= (Array.unsafe-nth &*llvm-value-intrinsics* i) symbol)
        (set! found true)))
    found))

(hidden llvm-cimpl?)
(defn llvm-cimpl? [symbol]
  (let-do [found false]
    (for [i 0 (Array.length &*llvm-cimpl-symbols*)]
      (when (String.= (Array.unsafe-nth &*llvm-cimpl-symbols* i) symbol)
        (set! found true)))
    found))

(doc llvm-protocol-target "the pointer-protocol entry for a symbol: its
`_carpimpl` when the function lives LLVM-side, else its shim `_carpabi`
wrapper.")
(hidden llvm-protocol-target)
(defn llvm-protocol-target [symbol]
  (if (llvm-cimpl? symbol) (fmt "%s_carpimpl" symbol) (fmt "%s_carpabi" symbol)))

(hidden llvm-cnative?)
(defn llvm-cnative? [symbol]
  (let-do [found false]
    (for [i 0 (Array.length &*llvm-cnative-symbols*)]
      (when (String.= (Array.unsafe-nth &*llvm-cnative-symbols* i) symbol)
        (set! found true)))
    found))

(doc llvm-preproc? "whether `symbol` rode the preprocessor channel — no
declaration covers it, so only the C compiler can resolve it (it may be a
function-like macro), and every call must go through a shim wrapper.")
(hidden llvm-preproc?)
(defn llvm-preproc? [symbol]
  (let-do [found false]
    (for [i 0 (Array.length &*llvm-preproc-syms*)]
      (when (String.= (Array.unsafe-nth &*llvm-preproc-syms* i) symbol)
        (set! found true)))
    found))

(hidden llvm-asm-index)
(defn llvm-asm-index [symbol]
  (let-do [found -1]
    (for [i 0 (Array.length &*llvm-asm-syms*)]
      (when (String.= (Array.unsafe-nth &*llvm-asm-syms* i) symbol)
        (set! found i)))
    found))

(doc llvm-asm-sections "splits an `__asm__` operand list on top-level `:`,
outside string literals and parentheses.")
(hidden llvm-asm-sections)
(defn llvm-asm-sections [text]
  (let-do [sections (the (Array String) [])
           n (String.length text)
           start 0
           depth 0
           quoted false
           i 0]
    (while (Int.< i n)
      (let-do [c (Char.to-int (String.char-at text i))]
        (cond
          quoted
            (do
              (when (Int.= c 92) (set! i (Int.inc i)))
              (when (Int.= c 34) (set! quoted false)))
          (Int.= c 34) (set! quoted true)
          (Int.= c 40) (set! depth (Int.inc depth))
          (Int.= c 41) (set! depth (Int.dec depth))
          (and (Int.= c 58) (Int.= depth 0))
            (do
              (Array.push-back! &sections (String.slice text start i))
              (set! start (Int.inc i)))
          ())
        (set! i (Int.inc i))))
    (Array.push-back! &sections (String.slice text start n))
    sections))

(doc llvm-asm-operand-names "the parenthesized identifiers of one asm operand
section, in order (`\"=r\" (dst), \"r\" (src)` yields dst, src).")
(hidden llvm-asm-operand-names)
(defn llvm-asm-operand-names [section]
  (let-do [names (the (Array String) [])
           n (String.length section)
           quoted false
           i 0]
    (while (Int.< i n)
      (let-do [c (Char.to-int (String.char-at section i))]
        (cond
          quoted
            (do
              (when (Int.= c 92) (set! i (Int.inc i)))
              (when (Int.= c 34) (set! quoted false)))
          (Int.= c 34) (set! quoted true)
          (Int.= c 40)
            (let-do [j (Int.inc i)]
              (while (and (Int.< j n)
                          (not
                            (Int.= 41 (Char.to-int (String.char-at section j)))))
                (set! j (Int.inc j)))
              (let-do [a (Int.inc i)
                       b j]
                (while (and (Int.< a b)
                            (Int.= 32 (Char.to-int (String.char-at section a))))
                  (set! a (Int.inc a)))
                (while (and (Int.< a b)
                            (Int.= 32
                                   (Char.to-int (String.char-at section
                                                                (Int.dec b)))))
                  (set! b (Int.dec b)))
                (Array.push-back! &names (String.slice section a b)))
              (set! i j))
          ())
        (set! i (Int.inc i))))
    names))

(doc llvm-scan-asm-defines! "records every function-like `#define <sym>()
__asm__(...)` preamble line: its symbol and its output and input operand
names, so calls can be routed through a scope-rebinding shim thunk.")
(hidden llvm-scan-asm-defines!)
(defn llvm-scan-asm-defines! [includes]
  (for [i 0 (Array.length includes)]
    (let [line (Array.unsafe-nth includes i)]
      (when (and (String.starts-with? line "#define ")
                 (Int.>= (String.index-of-string line "__asm__(") 0))
        (let-do [open (String.index-of-string line "(")
                 asm-at (String.index-of-string line "__asm__(")
                 sym (String.slice line 8 open)
                 body-start (Int.+ asm-at 8)
                 body-end (Int.dec (String.length line))]
          ;; only a zero-parameter macro can be thunked
          (when-do (String.starts-with? &(String.slice line open (Int.+ open 2))
                                        "()")
            (while (and (Int.> body-end body-start)
                        (not
                          (Int.= 41 (Char.to-int (String.char-at line body-end)))))
              (set! body-end (Int.dec body-end)))
            (let-do [sections (llvm-asm-sections &(String.slice line
                                                                body-start
                                                                body-end))
                     outs (if (Int.> (Array.length &sections) 1)
                       (llvm-asm-operand-names (Array.unsafe-nth &sections 1))
                       (the (Array String) []))
                     ins (if (Int.> (Array.length &sections) 2)
                       (llvm-asm-operand-names (Array.unsafe-nth &sections 2))
                       (the (Array String) []))]
              (when-do (Int.< (llvm-asm-index &sym) 0)
                (Array.push-back! &*llvm-asm-syms* @&sym)
                (Array.push-back! &*llvm-asm-outs* outs)
                (Array.push-back! &*llvm-asm-ins* ins)
                (Array.push-back! &*llvm-asm-out-types*
                                  (the (Array MonoType) []))
                (Array.push-back! &*llvm-asm-in-types* (the (Array MonoType) []))))))))))

(doc llvm-asm-scope-index "the innermost scope entry binding `name`, -1 when
unbound.")
(hidden llvm-asm-scope-index)
(defn llvm-asm-scope-index [name]
  (let-do [found -1
           i (Int.dec (Array.length &*llvm-asm-scope-names*))]
    (while-do (and (Int.>= i 0) (Int.< found 0))
      (when (String.= (Array.unsafe-nth &*llvm-asm-scope-names* i) name)
        (set! found i))
      (set! i (Int.dec i)))
    found))

(doc llvm-asm-record-call! "resolves one asm-macro call site's operand names
against the prescan scope, forces slots for the operands, and records the
binder ids (and, once per symbol, the operand types for the shim thunk).")
(hidden llvm-asm-record-call!)
(defn llvm-asm-record-call! [call-id ai]
  (let-do [out-ids (the (Array Int) [])
           in-ids (the (Array Int) [])
           out-types (the (Array MonoType) [])
           in-types (the (Array MonoType) [])
           ok true]
    (for [i 0 (Array.length (Array.unsafe-nth &*llvm-asm-outs* ai))]
      (let [si (llvm-asm-scope-index
              (Array.unsafe-nth (Array.unsafe-nth &*llvm-asm-outs* ai) i))]
        (if (Int.< si 0)
          (set! ok false)
          (do
            (Array.push-back! &out-ids
                              @(Array.unsafe-nth &*llvm-asm-scope-ids* si))
            (Array.push-back! &out-types
                              (MonoType.copy
                                (Array.unsafe-nth &*llvm-asm-scope-types* si)))
            (llvm-pending-add!
              @(Array.unsafe-nth &*llvm-asm-scope-ids* si)
              (MonoType.copy (Array.unsafe-nth &*llvm-asm-scope-types* si)))))))
    (for [i 0 (Array.length (Array.unsafe-nth &*llvm-asm-ins* ai))]
      (let [si (llvm-asm-scope-index
              (Array.unsafe-nth (Array.unsafe-nth &*llvm-asm-ins* ai) i))]
        (if (Int.< si 0)
          (set! ok false)
          (do
            (Array.push-back! &in-ids
                              @(Array.unsafe-nth &*llvm-asm-scope-ids* si))
            (Array.push-back! &in-types
                              (MonoType.copy
                                (Array.unsafe-nth &*llvm-asm-scope-types* si)))
            (llvm-pending-add!
              @(Array.unsafe-nth &*llvm-asm-scope-ids* si)
              (MonoType.copy (Array.unsafe-nth &*llvm-asm-scope-types* si)))))))
    (if (not ok)
      (llvm-emit-error!
        (fmt
          "asm macro %s references names outside the local scope in llvm backend"
          (Array.unsafe-nth &*llvm-asm-syms* ai)))
      (do
        (Array.push-back! &*llvm-asm-call-ids* call-id)
        (Array.push-back! &*llvm-asm-call-outs* out-ids)
        (Array.push-back! &*llvm-asm-call-ins* in-ids)
        (when-do (and
            (Int.= 0 (Array.length (Array.unsafe-nth &*llvm-asm-out-types* ai)))
            (Int.= 0 (Array.length (Array.unsafe-nth &*llvm-asm-in-types* ai))))
          (Array.aset! &*llvm-asm-out-types* ai out-types)
          (Array.aset! &*llvm-asm-in-types* ai in-types))))))

(doc llvm-lambda-type "the runtime Lambda struct `{ callback, env, delete,
copy }` — every function value shares it.")
(hidden llvm-lambda-type)
(defn llvm-lambda-type [ctx]
  (LLVM.struct-type ctx
                    &[(LLVM.pointer-type (LLVM.int8-type ctx) 0)
                      (LLVM.pointer-type (LLVM.int8-type ctx) 0)
                      (LLVM.pointer-type (LLVM.int8-type ctx) 0)
                      (LLVM.pointer-type (LLVM.int8-type ctx) 0)]
                    false))

(hidden llvm-closure-index)
(defn llvm-closure-index [symbol]
  (let-do [found -1]
    (for [i 0 (Array.length &*llvm-closures*)]
      (when (String.=
          (ClosureFunction.symbol (Array.unsafe-nth &*llvm-closures* i))
          symbol)
        (set! found i)))
    found))

(hidden llvm-managed-symbol)
(defn llvm-managed-symbol [pairs type]
  (let-do [result (the (Maybe String) (Maybe.Nothing))
           key (CAbi.type-key type)]
    (for [i 0 (Array.length pairs)]
      (let [entry (Array.unsafe-nth pairs i)]
        (when (String.= (Pair.a entry) &key)
          (set! result (Maybe.Just (String.copy (Pair.b entry)))))))
    result))

(doc llvm-named-fn "get-named-function with the name String kept alive
across the call — `(llvm-cstr &(fmt ...))` hands LLVM a pointer into a
temporary that can be freed first.")
(hidden llvm-named-fn)
(defn llvm-named-fn [mod name] (LLVM.get-named-function mod (String.cstr name)))

(hidden llvm-add-fn)
(defn llvm-add-fn [mod name fnty]
  (LLVM.add-function mod (String.cstr name) fnty))

(hidden llvm-add-global-named)
(defn llvm-add-global-named [mod ty name]
  (LLVM.add-global mod ty (String.cstr name)))

(hidden llvm-struct-named)
(defn llvm-struct-named [ctx name]
  (LLVM.struct-create-named ctx (String.cstr name)))

(doc llvm-runtime-fn "the named function, declared with `fnty` on first use.")
(hidden llvm-runtime-fn)
(defn llvm-runtime-fn [mod name fnty]
  (let [found (LLVM.get-named-function mod (llvm-cstr name))]
    (if (LLVM.value-null? found)
      (LLVM.add-function mod (llvm-cstr name) fnty)
      found)))

(hidden llvm-target-data)
(defn llvm-target-data [] (LLVM.dup (Array.unsafe-nth &*llvm-target-data* 0)))

(doc llvm-collect-set-targets! "walks a lowered body recording every set!
target binder (with the assigned type) so its slot can be alloca'd in the
entry block before emission, and every by-value match scrutinee so its spill
slot can be alloca'd there too. Unit-typed set! targets get no slot.")
(hidden llvm-collect-set-targets!)
(defn llvm-collect-set-targets! [expression]
  (match-ref expression
    (SpecializedExpr.GlobalCall id _ reference callee-signature symbol arguments)
    (do
      ;; a wrapper call passes every argument and the return through
      ;; entry-block slots
      (when (or (llvm-cimpl? symbol)
                (and (llvm-cnative? symbol)
                     (llvm-needs-wrapper? (Box.peek callee-signature))))
        (match-ref (Box.peek callee-signature)
          (MonoType.Function fargs fret)
            (do
              (for [i 0 (Array.length fargs)]
                (llvm-argspill-add! @id
                                    i
                                    (MonoType.copy (Box.peek (Array.unsafe-nth fargs
                                                                               i)))))
              (unless (unit-type? (Box.peek fret))
                (llvm-argspill-add! @id -1 (MonoType.copy (Box.peek fret)))))
          _ ()))
      ;; an aggregate managed capture is deep-copied through the pointer
      ;; protocol, which needs a slot holding the field pointer
      (when (String.starts-with? symbol "_carp_closure_")
        (for [i 0 (Array.length arguments)]
          (let [t (Specialize.expression-type
                  (Box.peek (Array.unsafe-nth arguments i)))]
            (when (and (llvm-aggregate-monotype? &t)
                       (match (llvm-managed-symbol &*llvm-copy-symbols* &t)
                         (Maybe.Just _) true
                         (Maybe.Nothing) false))
              (llvm-argspill-add! @id i (Type.reference t (MonoLifetime.Static)))))))
      ;; a call to a scope-dependent asm macro: resolve its operand names
      ;; against the enclosing scope and force slots for them
      (let [ai (llvm-asm-index symbol)]
        (when (Int.>= ai 0) (llvm-asm-record-call! @id ai)))
      ;; the `ref` builtin (id 5) needs an addressable operand: a local gets
      ;; a slot, a temporary gets a spill slot keyed by this call's id
      (when (and (Int.= 5 @(CoreRef.id reference))
                 (Int.= 1 (Array.length arguments)))
        (match-ref (Box.peek (Array.unsafe-nth arguments 0))
          (SpecializedExpr.Reference _ type target)
            (unless @(CoreRef.global target)
              (llvm-pending-add! @(CoreRef.id target)
                                 (MonoType.copy (Box.peek type))))
          _
            (llvm-matchspill-add! @id
                                  (Specialize.expression-type
                                    (Box.peek (Array.unsafe-nth arguments 0))))))
      (for [i 0 (Array.length arguments)]
        (llvm-collect-set-targets! (Box.peek (Array.unsafe-nth arguments i)))))
    (SpecializedExpr.GlobalValue id value-type _ _ symbol _)
    ;; an aggregate C constant reads through the getter's out-pointer, which
    ;; needs an entry-block slot
    (when (and (llvm-value-intrinsic? symbol)
               (llvm-aggregate-monotype? (Box.peek value-type)))
      (llvm-matchspill-add! @id (MonoType.copy (Box.peek value-type))))
    (SpecializedExpr.Call id _ callee arguments)
    (do
      ;; an aggregate-moving indirect call spills its arguments and result
      ;; for the shim's invoke helper
      (match (Specialize.expression-type (Box.peek callee))
        (MonoType.Function fargs fret)
          (when-do (llvm-needs-wrapper?
              &(Type.function (Array.copy &fargs)
                              (MonoType.copy (Box.peek &fret))))
            (llvm-register-invoke!
              &(Type.function (Array.copy &fargs)
                              (MonoType.copy (Box.peek &fret))))
            (for [i 0 (Array.length &fargs)]
              (llvm-argspill-add! @id
                                  i
                                  (MonoType.copy (Box.peek (Array.unsafe-nth &fargs
                                                                             i)))))
            (unless (unit-type? (Box.peek &fret))
              (llvm-argspill-add! @id -1 (MonoType.copy (Box.peek &fret)))))
        _ ())
      (llvm-collect-set-targets! (Box.peek callee))
      (for [i 0 (Array.length arguments)]
        (llvm-collect-set-targets! (Box.peek (Array.unsafe-nth arguments i)))))
    (SpecializedExpr.Do _ _ elements)
    (for [i 0 (Array.length elements)]
      (llvm-collect-set-targets! (Box.peek (Array.unsafe-nth elements i))))
    (SpecializedExpr.If _ _ condition then else)
    (do
      (llvm-collect-set-targets! (Box.peek condition))
      (llvm-collect-set-targets! (Box.peek then))
      (llvm-collect-set-targets! (Box.peek else)))
    (SpecializedExpr.Let _ _ binder value body)
    (do
      (match-ref (Box.peek value)
        (SpecializedExpr.GlobalCall value-id _ _ _ symbol _)
          (when (String.starts-with? symbol "_carp_closure_")
            (Array.push-back! &*llvm-letbound-closures* @value-id))
        _ ())
      (llvm-collect-set-targets! (Box.peek value))
      (Array.push-back! &*llvm-asm-scope-names* @(CoreRef.name binder))
      (Array.push-back! &*llvm-asm-scope-ids* @(CoreRef.id binder))
      (Array.push-back! &*llvm-asm-scope-types*
                        (Specialize.expression-type (Box.peek value)))
      (llvm-collect-set-targets! (Box.peek body))
      (ignore (Array.pop-back! &*llvm-asm-scope-names*))
      (ignore (Array.pop-back! &*llvm-asm-scope-ids*))
      (ignore (Array.pop-back! &*llvm-asm-scope-types*)))
    (SpecializedExpr.While _ _ condition body)
    (do
      (llvm-collect-set-targets! (Box.peek condition))
      (llvm-collect-set-targets! (Box.peek body)))
    (SpecializedExpr.Set _ _ target value)
    (do
      (unless @(CoreRef.global target)
        (llvm-pending-add! @(CoreRef.id target)
                           (Specialize.expression-type (Box.peek value))))
      (llvm-collect-set-targets! (Box.peek value)))
    (SpecializedExpr.Match id _ by-reference scrutinee branches)
    (do
      (unless @by-reference
        (llvm-matchspill-add! @id
                              (Specialize.expression-type (Box.peek scrutinee))))
      (llvm-collect-set-targets! (Box.peek scrutinee))
      (for [i 0 (Array.length branches)]
        (llvm-collect-set-targets!
          (Box.peek (SpecializedMatchBranch.body (Array.unsafe-nth branches i))))))
    (SpecializedExpr.Annotation _ _ inner _)
    (llvm-collect-set-targets! (Box.peek inner))
    (SpecializedExpr.ArrayLit _ _ elements)
    (for [i 0 (Array.length elements)]
      (llvm-collect-set-targets! (Box.peek (Array.unsafe-nth elements i))))
    (SpecializedExpr.StaticArrayLit _ _ elements)
    (for [i 0 (Array.length elements)]
      (llvm-collect-set-targets! (Box.peek (Array.unsafe-nth elements i))))
    (SpecializedExpr.Lambda _ _ _ body)
    (llvm-collect-set-targets! (Box.peek body))
    _
    ()))

(doc llvm-monotype-of-coretype-with "a constructor field's concrete type:
the declared CoreType with the instance's variable bindings substituted.")
(hidden llvm-monotype-of-coretype-with)
(defn llvm-monotype-of-coretype-with [names types type]
  (match-ref type
    (CoreType.Integer) (Type.integer)
    (CoreType.Boolean) (Type.boolean)
    (CoreType.String) (Type.string)
    (CoreType.Unit) (Type.unit)
    (CoreType.Variable vname)
      (let-do [result (the (Maybe MonoType) (Maybe.Nothing))]
        (for [i 0 (Array.length names)]
          (when (String.= (Array.unsafe-nth names i) vname)
            (set! result (Maybe.Just (MonoType.copy (Array.unsafe-nth types i))))))
        (match result
          (Maybe.Just concrete) concrete
          (Maybe.Nothing)
            (do
              (llvm-emit-error!
                (fmt "unbound type variable %s in llvm backend" vname))
              (Type.integer))))
    (CoreType.Named name arguments)
      (let-do [lowered (the (Array (Box MonoType)) [])]
        (for [i 0 (Array.length arguments)]
          (Array.push-back! &lowered
                            (Box.init
                              (llvm-monotype-of-coretype-with names
                                                              types
                                                              (Box.peek (Array.unsafe-nth arguments
                                                                                          i))))))
        (Type.named name lowered))
    (CoreType.Reference inner _)
      (Type.reference
        (llvm-monotype-of-coretype-with names types (Box.peek inner))
        (MonoLifetime.Static))
    (CoreType.Function arguments result)
      (let-do [lowered (the (Array (Box MonoType)) [])]
        (for [i 0 (Array.length arguments)]
          (Array.push-back! &lowered
                            (Box.init
                              (llvm-monotype-of-coretype-with names
                                                              types
                                                              (Box.peek (Array.unsafe-nth arguments
                                                                                          i))))))
        (Type.function lowered
                       (llvm-monotype-of-coretype-with names
                                                       types
                                                       (Box.peek result))))
    _
      (do
        (llvm-emit-error! @"unsupported constructor field type in llvm backend")
        (Type.integer))))

(doc llvm-instance-bindings! "fills `names`/`types` with the variable bindings
that specialize a constructor's declared result to the concrete `instance`.
False when the shapes do not line up.")
(hidden llvm-instance-bindings!)
(defn llvm-instance-bindings! [decl instance names types]
  (match-ref (Box.peek (CoreConstructorDeclaration.result decl))
    (CoreType.Named _ vars)
      (match-ref instance
        (MonoType.Named _ concrete)
          (if (Int./= (Array.length vars) (Array.length concrete))
            false
            (let-do [ok true]
              (for [i 0 (Array.length vars)]
                (match-ref (Box.peek (Array.unsafe-nth vars i))
                  (CoreType.Variable vname)
                    (do
                      (Array.push-back! names (String.copy vname))
                      (Array.push-back! types
                                        (MonoType.copy (Box.peek (Array.unsafe-nth concrete
                                                                                   i)))))
                  _ (set! ok false)))
              ok))
        _ false)
    _ false))

(hidden llvm-sum-variant-of?)
(defn llvm-sum-variant-of? [decl name]
  (match-ref (Box.peek (CoreConstructorDeclaration.result decl))
    (CoreType.Named result-name _) (String.= result-name name)
    _ false))

(hidden llvm-sum-cache-index)
(defn llvm-sum-cache-index [key]
  (let-do [found -1]
    (for [i 0 (Array.length &*llvm-sum-names*)]
      (when (String.= (Array.unsafe-nth &*llvm-sum-names* i) key) (set! found i)))
    found))

(doc llvm-array-type "the runtime Array struct `{ size_t len, size_t
capacity, void* data }` — every (Array t) instance shares it.")
(hidden llvm-array-type)
(defn llvm-array-type [ctx]
  (LLVM.struct-type ctx
                    &[(LLVM.int64-type ctx)
                      (LLVM.int64-type ctx)
                      (LLVM.pointer-type (LLVM.int8-type ctx) 0)]
                    false))

(doc llvm-aggregate-monotype? "whether a type lowers to a struct, which C
passes by its own ABI coercions — such a value must cross the LLVM/C boundary
through a pointer-only wrapper.")
(hidden llvm-aggregate-monotype?)
(defn llvm-aggregate-monotype? [type]
  (match-ref type
    (MonoType.Function _ _) true
    (MonoType.Named name _)
      (cond
        (String.= name "Long") false
        (String.= name "Byte") false
        (String.= name "Char") false
        (String.= name "Double") false
        (String.= name "Float") false
        (String.= name "Ptr") false
        (String.= name "Box") false
        (String.= name "Uint8") false
        (String.= name "Uint16") false
        (String.= name "Uint32") false
        (String.= name "Uint64") false
        (String.= name "Int8") false
        (String.= name "Int16") false
        (String.= name "Int32") false
        (String.= name "Int64") false
        (String.= name "CChar") false
        (String.= name "Pattern") false
        true)
    _ false))

(hidden llvm-needs-wrapper?)
(defn llvm-needs-wrapper? [signature]
  (match-ref signature
    (MonoType.Function fargs fret)
      (let-do [needs (llvm-aggregate-monotype? (Box.peek fret))]
        (for [i 0 (Array.length fargs)]
          (when (llvm-aggregate-monotype? (Box.peek (Array.unsafe-nth fargs i)))
            (set! needs true)))
        needs)
    _ false))

;; llvm-lower-type <-> llvm-sum-type-for <-> llvm-build-sum-type <->
;; llvm-variant-struct are mutually recursive (a variant field can be another
;; sum type).
(defn llvm-lower-type [ctx type]
  (match-ref type
    (MonoType.Integer) (LLVM.int32-type ctx)
    (MonoType.Boolean) (LLVM.int8-type ctx)
    (MonoType.Unit) (LLVM.void-type ctx)
    (MonoType.String) (LLVM.pointer-type (LLVM.int8-type ctx) 0)
    (MonoType.Reference _ _) (LLVM.pointer-type (LLVM.int8-type ctx) 0)
    (MonoType.Function _ _) (llvm-lambda-type ctx)
    (MonoType.Named name arguments)
      (cond
        (String.= name "Long") (LLVM.int64-type ctx)
        (String.= name "Byte") (LLVM.int8-type ctx)
        (String.= name "Char") (LLVM.int32-type ctx)
        (String.= name "Double") (LLVM.double-type ctx)
        (String.= name "Float") (LLVM.float-type ctx)
        (String.= name "Uint8") (LLVM.int8-type ctx)
        (String.= name "Uint16") (LLVM.int16-type ctx)
        (String.= name "Uint32") (LLVM.int32-type ctx)
        (String.= name "Uint64") (LLVM.int64-type ctx)
        (String.= name "Int8") (LLVM.int8-type ctx)
        (String.= name "Int16") (LLVM.int16-type ctx)
        (String.= name "Int32") (LLVM.int32-type ctx)
        (String.= name "Int64") (LLVM.int64-type ctx)
        (String.= name "CChar") (LLVM.int8-type ctx)
        (String.= name "Pattern") (LLVM.pointer-type (LLVM.int8-type ctx) 0)
        (String.= name "Array") (llvm-array-type ctx)
        (String.= name "StaticArray") (llvm-array-type ctx)
        (String.= name "Ptr") (LLVM.pointer-type (LLVM.int8-type ctx) 0)
        (String.= name "Box") (LLVM.pointer-type (LLVM.int8-type ctx) 0)
        (llvm-sum-type-for ctx type))
    _
      (do
        (llvm-emit-error! @"unsupported type form in llvm backend")
        (LLVM.int32-type ctx))))

(defn llvm-sum-type-for [ctx instance]
  (let [cached (llvm-sum-cache-index &(CAbi.type-key instance))]
    (if (Int.>= cached 0)
      (LLVM.dup (Array.unsafe-nth &*llvm-sum-types* cached))
      (llvm-build-sum-type ctx instance))))

(hidden llvm-sum-variant-count)
(defn llvm-sum-variant-count [name]
  (let-do [count 0]
    (for [i 0 (Array.length &*llvm-backend-constructors*)]
      (when (llvm-sum-variant-of?
          (Array.unsafe-nth &*llvm-backend-constructors* i)
          name)
        (set! count (Int.+ count 1))))
    count))

(hidden llvm-instance-name)
(defn llvm-instance-name [instance]
  (match-ref instance (MonoType.Named name _) (String.copy name) _ @""))

(defn llvm-variant-struct [ctx instance tag]
  (let-do [fields (the (Array LLVMType) [])
           found false
           name (llvm-instance-name instance)]
    (for [i 0 (Array.length &*llvm-backend-constructors*)]
      (let [decl (Array.unsafe-nth &*llvm-backend-constructors* i)]
        (when (and (llvm-sum-variant-of? decl &name)
                   (Int.= @(CoreConstructorDeclaration.tag decl) tag))
          (let-do [names (the (Array String) [])
                   types (the (Array MonoType) [])]
            (set! found true)
            (if (llvm-instance-bindings! decl instance &names &types)
              (let [arguments (CoreConstructorDeclaration.arguments decl)]
                (for [j 0 (Array.length arguments)]
                  ;; a unit member has no storage, like the C backend's elision
                  (let [mt (llvm-monotype-of-coretype-with &names
                                                           &types
                                                           (Box.peek (Array.unsafe-nth arguments
                                                                                       j)))]
                    (unless (unit-type? &mt)
                      (Array.push-back! &fields (llvm-lower-type ctx &mt))))))
              (llvm-emit-error!
                (fmt
                  "constructor instance mismatch for %s in llvm backend"
                  &name)))))))
    (unless found
      (llvm-emit-error!
        (fmt "missing tag %d constructor for type %s in llvm backend" tag &name)))
    ;; a nullary variant is `{ i8 }` like the C backend's `unsigned char unused`
    (when (Int.= 0 (Array.length &fields))
      (Array.push-back! &fields (LLVM.int8-type ctx)))
    (LLVM.struct-type ctx &fields false)))

(hidden llvm-round-up)
(defn llvm-round-up [value align]
  (Long.* (Long./ (Long.+ value (Long.- align 1l)) align) align))

(doc llvm-build-sum-type "builds the C-parity layout `{ union-rep, i32 tag }`:
union-rep is the strictest-aligned variant struct padded with bytes up to the
union's ABI size (max variant size rounded to max variant alignment), so tag
offset and total size match the C backend's `struct { union {...} data; int
tag; }` under the same data layout.")
(defn llvm-build-sum-type [ctx instance]
  (let-do [key (CAbi.type-key instance)
           name (llvm-instance-name instance)
           outer (llvm-struct-named ctx &(CAbi.identifier &key))
           variant-count 0]
    ;; cache before building the body so a recursive occurrence resolves
    (Array.push-back! &*llvm-sum-names* (String.copy &key))
    (Array.push-back! &*llvm-sum-types* outer)
    (for [i 0 (Array.length &*llvm-backend-constructors*)]
      (when (llvm-sum-variant-of?
          (Array.unsafe-nth &*llvm-backend-constructors* i)
          &name)
        (set! variant-count (Int.+ variant-count 1))))
    (if (or (Int.= 0 variant-count) (Int.= 0 (Array.length &*llvm-target-data*)))
      (do
        (if (Int.= 0 variant-count)
          ;; an external registered struct: the plain C struct of its
          ;; recovered field types, in declaration order
          (let-do [ei (llvm-external-index &key)
                   gi (if (Int.>= ei 0) -1 (llvm-getterlay-index &key))]
            (if (and (Int.< ei 0) (Int.< gi 0))
              ;; a representation-string register-type with no recoverable
              ;; fields: a pointer-sized opaque slot. Every C crossing is
              ;; pointer-mediated, so only the storage size matters, and a
              ;; smaller representation just leaves slack in the slot.
              (LLVM.struct-set-body outer
                                    &[(LLVM.pointer-type (LLVM.int8-type ctx) 0)]
                                    false)
              (let-do [fields (the (Array LLVMType) [])
                       montypes (if (Int.>= ei 0)
                         (Array.unsafe-nth &*llvm-external-fields* ei)
                         (Array.unsafe-nth &*llvm-getterlay-fields* gi))]
                (for [i 0 (Array.length montypes)]
                  (Array.push-back! &fields
                                    (llvm-lower-type ctx
                                                     (Array.unsafe-nth montypes
                                                                       i))))
                ;; a representation-string register-type (e.g. "void*") shows
                ;; no fields at all: treat it as a pointer-sized opaque
                (when (Int.= 0 (Array.length &fields))
                  (Array.push-back! &fields
                                    (LLVM.pointer-type (LLVM.int8-type ctx) 0)))
                (LLVM.struct-set-body outer &fields false))))
          (llvm-emit-error!
            (fmt "no target data for type %s in llvm backend" &name)))
        outer)
      (let-do [td (llvm-target-data)
               variants (the (Array LLVMType) [])
               union-size 0l
               union-align 1l
               strictest 0]
        (for [tag 0 variant-count]
          (Array.push-back! &variants (llvm-variant-struct ctx instance tag)))
        (for [tag 0 variant-count]
          (let-do [variant (LLVM.dup (Array.unsafe-nth &variants tag))
                   size (LLVM.abi-size-of-type td variant)
                   align (Long.from-int (LLVM.abi-alignment-of-type td variant))]
            (when (Long.> size union-size) (set! union-size size))
            (when-do (Long.> align union-align)
              (set! union-align align)
              (set! strictest tag))))
        (set! union-size (llvm-round-up union-size union-align))
        (let-do [carrier (LLVM.dup (Array.unsafe-nth &variants strictest))
                 pad (Long.- union-size (LLVM.abi-size-of-type td carrier))
                 union-members (the (Array LLVMType) [carrier])]
          (when (Long.> pad 0l)
            (Array.push-back! &union-members
                              (LLVM.array-type (LLVM.int8-type ctx)
                                               (Long.to-int pad))))
          ;; a single-variant type (a product) carries no tag, like the C
          ;; backend's struct without the `int tag` member
          (let [union-rep (LLVM.struct-type ctx &union-members false)]
            (if (Int.= 1 variant-count)
              (LLVM.struct-set-body outer &[union-rep] false)
              (LLVM.struct-set-body outer
                                    &[union-rep (LLVM.int32-type ctx)]
                                    false)))
          outer)))))

(hidden llvm-ctor-index)
(defn llvm-ctor-index [reference]
  (let-do [found -1]
    (for [i 0 (Array.length &*llvm-backend-constructors*)]
      (let [decl (Array.unsafe-nth &*llvm-backend-constructors* i)]
        (when (Int.=
            @(CoreRef.id (CoreConstructorDeclaration.reference decl))
            @(CoreRef.id reference))
          (set! found i))))
    (when (Int.< found 0)
      (llvm-emit-error!
        (fmt "unknown constructor %s in llvm backend" (CoreRef.name reference))))
    found))

(doc llvm-ctor-index-for "the constructor a pattern names: by reference id
first, else type-directed — an ambiguous bare pattern name (two sumtypes
sharing a constructor name under `use`) is picked by the scrutinee's concrete
type and the unqualified name, like the C backend's constructor-for-pattern.")
(hidden llvm-ctor-index-for)
(defn llvm-ctor-index-for [reference instance]
  (let-do [found -1]
    (for [i 0 (Array.length &*llvm-backend-constructors*)]
      (let [decl (Array.unsafe-nth &*llvm-backend-constructors* i)]
        (when (Int.=
            @(CoreRef.id (CoreConstructorDeclaration.reference decl))
            @(CoreRef.id reference))
          (set! found i))))
    (when (Int.< found 0)
      (let [want (unqualified-suffix (CoreRef.name reference))
            subject-name (llvm-instance-name instance)]
        (for [i 0 (Array.length &*llvm-backend-constructors*)]
          (let [decl (Array.unsafe-nth &*llvm-backend-constructors* i)]
            (when (and
                (llvm-sum-variant-of? decl &subject-name)
                (String.=
                  &(unqualified-suffix
                    (CoreRef.name (CoreConstructorDeclaration.reference decl)))
                  &want))
              (set! found i))))))
    (when (Int.< found 0)
      (llvm-emit-error!
        (fmt "unknown constructor %s in llvm backend" (CoreRef.name reference))))
    found))

(hidden llvm-ctor-tag-at)
(defn llvm-ctor-tag-at [index]
  @(CoreConstructorDeclaration.tag
    (Array.unsafe-nth &*llvm-backend-constructors* index)))

(doc llvm-ctor-field-monotype "the concrete type of one constructor field
under the given instance.")
(hidden llvm-ctor-field-monotype)
(defn llvm-ctor-field-monotype [index instance field]
  (let-do [names (the (Array String) [])
           types (the (Array MonoType) [])]
    (if (llvm-instance-bindings!
        (Array.unsafe-nth &*llvm-backend-constructors* index)
        instance
        &names
        &types)
      (llvm-monotype-of-coretype-with &names
                                      &types
                                      (Box.peek
                                        (Array.unsafe-nth
                                          (CoreConstructorDeclaration.arguments
                                            (Array.unsafe-nth &*llvm-backend-constructors*
                                                              index))
                                          field)))
      (do
        (llvm-emit-error! @"constructor instance mismatch in llvm backend")
        (Type.integer)))))

(doc llvm-ctor-adjusted-index "the struct index of one constructor field
after unit-member elision: the count of non-unit fields before it.")
(hidden llvm-ctor-adjusted-index)
(defn llvm-ctor-adjusted-index [index instance field]
  (let-do [adjusted 0]
    (for [j 0 field]
      (unless (unit-type? &(llvm-ctor-field-monotype index instance j))
        (set! adjusted (Int.inc adjusted))))
    adjusted))

(doc llvm-ctor-index-of-tag "the registry index of the constructor with
`tag` for `instance`, -1 when absent.")
(hidden llvm-ctor-index-of-tag)
(defn llvm-ctor-index-of-tag [instance tag]
  (let-do [found -1
           name (llvm-instance-name instance)]
    (for [i 0 (Array.length &*llvm-backend-constructors*)]
      (let [decl (Array.unsafe-nth &*llvm-backend-constructors* i)]
        (when (and (llvm-sum-variant-of? decl &name)
                   (Int.= @(CoreConstructorDeclaration.tag decl) tag))
          (set! found i))))
    found))

(hidden llvm-lower-function-type)
(defn llvm-lower-function-type [ctx signature]
  (match-ref signature
    (MonoType.Function arguments ret)
      (let-do [parameter-types (the (Array LLVMType) [])]
        (for [i 0 (Array.length arguments)]
          ;; unit parameters are elided, like the C backend's rendering
          (unless (unit-type? (Box.peek (Array.unsafe-nth arguments i)))
            (Array.push-back! &parameter-types
                              (llvm-lower-type ctx
                                               (Box.peek (Array.unsafe-nth arguments
                                                                           i))))))
        (LLVM.function-type (llvm-lower-type ctx (Box.peek ret))
                            &parameter-types
                            false))
    _
      (do
        (llvm-emit-error! @"declaration without a function type in llvm backend")
        (LLVM.function-type (LLVM.int32-type ctx)
                            &(the (Array LLVMType) [])
                            false))))

(doc llvm-impl-fn-type "the pointer-only shape of a `_carpimpl` definition:
every parameter behind a pointer, a non-unit result through a trailing
out-pointer, returning void.")
(hidden llvm-impl-fn-type)
(defn llvm-impl-fn-type [ctx signature]
  (match-ref signature
    (MonoType.Function fargs fret)
      (let-do [params (the (Array LLVMType) [])]
        (for [i 0 (Array.length fargs)]
          ;; unit parameters are elided, like the C adapter's
          (unless (unit-type? (Box.peek (Array.unsafe-nth fargs i)))
            (Array.push-back! &params (LLVM.pointer-type (LLVM.int8-type ctx) 0))))
        (unless (unit-type? (Box.peek fret))
          (Array.push-back! &params (LLVM.pointer-type (LLVM.int8-type ctx) 0)))
        (LLVM.function-type (LLVM.void-type ctx) &params false))
    _ (LLVM.function-type (LLVM.void-type ctx) &(the (Array LLVMType) []) false)))

(hidden llvm-returns-unit?)
(defn llvm-returns-unit? [signature]
  (match-ref signature
    (MonoType.Function _ ret) (unit-type? (Box.peek ret))
    _ false))

(hidden llvm-unsupported-name)
(defn llvm-unsupported-name [expression]
  (match-ref expression
    (SpecializedExpr.Lambda _ _ _ _) @"lambda"
    _ @"expression"))

(hidden llvm-void-fn-type)
(defn llvm-void-fn-type [ctx]
  (LLVM.function-type (LLVM.void-type ctx) &(the (Array LLVMType) []) false))

(hidden llvm-declare-abort!)
(defn llvm-declare-abort! [ctx mod]
  (when (LLVM.value-null? (LLVM.get-named-function mod (llvm-cstr &@"abort")))
    (ignore
      (LLVM.add-function mod (llvm-cstr &@"abort") (llvm-void-fn-type ctx)))))

(doc llvm-emit-pattern-test "an i1 saying whether the value behind `ptr`
matches `pattern`. Loads run unconditionally and are and-ed — reading an
inactive variant's bytes is defined, and a false outer tag test makes the
whole conjunction false regardless.")
(hidden llvm-emit-pattern-test)
(defn llvm-emit-pattern-test [ctx builder pattern ptr instance]
  (match-ref pattern
    (CorePattern.Ignore) (LLVM.const-int (LLVM.int1-type ctx) 1l 0)
    (CorePattern.Bind _) (LLVM.const-int (LLVM.int1-type ctx) 1l 0)
    (CorePattern.Constructor reference subpatterns)
      (let [index (llvm-ctor-index-for reference instance)]
        (if (Int.< index 0)
          (LLVM.const-int (LLVM.int1-type ctx) 0l 0)
          (let-do [tag (llvm-ctor-tag-at index)
                   outer-ty (llvm-sum-type-for ctx instance)
                   variant-ty (llvm-variant-struct ctx instance tag)
                   test (if (Int.= 1
                                   (llvm-sum-variant-count &(llvm-instance-name instance)))
                     (LLVM.const-int (LLVM.int1-type ctx) 1l 0)
                     (LLVM.build-icmp builder
                                      LLVM.int-eq
                                      (LLVM.build-load builder
                                                       (LLVM.int32-type ctx)
                                                       (LLVM.build-struct-gep builder
                                                                              outer-ty
                                                                              ptr
                                                                              1
                                                                              (llvm-cstr &@"tagp"))
                                                       (llvm-cstr &@"tag"))
                                      (LLVM.const-int (LLVM.int32-type ctx)
                                                      (Long.from-int tag)
                                                      0)
                                      (llvm-cstr &@"tageq")))
                   unionp (LLVM.build-struct-gep builder
                                                 outer-ty
                                                 ptr
                                                 0
                                                 (llvm-cstr &@"unionp"))]
            (for [i 0 (Array.length subpatterns)]
              ;; a unit member has no storage and no constructors to test
              (unless (unit-type? &(llvm-ctor-field-monotype index instance i))
                (set! test
                      (LLVM.build-and builder
                                      test
                                      (llvm-emit-pattern-test ctx
                                                              builder
                                                              (Box.peek (Array.unsafe-nth subpatterns
                                                                                          i))
                                                              (LLVM.build-struct-gep builder
                                                                                     variant-ty
                                                                                     unionp
                                                                                     (llvm-ctor-adjusted-index index
                                                                                                               instance
                                                                                                               i)
                                                                                     (llvm-cstr &@"fieldp"))
                                                              &(llvm-ctor-field-monotype index
                                                                                         instance
                                                                                         i))
                                      (llvm-cstr &@"and")))))
            test)))))

(doc llvm-bind-pattern! "binds the pattern's binders to the matching pieces
behind `ptr` (slot store for mutated binders, SSA push otherwise) and returns
how many SSA pushes must be popped after the branch body. A by-value match
loads the piece; a by-ref match binds the field pointer itself, the C
backend's `int* f0 = &(...).member_0`.")
(hidden llvm-bind-pattern!)
(defn llvm-bind-pattern! [ctx builder pattern ptr instance by-ref]
  (match-ref pattern
    (CorePattern.Ignore) 0
    (CorePattern.Bind reference)
      (let [id @(CoreRef.id reference)
            si (llvm-slot-index id)
            value (if by-ref
              ptr
              (LLVM.build-load builder
                               (llvm-lower-type ctx instance)
                               ptr
                               (llvm-cstr &@"bindload")))]
        (if (Int.>= si 0)
          (do (ignore (LLVM.build-store builder value (llvm-slot-ptr si))) 0)
          (do (llvm-env-push! id value) 1)))
    (CorePattern.Constructor reference subpatterns)
      (let [index (llvm-ctor-index-for reference instance)]
        (if (Int.< index 0)
          0
          (let-do [tag (llvm-ctor-tag-at index)
                   outer-ty (llvm-sum-type-for ctx instance)
                   variant-ty (llvm-variant-struct ctx instance tag)
                   unionp (LLVM.build-struct-gep builder
                                                 outer-ty
                                                 ptr
                                                 0
                                                 (llvm-cstr &@"bunionp"))
                   pushed 0]
            (for [i 0 (Array.length subpatterns)]
              ;; a unit member has no storage: a binder gets a dummy value
              (if (unit-type? &(llvm-ctor-field-monotype index instance i))
                (match-ref (Box.peek (Array.unsafe-nth subpatterns i))
                  (CorePattern.Bind reference)
                    (do
                      (llvm-env-push! @(CoreRef.id reference)
                                      (llvm-dummy-value ctx))
                      (set! pushed (Int.inc pushed)))
                  _ ())
                (set! pushed
                      (Int.+ pushed
                             (llvm-bind-pattern! ctx
                                                 builder
                                                 (Box.peek (Array.unsafe-nth subpatterns
                                                                             i))
                                                 (LLVM.build-struct-gep builder
                                                                        variant-ty
                                                                        unionp
                                                                        (llvm-ctor-adjusted-index index
                                                                                                  instance
                                                                                                  i)
                                                                        (llvm-cstr &@"bfieldp"))
                                                 &(llvm-ctor-field-monotype index
                                                                            instance
                                                                            i)
                                                 by-ref)))))
            pushed)))))

(doc llvm-deref-monotype "the concrete type behind a reference-typed
expression (or the expression's own type when it is not a reference).")
(hidden llvm-deref-monotype)
(defn llvm-deref-monotype [expression]
  (match (Specialize.expression-type expression)
    (MonoType.Reference inner _) (MonoType.copy (Box.peek &inner))
    other other))

(hidden llvm-invoke-key)
(defn llvm-invoke-key [signature] (CAbi.identifier &(CAbi.type-key signature)))

(hidden llvm-register-invoke!)
(defn llvm-register-invoke! [signature]
  (let-do [key (llvm-invoke-key signature)
           known false]
    (for [i 0 (Array.length &*llvm-invoke-keys*)]
      (when (String.= (Array.unsafe-nth &*llvm-invoke-keys* i) &key)
        (set! known true)))
    (unless-do known
      (Array.push-back! &*llvm-invoke-keys* (String.copy &key))
      (Array.push-back! &*llvm-invoke-sigs* (MonoType.copy signature)))))

(hidden llvm-match-scrutinee-ok?)
(defn llvm-match-scrutinee-ok? [scrutinee]
  (match (Specialize.expression-type scrutinee)
    (MonoType.Named _ _) true
    _ false))

(hidden llvm-closure-env-type)
(defn llvm-closure-env-type [ctx captures]
  (let-do [fields (the (Array LLVMType) [])]
    (for [i 0 (Array.length captures)]
      (Array.push-back! &fields
                        (llvm-lower-type ctx
                                         (Box.peek (Pair.b (Array.unsafe-nth captures
                                                                             i))))))
    (LLVM.struct-type ctx &fields false)))

(doc llvm-emit-ref-builtin "the `ref` builtin (id 5): the address of its
operand. A slotted local or a global yields its storage directly (real
aliasing); any other operand is spilled to this site's entry-block slot.")
(hidden llvm-emit-ref-builtin)
(defn llvm-emit-ref-builtin [ctx builder mod func id arguments]
  (let [operand (Box.peek (Array.unsafe-nth arguments 0))]
    (match-ref operand
      (SpecializedExpr.Reference _ type reference)
        (if @(CoreRef.global reference)
          (let [symbol (CAbi.identifier
                  &(CAbi.mangle (CoreRef.name reference) (Box.peek type)))
                g (LLVM.get-named-global mod (llvm-cstr &symbol))]
            (if (LLVM.value-null? g)
              (do
                (llvm-emit-error!
                  (fmt "unknown global %s in llvm backend"
                       (CoreRef.name reference)))
                (llvm-dummy-value ctx))
              g))
          (let [si (llvm-slot-index @(CoreRef.id reference))]
            (if (Int.>= si 0)
              (llvm-slot-ptr si)
              (do
                (llvm-emit-error!
                  (fmt
                    "ref of unslotted local %s in llvm backend"
                    (CoreRef.name reference)))
                (llvm-dummy-value ctx)))))
      _
        (let [sp (llvm-matchspill-index id)]
          (if (Int.< sp 0)
            (do
              (llvm-emit-error! @"ref site without spill slot in llvm backend")
              (llvm-dummy-value ctx))
            (let-do [value (llvm-emit-expr ctx builder mod func operand)
                     ptr (llvm-matchspill-ptr sp)]
              (ignore (LLVM.build-store builder value ptr))
              ptr))))))

(doc llvm-string-literal "a `String*` to static storage holding `text`,
mirroring the C backend's `({ static String v = \"...\"; &v; })`: a private
global pointer variable initialized with the interned literal data. The
returned value is the address of that variable.")
(hidden llvm-string-literal)
(defn llvm-string-literal [ctx builder mod text]
  (let-do [serial @(Array.unsafe-nth &*llvm-strlit-counter* 0)
           holder-name (fmt "carp_strlit_%d" serial)
           data (LLVM.build-global-string-ptr builder
                                              (llvm-cstr text)
                                              (String.cstr &(fmt "%s_data"
                                                                 &holder-name)))
           holder (llvm-add-global-named mod
                                         (LLVM.pointer-type (LLVM.int8-type ctx)
                                                            0)
                                         &holder-name)]
    (Array.aset! &*llvm-strlit-counter* 0 (Int.inc serial))
    (LLVM.set-initializer holder data)
    (LLVM.set-linkage holder LLVM.linkage-private)
    holder))

(hidden llvm-env-bound?)
(defn llvm-env-bound? [id]
  (let-do [found (Int.>= (llvm-slot-index id) 0)]
    (for [i 0 (Array.length &*llvm-backend-env-ids*)]
      (when (Int.= @(Array.unsafe-nth &*llvm-backend-env-ids* i) id)
        (set! found true)))
    found))

(doc llvm-capture-self? "whether a capture argument references a local with no
binding yet — the only legal case is a letrec-style closure capturing the very
binding under construction, which gets a weak self-reference stored after
assembly (the C backend's `_carp_self` two-phase init).")
(hidden llvm-capture-self?)
(defn llvm-capture-self? [argument]
  (match-ref argument
    (SpecializedExpr.Reference _ _ reference)
      (and (not @(CoreRef.global reference))
           (not (llvm-env-bound? @(CoreRef.id reference))))
    _ false))

(doc llvm-emit-closure-construction "a `_carp_closure_N` site: malloc the
environment, store the captured values, and assemble a Lambda over
`_carp_lambda_N` and its environment delete/copy functions.")
(defn llvm-emit-closure-construction [ctx builder mod func id symbol arguments]
  (let-do [suffix (String.suffix symbol 14)
           lambda-symbol (String.concat
             &[@"_carp_lambda_" (String.copy &suffix)])
           ci (llvm-closure-index &lambda-symbol)]
    (if (Int.< ci 0)
      (do
        (llvm-emit-error! (fmt "unknown closure %s in llvm backend" symbol))
        (llvm-dummy-value ctx))
      (let-do [captures @(ClosureFunction.captures (Array.unsafe-nth &*llvm-closures*
                                                                     ci))
               env-ty (llvm-closure-env-type ctx &captures)
               env-size (if (Int.= 0 (Array.length &*llvm-target-data*))
                 8l
                 (LLVM.abi-size-of-type (llvm-target-data) env-ty))
               malloc-fnty (LLVM.function-type
                 (LLVM.pointer-type (LLVM.int8-type ctx) 0)
                 &[(LLVM.int64-type ctx)]
                 false)
               envp (LLVM.build-call builder
                                     malloc-fnty
                                     (llvm-runtime-fn mod
                                                      &*llvm-malloc-symbol*
                                                      malloc-fnty)
                                     &[(LLVM.const-int (LLVM.int64-type ctx)
                                                       env-size
                                                       0)]
                                     (llvm-cstr &@"envp"))]
        (let-do [self-fields (the (Array Int) [])]
          (for [i 0 (Array.length arguments)]
            (let-do [fieldp (LLVM.build-struct-gep builder
                                                   env-ty
                                                   envp
                                                   i
                                                   (llvm-cstr &@"capf"))]
              (if (llvm-capture-self? (Box.peek (Array.unsafe-nth arguments i)))
                ;; letrec: zero the field now, store a weak self after assembly
                (do
                  (Array.push-back! &self-fields i)
                  (ignore
                    (LLVM.build-store builder
                                      (LLVM.const-null (llvm-lambda-type ctx))
                                      fieldp)))
                (let-do [value (llvm-emit-expr ctx
                                               builder
                                               mod
                                               func
                                               (Box.peek (Array.unsafe-nth arguments
                                                                           i)))]
                  (ignore (LLVM.build-store builder value fieldp))
                  ;; the environment must OWN a managed capture: a borrowed
                  ;; capture (a Reference argument) is deep-copied in place
                  ;; through its copier — EXCEPT in a construction standing
                  ;; directly as a Let's value, where captures move in (the C
                  ;; backend's recursive path stores `.fi = value` uncopied,
                  ;; and the plan schedules no scope delete for them)
                  (when (and (Int.< i (Array.length &captures))
                             (and
                               (match-ref (Box.peek (Array.unsafe-nth arguments
                                                                      i))
                                 (SpecializedExpr.Reference _ _ _) true
                                 _ false)
                               (let-do [letbound false]
                                 (for [k
                                       0
                                       (Array.length &*llvm-letbound-closures*)]
                                   (when (Int.=
                                       @(Array.unsafe-nth &*llvm-letbound-closures*
                                                          k)
                                       id)
                                     (set! letbound true)))
                                 (not letbound))))
                    (let [capture-type (Box.peek (Pair.b (Array.unsafe-nth &captures
                                                                           i)))]
                      (match (llvm-managed-symbol &*llvm-copy-symbols*
                                                  capture-type)
                        (Maybe.Just copier)
                          (if (llvm-aggregate-monotype? capture-type)
                            ;; the copier moves an aggregate: pointer protocol
                            ;; through the prescanned ref slot, out into the field
                            (let-do [sp (llvm-argspill-index id i)]
                              (if (Int.< sp 0)
                                (llvm-emit-error!
                                  @"capture copy without ref slot in llvm backend")
                                (let-do [refslot (llvm-argspill-ptr sp)
                                         pfnty (LLVM.function-type (LLVM.void-type ctx)
                                                                   &[(LLVM.pointer-type (LLVM.int8-type ctx)
                                                                                        0)
                                                                     (LLVM.pointer-type (LLVM.int8-type ctx)
                                                                                        0)]
                                                                   false)]
                                  (ignore
                                    (LLVM.build-store builder
                                                      (LLVM.dup &fieldp)
                                                      refslot))
                                  (ignore
                                    (LLVM.build-call builder
                                                     pfnty
                                                     (llvm-runtime-fn mod
                                                                      &(llvm-protocol-target &copier)
                                                                      pfnty)
                                                     &[refslot
                                                       (LLVM.dup &fieldp)]
                                                     (llvm-cstr &@""))))))
                            (let [copier-fnty (LLVM.function-type (llvm-lower-type ctx
                                                                                   capture-type)
                                                                  &[(LLVM.pointer-type (LLVM.int8-type ctx)
                                                                                       0)]
                                                                  false)]
                              (ignore
                                (LLVM.build-store builder
                                                  (LLVM.build-call builder
                                                                   copier-fnty
                                                                   (llvm-runtime-fn mod
                                                                                    &copier
                                                                                    copier-fnty)
                                                                   &[(LLVM.dup &fieldp)]
                                                                   (llvm-cstr &@"capcopy"))
                                                  fieldp))))
                        (Maybe.Nothing) ())))))))
          (set! *llvm-selffields* self-fields))
        (let-do [fnv (LLVM.get-named-function mod (llvm-cstr &lambda-symbol))
                 envdel (llvm-named-fn mod &(fmt "%s_env_delete" &lambda-symbol))
                 envcopy (llvm-named-fn mod &(fmt "%s_env_copy" &lambda-symbol))
                 value (LLVM.const-null (llvm-lambda-type ctx))]
          (set! value
                (LLVM.build-insert-value builder value fnv 0 (llvm-cstr &@"lcb")))
          (set! value
                (LLVM.build-insert-value builder
                                         value
                                         envp
                                         1
                                         (llvm-cstr &@"lenv")))
          (set! value
                (LLVM.build-insert-value builder
                                         value
                                         envdel
                                         2
                                         (llvm-cstr &@"ldel")))
          (set! value
                (LLVM.build-insert-value builder
                                         value
                                         envcopy
                                         3
                                         (llvm-cstr &@"lcpy")))
          ;; letrec: a WEAK self (no delete/copy, breaking the ownership
          ;; cycle) lands in each deferred field now that self exists
          (for [k 0 (Array.length &*llvm-selffields*)]
            (let-do [weak (LLVM.const-null (llvm-lambda-type ctx))]
              (set! weak
                    (LLVM.build-insert-value builder
                                             weak
                                             fnv
                                             0
                                             (llvm-cstr &@"wcb")))
              (set! weak
                    (LLVM.build-insert-value builder
                                             weak
                                             envp
                                             1
                                             (llvm-cstr &@"wenv")))
              (ignore
                (LLVM.build-store builder
                                  weak
                                  (LLVM.build-struct-gep builder
                                                         env-ty
                                                         envp
                                                         @(Array.unsafe-nth &*llvm-selffields*
                                                                            k)
                                                         (llvm-cstr &@"selff"))))))
          (set! *llvm-selffields* [])
          value)))))

(doc llvm-emit-indirect-call "a call through a Lambda value: branch on the
environment pointer, calling the callback env-first when one is present and
plain otherwise — the C backend's `env ? cb(env, args) : cb(args)`.")
(doc llvm-emit-invoke-call "an aggregate-moving indirect call: spill the
arguments, hand callback + environment + pointers to the shim's per-signature
invoke helper, and read the result back — clang performs the actual call.")
(doc llvm-callee-temp? "whether an indirect call's callee is a closure
construction standing directly at the call — an owned temporary the call site
must dispose after calling (the C backend's dispose-callee).")
(hidden llvm-callee-temp?)
(defn llvm-callee-temp? [callee]
  (match-ref callee
    (SpecializedExpr.GlobalCall _ _ _ _ symbol _)
      (String.starts-with? symbol "_carp_closure_")
    _ false))

(doc llvm-dispose-callee! "frees a temporary callee Lambda after its call:
when its delete member is set, call it on the environment and free the
environment, like the C backend's `if (_carp_call.delete) { ... }`.")
(hidden llvm-dispose-callee!)
(defn llvm-dispose-callee! [ctx builder mod func lam]
  (let-do [ptr-ty (LLVM.pointer-type (LLVM.int8-type ctx) 0)
           del (LLVM.build-extract-value builder lam 2 (llvm-cstr &@"ddel"))
           denv (LLVM.build-extract-value builder lam 1 (llvm-cstr &@"denv"))
           flag (LLVM.build-icmp builder
                                 LLVM.int-ne
                                 del
                                 (LLVM.const-null ptr-ty)
                                 (llvm-cstr &@"hasdel"))
           dispose-block (LLVM.append-block ctx
                                            func
                                            (llvm-cstr &@"disposecallee"))
           done-block (LLVM.append-block ctx func (llvm-cstr &@"disposedone"))
           del-fnty (LLVM.function-type (LLVM.void-type ctx) &[ptr-ty] false)
           free-fnty (LLVM.function-type (LLVM.void-type ctx) &[ptr-ty] false)]
    (ignore (LLVM.build-cond-br builder flag dispose-block done-block))
    (LLVM.position-at-end builder dispose-block)
    (ignore
      (LLVM.build-call builder del-fnty del &[(LLVM.dup &denv)] (llvm-cstr &@"")))
    (ignore
      (LLVM.build-call builder
                       free-fnty
                       (llvm-runtime-fn mod &*llvm-free-symbol* free-fnty)
                       &[denv]
                       (llvm-cstr &@"")))
    (ignore (LLVM.build-br builder done-block))
    (LLVM.position-at-end builder done-block)))

(defn llvm-emit-invoke-call [ctx builder mod func id signature callee arguments]
  (match-ref signature
    (MonoType.Function fargs fret)
      (let-do [lam (llvm-emit-expr ctx builder mod func (Box.peek callee))
               cb (LLVM.build-extract-value builder lam 0 (llvm-cstr &@"icb"))
               env (LLVM.build-extract-value builder lam 1 (llvm-cstr &@"ienv"))
               helper-args (the (Array LLVMValue) [cb env])
               helper-types (the (Array LLVMType)
                                 [(LLVM.pointer-type (LLVM.int8-type ctx) 0)
                                  (LLVM.pointer-type (LLVM.int8-type ctx) 0)])
               ret-unit (unit-type? (Box.peek fret))
               broken false
               n (Array.length arguments)]
        (for [i 0 n]
          (let-do [value (llvm-emit-expr ctx
                                         builder
                                         mod
                                         func
                                         (Box.peek (Array.unsafe-nth arguments i)))
                   sp (llvm-argspill-index id i)]
            (if (Int.< sp 0)
              (do
                (llvm-emit-error!
                  @"invoke call without argument slot in llvm backend")
                (set! broken true))
              (let-do [slot (llvm-argspill-ptr sp)]
                (ignore (LLVM.build-store builder value slot))
                (Array.push-back! &helper-args slot)
                (Array.push-back! &helper-types
                                  (LLVM.pointer-type (LLVM.int8-type ctx) 0))))))
        (let-do [ret-slot (if ret-unit -1 (llvm-argspill-index id -1))]
          (when-do (and (not ret-unit) (Int.< ret-slot 0))
            (llvm-emit-error! @"invoke call without return slot in llvm backend")
            (set! broken true))
          (if broken
            (llvm-dummy-value ctx)
            (let-do [helper-name (fmt "carp_invoke_%s"
                                      &(llvm-invoke-key signature))]
              (unless-do ret-unit
                (Array.push-back! &helper-args (llvm-argspill-ptr ret-slot))
                (Array.push-back! &helper-types
                                  (LLVM.pointer-type (LLVM.int8-type ctx) 0)))
              (let-do [helper-fnty (LLVM.function-type (LLVM.void-type ctx)
                                                       &helper-types
                                                       false)]
                (ignore
                  (LLVM.build-call builder
                                   helper-fnty
                                   (llvm-runtime-fn mod &helper-name helper-fnty)
                                   &helper-args
                                   (llvm-cstr &@"")))
                ;; an owned temporary callee is disposed by the call site
                (when (llvm-callee-temp? (Box.peek callee))
                  (llvm-dispose-callee! ctx builder mod func (LLVM.dup &lam)))
                (if ret-unit
                  (llvm-dummy-value ctx)
                  (LLVM.build-load builder
                                   (llvm-lower-type ctx (Box.peek fret))
                                   (llvm-argspill-ptr ret-slot)
                                   (llvm-cstr &@"iret"))))))))
    _
      (do
        (llvm-emit-error! @"invoke call without function type in llvm backend")
        (llvm-dummy-value ctx))))

(defn llvm-emit-indirect-call [ctx builder mod func id callee arguments]
  (let [signature (Specialize.expression-type (Box.peek callee))]
    (if (llvm-needs-wrapper? &signature)
      (llvm-emit-invoke-call ctx builder mod func id &signature callee arguments)
      (llvm-emit-plain-indirect-call ctx builder mod func callee arguments))))

(defn llvm-emit-plain-indirect-call [ctx builder mod func callee arguments]
  (match (Specialize.expression-type (Box.peek callee))
    (MonoType.Function fargs fret)
      (let-do [lam (llvm-emit-expr ctx builder mod func (Box.peek callee))
               cb (LLVM.build-extract-value builder lam 0 (llvm-cstr &@"cb"))
               env (LLVM.build-extract-value builder lam 1 (llvm-cstr &@"env"))
               argument-values (the (Array LLVMValue) [])
               n (Array.length arguments)]
        (for [i 0 n]
          (Array.push-back! &argument-values
                            (llvm-emit-expr ctx
                                            builder
                                            mod
                                            func
                                            (Box.peek (Array.unsafe-nth arguments
                                                                        i)))))
        (let-do [ret-ty (llvm-lower-type ctx (Box.peek &fret))
                 ret-unit (unit-type? (Box.peek &fret))
                 ptr-ty (LLVM.pointer-type (LLVM.int8-type ctx) 0)
                 plain-types (the (Array LLVMType) [])
                 env-types (the (Array LLVMType) [ptr-ty])
                 env-args (the (Array LLVMValue) [env])]
          (for [i 0 (Array.length &fargs)]
            (let-do [t (llvm-lower-type ctx
                                        (Box.peek (Array.unsafe-nth &fargs i)))]
              (Array.push-back! &plain-types t)
              (Array.push-back! &env-types t)))
          (for [i 0 n]
            (Array.push-back! &env-args
                              (LLVM.dup (Array.unsafe-nth &argument-values i))))
          (let-do [flag (LLVM.build-icmp builder
                                         LLVM.int-ne
                                         env
                                         (LLVM.const-null ptr-ty)
                                         (llvm-cstr &@"hasenv"))
                   env-block (LLVM.append-block ctx func (llvm-cstr &@"callenv"))
                   plain-block (LLVM.append-block ctx
                                                  func
                                                  (llvm-cstr &@"callplain"))
                   merge-block (LLVM.append-block ctx
                                                  func
                                                  (llvm-cstr &@"callmerge"))]
            (ignore (LLVM.build-cond-br builder flag env-block plain-block))
            (LLVM.position-at-end builder env-block)
            (let-do [env-fnty (LLVM.function-type ret-ty &env-types false)
                     env-value (if ret-unit
                       (LLVM.build-call builder
                                        env-fnty
                                        cb
                                        &env-args
                                        (llvm-cstr &@""))
                       (LLVM.build-call builder
                                        env-fnty
                                        cb
                                        &env-args
                                        (llvm-cstr &@"cenv")))
                     env-end (LLVM.get-insert-block builder)]
              (ignore (LLVM.build-br builder merge-block))
              (LLVM.position-at-end builder plain-block)
              (let-do [plain-fnty (LLVM.function-type ret-ty &plain-types false)
                       plain-value (if ret-unit
                         (LLVM.build-call builder
                                          plain-fnty
                                          cb
                                          &argument-values
                                          (llvm-cstr &@""))
                         (LLVM.build-call builder
                                          plain-fnty
                                          cb
                                          &argument-values
                                          (llvm-cstr &@"cplain")))
                       plain-end (LLVM.get-insert-block builder)]
                (ignore (LLVM.build-br builder merge-block))
                (LLVM.position-at-end builder merge-block)
                (let-do [result (if ret-unit
                           (llvm-dummy-value ctx)
                           (let-do [phi (LLVM.build-phi builder
                                                        ret-ty
                                                        (llvm-cstr &@"callv"))]
                             (LLVM.add-incoming phi
                                                &[env-value plain-value]
                                                &[env-end plain-end])
                             phi))]
                  ;; an owned temporary callee is disposed by the call site
                  (when (llvm-callee-temp? (Box.peek callee))
                    (llvm-dispose-callee! ctx builder mod func (LLVM.dup &lam)))
                  result))))))
    _
      (do
        (llvm-emit-error! @"indirect call without function type in llvm backend")
        (llvm-dummy-value ctx))))

;; llvm-emit-expr and the construct emitters below are mutually recursive.
(defn llvm-emit-expr [ctx builder mod func expression]
  (let-do [_debug (llvm-debug-set-builder! ctx builder expression)
           value (match-ref expression
             (SpecializedExpr.IntLit _ _ value)
               (LLVM.const-int (LLVM.int32-type ctx) (Long.from-int @value) 0)
             (SpecializedExpr.LongLit _ _ value)
               (LLVM.const-int (LLVM.int64-type ctx) @value 0)
             (SpecializedExpr.DoubleLit _ _ value)
               (LLVM.const-real (LLVM.double-type ctx) @value)
             (SpecializedExpr.BoolLit _ _ value)
               (LLVM.const-int (LLVM.int8-type ctx) (if @value 1l 0l) 0)
             (SpecializedExpr.FloatLit _ _ value)
               (LLVM.const-real (LLVM.float-type ctx) (Double.from-float @value))
             (SpecializedExpr.CharLit _ _ value)
               (LLVM.const-int (LLVM.int32-type ctx)
                               (Long.from-int (Char.to-int @value))
                               0)
             (SpecializedExpr.ByteLit _ _ value)
               (LLVM.const-int (LLVM.int8-type ctx)
                               (Long.from-int (Byte.to-int @value))
                               0)
             (SpecializedExpr.StringLit _ _ value)
               (llvm-string-literal ctx builder mod value)
             (SpecializedExpr.PatternLit _ _ value)
               (llvm-string-literal ctx builder mod value)
             (SpecializedExpr.ArrayLit _ type elements)
               (llvm-emit-array-lit ctx builder mod func type elements)
             (SpecializedExpr.StaticArrayLit _ type elements)
               (llvm-emit-static-array-lit ctx builder mod func type elements)
             (SpecializedExpr.UnitLit _ _) (llvm-dummy-value ctx)
             (SpecializedExpr.Reference _ type reference)
               (if @(CoreRef.global reference)
                 (if (unit-type? (Box.peek type))
                   (llvm-dummy-value ctx)
                   (let [symbol (CAbi.identifier
                           &(CAbi.mangle (CoreRef.name reference)
                                         (Box.peek type)))
                         g (LLVM.get-named-global mod (llvm-cstr &symbol))]
                     (if (LLVM.value-null? g)
                       (do
                         (llvm-emit-error!
                           (fmt "unknown global %s in llvm backend"
                                (CoreRef.name reference)))
                         (llvm-dummy-value ctx))
                       (LLVM.build-load builder
                                        (llvm-lower-type ctx (Box.peek type))
                                        g
                                        (llvm-cstr &@"gload")))))
                 (let [si (llvm-slot-index @(CoreRef.id reference))]
                   (if (Int.>= si 0)
                     (LLVM.build-load builder
                                      (llvm-lower-type ctx (Box.peek type))
                                      (llvm-slot-ptr si)
                                      (llvm-cstr &@"loadslot"))
                     (llvm-env-lookup ctx
                                      @(CoreRef.id reference)
                                      (CoreRef.name reference)))))
             (SpecializedExpr.GlobalValue id
                                          value-type
                                          reference
                                          _
                                          symbol
                                          lambda-var)
               (cond
                 ;; the NULL builtin (id 7) is a null pointer constant, not a global
                 (Int.= @(CoreRef.id reference) 7)
                 (LLVM.const-null (LLVM.pointer-type (LLVM.int8-type ctx) 0))
                 ;; a function value: a def global already holds a Lambda; a plain
                 ;; function symbol is wrapped in one with no environment
                 (match-ref (Box.peek value-type)
                   (MonoType.Function _ _) true
                   _ false)
                 (if @lambda-var
                   (let [g (LLVM.get-named-global mod (llvm-cstr symbol))]
                     (if (LLVM.value-null? g)
                       (do
                         (llvm-emit-error!
                           (fmt "unknown global %s in llvm backend" symbol))
                         (llvm-dummy-value ctx))
                       (LLVM.build-load builder
                                        (llvm-lambda-type ctx)
                                        g
                                        (llvm-cstr &@"glambda"))))
                   (let-do [found (LLVM.get-named-function mod
                                                           (llvm-cstr symbol))
                            fnv (if (LLVM.value-null? found)
                              (LLVM.add-function mod
                                                 (llvm-cstr symbol)
                                                 (llvm-lower-function-type ctx
                                                                           (Box.peek value-type)))
                              found)]
                     (LLVM.build-insert-value builder
                                              (LLVM.const-null (llvm-lambda-type ctx))
                                              fnv
                                              0
                                              (llvm-cstr &@"mklambda"))))
                 (llvm-value-intrinsic? symbol)
                 ;; an aggregate constant crosses by out-pointer — a by-value struct
                 ;; return would not match clang's sret convention
                 (if (llvm-aggregate-monotype? (Box.peek value-type))
                   (let [si (llvm-matchspill-index @id)]
                     (if (Int.< si 0)
                       (do
                         (llvm-emit-error!
                           (fmt
                             "value intrinsic %s without slot in llvm backend"
                             symbol))
                         (llvm-dummy-value ctx))
                       (let-do [ptr (llvm-matchspill-ptr si)
                                getter-fnty (LLVM.function-type (LLVM.void-type ctx)
                                                                &[(LLVM.pointer-type (LLVM.int8-type ctx)
                                                                                     0)]
                                                                false)]
                         (ignore
                           (LLVM.build-call builder
                                            getter-fnty
                                            (llvm-runtime-fn mod
                                                             &(fmt "%s_carpvalue"
                                                                   symbol)
                                                             getter-fnty)
                                            &[ptr]
                                            (llvm-cstr &@"")))
                         (LLVM.build-load builder
                                          (llvm-lower-type ctx
                                                           (Box.peek value-type))
                                          ptr
                                          (llvm-cstr &@"cval")))))
                   (let-do [value-ty (llvm-lower-type ctx (Box.peek value-type))
                            getter-fnty (LLVM.function-type value-ty
                                                            &(the (Array LLVMType)
                                                                  [])
                                                            false)]
                     (LLVM.build-call builder
                                      getter-fnty
                                      (llvm-runtime-fn mod
                                                       &(fmt "%s_carpvalue"
                                                             symbol)
                                                       getter-fnty)
                                      &(the (Array LLVMValue) [])
                                      (llvm-cstr &@"cval"))))
                 (let [g (LLVM.get-named-global mod (llvm-cstr symbol))]
                   (if (LLVM.value-null? g)
                     (do
                       (llvm-emit-error!
                         (fmt "unknown global %s in llvm backend" symbol))
                       (llvm-dummy-value ctx))
                     (LLVM.build-load builder
                                      (llvm-lower-type ctx (Box.peek value-type))
                                      g
                                      (llvm-cstr &@"gval")))))
             (SpecializedExpr.GlobalCall id
                                         result-type
                                         reference
                                         callee-signature
                                         symbol
                                         arguments)
               (cond
                 ;; `ref` (id 5) and `deref` (id 6) are address-of and dereference,
                 ;; not calls to runtime functions
                 (and (Int.= 5 @(CoreRef.id reference))
                      (Int.= 1 (Array.length arguments)))
                 (llvm-emit-ref-builtin ctx builder mod func @id arguments)
                 (and (Int.= 6 @(CoreRef.id reference))
                      (Int.= 1 (Array.length arguments)))
                 ;; a unit value has no storage to load
                 (if (unit-type? (Box.peek result-type))
                   (do
                     (ignore
                       (llvm-emit-expr ctx
                                       builder
                                       mod
                                       func
                                       (Box.peek (Array.unsafe-nth arguments 0))))
                     (llvm-dummy-value ctx))
                   (LLVM.build-load builder
                                    (llvm-lower-type ctx (Box.peek result-type))
                                    (llvm-emit-expr ctx
                                                    builder
                                                    mod
                                                    func
                                                    (Box.peek (Array.unsafe-nth arguments
                                                                                0)))
                                    (llvm-cstr &@"deref")))
                 ;; the array-free sentinel is not a function: free the backing data,
                 ;; guarded on null like the C backend (LOG_MEMORY counts every
                 ;; CARP_FREE, so a free(NULL) would skew the balance)
                 (and (String.= symbol "__carp_array_free")
                      (Int.= 1 (Array.length arguments)))
                 (let-do [operand (llvm-emit-expr ctx
                                                  builder
                                                  mod
                                                  func
                                                  (Box.peek (Array.unsafe-nth arguments
                                                                              0)))
                          data (LLVM.build-extract-value builder
                                                         operand
                                                         2
                                                         (llvm-cstr &@"freedata"))
                          free-fnty (LLVM.function-type (LLVM.void-type ctx)
                                                        &[(LLVM.pointer-type (LLVM.int8-type ctx)
                                                                             0)]
                                                        false)
                          free-fn (llvm-runtime-fn mod
                                                   &*llvm-free-symbol*
                                                   free-fnty)
                          has-data (LLVM.build-icmp builder
                                                    LLVM.int-ne
                                                    data
                                                    (LLVM.const-null
                                                      (LLVM.pointer-type (LLVM.int8-type ctx)
                                                                         0))
                                                    (llvm-cstr &@"hasdata"))
                          free-block (LLVM.append-block ctx
                                                        func
                                                        (llvm-cstr &@"dofree"))
                          skip-block (LLVM.append-block ctx
                                                        func
                                                        (llvm-cstr &@"skipfree"))]
                   (ignore
                     (LLVM.build-cond-br builder has-data free-block skip-block))
                   (LLVM.position-at-end builder free-block)
                   (ignore
                     (LLVM.build-call builder
                                      free-fnty
                                      free-fn
                                      &[data]
                                      (llvm-cstr &@"")))
                   (ignore (LLVM.build-br builder skip-block))
                   (LLVM.position-at-end builder skip-block)
                   (llvm-dummy-value ctx))
                 ;; build-configuration commands (ids 73-75) are compile-time effects;
                 ;; the C emission ignores them and so does this one
                 (and
                   (or (Int.= 73 @(CoreRef.id reference))
                       (or (Int.= 74 @(CoreRef.id reference))
                           (Int.= 75 @(CoreRef.id reference))))
                   (Int.= 1 (Array.length arguments)))
                 (llvm-dummy-value ctx)
                 ;; a closure construction site assembles a Lambda over its lifted
                 ;; function and heap environment
                 (String.starts-with? symbol "_carp_closure_")
                 (llvm-emit-closure-construction ctx
                                                 builder
                                                 mod
                                                 func
                                                 @id
                                                 symbol
                                                 arguments)
                 ;; allocate (ids 14/15): uninitialized Array storage
                 (and
                   (or (Int.= 14 @(CoreRef.id reference))
                       (Int.= 15 @(CoreRef.id reference)))
                   (Int.= 1 (Array.length arguments)))
                 (llvm-emit-array-allocate ctx
                                           builder
                                           mod
                                           func
                                           result-type
                                           arguments)
                 ;; indexed setters (aset-uninitialized! 16/17/18, StaticArray.aset! 21):
                 ;; a plain store through the array reference, like the C backend
                 (and
                   (or (Int.= 16 @(CoreRef.id reference))
                       (or (Int.= 17 @(CoreRef.id reference))
                           (or (Int.= 18 @(CoreRef.id reference))
                               (Int.= 21 @(CoreRef.id reference)))))
                   (Int.= 3 (Array.length arguments)))
                 (llvm-emit-array-aset ctx builder mod func arguments)
                 ;; get-tag (id 48): the stored tag, or constant zero for a
                 ;; single-constructor nominal that carries none
                 (and (Int.= 48 @(CoreRef.id reference))
                      (Int.= 1 (Array.length arguments)))
                 (let-do [selfp (llvm-emit-expr ctx
                                                builder
                                                mod
                                                func
                                                (Box.peek (Array.unsafe-nth arguments
                                                                            0)))
                          subject (llvm-deref-monotype
                            (Box.peek (Array.unsafe-nth arguments 0)))]
                   (if (Int.= 1
                              (llvm-sum-variant-count &(llvm-instance-name &subject)))
                     (LLVM.const-int (LLVM.int32-type ctx) 0l 0)
                     (LLVM.build-load builder
                                      (LLVM.int32-type ctx)
                                      (LLVM.build-struct-gep builder
                                                             (llvm-sum-type-for ctx
                                                                                &subject)
                                                             selfp
                                                             1
                                                             (llvm-cstr &@"gtagp"))
                                      (llvm-cstr &@"gtag"))))
                 ;; field-set! (id 49): write a struct field in place behind a ref;
                 ;; args are [self, IntLit tag, IntLit member-index, value]
                 (and (Int.= 49 @(CoreRef.id reference))
                      (Int.= 4 (Array.length arguments)))
                 (let-do [selfp (llvm-emit-expr ctx
                                                builder
                                                mod
                                                func
                                                (Box.peek (Array.unsafe-nth arguments
                                                                            0)))
                          subject (llvm-deref-monotype
                            (Box.peek (Array.unsafe-nth arguments 0)))
                          tag (literal-int
                            (Box.peek (Array.unsafe-nth arguments 1)))
                          member (literal-int
                            (Box.peek (Array.unsafe-nth arguments 2)))
                          value (llvm-emit-expr ctx
                                                builder
                                                mod
                                                func
                                                (Box.peek (Array.unsafe-nth arguments
                                                                            3)))
                          outer-ty (llvm-sum-type-for ctx &subject)
                          variant-ty (llvm-variant-struct ctx &subject tag)
                          unionp (LLVM.build-struct-gep builder
                                                        outer-ty
                                                        selfp
                                                        0
                                                        (llvm-cstr &@"fsunionp"))
                          ci (llvm-ctor-index-of-tag &subject tag)]
                   ;; a unit member has no storage to write
                   (unless (and (Int.>= ci 0)
                                (unit-type?
                                  &(llvm-ctor-field-monotype ci &subject member)))
                     (ignore
                       (LLVM.build-store builder
                                         value
                                         (LLVM.build-struct-gep builder
                                                                variant-ty
                                                                unionp
                                                                (if (Int.>= ci 0)
                                                                  (llvm-ctor-adjusted-index ci
                                                                                            &subject
                                                                                            member)
                                                                  member)
                                                                (llvm-cstr &@"fsfield")))))
                   (llvm-dummy-value ctx))
                 ;; Array/StaticArray length (ids 9/10): load `.len` behind the ref
                 (and
                   (or (Int.= 9 @(CoreRef.id reference))
                       (Int.= 10 @(CoreRef.id reference)))
                   (Int.= 1 (Array.length arguments)))
                 (let [aref (llvm-emit-expr ctx
                                            builder
                                            mod
                                            func
                                            (Box.peek (Array.unsafe-nth arguments
                                                                        0)))]
                   (LLVM.build-trunc builder
                                     (LLVM.build-load builder
                                                      (LLVM.int64-type ctx)
                                                      (LLVM.build-struct-gep builder
                                                                             (llvm-array-type ctx)
                                                                             aref
                                                                             0
                                                                             (llvm-cstr &@"lenp"))
                                                      (llvm-cstr &@"len"))
                                     (LLVM.int32-type ctx)
                                     (llvm-cstr &@"leni")))
                 ;; unsafe-raw (id 65): a borrowed array's backing pointer
                 (and (Int.= 65 @(CoreRef.id reference))
                      (Int.= 1 (Array.length arguments)))
                 (let [aref (llvm-emit-expr ctx
                                            builder
                                            mod
                                            func
                                            (Box.peek (Array.unsafe-nth arguments
                                                                        0)))]
                   (LLVM.build-load builder
                                    (LLVM.pointer-type (LLVM.int8-type ctx) 0)
                                    (LLVM.build-struct-gep builder
                                                           (llvm-array-type ctx)
                                                           aref
                                                           2
                                                           (llvm-cstr &@"rawp"))
                                    (llvm-cstr &@"raw")))
                 ;; Array.raw (id 70): an owned array value's backing pointer
                 (and (Int.= 70 @(CoreRef.id reference))
                      (Int.= 1 (Array.length arguments)))
                 (LLVM.build-extract-value builder
                                           (llvm-emit-expr ctx
                                                           builder
                                                           mod
                                                           func
                                                           (Box.peek (Array.unsafe-nth arguments
                                                                                       0)))
                                           2
                                           (llvm-cstr &@"rawv"))
                 ;; Array/StaticArray unsafe-nth (ids 12/13): a borrowed pointer into
                 ;; the backing data
                 (and
                   (or (Int.= 12 @(CoreRef.id reference))
                       (Int.= 13 @(CoreRef.id reference)))
                   (Int.= 2 (Array.length arguments)))
                 (let-do [aref (llvm-emit-expr ctx
                                               builder
                                               mod
                                               func
                                               (Box.peek (Array.unsafe-nth arguments
                                                                           0)))
                          index (llvm-emit-expr ctx
                                                builder
                                                mod
                                                func
                                                (Box.peek (Array.unsafe-nth arguments
                                                                            1)))
                          data (LLVM.build-load builder
                                                (LLVM.pointer-type (LLVM.int8-type ctx)
                                                                   0)
                                                (LLVM.build-struct-gep builder
                                                                       (llvm-array-type ctx)
                                                                       aref
                                                                       2
                                                                       (llvm-cstr &@"datap"))
                                                (llvm-cstr &@"data"))
                          element-type (match-ref (Box.peek result-type)
                            (MonoType.Reference inner _)
                            ;; unit elements store as bytes
                            (if (unit-type? (Box.peek inner))
                              (LLVM.int8-type ctx)
                              (llvm-lower-type ctx (Box.peek inner)))
                            _
                            (do
                              (llvm-emit-error!
                                @"unsafe-nth without reference result in llvm backend")
                              (LLVM.int32-type ctx)))]
                   (LLVM.build-gep builder
                                   element-type
                                   data
                                   &[index]
                                   (llvm-cstr &@"elem")))
                 (llvm-emit-global-call ctx
                                        builder
                                        mod
                                        func
                                        @id
                                        callee-signature
                                        symbol
                                        arguments))
             (SpecializedExpr.Do _ _ elements)
               (llvm-emit-do ctx builder mod func elements)
             (SpecializedExpr.If _ type condition then else)
               (llvm-emit-if ctx builder mod func type condition then else)
             (SpecializedExpr.Let _ _ binder value body)
               (llvm-emit-let ctx builder mod func binder value body)
             (SpecializedExpr.Set _ _ target value)
               (let-do [assigned (llvm-emit-expr ctx
                                                 builder
                                                 mod
                                                 func
                                                 (Box.peek value))
                        si (llvm-slot-index @(CoreRef.id target))]
                 (cond
                   (Int.>= si 0)
                     (ignore
                       (LLVM.build-store builder assigned (llvm-slot-ptr si)))
                   @(CoreRef.global target)
                     (let [symbol (CAbi.identifier
                             &(CAbi.mangle (CoreRef.name target)
                                           &(Specialize.expression-type (Box.peek value))))
                           g (LLVM.get-named-global mod (llvm-cstr &symbol))]
                       (if (LLVM.value-null? g)
                         (llvm-emit-error!
                           (fmt "unknown global %s in llvm backend"
                                (CoreRef.name target)))
                         (ignore (LLVM.build-store builder assigned g))))
                   (unless (unit-type?
                       &(Specialize.expression-type (Box.peek value)))
                     (llvm-emit-error!
                       (fmt
                         "set! target %s missing slot in llvm backend"
                         (CoreRef.name target)))))
                 (llvm-dummy-value ctx))
             (SpecializedExpr.While _ _ condition body)
               (llvm-emit-while ctx builder mod func condition body)
             (SpecializedExpr.Match id type by-reference scrutinee branches)
               (llvm-emit-match ctx
                                builder
                                mod
                                func
                                @id
                                type
                                by-reference
                                scrutinee
                                branches)
             (SpecializedExpr.Break _ _)
               (let [n (Array.length &*llvm-break-blocks*)]
                 (if (Int.= n 0)
                   (do
                     (llvm-emit-error! @"break outside while in llvm backend")
                     (llvm-dummy-value ctx))
                   (let-do [target (LLVM.dup
                              (Array.unsafe-nth &*llvm-break-blocks* (Int.dec n)))]
                     (ignore (LLVM.build-br builder target))
                     (LLVM.position-at-end builder
                                           (LLVM.append-block ctx
                                                              func
                                                              (llvm-cstr &@"afterbreak")))
                     (llvm-dummy-value ctx))))
             (SpecializedExpr.Call id _ callee arguments)
               (llvm-emit-indirect-call ctx
                                        builder
                                        mod
                                        func
                                        @id
                                        callee
                                        arguments)
             (SpecializedExpr.Annotation _ _ inner _)
               (llvm-emit-expr ctx builder mod func (Box.peek inner))
             _
               (do
                 (llvm-emit-error!
                   (fmt "unsupported %s in llvm backend"
                        &(llvm-unsupported-name expression)))
                 (llvm-dummy-value ctx)))]
    (llvm-debug-attach! ctx value expression)
    value))

(doc llvm-emit-wrapper-call "calls a C-native function whose signature moves
aggregates: every argument is spilled to an entry-block slot and passed by
pointer to the generated `<symbol>_carpabi` shim wrapper, which returns
through an out-pointer. Pointer-only signatures are ABI-safe on every target.")
(defn llvm-emit-wrapper-call [ctx
                              builder
                              mod
                              func
                              id
                              callee-signature
                              symbol
                              arguments]
  (match-ref (Box.peek callee-signature)
    (MonoType.Function fargs fret)
      (let-do [pointer-args (the (Array LLVMValue) [])
               pointer-types (the (Array LLVMType) [])
               n (Array.length arguments)
               broken false]
        (for [i 0 n]
          (let-do [value (llvm-emit-expr ctx
                                         builder
                                         mod
                                         func
                                         (Box.peek (Array.unsafe-nth arguments i)))]
            ;; a unit argument runs for its effects and is elided from the call
            (unless (unit-type?
                &(Specialize.expression-type
                  (Box.peek (Array.unsafe-nth arguments i))))
              (let [sp (llvm-argspill-index id i)]
                (if (Int.< sp 0)
                  (do
                    (llvm-emit-error!
                      (fmt
                        "wrapper call %s without argument slot in llvm backend"
                        symbol))
                    (set! broken true))
                  (let-do [ptr (llvm-argspill-ptr sp)]
                    (ignore (LLVM.build-store builder value ptr))
                    (Array.push-back! &pointer-args ptr)
                    (Array.push-back! &pointer-types
                                      (LLVM.pointer-type (LLVM.int8-type ctx) 0))))))))
        (let-do [ret-unit (unit-type? (Box.peek fret))
                 ret-slot (if ret-unit -1 (llvm-argspill-index id -1))]
          (when-do (and (not ret-unit) (Int.< ret-slot 0))
            (llvm-emit-error!
              (fmt "wrapper call %s without return slot in llvm backend" symbol))
            (set! broken true))
          (if broken
            (llvm-dummy-value ctx)
            (let-do [wrapper-name (String.copy symbol)]
              (unless-do ret-unit
                (Array.push-back! &pointer-args (llvm-argspill-ptr ret-slot))
                (Array.push-back! &pointer-types
                                  (LLVM.pointer-type (LLVM.int8-type ctx) 0)))
              (let-do [fnty (LLVM.function-type (LLVM.void-type ctx)
                                                &pointer-types
                                                false)
                       found (LLVM.get-named-function mod
                                                      (llvm-cstr &wrapper-name))
                       callee (if (LLVM.value-null? found)
                         (LLVM.add-function mod (llvm-cstr &wrapper-name) fnty)
                         found)]
                (ignore
                  (LLVM.build-call builder
                                   fnty
                                   callee
                                   &pointer-args
                                   (llvm-cstr &@"")))
                (if ret-unit
                  (llvm-dummy-value ctx)
                  (LLVM.build-load builder
                                   (llvm-lower-type ctx (Box.peek fret))
                                   (llvm-argspill-ptr ret-slot)
                                   (llvm-cstr &@"abiret"))))))))
    _
      (do
        (llvm-emit-error! @"wrapper call without function type in llvm backend")
        (llvm-dummy-value ctx))))

(defn llvm-emit-global-call [ctx
                             builder
                             mod
                             func
                             id
                             callee-signature
                             symbol
                             arguments]
  (if (Int.>= (llvm-asm-index symbol) 0)
    (llvm-emit-asm-call ctx builder mod func id symbol)
    (llvm-emit-global-call-dispatch ctx
                                    builder
                                    mod
                                    func
                                    id
                                    callee-signature
                                    symbol
                                    arguments)))

(doc llvm-emit-asm-call "calls the shim thunk for a scope-dependent asm macro:
output operands pass their slot pointers, inputs pass loaded values, per the
operand resolution the prescan recorded for this call site.")
(hidden llvm-emit-asm-call)
(defn llvm-emit-asm-call [ctx builder mod func id symbol]
  (let-do [ci -1]
    (for [i 0 (Array.length &*llvm-asm-call-ids*)]
      (when (Int.= @(Array.unsafe-nth &*llvm-asm-call-ids* i) id) (set! ci i)))
    (if (Int.< ci 0)
      (do
        (llvm-emit-error!
          (fmt
            "asm macro call %s without operand resolution in llvm backend"
            symbol))
        (llvm-dummy-value ctx))
      (let-do [args (the (Array LLVMValue) [])
               arg-types (the (Array LLVMType) [])
               ai (llvm-asm-index symbol)
               broken false]
        (for [i 0 (Array.length (Array.unsafe-nth &*llvm-asm-call-outs* ci))]
          (let [si (llvm-slot-index
                  @(Array.unsafe-nth
                    (Array.unsafe-nth &*llvm-asm-call-outs* ci)
                    i))]
            (if (Int.< si 0)
              (set! broken true)
              (do
                (Array.push-back! &args (llvm-slot-ptr si))
                (Array.push-back! &arg-types
                                  (LLVM.pointer-type (LLVM.int8-type ctx) 0))))))
        (for [i 0 (Array.length (Array.unsafe-nth &*llvm-asm-call-ins* ci))]
          (let [si (llvm-slot-index
                  @(Array.unsafe-nth
                    (Array.unsafe-nth &*llvm-asm-call-ins* ci)
                    i))]
            (if (Int.< si 0)
              (set! broken true)
              (let-do [ty (llvm-lower-type ctx
                                           (Array.unsafe-nth
                                             (Array.unsafe-nth &*llvm-asm-in-types*
                                                               ai)
                                             i))]
                (Array.push-back! &args
                                  (LLVM.build-load builder
                                                   ty
                                                   (llvm-slot-ptr si)
                                                   (llvm-cstr &@"asmin")))
                (Array.push-back! &arg-types ty)))))
        (if broken
          (do
            (llvm-emit-error!
              (fmt
                "asm macro call %s without operand slot in llvm backend"
                symbol))
            (llvm-dummy-value ctx))
          (let-do [fnty (LLVM.function-type (LLVM.void-type ctx)
                                            &arg-types
                                            false)]
            (ignore
              (LLVM.build-call builder
                               fnty
                               (llvm-runtime-fn mod
                                                &(fmt "carp_asmthunk_%s" symbol)
                                                fnty)
                               &args
                               (llvm-cstr &@"")))
            (llvm-dummy-value ctx)))))))

(hidden llvm-emit-global-call-dispatch)
(defn llvm-emit-global-call-dispatch [ctx
                                      builder
                                      mod
                                      func
                                      id
                                      callee-signature
                                      symbol
                                      arguments]
  (cond
    (llvm-cimpl? symbol)
      (llvm-emit-wrapper-call ctx
                              builder
                              mod
                              func
                              id
                              callee-signature
                              &(fmt "%s_carpimpl" symbol)
                              arguments)
    (and (llvm-cnative? symbol)
         (llvm-needs-wrapper? (Box.peek callee-signature)))
      (llvm-emit-wrapper-call ctx
                              builder
                              mod
                              func
                              id
                              callee-signature
                              &(fmt "%s_carpabi" symbol)
                              arguments)
    (llvm-emit-plain-call ctx builder mod func callee-signature symbol arguments)))

(defn llvm-emit-plain-call [ctx
                            builder
                            mod
                            func
                            callee-signature
                            symbol
                            arguments]
  (let-do [argument-values (the (Array LLVMValue) [])
           n (Array.length arguments)]
    (for [i 0 n]
      ;; a unit argument runs for its effects and is elided from the call
      (let [value (llvm-emit-expr ctx
                                  builder
                                  mod
                                  func
                                  (Box.peek (Array.unsafe-nth arguments i)))]
        (unless (unit-type?
            &(Specialize.expression-type
              (Box.peek (Array.unsafe-nth arguments i))))
          (Array.push-back! &argument-values value))))
    (let [fnty (llvm-lower-function-type ctx (Box.peek callee-signature))
          found (LLVM.get-named-function mod (llvm-cstr symbol))
          ;; a plan-inserted call (e.g. a deleter) can name a symbol no
          ;; declaration covers — the C backend leans on header declarations
          ;; there, so declare it here from the call's own signature
          callee (if (LLVM.value-null? found)
            (LLVM.add-function mod (llvm-cstr symbol) fnty)
            found)]
      ;; a void call must stay unnamed — LLVM refuses names on void values
      (if (llvm-returns-unit? (Box.peek callee-signature))
        (LLVM.build-call builder fnty callee &argument-values (llvm-cstr &@""))
        (LLVM.build-call builder
                         fnty
                         callee
                         &argument-values
                         (llvm-cstr &@"call"))))))

(doc llvm-emit-array-allocate "the `allocate` builtins (ids 14/15): an Array
with `n` elements of uninitialized malloc'd storage.")
(defn llvm-emit-array-allocate [ctx builder mod func result-type arguments]
  (let-do [n32 (llvm-emit-expr ctx
                               builder
                               mod
                               func
                               (Box.peek (Array.unsafe-nth arguments 0)))
           n64 (LLVM.build-sext builder
                                n32
                                (LLVM.int64-type ctx)
                                (llvm-cstr &@"alen64"))
           element-monotype (match-ref (Box.peek result-type)
             (MonoType.Named _ targs)
               (if (Int.= 1 (Array.length targs))
                 (MonoType.copy (Box.peek (Array.unsafe-nth targs 0)))
                 (Type.integer))
             _ (Type.integer))
           element-type (llvm-lower-type ctx &element-monotype)
           ;; a unit element sizes as one byte, GNU C's sizeof(void)
           element-size (cond
             (unit-type? &element-monotype) 1l
             (Int.= 0 (Array.length &*llvm-target-data*)) 8l
             (LLVM.abi-size-of-type (llvm-target-data) element-type))
           malloc-fnty (LLVM.function-type
             (LLVM.pointer-type (LLVM.int8-type ctx) 0)
             &[(LLVM.int64-type ctx)]
             false)
           byte-count (LLVM.build-mul builder
                                      n64
                                      (LLVM.const-int (LLVM.int64-type ctx)
                                                      element-size
                                                      0)
                                      (llvm-cstr &@"abytes"))
           data (LLVM.build-call builder
                                 malloc-fnty
                                 (llvm-runtime-fn mod
                                                  &*llvm-malloc-symbol*
                                                  malloc-fnty)
                                 &[byte-count]
                                 (llvm-cstr &@"adata"))
           value (LLVM.const-null (llvm-array-type ctx))]
    (set! value
          (LLVM.build-insert-value builder value n64 0 (llvm-cstr &@"alen")))
    (set! value
          (LLVM.build-insert-value builder value n64 1 (llvm-cstr &@"acap")))
    (LLVM.build-insert-value builder value data 2 (llvm-cstr &@"abuilt"))))

(doc llvm-emit-array-aset "the `aset-uninitialized!` builtins (ids 16/17):
store `value` at index `idx` of the array behind the reference.")
(defn llvm-emit-array-aset [ctx builder mod func arguments]
  (let-do [aref (llvm-emit-expr ctx
                                builder
                                mod
                                func
                                (Box.peek (Array.unsafe-nth arguments 0)))
           idx (llvm-emit-expr ctx
                               builder
                               mod
                               func
                               (Box.peek (Array.unsafe-nth arguments 1)))
           value-monotype (Specialize.expression-type
             (Box.peek (Array.unsafe-nth arguments 2)))
           value (llvm-emit-expr ctx
                                 builder
                                 mod
                                 func
                                 (Box.peek (Array.unsafe-nth arguments 2)))
           element-type (llvm-lower-type ctx &value-monotype)
           data (LLVM.build-load builder
                                 (LLVM.pointer-type (LLVM.int8-type ctx) 0)
                                 (LLVM.build-struct-gep builder
                                                        (llvm-array-type ctx)
                                                        aref
                                                        2
                                                        (llvm-cstr &@"datap"))
                                 (llvm-cstr &@"data"))]
    ;; a unit element has no storage; the value expression still ran
    (unless (unit-type? &value-monotype)
      (ignore
        (LLVM.build-store builder
                          value
                          (LLVM.build-gep builder
                                          element-type
                                          data
                                          &[idx]
                                          (llvm-cstr &@"aslot")))))
    (llvm-dummy-value ctx)))

(doc llvm-emit-array-lit "an Array value: malloc the backing data, store the
elements through a typed GEP, and build `{ len, capacity, data }`, mirroring
the C backend's designated-initializer rendering.")
(defn llvm-emit-array-lit [ctx builder mod func type elements]
  (let-do [n (Array.length elements)
           element-monotype (match-ref (Box.peek type)
             (MonoType.Named _ targs)
               (if (Int.= 1 (Array.length targs))
                 (MonoType.copy (Box.peek (Array.unsafe-nth targs 0)))
                 (Type.integer))
             _ (Type.integer))
           element-type (llvm-lower-type ctx &element-monotype)
           ;; a unit element sizes as one byte, GNU C's sizeof(void)
           element-size (cond
             (unit-type? &element-monotype) 1l
             (Int.= 0 (Array.length &*llvm-target-data*))
               (do
                 (llvm-emit-error!
                   @"array literal without target data in llvm backend")
                 8l)
             (LLVM.abi-size-of-type (llvm-target-data) element-type))
           malloc-fnty (LLVM.function-type
             (LLVM.pointer-type (LLVM.int8-type ctx) 0)
             &[(LLVM.int64-type ctx)]
             false)
           data (LLVM.build-call builder
                                 malloc-fnty
                                 (llvm-runtime-fn mod
                                                  &*llvm-malloc-symbol*
                                                  malloc-fnty)
                                 &[(LLVM.const-int (LLVM.int64-type ctx)
                                                   (Long.* (Long.from-int n)
                                                           element-size)
                                                   0)]
                                 (llvm-cstr &@"adata"))]
    (for [i 0 n]
      (let [value (llvm-emit-expr ctx
                                  builder
                                  mod
                                  func
                                  (Box.peek (Array.unsafe-nth elements i)))]
        ;; a unit element has no storage; its expression still ran
        (unless (unit-type? &element-monotype)
          (ignore
            (LLVM.build-store builder
                              value
                              (LLVM.build-gep builder
                                              element-type
                                              data
                                              &[(LLVM.const-int (LLVM.int64-type ctx)
                                                                (Long.from-int i)
                                                                0)]
                                              (llvm-cstr &@"aslot")))))))
    (let-do [value (LLVM.const-null (llvm-array-type ctx))
             length-value (LLVM.const-int (LLVM.int64-type ctx)
                                          (Long.from-int n)
                                          0)]
      (set! value
            (LLVM.build-insert-value builder
                                     value
                                     length-value
                                     0
                                     (llvm-cstr &@"alen")))
      (set! value
            (LLVM.build-insert-value builder
                                     value
                                     length-value
                                     1
                                     (llvm-cstr &@"acap")))
      (LLVM.build-insert-value builder value data 2 (llvm-cstr &@"abuilt")))))

(doc llvm-emit-static-array-lit "a `$[...]` literal: static storage — a
private global element array and a private global Array struct pointing at
it — with the header fields and elements stored on each evaluation, yielding
the pointer to the static Array (the C backend's `static Array` block).")
(defn llvm-emit-static-array-lit [ctx builder mod func type elements]
  (let-do [n (Array.length elements)
           element-monotype (match-ref (Box.peek type)
             (MonoType.Reference inner _)
               (match-ref (Box.peek inner)
                 (MonoType.Named _ targs)
                   (if (Int.= 1 (Array.length targs))
                     (MonoType.copy (Box.peek (Array.unsafe-nth targs 0)))
                     (Type.integer))
                 _ (Type.integer))
             _ (Type.integer))
           ;; unit elements store as bytes, GNU C's sizeof(void)
           element-type (if (unit-type? &element-monotype)
             (LLVM.int8-type ctx)
             (llvm-lower-type ctx &element-monotype))
           serial @(Array.unsafe-nth &*llvm-strlit-counter* 0)
           data-name (fmt "carp_staticarr_%d_data" serial)
           arr-name (fmt "carp_staticarr_%d" serial)
           data-global (LLVM.add-global mod
                                        (LLVM.array-type element-type n)
                                        (llvm-cstr &data-name))
           arr-global (LLVM.add-global mod
                                       (llvm-array-type ctx)
                                       (llvm-cstr &arr-name))
           n64 (LLVM.const-int (LLVM.int64-type ctx) (Long.from-int n) 0)]
    (Array.aset! &*llvm-strlit-counter* 0 (Int.inc serial))
    (LLVM.set-initializer data-global
                          (LLVM.const-null (LLVM.array-type element-type n)))
    (LLVM.set-linkage data-global LLVM.linkage-private)
    (LLVM.set-initializer arr-global (LLVM.const-null (llvm-array-type ctx)))
    (LLVM.set-linkage arr-global LLVM.linkage-private)
    (ignore
      (LLVM.build-store builder
                        n64
                        (LLVM.build-struct-gep builder
                                               (llvm-array-type ctx)
                                               arr-global
                                               0
                                               (llvm-cstr &@"salen"))))
    (ignore
      (LLVM.build-store builder
                        n64
                        (LLVM.build-struct-gep builder
                                               (llvm-array-type ctx)
                                               arr-global
                                               1
                                               (llvm-cstr &@"sacap"))))
    (ignore
      (LLVM.build-store builder
                        data-global
                        (LLVM.build-struct-gep builder
                                               (llvm-array-type ctx)
                                               arr-global
                                               2
                                               (llvm-cstr &@"sadata"))))
    (for [i 0 n]
      (let [value (llvm-emit-expr ctx
                                  builder
                                  mod
                                  func
                                  (Box.peek (Array.unsafe-nth elements i)))]
        ;; a unit element has no storage; its expression still ran
        (unless (unit-type? &element-monotype)
          (ignore
            (LLVM.build-store builder
                              value
                              (LLVM.build-gep builder
                                              element-type
                                              data-global
                                              &[(LLVM.const-int (LLVM.int64-type ctx)
                                                                (Long.from-int i)
                                                                0)]
                                              (llvm-cstr &@"saslot")))))))
    arr-global))

(defn llvm-emit-do [ctx builder mod func elements]
  (let-do [result (llvm-dummy-value ctx)
           n (Array.length elements)]
    (for [i 0 n]
      (set! result
            (llvm-emit-expr ctx
                            builder
                            mod
                            func
                            (Box.peek (Array.unsafe-nth elements i)))))
    result))

(defn llvm-emit-if [ctx builder mod func type condition then else]
  (let-do [condition-value (llvm-emit-expr ctx
                                           builder
                                           mod
                                           func
                                           (Box.peek condition))
           flag (LLVM.build-icmp builder
                                 LLVM.int-ne
                                 condition-value
                                 (LLVM.const-int (LLVM.int8-type ctx) 0l 0)
                                 (llvm-cstr &@"cond"))
           then-block (LLVM.append-block ctx func (llvm-cstr &@"then"))
           else-block (LLVM.append-block ctx func (llvm-cstr &@"else"))
           merge-block (LLVM.append-block ctx func (llvm-cstr &@"merge"))]
    (ignore (LLVM.build-cond-br builder flag then-block else-block))
    (LLVM.position-at-end builder then-block)
    (let-do [then-value (llvm-emit-expr ctx builder mod func (Box.peek then))
             then-end (LLVM.get-insert-block builder)]
      (ignore (LLVM.build-br builder merge-block))
      (LLVM.position-at-end builder else-block)
      (let-do [else-value (llvm-emit-expr ctx builder mod func (Box.peek else))
               else-end (LLVM.get-insert-block builder)]
        (ignore (LLVM.build-br builder merge-block))
        (LLVM.position-at-end builder merge-block)
        (if (unit-type? (Box.peek type))
          (llvm-dummy-value ctx)
          (let-do [phi (LLVM.build-phi builder
                                       (llvm-lower-type ctx (Box.peek type))
                                       (llvm-cstr &@"phi"))]
            (LLVM.add-incoming phi &[then-value else-value] &[then-end else-end])
            phi))))))

(defn llvm-emit-let [ctx builder mod func binder value body]
  (let-do [bound (llvm-emit-expr ctx builder mod func (Box.peek value))
           si (llvm-slot-index @(CoreRef.id binder))
           pushed false]
    (if (Int.>= si 0)
      (ignore (LLVM.build-store builder bound (llvm-slot-ptr si)))
      (do (llvm-env-push! @(CoreRef.id binder) bound) (set! pushed true)))
    (let-do [result (llvm-emit-expr ctx builder mod func (Box.peek body))]
      (when pushed (llvm-env-pop!))
      result)))

(defn llvm-emit-while [ctx builder mod func condition body]
  (let-do [cond-block (LLVM.append-block ctx func (llvm-cstr &@"whilecond"))
           body-block (LLVM.append-block ctx func (llvm-cstr &@"whilebody"))
           exit-block (LLVM.append-block ctx func (llvm-cstr &@"whileexit"))]
    (ignore (LLVM.build-br builder cond-block))
    (LLVM.position-at-end builder cond-block)
    (let-do [condition-value (llvm-emit-expr ctx
                                             builder
                                             mod
                                             func
                                             (Box.peek condition))
             flag (LLVM.build-icmp builder
                                   LLVM.int-ne
                                   condition-value
                                   (LLVM.const-int (LLVM.int8-type ctx) 0l 0)
                                   (llvm-cstr &@"whileflag"))]
      (ignore (LLVM.build-cond-br builder flag body-block exit-block))
      (LLVM.position-at-end builder body-block)
      (Array.push-back! &*llvm-break-blocks* exit-block)
      ;; `the` pins the recursive call's result type: an ignored result leaves
      ;; the mutually recursive group's return tvar unconstrained otherwise
      (ignore
        (the LLVMValue (llvm-emit-expr ctx builder mod func (Box.peek body))))
      (ignore (Array.pop-back! &*llvm-break-blocks*))
      (ignore (LLVM.build-br builder cond-block))
      (LLVM.position-at-end builder exit-block)
      (llvm-dummy-value ctx))))

(defn llvm-emit-match [ctx
                       builder
                       mod
                       func
                       id
                       type
                       by-reference
                       scrutinee
                       branches]
  (cond
    @by-reference
    ;; a by-ref match scrutinizes through the reference itself: no spill,
    ;; and bindings are field pointers
    (match (Specialize.expression-type (Box.peek scrutinee))
      (MonoType.Reference inner _)
        (llvm-emit-match-over ctx
                              builder
                              mod
                              func
                              type
                              (llvm-emit-expr ctx
                                              builder
                                              mod
                                              func
                                              (Box.peek scrutinee))
                              &(MonoType.copy (Box.peek &inner))
                              true
                              branches)
      _
        (do
          (llvm-emit-error!
            @"match-ref without a reference scrutinee in llvm backend")
          (llvm-dummy-value ctx)))
    (or
      (not (llvm-match-scrutinee-ok? (Box.peek scrutinee)))
      (Int.< (llvm-matchspill-index id) 0))
    (do
      (llvm-emit-error! @"unsupported match scrutinee in llvm backend")
      (llvm-dummy-value ctx))
    (let-do [scrutinee-value (llvm-emit-expr ctx
                                             builder
                                             mod
                                             func
                                             (Box.peek scrutinee))
             scrutinee-monotype (Specialize.expression-type (Box.peek scrutinee))
             ptr (llvm-matchspill-ptr (llvm-matchspill-index id))]
      (ignore (LLVM.build-store builder scrutinee-value ptr))
      (llvm-emit-match-over ctx
                            builder
                            mod
                            func
                            type
                            ptr
                            &scrutinee-monotype
                            false
                            branches))))

(doc llvm-emit-match-over "the shared match lowering over an addressable
scrutinee: chained pattern tests, branch bodies joined by a phi, and the C
backend's abort() when nothing matched.")
(defn llvm-emit-match-over [ctx
                            builder
                            mod
                            func
                            type
                            ptr
                            instance
                            by-ref
                            branches]
  (let-do [merge-block (LLVM.append-block ctx func (llvm-cstr &@"matchmerge"))
           incoming-values (the (Array LLVMValue) [])
           incoming-blocks (the (Array LLVMBasicBlock) [])
           n (Array.length branches)]
    (for [i 0 n]
      (let-do [branch (Array.unsafe-nth branches i)
               pattern (SpecializedMatchBranch.pattern branch)
               test (llvm-emit-pattern-test ctx builder pattern ptr instance)
               body-block (LLVM.append-block ctx func (llvm-cstr &@"matchbody"))
               next-block (LLVM.append-block ctx func (llvm-cstr &@"matchnext"))]
        (ignore (LLVM.build-cond-br builder test body-block next-block))
        (LLVM.position-at-end builder body-block)
        (let-do [pushed (llvm-bind-pattern! ctx
                                            builder
                                            pattern
                                            ptr
                                            instance
                                            by-ref)
                 body-value (llvm-emit-expr ctx
                                            builder
                                            mod
                                            func
                                            (Box.peek (SpecializedMatchBranch.body branch)))
                 end-block (LLVM.get-insert-block builder)]
          (for [k 0 pushed] (llvm-env-pop!))
          (Array.push-back! &incoming-values body-value)
          (Array.push-back! &incoming-blocks end-block)
          (ignore (LLVM.build-br builder merge-block))
          (LLVM.position-at-end builder next-block))))
    ;; no branch matched: the C backend aborts, so do the same
    (llvm-declare-abort! ctx mod)
    (ignore
      (LLVM.build-call builder
                       (llvm-void-fn-type ctx)
                       (LLVM.get-named-function mod (llvm-cstr &@"abort"))
                       &(the (Array LLVMValue) [])
                       (llvm-cstr &@"")))
    (ignore (LLVM.build-unreachable builder))
    (LLVM.position-at-end builder merge-block)
    (if (unit-type? (Box.peek type))
      (llvm-dummy-value ctx)
      (let-do [phi (LLVM.build-phi builder
                                   (llvm-lower-type ctx (Box.peek type))
                                   (llvm-cstr &@"matchphi"))]
        (LLVM.add-incoming phi &incoming-values &incoming-blocks)
        phi))))

(hidden llvm-declare-one!)
(defn llvm-declare-one! [ctx mod declaration]
  (match-ref declaration
    (BackendDeclaration.Function symbol signature _ _)
    (if (llvm-cimpl? symbol)
      (ignore
        (llvm-add-fn mod
                     &(fmt "%s_carpimpl" symbol)
                     (llvm-impl-fn-type ctx (Box.peek signature))))
      (ignore
        (LLVM.add-function mod
                           (llvm-cstr symbol)
                           (llvm-lower-function-type ctx (Box.peek signature)))))
    (BackendDeclaration.Constructor symbol signature _)
    (ignore
      (LLVM.add-function mod
                         (llvm-cstr symbol)
                         (llvm-lower-function-type ctx (Box.peek signature))))
    (BackendDeclaration.Intrinsic symbol signature external)
    (match-ref (Box.peek signature)
      (MonoType.Function _ _)
      (ignore
        (LLVM.add-function mod
                           (llvm-cstr symbol)
                           (llvm-lower-function-type ctx (Box.peek signature))))
      ;; a non-function intrinsic is a registered C constant: a header-backed
      ;; one reads through a shim getter, a builtin one is inlined at use
      _
      (when (match-ref external (Maybe.Just _) true (Maybe.Nothing) false)
        (Array.push-back! &*llvm-value-intrinsics* (String.copy symbol))))
    (BackendDeclaration.Global symbol signature _)
    ; A predefined global is storage owned by an earlier JIT module.
    (unless (unit-type? (Box.peek signature))
      (let [ty (llvm-lower-type ctx (Box.peek signature))]
        (if (llvm-predefined? symbol)
          (ignore (LLVM.add-global mod ty (llvm-cstr symbol)))
          (LLVM.set-initializer
            (LLVM.add-global mod ty (llvm-cstr symbol))
            (LLVM.const-null ty)))))
    ;; templates are C-native: declared here, defined by the C shim
    (BackendDeclaration.Template symbol signature _ _)
    (match-ref (Box.peek signature)
      (MonoType.Function _ _)
        (ignore
          (LLVM.add-function mod
                             (llvm-cstr symbol)
                             (llvm-lower-function-type ctx (Box.peek signature))))
      _
        (llvm-emit-error!
          (fmt "unsupported non-function template %s in llvm backend" symbol)))
    (BackendDeclaration.SourceTemplate symbol signature _ _ _)
    (match-ref (Box.peek signature)
      (MonoType.Function _ _)
        (ignore
          (LLVM.add-function mod
                             (llvm-cstr symbol)
                             (llvm-lower-function-type ctx (Box.peek signature))))
      _
        (llvm-emit-error!
          (fmt
            "unsupported non-function source template %s in llvm backend"
            symbol)))))

(hidden llvm-emit-slots!)
(defn llvm-emit-slots! [ctx builder]
  (do
    (for [i 0 (Array.length &*llvm-pending-ids*)]
      (llvm-slot-add!
        @(Array.unsafe-nth &*llvm-pending-ids* i)
        (LLVM.build-alloca builder
                           (llvm-lower-type ctx
                                            (Array.unsafe-nth &*llvm-pending-types*
                                                              i))
                           (llvm-cstr &@"slot"))))
    (for [i 0 (Array.length &*llvm-matchspill-pending-ids*)]
      (do
        (Array.push-back! &*llvm-matchspill-ids*
                          @(Array.unsafe-nth &*llvm-matchspill-pending-ids* i))
        (Array.push-back! &*llvm-matchspill-ptrs*
                          (LLVM.build-alloca builder
                                             (llvm-lower-type ctx
                                                              (Array.unsafe-nth &*llvm-matchspill-pending-types*
                                                                                i))
                                             (llvm-cstr &@"spill")))))
    (for [i 0 (Array.length &*llvm-argspill-pending-ids*)]
      (do
        (Array.push-back! &*llvm-argspill-ids*
                          @(Array.unsafe-nth &*llvm-argspill-pending-ids* i))
        (Array.push-back! &*llvm-argspill-pos*
                          @(Array.unsafe-nth &*llvm-argspill-pending-pos* i))
        (Array.push-back! &*llvm-argspill-ptrs*
                          (LLVM.build-alloca builder
                                             (llvm-lower-type ctx
                                                              (Array.unsafe-nth &*llvm-argspill-pending-types*
                                                                                i))
                                             (llvm-cstr &@"abislot")))))))

(doc llvm-define-impl-function! "defines a `_carpimpl` body: arguments load
from the pointer parameters, and a non-unit result stores through the
trailing out-pointer.")
(hidden llvm-define-impl-function!)
(defn llvm-define-impl-function! [ctx
                                  builder
                                  mod
                                  symbol
                                  signature
                                  parameters
                                  body]
  (match-ref (Box.peek signature)
    (MonoType.Function fargs fret)
      (let-do [func (llvm-named-fn mod &(fmt "%s_carpimpl" symbol))
               entry (LLVM.append-block ctx func (llvm-cstr &@"entry"))]
        (LLVM.position-at-end builder entry)
        (llvm-env-reset!)
        (llvm-slot-reset!)
        (llvm-pending-reset!)
        (for [i 0 (Array.length parameters)]
          (do
            (Array.push-back! &*llvm-asm-scope-names*
                              @(CoreRef.name (Array.unsafe-nth parameters i)))
            (Array.push-back! &*llvm-asm-scope-ids*
                              @(CoreRef.id (Array.unsafe-nth parameters i)))
            (Array.push-back! &*llvm-asm-scope-types*
                              (MonoType.copy (Box.peek (Array.unsafe-nth fargs i))))))
        (llvm-collect-set-targets! (Box.peek body))
        (llvm-emit-slots! ctx builder)
        (let-do [pi 0]
          (for [i 0 (Array.length parameters)]
            (let [id @(CoreRef.id (Array.unsafe-nth parameters i))]
              ;; a unit parameter is elided from the pointer protocol
              (if (unit-type? (Box.peek (Array.unsafe-nth fargs i)))
                (llvm-env-push! id (llvm-dummy-value ctx))
                (let-do [value (LLVM.build-load builder
                                                (llvm-lower-type ctx
                                                                 (Box.peek (Array.unsafe-nth fargs
                                                                                             i)))
                                                (LLVM.get-param func pi)
                                                (llvm-cstr &@"implarg"))
                         si (llvm-slot-index id)]
                  (if (Int.>= si 0)
                    (ignore (LLVM.build-store builder value (llvm-slot-ptr si)))
                    (llvm-env-push! id value))
                  (set! pi (Int.inc pi))))))
          (let [result (llvm-emit-expr ctx builder mod func (Box.peek body))]
            (if (unit-type? (Box.peek fret))
              (ignore (LLVM.build-ret-void builder))
              (do
                (ignore
                  (LLVM.build-store builder result (LLVM.get-param func pi)))
                (ignore (LLVM.build-ret-void builder)))))))
    _
      (llvm-emit-error!
        (fmt "impl function %s without function type in llvm backend" symbol))))

(hidden llvm-define-function!)
(defn llvm-define-function! [ctx builder mod symbol signature parameters body]
  (do
    (llvm-debug-enter-function! ctx
                                (LLVM.get-named-function mod (llvm-cstr symbol))
                                symbol
                                (Box.peek body))
    (if (llvm-cimpl? symbol)
      (llvm-define-impl-function! ctx
                                  builder
                                  mod
                                  symbol
                                  signature
                                  parameters
                                  body)
      (llvm-define-plain-function! ctx
                                   builder
                                   mod
                                   symbol
                                   signature
                                   parameters
                                   body))))

(hidden llvm-define-plain-function!)
(defn llvm-define-plain-function! [ctx
                                   builder
                                   mod
                                   symbol
                                   signature
                                   parameters
                                   body]
  (let-do [func (LLVM.get-named-function mod (llvm-cstr symbol))
           entry (LLVM.append-block ctx func (llvm-cstr &@"entry"))]
    (LLVM.position-at-end builder entry)
    (llvm-env-reset!)
    (llvm-slot-reset!)
    (llvm-pending-reset!)
    (match-ref (Box.peek signature)
      (MonoType.Function scope-fargs _)
        (for [i 0 (Array.length parameters)]
          (do
            (Array.push-back! &*llvm-asm-scope-names*
                              @(CoreRef.name (Array.unsafe-nth parameters i)))
            (Array.push-back! &*llvm-asm-scope-ids*
                              @(CoreRef.id (Array.unsafe-nth parameters i)))
            (Array.push-back! &*llvm-asm-scope-types*
                              (MonoType.copy
                                (Box.peek (Array.unsafe-nth scope-fargs i))))))
      _ ())
    (llvm-collect-set-targets! (Box.peek body))
    (llvm-emit-slots! ctx builder)
    (match-ref (Box.peek signature)
      (MonoType.Function fargs _)
        (let-do [pi 0]
          (for [i 0 (Array.length parameters)]
            (let [id @(CoreRef.id (Array.unsafe-nth parameters i))]
              ;; a unit parameter is elided from the LLVM signature
              (if (unit-type? (Box.peek (Array.unsafe-nth fargs i)))
                (llvm-env-push! id (llvm-dummy-value ctx))
                (let-do [si (llvm-slot-index id)]
                  (if (Int.>= si 0)
                    (ignore
                      (LLVM.build-store builder
                                        (LLVM.get-param func pi)
                                        (llvm-slot-ptr si)))
                    (llvm-env-push! id (LLVM.get-param func pi)))
                  (set! pi (Int.inc pi)))))))
      _
        (for [i 0 (Array.length parameters)]
          (let [id @(CoreRef.id (Array.unsafe-nth parameters i))
                si (llvm-slot-index id)]
            (if (Int.>= si 0)
              (ignore
                (LLVM.build-store builder
                                  (LLVM.get-param func i)
                                  (llvm-slot-ptr si)))
              (llvm-env-push! id (LLVM.get-param func i))))))
    (let [result (llvm-emit-expr ctx builder mod func (Box.peek body))]
      (if (llvm-returns-unit? (Box.peek signature))
        (ignore (LLVM.build-ret-void builder))
        (ignore (LLVM.build-ret builder result))))))

(doc llvm-define-constructor! "defines a constructor: zero an alloca of the
sum type, store the tag, overlay the variant struct on the union area via a
typed GEP to store the fields, and return the loaded whole value.")
(hidden llvm-define-constructor!)
(defn llvm-define-constructor! [ctx builder mod symbol signature decl]
  (let-do [func (LLVM.get-named-function mod (llvm-cstr symbol))
           entry (LLVM.append-block ctx func (llvm-cstr &@"entry"))
           tag @(CoreConstructorDeclaration.tag decl)]
    (LLVM.position-at-end builder entry)
    (match-ref (Box.peek signature)
      (MonoType.Function arguments ret)
        (let-do [outer-ty (llvm-lower-type ctx (Box.peek ret))
                 slot (LLVM.build-alloca builder outer-ty (llvm-cstr &@"ctor"))
                 n (Array.length arguments)]
          ;; zero the whole value first so inactive bytes are defined
          (ignore (LLVM.build-store builder (LLVM.const-null outer-ty) slot))
          ;; a single-variant type (a product) has no tag member
          (unless (Int.= 1
                         (llvm-sum-variant-count &(llvm-instance-name (Box.peek ret))))
            (ignore
              (LLVM.build-store builder
                                (LLVM.const-int (LLVM.int32-type ctx)
                                                (Long.from-int tag)
                                                0)
                                (LLVM.build-struct-gep builder
                                                       outer-ty
                                                       slot
                                                       1
                                                       (llvm-cstr &@"tagp")))))
          (when (Int.> n 0)
            (let-do [variant-ty (llvm-variant-struct ctx (Box.peek ret) tag)
                     unionp (LLVM.build-struct-gep builder
                                                   outer-ty
                                                   slot
                                                   0
                                                   (llvm-cstr &@"unionp"))
                     pi 0]
              (for [i 0 n]
                ;; a unit argument is elided from both signature and storage
                (unless-do (unit-type? (Box.peek (Array.unsafe-nth arguments i)))
                  (ignore
                    (LLVM.build-store builder
                                      (LLVM.get-param func pi)
                                      (LLVM.build-struct-gep builder
                                                             variant-ty
                                                             unionp
                                                             pi
                                                             (llvm-cstr &@"fieldp"))))
                  (set! pi (Int.inc pi))))))
          (ignore
            (LLVM.build-ret builder
                            (LLVM.build-load builder
                                             outer-ty
                                             slot
                                             (llvm-cstr &@"ctorval")))))
      _
        (llvm-emit-error!
          (fmt "constructor %s without function type in llvm backend" symbol)))))

(hidden llvm-declare-closure!)
(defn llvm-declare-closure! [ctx mod closure]
  (match-ref (Box.peek (ClosureFunction.signature closure))
    (MonoType.Function fargs fret)
      (let-do [ptr-ty (LLVM.pointer-type (LLVM.int8-type ctx) 0)
               param-types (the (Array LLVMType) [ptr-ty])
               symbol (ClosureFunction.symbol closure)]
        (for [i 0 (Array.length fargs)]
          (Array.push-back! &param-types
                            (llvm-lower-type ctx
                                             (Box.peek (Array.unsafe-nth fargs i)))))
        (if (llvm-needs-wrapper? (Box.peek (ClosureFunction.signature closure)))
          ;; an aggregate-moving closure compiles impl-style; its C-ABI
          ;; callback is the shim's adapter under the plain symbol
          (let-do [impl-params (the (Array LLVMType)
                                    [(LLVM.pointer-type (LLVM.int8-type ctx) 0)])]
            (for [i 0 (Array.length fargs)]
              (Array.push-back! &impl-params
                                (LLVM.pointer-type (LLVM.int8-type ctx) 0)))
            (unless (unit-type? (Box.peek fret))
              (Array.push-back! &impl-params
                                (LLVM.pointer-type (LLVM.int8-type ctx) 0)))
            (ignore
              (llvm-add-fn mod
                           &(fmt "%s_carpimpl" symbol)
                           (LLVM.function-type (LLVM.void-type ctx)
                                               &impl-params
                                               false)))
            (ignore
              (LLVM.add-function mod
                                 (llvm-cstr symbol)
                                 (LLVM.function-type (LLVM.void-type ctx)
                                                     &(the (Array LLVMType) [])
                                                     false))))
          (ignore
            (LLVM.add-function mod
                               (llvm-cstr symbol)
                               (LLVM.function-type (llvm-lower-type ctx
                                                                    (Box.peek fret))
                                                   &param-types
                                                   false))))
        (ignore
          (llvm-add-fn mod
                       &(fmt "%s_env_delete" symbol)
                       (LLVM.function-type (LLVM.void-type ctx) &[ptr-ty] false)))
        (ignore
          (llvm-add-fn mod
                       &(fmt "%s_env_copy" symbol)
                       (LLVM.function-type ptr-ty &[ptr-ty] false))))
    _ (llvm-emit-error! @"closure without function type in llvm backend")))

(doc llvm-define-closure! "defines a lifted closure function: the leading
parameter is the environment pointer, captures load from it (into slots when
set!), and the declared parameters follow shifted by one.")
(hidden llvm-define-closure!)
(defn llvm-define-closure! [ctx builder mod closure]
  (let-do [symbol (ClosureFunction.symbol closure)
           _debug (llvm-debug-enter-function! ctx
                                              (LLVM.get-named-function mod
                                                                       (llvm-cstr symbol))
                                              symbol
                                              (Box.peek (ClosureFunction.body closure)))
           value (if (llvm-needs-wrapper?
               (Box.peek (ClosureFunction.signature closure)))
             (llvm-define-impl-closure! ctx builder mod closure)
             (llvm-define-plain-closure! ctx builder mod closure))]
    value))

(doc llvm-define-impl-closure! "defines an aggregate-moving closure impl-style:
environment pointer first, arguments behind pointers, a non-unit result
through the trailing out-pointer.")
(hidden llvm-define-impl-closure!)
(defn llvm-define-impl-closure! [ctx builder mod closure]
  (match-ref (Box.peek (ClosureFunction.signature closure))
    (MonoType.Function fargs fret)
      (let-do [symbol (ClosureFunction.symbol closure)
               captures (ClosureFunction.captures closure)
               parameters (ClosureFunction.parameters closure)
               body (ClosureFunction.body closure)
               func (llvm-named-fn mod &(fmt "%s_carpimpl" symbol))
               entry (LLVM.append-block ctx func (llvm-cstr &@"entry"))
               env-ty (llvm-closure-env-type ctx captures)]
        (LLVM.position-at-end builder entry)
        (llvm-env-reset!)
        (llvm-slot-reset!)
        (llvm-pending-reset!)
        (llvm-collect-set-targets! (Box.peek body))
        (llvm-emit-slots! ctx builder)
        (for [i 0 (Array.length captures)]
          (let-do [capture (Array.unsafe-nth captures i)
                   id @(CoreRef.id (Pair.a capture))
                   value (LLVM.build-load builder
                                          (llvm-lower-type ctx
                                                           (Box.peek (Pair.b capture)))
                                          (LLVM.build-struct-gep builder
                                                                 env-ty
                                                                 (LLVM.get-param func
                                                                                 0)
                                                                 i
                                                                 (llvm-cstr &@"cap"))
                                          (llvm-cstr &@"capv"))
                   si (llvm-slot-index id)]
            (if (Int.>= si 0)
              (ignore (LLVM.build-store builder value (llvm-slot-ptr si)))
              (llvm-env-push! id value))))
        (for [i 0 (Array.length parameters)]
          (let-do [id @(CoreRef.id (Array.unsafe-nth parameters i))
                   value (LLVM.build-load builder
                                          (llvm-lower-type ctx
                                                           (Box.peek (Array.unsafe-nth fargs
                                                                                       i)))
                                          (LLVM.get-param func (Int.inc i))
                                          (llvm-cstr &@"implcarg"))
                   si (llvm-slot-index id)]
            (if (Int.>= si 0)
              (ignore (LLVM.build-store builder value (llvm-slot-ptr si)))
              (llvm-env-push! id value))))
        (let [result (llvm-emit-expr ctx builder mod func (Box.peek body))]
          (if (unit-type? (Box.peek fret))
            (ignore (LLVM.build-ret-void builder))
            (do
              (ignore
                (LLVM.build-store builder
                                  result
                                  (LLVM.get-param func
                                                  (Int.inc (Array.length parameters)))))
              (ignore (LLVM.build-ret-void builder))))))
    _ ()))

(hidden llvm-define-plain-closure!)
(defn llvm-define-plain-closure! [ctx builder mod closure]
  (match-ref (Box.peek (ClosureFunction.signature closure))
    (MonoType.Function _ fret)
      (let-do [symbol (ClosureFunction.symbol closure)
               captures (ClosureFunction.captures closure)
               parameters (ClosureFunction.parameters closure)
               body (ClosureFunction.body closure)
               func (LLVM.get-named-function mod (llvm-cstr symbol))
               entry (LLVM.append-block ctx func (llvm-cstr &@"entry"))
               env-ty (llvm-closure-env-type ctx captures)]
        (LLVM.position-at-end builder entry)
        (llvm-env-reset!)
        (llvm-slot-reset!)
        (llvm-pending-reset!)
        (llvm-collect-set-targets! (Box.peek body))
        (llvm-emit-slots! ctx builder)
        (for [i 0 (Array.length captures)]
          (let-do [capture (Array.unsafe-nth captures i)
                   id @(CoreRef.id (Pair.a capture))
                   value (LLVM.build-load builder
                                          (llvm-lower-type ctx
                                                           (Box.peek (Pair.b capture)))
                                          (LLVM.build-struct-gep builder
                                                                 env-ty
                                                                 (LLVM.get-param func
                                                                                 0)
                                                                 i
                                                                 (llvm-cstr &@"cap"))
                                          (llvm-cstr &@"capv"))
                   si (llvm-slot-index id)]
            (if (Int.>= si 0)
              (ignore (LLVM.build-store builder value (llvm-slot-ptr si)))
              (llvm-env-push! id value))))
        (for [i 0 (Array.length parameters)]
          (let [id @(CoreRef.id (Array.unsafe-nth parameters i))
                si (llvm-slot-index id)]
            (if (Int.>= si 0)
              (ignore
                (LLVM.build-store builder
                                  (LLVM.get-param func (Int.inc i))
                                  (llvm-slot-ptr si)))
              (llvm-env-push! id (LLVM.get-param func (Int.inc i))))))
        (let [result (llvm-emit-expr ctx builder mod func (Box.peek body))]
          (if (unit-type? (Box.peek fret))
            (ignore (LLVM.build-ret-void builder))
            (ignore (LLVM.build-ret builder result)))))
    _ ()))

(doc llvm-define-closure-env-fns! "defines the environment delete and copy
functions the constructed Lambda carries: delete runs each managed field's
deleter, copy is a malloc plus field-wise moves with managed fields deep
copied through their copiers.")
(hidden llvm-define-closure-env-fns!)
(defn llvm-define-closure-env-fns! [ctx builder mod closure]
  (let-do [symbol (ClosureFunction.symbol closure)
           captures (ClosureFunction.captures closure)
           env-ty (llvm-closure-env-type ctx captures)
           del (llvm-named-fn mod &(fmt "%s_env_delete" symbol))
           del-entry (LLVM.append-block ctx del (llvm-cstr &@"entry"))]
    (LLVM.position-at-end builder del-entry)
    (for [i 0 (Array.length captures)]
      (let [capture-type (Box.peek (Pair.b (Array.unsafe-nth captures i)))]
        (match (llvm-managed-symbol &*llvm-delete-symbols* capture-type)
          (Maybe.Just deleter)
            (if (llvm-aggregate-monotype? capture-type)
              ;; an aggregate field deletes through the pointer protocol,
              ;; straight at the field
              (let [pfnty (LLVM.function-type (LLVM.void-type ctx)
                                              &[(LLVM.pointer-type (LLVM.int8-type ctx)
                                                                   0)]
                                              false)]
                (ignore
                  (LLVM.build-call builder
                                   pfnty
                                   (llvm-runtime-fn mod
                                                    &(llvm-protocol-target &deleter)
                                                    pfnty)
                                   &[(LLVM.build-struct-gep builder
                                                            env-ty
                                                            (LLVM.get-param del
                                                                            0)
                                                            i
                                                            (llvm-cstr &@"delf"))]
                                   (llvm-cstr &@""))))
              (let [field-ty (llvm-lower-type ctx capture-type)
                    deleter-fnty (LLVM.function-type (LLVM.void-type ctx)
                                                     &[field-ty]
                                                     false)]
                (ignore
                  (LLVM.build-call builder
                                   deleter-fnty
                                   (llvm-runtime-fn mod &deleter deleter-fnty)
                                   &[(LLVM.build-load builder
                                                      field-ty
                                                      (LLVM.build-struct-gep builder
                                                                             env-ty
                                                                             (LLVM.get-param del
                                                                                             0)
                                                                             i
                                                                             (llvm-cstr &@"delf"))
                                                      (llvm-cstr &@"delv"))]
                                   (llvm-cstr &@"")))))
          (Maybe.Nothing) ())))
    (ignore (LLVM.build-ret-void builder))
    (let-do [cpy (llvm-named-fn mod &(fmt "%s_env_copy" symbol))
             cpy-entry (LLVM.append-block ctx cpy (llvm-cstr &@"entry"))
             malloc-fnty (LLVM.function-type
               (LLVM.pointer-type (LLVM.int8-type ctx) 0)
               &[(LLVM.int64-type ctx)]
               false)
             env-size (if (Int.= 0 (Array.length &*llvm-target-data*))
               8l
               (LLVM.abi-size-of-type (llvm-target-data) env-ty))]
      (LLVM.position-at-end builder cpy-entry)
      (let-do [dst (LLVM.build-call builder
                                    malloc-fnty
                                    (llvm-runtime-fn mod
                                                     &*llvm-malloc-symbol*
                                                     malloc-fnty)
                                    &[(LLVM.const-int (LLVM.int64-type ctx)
                                                      env-size
                                                      0)]
                                    (llvm-cstr &@"envdst"))]
        (for [i 0 (Array.length captures)]
          (let-do [capture-type (Box.peek (Pair.b (Array.unsafe-nth captures i)))
                   field-ty (llvm-lower-type ctx capture-type)
                   srcp (LLVM.build-struct-gep builder
                                               env-ty
                                               (LLVM.get-param cpy 0)
                                               i
                                               (llvm-cstr &@"srcf"))
                   dstp (LLVM.build-struct-gep builder
                                               env-ty
                                               dst
                                               i
                                               (llvm-cstr &@"dstf"))
                   lambda-field (match-ref capture-type
                     (MonoType.Function _ _) true
                     _ false)]
            (if lambda-field
              ;; a captured Lambda may be the letrec weak self: give the copy
              ;; its own weak self instead of aliasing (or arity-copying) the
              ;; source's, like the C backend's cycle check
              (let-do [srcv (LLVM.build-load builder
                                             field-ty
                                             srcp
                                             (llvm-cstr &@"srclam"))
                       this-fn (LLVM.get-named-function mod (llvm-cstr symbol))
                       is-self (LLVM.build-and builder
                                               (LLVM.build-icmp builder
                                                                LLVM.int-eq
                                                                (LLVM.build-extract-value builder
                                                                                          srcv
                                                                                          1
                                                                                          (llvm-cstr &@"srcenv"))
                                                                (LLVM.get-param cpy
                                                                                0)
                                                                (llvm-cstr &@"envmatch"))
                                               (LLVM.build-icmp builder
                                                                LLVM.int-eq
                                                                (LLVM.build-extract-value builder
                                                                                          srcv
                                                                                          0
                                                                                          (llvm-cstr &@"srccb"))
                                                                this-fn
                                                                (llvm-cstr &@"cbmatch"))
                                               (llvm-cstr &@"isself"))
                       self-block (LLVM.append-block ctx
                                                     cpy
                                                     (llvm-cstr &@"cpyself"))
                       other-block (LLVM.append-block ctx
                                                      cpy
                                                      (llvm-cstr &@"cpyother"))
                       done-block (LLVM.append-block ctx
                                                     cpy
                                                     (llvm-cstr &@"cpydone"))]
                (ignore
                  (LLVM.build-cond-br builder is-self self-block other-block))
                (LLVM.position-at-end builder self-block)
                (let-do [weak (LLVM.const-null (llvm-lambda-type ctx))]
                  (set! weak
                        (LLVM.build-insert-value builder
                                                 weak
                                                 this-fn
                                                 0
                                                 (llvm-cstr &@"wcb2")))
                  (set! weak
                        (LLVM.build-insert-value builder
                                                 weak
                                                 dst
                                                 1
                                                 (llvm-cstr &@"wenv2")))
                  (ignore (LLVM.build-store builder weak dstp))
                  (ignore (LLVM.build-br builder done-block)))
                (LLVM.position-at-end builder other-block)
                (match (llvm-managed-symbol &*llvm-copy-symbols* capture-type)
                  (Maybe.Just copier)
                    (let [copier-fnty (LLVM.function-type field-ty
                                                          &[(LLVM.pointer-type (LLVM.int8-type ctx)
                                                                               0)]
                                                          false)]
                      (ignore
                        (LLVM.build-store builder
                                          (LLVM.build-call builder
                                                           copier-fnty
                                                           (llvm-runtime-fn mod
                                                                            &copier
                                                                            copier-fnty)
                                                           &[(LLVM.dup &srcp)]
                                                           (llvm-cstr &@"cpv"))
                                          dstp)))
                  (Maybe.Nothing) (ignore (LLVM.build-store builder srcv dstp)))
                (ignore (LLVM.build-br builder done-block))
                (LLVM.position-at-end builder done-block))
              (match (llvm-managed-symbol &*llvm-copy-symbols* capture-type)
                (Maybe.Just copier)
                  (let [copier-fnty (LLVM.function-type field-ty
                                                        &[(LLVM.pointer-type (LLVM.int8-type ctx)
                                                                             0)]
                                                        false)]
                    (ignore
                      (LLVM.build-store builder
                                        (LLVM.build-call builder
                                                         copier-fnty
                                                         (llvm-runtime-fn mod
                                                                          &copier
                                                                          copier-fnty)
                                                         &[srcp]
                                                         (llvm-cstr &@"cpv"))
                                        dstp)))
                (Maybe.Nothing)
                  (ignore
                    (LLVM.build-store builder
                                      (LLVM.build-load builder
                                                       field-ty
                                                       srcp
                                                       (llvm-cstr &@"srcv"))
                                      dstp))))))
        (ignore (LLVM.build-ret builder dst))))))

(hidden llvm-integer-root?)
(defn llvm-integer-root? [expression]
  (match (Specialize.expression-type expression) (MonoType.Integer) true _ false))

(doc llvm-define-global-inits! "defines the synthesized function that runs
every global's initializer expression and stores the results, in declaration
order — the LLVM backend's carp_init_globals.")
(hidden llvm-define-global-inits!)
(defn llvm-define-global-inits! [ctx builder mod declarations symbol]
  (let-do [fnty (llvm-void-fn-type ctx)
           func (LLVM.add-function mod (llvm-cstr symbol) fnty)
           entry (LLVM.append-block ctx func (llvm-cstr &@"entry"))
           n (Array.length declarations)
           debug-entered false]
    (LLVM.position-at-end builder entry)
    (set! *llvm-di-scopes* [])
    (LLVM.clear-debug-location builder)
    (for [i 0 n]
      (match-ref (Array.unsafe-nth declarations i)
        (BackendDeclaration.Global global-symbol _ initializer)
          (when-do (and (not debug-entered)
                        (not (llvm-predefined? global-symbol))
                        (Int.>
                          (llvm-debug-line
                            (Specialize.expression-id (Box.peek initializer)))
                          0))
            (llvm-debug-enter-function! ctx func symbol (Box.peek initializer))
            (set! debug-entered true))
        _ ()))
    (llvm-env-reset!)
    (llvm-slot-reset!)
    (llvm-pending-reset!)
    (for [i 0 n]
      (match-ref (Array.unsafe-nth declarations i)
        (BackendDeclaration.Global global-symbol _ initializer)
          (unless (llvm-predefined? global-symbol)
            (llvm-collect-set-targets! (Box.peek initializer)))
        _ ()))
    (llvm-emit-slots! ctx builder)
    (for [i 0 n]
      (match-ref (Array.unsafe-nth declarations i)
        (BackendDeclaration.Global global-symbol signature initializer)
          (unless (llvm-predefined? global-symbol)
            (let [value (llvm-emit-expr ctx
                                        builder
                                        mod
                                        func
                                        (Box.peek initializer))]
              (unless (unit-type? (Box.peek signature))
                (let [g (LLVM.get-named-global mod (llvm-cstr global-symbol))]
                  (if (LLVM.value-null? g)
                    (llvm-emit-error!
                      (fmt "undeclared global %s in llvm backend" global-symbol))
                    (ignore (LLVM.build-store builder value g)))))))
        _ ()))
    (ignore (LLVM.build-ret-void builder))))

(hidden llvm-define-roots!)
(defn llvm-define-roots! [ctx builder mod roots symbol init-symbol]
  (let-do [fnty (LLVM.function-type (LLVM.int32-type ctx)
                                    &(the (Array LLVMType) [])
                                    false)
           func (LLVM.add-function mod (llvm-cstr symbol) fnty)
           entry (LLVM.append-block ctx func (llvm-cstr &@"entry"))
           n (Array.length roots)
           debug-entered false]
    (LLVM.position-at-end builder entry)
    (set! *llvm-di-scopes* [])
    (LLVM.clear-debug-location builder)
    (for [i 0 n]
      (let [root (Array.unsafe-nth roots i)]
        (when-do (and (not debug-entered)
                      (Int.>
                        (llvm-debug-line
                          (Specialize.expression-id (Box.peek root)))
                        0))
          (llvm-debug-enter-function! ctx func symbol (Box.peek root))
          (llvm-debug-set-builder! ctx builder (Box.peek root))
          (set! debug-entered true))))
    (llvm-env-reset!)
    (llvm-slot-reset!)
    (llvm-pending-reset!)
    (for [i 0 n]
      (llvm-collect-set-targets! (Box.peek (Array.unsafe-nth roots i))))
    (llvm-emit-slots! ctx builder)
    (ignore
      (LLVM.build-call builder
                       (llvm-void-fn-type ctx)
                       (LLVM.get-named-function mod (llvm-cstr init-symbol))
                       &(the (Array LLVMValue) [])
                       (llvm-cstr &@"")))
    (let-do [result (llvm-dummy-value ctx)]
      (for [i 0 n]
        (let [root (Array.unsafe-nth roots i)]
          (let [value (llvm-emit-expr ctx builder mod func (Box.peek root))]
            (when (llvm-integer-root? (Box.peek root)) (set! result value)))))
      (ignore (LLVM.build-ret builder result)))))

(doc llvm-append-wrapper! "appends the pointer-only C wrapper for one
C-native symbol whose signature moves aggregates: every parameter arrives by
pointer and a non-void result leaves through `carp_out`, so the C compiler
performs all aggregate ABI coercions on its side of the boundary.")
(hidden llvm-append-wrapper!)
(defn llvm-append-wrapper! [buffer symbol signature]
  (match-ref signature
    (MonoType.Function fargs fret)
      (let-do [ok true
               params (the (Array String) [])
               args (the (Array String) [])
               n (Array.length fargs)]
        (for [i 0 n]
          ;; unit parameters are elided on both sides of the boundary
          (unless (unit-type? (Box.peek (Array.unsafe-nth fargs i)))
            (match (CAbi.render-type (Box.peek (Array.unsafe-nth fargs i)))
              (Result.Success rendered)
                (do
                  (Array.push-back! &params (fmt "%s* a%d" &rendered i))
                  (Array.push-back! &args (fmt "(*a%d)" i)))
              (Result.Error _) (set! ok false))))
        (let [ret-unit (unit-type? (Box.peek fret))]
          (when ok (if ret-unit (StringBuf.append-str buffer &(fmt "
void %s_carpabi(%s) { %s(%s); }
" symbol &(String.join ", " &params) symbol &(String.join ", " &args))) (match (CAbi.render-type (Box.peek fret))
                (Result.Success rendered-ret)
                  (do
                    (Array.push-back! &params (fmt "%s* carp_out" &rendered-ret))
                    (StringBuf.append-str buffer &(fmt "
void %s_carpabi(%s) { *carp_out = %s(%s); }
" symbol &(String.join ", " &params) symbol &(String.join ", " &args))))
                (Result.Error _) ())))))
    _ ()))

(doc llvm-append-asm-thunk! "appends the scope-rebinding thunk for one asm
macro: locals named like the macro's operands are bound from the thunk's
parameters (outputs by pointer, inputs by value), the macro expands against
them, and outputs write back.")
(hidden llvm-append-asm-thunk!)
(defn llvm-append-asm-thunk! [buffer ai]
  (let-do [sym (Array.unsafe-nth &*llvm-asm-syms* ai)
           outs (Array.unsafe-nth &*llvm-asm-outs* ai)
           ins (Array.unsafe-nth &*llvm-asm-ins* ai)
           out-types (Array.unsafe-nth &*llvm-asm-out-types* ai)
           in-types (Array.unsafe-nth &*llvm-asm-in-types* ai)
           params (the (Array String) [])
           binds (the (Array String) [])
           writebacks (the (Array String) [])
           ok true]
    (if (and (Int.= 0 (Array.length outs)) (Int.= 0 (Array.length ins)))
      (StringBuf.append-str buffer &(fmt "
#ifdef %s
void carp_asmthunk_%s(void) { %s(); }
#endif
" sym sym sym))
      ;; operands recorded only once a call site resolved them
      (when-do (and
          (Int.= (Array.length outs) (Array.length out-types))
          (Int.= (Array.length ins) (Array.length in-types)))
        (for [i 0 (Array.length outs)]
          (match (CAbi.render-type (Array.unsafe-nth out-types i))
            (Result.Success rendered)
              (do
                (Array.push-back! &params (fmt "%s* carp_o%d" &rendered i))
                (Array.push-back! &binds
                                  (fmt "%s %s = *carp_o%d;"
                                       &rendered
                                       (Array.unsafe-nth outs i)
                                       i))
                (Array.push-back! &writebacks
                                  (fmt "*carp_o%d = %s;"
                                       i
                                       (Array.unsafe-nth outs i))))
            (Result.Error _) (set! ok false)))
        (for [i 0 (Array.length ins)]
          (match (CAbi.render-type (Array.unsafe-nth in-types i))
            (Result.Success rendered)
              (do
                (Array.push-back! &params (fmt "%s carp_i%d" &rendered i))
                (Array.push-back! &binds
                                  (fmt "%s %s = carp_i%d;"
                                       &rendered
                                       (Array.unsafe-nth ins i)
                                       i)))
            (Result.Error _) (set! ok false)))
        (when ok (StringBuf.append-str buffer &(fmt "
#ifdef %s
void carp_asmthunk_%s(%s) {
%s
%s();
%s
}
#endif
" sym sym &(String.join ", " &params) &(String.join "
" &binds) sym &(String.join "
" &writebacks))))))))

(doc llvm-append-impl-adapter! "appends the C-ABI adapter for one `_carpimpl`
function: the real symbol, defined in C, forwards by pointer — so the
templates' by-value calls get clang's aggregate coercions.")
(hidden llvm-append-impl-adapter!)
(defn llvm-append-impl-adapter! [buffer symbol signature]
  (match-ref signature
    (MonoType.Function fargs fret)
      (let-do [ok true
               params (the (Array String) [])
               proto-params (the (Array String) [])
               addresses (the (Array String) [])]
        (for [i 0 (Array.length fargs)]
          ;; unit parameters are elided on both sides of the boundary
          (unless (unit-type? (Box.peek (Array.unsafe-nth fargs i)))
            (match (CAbi.render-type (Box.peek (Array.unsafe-nth fargs i)))
              (Result.Success rendered)
                (do
                  (Array.push-back! &params (fmt "%s a%d" &rendered i))
                  (Array.push-back! &proto-params @"void*")
                  (Array.push-back! &addresses (fmt "(void*)&a%d" i)))
              (Result.Error _) (set! ok false))))
        (let [ret-unit (unit-type? (Box.peek fret))]
          (when ok (if ret-unit (StringBuf.append-str buffer &(fmt "
void %s_carpimpl(%s);
void %s(%s) { %s_carpimpl(%s); }
" symbol &(String.join ", " &proto-params) symbol &(String.join ", " &params) symbol &(String.join ", "
                                                                                                   &addresses))) (match (CAbi.render-type (Box.peek fret))
                (Result.Success rendered-ret)
                  (do
                    (Array.push-back! &proto-params @"void*")
                    (Array.push-back! &addresses @"(void*)&carp_out")
                    (StringBuf.append-str buffer &(fmt "
void %s_carpimpl(%s);
%s %s(%s) { %s carp_out; %s_carpimpl(%s); return carp_out; }
" symbol &(String.join ", " &proto-params) &rendered-ret symbol &(String.join ", "
                                                                              &params) &rendered-ret symbol &(String.join ", "
                                                                                                                          &addresses))))
                (Result.Error _) ())))))
    _ ()))

(doc llvm-append-closure-adapter! "appends the C-ABI callback adapter for an
aggregate-moving closure: the plain symbol, called by C template code and
invoke helpers, forwards environment plus pointered arguments to the
LLVM-side `_carpimpl`.")
(hidden llvm-append-closure-adapter!)
(defn llvm-append-closure-adapter! [buffer symbol signature]
  (match-ref signature
    (MonoType.Function fargs fret)
      (let-do [ok true
               params (the (Array String) [@"void* carp_env"])
               proto-params (the (Array String) [@"void*"])
               addresses (the (Array String) [@"carp_env"])]
        (for [i 0 (Array.length fargs)]
          ;; unit parameters are elided on both sides of the boundary
          (unless (unit-type? (Box.peek (Array.unsafe-nth fargs i)))
            (match (CAbi.render-type (Box.peek (Array.unsafe-nth fargs i)))
              (Result.Success rendered)
                (do
                  (Array.push-back! &params (fmt "%s a%d" &rendered i))
                  (Array.push-back! &proto-params @"void*")
                  (Array.push-back! &addresses (fmt "(void*)&a%d" i)))
              (Result.Error _) (set! ok false))))
        (let [ret-unit (unit-type? (Box.peek fret))]
          (when ok (if ret-unit (StringBuf.append-str buffer &(fmt "
void %s_carpimpl(%s);
void %s(%s) { %s_carpimpl(%s); }
" symbol &(String.join ", " &proto-params) symbol &(String.join ", " &params) symbol &(String.join ", "
                                                                                                   &addresses))) (match (CAbi.render-type (Box.peek fret))
                (Result.Success rendered-ret)
                  (do
                    (Array.push-back! &proto-params @"void*")
                    (Array.push-back! &addresses @"(void*)&carp_out")
                    (StringBuf.append-str buffer &(fmt "
void %s_carpimpl(%s);
%s %s(%s) { %s carp_out; %s_carpimpl(%s); return carp_out; }
" symbol &(String.join ", " &proto-params) &rendered-ret symbol &(String.join ", "
                                                                              &params) &rendered-ret symbol &(String.join ", "
                                                                                                                          &addresses))))
                (Result.Error _) ())))))
    _ ()))

(doc llvm-append-invoke-helper! "appends the C invoke helper for one
aggregate-moving indirect-call signature: it performs the env-branched
callback call with clang's ABI, reading arguments and writing the result
through pointers.")
(hidden llvm-append-invoke-helper!)
(defn llvm-append-invoke-helper! [buffer key signature]
  (match-ref signature
    (MonoType.Function fargs fret)
      (let-do [ok true
               types (the (Array String) [])
               params (the (Array String) [@"void* cb" @"void* env"])
               derefs (the (Array String) [])]
        (for [i 0 (Array.length fargs)]
          (match (CAbi.render-type (Box.peek (Array.unsafe-nth fargs i)))
            (Result.Success rendered)
              (do
                (Array.push-back! &types (String.copy &rendered))
                (Array.push-back! &params (fmt "%s* a%d" &rendered i))
                (Array.push-back! &derefs (fmt "(*a%d)" i)))
            (Result.Error _) (set! ok false)))
        (let [ret-unit (unit-type? (Box.peek fret))
              arg-types (String.join ", " &types)
              env-types (if (Int.= 0 (Array.length &types))
                @"void*"
                (String.concat &[@"void*, " (String.join ", " &types)]))
              args (String.join ", " &derefs)
              env-args (if (Int.= 0 (Array.length &derefs))
                @"env"
                (String.concat &[@"env, " (String.join ", " &derefs)]))]
          (when ok (if ret-unit (StringBuf.append-str buffer &(fmt "
void carp_invoke_%s(%s) { if (env) { ((void(*)(%s))cb)(%s); } else { ((void(*)(%s))cb)(%s); } }
" key &(String.join ", " &params) &env-types &env-args &arg-types &args)) (match (CAbi.render-type (Box.peek fret))
                (Result.Success rendered-ret)
                  (do
                    (Array.push-back! &params (fmt "%s* carp_out" &rendered-ret))
                    (StringBuf.append-str buffer &(fmt "
void carp_invoke_%s(%s) { if (env) { *carp_out = ((%s(*)(%s))cb)(%s); } else { *carp_out = ((%s(*)(%s))cb)(%s); } }
" key &(String.join ", " &params) &rendered-ret &env-types &env-args &rendered-ret &arg-types &args)))
                (Result.Error _) ())))))
    _ ()))

(defmodule LLVMBackend
  (doc roots-symbol "the name of the synthesized function holding the module's
top-level expressions. It runs the global initializers first (see
`init-symbol`) and returns the value of the last Int-typed top-level
expression, or 0.")
  (defn roots-symbol [] @"carp_llvm_roots")

  (doc init-symbol "the name of the synthesized function that runs the global
initializers — the LLVM backend's carp_init_globals. The roots function calls
it first; a client JIT-calling individual functions must call it once itself.")
  (defn init-symbol [] @"carp_llvm_init_globals")

  (doc sum-layout "the `(size, tag-offset)` in bytes of a sum type's lowered
layout under `td`, for parity checks against the C backend's struct.")
  (defn sum-layout [ctx td backend name]
    (do
      (set! *llvm-backend-constructors*
            (Array.copy (BackendModule.constructors backend)))
      (set! *llvm-sum-names* [])
      (set! *llvm-sum-types* [])
      (set! *llvm-target-data* [td])
      (let [ty (llvm-sum-type-for ctx
                                  &(Type.named name
                                               (the (Array (Box MonoType)) [])))]
        (Pair.init
          (Long.to-int (LLVM.abi-size-of-type td ty))
          (Long.to-int (LLVM.offset-of-element td ty 1))))))

  (doc shim-translation-unit "renders the C-native declarations — deftemplate
sources and primitive templates — plus whatever typedefs their signatures
need into a C translation unit with no entry point: the shim a build compiles
with a C compiler and links (or dlopens for the JIT) beside the emitted LLVM
module. Only scalars may cross the LLVM/C call boundary until the ABI-wrapper
work lands; aggregate parameters and returns need the C compiler's coercions.")
  (defn shim-translation-unit [backend]
    (let-do [filtered (the (Array BackendDeclaration) [])
             template-symbols (the (Array String) [])
             declarations (BackendModule.declarations backend)]
      (for [i 0 (Array.length declarations)]
        (match-ref (Array.unsafe-nth declarations i)
          (BackendDeclaration.Template symbol _ _ _)
            (do
              (Array.push-back! &template-symbols (String.copy symbol))
              (Array.push-back! &filtered @(Array.unsafe-nth declarations i)))
          (BackendDeclaration.SourceTemplate symbol _ _ _ _)
            (do
              (Array.push-back! &template-symbols (String.copy symbol))
              (Array.push-back! &filtered @(Array.unsafe-nth declarations i)))
          _ ()))
      ;; a header-backed intrinsic must NOT get our prototype (const-qualifier
      ;; conflicts with the header's own declaration)
      (for [i 0 (Array.length declarations)]
        (match-ref (Array.unsafe-nth declarations i)
          (BackendDeclaration.Intrinsic symbol _ external)
            (when (match-ref external (Maybe.Just _) true (Maybe.Nothing) false)
              (Array.push-back! &template-symbols (String.copy symbol)))
          _ ()))
      ;; the adapters, wrappers, and invoke helpers appended below reference
      ;; types by their C names: carry their signatures as declaration-only
      ;; intrinsics so the nominal typedef pass renders every instance type
      ;; they mention (the carrier prototypes themselves are unused externs)
      (for [i 0 (Array.length &*llvm-invoke-keys*)]
        (Array.push-back! &filtered
                          (BackendDeclaration.Intrinsic
                            (fmt "carp_sig_%s"
                                 (Array.unsafe-nth &*llvm-invoke-keys* i))
                            (Box.init
                              (MonoType.copy (Array.unsafe-nth &*llvm-invoke-sigs*
                                                               i)))
                            (the (Maybe String) (Maybe.Nothing)))))
      (for [i 0 (Array.length &*llvm-preproc-syms*)]
        (when (llvm-needs-wrapper? (Array.unsafe-nth &*llvm-preproc-sigs* i))
          (Array.push-back! &filtered
                            (BackendDeclaration.Intrinsic
                              (fmt "%s_carpsig"
                                   (Array.unsafe-nth &*llvm-preproc-syms* i))
                              (Box.init
                                (MonoType.copy
                                  (Array.unsafe-nth &*llvm-preproc-sigs* i)))
                              (the (Maybe String) (Maybe.Nothing))))))
      (let [shim-closures (BackendModule.closure-functions backend)]
        (for [i 0 (Array.length shim-closures)]
          (let [closure (Array.unsafe-nth shim-closures i)]
            (when (llvm-needs-wrapper?
                (Box.peek (ClosureFunction.signature closure)))
              (Array.push-back! &filtered
                                (BackendDeclaration.Intrinsic
                                  (fmt "%s_carpsig"
                                       (ClosureFunction.symbol closure))
                                  (Box.init
                                    (MonoType.copy
                                      (Box.peek (ClosureFunction.signature closure))))
                                  (the (Maybe String) (Maybe.Nothing))))))))
      (for [i 0 (Array.length declarations)]
        (match-ref (Array.unsafe-nth declarations i)
          (BackendDeclaration.Function symbol signature _ _)
            (when (llvm-cimpl? symbol)
              (Array.push-back! &filtered
                                (BackendDeclaration.Intrinsic (fmt "%s_carpsig"
                                                                   symbol)
                                                              (Box.init (MonoType.copy (Box.peek signature)))
                                                              (the (Maybe String)
                                                                   (Maybe.Nothing)))))
          _ ()))
      ;; a template's dependencies live on the LLVM side (specialized
      ;; deleters/copiers): give the shim their prototypes, as declaration-only
      ;; intrinsics, so the template definitions compile
      (for [i 0 (Array.length declarations)]
        (match-ref (Array.unsafe-nth declarations i)
          (BackendDeclaration.Template _ _ _ dependencies)
            (for [j 0 (Array.length dependencies)]
              (let-do [dep (Array.unsafe-nth dependencies j)
                       dep-symbol (BackendDependency.symbol dep)
                       known false]
                (for [k 0 (Array.length &template-symbols)]
                  (when (String.= (Array.unsafe-nth &template-symbols k)
                                  dep-symbol)
                    (set! known true)))
                (unless-do known
                  (Array.push-back! &template-symbols (String.copy dep-symbol))
                  (Array.push-back! &filtered
                                    (BackendDeclaration.Intrinsic (String.copy dep-symbol)
                                                                  (Box.init
                                                                    (MonoType.copy
                                                                      (Box.peek (BackendDependency.signature dep))))
                                                                  (the (Maybe String)
                                                                       (Maybe.Nothing)))))))
          _ ()))
      (match (CBackend.translation-unit
          &(BackendModule.init filtered
                               (the (Array (Box SpecializedExpr)) [])
                               (Array.copy (BackendModule.constructors backend))
                               (Array.copy (BackendModule.system-includes backend))
                               (the (Array ClosureFunction) [])
                               (Array.copy (BackendModule.delete-symbols backend))
                               (Array.copy (BackendModule.copy-symbols backend))
                               (BackendLineMap.empty)))
        (Result.Success unit-c)
          (let-do [buffer (StringBuf.create)
                   emitted-getters (the (Array String) [])]
            (StringBuf.append-str &buffer &unit-c)
            ;; heap helpers keeping CARP_MALLOC/CARP_FREE (and LOG_MEMORY) in
            ;; the loop for IR-side allocations
            (StringBuf.append-str &buffer "
void* carp_llvm_malloc(size_t n) { return CARP_MALLOC(n); }
void carp_llvm_free(void* p) { CARP_FREE(p); }
")
            (for [i 0 (Array.length declarations)]
              (match-ref (Array.unsafe-nth declarations i)
                (BackendDeclaration.Template symbol signature _ _)
                (when (llvm-needs-wrapper? (Box.peek signature))
                  (llvm-append-wrapper! &buffer symbol (Box.peek signature)))
                (BackendDeclaration.SourceTemplate symbol signature _ _ _)
                (when (llvm-needs-wrapper? (Box.peek signature))
                  (llvm-append-wrapper! &buffer symbol (Box.peek signature)))
                ;; only header-backed registered functions (Just) get a
                ;; wrapper; a Nothing intrinsic is a builtin the emitter
                ;; special-cases inline and never calls. A header-backed
                ;; non-function intrinsic (a C constant) gets a value getter.
                (BackendDeclaration.Intrinsic symbol signature external)
                (when (match-ref external
                    (Maybe.Just _) true
                    (Maybe.Nothing) false)
                  (match-ref (Box.peek signature)
                    (MonoType.Function _ _)
                      (when (llvm-needs-wrapper? (Box.peek signature))
                        (llvm-append-wrapper! &buffer
                                              symbol
                                              (Box.peek signature)))
                    _
                      (let-do [dup false]
                        (for [k 0 (Array.length &emitted-getters)]
                          (when (String.= (Array.unsafe-nth &emitted-getters k)
                                          symbol)
                            (set! dup true)))
                        (unless-do dup
                          (Array.push-back! &emitted-getters
                                            (String.copy symbol))
                          (match (CAbi.render-type (Box.peek signature))
                            (Result.Success rendered)
                              (if (llvm-aggregate-monotype? (Box.peek signature))
                                (StringBuf.append-str &buffer &(fmt "
void %s_carpvalue(%s* carp_out) { *carp_out = %s; }
" symbol &rendered symbol))
                                (StringBuf.append-str &buffer &(fmt "
%s %s_carpvalue(void) { return %s; }
" &rendered symbol symbol)))
                            (Result.Error _) ())))))
                _
                ()))
            (for [i 0 (Array.length declarations)]
              (match-ref (Array.unsafe-nth declarations i)
                (BackendDeclaration.Function symbol signature _ _)
                  (when (llvm-cimpl? symbol)
                    (llvm-append-impl-adapter! &buffer
                                               symbol
                                               (Box.peek signature)))
                _ ()))
            (for [i 0 (Array.length &*llvm-preproc-syms*)]
              (when (llvm-needs-wrapper?
                  (Array.unsafe-nth &*llvm-preproc-sigs* i))
                (llvm-append-wrapper! &buffer
                                      (Array.unsafe-nth &*llvm-preproc-syms* i)
                                      (Array.unsafe-nth &*llvm-preproc-sigs* i))))
            ;; aggregate-moving closures: the C-ABI callback adapter under the
            ;; plain symbol, forwarding by pointer to the LLVM-side impl
            (let [closures (BackendModule.closure-functions backend)]
              (for [i 0 (Array.length closures)]
                (let [closure (Array.unsafe-nth closures i)]
                  (when (llvm-needs-wrapper?
                      (Box.peek (ClosureFunction.signature closure)))
                    (llvm-append-closure-adapter! &buffer
                                                  (ClosureFunction.symbol closure)
                                                  (Box.peek (ClosureFunction.signature closure)))))))
            ;; per-signature invoke helpers for aggregate-moving indirect calls
            (for [i 0 (Array.length &*llvm-invoke-keys*)]
              (llvm-append-invoke-helper! &buffer
                                          (Array.unsafe-nth &*llvm-invoke-keys*
                                                            i)
                                          (Array.unsafe-nth &*llvm-invoke-sigs*
                                                            i)))
            ;; scope-rebinding thunks for asm macros
            (for [i 0 (Array.length &*llvm-asm-syms*)]
              (llvm-append-asm-thunk! &buffer i))
            (Result.Success (StringBuf.to-string &buffer)))
        (Result.Error error) (Result.Error error))))

  (doc defined-symbols "returns every symbol this backend module publishes:
functions, constructors, globals, closures, and closure environment helpers.")
  (defn defined-symbols [backend]
    (let-do [symbols (the (Array String) [])
             declarations (BackendModule.declarations backend)]
      (for [i 0 (Array.length declarations)]
        (match-ref (Array.unsafe-nth declarations i)
          (BackendDeclaration.Function symbol _ _ _)
            (Array.push-back! &symbols (String.copy symbol))
          (BackendDeclaration.Constructor symbol _ _)
            (Array.push-back! &symbols (String.copy symbol))
          (BackendDeclaration.Global symbol _ _)
            (Array.push-back! &symbols (String.copy symbol))
          _ ()))
      (let [closures (BackendModule.closure-functions backend)]
        (for [i 0 (Array.length closures)]
          (let-do [symbol (ClosureFunction.symbol (Array.unsafe-nth closures i))]
            (Array.push-back! &symbols (String.copy symbol))
            (Array.push-back! &symbols (fmt "%s_env_delete" symbol))
            (Array.push-back! &symbols (fmt "%s_env_copy" symbol)))))
      symbols))

  (doc use-carp-allocator! "routes IR-side heap operations through the shim's
carp_llvm_malloc/free helpers (CARP_MALLOC/CARP_FREE, honoring LOG_MEMORY).
Call once before emitting; builds that link no shim must not use it.")
  (defn use-carp-allocator! []
    (do
      (set! *llvm-malloc-symbol* @"carp_llvm_malloc")
      (set! *llvm-free-symbol* @"carp_llvm_free")))

  (doc emit-module "lowers `backend` into the LLVM module `mod`: declares every
function, constructor, and intrinsic, defines the function and constructor
bodies, and collects the top-level expressions into one function named by
`roots-symbol`. Returns () or the collected emission errors. The scope is the
simple and nominal example tiers; constructs beyond it are reported, never
mis-lowered.")
  (private emit-module-with)
  (hidden emit-module-with)
  (defn emit-module-with [ctx
                          builder
                          mod
                          td
                          backend
                          predefined
                          roots-name
                          init-name]
    (do
      (set! *llvm-backend-errors* [])
      (set! *llvm-predefined-symbols* (Array.copy predefined))
      (llvm-debug-begin! ctx mod (BackendModule.line-map backend))
      (set! *llvm-backend-constructors*
            (Array.copy (BackendModule.constructors backend)))
      (set! *llvm-sum-names* [])
      (set! *llvm-sum-types* [])
      (set! *llvm-target-data* [td])
      (set! *llvm-cnative-symbols* [])
      (set! *llvm-value-intrinsics* [])
      (set! *llvm-external-keys* [])
      (set! *llvm-external-fields* [])
      (set! *llvm-cimpl-symbols* [])
      (set! *llvm-declared-symbols* [])
      (set! *llvm-function-symbols* [])
      (set! *llvm-preproc-syms* [])
      (set! *llvm-preproc-sigs* [])
      (set! *llvm-asm-syms* [])
      (set! *llvm-asm-outs* [])
      (set! *llvm-asm-ins* [])
      (set! *llvm-asm-out-types* [])
      (set! *llvm-asm-in-types* [])
      (set! *llvm-asm-call-ids* [])
      (set! *llvm-asm-call-outs* [])
      (set! *llvm-asm-call-ins* [])
      (llvm-scan-asm-defines! (BackendModule.system-includes backend))
      (set! *llvm-getterlay-keys* [])
      (set! *llvm-getterlay-fields* [])
      (set! *llvm-getterlay-seen* [])
      (set! *llvm-closures*
            (Array.copy (BackendModule.closure-functions backend)))
      (set! *llvm-delete-symbols*
            (Array.copy (BackendModule.delete-symbols backend)))
      (set! *llvm-copy-symbols*
            (Array.copy (BackendModule.copy-symbols backend)))
      (let-do [declarations (BackendModule.declarations backend)
               n (Array.length declarations)]
        (for [i 0 n]
          (match-ref (Array.unsafe-nth declarations i)
            (BackendDeclaration.Template symbol _ _ _)
              (Array.push-back! &*llvm-cnative-symbols* (String.copy symbol))
            (BackendDeclaration.SourceTemplate symbol _ _ _ _)
              (Array.push-back! &*llvm-cnative-symbols* (String.copy symbol))
            (BackendDeclaration.Intrinsic symbol _ external)
              (when (match-ref external
                  (Maybe.Just _) true
                  (Maybe.Nothing) false)
                (Array.push-back! &*llvm-cnative-symbols* (String.copy symbol)))
            _ ()))
        (for [i 0 n]
          (match-ref (Array.unsafe-nth declarations i)
            (BackendDeclaration.SourceTemplate _ signature _ _ _)
              (llvm-collect-external-layout! (Box.peek signature))
            _ ()))
        (let-do [function-symbols (the (Array String) [])]
          (for [i 0 n]
            (match-ref (Array.unsafe-nth declarations i)
              (BackendDeclaration.Function symbol _ _ _)
                (Array.push-back! &function-symbols (String.copy symbol))
              _ ()))
          (for [i 0 n]
            (match-ref (Array.unsafe-nth declarations i)
              (BackendDeclaration.Template _ _ _ dependencies)
                (for [j 0 (Array.length dependencies)]
                  (let-do [dep (Array.unsafe-nth dependencies j)
                           dep-is-function false]
                    (for [k 0 (Array.length &function-symbols)]
                      (when (String.= (Array.unsafe-nth &function-symbols k)
                                      (BackendDependency.symbol dep))
                        (set! dep-is-function true)))
                    ;; only LLVM-side functions need the impl treatment:
                    ;; template and header-backed dependencies are C-side
                    ;; already, with clang doing their aggregate ABI
                    (when (and dep-is-function
                               (and
                                 (llvm-needs-wrapper?
                                   (Box.peek (BackendDependency.signature dep)))
                                 (not
                                   (llvm-cimpl? (BackendDependency.symbol dep)))))
                      (Array.push-back! &*llvm-cimpl-symbols*
                                        (String.copy (BackendDependency.symbol dep))))))
              _ ())))
        (for [i 0 n]
          (match-ref (Array.unsafe-nth declarations i)
            (BackendDeclaration.Function symbol _ _ _)
              (do
                (Array.push-back! &*llvm-function-symbols* (String.copy symbol))
                (Array.push-back! &*llvm-declared-symbols* (String.copy symbol)))
            (BackendDeclaration.Global symbol _ _)
              (Array.push-back! &*llvm-declared-symbols* (String.copy symbol))
            (BackendDeclaration.Intrinsic symbol _ external)
              (when (match-ref external
                  (Maybe.Just _) true
                  (Maybe.Nothing) false)
                (Array.push-back! &*llvm-declared-symbols* (String.copy symbol)))
            (BackendDeclaration.Constructor symbol _ _)
              (Array.push-back! &*llvm-declared-symbols* (String.copy symbol))
            (BackendDeclaration.Template symbol _ _ _)
              (Array.push-back! &*llvm-declared-symbols* (String.copy symbol))
            (BackendDeclaration.SourceTemplate symbol _ _ _ _)
              (Array.push-back! &*llvm-declared-symbols* (String.copy symbol))))
        (for [i 0 n]
          (match-ref (Array.unsafe-nth declarations i)
            (BackendDeclaration.Function _ _ _ body)
              (llvm-collect-init-calls! (Box.peek body))
            (BackendDeclaration.Global _ _ initializer)
              (llvm-collect-init-calls! (Box.peek initializer))
            _ ()))
        (let [roots (BackendModule.roots backend)]
          (for [i 0 (Array.length roots)]
            (llvm-collect-init-calls! (Box.peek (Array.unsafe-nth roots i)))))
        (for [i 0 (Array.length &*llvm-closures*)]
          (llvm-collect-init-calls!
            (Box.peek
              (ClosureFunction.body (Array.unsafe-nth &*llvm-closures* i)))))
        ;; preprocessor-provided functions are C-native for wrapper purposes
        (for [i 0 (Array.length &*llvm-preproc-syms*)]
          (Array.push-back! &*llvm-cnative-symbols*
                            (String.copy
                              (Array.unsafe-nth &*llvm-preproc-syms* i))))
        (for [i 0 n]
          (llvm-declare-one! ctx mod (Array.unsafe-nth declarations i)))
        (for [i 0 (Array.length &*llvm-closures*)]
          (llvm-declare-closure! ctx mod (Array.unsafe-nth &*llvm-closures* i)))
        (for [i 0 n]
          (match-ref (Array.unsafe-nth declarations i)
            (BackendDeclaration.Function symbol signature parameters body)
              (unless (llvm-predefined? symbol)
                (llvm-define-function! ctx
                                       builder
                                       mod
                                       symbol
                                       signature
                                       parameters
                                       body))
            (BackendDeclaration.Constructor symbol signature decl)
              (unless (llvm-predefined? symbol)
                (llvm-define-constructor! ctx builder mod symbol signature decl))
            _ ()))
        (for [i 0 (Array.length &*llvm-closures*)]
          (unless-do (llvm-predefined?
              (ClosureFunction.symbol (Array.unsafe-nth &*llvm-closures* i)))
            (llvm-define-closure! ctx
                                  builder
                                  mod
                                  (Array.unsafe-nth &*llvm-closures* i))
            (llvm-define-closure-env-fns! ctx
                                          builder
                                          mod
                                          (Array.unsafe-nth &*llvm-closures* i))))
        (llvm-define-global-inits! ctx builder mod declarations init-name)
        (llvm-define-roots! ctx
                            builder
                            mod
                            (BackendModule.roots backend)
                            roots-name
                            init-name)
        (let-do [result (if (Int.= 0 (Array.length &*llvm-backend-errors*))
                   (Result.Success ())
                   (Result.Error (String.join "; " &*llvm-backend-errors*)))]
          (llvm-debug-finish!)
          result))))

  (doc emit-module-incremental "emits one module for a persistent JIT. Symbols
already present in `predefined` remain external declarations, their globals
retain storage and values, and the cell receives unique initializer and roots
symbols.")
  (defn emit-module-incremental [ctx
                                 builder
                                 mod
                                 td
                                 backend
                                 predefined
                                 roots-name
                                 init-name]
    (emit-module-with ctx builder mod td backend predefined roots-name init-name))

  (defn emit-module [ctx builder mod td backend]
    (emit-module-with ctx
                      builder
                      mod
                      td
                      backend
                      &(the (Array String) [])
                      &(roots-symbol)
                      &(init-symbol))))
