(load "git@github.com:carpentry-org/carp-reader@0.5.0")
(load "../carp-source/carp-source.carp")

(doc SurfaceSpan "is the source range of a syntax node. `start` and `end` are
reader positions, end exclusive. `source` is the id of its file in the source
table, or `no-source`. `origin` is the range the node was written at, if it was
written by the caller.")
(doc SurfaceOrigin "is the range a node was written at. `source` is the id of
its file, and `start` and `end` its byte offsets. `direct` is whether the node's
span still covers this range. `content-end` is where the content of a container
ends. It is the end of the node unless `with-content-end` moved it.")
(deftype SurfaceOrigin
  [source Int
   start Int
   end Int
   direct Bool
   content-end Info])

(deftype SurfaceSpan
  [start Info
   end Info
   source Int
   origin (Maybe SurfaceOrigin)])

(doc *surface-sources* "is the source table: the names of the files that spans
refer to. A span stores an index into it, not the name.")
(def *surface-sources* (the (Array String) []))

(doc *surface-source-id* "is the name of the file being parsed, or the empty
string.")
(def *surface-source-id* @"")

(doc *surface-source-index* "is the id of the file being parsed, or `no-source`.
New spans get this id.")
(def *surface-source-index* -1)

(doc no-source "returns the source id of syntax that has no file.")
(defn no-source [] -1)

(doc intern-source! "returns the id of the file `name` in the source table, and
adds it if it is new.")
(defn intern-source! [name]
  (let-do [found -1
           n (Array.length &*surface-sources*)]
    (for [i 0 n]
      (when (and (Int.< found 0)
                 (String.= (Array.unsafe-nth &*surface-sources* i) name))
        (set! found i)))
    (when-do (Int.< found 0)
      (Array.push-back! &*surface-sources* (String.copy name))
      (set! found (Int.dec (Array.length &*surface-sources*))))
    found))

(doc source-name "returns the file name of source id `id`, or the empty string.")
(defn source-name [id]
  (if (or (Int.< id 0) (Int.>= id (Array.length &*surface-sources*)))
    (String.copy "")
    (String.copy (Array.unsafe-nth &*surface-sources* id))))

(doc source-watermark "returns the number of files in the source table, for
`release-sources!`.")
(defn source-watermark [] (Array.length &*surface-sources*))

(doc release-sources! "removes the files added to the source table after
`watermark`. Their ids are given out again, so spans that use them would name
the wrong file. Call it only when those spans are discarded.")
(defn release-sources! [watermark]
  (when (and (Int.>= watermark 0)
             (Int.< watermark (Array.length &*surface-sources*)))
    (let-do [kept (the (Array String) [])]
      (for [i 0 watermark]
        (Array.push-back! &kept
                          (String.copy (Array.unsafe-nth &*surface-sources* i))))
      (set! *surface-sources* kept))))

(defmodule SurfaceSpan
  (doc with-content-end "returns `span` with the content end of its origin set
to `point`. A span without an origin is returned unchanged.")
  (defn with-content-end [span point]
    (let [origin (match-ref (SurfaceSpan.origin span)
            (Maybe.Nothing) (the (Maybe SurfaceOrigin) (Maybe.Nothing))
            (Maybe.Just original)
              (let-do [bounded (SurfaceOrigin.copy original)]
                (SurfaceOrigin.set-content-end! &bounded @point)
                (Maybe.Just bounded)))]
      (SurfaceSpan.init @(SurfaceSpan.start span)
                        @(SurfaceSpan.end span)
                        @(SurfaceSpan.source span)
                        origin)))

  (doc from-reader "returns the span from `begin` to `end` in the file being
parsed. If both positions are real, the span records them as its origin.")
  (defn from-reader [begin end]
    (SurfaceSpan.init @begin
                      @end
                      *surface-source-index*
                      (if (and (Int.> @(Info.line begin) 0)
                               (Int.> @(Info.line end) 0))
                        (Maybe.Just
                          (SurfaceOrigin.init *surface-source-index*
                                              @(Info.pos begin)
                                              @(Info.pos end)
                                              true
                                              @end))
                        (Maybe.Nothing))))

  (doc from-located "returns the span of the reader node `located`, in the file
being parsed.")
  (defn from-located [located]
    (from-reader (Located.info located) (Located.end located)))

  (doc anywhere "returns a span with no position and no file, for syntax a phase
makes up.")
  (defn anywhere []
    (SurfaceSpan.init (Info.init 0 0 0)
                      (Info.init 0 0 0)
                      (no-source)
                      (Maybe.Nothing)))

  (doc at "returns a span from `start` to `end` with no file, for syntax built
from parts.")
  (defn at [start end] (SurfaceSpan.init start end (no-source) (Maybe.Nothing)))

  (doc byte-start "returns the byte offset where `span` starts.")
  (defn byte-start [span] @(Info.pos (SurfaceSpan.start span)))

  (doc byte-end "returns the byte offset where `span` ends, exclusive.")
  (defn byte-end [span] @(Info.pos (SurfaceSpan.end span)))

  (doc in-source "returns `span` as a `SourceSpan`. It uses the span's own file
if it has one, and `source-id` otherwise.")
  (defn in-source [span source-id]
    (SourceSpan.init
      (let [own (source-name @(SurfaceSpan.source span))]
        (if (String.empty? &own) (String.copy source-id) own))
      (byte-start span)
      (byte-end span))))

(doc SurfaceForm "is a Carp form after reading. Its children are `SurfaceNode`s.
Each constructor holds one kind of form: `IntLit`, `ByteLit`, `LongLit`,
`FloatLit`, `DoubleLit`, `BoolLit`, `CharLit`, `StringLit` and `PatternLit` hold
literals. `Symbol` holds the segments of a symbol. `List`, `Array`,
`StaticArray` and `Dictionary` hold their elements. `Comment` holds a comment's
text. `Invalid` holds text that is not a form. It keeps every form, comments
included, but resolves no names and interprets no special forms.")
(deftype SurfaceForm
  (IntLit [Int])
  (ByteLit [Byte])
  (LongLit [Long])
  (FloatLit [Float])
  (DoubleLit [Double])
  (BoolLit [Bool])
  (CharLit [Char])
  (StringLit [String])
  (PatternLit [String])
  (Symbol [(Array String)])
  (List [(Array (Box SurfaceNode))])
  (Array [(Array (Box SurfaceNode))])
  (StaticArray [(Array (Box SurfaceNode))])
  (Dictionary [(Array (Box SurfaceNode))])
  (Comment [String])
  (Invalid [String]))

(doc SurfaceNode "is a `SurfaceForm` with its span. `span` is where diagnostics
point. `form` is the form.")
(deftype SurfaceNode [span SurfaceSpan
                      form SurfaceForm])

(doc SurfaceModule "is the forms of a source, in order. `forms` holds them.")
(deftype SurfaceModule [forms (Array (Box SurfaceNode))])

(doc SourcedSurfaceModule "is a parsed source with its input. `input` is the
source and its id. `module` is the parsed forms.")
(deftype SourcedSurfaceModule [input SourceInput
                               module SurfaceModule])

(defmodule SurfaceSpan
  (doc generated "returns `span` without its origin, for syntax the compiler
made.")
  (defn generated [span]
    (SurfaceSpan.init @(SurfaceSpan.start span)
                      @(SurfaceSpan.end span)
                      @(SurfaceSpan.source span)
                      (Maybe.Nothing)))

  (doc reanchored "returns the span `blame` with the origin of `span`. The
origin stays direct only if it lies inside `blame` in the same file.")
  (defn reanchored [span blame]
    (let [origin (match-ref (SurfaceSpan.origin span)
            (Maybe.Nothing) (the (Maybe SurfaceOrigin) (Maybe.Nothing))
            (Maybe.Just original)
              (let-do [retained (SurfaceOrigin.copy original)]
                (SurfaceOrigin.set-direct! &retained
                                           (and @(SurfaceOrigin.direct original)
                                                (and
                                                  (Int.= @(SurfaceOrigin.source original)
                                                         @(SurfaceSpan.source blame))
                                                  (and
                                                    (Int.>= @(SurfaceOrigin.start original)
                                                            (byte-start blame))
                                                    (Int.<= @(SurfaceOrigin.end original)
                                                            (byte-end blame))))))
                (Maybe.Just retained)))]
      (SurfaceSpan.init @(SurfaceSpan.start blame)
                        @(SurfaceSpan.end blame)
                        @(SurfaceSpan.source blame)
                        origin)))

  (doc missing-at-end "returns an empty span at the end of `span`, for an
expression that is missing. It keeps an origin only if `span` has a direct one.")
  (defn missing-at-end [span]
    (let [point (match-ref (SurfaceSpan.origin span)
            (Maybe.Just origin)
              (if @(SurfaceOrigin.direct origin)
                @(SurfaceOrigin.content-end origin)
                @(SurfaceSpan.end span))
            (Maybe.Nothing) @(SurfaceSpan.end span))
          origin (match-ref (SurfaceSpan.origin span)
            (Maybe.Just original)
              (if @(SurfaceOrigin.direct original)
                (Maybe.Just
                  (SurfaceOrigin.init @(SurfaceOrigin.source original)
                                      @(Info.pos &point)
                                      @(Info.pos &point)
                                      true
                                      @&point))
                (Maybe.Nothing))
            (Maybe.Nothing) (Maybe.Nothing))]
      (SurfaceSpan.init @&point @&point @(SurfaceSpan.source span) origin)))

  (doc original-in-source "returns the range the node was written at, if its
origin is direct. Unlike `in-source`, it does not change when the node is moved
by expansion.")
  (defn original-in-source [span source-id]
    (match-ref (SurfaceSpan.origin span)
      (Maybe.Nothing) (the (Maybe SourceSpan) (Maybe.Nothing))
      (Maybe.Just origin)
        (if @(SurfaceOrigin.direct origin)
          (Maybe.Just
            (SourceSpan.init
              (let [own (source-name @(SurfaceOrigin.source origin))]
                (if (String.empty? &own) (String.copy source-id) own))
              @(SurfaceOrigin.start origin)
              @(SurfaceOrigin.end origin)))
          (Maybe.Nothing))))

  (doc written-region "returns the written range of `container` from the end of
`boundary` to the container's content end, if both have direct origins. The
content end is only before the closing token if it was set with
`with-content-end`.")
  (defn written-region [container boundary source]
    (match (original-in-source container source)
      (Maybe.Nothing) (the (Maybe SourceSpan) (Maybe.Nothing))
      (Maybe.Just outer)
        (match (original-in-source boundary source)
          (Maybe.Nothing) (Maybe.Nothing)
          (Maybe.Just lower)
            (match-ref (SurfaceSpan.origin container)
              (Maybe.Nothing) (Maybe.Nothing)
              (Maybe.Just origin)
                (let [start @(SourceSpan.end &lower)
                      end @(Info.pos (SurfaceOrigin.content-end origin))]
                  (if (Int.<= start end)
                    (Maybe.Just
                      (SourceSpan.init @(SourceSpan.source-id &outer) start end))
                    (Maybe.Nothing))))))))

(defmodule SurfaceNode
  (doc generated "returns a node of `form` at `span`, without the span's
origin, for syntax the compiler made. Copied syntax should keep its origin, so
do not use this on it.")
  (defn generated [span form]
    (SurfaceNode.init (SurfaceSpan.generated &span) form)))

(doc Surface "parses Carp source into surface syntax and renders it back.")
(defmodule Surface
  (sig reanchor! (Fn [(Ref SurfaceNode) (Ref SurfaceSpan)] ()))
  (doc reanchor! "gives `node` and all its children the span `span`, with
`reanchored`. Macro expansion uses it so diagnostics point at the macro call.")
  (defn reanchor! [node span]
    (do
      (SurfaceNode.set-span! node
                             (SurfaceSpan.reanchored (SurfaceNode.span node)
                                                     span))

      (match-ref (SurfaceNode.form node)
        (SurfaceForm.List items)
          (for [i 0 (Array.length items)]
            (reanchor! (Box.peek (Array.unsafe-nth items i)) span))
        (SurfaceForm.Array items)
          (for [i 0 (Array.length items)]
            (reanchor! (Box.peek (Array.unsafe-nth items i)) span))
        (SurfaceForm.StaticArray items)
          (for [i 0 (Array.length items)]
            (reanchor! (Box.peek (Array.unsafe-nth items i)) span))
        (SurfaceForm.Dictionary items)
          (for [i 0 (Array.length items)]
            (reanchor! (Box.peek (Array.unsafe-nth items i)) span))
        _ ())))

  (private append-escaped-string)
  (hidden append-escaped-string)
  (defn append-escaped-string [buffer text]
    (let-do [n (String.length text)
             i 0]
      (while-do (Int.< i n)
        (let-do [c (String.char-at text i)
                 crlf? (and (Char.= c \return)
                            (and (Int.< (Int.inc i) n)
                                 (Char.= (String.char-at text (Int.inc i))
                                         \newline)))]
          (if crlf?
            (do (StringBuf.append-str buffer "\\r\\n") (set! i (Int.+ i 2)))
            (do
              (cond
                (Char.= c \\) (StringBuf.append-str buffer "\\\\")
                (Char.= c \") (StringBuf.append-str buffer "\\\"")
                (Char.= c \tab) (StringBuf.append-str buffer "\\t")
                (Char.= c \return) (StringBuf.append-str buffer "\\r")
                (StringBuf.append-char buffer c))
              (set! i (Int.inc i))))))))

  (private append-char)
  (hidden append-char)
  (defn append-char [buffer c]
    (let [text (cond
            (Char.= c \space) @"\\space"
            (Char.= c \tab) @"\\tab"
            (Char.= c \newline) @"\\newline"
            (Char.= c \return) @"\\return"
            (Char.= c \backspace) @"\\backspace"
            (Char.= c \formfeed) @"\\formfeed"
            (Char.= c \") @"\\\""
            (Int.> (Char.to-int c) 127) (fmt "\\u%04x" (Char.to-int c))
            (fmt "\\%c" c))]
      (StringBuf.append-str buffer &text)))

  (private double-round-trips?)
  (hidden double-round-trips?)
  (defn double-round-trips? [text value]
    (match (Double.from-string text)
      (Maybe.Just parsed) (Double.= parsed value)
      (Maybe.Nothing) false))

  (private decimal-only?)
  (hidden decimal-only?)
  (defn decimal-only? [text]
    (not (or (String.contains? text \e) (String.contains? text \E))))

  (private strip-trailing-zeros)
  (hidden strip-trailing-zeros)
  (defn strip-trailing-zeros [text]
    (if (not (String.contains? text \.))
      @text
      (let-do [chars (String.chars text)
               n (Array.length &chars)
               end n]
        (while-do (and (Int.> end 2)
                       (Char.= @(Array.unsafe-nth &chars (Int.dec end)) \0))
          (set! end (Int.dec end)))
        (when (Char.= @(Array.unsafe-nth &chars (Int.dec end)) \.)
          (set! end (Int.inc end)))
        (String.from-chars &(Array.prefix &chars end)))))

  (private special-double-text)
  (hidden special-double-text)
  ;; the reference pretty-prints non-finite numbers the way Haskell `show`
  ;; does; a macro that `str`s one observes the spelling, so it is part of
  ;; compile-time fidelity. (The reader parses these back as symbols, in both
  ;; compilers -- non-finite literals do not round-trip anywhere.)
  (defn special-double-text [value]
    (cond
      (not (Double.= value value)) (Maybe.Just @"NaN")
      (and (Double.> value 0.0) (Double.= value (Double.* value 2.0)))
        (Maybe.Just @"Infinity")
      (and (Double.< value 0.0) (Double.= value (Double.* value 2.0)))
        (Maybe.Just @"-Infinity")
      (the (Maybe String) (Maybe.Nothing))))

  (private float-text)
  (hidden float-text)
  ;; Float.str renders a whole-number float as `3f`; the reference prints
  ;; `3.0f`, and the spelling reaches programs through compile-time `str`.
  (defn float-text [value]
    (match (special-double-text (Double.from-float value))
      (Maybe.Just text) (String.append &text "f")
      (Maybe.Nothing)
        (let-do [text (Float.str value)]
          (when (String.ends-with? &text "f")
            (set! text
                  (String.byte-slice &text 0 (Int.dec (String.length &text)))))
          (when (and (decimal-only? &text) (not (String.contains? &text \.)))
            (set! text (String.append &text ".0")))
          (String.append &text "f"))))

  (private double-text-finite)
  (hidden double-text-finite)
  (defn double-text-finite [value]
    (let-do [text (Double.str value)]
      (when (or (not (decimal-only? &text))
                (not (double-round-trips? &text value)))
        (set! text (Double.unsafe-format "%.17g" value)))
      (unless-do (decimal-only? &text)
        (let-do [precisions [17 21 25 30 40 50 70 100 150 220 330]
                 n (Array.length &precisions)
                 i 0]
          (while-do (Int.< i n)
            ; `%%` escapes, so fmt-str carries exactly one directive
            (let-do [precision @(Array.unsafe-nth &precisions i)
                     fmt-str (fmt "%%.%df" precision)
                     candidate (strip-trailing-zeros &(Double.unsafe-format &fmt-str
                                                                            value))]
              (when-do (double-round-trips? &candidate value)
                (set! text candidate)
                (set! i n))
              (set! i (Int.inc i))))))
      (if (String.contains? &text \.) text (String.append &text ".0"))))

  (private double-text)
  (hidden double-text)
  (defn double-text [value]
    (match (special-double-text value)
      (Maybe.Just text) text
      (Maybe.Nothing) (double-text-finite value)))

  (private append-children)
  (hidden append-children)
  (private append-node)
  (hidden append-node)
  (defn append-children [buffer items]
    (let [n (Array.length items)]
      (for [i 0 n]
        (do
          (when (Int.> i 0) (StringBuf.append-char buffer \space))
          (append-node buffer (Box.peek (Array.unsafe-nth items i)))))))

  (defn append-node [buffer node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.Invalid source) (StringBuf.append-str buffer source)
      (SurfaceForm.IntLit value) (StringBuf.append-str buffer &(Int.str @value))
      (SurfaceForm.ByteLit value)
        (StringBuf.append-str buffer &(Byte.str @value))
      (SurfaceForm.LongLit value)
        (StringBuf.append-str buffer &(String.append &(Long.str @value) "l"))
      (SurfaceForm.FloatLit value)
        (StringBuf.append-str buffer &(float-text @value))
      (SurfaceForm.DoubleLit value)
        (StringBuf.append-str buffer &(double-text @value))
      (SurfaceForm.BoolLit value)
        (StringBuf.append-str buffer (if @value "true" "false"))
      (SurfaceForm.CharLit value) (append-char buffer @value)
      (SurfaceForm.StringLit value)
        (do
          (StringBuf.append-char buffer \")
          (append-escaped-string buffer value)
          (StringBuf.append-char buffer \"))
      (SurfaceForm.PatternLit value)
        (do
          (StringBuf.append-str buffer "#\"")
          (StringBuf.append-str buffer value)
          (StringBuf.append-char buffer \"))
      (SurfaceForm.Symbol segments)
        (StringBuf.append-str buffer &(String.join "." segments))
      (SurfaceForm.List items)
        (do
          (StringBuf.append-char buffer \()
          (append-children buffer items)
          (StringBuf.append-char buffer \)))
      (SurfaceForm.Array items)
        (do
          (StringBuf.append-char buffer \[)
          (append-children buffer items)
          (StringBuf.append-char buffer \]))
      (SurfaceForm.StaticArray items)
        (do
          (StringBuf.append-str buffer "$[")
          (append-children buffer items)
          (StringBuf.append-char buffer \]))
      (SurfaceForm.Dictionary items)
        (do
          (StringBuf.append-char buffer \{)
          (append-children buffer items)
          (StringBuf.append-char buffer \}))
      (SurfaceForm.Comment value)
        (do
          (StringBuf.append-char buffer \;)
          (StringBuf.append-str buffer value)
          (StringBuf.append-char buffer \newline))))

  (doc render "renders `node` as Carp source. Spans are left out. Invalid text
is printed as it is, and a comment ends with a newline.")
  (defn render [node]
    (let-do [buffer (StringBuf.create)]
      (append-node &buffer node)
      (StringBuf.into-string buffer)))

  (doc render-module "renders `module` as Carp source, one form per line.")
  (defn render-module [module]
    (let-do [buffer (StringBuf.create)
             forms (SurfaceModule.forms module)
             n (Array.length forms)]
      (for [i 0 n]
        (do
          (when (Int.> i 0) (StringBuf.append-char &buffer \newline))
          (append-node &buffer (Box.peek (Array.unsafe-nth forms i)))))
      (StringBuf.into-string buffer)))

  (doc lower-located "returns the `SurfaceNode` of the reader node `located`. It
accepts every reader node.")
  (defn lower-located [located]
    (let [span (SurfaceSpan.from-located located)]
      (match-ref (Located.form located)
        (Form.Itg value) (SurfaceNode.init span (SurfaceForm.IntLit @value))
        (Form.Byt value) (SurfaceNode.init span (SurfaceForm.ByteLit @value))
        (Form.Lng value) (SurfaceNode.init span (SurfaceForm.LongLit @value))
        (Form.Flt value) (SurfaceNode.init span (SurfaceForm.FloatLit @value))
        (Form.Dbl value) (SurfaceNode.init span (SurfaceForm.DoubleLit @value))
        (Form.Bol value) (SurfaceNode.init span (SurfaceForm.BoolLit @value))
        (Form.Chr value) (SurfaceNode.init span (SurfaceForm.CharLit @value))
        (Form.Str value) (SurfaceNode.init span (SurfaceForm.StringLit @value))
        (Form.Pat value) (SurfaceNode.init span (SurfaceForm.PatternLit @value))
        (Form.Sym segments)
          (SurfaceNode.init span (SurfaceForm.Symbol @segments))
        (Form.Lst forms)
          (let-do [children (the (Array (Box SurfaceNode)) [])
                   n (Array.length forms)]
            (for [i 0 n]
              (set! children
                    (Array.push-back children
                                     (Box.init
                                       (lower-located (Box.peek (Array.unsafe-nth forms
                                                                                  i)))))))
            (SurfaceNode.init span (SurfaceForm.List children)))
        (Form.Arr forms)
          (let-do [children (the (Array (Box SurfaceNode)) [])
                   n (Array.length forms)]
            (for [i 0 n]
              (set! children
                    (Array.push-back children
                                     (Box.init
                                       (lower-located (Box.peek (Array.unsafe-nth forms
                                                                                  i)))))))
            (SurfaceNode.init span (SurfaceForm.Array children)))
        (Form.StaticArr forms)
          (let-do [children (the (Array (Box SurfaceNode)) [])
                   n (Array.length forms)]
            (for [i 0 n]
              (set! children
                    (Array.push-back children
                                     (Box.init
                                       (lower-located (Box.peek (Array.unsafe-nth forms
                                                                                  i)))))))
            (SurfaceNode.init span (SurfaceForm.StaticArray children)))
        (Form.Dict forms)
          (let-do [children (the (Array (Box SurfaceNode)) [])
                   n (Array.length forms)]
            (for [i 0 n]
              (set! children
                    (Array.push-back children
                                     (Box.init
                                       (lower-located (Box.peek (Array.unsafe-nth forms
                                                                                  i)))))))
            (SurfaceNode.init span (SurfaceForm.Dictionary children)))
        (Form.Cmt value) (SurfaceNode.init span (SurfaceForm.Comment @value)))))

  (doc lower "returns the `SurfaceModule` of the reader forms `forms`. Comments
are kept.")
  (defn lower [forms]
    (let-do [result (the (Array (Box SurfaceNode)) [])
             n (Array.length forms)]
      (for [i 0 n]
        (set! result
              (Array.push-back result
                               (Box.init
                                 (lower-located (Box.peek (Array.unsafe-nth forms
                                                                            i)))))))
      (SurfaceModule.init result)))

  (doc parse "parses `source` into a `SurfaceModule`. Parser errors are returned
as they are. Spans get the id of the file being parsed, which is `no-source`
unless `parse-in` is running.")
  (defn parse [source]
    (match (Reader.parse source)
      (Result.Success forms) (Result.Success (lower &forms))
      (Result.Error error) (Result.Error error)))

  (doc parse-in "parses `source` as the file `source-id`, so every span names
that file.")
  (defn parse-in [source-id source]
    (let-do [_ignored-enter (set! *surface-source-index*
                                  (intern-source! source-id))
             _ignored-enter2 (set! *surface-source-id* (String.copy source-id))
             parsed (parse source)
             _ignored-leave (set! *surface-source-index* (no-source))
             _ignored-leave2 (set! *surface-source-id* @"")]
      parsed))

  (doc parse-input "parses `input` into a `SourcedSurfaceModule`. Parser errors
are returned as reader errors. `parse-input-diagnosed` returns a diagnostic
instead.")
  (defn parse-input [input]
    (match (parse-in (SourceInput.id input) (SourceInput.source input))
      (Result.Success module)
        (Result.Success
          (SourcedSurfaceModule.init (SourceInput.copy input) module))
      (Result.Error error) (Result.Error error)))

  (doc parse-input-diagnosed "parses `input` into a `SourcedSurfaceModule`. A
parser error becomes a diagnostic with phase `parse` and an empty span at the
error position.")
  (sig parse-input-diagnosed
       (Fn [(Ref SourceInput)] (Result SourcedSurfaceModule Diagnostic)))
  (defn parse-input-diagnosed [input]
    (match (parse-input input)
      (Result.Success sourced) (Result.Success sourced)
      (Result.Error error)
        (let [position @(ParseErr.pos &error)]
          (Result.Error
            (Diagnostic.init (String.copy "parse")
                             (Parser.format-error &error)
                             (Maybe.Just
                               (SourceSpan.init (String.copy (SourceInput.id input))
                                                position
                                                position))))))))

(defmodule SurfaceNode
  (doc str "renders a surface node as source-level Carp syntax, omitting its
source span.")
  (defn str [node] (Surface.render node))
  (implements str SurfaceNode.str))

(defmodule SurfaceModule
  (doc str "renders a surface module as newline-separated source-level forms.")
  (defn str [module] (Surface.render-module module))
  (implements str SurfaceModule.str))

(defmodule Surface
  (doc a-parsed-definition "is an example: the surface syntax of a function
definition.")
  (meta-set! a-parsed-definition "example" true)
  (defn a-parsed-definition []
    (Result.from-success
      (Surface.parse "(defn double [x] (* 2 x))")
      (SurfaceModule.init [])))

  (doc a-parsed-module "is an example: the surface syntax of a type and a
function.")
  (meta-set! a-parsed-module "example" true)
  (defn a-parsed-module []
    (Result.from-success (Surface.parse "(deftype Point [x Int y Int])
(defn origin [] (Point.init 0 0))") (SurfaceModule.init [])))

  (doc a-round-tripped-form "is an example: a parsed definition rendered back to
source.")
  (meta-set! a-round-tripped-form "example" true)
  (defn a-round-tripped-form [] (Surface.render-module &(a-parsed-definition)))

  (doc a-parse-diagnostic "is an example: the diagnostic of a parse failure.")
  (meta-set! a-parse-diagnostic "example" true)
  (defn a-parse-diagnostic []
    (match (Surface.parse-input-diagnosed
        &(SourceInput.init @"example" @"(defn broken ["))
      (Result.Error diagnostic) diagnostic
      (Result.Success _)
        (Diagnostic.init @"parse" @"this source parses" (Maybe.Nothing)))))

(load "observations.carp")
