(doc SourceSemanticFact "is a name in the source with its meaning. `name` is the
name, `role` what it names, and `span` where it is written.")
(deftype SourceSemanticFact [name String
                             role String
                             span SourceSpan])
(doc SourceLexicalIdentity "identifies a binding. `Local` holds the number of a
local binding in the observed source. `Cell` holds the index of a compile-time
environment cell.")
(deftype SourceLexicalIdentity
  (Local [Int])
  (Cell [Int]))
(doc SourceLexicalBinding "is a binding that is visible in the source. `name` is
its name and `role` what it names. `identity` identifies it. `declaration` is
where it is declared, if that is in the observed source.")
(deftype SourceLexicalBinding
  [name String
   role String
   identity SourceLexicalIdentity
   declaration (Maybe SourceSpan)])
(doc SourceCompileEnvironment "is a compile-time environment seen while
observing. `key` identifies it. `query` returns its bindings for a name, or for
a name prefix if its second argument is false.")
(deftype SourceCompileEnvironment
  [key String
   query (Fn [(Ref String) Bool] (Array SourceLexicalBinding))])
(doc SourceContext "is the kind of a source region. `Evaluation` is code that is
evaluated. `Quoted` is quoted code. `Type` is a type signature.")
(deftype SourceContext
  (Evaluation [])
  (Quoted [])
  (Type []))
(doc SourceCompileScope "is a source region and what is in scope there. `span`
is the region and `locals` the local bindings. `environment` is the index of its
compile-time environment, or -1. `context` is the kind of the region.")
(deftype SourceCompileScope
  [span SourceSpan
   locals (Array SourceLexicalBinding)
   environment Int
   context SourceContext])
(doc *source-observing* "is whether a source is being observed.")
(def *source-observing* false)
(doc *source-observation-id* "is the id of the source being observed.")
(def *source-observation-id* @"")
(doc *source-semantic-facts* "holds the facts recorded in the current
observation.")
(def *source-semantic-facts* (the (Array SourceSemanticFact) []))
(doc *source-compile-scopes* "holds the scopes recorded in the current
observation.")
(def *source-compile-scopes* (the (Array SourceCompileScope) []))
(doc *source-compile-environments* "holds the compile-time environments seen in
the current observation.")
(def *source-compile-environments* (the (Array SourceCompileEnvironment) []))
(doc *source-compile-environment* "is the index of the current compile-time
environment, or -1.")
(def *source-compile-environment* -1)
(doc *source-binding-identity* "numbers the next local binding of the current
observation.")
(def *source-binding-identity* 0)

(doc SourceObservations "records what names mean and what is in scope while a
source is compiled, for editing tools.")
(defmodule SourceObservations
  (doc record! "records that `node`, written as `name`, has the role `role`, if
`node` was written in the observed source.")
  (defn record! [node name role]
    (when *source-observing*
      (match (SurfaceSpan.original-in-source (SurfaceNode.span node)
                                             &*source-observation-id*)
        (Maybe.Nothing) ()
        (Maybe.Just span)
          (Array.push-back! &*source-semantic-facts*
                            (SourceSemanticFact.init (String.copy name)
                                                     (String.copy role)
                                                     span)))))

  (doc region! "records a scope with `locals` from the end of `boundary` to the
end of `body`, if both were written in the observed source.")
  (defn region! [boundary body locals]
    (when (and *source-observing*
               (WorkBudget.consume! (Int.inc (Array.length locals))))
      (match (SurfaceSpan.original-in-source boundary &*source-observation-id*)
        (Maybe.Nothing) ()
        (Maybe.Just lower)
          (match (SurfaceSpan.original-in-source body &*source-observation-id*)
            (Maybe.Nothing) ()
            (Maybe.Just upper)
              (when (Int.<= @(SourceSpan.end &lower) @(SourceSpan.end &upper))
                (Array.push-back! &*source-compile-scopes*
                                  (SourceCompileScope.init
                                    (SourceSpan.init @(SourceSpan.source-id &upper)
                                                     @(SourceSpan.end &lower)
                                                     @(SourceSpan.end &upper))
                                    (Array.copy locals)
                                    *source-compile-environment*
                                    (SourceContext.Evaluation))))))))
  (doc written? "checks whether a source is being observed and `node` was
written in it.")
  (defn written? [node]
    (and *source-observing*
         (Maybe.just?
           &(SurfaceSpan.original-in-source (SurfaceNode.span node)
                                            &*source-observation-id*))))
  (doc begin! "starts observing the source `source`.")
  (defn begin! [source]
    (do
      (set! *source-observing* true)
      (set! *source-observation-id* (String.copy source))
      (set! *source-semantic-facts* [])
      (set! *source-compile-scopes* [])
      (set! *source-compile-environments* [])
      (set! *source-compile-environment* -1)
      (set! *source-binding-identity* 0)))

  (doc binding "returns a new local binding of `name` with role `role`, declared
at `node`, and records it.")
  (defn binding [node name role]
    (let-do [identity *source-binding-identity*
             declaration (SurfaceSpan.original-in-source (SurfaceNode.span node)
                                                         &*source-observation-id*)]
      (when-do *source-observing*
        (set! *source-binding-identity* (Int.inc identity))
        (record! node name role))
      (SourceLexicalBinding.init (String.copy name)
                                 (String.copy role)
                                 (SourceLexicalIdentity.Local identity)
                                 declaration)))

  (doc reference! "records the role of the binding that the reference `node`,
named `name`, refers to in the current compile-time environment.")
  (defn reference! [node name]
    (when (and (written? node) (Int.>= *source-compile-environment* 0))
      (let [query (SourceCompileEnvironment.query
              (Array.unsafe-nth &*source-compile-environments*
                                *source-compile-environment*))
            bindings (~query name true)]
        (for [i 0 (Array.length &bindings)]
          (let [binding (Array.unsafe-nth &bindings i)]
            (when (String.= name (SourceLexicalBinding.name binding))
              (record! node name (SourceLexicalBinding.role binding))))))))

  (doc scope! "records the scope of `node` with `locals`, if `node` was written
in the observed source.")
  (defn scope! [node locals]
    (when (and *source-observing*
               (WorkBudget.consume! (Int.inc (Array.length locals))))
      (match (SurfaceSpan.original-in-source (SurfaceNode.span node)
                                             &*source-observation-id*)
        (Maybe.Nothing) ()
        (Maybe.Just span)
          (Array.push-back! &*source-compile-scopes*
                            (SourceCompileScope.init span
                                                     (Array.copy locals)
                                                     *source-compile-environment*
                                                     (SourceContext.Evaluation))))))

  (doc opaque! "records `node` as quoted, if it was written in the observed
source.")
  (defn opaque! [node]
    (when *source-observing*
      (match (SurfaceSpan.original-in-source (SurfaceNode.span node)
                                             &*source-observation-id*)
        (Maybe.Nothing) ()
        (Maybe.Just span)
          (Array.push-back! &*source-compile-scopes*
                            (SourceCompileScope.init span
                                                     []
                                                     -1
                                                     (SourceContext.Quoted))))))

  (doc type-context! "records `node` as a type signature, if it was written in
the observed source.")
  (defn type-context! [node]
    (when *source-observing*
      (match (SurfaceSpan.original-in-source (SurfaceNode.span node)
                                             &*source-observation-id*)
        (Maybe.Nothing) ()
        (Maybe.Just span)
          (Array.push-back! &*source-compile-scopes*
                            (SourceCompileScope.init span
                                                     []
                                                     -1
                                                     (SourceContext.Type))))))

  (doc type-bindings! "gives the type scopes inside `node` the type parameters
`bindings`.")
  (defn type-bindings! [node bindings]
    (when *source-observing*
      (match (SurfaceSpan.original-in-source (SurfaceNode.span node)
                                             &*source-observation-id*)
        (Maybe.Nothing) ()
        (Maybe.Just enclosing)
          (for [i 0 (Array.length &*source-compile-scopes*)]
            (let [scope (Array.unsafe-nth &*source-compile-scopes* i)
                  span (SourceCompileScope.span scope)]
              (when (and
                  (Int.<= @(SourceSpan.start &enclosing)
                          @(SourceSpan.start span))
                  (and
                    (Int.>= @(SourceSpan.end &enclosing) @(SourceSpan.end span))
                    (match-ref (SourceCompileScope.context scope)
                      (SourceContext.Type) true
                      _ false)))
                (SourceCompileScope.set-locals! scope (Array.copy bindings))))))))

  (doc environment-index "returns the index of the compile-time environment
`key`, or -1.")
  (defn environment-index [key]
    (let-do [found -1]
      (for [i 0 (Array.length &*source-compile-environments*)]
        (when (String.= key
                        (SourceCompileEnvironment.key
                          (Array.unsafe-nth &*source-compile-environments* i)))
          (set! found i)))
      found))

  (doc select-environment! "makes environment `index` the current one.")
  (defn select-environment! [index] (set! *source-compile-environment* index))

  (doc add-environment! "adds the compile-time environment `key` with `query`
and makes it the current one.")
  (defn add-environment! [key query]
    (let-do [index (Array.length &*source-compile-environments*)]
      (Array.push-back! &*source-compile-environments*
                        (SourceCompileEnvironment.init key query))
      (select-environment! index)))

  (doc scopes "returns the scopes recorded so far.")
  (defn scopes [] (Array.copy &*source-compile-scopes*))
  (doc environments "returns the compile-time environments seen so far.")
  (defn environments [] (Array.copy &*source-compile-environments*))

  (doc end! "stops observing and returns the facts that were recorded.")
  (defn end! []
    (let-do [facts (Array.copy &*source-semantic-facts*)]
      (set! *source-observing* false)
      (set! *source-semantic-facts* [])
      (set! *source-compile-scopes* [])
      (set! *source-compile-environments* [])
      (set! *source-compile-environment* -1)
      facts)))
