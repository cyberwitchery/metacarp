(load "../carp-surface.carp")
(Project.no-echo)
(load "Test.carp")

(use-all Test)

(defn parsed-module [source]
  (Result.from-success (Surface.parse source) (SurfaceModule.init [])))

(defn node-at [module index]
  (Box.peek (Array.unsafe-nth (SurfaceModule.forms module) index)))

(defn form-at [module index] (SurfaceNode.form (node-at module index)))

(deftest t
  (let [module (parsed-module "; documentation
(defn id [x] x)")] (assert-equal t
      2
      (Array.length (SurfaceModule.forms &module))
      "surface lowering retains top-level ordering") (assert-true t
      (match-ref (form-at &module 0) (SurfaceForm.Comment _) true _ false)
      "comments are retained for source tools") (assert-true t
      (match-ref (form-at &module 1) (SurfaceForm.List _) true _ false)
      "lists lower to the surface list variant") (assert-equal t
      2
      @(Info.line (SurfaceSpan.start (SurfaceNode.span (node-at &module 1))))
      "node span starts at reader location"))

  (let [module (parsed-module "&value $[1 2] {:a true}")]
    (assert-equal t
      3
      (Array.length (SurfaceModule.forms &module))
      "one surface node is produced per reader form")
    (assert-true t
      (match-ref (form-at &module 0) (SurfaceForm.List _) true _ false)
      "reader macros stay normalized as reader lists")
    (assert-true t
      (match-ref (form-at &module 1) (SurfaceForm.StaticArray _) true _ false)
      "static arrays retain their syntax category")
    (assert-true t
      (match-ref (form-at &module 2) (SurfaceForm.Dictionary _) true _ false)
      "dictionaries retain their syntax category"))

  (assert-true t
    (Result.error? &(Surface.parse "("))
    "parse forwards reader syntax errors")

  (let [module (parsed-module "(do (println \"ok\") $[1 2] {:a \\newline})")]
    (assert-equal t
      "(do (println \"ok\") $[1 2] {:a \\newline})"
      &(str (node-at &module 0))
      "surface nodes render as source without spans or boxes")))
