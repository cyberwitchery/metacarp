(load "../carp-expand.carp")
(load "Test.carp")
(Project.no-echo)
(use-all Test)

(defn parses [source]
  (Result.from-success (Surface.parse source) (SurfaceModule.init [])))

(defn retained-metadata? []
  (match (CtEval.meta-value "preview:probe" "doc")
    (Maybe.Nothing) false
    (Maybe.Just node)
      (match-ref (SurfaceNode.form (Box.peek &node))
        (SurfaceForm.StringLit text) (String.= text "before")
        _ false)))

(defn restores-transient-state? []
  (let [base (parses "(defmacro pass [x] ((fn [y] y) x))")
        config (ExpandConfig.init [])]
    (match (MacroExpand.prepare-module-with &base &config)
      (Result.Error _) false
      (Result.Success warm)
        (let-do [before (CtCodeStore.count)
                 prototypes (Array.length &*ct-protos*)
                 source (parses "(pass 42)
(defmacro temporary [x] ((fn [y] y) x))
(temporary 1)")
                 marker (SurfaceNode.generated (SurfaceSpan.anywhere)
                                               (SurfaceForm.StringLit @"before"))
                 okay true]
          (CtEval.record-meta! "preview:probe" "doc" &marker)
          (for [i 0 20]
            (let-do [saved (CtEval.checkpoint)
                     expanded (MacroExpand.expand-module-against &source
                                                                 (PreparedExpansion.snapshot &warm))]
              (unless (Result.success? &expanded) (set! okay false))
              (CtEval.restore! saved)
              (unless (and (Int.= before (CtCodeStore.count))
                           (and
                             (Int.= prototypes (Array.length &*ct-protos*))
                             (retained-metadata?)))
                (set! okay false))))
          (let [again (MacroExpand.expand-module-against &(parses "(pass 7)")
                                                         (PreparedExpansion.snapshot &warm))]
            (and okay
                 (match again
                   (Result.Error _) false
                   (Result.Success expanded)
                     (String.= &(Surface.render-module &expanded) "7"))))))))

(deftest test
  (assert-true test
    (restores-transient-state?)
    "repeated previews retire temporary code and restore metadata and lazy warm prototypes"))
