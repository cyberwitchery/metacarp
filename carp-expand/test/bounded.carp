(load "../carp-expand.carp")
(load "Test.carp")
(Project.no-echo)
(use-all Test)

(defn stopped-expansion [source steps]
  (match (Surface.parse source)
    (Result.Error _) (the (Maybe WorkStop) (Maybe.Nothing))
    (Result.Success parsed)
      (let-do [_begin (WorkBudget.begin! steps true (fn [] false))
               _expanded (MacroExpand.expand-module &parsed)]
        (WorkBudget.end!))))

(defn finite-budget-stops? []
  (match (stopped-expansion
      "(defmacro twice [x] (do (+ 1 2) (+ 3 4) (+ 5 6) x)) (twice 1)"
      5)
    (Maybe.Just (WorkStop.Limit)) true
    _ false))

(defn preview-declines-read? []
  (match (stopped-expansion
      "(defmacro read [] (read-file \"metacarp-preview-must-not-open-this\")) (read)"
      10000)
    (Maybe.Just (WorkStop.Effect effect)) (String.= &effect "read-file")
    _ false))

(defn infinite-loop-stops? []
  (match (stopped-expansion
      "(defmacro spin [] (do (while true 0) 0)) (spin)"
      1000)
    (Maybe.Just (WorkStop.Limit)) true
    _ false))

(defn data-growth-stops? [] (match (stopped-expansion "(defmacro large []
       (let [s \"x\"]
         (do
           (while (< (String.length s) 65536) (set! s (String.append s s)))
           (parse s))))
     (large)" 1000) (Maybe.Just (WorkStop.Limit)) true _ false))

(deftest test
  (assert-true test
    (finite-budget-stops?)
    "macro evaluation participates in the compiler work budget")
  (assert-true test
    (preview-declines-read?)
    "automatic preview declines compile-time file reads")
  (assert-true test
    (infinite-loop-stops?)
    "a looping macro cannot retain the analysis worker")
  (assert-true test
    (data-growth-stops?)
    "growing macro data is charged before another doubling"))
