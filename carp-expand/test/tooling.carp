(load "../carp-expand.carp")
(load "Test.carp")
(Project.no-echo)
(use-all Test)

(defn facts [source]
  (let-do [input (SourceInput.init @"ct:editing" (String.copy source))
           saved (CtEval.checkpoint)
           _start (SourceObservations.begin! (SourceInput.id &input))
           _expanded (match (Surface.parse-input &input)
             (Result.Error _) ()
             (Result.Success parsed)
               (ignore
                 (MacroExpand.expand-module (SourcedSurfaceModule.module &parsed))))
           observed (SourceObservations.end!)]
    (CtEval.restore! saved)
    observed))

(defn count-facts [source role name]
  (let-do [observed (facts source)
           count 0]
    (for [i 0 (Array.length &observed)]
      (let [fact (Array.unsafe-nth &observed i)]
        (when (and
            (String.= (SourceSemanticFact.role fact) role)
            (String.= (SourceSemanticFact.name fact) name))
          (set! count (Int.inc count)))))
    count))

(deftest test
  (assert-equal test
    2
    (count-facts "(defmacro m [x] x)" "compile-time-parameter" "x")
    "macro parameter declarations and uses come from compile-time lowering")
  (assert-equal test
    2
    (count-facts "(defmacro m [x] (let [y x] y))" "compile-time-local" "y")
    "compile-time let declarations and uses share the actual lowering scope")
  (assert-equal test
    1
    (count-facts "(defmacro m [x] (quote x))" "compile-time-parameter" "x")
    "quoted macro data is not classified as a parameter use")
  (assert-equal test
    1
    (count-facts "(defmacro m [x] x) (m 1)" "macro" "m")
    "the selected macro expansion records its exact source head"))
