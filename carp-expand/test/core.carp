(load "../carp-expand.carp")
(load "../../carp-module/carp-module.carp")
(Project.no-echo)

;; core files come from $CARP_DIR (the reference checkout, as setup-carp
;; exports it), falling back to the sibling layout used for local development.
(defn core-prefix []
  (match (IO.getenv "CARP_DIR")
    (Maybe.Just dir) (String.append &dir "/core/")
    (Maybe.Nothing) @"../../../carp/core/"))

(defn core-path [name]
  (String.append &(core-prefix) name))


(defn core-source [path]
  (let [prefix (core-prefix)
        file (String.append &prefix path)]
    (ModuleSource.init (String.copy path)
                       (String.copy &file)
                       (IO.unsafe-read-file &file))))

(defn core-sources []
  (let-do [result (the (Array ModuleSource) [])
           paths (String.split-by "Core.carp
Interfaces.carp
Blitable.carp
Bool.carp
Box.carp
Macros.carp
BoolExtras.carp
List.carp
Derive.carp
Gensym.carp
ControlMacros.carp
Project.carp
Platform.carp
Introspect.carp
Quasiquote.carp
Pointer.carp
Unsafe.carp
Function.carp
Generics.carp
Maybe.carp
Result.carp
Dynamic.carp
Format.carp
Byte.carp
Int.carp
Long.carp
Double.carp
Float.carp
Tuples.carp
Array.carp
StaticArray.carp
StdInt.carp
Char.carp
String.carp
ArrayExt.carp
System.carp
IO.carp
Pattern.carp
Debug.carp
Random.carp
Map.carp
Heap.carp
Sort.carp
Binary.carp
Control.carp
Opaque.carp
Unit.carp" &[\newline])
           n (Array.length &paths)]
    (for [i 0 n]
      (set! result
            (Array.push-back result (core-source (Array.unsafe-nth &paths i)))))
    result))

(defn append-forms [left right]
  (let-do [result (Array.copy left)
           n (Array.length right)]
    (for [i 0 n]
      (set! result
            (Array.push-back result
                             (Box.init
                               (SurfaceNode.copy (Box.peek (Array.unsafe-nth right
                                                                             i)))))))
    result))

(defn main []
  (let [sources (core-sources)
        root (String.copy "Core.carp")
        bootstrap (Result.from-success
          (Surface.parse "(defndynamic host-arch [] 'aarch64)
(defndynamic host-os [] 'darwin)
(defmodule Project (defndynamic get-config [key] \"native\"))")
          (SurfaceModule.init []))
        probe-source (if (Int.> (StaticArray.length &System.args) 1)
          @(StaticArray.unsafe-nth &System.args 1)
          (String.copy "(println \"ok\")"))
        probe (Result.from-success (Surface.parse &probe-source)
                                   (SurfaceModule.init []))]
    (match (ModuleLoader.load &sources &root)
      (Result.Success core)
        (let [with-core (append-forms (SurfaceModule.forms &bootstrap)
                                      (SurfaceModule.forms &core))
              forms (append-forms &with-core (SurfaceModule.forms &probe))
              input (SurfaceModule.init forms)
              config (ExpandConfig.init [@"Dynamic"])]
          (match (MacroExpand.expand-module-with &input &config)
            (Result.Success expanded)
              (let [last (SurfaceNode.copy
                      (Box.peek
                        (Array.unsafe-nth (SurfaceModule.forms &expanded)
                                          (Int.dec
                                            (Array.length (SurfaceModule.forms &expanded))))))]
                (IO.println &(str &last)))
            (Result.Error error) (IO.println (CtError.message &error))))
      (Result.Error error) (IO.println (ModuleError.message &error)))))
