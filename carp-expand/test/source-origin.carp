(load "../carp-expand.carp")
(load "Test.carp")
(Project.no-echo)
(use-all Test)

(defn expansion-keeps-argument-origin? [] (let [source "(defmacro pass [x] x)
(pass target)"
                                                target (String.index-of-string source
                                                                               "target")
                                                call (String.index-of-string source
                                                                             "(pass target)")] (match (Surface.parse-in "origin:test"
                                                                                                                        source)
      (Result.Error _) false
      (Result.Success parsed)
        (match (MacroExpand.expand-module &parsed)
          (Result.Error _) false
          (Result.Success expanded)
            (let [node (Box.peek
                    (Array.unsafe-nth (SurfaceModule.forms &expanded) 0))
                  span (SurfaceNode.span node)]
              (and
                (Int.= (SurfaceSpan.byte-start span) call)
                (match (SurfaceSpan.original-in-source span "origin:test")
                  (Maybe.Nothing) false
                  (Maybe.Just original)
                    (and
                      (String.= (SourceSpan.source-id &original) "origin:test")
                      (Int.= @(SourceSpan.start &original) target)))))))))

(defn generated-syntax-has-no-origin? []
  (match (Surface.parse-in "origin:test" "(call)")
    (Result.Error _) false
    (Result.Success parsed)
      (let [source (Box.peek (Array.unsafe-nth (SurfaceModule.forms &parsed) 0))
            generated (SurfaceNode.generated @(SurfaceNode.span source)
                                             (SurfaceForm.Symbol [@"made"]))]
        (match (SurfaceSpan.original-in-source (SurfaceNode.span &generated)
                                               "origin:test")
          (Maybe.Nothing) true
          _ false))))

(deftest test
  (assert-true test
    (expansion-keeps-argument-origin?)
    "substituted syntax keeps exact written origin while diagnostics blame the invocation")
  (assert-true test
    (generated-syntax-has-no-origin?)
    "generated syntax does not claim the invocation's source bytes"))
