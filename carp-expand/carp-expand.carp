(load "../carp-ct-eval/carp-ct-eval.carp")

(doc ExpandMacro "is a macro definition. `name` is its name and `parameters` its
parameters. `body` is the body as written. `code` is the compiled body, which a
call runs. `defining-frame` is the frame it was defined in, and `file` the file
it was written in.")
(doc MacroParameters "is the parameter list of a macro. `fixed` holds the names
of the fixed parameters. `rest` is the name of the rest parameter, if there is
one.")
(deftype MacroParameters [fixed (Array String)
                          rest (Maybe String)])
(deftype ExpandMacro
  [name String
   parameters MacroParameters
   body (Box SurfaceNode)
   code Int
   defining-frame FrameId
   file String])

(doc ExpandScope "is the scope one module body is expanded in. `path` is the
dotted module name, or the empty string at the root. `frame` is the module's
frame. `imports` holds the frames of the modules it uses.")
(deftype ExpandScope [path String
                      frame FrameId
                      imports (Array FrameId)])

(doc ExpandDynamic "is a dynamic definition: `name` bound to `value`.")
(deftype ExpandDynamic [name String
                        value (Box CtValue)])

(doc ExpandModuleFrame "is the compile-time frame `frame` of the module `path`.")
(deftype ExpandModuleFrame [path String
                            frame FrameId])

(doc ExpandConfig "is driver configuration for expansion. `preludes` holds the
modules that every module sees, after its own imports and before the root.")
(deftype ExpandConfig [preludes (Array String)])

(doc ExpandSnapshot "is the compile-time environment after expanding a base
module, to expand later sources against. `scope` is the root scope. `macros`
holds the macros. `state` is the compile-time state. `modules` holds the module
frames. `config` is the configuration and `preludes` the prelude frames. `meta`
holds the metadata that `meta` reads, and `typing-forms` the forms that `type`
infers against. Expanding against it copies it and leaves it unchanged.")
(deftype ExpandSnapshot
  [scope ExpandScope
   macros (Array ExpandMacro)
   state CtState
   modules (Array ExpandModuleFrame)
   config ExpandConfig
   preludes (Array FrameId)
   meta (Array (Pair String (Box SurfaceNode)))
   typing-forms (Array (Box SurfaceNode))])

(doc PreparedExpansion "is an expanded module with the snapshot after expanding
it. `module` is the expanded forms and `snapshot` the environment.")
(deftype PreparedExpansion [module SurfaceModule
                            snapshot ExpandSnapshot])

(doc MacroLookup "is the result of looking up a macro. `Missing` means there is
none. `Found` holds the macro. `Ambiguous` means more than one imported module
defines it.")
(deftype MacroLookup
  (Missing [])
  (Found [ExpandMacro])
  (Ambiguous []))

(doc *expand-recovering* "is whether expansion goes on after an error, for
`observe-module-against`.")
(def *expand-recovering* false)
(doc *expand-in-definition* "is whether the body of a runtime definition, a
`defn` or `def`, is being expanded. Only there is a call to a `defndynamic`
function evaluated at compile time. At the top level the form is compile-time
code itself, and expanding both branches of a top-level `if` must not run
either.")
(def *expand-in-definition* false)
(doc *expand-locals* "holds the runtime names bound around the form being
expanded inside a definition: parameters and `let`, `fn` and `match` bindings.
A local shadows a `defndynamic` function of the same name, as in the
reference.")
(def *expand-locals* (the (Array String) []))
(doc *expand-recovery-errors* "holds the errors met while recovering.")
(def *expand-recovery-errors* (the (Array CtError) []))
(doc ObservedExpansion "is the result of `observe-module-against`. `result` is
the expanded module or the first error. `errors` holds the errors met while
recovering.")
(deftype ObservedExpansion
  [result (Result SurfaceModule CtError)
   errors (Array CtError)])

(doc MacroExpand "expands macros and runs compile-time definitions, in source
order.")
(defmodule MacroExpand
  (private editing-items)
  (hidden editing-items)
  (defn editing-items [node items count]
    (do
      (when *source-observing*
        (while-do (Int.< (Array.length &items) count)
          (Array.push-back! &items
                            (Box.init
                              (SurfaceNode.init
                                (SurfaceSpan.missing-at-end (SurfaceNode.span node))
                                (SurfaceForm.Invalid @"missing expression"))))))
      items))

  (private symbol-name)
  (hidden symbol-name)
  (defn symbol-name [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.Symbol segments)
        (if (Int.= 1 (Array.length segments))
          (Maybe.Just @(Array.unsafe-nth segments 0))
          (Maybe.Nothing))
      _ (Maybe.Nothing)))

  (private symbol-key)
  (hidden symbol-key)
  (defn symbol-key [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.Symbol segments)
        (if (Int.> (Array.length segments) 0)
          (Maybe.Just (String.join "." segments))
          (Maybe.Nothing))
      _ (Maybe.Nothing)))

  (private qualified-name)
  (hidden qualified-name)
  (defn qualified-name [path name]
    (if (= path "") @name (let [parts [@path @name]] (String.join "." &parts))))

  (private named?)
  (hidden named?)
  (defn named? [node name]
    (let-do [matches (match (symbol-name node)
               (Maybe.Just found) (String.= &found &name)
               (Maybe.Nothing) false)]
      (when matches (SourceObservations.record! node &name "syntax"))
      matches))

  (private error-at)
  (hidden error-at)
  (defn error-at [node message] (CtError.init message @(SurfaceNode.span node)))

  (private semantic-items)
  (hidden semantic-items)
  (defn semantic-items [items]
    (let-do [result (the (Array (Box SurfaceNode)) [])
             n (Array.length items)]
      (for [i 0 n]
        (let [item (Box.peek (Array.unsafe-nth items i))]
          (match-ref (SurfaceNode.form item)
            (SurfaceForm.Comment _) ()
            _
              (set! result
                    (Array.push-back result (Box.init (SurfaceNode.copy item)))))))
      result))

  (private parameter-names)
  (hidden parameter-names)
  (private fixed-parameter-names)
  (hidden fixed-parameter-names)
  (defn fixed-parameter-names [parameters n]
    (let-do [result (the (Result (Array String) CtError) (Result.Success []))]
      (for [i 0 n]
        (match-ref &result
          (Result.Success names)
            (let [parameter (Box.peek (Array.unsafe-nth parameters i))]
              (match (symbol-name parameter)
                (Maybe.Just name) (Array.push-back! names name)
                (Maybe.Nothing)
                  (set! result
                        (Result.Error
                          (error-at parameter
                                    @"defmacro parameters must be unqualified symbols")))))
          (Result.Error error) (set! result (Result.Error @error))))
      result))

  (defn parameter-names [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.Array parameters)
        (let [n (Array.length parameters)]
          (if (and (Int.> n 1)
                   (named?
                     (Box.peek (Array.unsafe-nth parameters (Int.- n 2)))
                     @":rest"))
            (let [rest-node (Box.peek (Array.unsafe-nth parameters (Int.dec n)))]
              (match (symbol-name rest-node)
                (Maybe.Just rest-name)
                  (match (fixed-parameter-names parameters (Int.- n 2))
                    (Result.Success fixed)
                      (Result.Success
                        (MacroParameters.init fixed (Maybe.Just rest-name)))
                    (Result.Error error) (Result.Error error))
                (Maybe.Nothing)
                  (Result.Error
                    (error-at rest-node
                              @"defmacro :rest must be followed by an unqualified symbol"))))
            (match (fixed-parameter-names parameters n)
              (Result.Success fixed)
                (Result.Success (MacroParameters.init fixed (Maybe.Nothing)))
              (Result.Error error) (Result.Error error))))
      _ (Result.Error (error-at node @"defmacro parameters must be an array"))))

  (private parse-definition)
  (hidden parse-definition)
  (defn parse-definition [node frame state]
    (do
      (CtEval.observe-environment! node state frame)
      (match-ref (SurfaceNode.form node)
        (SurfaceForm.List raw-items)
          (let [written (semantic-items raw-items)
                written-count (Array.length &written)
                items (editing-items node written 4)]
            (if (Int.= 4 (Array.length &items))
              (let [head (Box.peek (Array.unsafe-nth &items 0))
                    name-node (Box.peek (Array.unsafe-nth &items 1))
                    parameters (Box.peek (Array.unsafe-nth &items 2))
                    body (Box.peek (Array.unsafe-nth &items 3))]
                (if (named? head @"defmacro")
                  (match (symbol-name name-node)
                    (Maybe.Just name)
                      (match (parameter-names parameters)
                        (Result.Success macro-parameters)
                          (let [partial (ExpandMacro.init name
                                                          @&macro-parameters
                                                          (Box.init (SurfaceNode.copy body))
                                                          (CtLower.lower-macro-proto-at
                                                            @(MacroParameters.fixed &macro-parameters)
                                                            @(MacroParameters.rest &macro-parameters)
                                                            (Box.init (SurfaceNode.copy body))
                                                            parameters)
                                                          @frame
                                                          (CtEval.definition-file))]
                            (if (Int.< written-count 4)
                              (Result.Error
                                (error-at node
                                          @"defmacro expects a name, parameter array, and body"))
                              (Result.Success partial)))
                        (Result.Error error) (Result.Error error))
                    (Maybe.Nothing)
                      (Result.Error
                        (error-at name-node
                                  @"defmacro name must be an unqualified symbol")))
                  (Result.Error (error-at node @"expected defmacro"))))
              (Result.Error
                (error-at node
                          @"defmacro expects a name, parameter array, and body"))))
        _ (Result.Error (error-at node @"defmacro must be a list")))))

  (private parse-dynamic-definition)
  (hidden parse-dynamic-definition)
  (defn parse-dynamic-definition [node frame state]
    (do
      (CtEval.observe-environment! node state frame)
      (match-ref (SurfaceNode.form node)
        (SurfaceForm.List raw-items)
          (let [written (semantic-items raw-items)
                written-count (Array.length &written)
                items (editing-items node written 4)]
            (if (Int.= 4 (Array.length &items))
              (let [head (Box.peek (Array.unsafe-nth &items 0))
                    name-node (Box.peek (Array.unsafe-nth &items 1))
                    parameters (Box.peek (Array.unsafe-nth &items 2))
                    body (Box.peek (Array.unsafe-nth &items 3))]
                (if (named? head @"defndynamic")
                  (match (symbol-name name-node)
                    (Maybe.Just name)
                      (match (CtEval.define-dynamic-function parameters
                                                             body
                                                             frame)
                        (Result.Success function)
                          (let [partial (ExpandDynamic.init name
                                                            (Box.init function))]
                            (if (Int.< written-count 4)
                              (Result.Error
                                (error-at node
                                          @"defndynamic expects a name, parameter array, and body"))
                              (Result.Success partial)))
                        (Result.Error error) (Result.Error error))
                    (Maybe.Nothing)
                      (Result.Error
                        (error-at name-node
                                  @"defndynamic name must be an unqualified symbol")))
                  (Result.Error (error-at node @"expected defndynamic"))))
              (Result.Error
                (error-at node
                          @"defndynamic expects a name, parameter array, and body"))))
        _ (Result.Error (error-at node @"defndynamic must be a list")))))

  (private parse-dynamic-value)
  (hidden parse-dynamic-value)
  (defn parse-dynamic-value [node state frame]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (Int.= 3 (Array.length &items))
            (let [head (Box.peek (Array.unsafe-nth &items 0))
                  name-node (Box.peek (Array.unsafe-nth &items 1))
                  value-form (Box.peek (Array.unsafe-nth &items 2))]
              (if (named? head @"defdynamic")
                (match (symbol-name name-node)
                  (Maybe.Just name)
                    (match (CtEval.eval-node value-form state frame)
                      (Result.Success value)
                        (Result.Success
                          (ExpandDynamic.init name (Box.init value)))
                      (Result.Error error) (Result.Error error))
                  (Maybe.Nothing)
                    (Result.Error
                      (error-at name-node
                                @"defdynamic name must be an unqualified symbol")))
                (Result.Error (error-at node @"expected defdynamic"))))
            (Result.Error
              (error-at node @"defdynamic expects a name and a value"))))
      _ (Result.Error (error-at node @"defdynamic must be a list"))))

  (private same-frame?)
  (hidden same-frame?)
  (defn same-frame? [left right]
    (Int.= @(FrameId.index left) @(FrameId.index right)))

  (private macro-in-frame)
  (hidden macro-in-frame)
  (defn macro-in-frame [macros frame name]
    (let-do [result (Maybe.Nothing)
             n (Array.length macros)]
      (for [i 0 n]
        (let [macro (Array.unsafe-nth macros i)]
          (when (and (= (ExpandMacro.name macro) name)
                     (same-frame? (ExpandMacro.defining-frame macro) frame))
            (set! result (Maybe.Just @macro)))))
      result))

  (private macro-by-name)
  (hidden macro-by-name)
  (private module-frame)
  (hidden module-frame)
  (private macro-in-frames)
  (hidden macro-in-frames)
  (defn macro-in-frames [macros frames name]
    (let-do [result (the MacroLookup (MacroLookup.Missing))
             found-frame (the (Maybe FrameId) (Maybe.Nothing))
             n (Array.length frames)]
      (for [i 0 n]
        (match-ref &result
          (MacroLookup.Ambiguous) ()
          _
            (let [frame (Array.unsafe-nth frames i)]
              (match (macro-in-frame macros frame name)
                (Maybe.Just macro)
                  (match-ref &found-frame
                    (Maybe.Nothing)
                      (do
                        (set! found-frame (Maybe.Just @frame))
                        (set! result (MacroLookup.Found macro)))
                    (Maybe.Just prior)
                      (unless (same-frame? prior frame)
                        (set! result (MacroLookup.Ambiguous))))
                (Maybe.Nothing) ()))))
      result))

  (defn macro-by-name [macros modules preludes scope node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.Symbol segments)
        (let [n (Array.length segments)]
          (cond
            (Int.= n 1)
              (let [name (Array.unsafe-nth segments 0)]
                (match (macro-in-frame macros (ExpandScope.frame scope) name)
                  (Maybe.Just macro) (MacroLookup.Found macro)
                  (Maybe.Nothing)
                    (match (macro-in-frames macros
                                            (ExpandScope.imports scope)
                                            name)
                      (MacroLookup.Found macro) (MacroLookup.Found macro)
                      (MacroLookup.Ambiguous) (MacroLookup.Ambiguous)
                      (MacroLookup.Missing)
                        (match (macro-in-frames macros preludes name)
                          (MacroLookup.Found macro) (MacroLookup.Found macro)
                          (MacroLookup.Ambiguous) (MacroLookup.Ambiguous)
                          (MacroLookup.Missing)
                            (match (module-frame modules "")
                              (Maybe.Just root)
                                (match (macro-in-frame macros &root name)
                                  (Maybe.Just macro) (MacroLookup.Found macro)
                                  (Maybe.Nothing) (MacroLookup.Missing))
                              (Maybe.Nothing) (MacroLookup.Missing))))))
            (Int.> n 1)
              (let [path-parts (Array.prefix segments (Int.dec n))
                    path (String.join "." &path-parts)
                    name (Array.unsafe-nth segments (Int.dec n))]
                (match (module-frame modules &path)
                  (Maybe.Just frame)
                    (match (macro-in-frame macros &frame name)
                      (Maybe.Just macro) (MacroLookup.Found macro)
                      (Maybe.Nothing) (MacroLookup.Missing))
                  (Maybe.Nothing) (MacroLookup.Missing)))
            (MacroLookup.Missing)))
      _ (MacroLookup.Missing)))

  (private closure-at?)
  (hidden closure-at?)
  (defn closure-at? [state path local]
    (if (= path "")
      (CtEval.closure-in-frame? state &(CtEval.root state) local)
      (match (CtEval.module-frame state path)
        (Maybe.Just frame) (CtEval.closure-in-frame? state &frame local)
        (Maybe.Nothing) false)))

  (private runtime-definition-head?)
  (hidden runtime-definition-head?)
  (defn runtime-definition-head? [name]
    (or (= name "defn")
        (or (= name "defn-") (or (= name "def") (= name "def-")))))

  (private pattern-names!)
  (hidden pattern-names!)
  (defn pattern-names! [pattern names]
    (match-ref (SurfaceNode.form pattern)
      (SurfaceForm.Symbol _)
      (match (symbol-key pattern)
        (Maybe.Just name) (unless (= &name "_") (Array.push-back! names name))
        (Maybe.Nothing) ())
      (SurfaceForm.List items)
      ; a constructor pattern binds its arguments, not its head
      (let [parts (semantic-items items)]
        (for [i 1 (Array.length &parts)]
          (pattern-names! (Box.peek (Array.unsafe-nth &parts i)) names)))
      _
      ()))

  (private vector-names!)
  (hidden vector-names!)
  (defn vector-names! [node step names]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.Array items)
        (let-do [parts (semantic-items items)
                 i 0]
          (while-do (Int.< i (Array.length &parts))
            (pattern-names! (Box.peek (Array.unsafe-nth &parts i)) names)
            (set! i (Int.+ i step))))
      _ ()))

  (private bound-names)
  (hidden bound-names)
  (doc bound-names "returns the runtime names that the form `name` with `items`
binds for its body: the parameters of `defn` and `fn`, the names of `let`, and
the variables of each `match` pattern.")
  (defn bound-names [name items]
    (let-do [parts (semantic-items items)
             n (Array.length &parts)
             names (the (Array String) [])]
      (cond
        (and (or (= name "defn") (= name "defn-")) (Int.> n 2))
          (vector-names! (Box.peek (Array.unsafe-nth &parts 2)) 1 &names)
        (and (= name "fn") (Int.> n 1))
          (vector-names! (Box.peek (Array.unsafe-nth &parts 1)) 1 &names)
        (and (= name "let") (Int.> n 1))
          (vector-names! (Box.peek (Array.unsafe-nth &parts 1)) 2 &names)
        (or (= name "match") (= name "match-ref"))
          (let-do [i 2]
            (while-do (Int.< i n)
              (pattern-names! (Box.peek (Array.unsafe-nth &parts i)) &names)
              (set! i (Int.+ i 2))))
        ())
      names))

  (private locally-bound?)
  (hidden locally-bound?)
  (defn locally-bound? [name]
    (and (not (String.contains? name \.))
         (Array.contains? &*expand-locals* name)))

  (private dynamic-function-call?)
  (hidden dynamic-function-call?)
  (doc dynamic-function-call? "checks whether the call head `name` in static
code names a `defndynamic` function. The reference evaluates such a call at
compile time and splices the result. The head resolves by its exact path, as
written or under the current module, never through a `use` or the `Dynamic`
prelude, as in the reference: under `(use Array)`, `(reduce ...)` stays static.")
  (defn dynamic-function-call? [state scope name]
    (let [segments (String.split-by name &[\.])
          n (Array.length &segments)]
      (if (Int.< n 1)
        false
        (let [local (Array.unsafe-nth &segments (Int.dec n))
              written (String.join "." &(Array.prefix &segments (Int.dec n)))
              scope-path (ExpandScope.path scope)
              relative (cond
                (= scope-path "") @&written
                (= &written "") @scope-path
                (qualified-name scope-path &written))]
          (or (closure-at? state &written local)
              (and (/= &relative &written) (closure-at? state &relative local)))))))

  (private call-arguments)
  (hidden call-arguments)
  (defn call-arguments [items]
    (let-do [result (the (Array (Box SurfaceNode)) [])
             n (Array.length items)]
      (for [i 1 n]
        (let [item (Box.peek (Array.unsafe-nth items i))]
          (match-ref (SurfaceNode.form item)
            (SurfaceForm.Comment _) ()
            _
              (set! result
                    (Array.push-back result (Box.init (SurfaceNode.copy item)))))))
      result))

  (private bindings-for)
  (hidden bindings-for)
  (private rest-syntax)
  (hidden rest-syntax)
  (defn rest-syntax [call arguments start]
    (let-do [items (the (Array (Box SurfaceNode)) [])
             n (Array.length arguments)]
      (for [i start n]
        (set! items
              (Array.push-back items
                               (Box.init
                                 (SurfaceNode.copy
                                   (Box.peek (Array.unsafe-nth arguments i)))))))
      (SurfaceNode.generated @(SurfaceNode.span call) (SurfaceForm.List items))))

  (private expand-macro-template)
  (hidden expand-macro-template)
  (doc expand-macro-template "runs the body of `macro` for `call`. Steps inside
it report the macro's own file, under the call.")
  (defn expand-macro-template [call macro state frame]
    (let-do [_entered (CtEval.enter-call! call state frame)
             _pushed (CtEval.push-step-file! (ExpandMacro.file macro))
             result (CtEval.eval-proto-template @(ExpandMacro.code macro)
                                                (Box.peek (ExpandMacro.body macro))
                                                state
                                                frame
                                                @(FrameId.index (ExpandMacro.defining-frame macro)))
             _popped (CtEval.pop-step-file!)
             _left (CtEval.leave-call!)]
      result))

  (defn bindings-for [call macro state arguments]
    (let [parameters (ExpandMacro.parameters macro)
          fixed (MacroParameters.fixed parameters)
          rest @(MacroParameters.rest parameters)
          fixed-count (Array.length fixed)
          argument-count (Array.length arguments)]
      (if (or (Int.< argument-count fixed-count)
              (and (Maybe.nothing? &rest) (/= fixed-count argument-count)))
        (Result.Error
          (error-at call
                    (String.concat
                      &[@"the macro "
                        @(ExpandMacro.name macro)
                        @" takes "
                        (if (Maybe.just? &rest)
                          (String.concat &[@"at least " (Int.str fixed-count)])
                          (Int.str fixed-count))
                        (if (Int.= fixed-count 1)
                          @" argument, got "
                          @" arguments, got ")
                        (Int.str argument-count)])))
        (let-do [frame (CtEval.child! state (ExpandMacro.defining-frame macro))
                 n fixed-count]
          (for [i 0 n]
            (ignore
              (CtEval.define-local! state
                                    &frame
                                    (Array.unsafe-nth fixed i)
                                    (CtValue.Syntax
                                      (Box.init
                                        (SurfaceNode.copy
                                          (Box.peek (Array.unsafe-nth arguments
                                                                      i))))))))
          (match rest
            (Maybe.Just rest-name)
              (ignore
                (CtEval.define-local! state
                                      &frame
                                      &rest-name
                                      (CtValue.Syntax
                                        (Box.init (rest-syntax call
                                                               arguments
                                                               fixed-count)))))
            (Maybe.Nothing) ())
          (Result.Success frame)))))

  ; the doc of `expand-node` also declares it for the mutual recursion below,
  ; under the reference compiler
  (doc expand-node "expands the macro calls in `node`, recursively. Quoted forms
are not expanded. While recovering, a node that fails becomes `Invalid`, and so
does every node after the first error.")
  (defn expand-node-strict [node macros state modules preludes scope]
    (if (WorkBudget.consume! 1)
      (match-ref (SurfaceNode.form node)
        (SurfaceForm.List items)
          (if (Int.= 0 (Array.length items))
            (Result.Success (SurfaceNode.copy node))
            (let [head (Box.peek (Array.unsafe-nth items 0))]
              (if (named? head @"quote")
                (do
                  (when (Int.> (Array.length items) 1)
                    (SourceObservations.opaque! (Box.peek (Array.unsafe-nth items
                                                                            1))))
                  (Result.Success (SurfaceNode.copy node)))
                (match (symbol-key head)
                  (Maybe.Just name)
                    (match (macro-by-name macros modules preludes scope head)
                      (MacroLookup.Found macro)
                      (let [arguments (call-arguments items)
                            _observed (SourceObservations.record! head
                                                                  (ExpandMacro.name &macro)
                                                                  "macro")]
                        (match (bindings-for node &macro state &arguments)
                          (Result.Success frame)
                            (match (expand-macro-template node
                                                          &macro
                                                          state
                                                          &frame)
                              (Result.Success generated)
                                (let-do [next (SurfaceNode.copy &generated)
                                         _ignored-anchor (Surface.reanchor! &next
                                                                            (SurfaceNode.span node))]
                                  (expand-node &next
                                               macros
                                               state
                                               modules
                                               preludes
                                               scope))
                              (Result.Error error)
                                (Result.Error
                                  (CtError.init
                                    (String.concat
                                      &[@"while expanding macro "
                                        (String.copy (ExpandMacro.name &macro))
                                        @": "
                                        (String.copy (CtError.message &error))])
                                    @(SurfaceNode.span node))))
                          (Result.Error error) (Result.Error error)))
                      (MacroLookup.Ambiguous)
                      (Result.Error
                        (error-at head
                                  (String.append "ambiguous imported macro: "
                                                 &name)))
                      (MacroLookup.Missing)
                      ; the reference evaluates a `Dynamic.`-qualified call in
                      ; static code at compile time and splices the result, and
                      ; so does a call to a `defndynamic` function named by its
                      ; exact path
                      (if (or (String.starts-with? &name "Dynamic.")
                              (and *expand-in-definition*
                                   (and (not (locally-bound? &name))
                                        (dynamic-function-call? state
                                                                scope
                                                                &name))))
                        ; inside a definition the result is code, and is
                        ; expanded like a macro's. a top-level submission keeps
                        ; it as a value.
                        (match (CtEval.eval-template node
                                                     state
                                                     (ExpandScope.frame scope))
                          (Result.Success generated)
                            (if *expand-in-definition*
                              (let-do [next (SurfaceNode.copy &generated)
                                       _ignored-anchor (Surface.reanchor! &next
                                                                          (SurfaceNode.span node))]
                                (expand-node &next
                                             macros
                                             state
                                             modules
                                             preludes
                                             scope))
                              (Result.Success generated))
                          (Result.Error error) (Result.Error error))
                        (let-do [result (the
                                   (Result (Array (Box SurfaceNode)) CtError)
                                   (Result.Success []))
                                 n (Array.length items)
                                 saved-in-definition *expand-in-definition*
                                 saved-locals (Array.length &*expand-locals*)]
                          (when (runtime-definition-head? &name)
                            (set! *expand-in-definition* true))
                          (when *expand-in-definition*
                            (let [names (bound-names &name items)]
                              (for [k 0 (Array.length &names)]
                                (Array.push-back! &*expand-locals*
                                                  @(Array.unsafe-nth &names k)))))
                          (for [i 0 n]
                            (match-ref &result
                              (Result.Success children)
                                (let [child (Box.peek (Array.unsafe-nth items i))]
                                  (match (expand-node child
                                                      macros
                                                      state
                                                      modules
                                                      preludes
                                                      scope)
                                    (Result.Success expanded)
                                      (Array.push-back! children
                                                        (Box.init expanded))
                                    (Result.Error error)
                                      (set! result (Result.Error error))))
                              (Result.Error error)
                                (set! result (Result.Error @error))))
                          (set! *expand-in-definition* saved-in-definition)
                          (while (Int.> (Array.length &*expand-locals*)
                                        saved-locals)
                            (ignore (Array.pop-back! &*expand-locals*)))
                          (match result
                            (Result.Success children)
                              (Result.Success
                                (SurfaceNode.init @(SurfaceNode.span node)
                                                  (SurfaceForm.List children)))
                            (Result.Error error) (Result.Error error)))))
                  (Maybe.Nothing)
                    (let-do [result (the
                               (Result (Array (Box SurfaceNode)) CtError)
                               (Result.Success []))
                             n (Array.length items)]
                      (for [i 0 n]
                        (match-ref &result
                          (Result.Success children)
                            (let [child (Box.peek (Array.unsafe-nth items i))]
                              (match (expand-node child
                                                  macros
                                                  state
                                                  modules
                                                  preludes
                                                  scope)
                                (Result.Success expanded)
                                  (Array.push-back! children (Box.init expanded))
                                (Result.Error error)
                                  (set! result (Result.Error error))))
                          (Result.Error error)
                            (set! result (Result.Error @error))))
                      (match result
                        (Result.Success children)
                          (Result.Success
                            (SurfaceNode.init @(SurfaceNode.span node)
                                              (SurfaceForm.List children)))
                        (Result.Error error) (Result.Error error)))))))
        (SurfaceForm.Array items)
          (let-do [result (the
                     (Result (Array (Box SurfaceNode)) CtError)
                     (Result.Success []))
                   n (Array.length items)]
            (for [i 0 n]
              (match-ref &result
                (Result.Success children)
                  (let [child (Box.peek (Array.unsafe-nth items i))]
                    (match (expand-node child
                                        macros
                                        state
                                        modules
                                        preludes
                                        scope)
                      (Result.Success expanded)
                        (Array.push-back! children (Box.init expanded))
                      (Result.Error error) (set! result (Result.Error error))))
                (Result.Error error) (set! result (Result.Error @error))))
            (match result
              (Result.Success children)
                (Result.Success
                  (SurfaceNode.init @(SurfaceNode.span node)
                                    (SurfaceForm.Array children)))
              (Result.Error error) (Result.Error error)))
        (SurfaceForm.StaticArray items)
          (let-do [result (the
                     (Result (Array (Box SurfaceNode)) CtError)
                     (Result.Success []))
                   n (Array.length items)]
            (for [i 0 n]
              (match-ref &result
                (Result.Success children)
                  (let [child (Box.peek (Array.unsafe-nth items i))]
                    (match (expand-node child
                                        macros
                                        state
                                        modules
                                        preludes
                                        scope)
                      (Result.Success expanded)
                        (Array.push-back! children (Box.init expanded))
                      (Result.Error error) (set! result (Result.Error error))))
                (Result.Error error) (set! result (Result.Error @error))))
            (match result
              (Result.Success children)
                (Result.Success
                  (SurfaceNode.init @(SurfaceNode.span node)
                                    (SurfaceForm.StaticArray children)))
              (Result.Error error) (Result.Error error)))
        (SurfaceForm.Dictionary items)
          (let-do [result (the
                     (Result (Array (Box SurfaceNode)) CtError)
                     (Result.Success []))
                   n (Array.length items)]
            (for [i 0 n]
              (match-ref &result
                (Result.Success children)
                  (let [child (Box.peek (Array.unsafe-nth items i))]
                    (match (expand-node child
                                        macros
                                        state
                                        modules
                                        preludes
                                        scope)
                      (Result.Success expanded)
                        (Array.push-back! children (Box.init expanded))
                      (Result.Error error) (set! result (Result.Error error))))
                (Result.Error error) (set! result (Result.Error @error))))
            (match result
              (Result.Success children)
                (Result.Success
                  (SurfaceNode.init @(SurfaceNode.span node)
                                    (SurfaceForm.Dictionary children)))
              (Result.Error error) (Result.Error error)))
        _ (Result.Success (SurfaceNode.copy node)))
      (Result.Error (error-at node (WorkBudget.reason)))))
  (private expand-node-strict)
  (hidden expand-node-strict)
  (defn expand-node [node macros state modules preludes scope]
    (if (and *expand-recovering* (not (Array.empty? &*expand-recovery-errors*)))
      (Result.Success
        (SurfaceNode.init @(SurfaceNode.span node)
                          (SurfaceForm.Invalid @"unexpanded after failure")))
      (match (expand-node-strict node macros state modules preludes scope)
        (Result.Success expanded) (Result.Success expanded)
        (Result.Error error)
          (if *expand-recovering*
            (do
              (Array.push-back! &*expand-recovery-errors* error)
              (Result.Success
                (SurfaceNode.init @(SurfaceNode.span node)
                                  (SurfaceForm.Invalid @"failed expansion"))))
            (Result.Error error)))))

  (private expand-node-1)
  (hidden expand-node-1)
  (doc expand-node-1 "expands the outermost macro call of `node`. It returns
`Nothing` if `node` is not a macro call, so that case differs from a call that
expands to the same form.")
  (defn expand-node-1 [node macros state modules preludes scope]
    (if (WorkBudget.consume! 1)
      (match-ref (SurfaceNode.form node)
        (SurfaceForm.List items)
          (if (Int.= 0 (Array.length items))
            (Result.Success (Maybe.Nothing))
            (let [head (Box.peek (Array.unsafe-nth items 0))]
              (if (named? head @"quote")
                (do
                  (when (Int.> (Array.length items) 1)
                    (SourceObservations.opaque! (Box.peek (Array.unsafe-nth items
                                                                            1))))
                  (Result.Success (Maybe.Nothing)))
                (match (symbol-key head)
                  (Maybe.Just name)
                    (match (macro-by-name macros modules preludes scope head)
                      (MacroLookup.Found macro)
                        (let [arguments (call-arguments items)
                              _observed (SourceObservations.record! head
                                                                    (ExpandMacro.name &macro)
                                                                    "macro")]
                          (match (bindings-for node &macro state &arguments)
                            (Result.Success frame)
                              (match (expand-macro-template node
                                                            &macro
                                                            state
                                                            &frame)
                                (Result.Success generated)
                                  (let-do [next (SurfaceNode.copy &generated)
                                           _ignored-anchor (Surface.reanchor! &next
                                                                              (SurfaceNode.span node))]
                                    (Result.Success (Maybe.Just next)))
                                (Result.Error error)
                                  (Result.Error
                                    (CtError.init
                                      (String.concat
                                        &[@"while expanding macro "
                                          (String.copy (ExpandMacro.name &macro))
                                          @": "
                                          (String.copy (CtError.message &error))])
                                      @(SurfaceNode.span node))))
                            (Result.Error error) (Result.Error error)))
                      (MacroLookup.Ambiguous)
                        (Result.Error
                          (error-at head
                                    (String.append "ambiguous imported macro: "
                                                   &name)))
                      (MacroLookup.Missing) (Result.Success (Maybe.Nothing)))
                  (Maybe.Nothing) (Result.Success (Maybe.Nothing))))))
        _ (Result.Success (Maybe.Nothing)))
      (Result.Error (error-at node (WorkBudget.reason)))))

  (private expand-top-level)
  (hidden expand-top-level)
  (private literal-arguments?)
  (hidden literal-arguments?)
  (defn literal-arguments? [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List raw-items)
        (let-do [items (semantic-items raw-items)
                 ok true]
          (for [i 1 (Array.length &items)]
            (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth &items i)))
              (SurfaceForm.StringLit _) ()
              (SurfaceForm.IntLit _) ()
              (SurfaceForm.BoolLit _) ()
              (SurfaceForm.CharLit _) ()
              _ (set! ok false)))
          ok)
      _ false))

  (defn expand-top-level [node macros state modules preludes scope]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List items)
        (if (Int.= 0 (Array.length items))
          (Result.Success (Maybe.Just (SurfaceNode.copy node)))
          (let [head (Box.peek (Array.unsafe-nth items 0))]
            (match (macro-by-name macros modules preludes scope head)
              (MacroLookup.Found _)
                (match (expand-node node macros state modules preludes scope)
                  (Result.Success expanded)
                    (Result.Success (Maybe.Just expanded))
                  (Result.Error error) (Result.Error error))
              (MacroLookup.Ambiguous)
                (Result.Error (error-at head @"ambiguous imported macro"))
              (MacroLookup.Missing)
                (match (symbol-key head)
                  (Maybe.Just name)
                    (if (or (String.= &name "eval")
                            (or (String.= &name "set!")
                                ;; the evaluator's own: it runs with no
                                ;; prelude definition behind it
                                (String.= &name "Project.config")))
                      (match (CtEval.eval-node node
                                               state
                                               (ExpandScope.frame scope))
                        (Result.Success _) (Result.Success (Maybe.Nothing))
                        (Result.Error error) (Result.Error error))
                      ; a top-level call to a pure compile-time command with
                      ; literal arguments is evaluated now and dropped, as in
                      ; the reference's REPL (`(String.char-at "" 1)` fails
                      ; here). with other arguments it compiles as a root.
                      (cond
                        (and (CtEval.pure-string-command? &name)
                             (literal-arguments? node))
                        (match (CtEval.eval-node node
                                                 state
                                                 (ExpandScope.frame scope))
                          (Result.Success _) (Result.Success (Maybe.Nothing))
                          (Result.Error error) (Result.Error error))
                        (named? head @"if")
                        ; a top-level `if` whose condition evaluates to a
                        ; boolean literal, such as `(= target-arch "aarch64")`,
                        ; is replaced by its branch. other conditions stay a
                        ; runtime expression.
                        (match-ref (SurfaceNode.form node)
                          (SurfaceForm.List raw-items)
                            (let [items (semantic-items raw-items)
                                  folded (if (Int.= (Array.length &items) 4)
                                    (match (CtEval.eval-node (Box.peek (Array.unsafe-nth &items
                                                                                         1))
                                                             state
                                                             (ExpandScope.frame scope))
                                      (Result.Success value)
                                        (match value
                                          (CtValue.Syntax boxed)
                                            (match-ref (SurfaceNode.form (Box.peek &boxed))
                                              (SurfaceForm.BoolLit condition)
                                                (Maybe.Just @condition)
                                              _
                                                (the (Maybe Bool)
                                                     (Maybe.Nothing)))
                                          _ (Maybe.Nothing))
                                      (Result.Error _) (Maybe.Nothing))
                                    (Maybe.Nothing))]
                              (match folded
                                (Maybe.Just condition)
                                  (expand-top-level
                                    (Box.peek
                                      (Array.unsafe-nth &items
                                                        (if condition 2 3)))
                                    macros
                                    state
                                    modules
                                    preludes
                                    scope)
                                (Maybe.Nothing)
                                  (match (expand-node node
                                                      macros
                                                      state
                                                      modules
                                                      preludes
                                                      scope)
                                    (Result.Success expanded)
                                      (Result.Success (Maybe.Just expanded))
                                    (Result.Error error) (Result.Error error))))
                          _
                            (match (expand-node node
                                                macros
                                                state
                                                modules
                                                preludes
                                                scope)
                              (Result.Success expanded)
                                (Result.Success (Maybe.Just expanded))
                              (Result.Error error) (Result.Error error)))
                        (match (CtEval.lookup-status state
                                                     (ExpandScope.frame scope)
                                                     &name)
                          (CtEnvLookup.Found cell)
                            (match (CtEval.read-cell state &cell)
                              (Maybe.Just value)
                                (match value
                                  (CtValue.Closure _)
                                    (match (CtEval.eval-node node
                                                             state
                                                             (ExpandScope.frame scope))
                                      (Result.Success _)
                                        (Result.Success (Maybe.Nothing))
                                      (Result.Error error) (Result.Error error))
                                  _
                                    (Result.Error
                                      (error-at head
                                                @"top-level compile-time binding is not callable")))
                              (Maybe.Nothing)
                                (Result.Error
                                  (error-at head @"invalid compile-time cell")))
                          (CtEnvLookup.Ambiguous)
                            (Result.Error
                              (error-at head
                                        (String.append "ambiguous compile-time function: "
                                                       &name)))
                          (CtEnvLookup.Missing)
                            (match (expand-node node
                                                macros
                                                state
                                                modules
                                                preludes
                                                scope)
                              (Result.Success expanded)
                                (Result.Success (Maybe.Just expanded))
                              (Result.Error error) (Result.Error error)))))
                  (Maybe.Nothing)
                    (match (expand-node node macros state modules preludes scope)
                      (Result.Success expanded)
                        (Result.Success (Maybe.Just expanded))
                      (Result.Error error) (Result.Error error))))))
      _
        (match (expand-node node macros state modules preludes scope)
          (Result.Success expanded) (Result.Success (Maybe.Just expanded))
          (Result.Error error) (Result.Error error))))

  (private defmacro?)
  (hidden defmacro?)
  (defn defmacro? [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List items)
        (if (Int.> (Array.length items) 0)
          (named? (Box.peek (Array.unsafe-nth items 0)) @"defmacro")
          false)
      _ false))

  (private defndynamic?)
  (hidden defndynamic?)
  (defn defndynamic? [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List items)
        (if (Int.> (Array.length items) 0)
          (named? (Box.peek (Array.unsafe-nth items 0)) @"defndynamic")
          false)
      _ false))

  (private defdynamic?)
  (hidden defdynamic?)
  (defn defdynamic? [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List items)
        (if (Int.> (Array.length items) 0)
          (named? (Box.peek (Array.unsafe-nth items 0)) @"defdynamic")
          false)
      _ false))

  (private defmodule?)
  (hidden defmodule?)
  ;; the loader's load-stack markers: maintain the compile-time load stack
  ;; and vanish from the expanded stream.
  (private load-stack-marker-head?)
  (hidden load-stack-marker-head?)
  (defn load-stack-marker-head? [node name]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List items)
        (if (Int.> (Array.length items) 0)
          (match (symbol-key (Box.peek (Array.unsafe-nth items 0)))
            (Maybe.Just key) (String.= &key name)
            (Maybe.Nothing) false)
          false)
      _ false))

  (private load-stack-marker-file)
  (hidden load-stack-marker-file)
  (defn load-stack-marker-file [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List items)
        (if (Int.= 2 (Array.length items))
          (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth items 1)))
            (SurfaceForm.StringLit path) (Maybe.Just @path)
            _ (the (Maybe String) (Maybe.Nothing)))
          (Maybe.Nothing))
      _ (Maybe.Nothing)))

  (private compile-time-command?)
  (hidden compile-time-command?)
  (defn defmodule? [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List items)
        (if (Int.> (Array.length items) 0)
          (named? (Box.peek (Array.unsafe-nth items 0)) @"defmodule")
          false)
      _ false))

  (private record-command-flag!)
  (hidden record-command-flag!)
  (defn record-command-flag! [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List items)
        (when (Int.= 2 (Array.length items))
          (let [head (Box.peek (Array.unsafe-nth items 0))]
            (when (or (named? head @"add-cflag")
                      (or (named? head @"add-lib") (named? head @"add-pkg")))
              (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth items 1)))
                (SurfaceForm.StringLit flag)
                  (CtEval.record-build-command!
                    &(Maybe.from (symbol-key head) @"add-cflag")
                    flag)
                _ ()))))
      _ ()))

  (defn compile-time-command? [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List items)
        (if (Int.> (Array.length items) 0)
          (let [head (Box.peek (Array.unsafe-nth items 0))]
            (or (named? head @"macro-log")
                (or (named? head @"quit")
                    (or (named? head @"add-cflag")
                        (or (named? head @"add-lib") (named? head @"add-pkg"))))))
          false)
      _ false))

  (private module-name)
  (hidden module-name)
  (defn module-name [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List items)
        (if (and (Int.> (Array.length items) 1)
                 (named? (Box.peek (Array.unsafe-nth items 0)) @"defmodule"))
          (symbol-key (Box.peek (Array.unsafe-nth items 1)))
          (Maybe.Nothing))
      _ (Maybe.Nothing)))

  ;; module paths imported by a `use` or `use-all` form (empty for anything
  ;; else). `(use-all A B ...)` brings every listed module into scope, so its
  ;; macros resolve unqualified just like `(use A)` does for one.
  (private use-targets)
  (hidden use-targets)
  (defn use-targets [node]
    (let-do [result (the (Array String) [])]
      (match-ref (SurfaceNode.form node)
        (SurfaceForm.List items)
          (when (Int.> (Array.length items) 1)
            (let [head (Box.peek (Array.unsafe-nth items 0))]
              (cond
                (named? head @"use")
                  (match (symbol-key (Box.peek (Array.unsafe-nth items 1)))
                    (Maybe.Just path) (Array.push-back! &result path)
                    (Maybe.Nothing) ())
                (named? head @"use-all")
                  (for [i 1 (Array.length items)]
                    (match (symbol-key (Box.peek (Array.unsafe-nth items i)))
                      (Maybe.Just path) (Array.push-back! &result path)
                      (Maybe.Nothing) ()))
                ())))
        _ ())
      result))

  (defn module-frame [modules path]
    (let-do [result (the (Maybe FrameId) (Maybe.Nothing))
             n (Array.length modules)]
      (for [i 0 n]
        (match-ref &result
          (Maybe.Nothing)
            (let [entry (Array.unsafe-nth modules i)]
              (when (= (ExpandModuleFrame.path entry) path)
                (set! result (Maybe.Just @(ExpandModuleFrame.frame entry)))))
          (Maybe.Just _) ()))
      result))

  (private ensure-module-frame!)
  (hidden ensure-module-frame!)
  (defn ensure-module-frame! [state modules path]
    (match (module-frame modules path)
      (Maybe.Just frame)
        (do (ignore (CtEval.register-module! state path &frame)) frame)
      (Maybe.Nothing)
        (let-do [root (CtEval.root state)
                 frame (CtEval.child! state &root)]
          (Array.push-back! modules
                            (ExpandModuleFrame.init @path (FrameId.copy &frame)))
          (ignore (CtEval.register-module! state path &frame))
          frame)))

  (private configured-prelude?)
  (hidden configured-prelude?)
  (defn configured-prelude? [config path]
    (let-do [result false
             names (ExpandConfig.preludes config)
             n (Array.length names)]
      (for [i 0 n] (when (= (Array.unsafe-nth names i) path) (set! result true)))
      result))

  (private frame-listed?)
  (hidden frame-listed?)
  (defn frame-listed? [frames frame]
    (let-do [result false
             n (Array.length frames)]
      (for [i 0 n]
        (when (same-frame? (Array.unsafe-nth frames i) frame) (set! result true)))
      result))

  (private register-prelude!)
  (hidden register-prelude!)
  (defn register-prelude! [state config preludes path frame]
    (when (and (configured-prelude? config path)
               (not (frame-listed? preludes frame)))
      (let-do [root (CtEval.root state)]
        (Array.push-back! preludes @frame)
        (ignore (CtEval.import! state &root frame)))))

  (private register-dynamic!)
  (hidden register-dynamic!)
  (defn register-dynamic! [state scope dynamic]
    (let-do [cell (CtEval.define! state
                                  (ExpandScope.frame scope)
                                  (ExpandDynamic.name dynamic)
                                  (CtValue.copy (Box.peek (ExpandDynamic.value dynamic))))]
      (unless (= (ExpandScope.path scope) "")
        (let [root (CtEval.root state)
              qualified (qualified-name (ExpandScope.path scope)
                                        (ExpandDynamic.name dynamic))]
          (ignore (CtEval.alias! state &root &qualified &cell))))))

  (private module-with-body)
  (hidden module-with-body)
  (defn module-with-body [node body]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List items)
        (let-do [result (the (Array (Box SurfaceNode)) [])]
          (for [i 0 2]
            (set! result
                  (Array.push-back result
                                   (Box.init
                                     (SurfaceNode.copy (Box.peek (Array.unsafe-nth items
                                                                                   i)))))))
          (for [i 0 (Array.length body)]
            (set! result
                  (Array.push-back result
                                   (Box.init
                                     (SurfaceNode.copy (Box.peek (Array.unsafe-nth body
                                                                                   i)))))))
          (SurfaceNode.init @(SurfaceNode.span node) (SurfaceForm.List result)))
      _ (SurfaceNode.copy node)))

  (private record-metadata!)
  (hidden record-metadata!)
  (private record-metadata-entry!)
  (hidden record-metadata-entry!)
  (private record-metadata-doc!)
  (hidden record-metadata-doc!)
  (private record-metadata-named!)
  (hidden record-metadata-named!)
  (doc record-metadata! "records the metadata that `node` sets, written or
produced by a macro: `(meta-set! name \"key\" value)`, `(doc name \"text\")`,
and `(private name)` or `(hidden name)` as a true flag. Entries are recorded
under the name qualified by `scope`.")
  (defn record-metadata! [node scope]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)
              count (Array.length &items)]
          (when (Int.>= count 2)
            (let [head (Box.peek (Array.unsafe-nth &items 0))]
              (cond
                (and (named? head @"meta-set!") (Int.= count 4))
                (record-metadata-entry! (Box.peek (Array.unsafe-nth &items 1))
                                        (Box.peek (Array.unsafe-nth &items 2))
                                        (Box.peek (Array.unsafe-nth &items 3))
                                        scope)
                (and (named? head @"doc") (Int.>= count 3))
                (record-metadata-doc! &items scope)
                ; `(private f)` and `(hidden f)` are core's
                ; `(meta-set! f "private" true)`, which `private?` and
                ; `hidden?` read back
                (and
                  (or (named? head @"private") (named? head @"hidden"))
                  (Int.= count 2))
                (let [name-node (Box.peek (Array.unsafe-nth &items 1))]
                  (record-metadata-named! name-node
                                          (if (named? head @"private")
                                            "private"
                                            "hidden")
                                          &(SurfaceNode.generated @(SurfaceNode.span name-node)
                                                                  (SurfaceForm.BoolLit true))
                                          scope))
                ()))))
      _ ()))

  (defn record-metadata-entry! [name-node key-node value scope]
    (match-ref (SurfaceNode.form key-node)
      (SurfaceForm.StringLit key)
        (record-metadata-named! name-node key value scope)
      _ ()))

  (doc record-metadata-doc! "records the strings of a `doc` form as the doc of
its name, each followed by a newline. Items that are not string literals are
skipped.")
  (defn record-metadata-doc! [items scope]
    (let-do [text (StringBuf.create)
             n (Array.length items)]
      (for [i 2 n]
        (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth items i)))
          (SurfaceForm.StringLit line)
            (do
              (StringBuf.append-str &text line)
              (StringBuf.append-char &text \newline))
          _ ()))
      (record-metadata-named! (Box.peek (Array.unsafe-nth items 1))
                              "doc"
                              &(SurfaceNode.generated
                                @(SurfaceNode.span (Box.peek (Array.unsafe-nth items
                                                                               1)))
                                (SurfaceForm.StringLit (StringBuf.into-string text)))
                              scope)))

  ; metadata is recorded under the qualified name only: `(private f)` inside
  ; `A` annotates `A.f`, not a root `f`. `meta` resolves a bare name from the
  ; module it is read in.
  (defn record-metadata-named! [name-node key value scope]
    (match (symbol-key name-node)
      (Maybe.Just name)
        (CtEval.record-meta!
          &(qualified-name (ExpandScope.path scope) &name)
          key
          value)
      (Maybe.Nothing) ()))

  (private record-typing-form!)
  (hidden record-typing-form!)
  (doc record-typing-form! "keeps `form` for `type` to infer against, if `scope`
is the root. Forms inside modules are kept as part of their module.")
  (defn record-typing-form! [form scope]
    (when (String.empty? (ExpandScope.path scope))
      (CtEval.record-typing-form! form)))

  (private opaque-top-level?)
  (hidden opaque-top-level?)
  (defn opaque-top-level? [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List items)
        (if (Int.= 0 (Array.length items))
          false
          (let [head (Box.peek (Array.unsafe-nth items 0))]
            (or (named? head @"doc")
                (or (named? head @"hidden")
                    (or (named? head @"private")
                        (or (named? head @"deprecated")
                            (or (named? head @"meta-set!")
                                (or (named? head @"defmodule")
                                    (or (named? head @"deftype")
                                        (or (named? head @"deftemplate")
                                            (or (named? head @"implements")
                                                (or (named? head @"register")
                                                    (or (named? head
                                                                @"system-include")
                                                        (or (named? head @"load")
                                                            (or (named? head
                                                                        @"load-once")
                                                                (named? head
                                                                        @"use"))))))))))))))))
      _ false))

  (private expand-module-form)
  (hidden expand-module-form)
  (private expand-body)
  (hidden expand-body)
  (defn expand-module-form [node
                            scope
                            macros
                            state
                            modules
                            config
                            preludes
                            runtime]
    (match (module-name node)
      (Maybe.Just name)
        (match-ref (SurfaceNode.form node)
          (SurfaceForm.List items)
            (let [path (qualified-name (ExpandScope.path scope) &name)
                  frame (ensure-module-frame! state modules &path)
                  child-scope (ExpandScope.init (String.copy &path)
                                                (FrameId.copy &frame)
                                                [])]
              (let-do [_ (register-prelude! state config preludes &path &frame)
                       expanded-result (expand-body items
                                                    2
                                                    child-scope
                                                    macros
                                                    state
                                                    modules
                                                    config
                                                    preludes
                                                    runtime)]
                (match-ref &expanded-result
                  (Result.Success body)
                    (Result.Success (module-with-body node body))
                  (Result.Error error) (Result.Error @error))))
          _ (Result.Error (error-at node @"defmodule must be a list")))
      (Maybe.Nothing)
        (Result.Error (error-at node @"defmodule requires a module symbol"))))

  (private deftype?)
  (hidden deftype?)
  (defn deftype? [form]
    (match-ref (SurfaceNode.form form)
      (SurfaceForm.List items)
        (and (Int.> (Array.length items) 0)
             (named? (Box.peek (Array.unsafe-nth items 0)) @"deftype"))
      _ false))

  ; returns `Name` for a deftype name `Name` or `(Name v..)`
  (private deftype-name)
  (hidden deftype-name)
  (defn deftype-name [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.Symbol _) (symbol-key node)
      (SurfaceForm.List name-items)
        (if (Int.> (Array.length name-items) 0)
          (symbol-key (Box.peek (Array.unsafe-nth name-items 0)))
          (Maybe.Nothing))
      _ (Maybe.Nothing)))

  (private register-deftype-members!)
  (hidden register-deftype-members!)

  (private delete-implementation-type-name)
  (hidden delete-implementation-type-name)
  (private register-managed-implementation!)
  (hidden register-managed-implementation!)
  (private source-binding-name)
  (hidden source-binding-name)
  (private source-binding-head?)
  (hidden source-binding-head?)
  (private register-source-expression!)
  (hidden register-source-expression!)
  (private register-source-expressions!)
  (hidden register-source-expressions!)
  ; binds `__members_<Name>` to the fields of a record deftype, as
  ; `[[name type] ...]`, in the module that declares the type. the `members`
  ; primitive reads it.
  (defn register-deftype-members! [state form scope]
    (match-ref (SurfaceNode.form form)
      (SurfaceForm.List items)
        (when (Int.>= (Array.length items) 3)
          (match (deftype-name (Box.peek (Array.unsafe-nth items 1)))
            (Maybe.Just type-name)
              (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth items 2)))
                (SurfaceForm.Array field-items)
                  (let-do [pairs (the (Array (Box SurfaceNode)) [])
                           span @(SurfaceNode.span form)
                           k 0]
                    (while (Int.< (Int.inc k) (Array.length field-items))
                      (let-do [name-copy (SurfaceNode.copy
                                 (Box.peek (Array.unsafe-nth field-items k)))
                               type-copy (SurfaceNode.copy
                                 (Box.peek
                                   (Array.unsafe-nth field-items (Int.inc k))))
                               pair (SurfaceNode.generated @&span
                                                           (SurfaceForm.List
                                                             [(Box.init name-copy)
                                                              (Box.init type-copy)]))]
                        (Array.push-back! &pairs (Box.init pair))
                        (set! k (Int.+ k 2))))
                    (let [members-node (SurfaceNode.generated @&span
                                                              (SurfaceForm.Array pairs))
                          binding-name (String.concat
                            &[@"__members_" (String.copy &type-name)])]
                      (ignore
                        (CtEval.define! state
                                        (ExpandScope.frame scope)
                                        &binding-name
                                        (CtValue.Syntax (Box.init members-node))))))
                _ ())
            (Maybe.Nothing) ()))
      _ ()))

  (defn source-binding-head? [head]
    (cond
      (named? head @"def") true
      (named? head @"def-") true
      (named? head @"defn") true
      (named? head @"defn-") true
      (named? head @"defmacro") true
      (named? head @"defdynamic") true
      (named? head @"defndynamic") true
      (named? head @"defmodule") true
      (named? head @"deftype") true
      (named? head @"definterface") true
      (named? head @"external") true
      (named? head @"command") true
      (named? head @"primitive") true
      (named? head @"register") true
      (named? head @"deftemplate") true
      false))

  (defn source-binding-name [form scope]
    (match-ref (SurfaceNode.form form)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (Int.>= (Array.length &items) 2)
            (let [head (Box.peek (Array.unsafe-nth &items 0))
                  name-node (Box.peek (Array.unsafe-nth &items 1))]
              (if (source-binding-head? head)
                (match (symbol-key name-node)
                  (Maybe.Just name)
                    (Maybe.Just (qualified-name (ExpandScope.path scope) &name))
                  (Maybe.Nothing) (Maybe.Nothing))
                (Maybe.Nothing)))
            (Maybe.Nothing)))
      _ (Maybe.Nothing)))

  (defn register-source-expression! [state form scope]
    (match (source-binding-name form scope)
      (Maybe.Just name)
        (let [root (CtEval.root state)
              binding-name (String.concat &[@"__sexpr_" (String.copy &name)])]
          (ignore
            (CtEval.define! state
                            &root
                            &binding-name
                            (CtValue.Syntax (Box.init (SurfaceNode.copy form))))))
      (Maybe.Nothing) ()))

  (defn register-source-expressions! [state form scope]
    (match-ref (SurfaceNode.form form)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (and (Int.>= (Array.length &items) 2)
                   (named? (Box.peek (Array.unsafe-nth &items 0)) @"defmodule"))
            (do
              (register-source-expression! state form scope)
              (match (symbol-key (Box.peek (Array.unsafe-nth &items 1)))
                (Maybe.Just module-name)
                  (let [child-scope (ExpandScope.init
                          (qualified-name (ExpandScope.path scope) &module-name)
                          @(ExpandScope.frame scope)
                          [])]
                    (for [i 2 (Array.length &items)]
                      (register-source-expressions! state
                                                    (Box.peek (Array.unsafe-nth &items
                                                                                i))
                                                    &child-scope)))
                (Maybe.Nothing) ()))
            (register-source-expression! state form scope)))
      _ ()))

  (private seed-transient-definition!)
  (hidden seed-transient-definition!)
  (doc seed-transient-definition! "registers the definition `form`, a macro, a
dynamic definition or a deftype's members, in the expansion environment. The
form itself is not changed.")
  (defn seed-transient-definition! [form scope macros state]
    (cond
      (defmacro? form)
        (do
          (register-source-expressions! state form scope)
          (match (parse-definition form (ExpandScope.frame scope) state)
            (Result.Success macro)
              (do
                (CtEval.register-compiled-macro! state
                                                 (ExpandScope.frame scope)
                                                 (ExpandMacro.name &macro)
                                                 @(ExpandMacro.code &macro)
                                                 @(ExpandMacro.defining-frame &macro))
                (Array.push-back! macros macro)
                (Result.Success ()))
            (Result.Error error) (Result.Error error)))
      (defndynamic? form)
        (do
          (register-source-expressions! state form scope)
          (match (parse-dynamic-definition form &(CtEval.root state) state)
            (Result.Success dynamic)
              (do (register-dynamic! state scope &dynamic) (Result.Success ()))
            (Result.Error error) (Result.Error error)))
      (defdynamic? form)
        (do
          (register-source-expressions! state form scope)
          (match (parse-dynamic-value form state (ExpandScope.frame scope))
            (Result.Success dynamic)
              (do (register-dynamic! state scope &dynamic) (Result.Success ()))
            (Result.Error error) (Result.Error error)))
      (deftype? form)
        (do
          (register-source-expressions! state form scope)
          (register-deftype-members! state form scope)
          (Result.Success ()))
      (Result.Success ())))

  (doc expand-module-1-against "expands the outermost macro call of each
top-level form of `module` by one step, against a copy of `snapshot`.
Definitions earlier in `module` are seen by the forms after them. It returns
`Nothing` if no top-level form is a macro call.")
  (sig expand-module-1-against
       (Fn
         [(Ref SurfaceModule) (Ref ExpandSnapshot)]
         (Result (Maybe SurfaceModule) CtError)))
  (defn expand-module-1-against [module snapshot]
    (let-do [_ignored-stack (CtEval.reset-load-stack!)
             _ignored-typing (set! *ct-typing-forms*
                                   (Array.copy (ExpandSnapshot.typing-forms snapshot)))
             _ignored-meta (set! *ct-meta*
                                 (Array.copy (ExpandSnapshot.meta snapshot)))
             scope (ExpandScope.copy (ExpandSnapshot.scope snapshot))
             macros (Array.copy (ExpandSnapshot.macros snapshot))
             state (CtState.copy (ExpandSnapshot.state snapshot))
             modules (Array.copy (ExpandSnapshot.modules snapshot))
             preludes (Array.copy (ExpandSnapshot.preludes snapshot))
             forms (SurfaceModule.forms module)
             expanded (the (Array (Box SurfaceNode)) [])
             changed false
             failure (the (Maybe CtError) (Maybe.Nothing))]
      (for [i 0 (Array.length forms)]
        (match-ref &failure
          (Maybe.Just _) ()
          (Maybe.Nothing)
            (let [form (Box.peek (Array.unsafe-nth forms i))]
              (match (seed-transient-definition! form &scope &macros &state)
                (Result.Error error) (set! failure (Maybe.Just error))
                (Result.Success _)
                  (match (expand-node-1 form
                                        &macros
                                        &state
                                        &modules
                                        &preludes
                                        &scope)
                    (Result.Success maybe-expanded)
                      (match maybe-expanded
                        (Maybe.Just next)
                          (do
                            (set! changed true)
                            (Array.push-back! &expanded (Box.init next)))
                        (Maybe.Nothing)
                          (Array.push-back! &expanded
                                            (Box.init (SurfaceNode.copy form))))
                    (Result.Error error) (set! failure (Maybe.Just error)))))))
      (match failure
        (Maybe.Just error) (Result.Error error)
        (Maybe.Nothing)
          (if changed
            (Result.Success (Maybe.Just (SurfaceModule.init expanded)))
            (Result.Success (Maybe.Nothing))))))

  (defn delete-implementation-type-name [node]
    (match (symbol-key node)
      (Maybe.Just implementation)
        (if (String.ends-with? &implementation ".delete")
          (Maybe.Just
            (String.byte-slice &implementation
                               0
                               (Int.- (String.length &implementation) 7)))
          (Maybe.Nothing))
      (Maybe.Nothing) (Maybe.Nothing)))

  (defn register-managed-implementation! [state form]
    (match-ref (SurfaceNode.form form)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (when (Int.= (Array.length &items) 3)
            (let [head (Box.peek (Array.unsafe-nth &items 0))
                  interface (Box.peek (Array.unsafe-nth &items 1))
                  implementation (Box.peek (Array.unsafe-nth &items 2))]
              (when (and (named? head @"implements")
                         (named? interface @"delete"))
                (match (delete-implementation-type-name implementation)
                  (Maybe.Just type-name)
                    (let [span @(SurfaceNode.span form)
                          node (SurfaceNode.generated span
                                                      (SurfaceForm.BoolLit true))
                          root (CtEval.root state)
                          binding-name (String.concat
                            &[@"__managed_" (String.copy &type-name)])]
                      (ignore
                        (CtEval.define! state
                                        &root
                                        &binding-name
                                        (CtValue.Syntax (Box.init node)))))
                  (Maybe.Nothing) ())))))
      _ ()))

  (private head-name)
  (hidden head-name)
  (defn head-name [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List items)
        (if (Int.> (Array.length items) 0)
          (symbol-key (Box.peek (Array.unsafe-nth items 0)))
          (Maybe.Nothing))
      _ (Maybe.Nothing)))

  (private top-level-again?)
  (hidden top-level-again?)
  (doc top-level-again? "checks whether `expanded`, what the top-level `form`
expanded to, must be dispatched as top-level forms again: it is a `do`, or it
has a different head. This lets `(when (= (host-os) \"linux\") (add-cflag ...))`
run the command, as in the reference. Macros that expand to each other never
stop, as in the reference.")
  (defn top-level-again? [form expanded]
    (let [head (head-name expanded)]
      (match-ref &head
        (Maybe.Just name)
          (or (String.= name "do")
              (match (head-name form)
                (Maybe.Just before) (not (String.= name &before))
                (Maybe.Nothing) true))
        (Maybe.Nothing) false)))

  (private dynamic-value-call?)
  (hidden dynamic-value-call?)
  (doc dynamic-value-call? "checks whether `form` calls a `Dynamic.` function
rather than a macro. Runtime expansion evaluates such a call once and keeps its
result as a value, with `displayed-value`, as the reference prints the result of
`(Dynamic.f)` and does not run it again.")
  (defn dynamic-value-call? [form macros modules preludes scope]
    (match (head-name form)
      (Maybe.Just name)
        (and (String.starts-with? &name "Dynamic.")
             (match-ref (SurfaceNode.form form)
               (SurfaceForm.List items)
                 (match (macro-by-name macros
                                       modules
                                       preludes
                                       scope
                                       (Box.peek (Array.unsafe-nth items 0)))
                   (MacroLookup.Missing) true
                   _ false)
               _ false))
      (Maybe.Nothing) false))

  (private displayed-value)
  (hidden displayed-value)
  (doc displayed-value "returns what a submitted `(Dynamic.f)` leaves for the
runtime cell, given its result `node`. A list or symbol becomes the string the
reference REPL prints for it. A literal is kept as it is.")
  (defn displayed-value [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List _)
        (SurfaceNode.generated @(SurfaceNode.span node)
                               (SurfaceForm.StringLit (Surface.render node)))
      (SurfaceForm.Symbol _)
        (SurfaceNode.generated @(SurfaceNode.span node)
                               (SurfaceForm.StringLit (Surface.render node)))
      _ (SurfaceNode.copy node)))

  (private top-level-forms)
  (hidden top-level-forms)
  (defn top-level-forms [expanded]
    (if (match (head-name expanded)
        (Maybe.Just name) (String.= &name "do")
        (Maybe.Nothing) false)
      (match-ref (SurfaceNode.form expanded)
        (SurfaceForm.List items)
          (let-do [forms (the (Array (Box SurfaceNode)) [])]
            (for [i 1 (Array.length items)]
              (Array.push-back! &forms @(Array.unsafe-nth items i)))
            forms)
        _ [(Box.init (SurfaceNode.copy expanded))])
      [(Box.init (SurfaceNode.copy expanded))]))

  (defn expand-body [forms
                     start
                     scope
                     macros
                     state
                     modules
                     config
                     preludes
                     runtime]
    (let-do [expanded-forms (the (Array (Box SurfaceNode)) [])
             current-scope scope
             failure (the (Maybe CtError) (Maybe.Nothing))
             n (Array.length forms)]
      (for [i start n]
        (when (or (not *expand-recovering*)
                  (Array.empty? &*expand-recovery-errors*))
          (match-ref &failure
            (Maybe.Nothing)
              (let [form (Box.peek (Array.unsafe-nth forms i))]
                (cond
                  (defmacro? form)
                    (do
                      (register-source-expressions! state form &current-scope)
                      (match (parse-definition form
                                               (ExpandScope.frame &current-scope)
                                               state)
                        (Result.Success macro)
                          (do
                            ; the evaluator can then expand the macro when it
                            ; meets it inside another macro's body
                            (CtEval.register-compiled-macro! state
                                                             (ExpandScope.frame &current-scope)
                                                             (ExpandMacro.name &macro)
                                                             @(ExpandMacro.code &macro)
                                                             @(ExpandMacro.defining-frame &macro))
                            (Array.push-back! macros macro))
                        (Result.Error error) (set! failure (Maybe.Just error))))
                  (defndynamic? form)
                    (do
                      (register-source-expressions! state form &current-scope)
                      ; a dynamic function resolves bare names at the root, as
                      ; in the reference: `(defndynamic bb [] (aa))` next to
                      ; `aa` fails, and `map` inside `Dynamic.Map` is the
                      ; generic map. the module frame binds the unqualified
                      ; name and the root the qualified one.
                      (match (parse-dynamic-definition form
                                                       &(CtEval.root state)
                                                       state)
                        (Result.Success dynamic)
                          (register-dynamic! state &current-scope &dynamic)
                        (Result.Error error) (set! failure (Maybe.Just error))))
                  (defdynamic? form)
                    (do
                      (register-source-expressions! state form &current-scope)
                      (match (parse-dynamic-value form
                                                  state
                                                  (ExpandScope.frame &current-scope))
                        (Result.Success dynamic)
                          (register-dynamic! state &current-scope &dynamic)
                        (Result.Error error) (set! failure (Maybe.Just error))))
                  (defmodule? form)
                    (do
                      (register-source-expressions! state form &current-scope)
                      (match (expand-module-form form
                                                 &current-scope
                                                 macros
                                                 state
                                                 modules
                                                 config
                                                 preludes
                                                 runtime)
                        (Result.Success expanded)
                          (do
                            (record-typing-form! &expanded &current-scope)
                            (set! expanded-forms
                                  (Array.push-back expanded-forms
                                                   (Box.init expanded))))
                        (Result.Error error) (set! failure (Maybe.Just error))))
                  (deftype? form)
                    (do
                      ;; record members for `(members T)`, then pass the deftype on
                      ;; unchanged so resolution still sees it.
                      (register-source-expressions! state form &current-scope)
                      (register-deftype-members! state form &current-scope)
                      (record-typing-form! form &current-scope)
                      (set! expanded-forms
                            (Array.push-back expanded-forms
                                             (Box.init (SurfaceNode.copy form)))))
                  (load-stack-marker-head? form "Unsafe.load-stack-push!")
                    (match (load-stack-marker-file form)
                      (Maybe.Just file) (CtEval.push-load-file! &file)
                      (Maybe.Nothing) ())
                  (load-stack-marker-head? form "Unsafe.load-stack-pop!")
                    (CtEval.pop-load-file!)
                  (compile-time-command? form) (record-command-flag! form)
                  (let [imports (use-targets form)]
                    (cond
                      (Int.> (Array.length &imports) 0)
                        (do
                          (for [ii 0 (Array.length &imports)]
                            (match (module-frame modules
                                                 (Array.unsafe-nth &imports ii))
                              (Maybe.Just imported)
                                (do
                                  (ignore
                                    (CtEval.import! state
                                                    (ExpandScope.frame &current-scope)
                                                    &imported))
                                  (Array.push-back! (ExpandScope.imports &current-scope)
                                                    imported))
                              (Maybe.Nothing) ()))
                          (record-typing-form! form &current-scope)
                          (set! expanded-forms
                                (Array.push-back expanded-forms
                                                 (Box.init (SurfaceNode.copy form)))))
                      (opaque-top-level? form)
                        (do
                          (register-source-expressions! state
                                                        form
                                                        &current-scope)
                          (register-managed-implementation! state form)
                          (record-metadata! form &current-scope)
                          (record-typing-form! form &current-scope)
                          (set! expanded-forms
                                (Array.push-back expanded-forms
                                                 (Box.init (SurfaceNode.copy form)))))
                      (match (if runtime
                          (match (expand-node form
                                              macros
                                              state
                                              modules
                                              preludes
                                              &current-scope)
                            (Result.Error error) (Result.Error error)
                            (Result.Success expanded)
                              (Result.Success
                                (Maybe.Just
                                  (if (dynamic-value-call? form
                                                           macros
                                                           modules
                                                           preludes
                                                           &current-scope)
                                    (displayed-value &expanded)
                                    expanded))))
                          (expand-top-level form
                                            macros
                                            state
                                            modules
                                            preludes
                                            &current-scope))
                        (Result.Success maybe-expanded)
                          (match maybe-expanded
                            (Maybe.Just expanded)
                              (if (top-level-again? form &expanded)
                                (match (expand-body &(top-level-forms &expanded)
                                                    0
                                                    @&current-scope
                                                    macros
                                                    state
                                                    modules
                                                    config
                                                    preludes
                                                    runtime)
                                  (Result.Success more)
                                    (for [k 0 (Array.length &more)]
                                      (set! expanded-forms
                                            (Array.push-back expanded-forms
                                                             @(Array.unsafe-nth &more
                                                                                k))))
                                  (Result.Error error)
                                    (set! failure (Maybe.Just error)))
                                (set! expanded-forms
                                      (do
                                        (register-source-expressions! state
                                                                      &expanded
                                                                      &current-scope)
                                        (record-metadata! &expanded
                                                          &current-scope)
                                        (record-typing-form! &expanded
                                                             &current-scope)
                                        (Array.push-back expanded-forms
                                                         (Box.init expanded)))))
                            (Maybe.Nothing) ())
                        (Result.Error error) (set! failure (Maybe.Just error)))))))
            (Maybe.Just _) ())))
      (match failure
        (Maybe.Nothing) (Result.Success expanded-forms)
        (Maybe.Just error)
          (if *expand-recovering*
            (do
              (Array.push-back! &*expand-recovery-errors* error)
              (Result.Success expanded-forms))
            (Result.Error error)))))

  (doc prepare-module-with "expands `module` with `config` and returns the
result with its snapshot.")
  (defn prepare-module-with [module config]
    ;; one expansion is one compile-time session: the forms `type` infers
    ;; against, and the metadata `meta` reads back, belong to this run of it
    ;; and not to whichever one came before.
    (let-do [_ignored-stack (CtEval.reset-load-stack!)
             _ignored-typing (CtEval.reset-typing-forms!)
             _ignored-meta (CtEval.reset-meta!)
             state (CtEval.state)
             root (CtEval.root &state)
             scope (ExpandScope.init @"" root [])
             macros (the (Array ExpandMacro) [])
             modules [(ExpandModuleFrame.init @"" @(ExpandScope.frame &scope))]
             preludes (the (Array FrameId) [])]
      (match (expand-body (SurfaceModule.forms module)
                          0
                          (ExpandScope.copy &scope)
                          &macros
                          &state
                          &modules
                          config
                          &preludes
                          false)
        (Result.Success forms)
          (let-do [snapshot-root (CtEval.root &state)
                   snapshot-scope (ExpandScope.init @""
                                                    (FrameId.copy &snapshot-root)
                                                    (CtEnv.imports (CtState.environment &state)
                                                                   &snapshot-root))
                   ; system includes added during compile-time evaluation
                   ; become top-level forms, so resolution collects them like
                   ; written ones
                   drained (CtEval.drain-pending-includes!)
                   all-forms forms]
            (for [di 0 (Array.length &drained)]
              (set! all-forms
                    (Array.push-back all-forms
                                     (Box.init @(Array.unsafe-nth &drained di)))))
            (Result.Success
              (PreparedExpansion.init (SurfaceModule.init all-forms)
                                      (ExpandSnapshot.init snapshot-scope
                                                           macros
                                                           state
                                                           modules
                                                           (ExpandConfig.copy config)
                                                           preludes
                                                           (Array.copy &*ct-meta*)
                                                           (Array.copy &*ct-typing-forms*)))))
        (Result.Error error) (Result.Error error))))

  (doc expand-module-with "expands `module` with `config`.")
  (defn expand-module-with [module config]
    (let-do [result (match (prepare-module-with module config)
               (Result.Success prepared)
                 (Result.Success @(PreparedExpansion.module &prepared))
               (Result.Error error) (Result.Error error))]
      (match (IO.getenv "CARP_DEBUG_CT")
        (Maybe.Just _) (IO.errorln &(CtIRStore.report))
        (Maybe.Nothing) ())
      result))

  (sig prepare-module-against
       (Fn
         [(Ref SurfaceModule) (Ref ExpandSnapshot)]
         (Result PreparedExpansion CtError)))
  (defn- prepare-module-against-with-policy [module snapshot runtime]
    (let-do [_ignored-stack (CtEval.reset-load-stack!)
             _ignored-typing (set! *ct-typing-forms*
                                   (Array.copy (ExpandSnapshot.typing-forms snapshot)))
             _ignored-meta (set! *ct-meta*
                                 (Array.copy (ExpandSnapshot.meta snapshot)))
             scope (ExpandScope.copy (ExpandSnapshot.scope snapshot))
             macros (Array.copy (ExpandSnapshot.macros snapshot))
             state (CtState.copy (ExpandSnapshot.state snapshot))
             modules (Array.copy (ExpandSnapshot.modules snapshot))
             config (ExpandConfig.copy (ExpandSnapshot.config snapshot))
             preludes (Array.copy (ExpandSnapshot.preludes snapshot))]
      (match (expand-body (SurfaceModule.forms module)
                          0
                          scope
                          &macros
                          &state
                          &modules
                          &config
                          &preludes
                          runtime)
        (Result.Success forms)
          (let-do [snapshot-root (CtEval.root &state)
                   snapshot-scope (ExpandScope.init @""
                                                    (FrameId.copy &snapshot-root)
                                                    (CtEnv.imports (CtState.environment &state)
                                                                   &snapshot-root))
                   ; system includes added during compile-time evaluation
                   ; become top-level forms, so resolution collects them like
                   ; written ones
                   drained (CtEval.drain-pending-includes!)
                   all-forms forms]
            (for [di 0 (Array.length &drained)]
              (set! all-forms
                    (Array.push-back all-forms
                                     (Box.init @(Array.unsafe-nth &drained di)))))
            (Result.Success
              (PreparedExpansion.init (SurfaceModule.init all-forms)
                                      (ExpandSnapshot.init snapshot-scope
                                                           macros
                                                           state
                                                           modules
                                                           config
                                                           preludes
                                                           (Array.copy &*ct-meta*)
                                                           (Array.copy &*ct-typing-forms*)))))
        (Result.Error error) (Result.Error error))))

  (doc prepare-module-against "expands `module` against a copy of `snapshot` and
returns the result with the new snapshot. Compile-time effects also go to global
state, such as metadata, typing forms and build flags. To discard them, take a
`CtEval.checkpoint` first and restore it.")
  (defn prepare-module-against [module snapshot]
    (prepare-module-against-with-policy module snapshot false))

  (doc prepare-submission-against "expands `module` as `prepare-module-against`
does, but keeps top-level forms as runtime code. Top-level `eval`, `set!`,
`Project.config` and string commands are not run, and a top-level `if` is not
folded.")
  (defn prepare-submission-against [module snapshot]
    (prepare-module-against-with-policy module snapshot true))

  (doc expand-module-against "expands `module` against a copy of `snapshot`. It
changes global compile-time state as `prepare-module-against` does.")
  (defn expand-module-against [module snapshot]
    (match (prepare-module-against module snapshot)
      (Result.Success prepared)
        (Result.Success @(PreparedExpansion.module &prepared))
      (Result.Error error) (Result.Error error)))

  (doc expand-module "expands `module` in source order, nested modules included.
Macro and dynamic definitions are left out of the result. Top-level `eval`,
`set!`, `Project.config` and string commands with literal arguments run during
expansion, a top-level `if` with a constant condition is replaced by its branch,
and build commands are recorded instead of returned. System includes added
during expansion are appended to the result.")
  (defn expand-module [module]
    (let [config (ExpandConfig.init [])] (expand-module-with module &config))))

(defmodule MacroExpand
  (doc observe-module-against "expands `module` against `snapshot` and goes on
after an error. Nodes that fail, and nodes after the first error, become
`Invalid`, and top-level forms after it are dropped. The result is for editing
analysis, not for committing.")
  (defn observe-module-against [module snapshot]
    (let-do [saved *expand-recovering*
             saved-errors (Array.copy &*expand-recovery-errors*)
             _begin (set! *expand-recovering* true)
             _clear (set! *expand-recovery-errors* [])
             result (expand-module-against module snapshot)
             errors (Array.copy &*expand-recovery-errors*)
             _restore (set! *expand-recovering* saved)
             _errors (set! *expand-recovery-errors* saved-errors)]
      (ObservedExpansion.init result errors))))
