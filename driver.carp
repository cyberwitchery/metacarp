(load "carp-compiler.carp")
(load "driver-load.carp")

(doc print-help "prints the usage of the compiler, named `command`.")
(defn print-help [command]
  (do
    (IO.println
      &(fmt "%s — a self-hosting Carp compiler (Carp → C)" command))
    (IO.println "")
    (IO.println "usage:")
    (IO.println &(fmt "  %s [options] <source.carp>" command))
    (IO.println "")
    (IO.println "options:")
    (IO.println
      "  -b, --build           compile to an executable instead of C (needs Core)")
    (IO.println
      "  -x, --execute         compile to an executable and run it (needs Core)")
    (IO.println
      "  -c, --core <dir>      compile against the Carp standard library in <dir>")
    (IO.println "                        (default: $CARP_DIR/core)")
    (IO.println
      "  -o, --output <file>   output path — the C file, or the executable under -b")
    (IO.println
      "                        (default under -b: <output-directory>/<title>")
    (IO.println
      "                        from Project.config, out/Untitled unless set)")
    (IO.println
      "  --emit c|llvm         the backend (llvm only in metacarp); llvm without")
    (IO.println "                        -b/-x writes textual IR")
    (IO.println
      "  --optimize            build -b/-x executables with clang -O3 -D NDEBUG")
    (IO.println
      "  --log-memory          build -b/-x executables with LOG_MEMORY, so")
    (IO.println
      "                        Debug.memory-balance counts allocations")
    (IO.println
      "  -g, --debug           build -b executables with debug info and no")
    (IO.println
      "                        optimization, keeping the C beside the binary")
    (IO.println
      "  --annotate            emit the inferred types of definitions, top-level")
    (IO.println "                        expressions and locals as JSON")
    (IO.println
      "  --ownership           emit the move/borrow/delete plan as JSON")
    (IO.println
      "  --library             emit a C translation unit without main (needs Core)")
    (IO.println
      "  --no-core             skip the implicit Core load; with a Core directory,")
    (IO.println
      "                        (load \"X.carp\") directives still resolve there")
    (IO.println "  --package-override <git-reference>=<source.carp>")
    (IO.println
      "                        use a local package source for this invocation")
    (IO.println
      "                        CARP_PACKAGE_OVERRIDES supplies newline-separated defaults")
    (IO.println "  -h, --help            show this help and exit")
    (IO.println "  -v, --version         show version and exit")
    (IO.println "")
    (IO.println
      "with no -b/-x the C translation unit is written to stdout (or -o). Core is the")
    (IO.println
      "standard library the source may use (Array, String, IO, …); it also holds the")
    (IO.println
      "runtime headers clang needs. It is --core, else $CARP_DIR/core, and one of them")
    (IO.println
      "is required unless --no-core is given. diagnostics go to stderr.")))

(doc compile-standalone "compiles the file `input` to C without Core. It reports
errors and returns `Nothing` on failure.")
(defn compile-standalone [input]
  (match (IO.read-file input)
    (Result.Success source)
      (let [sources [(ModuleSource.init (String.copy input)
                                        (String.copy input)
                                        source)]]
        (match (CarpCompiler.compile-sources &sources input)
          (Result.Success c) (Maybe.Just c)
          (Result.Error error)
            (do
              (IO.errorln &(CompileError.render &error))
              (the (Maybe String) (Maybe.Nothing)))))
    (Result.Error e)
      (do
        (report-error &(fmt "cannot read '%s': %s" input &e))
        (the (Maybe String) (Maybe.Nothing)))))

(doc compile-with-core "loads `input` with the Core in `core-dir` and compiles
it to C, or to a library unit if `library` is true. It reports errors and
returns `Nothing` on failure.")
(defn compile-with-core [input core-dir no-core library]
  (match (load-with-core input core-dir no-core)
    (Maybe.Nothing) (the (Maybe String) (Maybe.Nothing))
    (Maybe.Just pair)
      (match (if library
          (CarpCompiler.compile-module-library-full (Pair.a &pair)
                                                    &(ExpandConfig.init [@"Dynamic"])
                                                    &(collect-library-roots (Pair.b &pair)))
          (CarpCompiler.compile-module-full (Pair.a &pair)
                                            &(ExpandConfig.init [@"Dynamic"])
                                            &(collect-check-names (Pair.b &pair))
                                            (source-echo-enabled? (Pair.b &pair))))
        (Result.Success c) (Maybe.Just c)
        (Result.Error error)
          (do
            (IO.errorln &(CompileError.render &error))
            (the (Maybe String) (Maybe.Nothing))))))

(doc produce-c "compiles `input` to C, with Core if `core-dir` is given and
without it otherwise. A library needs Core.")
(defn produce-c [input core-dir no-core library]
  (match-ref core-dir
    (Maybe.Just dir) (compile-with-core input dir no-core library)
    (Maybe.Nothing)
      (if library
        (do
          (report-error "--library requires --core <dir> or CARP_DIR")
          (the (Maybe String) (Maybe.Nothing)))
        (compile-standalone input))))

; --- emitting / building ---

(doc temp-c-path "returns the path of the temporary C file for this process.")
(defn temp-c-path [] (fmt "/tmp/carp-compiler-out-%d.c" (compiler-process-id)))

(doc write-temp-c "writes `c` to `path`. It reports an error and returns false
on failure.")
(defn write-temp-c [c path]
  (match (IO.write-file c path)
    (Result.Success _) true
    (Result.Error e)
      (do (report-error &(fmt "cannot write temporary C: %s" &e)) false)))

(doc debug-c-path "returns the path a debug build keeps its C at: `binary` with
`.c` appended.")
(defn debug-c-path [binary] (String.append binary ".c"))

(doc clang-build "compiles `temp-c` with clang into `binary`, with the headers
in `core-dir`, the program's C flags and `CARP_EXTRA_CFLAGS`. `optimize`,
`debug` and `log-memory` add their flags. It returns whether clang succeeded.")
(defn clang-build [core-dir binary temp-c log-memory optimize debug]
  (let [cmd (String.concat
          &[@"clang "
            (if optimize @"-O3 -D NDEBUG " @"")
            ; -g also means -O0, and comes after -O3, so it wins
            (if debug @"-g -O0 " @"")
            (if log-memory @"-D LOG_MEMORY " @"")
            ;; `-I .` lets `relative-include`/`add-c` quoted includes resolve
            ;; against the directory the compiler was invoked from.
            @"-I . -I "
            @core-dir
            ;; flags requested by the program (`add-cflag`/`add-lib`/`add-pkg`,
            ;; written or applied at compile time)
            @" "
            (String.join " " &(CtEval.collected-cflags))
            ;; flags requested by the environment, for builds the program
            ;; cannot know about: sanitizers, coverage, a different -march.
            @" "
            (match (IO.getenv "CARP_EXTRA_CFLAGS")
              (Maybe.Just extra) extra
              (Maybe.Nothing) @"")
            @" -lm -o "
            @binary
            @" "
            @temp-c])]
    (if (Int.= 0 (System.system &cmd))
      true
      (do (report-error "clang failed") false))))

(doc emit-c "writes `c` to `output`, or to standard output. It returns the exit
code.")
(defn emit-c [c output]
  (match-ref output
    (Maybe.Just path)
      (match (IO.write-file c path)
        (Result.Success _) 0
        (Result.Error e)
          (do (report-error &(fmt "cannot write '%s': %s" path &e)) 1))
    (Maybe.Nothing) (do (IO.print c) 0)))

(doc build "compiles `c` to an executable at `output`, or at the project's
binary path. A debug build keeps its C next to the executable. It returns the
exit code.")
(defn build [c core-dir output log-memory optimize debug]
  (match-ref core-dir
    (Maybe.Nothing) (do (report-error "-b requires --core <dir> or CARP_DIR") 1)
    (Maybe.Just dir)
      (let-do [binary (match-ref output
                 (Maybe.Just p) @p
                 (Maybe.Nothing) (project-binary))
               ;; a debug build keeps its C, and keeps it where the binary says
               ;; it is; every other build compiles a temporary and removes it
               temp-c (if debug (debug-c-path &binary) (temp-c-path))
               ;; the marks the backend left can only become directives once
               ;; the file they will live in is known, which is here
               emitted (if debug
                 (CarpCompiler.resolve-line-resets c &temp-c)
                 (String.copy c))
               built (and (write-temp-c &emitted &temp-c)
                          (clang-build dir
                                       &binary
                                       &temp-c
                                       log-memory
                                       optimize
                                       debug))]
        (unless debug (compiler-remove-file &temp-c))
        (if built
          (do
            (report &(String.append "wrote executable " &binary))
            (when debug (report &(String.append "kept C in " &temp-c)))
            0)
          1))))

(doc execute "compiles `c` to an executable and runs it. It returns the
program's exit code, or 1 if it could not be built.")
(defn execute [c core-dir log-memory optimize]
  (match-ref core-dir
    (Maybe.Nothing) (do (report-error "-x requires --core <dir> or CARP_DIR") 1)
    (Maybe.Just dir)
      (let-do [temp-c (temp-c-path)
               binary (project-binary)]
        (let-do [built (and (write-temp-c c &temp-c)
                            (clang-build dir
                                         &binary
                                         &temp-c
                                         log-memory
                                         optimize
                                         false))]
          (compiler-remove-file &temp-c)
          (if built
            ; WEXITSTATUS of a status from a signal is 0, so a crash would
            ; look like success. `compiler-system-exit-code` keeps signals.
            (let [status (System.system &binary)]
              (compiler-system-exit-code status))
            1)))))

(doc usage-hint "prints how to get help for `command` and exits with code 2.")
(defn usage-hint [command]
  (do (IO.errorln &(fmt "try '%s --help' for usage." command)) (System.exit 2)))

; action: 0 = emit C, 1 = build executable, 2 = build and run, 3 = annotate,
; 4 = ownership.
; --- annotation (--annotate) ---
; Emits the inferred type of every global definition as JSON, for tooling.

(doc annotate-escape "escapes `s` for a JSON string. Other control characters
become spaces.")
(defn annotate-escape [s]
  (let-do [out @""]
    (for [i 0 (String.length s)]
      (let [c (Char.to-int (String.char-at s i))]
        (set! out
              (cond
                (Int.= c 34) (String.append &out "\\\"")
                (Int.= c 92) (String.append &out "\\\\")
                (Int.= c 10) (String.append &out "\\n")
                (Int.< c 32) (String.append &out " ")
                (String.append &out &(String.from-bytes &[(Byte.from-int c)]))))))
    out))

(doc type-string "returns `type` as Carp writes it.")
(sig type-string (Fn [(Ref MonoType)] String))
(defn type-string [type] (Type.render type))

; --- local bindings ---
; a let binder's type is the type of its value. lambda parameters take their
; types from the lambda's function type. match-pattern binders are skipped.

(doc node-type-map "maps `owner/id` of every node of `annotated` to its inferred
type, with the final substitution applied. Node ids repeat across definitions,
so the owner is part of the key.")
(defn node-type-map [annotated]
  (let-do [types (InferredModule.node-types (AnnotatedModule.inferred annotated))
           n (Array.length types)
           result (the (Map String MonoType) {})]
    (for [i 0 n]
      (let [node (Array.unsafe-nth types i)
            owner-name (match-ref (InferredNodeType.owner node)
              (Maybe.Just reference) @(CoreRef.name reference)
              (Maybe.Nothing) @"")]
        (let [key (fmt "%s/%d" &owner-name @(InferredNodeType.id node))
              applied (Type.apply
                (InferredModule.substitution (AnnotatedModule.inferred annotated))
                (Box.peek (InferredNodeType.type node)))]
          (Map.put! &result &key &applied))))
    result))

(doc resolved-node-type "returns the type of node `id` in `owner` from `types`,
as a string, if it is known.")
(defn resolved-node-type [types owner id]
  (let [key (fmt "%s/%d" owner id)]
    (match (Map.get-maybe types &key)
      (Maybe.Nothing) (Maybe.Nothing)
      (Maybe.Just type) (Maybe.Just (type-string &type)))))

(sig collect-locals!
     (Fn
       [(Ref CoreExpr)
        (Ref String)
        (Ref (Map String MonoType))
        (Ref (Array String))]
       ()))
(doc collect-locals! "appends to `out` a JSON object for each let binder and
lambda parameter in `expression`, with its owner, name and type.")
(defn collect-locals! [expression owner types out]
  (match-ref expression
    (CoreExpr.Let _ binder value body)
      (do
        (match (resolved-node-type types
                                   owner
                                   (CoreIR.expression-id (Box.peek value)))
          (Maybe.Just type-name)
            (Array.push-back! out
                              (fmt
                                "{\"owner\": \"%s\", \"name\": \"%s\", \"type\": \"%s\"}"
                                &(annotate-escape owner)
                                &(annotate-escape (CoreRef.name binder))
                                &(annotate-escape &type-name)))
          (Maybe.Nothing) ())
        (collect-locals! (Box.peek value) owner types out)
        (collect-locals! (Box.peek body) owner types out))
    (CoreExpr.Lambda id parameters body)
      (do
        (match (let [key (fmt "%s/%d" owner @id)] (Map.get-maybe types &key))
          (Maybe.Just lambda-type)
            (match lambda-type
              (MonoType.Function arguments _)
                (let [n (Int.min (Array.length parameters)
                                 (Array.length &arguments))]
                  (for [i 0 n]
                    (Array.push-back! out
                                      (fmt
                                        "{\"owner\": \"%s\", \"name\": \"%s\", \"type\": \"%s\"}"
                                        &(annotate-escape owner)
                                        &(annotate-escape
                                          (CoreRef.name (Array.unsafe-nth parameters
                                                                          i)))
                                        &(annotate-escape
                                          &(type-string
                                            (Box.peek (Array.unsafe-nth &arguments
                                                                        i))))))))
              _ ())
          (Maybe.Nothing) ())
        (collect-locals! (Box.peek body) owner types out))
    (CoreExpr.Call _ callee arguments)
      (do
        (collect-locals! (Box.peek callee) owner types out)
        (for [i 0 (Array.length arguments)]
          (collect-locals!
            (Box.peek (Array.unsafe-nth arguments i))
            owner
            types
            out)))
    (CoreExpr.Do _ expressions)
      (for [i 0 (Array.length expressions)]
        (collect-locals!
          (Box.peek (Array.unsafe-nth expressions i))
          owner
          types
          out))
    (CoreExpr.If _ condition then else)
      (do
        (collect-locals! (Box.peek condition) owner types out)
        (collect-locals! (Box.peek then) owner types out)
        (collect-locals! (Box.peek else) owner types out))
    (CoreExpr.While _ condition body)
      (do
        (collect-locals! (Box.peek condition) owner types out)
        (collect-locals! (Box.peek body) owner types out))
    (CoreExpr.Set _ _ value) (collect-locals! (Box.peek value) owner types out)
    (CoreExpr.ArrayLit _ elements)
      (for [i 0 (Array.length elements)]
        (collect-locals! (Box.peek (Array.unsafe-nth elements i))
                         owner
                         types
                         out))
    (CoreExpr.StaticArrayLit _ elements)
      (for [i 0 (Array.length elements)]
        (collect-locals! (Box.peek (Array.unsafe-nth elements i))
                         owner
                         types
                         out))
    (CoreExpr.Match _ _ scrutinee branches)
      (do
        (collect-locals! (Box.peek scrutinee) owner types out)
        (for [i 0 (Array.length branches)]
          (collect-locals!
            (Box.peek (CoreMatchBranch.body (Array.unsafe-nth branches i)))
            owner
            types
            out)))
    (CoreExpr.Annotation _ inner _)
      (collect-locals! (Box.peek inner) owner types out)
    _ ()))

(doc locals-json "returns the local bindings of every function of `annotated` as
a JSON array.")
(defn locals-json [annotated]
  (let-do [types (node-type-map annotated)
           functions (CoreModule.functions (AnnotatedModule.core annotated))
           rows (the (Array String) [])
           out @"["]
    (for [i 0 (Array.length functions)]
      (let-do [function (Array.unsafe-nth functions i)
               owner @(CoreRef.name (CoreFunction.reference function))
               parameters (CoreFunction.parameters function)]
        ; function parameters from the definition's own scheme
        (let [bindings (InferredModule.environment (AnnotatedModule.inferred annotated))]
          (for [j 0 (Array.length bindings)]
            (let [binding (Array.unsafe-nth bindings j)]
              (when (Int.=
                  @(CoreRef.id (SchemeBinding.reference binding))
                  @(CoreRef.id (CoreFunction.reference function)))
                (match-ref (Box.peek
                    (TypeScheme.body (SchemeBinding.scheme binding)))
                  (MonoType.Function arguments _)
                    (let [n (Int.min (Array.length parameters)
                                     (Array.length arguments))]
                      (for [k 0 n]
                        (Array.push-back! &rows
                                          (fmt
                                            "{\"owner\": \"%s\", \"name\": \"%s\", \"type\": \"%s\"}"
                                            &(annotate-escape &owner)
                                            &(annotate-escape
                                              (CoreRef.name (Array.unsafe-nth parameters
                                                                              k)))
                                            &(annotate-escape
                                              &(type-string
                                                (Box.peek (Array.unsafe-nth arguments
                                                                            k))))))))
                  _ ())))))
        (collect-locals! (Box.peek (CoreFunction.body function))
                         &owner
                         &types
                         &rows)))
    (for [i 0 (Array.length &rows)]
      (do
        (when (Int.> i 0) (set! out (String.append &out ", ")))
        (set! out (String.append &out (Array.unsafe-nth &rows i)))))
    (String.append &out "]")))

(doc annotations-json "returns the inferred types of `annotated` as JSON: the
global definitions, the top-level expressions and the locals.")
(defn annotations-json [annotated]
  (let-do [bindings (InferredModule.environment (AnnotatedModule.inferred annotated))
           n (Array.length bindings)
           out @"{\"definitions\": ["
           first true]
    (for [i 0 n]
      (let [binding (Array.unsafe-nth bindings i)
            reference (SchemeBinding.reference binding)]
        (when-do @(CoreRef.global reference)
          (unless first (set! out (String.append &out ", ")))
          (set! first false)
          (set! out
                (String.append &out
                               &(fmt "{\"name\": \"%s\", \"type\": \"%s\"}"
                                     &(annotate-escape (CoreRef.name reference))
                                     &(annotate-escape
                                       &(type-string
                                         (Box.peek
                                           (TypeScheme.body (SchemeBinding.scheme binding)))))))))))
    (set! out (String.append &out "], \"expressions\": ["))
    (let-do [types (InferredModule.expression-types (AnnotatedModule.inferred annotated))
             m (Array.length types)]
      (for [i 0 m]
        (do
          (when (Int.> i 0) (set! out (String.append &out ", ")))
          (set! out
                (String.append &out
                               &(fmt "{\"index\": %d, \"type\": \"%s\"}"
                                     i
                                     &(annotate-escape
                                       &(type-string
                                         &(Type.apply
                                           (InferredModule.substitution (AnnotatedModule.inferred annotated))
                                           (Box.peek (Array.unsafe-nth types i)))))))))))
    (set! out (String.append &out "], \"locals\": "))
    (set! out (String.append &out &(locals-json annotated)))
    (String.append &out "}")))

; --- ownership (--ownership) ---
; Emits the move/borrow/delete plan per concrete definition as JSON.

(doc ownership-resource-json "returns the name of `resource` for the ownership
JSON.")
(defn ownership-resource-json [resource]
  (match-ref resource
    (OwnershipResource.Binding reference) @(CoreRef.name reference)
    (OwnershipResource.Temporary n) (fmt "«tmp %d»" @n)
    (OwnershipResource.Result) @"«result»"))

(doc ownership-borrow-mode-json "returns the name of `mode` for the ownership
JSON.")
(defn ownership-borrow-mode-json [mode]
  (match-ref mode
    (OwnershipBorrowMode.Shared) @"shared"
    (OwnershipBorrowMode.Unique) @"unique"))

(doc ownership-context-strings "returns the owner name and signature of context
`index` in `contexts`.")
(defn ownership-context-strings [contexts index]
  (if (or (< index 0) (>= index (Array.length contexts)))
    (Pair.init @"" @"")
    (match-ref (Array.unsafe-nth contexts index)
      (OwnershipContext.Definition reference type _ _)
        (Pair.init @(CoreRef.name reference) (type-string (Box.peek type)))
      (OwnershipContext.Roots _) (Pair.init @"«roots»" @""))))

(doc ownership-json "returns the ownership actions of `planned` as JSON.")
(defn ownership-json [planned]
  (let-do [plan (PlannedModule.plan planned)
           contexts (OwnershipPlan.contexts plan)
           actions (OwnershipPlan.actions plan)
           out @"{\"ownership\": ["
           n (Array.length actions)]
    (for [i 0 n]
      (let-do [action (Array.unsafe-nth actions i)
               row (match-ref action
                 (OwnershipAction.Move site from to type)
                   (let [names (ownership-context-strings contexts
                                                          @(OwnershipSite.context site))]
                     (fmt
                       "{\"owner\": \"%s\", \"signature\": \"%s\", \"action\": \"move\", \"binding\": \"%s\", \"target\": \"%s\", \"type\": \"%s\", \"seq\": %d}"
                       &(annotate-escape (Pair.a &names))
                       &(annotate-escape (Pair.b &names))
                       &(annotate-escape &(ownership-resource-json from))
                       &(annotate-escape &(ownership-resource-json to))
                       &(annotate-escape &(type-string (Box.peek type)))
                       i))
                 (OwnershipAction.Borrow site mode place)
                   (let [names (ownership-context-strings contexts
                                                          @(OwnershipSite.context site))]
                     (fmt
                       "{\"owner\": \"%s\", \"signature\": \"%s\", \"action\": \"borrow\", \"mode\": \"%s\", \"binding\": \"%s\", \"target\": \"\", \"type\": \"\", \"seq\": %d}"
                       &(annotate-escape (Pair.a &names))
                       &(annotate-escape (Pair.b &names))
                       &(ownership-borrow-mode-json mode)
                       &(annotate-escape
                         &(ownership-resource-json (OwnershipPlace.root place)))
                       i))
                 (OwnershipAction.Delete site resource type)
                   (let [names (ownership-context-strings contexts
                                                          @(OwnershipSite.context site))]
                     (fmt
                       "{\"owner\": \"%s\", \"signature\": \"%s\", \"action\": \"delete\", \"binding\": \"%s\", \"target\": \"\", \"type\": \"%s\", \"seq\": %d}"
                       &(annotate-escape (Pair.a &names))
                       &(annotate-escape (Pair.b &names))
                       &(annotate-escape &(ownership-resource-json resource))
                       &(annotate-escape &(type-string (Box.peek type)))
                       i)))]
        (when (> i 0) (set! out (String.append &out ", ")))
        (set! out (String.append &out &row))))
    (String.append &out "]}")))

(doc ownership-with-core "loads `input` with Core, plans its ownership and
prints the plan as JSON. It returns the exit code.")
(defn ownership-with-core [input core-dir no-core]
  (match (load-with-core input core-dir no-core)
    (Maybe.Nothing) 1
    (Maybe.Just pair)
      (match (CarpCompiler.plan-module-checked (Pair.a &pair)
                                               &(ExpandConfig.init [@"Dynamic"])
                                               &(collect-check-names (Pair.b &pair)))
        (Result.Error error) (do (IO.errorln &(CompileError.render &error)) 1)
        (Result.Success planned) (do (IO.println &(ownership-json &planned)) 0))))

(doc annotate-with-core "loads `input` with Core, infers it and prints the types
as JSON. It returns the exit code.")
(defn annotate-with-core [input core-dir no-core]
  (match (load-with-core input core-dir no-core)
    (Maybe.Nothing) 1
    (Maybe.Just pair)
      (match (CarpCompiler.infer-module-with (Pair.a &pair)
                                             &(ExpandConfig.init [@"Dynamic"]))
        (Result.Error error) (do (IO.errorln &(CompileError.render &error)) 1)
        (Result.Success annotated)
          (do (IO.println &(annotations-json &annotated)) 0))))

(doc annotate-input "prints the inferred types of `input` as JSON. It needs a
Core directory.")
(defn annotate-input [input core-dir no-core]
  (match-ref core-dir
    (Maybe.Just dir) (annotate-with-core input dir no-core)
    (Maybe.Nothing)
      (do (report-error "--annotate requires --core <dir> or CARP_DIR") 1)))

(doc ownership-input "prints the ownership plan of `input` as JSON. It needs a
Core directory.")
(defn ownership-input [input core-dir no-core]
  (match-ref core-dir
    (Maybe.Just dir) (ownership-with-core input dir no-core)
    (Maybe.Nothing)
      (do (report-error "--ownership requires --core <dir> or CARP_DIR") 1)))

(doc run "loads the package overrides from the environment and runs `action` on
`input`. It returns the exit code.")
(defn run [input
           core-dir
           output
           action
           log-memory
           optimize
           no-core
           debug
           library]
  (match (load-env-package-overrides!)
    (Result.Error error)
      (do (report-error &(String.append "package overrides: " &error)) 1)
    (Result.Success _)
      (cond
        (Int.= action 3) (annotate-input input core-dir no-core)
        (Int.= action 4) (ownership-input input core-dir no-core)
        (run-produce input
                     core-dir
                     output
                     action
                     log-memory
                     optimize
                     no-core
                     debug
                     library))))

(doc run-produce "compiles `input` to C, then emits, builds or runs it,
depending on `action`. It returns the exit code.")
(defn run-produce [input
                   core-dir
                   output
                   action
                   log-memory
                   optimize
                   no-core
                   debug
                   library]
  (do
    ;; a debug build asks the compiler to remember where its C came from, so the
    ;; C can point back at the Carp each line was written as
    (set! *want-source-map* debug)
    (match (produce-c input core-dir no-core library)
      (Maybe.Nothing) 1
      (Maybe.Just c)
        (cond
          (Int.= action 1) (build &c core-dir output log-memory optimize debug)
          (Int.= action 2) (execute &c core-dir log-memory optimize)
          (emit-c &c output)))))

(doc compiler-main "parses the command-line arguments from index `first` and
runs the compiler. `command` is the name shown in help and errors. `run-llvm`
handles `--emit llvm`.")
(defn compiler-main [first command run-llvm]
  (let-do [_command (set! *command* @command)
           args &System.args
           n (StaticArray.length args)
           input (the (Maybe String) (Maybe.Nothing))
           output (the (Maybe String) (Maybe.Nothing))
           core-dir (the (Maybe String) (Maybe.Nothing))
           have-input false
           log-memory false
           optimize false
           debug false
           no-core false
           library false
           llvm false
           action 0
           ; 0 = compile, 1 = help, 2 = version, 3 = argument error
           mode 0
           i first]
    (while-do (and (Int.< i n) (Int.= mode 0))
      (let-do [arg @(StaticArray.unsafe-nth args i)]
        (cond
          (or (String.= &arg "-h") (String.= &arg "--help")) (set! mode 1)
          (or (String.= &arg "-v") (String.= &arg "--version")) (set! mode 2)
          (or (String.= &arg "-b") (String.= &arg "--build")) (set! action 1)
          (or (String.= &arg "-x") (String.= &arg "--execute")) (set! action 2)
          (String.= &arg "--annotate") (set! action 3)
          (String.= &arg "--ownership") (set! action 4)
          (String.= &arg "--library") (set! library true)
          (String.= &arg "--log-memory") (set! log-memory true)
          (String.= &arg "--optimize") (set! optimize true)
          (or (String.= &arg "-g") (String.= &arg "--debug")) (set! debug true)
          (String.= &arg "--no-core") (set! no-core true)
          (or (String.= &arg "-o") (String.= &arg "--output"))
            (if (Int.< (Int.inc i) n)
              (do
                (set! output
                      (Maybe.Just @(StaticArray.unsafe-nth args (Int.inc i))))
                (set! i (Int.inc i)))
              (do
                (report-error "option '-o' requires a file argument")
                (set! mode 3)))
          (or (String.= &arg "-c") (String.= &arg "--core"))
            (if (Int.< (Int.inc i) n)
              (do
                (set! core-dir
                      (Maybe.Just @(StaticArray.unsafe-nth args (Int.inc i))))
                (set! i (Int.inc i)))
              (do
                (report-error "option '-c' requires a directory argument")
                (set! mode 3)))
          (String.= &arg "--emit")
            (if (Int.< (Int.inc i) n)
              (let-do [backend (StaticArray.unsafe-nth args (Int.inc i))]
                (cond
                  (String.= backend "c") (set! llvm false)
                  (String.= backend "llvm") (set! llvm true)
                  (do (report-error "--emit takes c or llvm") (set! mode 3)))
                (set! i (Int.inc i)))
              (do (report-error "--emit takes c or llvm") (set! mode 3)))
          (String.= &arg "--package-override")
            (if (Int.< (Int.inc i) n)
              (do
                (match (add-package-override!
                    (StaticArray.unsafe-nth args (Int.inc i)))
                  (Result.Success _) ()
                  (Result.Error error) (do (IO.errorln &error) (set! mode 3)))
                (set! i (Int.inc i)))
              (do
                (report-error
                  "--package-override requires <git-reference>=<source.carp>")
                (set! mode 3)))
          (String.starts-with? &arg "-")
            (do (report-error &(fmt "unknown option '%s'" &arg)) (set! mode 3))
          have-input
            (do (report-error "more than one input file given") (set! mode 3))
          (do (set! input (Maybe.Just @&arg)) (set! have-input true))))
      (set! i (Int.inc i)))
    (when-do (and library (Int./= action 0) (Int.= mode 0))
      (report-error
        "--library emits C, so it cannot be combined with -b, -x, --annotate or --ownership")
      (set! mode 3))
    (when-do (and llvm (or library optimize (Int.> action 2)) (Int.= mode 0))
      (report-error
        "--emit llvm cannot be combined with --library, --optimize, --annotate or --ownership")
      (set! mode 3))
    (cond
      (Int.= mode 1) (print-help command)
      (Int.= mode 2) (IO.println &(fmt "%s %s" command version))
      (Int.= mode 3) (usage-hint command)
      (match input
        (Maybe.Just path)
          (System.exit
            (if llvm
              (run-llvm &path &core-dir &output action no-core log-memory debug)
              (match (effective-core-dir &core-dir)
                (Maybe.Nothing)
                  (if no-core
                    (run &path
                         &core-dir
                         &output
                         action
                         log-memory
                         optimize
                         no-core
                         debug
                         library)
                    ;; like the reference: without a Core to load the program
                    ;; would fail on its first use of the standard library
                    (do
                      (report-error
                        "no Core to load: pass --core <dir> or set CARP_DIR (or compile without it with --no-core)")
                      1))
                (Maybe.Just dir)
                  (run &path
                       &(Maybe.Just dir)
                       &output
                       action
                       log-memory
                       optimize
                       no-core
                       debug
                       library))))
        (Maybe.Nothing) (do (report-error "no input file") (usage-hint command))))))
