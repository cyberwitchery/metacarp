(deftype IntGraph [edges (Array (Array Int))])

(defmodule IntGraph
  (doc node-count "returns the number of nodes in a graph.")
  (defn node-count [graph] (Array.length (IntGraph.edges graph)))

  (private visit-order!)
  (hidden visit-order!)
  (defn visit-order! [edges node visited order]
    (unless-do @(Array.unsafe-nth visited node)
      (Array.aset! visited node true)
      (let [neighbors (Array.unsafe-nth edges node)
            n (Array.length neighbors)]
        (for [i 0 n]
          (visit-order! edges @(Array.unsafe-nth neighbors i) visited order)))
      (Array.push-back! order node)))

  (private collect-component!)
  (hidden collect-component!)
  (defn collect-component! [edges node visited component]
    (unless-do @(Array.unsafe-nth visited node)
      (Array.aset! visited node true)
      (Array.push-back! component node)
      (let [neighbors (Array.unsafe-nth edges node)
            n (Array.length neighbors)]
        (for [i 0 n]
          (collect-component! edges
                              @(Array.unsafe-nth neighbors i)
                              visited
                              component)))))

  (private transpose)
  (hidden transpose)
  (defn transpose [edges]
    (let-do [n (Array.length edges)
             empty (the (Array Int) [])
             result (Array.replicate n &empty)]
      (for [source 0 n]
        (let [neighbors (Array.unsafe-nth edges source)
              m (Array.length neighbors)]
          (for [i 0 m]
            (let [destination @(Array.unsafe-nth neighbors i)]
              (Array.push-back! (Array.unsafe-nth &result destination) source)))))
      result))

  (doc strong-components "returns strongly connected components in dependency
order when an edge points from a node to one of its dependencies.")
  (defn strong-components [graph]
    (let-do [edges (IntGraph.edges graph)
             n (Array.length edges)
             reversed (transpose edges)
             false-value false
             visited (Array.replicate n &false-value)
             order (the (Array Int) [])
             components (the (Array (Array Int)) [])]
      (for [node 0 n] (visit-order! &reversed node &visited &order))
      (set! visited (Array.replicate n &false-value))
      (for [offset 0 n]
        (let [node @(Array.unsafe-nth &order (Int.- (Int.dec n) offset))]
          (unless @(Array.unsafe-nth &visited node)
            (let-do [component (the (Array Int) [])]
              (collect-component! edges node &visited &component)
              (set! components (Array.push-back components component))))))
      components)))
