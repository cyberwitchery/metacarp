(load "../positions.carp")
(Project.no-echo)
(load "Test.carp")
(use-all Test)

(defn group-is? [buckets key expected]
  (let-do [range (PositionBuckets.range buckets &key)
           items (PositionBuckets.items buckets)
           actual (the (Array Int) [])]
    (for [i @(Pair.a &range) @(Pair.b &range)]
      (Array.push-back! &actual @(Array.unsafe-nth items i)))
    (Array.= &actual expected)))

(deftest t
  (assert-true t
    (let [groups (PositionBuckets.from-keys &[4 0 4 2147483600 -7 0])]
      (and (group-is? &groups 4 &[0 2])
           (and (group-is? &groups 0 &[1 5])
                (and (group-is? &groups 2147483600 &[3])
                     (group-is? &groups -7 &[4])))))
    "integer groups preserve position order for duplicate, sparse and negative keys")
  (assert-true t
    (let [groups (PositionBuckets.from-keys &[4 0 4])]
      (and (group-is? &groups 9 &[]) (group-is? &groups -1 &[])))
    "absent position keys have an empty range")
  (assert-true t
    (let [groups (PositionBuckets.from-keys &[])]
      (and
        (Array.empty? (PositionBuckets.items &groups))
        (group-is? &groups 0 &[])))
    "empty position input has no groups or items"))
