(load "../carp-graph.carp")
(Project.no-echo)
(load "Test.carp")

(use-all Test)

(defn dependency-order? []
  (let [graph (IntGraph.init [[1] [2] []])
        components (IntGraph.strong-components &graph)]
    (and (Int.= 3 (Array.length &components))
         (and
           (Int.= 2 @(Array.unsafe-nth (Array.unsafe-nth &components 0) 0))
           (and
             (Int.= 1 @(Array.unsafe-nth (Array.unsafe-nth &components 1) 0))
             (Int.= 0 @(Array.unsafe-nth (Array.unsafe-nth &components 2) 0)))))))

(defn cycle-component? []
  (let [graph (IntGraph.init [[1] [0 2] []])
        components (IntGraph.strong-components &graph)]
    (and (Int.= 2 (Array.length &components))
         (and
           (Int.= 1 (Array.length (Array.unsafe-nth &components 0)))
           (Int.= 2 (Array.length (Array.unsafe-nth &components 1)))))))

(deftest t
  (assert-true t
    (dependency-order?)
    "SCCs are ordered from dependencies to consumers")
  (assert-true t
    (cycle-component?)
    "mutually recursive nodes share one component"))
