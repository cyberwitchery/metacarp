(doc PositionBuckets "stable integer-keyed groups of positions, stored as
a sparse key-to-slot map and flat starts/items arrays.")
(deftype PositionBuckets
  [slot-of (Map Int Int)
   starts (Array Int)
   items (Array Int)])

(defmodule PositionBuckets
  (doc from-keys "groups input positions in linear time. Keys may be sparse or
negative; positions retain their original order within each group.")
  (defn from-keys [keys]
    (let-do [n (Array.length keys)
             slot-of (the (Map Int Int) (Map.create))
             slots (Array.allocate n)
             counts (the (Array Int) [])]
      (for [i 0 n]
        (let [key (Array.unsafe-nth keys i)]
          (match (Map.get-maybe &slot-of key)
            (Maybe.Just slot)
              (do
                (Array.aset-uninitialized! &slots i slot)
                (Array.aset! &counts
                             slot
                             (Int.inc @(Array.unsafe-nth &counts slot))))
            (Maybe.Nothing)
              (let-do [slot (Array.length &counts)]
                (ignore (Map.put! &slot-of key &slot))
                (Array.push-back! &counts 1)
                (Array.aset-uninitialized! &slots i slot)))))
      (let-do [slot-count (Array.length &counts)
               starts (Array.replicate (Int.inc slot-count) &0)
               running 0]
        (for [k 0 slot-count]
          (do
            (Array.aset! &starts k running)
            (set! running (Int.+ running @(Array.unsafe-nth &counts k)))))
        (Array.aset! &starts slot-count running)
        (let-do [items (Array.replicate running &0)
                 cursor @&starts]
          (for [i 0 n]
            (let-do [slot @(Array.unsafe-nth &slots i)
                     at @(Array.unsafe-nth &cursor slot)]
              (Array.aset! &items at i)
              (Array.aset! &cursor slot (Int.inc at))))
          (PositionBuckets.init slot-of starts items)))))

  (doc range
    "returns the half-open range in items for a key, or an empty range.")
  (defn range [buckets key]
    (match (Map.get-maybe (PositionBuckets.slot-of buckets) key)
      (Maybe.Just slot)
        (let [starts (PositionBuckets.starts buckets)]
          (Pair.init @(Array.unsafe-nth starts slot)
                     @(Array.unsafe-nth starts (Int.inc slot))))
      (Maybe.Nothing) (Pair.init 0 0))))
