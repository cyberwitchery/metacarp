(load "../carp-views.carp")
(load "Test.carp")
(use-all Test)

(deftype Point [x Int
                y Int])
(defview point-coordinates
         [p Point]
         (=> (View.text)
             (View.title @"Coordinates")
             (View.content (fmt "point(%d, %d)" @(Point.x p) @(Point.y p)))))

(def *copies* 0)
(def *rows* (the (Array Int) []))
(deftype Tracked [value Int])
(defmodule Tracked
  (defn copy [value]
    (do (set! *copies* (Int.inc *copies*)) (Tracked.init @(Tracked.value value))))
  (implements copy Tracked.copy)
  (sig summary (Fn [(Ref Tracked) (Ref ViewRequest)] String))
  (defn summary [value request]
    (do (ignore request) (str @(Tracked.value value))))
  (implements view-summary Tracked.summary))

(defview requested-rows
         [xs (Array Tracked)]
         (=> (View.columned)
             (View.title @"Rows")
             (View.with-columns
               [(View.value-column @"Value"
                                   (fn [source i request]
                                     (do
                                       (ignore request)
                                       (Array.push-back! &*rows* i)
                                       (str
                                         @(Tracked.value (Array.unsafe-nth source
                                                                           i))))))])
             (View.value-items (fn [source] (Array.length source)))
             (View.value-send
               (fn [source i owner]
                 (View.unsafe-borrow-register (Array.unsafe-nth source i) owner)))))

(defview no-point [p Point] (do (ignore p) (View.empty)))

(defn view-tests [initial]
  (let-do [test @initial
           point (Point.init 3 7)
           point-views (views &point)
           source [(Tracked.init 10) (Tracked.init 20) (Tracked.init 30)]
           rows (views &source)
           s @"αβγδε"
           n 0l]
    (set! test
          (assert-equal &test
            "abc"
            &(view-summary "abc" &(View.defaults))
            "String summaries use the bounded View.slice implementation"))
    (set! test
          (assert-equal &test
            "point(3, 7)"
            &(View.render &point &point-views &(View.defaults))
            "custom text view"))
    (set! test
          (assert-equal &test
            -1
            (View.view-index &point-views "no-point")
            "inapplicable view is absent"))
    (set! test
          (assert-true &test
            (String.starts-with? &(View.describe &point-views)
                                 "point-coordinates : Coordinates")
            "view metadata"))
    (set! test (assert-equal &test "βγ" &(View.slice &s 1 4) "UTF-8 window"))
    (set! test (assert-equal &test "" &(View.slice &s 0 1) "UTF-8 clipping"))
    (set! test
          (assert-equal &test
            "20"
            &(View.render &source
                          &rows
                          &(View.request @"requested-rows" 1 1 2 50))
            "bounded page"))
    (set! test (assert-equal &test &[1] &*rows* "only requested row evaluated"))
    (set! test
          (assert-equal &test
            0
            *copies*
            "view declarations do not copy source elements"))
    (let-do [id (view-register source)
             object-views (ViewObject.views (Array.unsafe-nth &*view-objects* id))]
      (set! test (assert-equal &test 0 *copies* "registration moves its source"))
      (set! test
            (assert-equal &test
              "30"
              &(View.render &n
                            object-views
                            &(View.request @"requested-rows" 2 1 2 50))
              "registered owner stays live"))
      (let-do [child (View.send-item id "requested-rows" 1)]
        (set! test (assert-equal &test 0 *copies* "selection borrows its child"))
        (View.drop-ref! id)
        (set! test
              (assert-true &test
                (View.valid-id? id)
                "child keeps parent storage alive"))
        (set! test
              (assert-equal &test
                "20"
                &(~(ViewObject.print (Array.unsafe-nth &*view-objects* child)))
                "child can read its storage after the parent client releases it"))
        (View.drop-ref! child)
        (set! test
              (assert-false &test
                (View.valid-id? id)
                "last child releases parent"))
        (View.drop-ref! id)
        (set! test
              (assert-false &test
                (View.valid-id? id)
                "double release is harmless"))))
    (View.clear!)
    test))

(deftest test (view-tests test))
