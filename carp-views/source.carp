(doc carp-view-source "expands to the text of carp-views.carp, read when the
macro is expanded.")
(defmacro carp-view-source []
  (list 'copy (read-file (relative-to (current-file) "carp-views.carp"))))

(defmodule CarpViews
  (doc source "returns the source text of the view runtime.")
  (defn source [] (carp-view-source)))
