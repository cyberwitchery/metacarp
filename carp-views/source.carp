; Embed the same source in terminal and notebook hosts. A deployed host does
; not need a second runtime file at an implicit filesystem location.
(defmacro carp-view-source []
  (list 'copy (read-file (relative-to (current-file) "carp-views.carp"))))

(defmodule CarpViews
  (doc source "the shared view runtime as a self-contained source module.")
  (defn source [] (carp-view-source)))
