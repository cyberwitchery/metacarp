(load "../carp-graph/positions.carp")
(load "../carp-types/pattern-typing.carp")
(load "../carp-ir/carp-ir.carp")
(load "../carp-infer/carp-infer.carp")
(load "../carp-types/carp-types.carp")
(load "../carp-primitives/carp-primitives.carp")
(load "../carp-c-abi/carp-c-abi.carp")

(deftype Specialization
  [reference CoreRef
   signature (Box MonoType)
   symbol String])

(deftype SpecializedCall
  [id Int
   reference CoreRef
   signature (Box MonoType)
   symbol String
   value Bool
   external Bool])

(deftype SpecializedMatchBranch
  [pattern CorePattern
   bindings (Array CoreRef)
   body (Box SpecializedExpr)])

(deftype SpecializedExpr
  (IntLit [Int (Box MonoType) Int])
  (ByteLit [Int (Box MonoType) Byte])
  (LongLit [Int (Box MonoType) Long])
  (FloatLit [Int (Box MonoType) Float])
  (DoubleLit [Int (Box MonoType) Double])
  (CharLit [Int (Box MonoType) Char])
  (StringLit [Int (Box MonoType) String])
  (PatternLit [Int (Box MonoType) String])
  (BoolLit [Int (Box MonoType) Bool])
  (UnitLit [Int (Box MonoType)])
  (ArrayLit [Int (Box MonoType) (Array (Box SpecializedExpr))])
  (StaticArrayLit [Int (Box MonoType) (Array (Box SpecializedExpr))])
  (Reference [Int (Box MonoType) CoreRef])
  (GlobalValue [Int (Box MonoType) CoreRef (Box MonoType) String Bool])
  (Call [Int (Box MonoType) (Box SpecializedExpr) (Array (Box SpecializedExpr))])
  (GlobalCall
    [Int
     (Box MonoType)
     CoreRef
     (Box MonoType)
     String
     (Array (Box SpecializedExpr))])
  (Do [Int (Box MonoType) (Array (Box SpecializedExpr))])
  (If
    [Int
     (Box MonoType)
     (Box SpecializedExpr)
     (Box SpecializedExpr)
     (Box SpecializedExpr)])
  (Let [Int (Box MonoType) CoreRef (Box SpecializedExpr) (Box SpecializedExpr)])
  (Set [Int (Box MonoType) CoreRef (Box SpecializedExpr)])
  (While [Int (Box MonoType) (Box SpecializedExpr) (Box SpecializedExpr)])
  (Break [Int (Box MonoType)])
  (Lambda [Int (Box MonoType) (Array CoreRef) (Box SpecializedExpr)])
  (Match
    [Int
     (Box MonoType)
     Bool
     (Box SpecializedExpr)
     (Array SpecializedMatchBranch)])
  (Annotation [Int (Box MonoType) (Box SpecializedExpr) (Box CoreType)]))

(deftype SpecializedBody
  [specialization Specialization
   parameters (Array CoreRef)
   body (Box SpecializedExpr)
   value Bool])

(deftype SpecializedBuiltinSource
  [signature (Box CoreType)
   payload CoreBuiltinPayload])

(deftype SpecializedPrimitive
  [specialization Specialization
   lowering PrimitiveLowering
   dependencies (Array SpecializedCall)
   source (Maybe SpecializedBuiltinSource)])

(deftype SpecializationModule
  [instances (Array Specialization)
   bodies (Array SpecializedBody)
   primitives (Array SpecializedPrimitive)
   roots (Array (Box SpecializedExpr))
   constructors (Array CoreConstructorDeclaration)
   system-includes (Array String)
   type-declarations (Array CoreTypeDeclaration)])

(doc IncrementalSpecialization "contains the materialized delta for one cell
and the complete concrete instance cache after satisfying that cell's roots.")
(deftype IncrementalSpecialization
  [module SpecializationModule
   instances (Array Specialization)])

(deftype SpecializeError [message String])

(deftype SpecializationRequest [call CallSite
                                origin String])

(doc SpecializationDemands "owns deduplicated copier and deleter requests across
closure rounds. Each stream retains its first ABI-key representative and order.")
(deftype SpecializationDemands
  [delete-keys (Set String)
   copy-keys (Set String)
   deletes (Array SpecializationRequest)
   copies (Array SpecializationRequest)])

; Legacy naming defaults are snapshotted at invocation creation. They are
; policy inputs; none of the specialization caches lives in process globals.
(def *specialization-symbol-salt* (String.copy ""))
(def *specialization-symbol-references* (the (Array CoreRef) []))
(def *specialization-binding-versions* (the (Array (Pair String String)) []))

(doc SpecializeContext
  "the indexes and native naming policy for one fixed Core/inference input. Reuse it only with that input, including repeated ownership-closure rounds.")
(deftype SpecializeContext
  [scheme-id-index (Array Int)
   owner-buckets PositionBuckets
   call-buckets PositionBuckets
   implementation-buckets PositionBuckets
   symbol-salt String
   symbol-references (Array CoreRef)
   binding-versions (Array (Pair String String))])

; Reusable indexes and temporary work are passed separately as references.
; A work record never escapes an entry function; all returned IR is owned.
(deftype SpecializeWork
  [module-solver TypeSolver
   instance-buckets (Array (Array Int))
   normalized-node-types (Array (Maybe (Box MonoType)))
   trace-positions (Array Int)
   trace-owner-key Int
   implementations (Map String
                        (Result (Pair CoreRef (Box MonoType)) SpecializeError))])

(defmodule Specialize
  (private work-for)
  (hidden work-for)
  (defn work-for [inferred]
    (SpecializeWork.init
      (Type.solver-from-substitution (InferredModule.substitution inferred))
      []
      []
      []
      -1000000002
      (Map.create)))

  (doc expression-id "returns the stable, owner-scoped ID retained on a
specialized expression.")
  (defn expression-id [expression]
    (match-ref expression
      (SpecializedExpr.IntLit id _ _) @id
      (SpecializedExpr.ByteLit id _ _) @id
      (SpecializedExpr.LongLit id _ _) @id
      (SpecializedExpr.FloatLit id _ _) @id
      (SpecializedExpr.DoubleLit id _ _) @id
      (SpecializedExpr.CharLit id _ _) @id
      (SpecializedExpr.StringLit id _ _) @id
      (SpecializedExpr.PatternLit id _ _) @id
      (SpecializedExpr.BoolLit id _ _) @id
      (SpecializedExpr.UnitLit id _) @id
      (SpecializedExpr.ArrayLit id _ _) @id
      (SpecializedExpr.StaticArrayLit id _ _) @id
      (SpecializedExpr.Reference id _ _) @id
      (SpecializedExpr.GlobalValue id _ _ _ _ _) @id
      (SpecializedExpr.Call id _ _ _) @id
      (SpecializedExpr.GlobalCall id _ _ _ _ _) @id
      (SpecializedExpr.Do id _ _) @id
      (SpecializedExpr.If id _ _ _ _) @id
      (SpecializedExpr.Let id _ _ _ _) @id
      (SpecializedExpr.Set id _ _ _) @id
      (SpecializedExpr.While id _ _ _) @id
      (SpecializedExpr.Break id _) @id
      (SpecializedExpr.Lambda id _ _ _) @id
      (SpecializedExpr.Match id _ _ _ _) @id
      (SpecializedExpr.Annotation id _ _ _) @id))

  (doc expression-type "returns the concrete type retained on a specialized
expression.")
  (defn expression-type [expression]
    (match-ref expression
      (SpecializedExpr.IntLit _ type _) (MonoType.copy (Box.peek type))
      (SpecializedExpr.ByteLit _ type _) (MonoType.copy (Box.peek type))
      (SpecializedExpr.LongLit _ type _) (MonoType.copy (Box.peek type))
      (SpecializedExpr.FloatLit _ type _) (MonoType.copy (Box.peek type))
      (SpecializedExpr.DoubleLit _ type _) (MonoType.copy (Box.peek type))
      (SpecializedExpr.CharLit _ type _) (MonoType.copy (Box.peek type))
      (SpecializedExpr.StringLit _ type _) (MonoType.copy (Box.peek type))
      (SpecializedExpr.PatternLit _ type _) (MonoType.copy (Box.peek type))
      (SpecializedExpr.BoolLit _ type _) (MonoType.copy (Box.peek type))
      (SpecializedExpr.UnitLit _ type) (MonoType.copy (Box.peek type))
      (SpecializedExpr.ArrayLit _ type _) (MonoType.copy (Box.peek type))
      (SpecializedExpr.StaticArrayLit _ type _) (MonoType.copy (Box.peek type))
      (SpecializedExpr.Reference _ type _) (MonoType.copy (Box.peek type))
      (SpecializedExpr.GlobalValue _ type _ _ _ _)
        (MonoType.copy (Box.peek type))
      (SpecializedExpr.Call _ type _ _) (MonoType.copy (Box.peek type))
      (SpecializedExpr.GlobalCall _ type _ _ _ _)
        (MonoType.copy (Box.peek type))
      (SpecializedExpr.Do _ type _) (MonoType.copy (Box.peek type))
      (SpecializedExpr.If _ type _ _ _) (MonoType.copy (Box.peek type))
      (SpecializedExpr.Let _ type _ _ _) (MonoType.copy (Box.peek type))
      (SpecializedExpr.Set _ type _ _) (MonoType.copy (Box.peek type))
      (SpecializedExpr.While _ type _ _) (MonoType.copy (Box.peek type))
      (SpecializedExpr.Break _ type) (MonoType.copy (Box.peek type))
      (SpecializedExpr.Lambda _ type _ _) (MonoType.copy (Box.peek type))
      (SpecializedExpr.Match _ type _ _ _) (MonoType.copy (Box.peek type))
      (SpecializedExpr.Annotation _ type _ _) (MonoType.copy (Box.peek type))))

  (doc unbound-slot-types
    "compatibility facade for PatternTyping.unbound-slot-types.")
  (defn unbound-slot-types [pattern type constructors]
    (PatternTyping.unbound-slot-types pattern type constructors))

  (doc bound-slot-types
    "compatibility facade for PatternTyping.bound-slot-types.")
  (defn bound-slot-types [pattern type constructors]
    (PatternTyping.bound-slot-types pattern type constructors))

  (doc bind-unbound-slots
    "compatibility facade for PatternTyping.bind-unbound-slots.")

  (defn bind-unbound-slots [pattern refs mask cursor]
    (PatternTyping.bind-unbound-slots pattern refs mask cursor))

  (private has-definition?)
  (hidden has-definition?)
  (private collect-global-values!)
  (hidden collect-global-values!)
  (private collect-global-values-from-expressions!)
  (hidden collect-global-values-from-expressions!)
  (private collect-global-values-from-branches!)
  (hidden collect-global-values-from-branches!)
  (private global-values-in)
  (hidden global-values-in)
  (private expression-type-for)
  (hidden expression-type-for)
  (private same-owner?)
  (hidden same-owner?)
  (private function-for)
  (hidden function-for)
  (private value-for)
  (hidden value-for)
  (defn has-definition? [functions reference]
    (let-do [found false
             n (Array.length functions)]
      (for [i 0 n]
        (let [function (Array.unsafe-nth functions i)]
          (when (CoreIR.same-ref? (CoreFunction.reference function) reference)
            (set! found true))))
      found))

  (private reference-positions)
  (hidden reference-positions)
  (doc reference-positions "maps each reference's id to its last position in
`references`, the one a scan would find last.")
  (defn reference-positions [references]
    (let-do [positions (the (Map Int Int) (Map.create))]
      (for [i 0 (Array.length references)]
        (Map.put! &positions (CoreRef.id (Array.unsafe-nth references i)) &i))
      positions))

  (private indexed-has?)
  (hidden indexed-has?)
  (doc indexed-has? "whether `references` holds `reference`, answered through
`positions` (see `reference-positions`). References with different ids are
never the same, so a missing id answers no; a hit that is not the same
reference falls back to the scan.")
  (defn indexed-has? [positions references reference]
    (match (Map.get-maybe positions (CoreRef.id reference))
      (Maybe.Just at)
        (or
          (CoreIR.same-ref? (Array.unsafe-nth references at) reference)
          (let-do [found false]
            (for [i 0 (Array.length references)]
              (when (CoreIR.same-ref? (Array.unsafe-nth references i) reference)
                (set! found true)))
            found))
      (Maybe.Nothing) false))

  (private has-value?)
  (hidden has-value?)
  (defn has-value? [values reference]
    (let-do [found false
             n (Array.length values)]
      (for [i 0 n]
        (let [value (Array.unsafe-nth values i)]
          (when (CoreIR.same-ref? (CoreValue.reference value) reference)
            (set! found true))))
      found))

  (private has-builtin?)
  (hidden has-builtin?)
  (defn has-builtin? [builtins reference]
    (let-do [found false
             n (Array.length builtins)]
      (for [i 0 n]
        (let [builtin (Array.unsafe-nth builtins i)]
          (when (CoreIR.same-ref? (CoreBuiltin.reference builtin) reference)
            (set! found true))))
      found))

  (private interface?)
  (hidden interface?)
  (defn interface? [interfaces reference]
    (let-do [found false
             n (Array.length interfaces)]
      (for [i 0 n]
        (let [interface (Array.unsafe-nth interfaces i)]
          (when (CoreIR.same-ref? (CoreInterface.reference interface) reference)
            (set! found true))))
      found))

  (private contains-instance?)
  (hidden contains-instance?)
  (private concrete-signature?)
  (hidden concrete-signature?)
  (defn concrete-signature? [signature] (Type.concrete? signature))

  (private buckets-reset!)
  (hidden buckets-reset!)
  (defn buckets-reset! [state max-id]
    (SpecializeWork.set-instance-buckets! state
                                          (Array.replicate (Int.inc (Int.max 0
                                                                             max-id))
                                                           &(the (Array Int) []))))

  (private buckets-note!)
  (hidden buckets-note!)
  (defn buckets-note! [state reference position]
    (let-do [id @(CoreRef.id reference)]
      (when-do (Int.>= id 0)
        (while-do (Int.<=
            (Array.length (SpecializeWork.instance-buckets state))
            id)
          (Array.push-back! (SpecializeWork.instance-buckets state)
                            (the (Array Int) [])))
        (Array.push-back!
          (Array.unsafe-nth (SpecializeWork.instance-buckets state) id)
          position))))

  (private bucket-instance-at)
  (hidden bucket-instance-at)
  ;; position of the instance matching (reference, signature) inside the
  ;; reference's bucket, or -1. Only valid when the buckets are primed.
  (defn bucket-instance-at [state instances reference signature]
    (let-do [result -1
             id @(CoreRef.id reference)]
      (when (and (Int.>= id 0)
                 (Int.< id
                        (Array.length (SpecializeWork.instance-buckets state))))
        (let-do [bucket (Array.unsafe-nth (SpecializeWork.instance-buckets state)
                                          id)
                 n (Array.length bucket)]
          (for [i 0 n]
            (when (Int.= result -1)
              (let [at @(Array.unsafe-nth bucket i)]
                (when (Type.same-representation?
                    (Box.peek
                      (Specialization.signature (Array.unsafe-nth instances at)))
                    signature)
                  (set! result at)))))))
      result))

  (defn contains-instance? [state instances reference signature]
    (Int.>= (bucket-instance-at state instances reference signature) 0))

  (private symbol-for)
  (hidden symbol-for)
  (doc use-symbol-namespace! "prefixes symbols for the supplied definitions.
A persistent JIT passes one transactional cell's definition provenance so new
native generations coexist while stable Core symbols retain their shared
names.")
  (defn use-symbol-namespace! [salt references]
    (do
      (set! *specialization-symbol-salt* (String.copy salt))
      (set! *specialization-symbol-references* (Array.copy references))))

  (defn clear-symbol-namespace! []
    (do
      (set! *specialization-symbol-salt* (String.copy ""))
      (set! *specialization-symbol-references* (the (Array CoreRef) []))))

  (private namespaced-reference?)
  (hidden namespaced-reference?)
  (defn namespaced-reference? [context reference]
    (let-do [found false]
      (for [i 0 (Array.length (SpecializeContext.symbol-references context))]
        (when (CoreIR.same-ref?
            (Array.unsafe-nth (SpecializeContext.symbol-references context) i)
            reference)
          (set! found true)))
      found))

  (doc use-binding-versions! "selects native versions of committed bindings.
Transient cell definitions keep their own namespace. Empty versions preserve
the ordinary AOT symbol policy.")
  (defn use-binding-versions! [versions]
    (set! *specialization-binding-versions* @versions))

  (doc clear-binding-versions! "restores the ordinary native symbol policy.")
  (defn clear-binding-versions! []
    (set! *specialization-binding-versions*
          (the (Array (Pair String String)) [])))

  (defn- binding-version [context reference]
    (let-do [version @""]
      (for [i 0 (Array.length (SpecializeContext.binding-versions context))]
        (let [entry (Array.unsafe-nth
                (SpecializeContext.binding-versions context)
                i)]
          (when (String.= (CoreRef.name reference) (Pair.a entry))
            (set! version @(Pair.b entry)))))
      version))

  (private mangled-symbol)
  (hidden mangled-symbol)
  (defn mangled-symbol [context reference signature]
    (let [base (CAbi.mangle (CoreRef.name reference) signature)
          salt (if (namespaced-reference? context reference)
            @(SpecializeContext.symbol-salt context)
            (binding-version context reference))]
      (if (String.empty? &salt)
        base
        (fmt "carp_session_%s_%s" &(CAbi.component &salt) &base))))

  (private builtin-source-for)
  (hidden builtin-source-for)
  (defn builtin-source-for [core reference]
    (let-do [result (the (Maybe SpecializedBuiltinSource) (Maybe.Nothing))
             sources (CoreModule.builtin-sources core)
             n (Array.length sources)]
      (for [i 0 n]
        (let [source (Array.unsafe-nth sources i)]
          (when (CoreIR.same-ref? (CoreBuiltinSource.reference source) reference)
            (set! result
                  (Maybe.Just
                    (SpecializedBuiltinSource.init @(CoreBuiltinSource.signature source)
                                                   @(CoreBuiltinSource.payload source)))))))
      result))

  (private external-call?)
  (hidden external-call?)
  (defn external-call? [core reference]
    (let-do [sources (CoreModule.builtin-sources core)
             external false]
      (for [i 0 (Array.length sources)]
        (let [source (Array.unsafe-nth sources i)]
          (when (CoreIR.same-ref? (CoreBuiltinSource.reference source) reference)
            (set! external
                  (match-ref (CoreBuiltinSource.payload source)
                    (CoreBuiltinPayload.External _) true
                    _ false)))))
      external))

  (defn symbol-for [context core reference signature]
    (match (builtin-source-for core reference)
      (Maybe.Just source)
        (match-ref (SpecializedBuiltinSource.payload &source)
          (CoreBuiltinPayload.External external-name)
            (match-ref external-name
              (Maybe.Just name) (String.copy name)
              (Maybe.Nothing) (CAbi.runtime-symbol (CoreRef.name reference)))
          (CoreBuiltinPayload.Template _ _)
            (mangled-symbol context reference signature))
      (Maybe.Nothing) (mangled-symbol context reference signature)))

  (private scheme-position-linear)
  (hidden scheme-position-linear)
  (defn scheme-position-linear [environment reference]
    (let-do [result -1
             n (Array.length environment)]
      (for [i 0 n]
        (when (CoreIR.same-ref?
            (SchemeBinding.reference (Array.unsafe-nth environment i))
            reference)
          (set! result i)))
      result))

  (private scheme-index)
  (hidden scheme-index)
  (doc scheme-index "builds the id→position index over a scheme environment;
called at every public entry before `scheme-for` runs. Ids can repeat across
categories, so the index keeps the LAST position per id (matching the linear
scan) and `scheme-for` verifies the hit, falling back to the scan on
mismatch.")
  (defn scheme-index [environment]
    (let-do [max-id 0
             n (Array.length environment)]
      (for [i 0 n]
        (let [id @(CoreRef.id
                (SchemeBinding.reference (Array.unsafe-nth environment i)))]
          (when (Int.> id max-id) (set! max-id id))))
      (let-do [index (Array.replicate (Int.inc max-id) &-1)]
        (for [i 0 n]
          (let [id @(CoreRef.id
                  (SchemeBinding.reference (Array.unsafe-nth environment i)))]
            (when (Int.>= id 0) (Array.aset! &index id i))))
        index)))

  (private owner-buckets)
  (hidden owner-buckets)
  (private owner-trace-key)
  (hidden owner-trace-key)

  (doc owner-buckets "groups node-type positions by owner trace key in
one linear pass: count per slot, prefix-sum into starts, then place.")
  (defn owner-buckets [inferred]
    (let-do [node-types (InferredModule.node-types inferred)
             keys (the (Array Int) [])]
      (for [i 0 (Array.length node-types)]
        (Array.push-back! &keys
                          (owner-trace-key
                            (InferredNodeType.owner (Array.unsafe-nth node-types
                                                                      i)))))
      (PositionBuckets.from-keys &keys)))

  (private call-buckets)
  (hidden call-buckets)
  (defn call-buckets [inferred]
    (let-do [calls (InferredModule.calls inferred)
             keys (the (Array Int) [])]
      (for [i 0 (Array.length calls)]
        (Array.push-back! &keys
                          (owner-trace-key
                            (CallSite.owner (Array.unsafe-nth calls i)))))
      (PositionBuckets.from-keys &keys)))

  (private scheme-position)
  (hidden scheme-position)
  (doc scheme-position "where `reference`'s scheme sits in `environment`, or
-1. A caller that only reads the scheme reads it there instead of copying it.")
  (defn scheme-position [context environment reference]
    (let [id @(CoreRef.id reference)]
      (if (or (Int.< id 0)
              (Int.>= id
                      (Array.length (SpecializeContext.scheme-id-index context))))
        -1
        (let [at @(Array.unsafe-nth
                (SpecializeContext.scheme-id-index context)
                id)]
          (cond
            (or (Int.< at 0) (Int.>= at (Array.length environment))) -1
            (CoreIR.same-ref?
              (SchemeBinding.reference (Array.unsafe-nth environment at))
              reference)
              at
            (scheme-position-linear environment reference))))))

  (private scheme-for)
  (hidden scheme-for)
  (defn scheme-for [context environment reference]
    (let [at (scheme-position context environment reference)]
      (if (Int.< at 0)
        (Maybe.Nothing)
        (Maybe.Just @(SchemeBinding.scheme (Array.unsafe-nth environment at))))))

  (private implementation-for)
  (hidden implementation-for)
  (private copy-call-owner)
  (hidden copy-call-owner)
  (private constructor-structure)
  (hidden constructor-structure)
  (doc constructor-structure "how constrained a declared type is: one point
per type its shape names. A bare variable names nothing and scores zero, so
an implementation for `(Duo a b)` outranks a fallback for `a` however many
parameters the type takes — the parameters are what the implementation is
generic in, not what it is vague about.

A constructor variable — the head of `(f a)` — names nothing either, which is
what keeps a generic-over-containers implementation from beating a concrete
one.")
  (defn constructor-structure [type]
    (match-ref type
      (MonoType.Variable _) 0
      (MonoType.Named name arguments)
        (let-do [score (if (Type.constructor-variable? name) 0 1)]
          (for [i 0 (Array.length arguments)]
            (set! score
                  (Int.+ score
                         (constructor-structure
                           (Box.peek (Array.unsafe-nth arguments i))))))
          score)
      (MonoType.Reference inner _)
        (Int.+ 1 (constructor-structure (Box.peek inner)))
      (MonoType.Function arguments result)
        (let-do [score (Int.+ 1 (constructor-structure (Box.peek result)))]
          (for [i 0 (Array.length arguments)]
            (set! score
                  (Int.+ score
                         (constructor-structure
                           (Box.peek (Array.unsafe-nth arguments i))))))
          score)
      _ 1))

  (private constructor-generality)
  (hidden constructor-generality)
  (defn constructor-generality [type]
    (match-ref type
      (MonoType.Named name arguments)
        (let-do [score (if (Type.constructor-variable? name) 1 0)]
          (for [i 0 (Array.length arguments)]
            (set! score
                  (Int.+ score
                         (constructor-generality
                           (Box.peek (Array.unsafe-nth arguments i))))))
          score)
      (MonoType.Reference inner _) (constructor-generality (Box.peek inner))
      (MonoType.Function arguments result)
        (let-do [score (constructor-generality (Box.peek result))]
          (for [i 0 (Array.length arguments)]
            (set! score
                  (Int.+ score
                         (constructor-generality
                           (Box.peek (Array.unsafe-nth arguments i))))))
          score)
      _ 0))

  (private exact-type-key!)
  (hidden exact-type-key!)
  (doc exact-type-key! "appends a spelling of `type` that tells apart every
pair of types unification tells apart: variable ids and lifetimes included,
which `Type.render` leaves out.")
  (defn exact-type-key! [type parts]
    (match-ref type
      (MonoType.Variable variable)
        (Array.push-back! parts (fmt "v%d" @variable))
      (MonoType.Integer) (Array.push-back! parts @"I")
      (MonoType.String) (Array.push-back! parts @"S")
      (MonoType.Boolean) (Array.push-back! parts @"B")
      (MonoType.Unit) (Array.push-back! parts @"U")
      (MonoType.Named name arguments)
        (do
          (Array.push-back! parts (fmt "(%d:%s" (String.length name) name))
          (for [i 0 (Array.length arguments)]
            (exact-type-key! (Box.peek (Array.unsafe-nth arguments i)) parts))
          (Array.push-back! parts @")"))
      (MonoType.Reference inner lifetime)
        (do
          (Array.push-back! parts
                            (match-ref lifetime
                              (MonoLifetime.Variable variable)
                                (fmt "&%d" @variable)
                              (MonoLifetime.Static) @"&s"))
          (exact-type-key! (Box.peek inner) parts))
      (MonoType.Function arguments result)
        (do
          (Array.push-back! parts @"[")
          (for [i 0 (Array.length arguments)]
            (exact-type-key! (Box.peek (Array.unsafe-nth arguments i)) parts))
          (Array.push-back! parts @"]")
          (exact-type-key! (Box.peek result) parts))))

  (private implementation-search)
  (hidden implementation-search)
  (defn implementation-search [context core inferred call]
    (let-do [interface (CallSite.reference call)
             signature (Box.peek (CallSite.type call))
             result (the (Maybe CallSite) (Maybe.Nothing))
             implementations (CoreModule.implementations core)
             environment (InferredModule.environment inferred)
             found false
             found-specificity 1000000
             found-structure -1
             buckets (SpecializeContext.implementation-buckets context)
             range (PositionBuckets.range buckets (CoreRef.id interface))
             items (PositionBuckets.items buckets)]
      (for [p @(Pair.a &range) @(Pair.b &range)]
        (let [candidate (Array.unsafe-nth implementations
                                          @(Array.unsafe-nth items p))]
          (when (CoreIR.same-ref? (CoreImplementation.interface candidate)
                                  interface)
            (let [at (scheme-position context
                                      environment
                                      (CoreImplementation.implementation candidate))]
              (when (Int.>= at 0)
                (let [scheme (SchemeBinding.scheme (Array.unsafe-nth environment
                                                                     at))
                      empty (Type.empty-substitution)]
                  (match (Type.unify-strict (Box.peek (TypeScheme.body scheme))
                                            signature
                                            &empty)
                    (Result.Success substitution)
                      (let [implementation-type (Type.apply &substitution
                                                            (Box.peek (TypeScheme.body scheme)))
                            ;; the most specific implementation (fewest free type
                            ;; variables in its declared type) wins; only a tie at
                            ;; the same specificity is a genuine ambiguity.
                            declared-type (Box.peek (TypeScheme.body scheme))
                            candidate-structure (constructor-structure declared-type)
                            candidate-specificity (Int.+
                              (Array.length &(Type.free-variables declared-type))
                              (constructor-generality declared-type))]
                        ;; free call-site variables (overload interfaces pin
                        ;; them only through dispatch) resolve through the
                        ;; unifier before the equivalence check.
                        (when (Type.same-representation? &implementation-type
                                                         &(Type.apply &substitution
                                                                      signature))
                          (cond
                            (or (not found)
                                (or
                                  (Int.> candidate-structure found-structure)
                                  (and
                                    (Int.= candidate-structure found-structure)
                                    (Int.< candidate-specificity
                                           found-specificity))))
                              (do
                                (set! found true)
                                (set! found-structure candidate-structure)
                                (set! found-specificity candidate-specificity)
                                (set! result
                                      (Maybe.Just
                                        (CallSite.init @(CallSite.id call)
                                                       @(CoreImplementation.implementation candidate)
                                                       (Box.init implementation-type)
                                                       (copy-call-owner call)))))
                            (and
                              (Int.= candidate-structure found-structure)
                              (Int.= candidate-specificity found-specificity))
                              (set! result
                                    (Maybe.Just
                                      (CallSite.init @(CallSite.id call)
                                                     @(CoreImplementation.implementation candidate)
                                                     (Box.init implementation-type)
                                                     (copy-call-owner call))))
                            ())))
                    (Result.Error _) ())))))))
      (match result
        (Maybe.Just site) (Result.Success site)
        (Maybe.Nothing)
          (Result.Error
            (SpecializeError.init
              ;; the interface and the type it was asked for are the whole
              ;; diagnosis, and what to do about it follows from them:
              ;; implement it for that type
              (String.concat
                &[@"no implementation of "
                  (String.copy (CoreRef.name interface))
                  @" for "
                  (Type.render signature)
                  @"; define one and say (implements "
                  (String.copy (CoreRef.name interface))
                  @" <your function>)"]))))))

  (doc implementation-for "the implementation of `call`'s interface that its
type dispatches to: the most constrained of the implementations whose type
fits. Answers are memoized while `module-with-known` runs.")
  (defn implementation-for [context state core inferred call]
    (let-do [parts (the (Array String) [])
             _ignored (exact-type-key! (Box.peek (CallSite.type call)) &parts)
             key (fmt "%d %s"
                      @(CoreRef.id (CallSite.reference call))
                      &(String.concat &parts))
             answer (match (Map.get-maybe (SpecializeWork.implementations state)
                                          &key)
               (Maybe.Just known) known
               (Maybe.Nothing)
                 (let-do [found (match (implementation-search context
                                                              core
                                                              inferred
                                                              call)
                            (Result.Success site)
                              (Result.Success
                                (Pair.init @(CallSite.reference &site)
                                           @(CallSite.type &site)))
                            (Result.Error error) (Result.Error error))]
                   (Map.put! (SpecializeWork.implementations state) &key &found)
                   found))]
      (match answer
        (Result.Success pair)
          (Result.Success
            (CallSite.init @(CallSite.id call)
                           @(Pair.a &pair)
                           @(Pair.b &pair)
                           (copy-call-owner call)))
        (Result.Error error) (Result.Error error))))

  (sig collect-global-values-from-expressions!
       (Fn
         [(Ref SpecializeContext)
          (Ref SpecializeWork)
          (Ref (Array (Box CoreExpr)))
          (Ref InferredModule)
          (Ref (Maybe CoreRef))
          (Ref (Array CallSite))]
         (Result Unit SpecializeError)))
  (defn collect-global-values-from-expressions! [context
                                                 state
                                                 expressions
                                                 inferred
                                                 owner
                                                 sites]
    (let-do [result (the (Result Unit SpecializeError) (Result.Success ()))
             n (Array.length expressions)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success _)
            (set! result
                  (collect-global-values! context
                                          state
                                          (Box.peek (Array.unsafe-nth expressions
                                                                      i))
                                          inferred
                                          owner
                                          sites))
          (Result.Error _) ()))
      result))

  (sig collect-global-values-from-branches!
       (Fn
         [(Ref SpecializeContext)
          (Ref SpecializeWork)
          (Ref (Array CoreMatchBranch))
          (Ref InferredModule)
          (Ref (Maybe CoreRef))
          (Ref (Array CallSite))]
         (Result Unit SpecializeError)))
  (defn collect-global-values-from-branches! [context
                                              state
                                              branches
                                              inferred
                                              owner
                                              sites]
    (let-do [result (the (Result Unit SpecializeError) (Result.Success ()))
             n (Array.length branches)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success _)
            (set! result
                  (collect-global-values! context
                                          state
                                          (Box.peek
                                            (CoreMatchBranch.body (Array.unsafe-nth branches
                                                                                    i)))
                                          inferred
                                          owner
                                          sites))
          (Result.Error _) ()))
      result))

  (sig collect-global-values!
       (Fn
         [(Ref SpecializeContext)
          (Ref SpecializeWork)
          (Ref CoreExpr)
          (Ref InferredModule)
          (Ref (Maybe CoreRef))
          (Ref (Array CallSite))]
         (Result Unit SpecializeError)))
  (defn collect-global-values! [context state expression inferred owner sites]
    (match-ref expression
      (CoreExpr.ArrayLit _ expressions)
        (collect-global-values-from-expressions! context
                                                 state
                                                 expressions
                                                 inferred
                                                 owner
                                                 sites)
      (CoreExpr.StaticArrayLit _ expressions)
        (collect-global-values-from-expressions! context
                                                 state
                                                 expressions
                                                 inferred
                                                 owner
                                                 sites)
      (CoreExpr.Reference expression-id reference)
        (if @(CoreRef.global reference)
          (let [empty (Type.empty-substitution)]
            (match (expression-type-for context
                                        state
                                        inferred
                                        owner
                                        @expression-id
                                        &empty)
              (Result.Success type)
                (do
                  (Array.push-back! sites
                                    (CallSite.init @expression-id
                                                   (CoreRef.copy reference)
                                                   (Box.init type)
                                                   (match-ref owner
                                                     (Maybe.Just found)
                                                       (Maybe.Just (CoreRef.copy found))
                                                     (Maybe.Nothing)
                                                       (Maybe.Nothing))))
                  (Result.Success ()))
              (Result.Error error) (Result.Error error)))
          (Result.Success ()))
      (CoreExpr.Call _ callee arguments)
        (let [callee-result (match-ref (Box.peek callee)
                (CoreExpr.Reference _ reference)
                  (if @(CoreRef.global reference)
                    (Result.Success ())
                    (collect-global-values! context
                                            state
                                            (Box.peek callee)
                                            inferred
                                            owner
                                            sites))
                _
                  (collect-global-values! context
                                          state
                                          (Box.peek callee)
                                          inferred
                                          owner
                                          sites))]
          (match callee-result
            (Result.Success _)
              (collect-global-values-from-expressions! context
                                                       state
                                                       arguments
                                                       inferred
                                                       owner
                                                       sites)
            (Result.Error error) (Result.Error error)))
      (CoreExpr.Do _ expressions)
        (collect-global-values-from-expressions! context
                                                 state
                                                 expressions
                                                 inferred
                                                 owner
                                                 sites)
      (CoreExpr.If _ condition then-branch else-branch)
        (match (collect-global-values! context
                                       state
                                       (Box.peek condition)
                                       inferred
                                       owner
                                       sites)
          (Result.Success _)
            (match (collect-global-values! context
                                           state
                                           (Box.peek then-branch)
                                           inferred
                                           owner
                                           sites)
              (Result.Success _)
                (collect-global-values! context
                                        state
                                        (Box.peek else-branch)
                                        inferred
                                        owner
                                        sites)
              (Result.Error error) (Result.Error error))
          (Result.Error error) (Result.Error error))
      (CoreExpr.Let _ _ value body)
        (match (collect-global-values! context
                                       state
                                       (Box.peek value)
                                       inferred
                                       owner
                                       sites)
          (Result.Success _)
            (collect-global-values! context
                                    state
                                    (Box.peek body)
                                    inferred
                                    owner
                                    sites)
          (Result.Error error) (Result.Error error))
      (CoreExpr.Set _ _ value)
        (collect-global-values! context
                                state
                                (Box.peek value)
                                inferred
                                owner
                                sites)
      (CoreExpr.While _ condition body)
        (match (collect-global-values! context
                                       state
                                       (Box.peek condition)
                                       inferred
                                       owner
                                       sites)
          (Result.Success _)
            (collect-global-values! context
                                    state
                                    (Box.peek body)
                                    inferred
                                    owner
                                    sites)
          (Result.Error error) (Result.Error error))
      (CoreExpr.Lambda _ _ body)
        (collect-global-values! context
                                state
                                (Box.peek body)
                                inferred
                                owner
                                sites)
      (CoreExpr.Match _ _ scrutinee branches)
        (match (collect-global-values! context
                                       state
                                       (Box.peek scrutinee)
                                       inferred
                                       owner
                                       sites)
          (Result.Success _)
            (collect-global-values-from-branches! context
                                                  state
                                                  branches
                                                  inferred
                                                  owner
                                                  sites)
          (Result.Error error) (Result.Error error))
      (CoreExpr.Annotation _ inner _)
        (collect-global-values! context
                                state
                                (Box.peek inner)
                                inferred
                                owner
                                sites)
      _ (Result.Success ())))

  (defn global-values-in [context state expression inferred owner]
    (let-do [sites (the (Array CallSite) [])]
      (match (collect-global-values! context
                                     state
                                     expression
                                     inferred
                                     owner
                                     &sites)
        (Result.Success _) (Result.Success sites)
        (Result.Error error) (Result.Error error))))

  (private call-owned-by?)
  (hidden call-owned-by?)
  (private root-call?)
  (hidden root-call?)
  (defn call-owned-by? [call reference]
    (match-ref (CallSite.owner call)
      (Maybe.Just owner) (CoreIR.same-ref? owner reference)
      (Maybe.Nothing) false))

  (defn root-call? [call]
    (match-ref (CallSite.owner call) (Maybe.Just _) false (Maybe.Nothing) true))

  (private calls-owned-by)
  (hidden calls-owned-by)
  (doc calls-owned-by "the calls `reference`'s definition makes, in trace
order: its owner bucket when one is primed, else a scan of every call.")
  (defn calls-owned-by [context inferred reference]
    (let-do [result (the (Array CallSite) [])
             calls (InferredModule.calls inferred)
             buckets (SpecializeContext.call-buckets context)
             range (PositionBuckets.range buckets (CoreRef.id reference))
             items (PositionBuckets.items buckets)]
      (for [b @(Pair.a &range) @(Pair.b &range)]
        (let [call (Array.unsafe-nth calls @(Array.unsafe-nth items b))]
          (when (call-owned-by? call reference) (Array.push-back! &result @call))))
      result))

  (private root-calls)
  (hidden root-calls)
  (defn root-calls [-core inferred]
    (let-do [result (the (Array CallSite) [])
             calls (InferredModule.calls inferred)
             n (Array.length calls)]
      (for [i 0 n]
        (let [call (Array.unsafe-nth calls i)]
          (when (root-call? call) (Array.push-back! &result @call))))
      result))

  (defn copy-call-owner [call]
    (match-ref (CallSite.owner call)
      (Maybe.Just owner) (Maybe.Just (CoreRef.copy owner))
      (Maybe.Nothing) (Maybe.Nothing)))

  (private normalize-call)
  (hidden normalize-call)
  (private apply-module-substitution)
  (hidden apply-module-substitution)
  (doc apply-module-substitution "applies the module substitution, through the
indexed view when one has been built for this module.")
  (defn apply-module-substitution [state type]
    (Type.solver-apply (SpecializeWork.module-solver state) type))

  (defn normalize-call [state inferred call]
    (CallSite.init @(CallSite.id call)
                   (CoreRef.copy (CallSite.reference call))
                   (Box.init (apply-module-substitution state

                                                        (Box.peek (CallSite.type call))))
                   (copy-call-owner call)))

  (private entry-type-error)
  (hidden entry-type-error)
  (doc entry-type-error "why a `main` of `type` cannot be the entry point, if it
cannot.")
  (defn entry-type-error [type]
    (match-ref type
      (MonoType.Function arguments answer)
        (cond
          (not (Array.empty? arguments))
            (Maybe.Just
              (fmt
                "The main function may not receive arguments, but it got %d"
                (Array.length arguments)))
          (not (Array.empty? &(Type.free-variables (Box.peek answer))))
            (Maybe.Just
              @"`main` was generic at build time, it must return either `Int` or `()`.")
          (match-ref (Box.peek answer)
            (MonoType.Integer) (Maybe.Nothing)
            (MonoType.Unit) (Maybe.Nothing)
            _
              (Maybe.Just
                (fmt
                  "The main function can only return an `Int` or a unit type `()`, but it got `%s`"
                  &(Type.render (Box.peek answer))))))
      _ (Maybe.Nothing)))

  (doc entry-request "seeds the `main` function as a specialization demand so it
is emitted as the program entry point, the way the reference compiler treats
`main`. Nullary and monomorphic, so its inferred scheme body is its concrete
type. Empty when the program defines no `main`, and an error, worded as the
reference words it, when `main` takes arguments or answers something other
than an `Int` or `()`.")
  (private entry-request)
  (hidden entry-request)
  (defn entry-request [context core inferred]
    (let-do [result (the
               (Result (Array SpecializationRequest) SpecializeError)
               (Result.Success []))
             functions (CoreModule.functions core)
             n (Array.length functions)]
      (for [i 0 n]
        (let [reference (CoreFunction.reference (Array.unsafe-nth functions i))]
          (when (String.= (CoreRef.name reference) "main")
            (match (scheme-for context
                               (InferredModule.environment inferred)
                               reference)
              (Maybe.Just scheme)
                (let [type (Type.apply (InferredModule.substitution inferred)
                                       (Box.peek (TypeScheme.body &scheme)))]
                  (set! result
                        (match (entry-type-error &type)
                          (Maybe.Just message)
                            (Result.Error (SpecializeError.init message))
                          (Maybe.Nothing)
                            (Result.Success
                              [(SpecializationRequest.init
                                 (CallSite.init -1
                                                (CoreRef.copy reference)
                                                (Box.init type)
                                                (Maybe.Nothing))
                                 (String.copy "<entry>"))]))))
              (Maybe.Nothing) ()))))
      result))

  (private root-requests)
  (hidden root-requests)
  (defn root-requests [context state core inferred]
    (let-do [result (the (Array SpecializationRequest) [])
             calls (root-calls core inferred)
             n (Array.length &calls)
             entry (entry-request context core inferred)]
      (for [i 0 n]
        (Array.push-back! &result
                          (SpecializationRequest.init @(Array.unsafe-nth &calls
                                                                         i)
                                                      (String.copy "<root>"))))
      (match-ref &entry
        (Result.Success entries)
          (for [i 0 (Array.length entries)]
            (Array.push-back! &result @(Array.unsafe-nth entries i)))
        _ ())
      ;; every top-level `def` is part of the program even when nothing reads
      ;; it: its initializer runs at startup, so it must be specialized.
      (let-do [values (CoreModule.values core)
               value-count (Array.length values)]
        (for [i 0 value-count]
          (let [value (Array.unsafe-nth values i)
                value-reference (CoreValue.reference value)]
            (match (scheme-for context
                               (InferredModule.environment inferred)
                               value-reference)
              (Maybe.Just scheme)
                (Array.push-back! &result
                                  (SpecializationRequest.init
                                    (CallSite.init -1
                                                   (CoreRef.copy value-reference)
                                                   (Box.init
                                                     (MonoType.copy (Box.peek (TypeScheme.body &scheme))))
                                                   (Maybe.Nothing))
                                    (String.copy "<global>")))
              (Maybe.Nothing) ()))))
      (match entry
        (Result.Error error) (Result.Error error)
        _
          (let-do [sites (the (Array CallSite) [])
                   owner (the (Maybe CoreRef) (Maybe.Nothing))]
            (match (collect-global-values-from-expressions! context
                                                            state
                                                            (CoreModule.expressions core)
                                                            inferred
                                                            &owner
                                                            &sites)
              (Result.Success _)
                (do
                  (let [site-count (Array.length &sites)]
                    (for [i 0 site-count]
                      (Array.push-back! &result
                                        (SpecializationRequest.init @(Array.unsafe-nth &sites
                                                                                       i)
                                                                    (String.copy "<root>")))))
                  (Result.Success result))
              (Result.Error error) (Result.Error error))))))

  (private contextual-specialize-error)
  (hidden contextual-specialize-error)
  (doc contextual-specialize-error "an error with the definition it came up
in. The context leads, the way `in function f:` leads an inference error, so
that a message ending in advice ends the sentence.")
  (defn contextual-specialize-error [origin message]
    (String.concat &[@"in " (String.copy origin) @": " (String.copy message)]))

  (private dependencies-for)
  (hidden dependencies-for)
  (private primitive-dependencies-for)
  (hidden primitive-dependencies-for)
  (private copy-template-dependency)
  (hidden copy-template-dependency)
  (private copy-callsite)
  (hidden copy-callsite)
  (private str-callsite)
  (hidden str-callsite)
  (private str-template-dependency)
  (hidden str-template-dependency)
  (private array-delete-template-dependencies)
  (hidden array-delete-template-dependencies)
  (private pair-copy-template-dependencies)
  (hidden pair-copy-template-dependencies)

  (defn copy-callsite [interface lifetime element]
    (CallSite.init -1
                   (CoreRef.copy interface)
                   (Box.init
                     (Type.function
                       [(Box.init
                          (Type.reference (MonoType.copy element)
                                          (MonoLifetime.copy lifetime)))]
                       (MonoType.copy element)))
                   (Maybe.Nothing)))

  (defn str-callsite [interface lifetime element by-ref]
    (CallSite.init -1
                   (CoreRef.copy interface)
                   (Box.init
                     (Type.function
                       [(Box.init
                          (if by-ref
                            (Type.reference (MonoType.copy element)
                                            (MonoLifetime.copy lifetime))
                            (MonoType.copy element)))]
                       (MonoType.String)))
                   (Maybe.Nothing)))

  (defn copy-template-dependency [interface signature]
    (match-ref signature
      (MonoType.Function arguments _)
        (if (Int.= 1 (Array.length arguments))
          (match-ref (Box.peek (Array.unsafe-nth arguments 0))
            (MonoType.Reference container lifetime)
              (match-ref (Box.peek container)
                (MonoType.Named _ type-arguments)
                  (if (Int.= 1 (Array.length type-arguments))
                    (let [element (MonoType.copy
                            (Box.peek (Array.unsafe-nth type-arguments 0)))]
                      (Result.Success
                        (copy-callsite interface lifetime &element)))
                    (Result.Error
                      (SpecializeError.init
                        @"copy template container must have one type argument")))
                _
                  (Result.Error
                    (SpecializeError.init
                      @"copy template argument must reference a named container")))
            _
              (Result.Error
                (SpecializeError.init
                  @"copy template argument must be a reference")))
          (Result.Error
            (SpecializeError.init @"copy template must have one argument")))
      _
        (Result.Error
          (SpecializeError.init @"copy template must have a function signature"))))

  ;; the element's `str` implementation may take its argument by value
  ;; (primitives) or by reference (managed types). The reference only calls by
  ;; value when the member type is blittable (StructUtils.memberStrCallingConvention);
  ;; probing value-first without that guard would move a String element out of a
  ;; borrowed array (StringCopy.prn takes its argument by value).
  (doc blit-implemented? "whether the element type implements `blit` — the
reference's test for whether a member's `str`/`prn` may be called BY VALUE
(StructUtils.memberStrCallingConvention). A blittable value is copied, not
moved, so passing it by value out of a borrowed container is safe. `blit` is a
Core interface, looked up the same way the reference looks it up.")
  (private blit-implemented?)
  (hidden blit-implemented?)
  (defn blit-implemented? [context state core inferred element]
    (let-do [interfaces (CoreModule.interfaces core)
             found (the (Maybe CoreRef) (Maybe.Nothing))]
      (for [i 0 (Array.length interfaces)]
        (let [reference (CoreInterface.reference (Array.unsafe-nth interfaces i))]
          (when (String.= (CoreRef.name reference) "blit")
            (set! found (Maybe.Just (CoreRef.copy reference))))))
      (match found
        (Maybe.Nothing) false
        (Maybe.Just blit-ref)
          (let [site (CallSite.init -1
                                    blit-ref
                                    (Box.init
                                      (Type.function [(Box.init (MonoType.copy element))]
                                                     (MonoType.copy element)))
                                    (Maybe.Nothing))]
            (match (implementation-for context state core inferred &site)
              (Result.Success _) true
              (Result.Error _) false)))))

  ;; fallback for builds without Core (no `blit` interface to probe).
  (private blittable-element?)
  (hidden blittable-element?)
  (defn blittable-element? [mono]
    (match-ref mono
      (MonoType.Named name args)
        (and (Int.= 0 (Array.length args))
             (let-do [names [@"Int"
                             @"Long"
                             @"Bool"
                             @"Float"
                             @"Double"
                             @"Byte"
                             @"Char"
                             @"Int8"
                             @"Int16"
                             @"Int32"
                             @"Int64"
                             @"Uint8"
                             @"Uint16"
                             @"Uint32"
                             @"Uint64"]
                      found false]
               (for [i 0 (Array.length &names)]
                 (when (String.= (Array.unsafe-nth &names i) name)
                   (set! found true)))
               found))
      _ false))

  (doc element-render-callsite "how a container renders one element. The
reference looks the member function up and gracefully falls back when it is
absent (StructUtils/ArrayTemplates); mirror that here — prefer the requested
interface (`prn`, so strings show as literals), fall back to `str` for element
types that implement only `str` (a `Ptr`, say), and pick the by-value convention
only for blittable elements, since a by-value call on a managed element would
move it out of the borrowed container.")
  (private element-render-callsite)
  (hidden element-render-callsite)
  (defn element-render-callsite [context
                                 state
                                 core
                                 inferred
                                 interface
                                 lifetime
                                 element]
    (let [str-interface (PrimitiveRegistry.reference 1 "str")
          candidates (if (or
              (blit-implemented? context state core inferred element)
              (blittable-element? element))
            [(str-callsite interface lifetime element false)
             (str-callsite interface lifetime element true)
             (str-callsite &str-interface lifetime element false)
             (str-callsite &str-interface lifetime element true)]
            [(str-callsite interface lifetime element true)
             (str-callsite &str-interface lifetime element true)])]
      (let-do [chosen (the (Maybe CallSite) (Maybe.Nothing))]
        (for [i 0 (Array.length &candidates)]
          (when (match-ref &chosen (Maybe.Nothing) true _ false)
            (match (implementation-for context
                                       state
                                       core
                                       inferred
                                       (Array.unsafe-nth &candidates i))
              (Result.Success _)
                (set! chosen (Maybe.Just @(Array.unsafe-nth &candidates i)))
              (Result.Error _) ())))
        ;; nothing matched: keep the by-reference form of the requested
        ;; interface so the error names the interface actually asked for.
        (match chosen
          (Maybe.Just site) site
          (Maybe.Nothing) (str-callsite interface lifetime element true)))))

  (defn str-template-dependency [context state core inferred interface signature]
    (match-ref signature
      (MonoType.Function arguments _)
        (if (Int.= 1 (Array.length arguments))
          (match-ref (Box.peek (Array.unsafe-nth arguments 0))
            (MonoType.Reference container lifetime)
              (match-ref (Box.peek container)
                (MonoType.Named _ type-arguments)
                  (if (Int.= 1 (Array.length type-arguments))
                    (let [element (MonoType.copy
                            (Box.peek (Array.unsafe-nth type-arguments 0)))]
                      (Result.Success
                        (element-render-callsite context
                                                 state
                                                 core
                                                 inferred
                                                 interface
                                                 lifetime
                                                 &element)))
                    (Result.Error
                      (SpecializeError.init
                        @"str template container must have one type argument")))
                _
                  (Result.Error
                    (SpecializeError.init
                      @"str template argument must reference a named container")))
            _
              (Result.Error
                (SpecializeError.init
                  @"str template argument must be a reference")))
          (Result.Error
            (SpecializeError.init @"str template must have one argument")))
      _
        (Result.Error
          (SpecializeError.init @"str template must have a function signature"))))

  ;; `Array.delete` takes its array BY VALUE, so the element type sits directly
  ;; in the container argument. Elements without a `delete` implementation are
  ;; unmanaged and need no dependency at all.
  (defn array-delete-template-dependencies [context
                                            state
                                            core
                                            inferred
                                            interface
                                            signature]
    (match-ref signature
      (MonoType.Function arguments _)
        (if (Int.= 1 (Array.length arguments))
          (match-ref (Box.peek (Array.unsafe-nth arguments 0))
            (MonoType.Named _ type-arguments)
              (if (Int.= 1 (Array.length type-arguments))
                (let [element (MonoType.copy
                        (Box.peek (Array.unsafe-nth type-arguments 0)))
                      site (CallSite.init -1
                                          (CoreRef.copy interface)
                                          (Box.init
                                            (Type.function [(Box.init (MonoType.copy &element))]
                                                           (MonoType.Unit)))
                                          (Maybe.Nothing))]
                  (match (implementation-for context state core inferred &site)
                    (Result.Success _) (Result.Success [site])
                    (Result.Error _) (Result.Success (the (Array CallSite) []))))
                (Result.Error
                  (SpecializeError.init
                    @"array delete template container must have one type argument")))
            _
              (Result.Error
                (SpecializeError.init
                  @"array delete template argument must be a named container")))
          (Result.Error
            (SpecializeError.init
              @"array delete template must have one argument")))
      _
        (Result.Error
          (SpecializeError.init
            @"array delete template must have a function signature"))))

  (defn array-set-template-dependencies [context
                                         state
                                         core
                                         inferred
                                         interface
                                         signature]
    (match-ref signature
      (MonoType.Function arguments _)
        (if (Int.= 3 (Array.length arguments))
          (let [element (MonoType.copy (Box.peek (Array.unsafe-nth arguments 2)))
                site (CallSite.init -1
                                    (CoreRef.copy interface)
                                    (Box.init
                                      (Type.function [(Box.init (MonoType.copy &element))]
                                                     (MonoType.Unit)))
                                    (Maybe.Nothing))]
            (match (implementation-for context state core inferred &site)
              ;; Keep the dispatch result: re-enqueueing the interface site
              ;; makes the worklist resolve the same implementation again for
              ;; every Array.set!/filter dependency before instance dedup can
              ;; see it.
              (Result.Success implementation)
              (Result.Success [implementation])
              (Result.Error _)
              (Result.Success (the (Array CallSite) []))))
          (Result.Error
            (SpecializeError.init
              @"array set template must have three arguments")))
      _
        (Result.Error
          (SpecializeError.init
            @"array set template must have a function signature"))))

  (defn array-filter-template-dependencies [context
                                            state
                                            core
                                            inferred
                                            interface
                                            signature]
    (match-ref signature
      (MonoType.Function arguments _)
        (if (Int.= 2 (Array.length arguments))
          (match-ref (Box.peek (Array.unsafe-nth arguments 1))
            (MonoType.Named _ type-arguments)
              (if (Int.= 1 (Array.length type-arguments))
                (let [element (MonoType.copy
                        (Box.peek (Array.unsafe-nth type-arguments 0)))
                      site (CallSite.init -1
                                          (CoreRef.copy interface)
                                          (Box.init
                                            (Type.function [(Box.init (MonoType.copy &element))]
                                                           (MonoType.Unit)))
                                          (Maybe.Nothing))]
                  (match (implementation-for context state core inferred &site)
                    (Result.Success implementation)
                      (Result.Success [implementation])
                    (Result.Error _) (Result.Success (the (Array CallSite) []))))
                (Result.Error
                  (SpecializeError.init
                    @"array filter container must have one type argument")))
            _
              (Result.Error
                (SpecializeError.init
                  @"array filter template needs an array argument")))
          (Result.Error
            (SpecializeError.init
              @"array filter template must have two arguments")))
      _
        (Result.Error
          (SpecializeError.init
            @"array filter template must have a function signature"))))

  (defn pair-copy-template-dependencies [interface signature]
    (match-ref signature
      (MonoType.Function arguments _)
        (if (Int.= 1 (Array.length arguments))
          (match-ref (Box.peek (Array.unsafe-nth arguments 0))
            (MonoType.Reference container lifetime)
              (match-ref (Box.peek container)
                (MonoType.Named name type-arguments)
                  (if (and (= name "Pair")
                           (Int.= 2 (Array.length type-arguments)))
                    (let [first (MonoType.copy
                            (Box.peek (Array.unsafe-nth type-arguments 0)))
                          second (MonoType.copy
                            (Box.peek (Array.unsafe-nth type-arguments 1)))]
                      (Result.Success
                        [(copy-callsite interface lifetime &first)
                         (copy-callsite interface lifetime &second)]))
                    (Result.Error
                      (SpecializeError.init
                        @"pair copy template expects Pair with two type arguments")))
                _
                  (Result.Error
                    (SpecializeError.init
                      @"pair copy template argument must reference Pair")))
            _
              (Result.Error
                (SpecializeError.init
                  @"pair copy template argument must be a reference")))
          (Result.Error
            (SpecializeError.init @"pair copy template must have one argument")))
      _
        (Result.Error
          (SpecializeError.init
            @"pair copy template must have a function signature"))))

  (defn primitive-dependencies-for [context
                                    state
                                    core
                                    inferred
                                    reference
                                    signature]
    (match (PrimitiveRegistry.lowering-for reference)
      (Maybe.Just lowering)
        (match-ref &lowering
          (PrimitiveLowering.Intrinsic) (Result.Success [])
          (PrimitiveLowering.ParameterizedTemplate template)
            (match-ref template
              (PrimitiveTemplate.ArrayCopy copy-interface)
                (match (copy-template-dependency copy-interface signature)
                  (Result.Success dependency) (Result.Success [dependency])
                  (Result.Error error) (Result.Error error))
              (PrimitiveTemplate.ArrayStr str-interface)
                (match (str-template-dependency context
                                                state
                                                core
                                                inferred
                                                str-interface
                                                signature)
                  (Result.Success dependency) (Result.Success [dependency])
                  (Result.Error error) (Result.Error error))
              (PrimitiveTemplate.ArrayDelete delete-interface)
                (array-delete-template-dependencies context
                                                    state
                                                    core
                                                    inferred
                                                    delete-interface
                                                    signature)
              (PrimitiveTemplate.ArraySet delete-interface)
                (array-set-template-dependencies context
                                                 state
                                                 core
                                                 inferred
                                                 delete-interface
                                                 signature)
              (PrimitiveTemplate.ArrayPopBack delete-interface)
                (array-delete-template-dependencies context
                                                    state
                                                    core
                                                    inferred
                                                    delete-interface
                                                    signature)
              (PrimitiveTemplate.ArrayFilter delete-interface)
                (array-filter-template-dependencies context
                                                    state
                                                    core
                                                    inferred
                                                    delete-interface
                                                    signature)
              (PrimitiveTemplate.PairCopy copy-interface)
                (pair-copy-template-dependencies copy-interface signature)
              (PrimitiveTemplate.PointerCopy) (Result.Success [])
              (PrimitiveTemplate.FunctionCopy _) (Result.Success [])
              (PrimitiveTemplate.FunctionDelete _) (Result.Success [])
              (PrimitiveTemplate.FunctionStr) (Result.Success [])
              (PrimitiveTemplate.IntComparison _) (Result.Success [])
              (PrimitiveTemplate.CollectionLength) (Result.Success [])))
      (Maybe.Nothing) (Result.Success [])))

  (private declaration-error)
  (hidden declaration-error)
  (doc declaration-error "reports an instance signature that does not fit its
declared scheme, rendering the two types when the unifier left the failure
unexplained.")
  (defn declaration-error [error declared signature]
    (match-ref error
      (TypeError.Unexplained)
        (SpecializeError.init
          (TypeError.message &(Type.mismatch declared signature)))
      _ (SpecializeError.init (TypeError.message error))))

  (defn dependencies-for [context state core inferred reference signature]
    (if (has-builtin? (CoreModule.builtins core) reference)
      (primitive-dependencies-for context
                                  state
                                  core
                                  inferred
                                  reference
                                  signature)
      (match (scheme-for context (InferredModule.environment inferred) reference)
        (Maybe.Just scheme)
          (let [empty (Type.empty-substitution)]
            (match (Type.unify-strict (Box.peek (TypeScheme.body &scheme))
                                      signature
                                      &empty)
              (Result.Success instance-substitution)
                (let-do [result (the
                           (Result (Array CallSite) SpecializeError)
                           (Result.Success []))
                         raw-calls (calls-owned-by context inferred reference)
                         owner (the (Maybe CoreRef)
                                    (Maybe.Just (CoreRef.copy reference)))
                         global-values (match (value-for (CoreModule.values core)
                                                         reference)
                           (Maybe.Just value)
                             (global-values-in context
                                               state
                                               (Box.peek (CoreValue.body &value))
                                               inferred
                                               &owner)
                           (Maybe.Nothing)
                             (match (function-for (CoreModule.functions core)
                                                  reference)
                               (Maybe.Just function)
                                 (global-values-in context
                                                   state
                                                   (Box.peek (CoreFunction.body &function))
                                                   inferred
                                                   &owner)
                               (Maybe.Nothing) (Result.Success [])))]
                  (match global-values
                    (Result.Success sites)
                      (let [site-count (Array.length &sites)]
                        (for [i 0 site-count]
                          (Array.push-back! &raw-calls
                                            @(Array.unsafe-nth &sites i))))
                    (Result.Error error) (set! result (Result.Error error)))
                  (let [n (Array.length &raw-calls)]
                    (for [i 0 n]
                      (match-ref &result
                        (Result.Success calls)
                          (let [normalized (normalize-call state
                                                           inferred
                                                           (Array.unsafe-nth &raw-calls
                                                                             i))
                                signature (Type.apply &instance-substitution
                                                      (Box.peek (CallSite.type &normalized)))]
                            (Array.push-back! calls
                                              (CallSite.init @(CallSite.id &normalized)
                                                             @(CallSite.reference &normalized)
                                                             (Box.init signature)
                                                             (copy-call-owner &normalized))))
                        (Result.Error _) ())))
                  result)
              (Result.Error error)
                (Result.Error
                  (declaration-error &error
                                     (Box.peek (TypeScheme.body &scheme))
                                     signature))))
        (Maybe.Nothing)
          (Result.Error
            (SpecializeError.init @"missing inferred function scheme")))))

  (private instance-for)
  (hidden instance-for)
  (defn instance-for [state instances reference signature]
    (let [at (bucket-instance-at state instances reference signature)]
      (if (Int.>= at 0)
        (Maybe.Just @(Array.unsafe-nth instances at))
        (the (Maybe Specialization) (Maybe.Nothing)))))

  (private overload-for)
  (hidden overload-for)
  (defn overload-for [core reference]
    (let-do [result (the (Maybe CoreOverload) (Maybe.Nothing))
             overloads (CoreModule.overloads core)]
      (for [i 0 (Array.length overloads)]
        (let [overload (Array.unsafe-nth overloads i)]
          (when (CoreIR.same-ref? (CoreOverload.reference overload) reference)
            (set! result (Maybe.Just @overload)))))
      result))

  (private candidate-for)
  (hidden candidate-for)
  (doc candidate-for "the candidate of an overload that a concrete call site
chooses: the one whose type fits. Inference settles every choice its types
decide, so what arrives here is an instance of a definition generalized over
an open choice, whose concrete types decide it now.")
  (defn candidate-for [context inferred call overload]
    (let-do [signature (Box.peek (CallSite.type call))
             environment (InferredModule.environment inferred)
             fitting (the (Array CallSite) [])
             candidates (CoreOverload.candidates overload)]
      (for [i 0 (Array.length candidates)]
        (let [candidate (Array.unsafe-nth candidates i)]
          (match (scheme-for context environment candidate)
            (Maybe.Just scheme)
              (let [empty (Type.empty-substitution)]
                (match (Type.unify-strict (Box.peek (TypeScheme.body &scheme))
                                          signature
                                          &empty)
                  (Result.Success substitution)
                    (Array.push-back! &fitting
                                      (CallSite.init @(CallSite.id call)
                                                     @candidate
                                                     (Box.init
                                                       (Type.apply &substitution
                                                                   (Box.peek (TypeScheme.body &scheme))))
                                                     (copy-call-owner call)))
                  (Result.Error _) ()))
            (Maybe.Nothing) ())))
      (if (Int.= 1 (Array.length &fitting))
        (Result.Success @(Array.unsafe-nth &fitting 0))
        (Result.Error
          (SpecializeError.init
            (String.concat
              &[(if (Int.= 0 (Array.length &fitting))
                  @"no candidate of "
                  @"ambiguous ")
                @(CoreRef.name (CoreOverload.reference overload))
                @" for "
                (Type.render signature)]))))))

  (private concrete-call)
  (hidden concrete-call)
  (defn concrete-call [context state core inferred call]
    (let [reference (CallSite.reference call)]
      (if (interface? (CoreModule.interfaces core) reference)
        (implementation-for context state core inferred call)
        (match (overload-for core reference)
          (Maybe.Just overload) (candidate-for context inferred call &overload)
          (Maybe.Nothing) (Result.Success @call)))))

  (private materialize-calls)
  (hidden materialize-calls)
  (private materialize-root-calls)
  (hidden materialize-root-calls)
  (doc materialize-calls "binds each of an instance's `dependencies`, as the
worklist recorded them when it created the instance, to the instance it
resolves to.")
  (defn materialize-calls [context state core inferred instances dependencies]
    (let-do [result (the
               (Result (Array SpecializedCall) SpecializeError)
               (Result.Success []))
             n (Array.length dependencies)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success calls)
            (match (concrete-call context
                                  state
                                  core
                                  inferred
                                  (Array.unsafe-nth dependencies i))
              (Result.Success concrete)
              (when (concrete-signature? (Box.peek (CallSite.type &concrete)))
                (match (instance-for state
                                     instances
                                     (CallSite.reference &concrete)
                                     (Box.peek (CallSite.type &concrete)))
                  (Maybe.Just target)
                    (Array.push-back! calls
                                      (SpecializedCall.init @(CallSite.id &concrete)
                                                            @(CallSite.reference &concrete)
                                                            @(CallSite.type &concrete)
                                                            @(Specialization.symbol &target)
                                                            (has-value? (CoreModule.values core)
                                                                        (CallSite.reference &concrete))
                                                            (external-call? core
                                                                            (CallSite.reference &concrete))))
                  (Maybe.Nothing)
                    (set! result
                          (Result.Error
                            (SpecializeError.init
                              (String.concat
                                &[@"materialized call has no reachable instance: "
                                  (String.copy
                                    (CoreRef.name (CallSite.reference &concrete)))
                                  @" at "
                                  (Type.render (Box.peek (CallSite.type &concrete)))]))))))
              ;; an unresolvable dispatch on a still-generic dependency is
              ;; skipped like any non-concrete dependency; only a concrete
              ;; call without an implementation is a real error.
              (Result.Error error)
              (when (concrete-signature?
                  (Box.peek (CallSite.type (Array.unsafe-nth dependencies i))))
                (set! result (Result.Error error))))
          (Result.Error _) ()))
      result))

  (defn materialize-root-calls [context state core inferred instances]
    (let-do [result (the
               (Result (Array SpecializedCall) SpecializeError)
               (Result.Success []))
             raw-calls (root-calls core inferred)
             owner (the (Maybe CoreRef) (Maybe.Nothing))
             global-values (let-do [sites (the (Array CallSite) [])]
               (match (collect-global-values-from-expressions! context
                                                               state
                                                               (CoreModule.expressions core)
                                                               inferred
                                                               &owner
                                                               &sites)
                 (Result.Success _) (Result.Success sites)
                 (Result.Error error) (Result.Error error)))
             _ignored-global-values (match global-values
               (Result.Success sites)
                 (let [site-count (Array.length &sites)]
                   (for [i 0 site-count]
                     (Array.push-back! &raw-calls @(Array.unsafe-nth &sites i))))
               (Result.Error error) (set! result (Result.Error error)))
             n (Array.length &raw-calls)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success calls)
            (let [normalized (normalize-call state
                                             inferred
                                             (Array.unsafe-nth &raw-calls i))]
              (match (concrete-call context state core inferred &normalized)
                (Result.Success concrete)
                  (when (concrete-signature? (Box.peek (CallSite.type &concrete)))
                    (match (instance-for state
                                         instances
                                         (CallSite.reference &concrete)
                                         (Box.peek (CallSite.type &concrete)))
                      (Maybe.Just target)
                        (Array.push-back! calls
                                          (SpecializedCall.init @(CallSite.id &concrete)
                                                                @(CallSite.reference &concrete)
                                                                @(CallSite.type &concrete)
                                                                @(Specialization.symbol &target)
                                                                (has-value? (CoreModule.values core)
                                                                            (CallSite.reference &concrete))
                                                                (external-call? core
                                                                                (CallSite.reference &concrete))))
                      (Maybe.Nothing)
                        (set! result
                              (Result.Error
                                (SpecializeError.init
                                  @"materialized root call has no reachable instance")))))
                (Result.Error error)
                  (when (concrete-signature? (Box.peek (CallSite.type &normalized)))
                    (set! result (Result.Error error)))))
          (Result.Error _) ()))
      result))

  (defn function-for [functions reference]
    (let-do [result (the (Maybe CoreFunction) (Maybe.Nothing))
             n (Array.length functions)]
      (for [i 0 n]
        (let [function (Array.unsafe-nth functions i)]
          (when (CoreIR.same-ref? (CoreFunction.reference function) reference)
            (set! result (Maybe.Just @function)))))
      result))

  (defn value-for [values reference]
    (let-do [result (the (Maybe CoreValue) (Maybe.Nothing))
             n (Array.length values)]
      (for [i 0 n]
        (let [value (Array.unsafe-nth values i)]
          (when (CoreIR.same-ref? (CoreValue.reference value) reference)
            (set! result (Maybe.Just @value)))))
      result))

  (private rewrite-expression)
  (hidden rewrite-expression)
  (private rewrite-expressions)
  (hidden rewrite-expressions)
  (private rewrite-branches)
  (hidden rewrite-branches)
  (private specialized-call-for)
  (hidden specialized-call-for)
  (private specialized-call-maybe)
  (hidden specialized-call-maybe)
  (private rewrite-body)
  (hidden rewrite-body)
  (defn specialized-call-for [calls call-id]
    (let-do [result (the (Result SpecializedCall SpecializeError)
                         (Result.Error
                           (SpecializeError.init
                             @"specialized body contains an untyped global call")))
             found false
             n (Array.length calls)]
      (for [i 0 n]
        (let [call (Array.unsafe-nth calls i)]
          (when (Int.= @(SpecializedCall.id call) call-id)
            (if found
              (set! result
                    (Result.Error
                      (SpecializeError.init @"duplicate specialized call ID")))
              (do (set! found true) (set! result (Result.Success @call)))))))
      result))

  (private min-local-in-pattern)
  (hidden min-local-in-pattern)
  (private min-local-in-expr)
  (hidden min-local-in-expr)
  (private min-local-in-exprs)
  (hidden min-local-in-exprs)
  (sig min-local-in-pattern (Fn [(Ref CorePattern) Int] Int))
  (sig min-local-in-expr (Fn [(Ref SpecializedExpr) Int] Int))
  (sig min-local-in-exprs (Fn [(Ref (Array (Box SpecializedExpr))) Int] Int))
  (defn min-local-in-pattern [pattern m]
    (match-ref pattern
      (CorePattern.Bind reference) (Int.min m @(CoreRef.id reference))
      (CorePattern.Constructor _ children)
        (let-do [current m]
          (for [i 0 (Array.length children)]
            (set! current
                  (min-local-in-pattern (Box.peek (Array.unsafe-nth children i))
                                        current)))
          current)
      _ m))

  (defn min-local-in-exprs [expressions m]
    (let-do [current m]
      (for [i 0 (Array.length expressions)]
        (set! current
              (min-local-in-expr
                (Box.peek (Array.unsafe-nth expressions i))
                current)))
      current))

  (defn min-local-in-expr [expr m]
    (match-ref expr
      (SpecializedExpr.Reference _ _ reference)
        (if @(CoreRef.global reference) m (Int.min m @(CoreRef.id reference)))
      (SpecializedExpr.GlobalCall _ _ _ _ _ args) (min-local-in-exprs args m)
      (SpecializedExpr.Call _ _ callee args)
        (min-local-in-exprs args (min-local-in-expr (Box.peek callee) m))
      (SpecializedExpr.Do _ _ es) (min-local-in-exprs es m)
      (SpecializedExpr.If _ _ c t e)
        (min-local-in-expr (Box.peek e)
                           (min-local-in-expr (Box.peek t)
                                              (min-local-in-expr (Box.peek c) m)))
      (SpecializedExpr.Let _ _ binder value body)
        (min-local-in-expr (Box.peek body)
                           (min-local-in-expr (Box.peek value)
                                              (Int.min m @(CoreRef.id binder))))
      (SpecializedExpr.Set _ _ binder value)
        (min-local-in-expr (Box.peek value) (Int.min m @(CoreRef.id binder)))
      (SpecializedExpr.While _ _ c body)
        (min-local-in-expr (Box.peek body) (min-local-in-expr (Box.peek c) m))
      (SpecializedExpr.Lambda _ _ parameters body)
        (let-do [current m]
          (for [i 0 (Array.length parameters)]
            (set! current
                  (Int.min current @(CoreRef.id (Array.unsafe-nth parameters i)))))
          (min-local-in-expr (Box.peek body) current))
      (SpecializedExpr.Match _ _ _ scrutinee branches)
        (let-do [current (min-local-in-expr (Box.peek scrutinee) m)]
          (for [i 0 (Array.length branches)]
            (let-do [branch (Array.unsafe-nth branches i)]
              (set! current
                    (min-local-in-pattern (SpecializedMatchBranch.pattern branch)
                                          current))
              (let [bindings (SpecializedMatchBranch.bindings branch)]
                (for [j 0 (Array.length bindings)]
                  (set! current
                        (Int.min current
                                 @(CoreRef.id (Array.unsafe-nth bindings j))))))
              (set! current
                    (min-local-in-expr
                      (Box.peek (SpecializedMatchBranch.body branch))
                      current))))
          current)
      (SpecializedExpr.Annotation _ _ inner _)
        (min-local-in-expr (Box.peek inner) m)
      (SpecializedExpr.ArrayLit _ _ es) (min-local-in-exprs es m)
      (SpecializedExpr.StaticArrayLit _ _ es) (min-local-in-exprs es m)
      _ m))

  (doc max-global-id "the highest global reference id among the module's
specialized instances. Backend passes that mint fresh globals (lifted
lambdas) allocate above this watermark.")
  (defn max-global-id [specialized]
    (let-do [m -1
             instances (SpecializationModule.instances specialized)]
      (for [i 0 (Array.length instances)]
        (let [id @(CoreRef.id
                (Specialization.reference (Array.unsafe-nth instances i)))]
          (when (Int.> id m) (set! m id))))
      m))

  (doc min-local-id "the lowest local binder id anywhere in the specialized
module (bodies and roots), clamped below the resolver's local range start.
Passes that synthesize local temporaries (backend cleanup/echo temps, ref
lifting) allocate downward from one below this watermark instead of from
hardcoded ranges.")
  (defn min-local-id [specialized]
    (let-do [m -1048576
             bodies (SpecializationModule.bodies specialized)
             roots (SpecializationModule.roots specialized)]
      (for [i 0 (Array.length bodies)]
        (let-do [body (Array.unsafe-nth bodies i)]
          (let [parameters (SpecializedBody.parameters body)]
            (for [j 0 (Array.length parameters)]
              (set! m (Int.min m @(CoreRef.id (Array.unsafe-nth parameters j))))))
          (set! m (min-local-in-expr (Box.peek (SpecializedBody.body body)) m))))
      (for [i 0 (Array.length roots)]
        (set! m (min-local-in-expr (Box.peek (Array.unsafe-nth roots i)) m)))
      m))

  (defn specialized-call-maybe [calls expression-id]
    (let-do [result (the (Maybe SpecializedCall) (Maybe.Nothing))
             n (Array.length calls)]
      (for [i 0 n]
        (let [call (Array.unsafe-nth calls i)]
          (when (Int.= @(SpecializedCall.id call) expression-id)
            (set! result (Maybe.Just @call)))))
      result))

  (defn same-owner? [left right]
    (match-ref left
      (Maybe.Just left-owner)
        (match-ref right
          (Maybe.Just right-owner) (CoreIR.same-ref? left-owner right-owner)
          (Maybe.Nothing) false)
      (Maybe.Nothing)
        (match-ref right (Maybe.Just _) false (Maybe.Nothing) true)))

  (private expression-type-missing)
  (hidden expression-type-missing)
  (defn expression-type-missing [owner expression-id]
    (Result.Error
      (SpecializeError.init
        (String.concat
          &[@"specialized expression has no inferred type (expr "
            (Int.str expression-id)
            @" in "
            (match-ref owner
              (Maybe.Just owner-ref) (String.copy (CoreRef.name owner-ref))
              (Maybe.Nothing) @"<root>")
            @")"]))))

  (private expression-type-for-linear)
  (hidden expression-type-for-linear)
  (defn expression-type-for-linear [state
                                    inferred
                                    owner
                                    expression-id
                                    instance-substitution]
    (let-do [result (the (Maybe MonoType) (Maybe.Nothing))
             node-types (InferredModule.node-types inferred)
             n (Array.length node-types)]
      (for [i 0 n]
        (let [node-type (Array.unsafe-nth node-types i)]
          (when (Int.= @(InferredNodeType.id node-type) expression-id)
            (when (same-owner? (InferredNodeType.owner node-type) owner)
              (let [normalized (apply-module-substitution state

                                                          (Box.peek (InferredNodeType.type node-type)))] (set! result
                                                                                                               (Maybe.Just
                                                                                                                 (Type.apply instance-substitution
                                                                                                                             &normalized))))))))
      (match result
        (Maybe.Just found) (Result.Success found)
        (Maybe.Nothing) (expression-type-missing owner expression-id))))

  (private owner-trace-key)
  (hidden owner-trace-key)
  (defn owner-trace-key [owner]
    (match-ref owner
      (Maybe.Just reference) @(CoreRef.id reference)
      (Maybe.Nothing) -1000000001))

  (private prime-trace-owner!)
  (hidden prime-trace-owner!)
  (doc prime-trace-owner! "rebuilds the expr-id→trace-position index for one
owner; runs when materialization switches owners (once per instance), so the
per-expression trace scan becomes an array lookup.")
  (defn prime-trace-owner! [context state inferred owner]
    (let-do [node-types (InferredModule.node-types inferred)
             key (owner-trace-key owner)
             buckets (SpecializeContext.owner-buckets context)
             range (PositionBuckets.range buckets &key)
             from @(Pair.a &range)
             to @(Pair.b &range)
             items (PositionBuckets.items buckets)]
      ;; the bucket is keyed by the owner's reference id, which `same-owner?`
      ;; also compares its name and globalness for, so the strict test still
      ;; runs — over the handful of entries this owner has, rather than over
      ;; every node type in the module.
      (let-do [max-id 0]
        (for [b from to]
          (let [node-type (Array.unsafe-nth node-types
                                            @(Array.unsafe-nth items b))]
            (when (same-owner? (InferredNodeType.owner node-type) owner)
              (when (Int.> @(InferredNodeType.id node-type) max-id)
                (set! max-id @(InferredNodeType.id node-type))))))
        (let-do [positions (Array.replicate (Int.inc max-id) &-1)]
          (for [b from to]
            (let-do [i @(Array.unsafe-nth items b)
                     node-type (Array.unsafe-nth node-types i)]
              (when (same-owner? (InferredNodeType.owner node-type) owner)
                (let [id @(InferredNodeType.id node-type)]
                  (when (Int.>= id 0) (Array.aset! &positions id i))))))
          (SpecializeWork.set-trace-positions! state positions)
          (SpecializeWork.set-trace-owner-key! state (owner-trace-key owner))))))

  (defn expression-type-for [context
                             state
                             inferred
                             owner
                             expression-id
                             instance-substitution]
    (do
      (when (Int.= 0 (Array.length (SpecializeWork.normalized-node-types state)))
        (SpecializeWork.set-normalized-node-types! state
                                                   (Array.replicate
                                                     (Array.length (InferredModule.node-types inferred))
                                                     &(the (Maybe (Box MonoType))
                                                           (Maybe.Nothing)))))
      (unless (Int.= (owner-trace-key owner)
                     @(SpecializeWork.trace-owner-key state))
        (prime-trace-owner! context state inferred owner))
      (if (or (Int.< expression-id 0)
              (Int.>= expression-id
                      (Array.length (SpecializeWork.trace-positions state))))
        (expression-type-missing owner expression-id)
        (let [at @(Array.unsafe-nth (SpecializeWork.trace-positions state)
                                    expression-id)]
          (if (or (Int.< at 0)
                  (Int.>= at
                          (Array.length
                            (SpecializeWork.normalized-node-types state))))
            (expression-type-missing owner expression-id)
            (let [node-type (Array.unsafe-nth (InferredModule.node-types inferred)
                                              at)]
              (if (and
                  (Int.= @(InferredNodeType.id node-type) expression-id)
                  (same-owner? (InferredNodeType.owner node-type) owner))
                (do
                  (when (match-ref (Array.unsafe-nth
                        (SpecializeWork.normalized-node-types state)
                        at)
                      (Maybe.Nothing) true
                      (Maybe.Just _) false)
                    (Array.aset!
                      (SpecializeWork.normalized-node-types state)
                      at
                      (Maybe.Just (Box.init (apply-module-substitution state

                                                                       (Box.peek (InferredNodeType.type node-type)))))))
                  (match-ref (Array.unsafe-nth
                      (SpecializeWork.normalized-node-types state)
                      at)
                    (Maybe.Just normalized)
                      (Result.Success
                        (Type.apply instance-substitution (Box.peek normalized)))
                    (Maybe.Nothing)
                      (expression-type-missing owner expression-id)))
                (expression-type-for-linear state
                                            inferred
                                            owner
                                            expression-id
                                            instance-substitution))))))))

  (defn rewrite-expressions [context
                             state
                             expressions
                             calls
                             inferred
                             owner
                             instance-substitution]
    (let-do [result (the
               (Result (Array (Box SpecializedExpr)) SpecializeError)
               (Result.Success []))
             n (Array.length expressions)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success rewritten)
            (match (rewrite-expression context
                                       state
                                       (Box.peek (Array.unsafe-nth expressions i))
                                       calls
                                       inferred
                                       owner
                                       instance-substitution)
              (Result.Success expression)
                (Array.push-back! rewritten (Box.init expression))
              (Result.Error error) (set! result (Result.Error error)))
          (Result.Error _) ()))
      result))

  (defn rewrite-branches [context
                          state
                          branches
                          calls
                          inferred
                          owner
                          instance-substitution]
    (let-do [result (the
               (Result (Array SpecializedMatchBranch) SpecializeError)
               (Result.Success []))
             n (Array.length branches)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success rewritten)
            (let [branch (Array.unsafe-nth branches i)]
              (match (rewrite-expression context
                                         state
                                         (Box.peek (CoreMatchBranch.body branch))
                                         calls
                                         inferred
                                         owner
                                         instance-substitution)
                (Result.Success body)
                  (Array.push-back! rewritten
                                    (SpecializedMatchBranch.init @(CoreMatchBranch.pattern branch)
                                                                 @(CoreMatchBranch.bindings branch)
                                                                 (Box.init body)))
                (Result.Error error) (set! result (Result.Error error))))
          (Result.Error _) ()))
      result))

  (defn rewrite-expression [context
                            state
                            expression
                            calls
                            inferred
                            owner
                            instance-substitution]
    (let [expression-id (CoreIR.expression-id expression)]
      (match (expression-type-for context
                                  state
                                  inferred
                                  owner
                                  expression-id
                                  instance-substitution)
        (Result.Success node-type)
          (match-ref expression
            (CoreExpr.IntLit _ value)
              (Result.Success
                (SpecializedExpr.IntLit expression-id
                                        (Box.init node-type)
                                        @value))
            (CoreExpr.ByteLit _ value)
              (Result.Success
                (SpecializedExpr.ByteLit expression-id
                                         (Box.init node-type)
                                         @value))
            (CoreExpr.LongLit _ value)
              (Result.Success
                (SpecializedExpr.LongLit expression-id
                                         (Box.init node-type)
                                         @value))
            (CoreExpr.FloatLit _ value)
              (Result.Success
                (SpecializedExpr.FloatLit expression-id
                                          (Box.init node-type)
                                          @value))
            (CoreExpr.DoubleLit _ value)
              (Result.Success
                (SpecializedExpr.DoubleLit expression-id
                                           (Box.init node-type)
                                           @value))
            (CoreExpr.CharLit _ value)
              (Result.Success
                (SpecializedExpr.CharLit expression-id
                                         (Box.init node-type)
                                         @value))
            (CoreExpr.StringLit _ value)
              (Result.Success
                (SpecializedExpr.StringLit expression-id
                                           (Box.init node-type)
                                           (String.copy value)))
            (CoreExpr.PatternLit _ value)
              (Result.Success
                (SpecializedExpr.PatternLit expression-id
                                            (Box.init node-type)
                                            (String.copy value)))
            (CoreExpr.BoolLit _ value)
              (Result.Success
                (SpecializedExpr.BoolLit expression-id
                                         (Box.init node-type)
                                         @value))
            (CoreExpr.UnitLit _)
              (Result.Success
                (SpecializedExpr.UnitLit expression-id (Box.init node-type)))
            (CoreExpr.ArrayLit _ expressions)
              (match (rewrite-expressions context
                                          state
                                          expressions
                                          calls
                                          inferred
                                          owner
                                          instance-substitution)
                (Result.Success rewritten)
                  (Result.Success
                    (SpecializedExpr.ArrayLit expression-id
                                              (Box.init node-type)
                                              rewritten))
                (Result.Error error) (Result.Error error))
            (CoreExpr.StaticArrayLit _ expressions)
              (match (rewrite-expressions context
                                          state
                                          expressions
                                          calls
                                          inferred
                                          owner
                                          instance-substitution)
                (Result.Success rewritten)
                  (Result.Success
                    (SpecializedExpr.StaticArrayLit expression-id
                                                    (Box.init node-type)
                                                    rewritten))
                (Result.Error error) (Result.Error error))
            (CoreExpr.Reference _ reference)
              (if @(CoreRef.global reference)
                (match (specialized-call-maybe calls expression-id)
                  (Maybe.Just target)
                    (Result.Success
                      (SpecializedExpr.GlobalValue expression-id
                                                   (Box.init node-type)
                                                   @(SpecializedCall.reference &target)
                                                   @(SpecializedCall.signature &target)
                                                   @(SpecializedCall.symbol &target)
                                                   @(SpecializedCall.value &target)))
                  (Maybe.Nothing)
                    (Result.Success
                      (SpecializedExpr.Reference expression-id
                                                 (Box.init node-type)
                                                 (CoreRef.copy reference))))
                (Result.Success
                  (SpecializedExpr.Reference expression-id
                                             (Box.init node-type)
                                             (CoreRef.copy reference))))
            (CoreExpr.Call call-id callee arguments)
              (match (rewrite-expression context
                                         state
                                         (Box.peek callee)
                                         calls
                                         inferred
                                         owner
                                         instance-substitution)
                (Result.Success rewritten-callee)
                  (match (rewrite-expressions context
                                              state
                                              arguments
                                              calls
                                              inferred
                                              owner
                                              instance-substitution)
                    (Result.Success rewritten-arguments)
                      (match-ref (Box.peek callee)
                        (CoreExpr.Reference _ reference)
                          (if @(CoreRef.global reference)
                            (match (specialized-call-for calls @call-id)
                              (Result.Success target)
                              ;; a call through a function-typed `def` global is a
                              ;; closure invocation of the stored Lambda, not a
                              ;; direct C call (the reference stores it in a global
                              ;; and dispatches through the callback pointer).
                              (if @(SpecializedCall.value &target)
                                (Result.Success
                                  (SpecializedExpr.Call expression-id
                                                        (Box.init node-type)
                                                        (Box.init
                                                          (SpecializedExpr.GlobalValue (CoreIR.expression-id (Box.peek callee))
                                                                                       @(SpecializedCall.signature &target)
                                                                                       @(SpecializedCall.reference &target)
                                                                                       @(SpecializedCall.signature &target)
                                                                                       @(SpecializedCall.symbol &target)
                                                                                       true))
                                                        rewritten-arguments))
                                (Result.Success
                                  (SpecializedExpr.GlobalCall expression-id
                                                              (Box.init node-type)
                                                              @(SpecializedCall.reference &target)
                                                              @(SpecializedCall.signature &target)
                                                              @(SpecializedCall.symbol &target)
                                                              rewritten-arguments)))
                              (Result.Error _)
                              (let [callee-type-name (match (expression-type-for context
                                                                                 state
                                                                                 inferred
                                                                                 owner
                                                                                 (CoreIR.expression-id (Box.peek callee))
                                                                                 instance-substitution)
                                      (Result.Success callee-type)
                                        (Type.render &callee-type)
                                      (Result.Error _) @"<unknown>")
                                    owner-name (match-ref owner
                                      (Maybe.Just owner-reference)
                                        (String.copy (CoreRef.name owner-reference))
                                      (Maybe.Nothing) @"<root>")]
                                (Result.Error
                                  (SpecializeError.init
                                    (String.concat
                                      &[@"specialized body contains an untyped global call to "
                                        (String.copy (CoreRef.name reference))
                                        @" in "
                                        owner-name
                                        @" (expr "
                                        (Int.str expression-id)
                                        @", callee expr "
                                        (Int.str (CoreIR.expression-id (Box.peek callee)))
                                        @") with callee "
                                        callee-type-name
                                        @" and result "
                                        (Type.render &node-type)
                                        @"; argument types: "
                                        (String.join ", "
                                                     &(Array.copy-map
                                                       &(fn [argument]
                                                         (Type.render
                                                           &(Specialize.expression-type (Box.peek argument))))
                                                       &rewritten-arguments))])))))
                            (Result.Success
                              (SpecializedExpr.Call expression-id
                                                    (Box.init node-type)
                                                    (Box.init rewritten-callee)
                                                    rewritten-arguments)))
                        _
                          (Result.Success
                            (SpecializedExpr.Call expression-id
                                                  (Box.init node-type)
                                                  (Box.init rewritten-callee)
                                                  rewritten-arguments)))
                    (Result.Error error) (Result.Error error))
                (Result.Error error) (Result.Error error))
            (CoreExpr.Do _ expressions)
              (match (rewrite-expressions context
                                          state
                                          expressions
                                          calls
                                          inferred
                                          owner
                                          instance-substitution)
                (Result.Success rewritten)
                  (Result.Success
                    (SpecializedExpr.Do expression-id
                                        (Box.init node-type)
                                        rewritten))
                (Result.Error error) (Result.Error error))
            (CoreExpr.If _ condition then-branch else-branch)
              (match (rewrite-expression context
                                         state
                                         (Box.peek condition)
                                         calls
                                         inferred
                                         owner
                                         instance-substitution)
                (Result.Success rewritten-condition)
                  (match (rewrite-expression context
                                             state
                                             (Box.peek then-branch)
                                             calls
                                             inferred
                                             owner
                                             instance-substitution)
                    (Result.Success rewritten-then)
                      (match (rewrite-expression context
                                                 state
                                                 (Box.peek else-branch)
                                                 calls
                                                 inferred
                                                 owner
                                                 instance-substitution)
                        (Result.Success rewritten-else)
                          (Result.Success
                            (SpecializedExpr.If expression-id
                                                (Box.init node-type)
                                                (Box.init rewritten-condition)
                                                (Box.init rewritten-then)
                                                (Box.init rewritten-else)))
                        (Result.Error error) (Result.Error error))
                    (Result.Error error) (Result.Error error))
                (Result.Error error) (Result.Error error))
            (CoreExpr.Let _ reference value body)
              (match (rewrite-expression context
                                         state
                                         (Box.peek value)
                                         calls
                                         inferred
                                         owner
                                         instance-substitution)
                (Result.Success rewritten-value)
                  (match (rewrite-expression context
                                             state
                                             (Box.peek body)
                                             calls
                                             inferred
                                             owner
                                             instance-substitution)
                    (Result.Success rewritten-body)
                      (Result.Success
                        (SpecializedExpr.Let expression-id
                                             (Box.init node-type)
                                             (CoreRef.copy reference)
                                             (Box.init rewritten-value)
                                             (Box.init rewritten-body)))
                    (Result.Error error) (Result.Error error))
                (Result.Error error) (Result.Error error))
            (CoreExpr.Set _ reference value)
              (match (rewrite-expression context
                                         state
                                         (Box.peek value)
                                         calls
                                         inferred
                                         owner
                                         instance-substitution)
                (Result.Success rewritten)
                  (Result.Success
                    (SpecializedExpr.Set expression-id
                                         (Box.init node-type)
                                         (CoreRef.copy reference)
                                         (Box.init rewritten)))
                (Result.Error error) (Result.Error error))
            (CoreExpr.While _ condition body)
              (match (rewrite-expression context
                                         state
                                         (Box.peek condition)
                                         calls
                                         inferred
                                         owner
                                         instance-substitution)
                (Result.Success rewritten-condition)
                  (match (rewrite-expression context
                                             state
                                             (Box.peek body)
                                             calls
                                             inferred
                                             owner
                                             instance-substitution)
                    (Result.Success rewritten-body)
                      (Result.Success
                        (SpecializedExpr.While expression-id
                                               (Box.init node-type)
                                               (Box.init rewritten-condition)
                                               (Box.init rewritten-body)))
                    (Result.Error error) (Result.Error error))
                (Result.Error error) (Result.Error error))
            (CoreExpr.Break _)
              (Result.Success
                (SpecializedExpr.Break expression-id (Box.init node-type)))
            (CoreExpr.Lambda _ parameters body)
              (match (rewrite-expression context
                                         state
                                         (Box.peek body)
                                         calls
                                         inferred
                                         owner
                                         instance-substitution)
                (Result.Success rewritten)
                  (Result.Success
                    (SpecializedExpr.Lambda expression-id
                                            (Box.init node-type)
                                            (Array.copy parameters)
                                            (Box.init rewritten)))
                (Result.Error error) (Result.Error error))
            (CoreExpr.Match _ by-reference scrutinee branches)
              (match (rewrite-expression context
                                         state
                                         (Box.peek scrutinee)
                                         calls
                                         inferred
                                         owner
                                         instance-substitution)
                (Result.Success rewritten-scrutinee)
                  (match (rewrite-branches context
                                           state
                                           branches
                                           calls
                                           inferred
                                           owner
                                           instance-substitution)
                    (Result.Success rewritten-branches)
                      (Result.Success
                        (SpecializedExpr.Match expression-id
                                               (Box.init node-type)
                                               @by-reference
                                               (Box.init rewritten-scrutinee)
                                               rewritten-branches))
                    (Result.Error error) (Result.Error error))
                (Result.Error error) (Result.Error error))
            (CoreExpr.Annotation _ inner annotation)
              (match (rewrite-expression context
                                         state
                                         (Box.peek inner)
                                         calls
                                         inferred
                                         owner
                                         instance-substitution)
                (Result.Success rewritten)
                  (Result.Success
                    (SpecializedExpr.Annotation expression-id
                                                (Box.init node-type)
                                                (Box.init rewritten)
                                                (Box.init (CoreType.copy (Box.peek annotation)))))
                (Result.Error error) (Result.Error error)))
        (Result.Error error) (Result.Error error))))

  (defn rewrite-body [context state body calls inferred owner signature]
    (match (scheme-for context (InferredModule.environment inferred) owner)
      (Maybe.Just scheme)
        (let [empty (Type.empty-substitution)]
          (match (Type.unify-strict (Box.peek (TypeScheme.body &scheme))
                                    signature
                                    &empty)
            (Result.Success instance-substitution)
              (rewrite-expression context
                                  state
                                  body
                                  calls
                                  inferred
                                  &(Maybe.Just (CoreRef.copy owner))
                                  &instance-substitution)
            (Result.Error error)
              (Result.Error
                (declaration-error &error
                                   (Box.peek (TypeScheme.body &scheme))
                                   signature))))
      (Maybe.Nothing)
        (Result.Error
          (SpecializeError.init @"missing scheme for specialized body"))))

  (private materialize-output-from)
  (hidden materialize-output-from)
  (defn materialize-output-from [context
                                 state
                                 core
                                 inferred
                                 instances
                                 first
                                 dependencies]
    ;; Accumulate payload arrays directly. Rebuilding a SpecializationModule
    ;; through a borrowed Result on every iteration copies all earlier bodies.
    (let-do [bodies (the (Array SpecializedBody) [])
             primitives (the (Array SpecializedPrimitive) [])
             failure (the (Maybe SpecializeError) (Maybe.Nothing))
             functions (CoreModule.functions core)
             values (CoreModule.values core)
             builtins (CoreModule.builtins core)
             n (Array.length instances)]
      (for [i first n]
        (match-ref &failure
          (Maybe.Nothing)
            (let [instance (Array.unsafe-nth instances i)
                  reference (Specialization.reference instance)
                  signature (Box.peek (Specialization.signature instance))]
              (match (function-for functions reference)
                (Maybe.Just function)
                  (match (materialize-calls context
                                            state
                                            core
                                            inferred
                                            instances
                                            (Array.unsafe-nth dependencies
                                                              (Int.- i first)))
                    (Result.Success calls)
                      (match (rewrite-body context
                                           state
                                           (Box.peek (CoreFunction.body &function))
                                           &calls
                                           inferred
                                           reference
                                           signature)
                        (Result.Success body)
                          (Array.push-back! &bodies
                                            (SpecializedBody.init @instance
                                                                  @(CoreFunction.parameters &function)
                                                                  (Box.init body)
                                                                  false))
                        (Result.Error error) (set! failure (Maybe.Just error)))
                    (Result.Error error) (set! failure (Maybe.Just error)))
                (Maybe.Nothing)
                  (match (value-for values reference)
                    (Maybe.Just value)
                      (match (materialize-calls context
                                                state
                                                core
                                                inferred
                                                instances
                                                (Array.unsafe-nth dependencies
                                                                  (Int.- i first)))
                        (Result.Success calls)
                          (match (rewrite-body context
                                               state
                                               (Box.peek (CoreValue.body &value))
                                               &calls
                                               inferred
                                               reference
                                               signature)
                            (Result.Success body)
                              (Array.push-back! &bodies
                                                (SpecializedBody.init @instance
                                                                      []
                                                                      (Box.init body)
                                                                      true))
                            (Result.Error error)
                              (set! failure (Maybe.Just error)))
                        (Result.Error error) (set! failure (Maybe.Just error)))
                    (Maybe.Nothing)
                      (when (has-builtin? builtins reference)
                        (let [lowering (match (PrimitiveRegistry.lowering-for reference)
                                (Maybe.Just found) found
                                (Maybe.Nothing) (PrimitiveLowering.Intrinsic))]
                          (match (materialize-calls context
                                                    state
                                                    core
                                                    inferred
                                                    instances
                                                    (Array.unsafe-nth dependencies
                                                                      (Int.- i
                                                                             first)))
                            (Result.Success calls)
                              (Array.push-back! &primitives
                                                (SpecializedPrimitive.init @instance
                                                                           lowering
                                                                           calls
                                                                           (builtin-source-for core
                                                                                               reference)))
                            (Result.Error error)
                              (set! failure (Maybe.Just error))))))))
          (Maybe.Just _) ()))
      (match failure
        (Maybe.Nothing)
          (match (materialize-root-calls context state core inferred instances)
            (Result.Success calls)
              (let [empty (Type.empty-substitution)
                    owner (the (Maybe CoreRef) (Maybe.Nothing))]
                (match (rewrite-expressions context
                                            state
                                            (CoreModule.expressions core)
                                            &calls
                                            inferred
                                            &owner
                                            &empty)
                  (Result.Success roots)
                    (Result.Success
                      (SpecializationModule.init (Array.copy instances)
                                                 bodies
                                                 primitives
                                                 roots
                                                 @(CoreModule.constructors core)
                                                 @(CoreModule.system-includes core)
                                                 @(CoreModule.type-declarations core)))
                  (Result.Error error) (Result.Error error)))
            (Result.Error error) (Result.Error error))
        (Maybe.Just error) (Result.Error error))))

  (doc delete-request "builds a specialization request that demands the concrete
`delete` implementation for `type`, routed through the same interface selection
as ordinary calls. Used by the driver to close a specialized module over the
deleters its ownership plan requires.")
  (defn delete-request [type]
    (SpecializationRequest.init
      (CallSite.init -1
                     (PrimitiveRegistry.delete-reference)
                     (Box.init
                       (MonoType.Function [(Box.init (MonoType.copy type))]
                                          (Box.init (MonoType.Unit))))
                     (Maybe.Nothing))
      (String.copy "ownership delete")))

  (doc copy-request "builds a specialization request that demands the concrete
`copy` implementation for `type`, the way `delete-request` demands a deleter.
Used by the driver to close a module over the copiers a capturing closure
needs: its environment owns what it captured, so the construction site copies
it in.")
  (defn copy-request [type]
    (SpecializationRequest.init
      (CallSite.init -1
                     (PrimitiveRegistry.reference 0 "copy")
                     (Box.init
                       (MonoType.Function
                         [(Box.init
                            (MonoType.Reference (Box.init (MonoType.copy type))
                                                (MonoLifetime.Static)))]
                         (Box.init (MonoType.copy type))))
                     (Maybe.Nothing))
      (String.copy "closure capture copy"))))

(defmodule SpecializationDemands
  (doc create "starts empty managed-demand streams for one ownership closure.")
  (defn create [] (SpecializationDemands.init (Set.create) (Set.create) [] []))

  (doc count "the number of distinct copier and deleter demands.")
  (defn count [demands]
    (Int.+
      (Array.length (SpecializationDemands.deletes demands))
      (Array.length (SpecializationDemands.copies demands))))

  (private require!)
  (hidden require!)
  (defn require! [keys requests type copier]
    (let [key (CAbi.type-key type)]
      (unless-do (Set.contains? keys &key)
        (Set.put! keys &key)
        (Array.push-back! requests
                          (if copier
                            (Specialize.copy-request type)
                            (Specialize.delete-request type))))))

  (doc require-delete! "adds a deleter demand only when its ABI key is new.")
  (defn require-delete! [demands type]
    (require!
      (SpecializationDemands.delete-keys demands)
      (SpecializationDemands.deletes demands)
      type
      false))

  (doc require-copy! "adds a copier demand independently of deleter demands.")
  (defn require-copy! [demands type]
    (require!
      (SpecializationDemands.copy-keys demands)
      (SpecializationDemands.copies demands)
      type
      true)))

(defmodule Specialize
  (private name-in?)
  (hidden name-in?)
  (defn name-in? [names name]
    (let-do [found false
             n (Array.length names)]
      (for [i 0 n]
        (when (String.= (Array.unsafe-nth names i) name) (set! found true)))
      found))

  (doc named-requests-in
    "builds a specialization demand for every function whose
qualified name appears in `names` and whose inferred scheme is concrete. The
driver seeds these for definitions in the compiled file itself, so they are
ownership- and borrow-checked even when nothing calls them, the way the
reference compiler checks every definition.")
  (private named-request-for!)
  (hidden named-request-for!)
  (defn named-request-for! [context inferred reference names result]
    (when (name-in? names (CoreRef.name reference))
      (match (scheme-for context (InferredModule.environment inferred) reference)
        (Maybe.Just scheme)
          (let [signature (Type.apply (InferredModule.substitution inferred)
                                      (Box.peek (TypeScheme.body &scheme)))]
            (when (concrete-signature? &signature)
              (Array.push-back! result
                                (SpecializationRequest.init
                                  (CallSite.init -1
                                                 (CoreRef.copy reference)
                                                 (Box.init signature)
                                                 (Maybe.Nothing))
                                  (String.copy "<definition>")))))
        (Maybe.Nothing) ())))

  (defn named-requests-in [context core inferred names]
    (let-do [result (the (Array SpecializationRequest) [])
             functions (CoreModule.functions core)
             builtins (CoreModule.builtins core)
             n (Array.length functions)
             m (Array.length builtins)]
      (for [i 0 n]
        (named-request-for! context
                            inferred
                            (CoreFunction.reference (Array.unsafe-nth functions
                                                                      i))
                            names
                            &result))
      ;; registered builtins (e.g. `IO.println`) are demandable by name too —
      ;; the echo plan needs their specialized symbol.
      (for [i 0 m]
        (named-request-for! context
                            inferred
                            (CoreBuiltin.reference (Array.unsafe-nth builtins i))
                            names
                            &result))
      result))

  (doc echo-request-in "builds the specialization demand for rendering a
top-level result of `type` through the `str` interface, the way the reference
echoes top-level expression results into `main`. Derived strs take their
argument by reference, scalar strs by value, so the by-reference form is
probed first. Returns the request paired with by-ref?, or Nothing when no str
implementation exists for the type.")
  (defn echo-request-in [context state core inferred type]
    (let [by-ref (CallSite.init -1
                                (PrimitiveRegistry.str-reference)
                                (Box.init
                                  (MonoType.Function
                                    [(Box.init
                                       (MonoType.Reference (Box.init (MonoType.copy type))
                                                           (MonoLifetime.Static)))]
                                    (Box.init (MonoType.String))))
                                (Maybe.Nothing))]
      (match (implementation-for context state core inferred &by-ref)
        (Result.Success _)
          (Maybe.Just
            (Pair.init
              (SpecializationRequest.init by-ref (String.copy "<echo>"))
              true))
        (Result.Error _)
          (let [by-value (CallSite.init -1
                                        (PrimitiveRegistry.str-reference)
                                        (Box.init
                                          (MonoType.Function [(Box.init (MonoType.copy type))]
                                                             (Box.init (MonoType.String))))
                                        (Maybe.Nothing))]
            (match (implementation-for context state core inferred &by-value)
              (Result.Success _)
                (Maybe.Just
                  (Pair.init
                    (SpecializationRequest.init by-value (String.copy "<echo>"))
                    false))
              (Result.Error _)
                (the (Maybe (Pair SpecializationRequest Bool)) (Maybe.Nothing)))))))

  (private append-requests!)
  (hidden append-requests!)
  (defn append-requests! [queue requests]
    (for [i 0 (Array.length requests)]
      (Array.push-back! queue @(Array.unsafe-nth requests i))))

  (doc module-with-known-in "specializes the reachable program plus
deleter, copier and seed requests, seeded with concrete instances already
compiled by an incremental session. The returned module contains only newly discovered
definitions while its instance cache contains both old and new instances.")
  (defn module-with-known-in [context
                              state
                              core
                              inferred
                              deletes
                              copies
                              seeds
                              known]
    (let-do [_ignored-buckets (buckets-reset! state
                                              (CoreIR.max-declared-global-id core))
             instances (Array.copy known)
             first-new (Array.length &instances)
             ;; each new instance's dependencies, for materialization
             instance-dependencies (the (Array (Array CallSite)) [])
             failed false
             failure (String.copy "")
             functions (CoreModule.functions core)
             values (CoreModule.values core)
             builtins (CoreModule.builtins core)
             interfaces (CoreModule.interfaces core)
             ;; every request asks whether its callee has a definition
             defined (the (Array CoreRef) [])
             _ignored-defined (do
               (for [i 0 (Array.length functions)]
                 (Array.push-back! &defined
                                   @(CoreFunction.reference (Array.unsafe-nth functions
                                                                              i))))
               (for [i 0 (Array.length values)]
                 (Array.push-back! &defined
                                   @(CoreValue.reference (Array.unsafe-nth values
                                                                           i))))
               (for [i 0 (Array.length builtins)]
                 (Array.push-back! &defined
                                   @(CoreBuiltin.reference (Array.unsafe-nth builtins
                                                                             i)))))
             defined-positions (reference-positions &defined)
             queue-result (root-requests context state core inferred)
             queue (match-ref &queue-result
               (Result.Success found) (Array.copy found)
               (Result.Error _) [])
             cursor 0]
      (for [i 0 first-new]
        (let [reference (Specialization.reference (Array.unsafe-nth &instances i))]
          (buckets-note! state reference i)))
      (match-ref &queue-result
        (Result.Success _) ()
        (Result.Error error)
          (do
            (set! failed true)
            (set! failure (String.copy (SpecializeError.message error)))))
      (append-requests! &queue deletes)
      (append-requests! &queue copies)
      (append-requests! &queue seeds)
      (while-do (Int.< cursor (Array.length &queue))
        (unless-do failed
          (let [request (Array.unsafe-nth &queue cursor)
                origin (String.copy (SpecializationRequest.origin request))
                call (normalize-call state
                                     inferred
                                     (SpecializationRequest.call request))
                reference (CoreRef.copy (CallSite.reference &call))
                signature (MonoType.copy (Box.peek (CallSite.type &call)))]
            ;; interface dispatch runs before the concreteness gate: a call
            ;; whose free variables are pinned by the unique matching
            ;; implementation resolves through the dispatch substitution.
            (if (interface? interfaces &reference)
              (match (implementation-for context state core inferred &call)
                (Result.Success implementation)
                  (when (concrete-signature?
                      (Box.peek (CallSite.type &implementation)))
                    (Array.push-back! &queue
                                      (SpecializationRequest.init implementation
                                                                  (String.copy &origin))))
                (Result.Error error)
                  (when-do (concrete-signature? &signature)
                    (set! failed true)
                    (set! failure
                          (contextual-specialize-error &origin
                                                       (SpecializeError.message &error)))))
              (when (concrete-signature? &signature)
                (match (overload-for core &reference)
                  (Maybe.Just overload)
                    (match (candidate-for context inferred &call &overload)
                      (Result.Success candidate)
                        (Array.push-back! &queue
                                          (SpecializationRequest.init candidate
                                                                      (String.copy &origin)))
                      (Result.Error error)
                        (do
                          (set! failed true)
                          (set! failure
                                (contextual-specialize-error &origin
                                                             (SpecializeError.message &error)))))
                  (Maybe.Nothing)
                    (if (indexed-has? &defined-positions &defined &reference)
                      (unless-do (contains-instance? state
                                                     &instances
                                                     &reference
                                                     &signature)
                        (match (dependencies-for context
                                                 state
                                                 core
                                                 inferred
                                                 &reference
                                                 &signature)
                          (Result.Success dependencies)
                            (let-do [symbol (symbol-for context
                                                        core
                                                        &reference
                                                        &signature)]
                              (Array.push-back! &instances
                                                (Specialization.init (CoreRef.copy &reference)
                                                                     (Box.init (MonoType.copy &signature))
                                                                     symbol))
                              (buckets-note! state
                                             &reference
                                             (Int.dec (Array.length &instances)))
                              (let [n (Array.length &dependencies)]
                                (for [i 0 n]
                                  (Array.push-back! &queue
                                                    (SpecializationRequest.init @(Array.unsafe-nth &dependencies
                                                                                                   i)
                                                                                (String.concat
                                                                                  &[(String.copy (CoreRef.name &reference))
                                                                                    @" at "
                                                                                    (Type.render &signature)])))))
                              (Array.push-back! &instance-dependencies
                                                dependencies))
                          (Result.Error error)
                            (do
                              (set! failed true)
                              (set! failure
                                    (contextual-specialize-error &origin
                                                                 (SpecializeError.message &error))))))

                      (do
                        (set! failed true)
                        (set! failure
                              (contextual-specialize-error &origin
                                                           "call has no function or builtin definition")))))))))
        (set! cursor (Int.inc cursor)))
      (if failed
        (Result.Error (SpecializeError.init failure))
        (match (materialize-output-from context
                                        state
                                        core
                                        inferred
                                        &instances
                                        first-new
                                        &instance-dependencies)
          (Result.Success delta)
            (Result.Success (IncrementalSpecialization.init delta instances))
          (Result.Error error) (Result.Error error)))))

  (private array-filter-template-dependencies)
  (hidden array-filter-template-dependencies)
  (private array-set-template-dependencies)
  (hidden array-set-template-dependencies)
  (private echo-request-in)
  (hidden echo-request-in)

  (private module-with-known-in)
  (hidden module-with-known-in)
  (private named-requests-in)
  (hidden named-requests-in))

(defmodule Specialize
  (private implementation-buckets)
  (hidden implementation-buckets)
  (defn implementation-buckets [core]
    (let-do [items (CoreModule.implementations core)
             keys (the (Array Int) [])]
      (for [i 0 (Array.length items)]
        (Array.push-back! &keys
                          @(CoreRef.id
                            (CoreImplementation.interface (Array.unsafe-nth items
                                                                            i)))))
      (PositionBuckets.from-keys &keys)))

  (doc prepare
    "builds the reusable indexes for one unchanged Core/inference input and snapshots the current native naming policy. The context owns no materialized IR or per-pass type cache.")
  (defn prepare [core inferred]
    (SpecializeContext.init
      (scheme-index (InferredModule.environment inferred))

      (owner-buckets inferred)
      (call-buckets inferred)
      (implementation-buckets core)
      @&*specialization-symbol-salt*
      @&*specialization-symbol-references*
      @&*specialization-binding-versions*))

  (doc module-with-context
    "specializes against the context's unchanged Core/inference input. Every call owns and releases its worklist, normalized types and dispatch memo before returning; only compact indexes persist between rounds.")
  (defn module-with-context [context core inferred extra known]
    (let-do [state (work-for inferred)]
      (module-with-known-in context &state core inferred &[] &[] extra known)))

  (doc module-with-demands "specializes with borrowed managed-demand streams,
followed by seeds. Requests are copied once into the work queue; the accumulator
retains its keys and requests for the next closure round.")
  (defn module-with-demands [context core inferred demands seeds known]
    (let [state (work-for inferred)]
      (module-with-known-in context
                            &state
                            core
                            inferred
                            (SpecializationDemands.deletes demands)
                            (SpecializationDemands.copies demands)
                            seeds
                            known)))

  (doc named-requests-with-context
    "builds named demands using the invocation's scheme index, without allocating a trace memo.")
  (defn named-requests-with-context [context core inferred names]
    (if (Array.empty? names) [] (named-requests-in context core inferred names)))

  (doc echo-request-with-context
    "builds an echo demand using the invocation's scheme and implementation indexes, without allocating a trace memo.")
  (defn echo-request-with-context [context core inferred type]
    (let-do [state (work-for inferred)]
      (echo-request-in context &state core inferred type)))

  (doc module-with-known
    "specializes one invocation with the current naming defaults and a known concrete instance cache.")
  (defn module-with-known [core inferred extra known]
    (let-do [context (prepare core inferred)]
      (module-with-context &context core inferred extra known)))

  (doc named-requests
    "builds concrete named demands with an invocation-owned index.")
  (defn named-requests [core inferred names]
    (if (Array.empty? names)
      []
      (let-do [context (prepare core inferred)]
        (named-requests-with-context &context core inferred names))))

  (doc echo-request
    "builds an echo demand with invocation-owned indexes and temporary state.")
  (defn echo-request [core inferred type]
    (let-do [context (prepare core inferred)]
      (echo-request-with-context &context core inferred type)))

  (doc module-with
    "specializes reachable roots plus explicit demands, with invocation-owned caches.")
  (defn module-with [core inferred extra]
    (match (module-with-known core
                              inferred
                              extra
                              &(the (Array Specialization) []))
      (Result.Success (IncrementalSpecialization.init module _))
        (Result.Success module)
      (Result.Error error) (Result.Error error)))

  (doc module "specializes reachable roots with invocation-owned caches.")
  (defn module [core inferred]
    (module-with core inferred &(the (Array SpecializationRequest) []))))
