(defn overwrites-equal-interface-implementation? []
  (match (Surface.parse "(definterface add (Fn [a a] a))
(register int-add-a (Fn [Int Int] Int))
(register int-add-b (Fn [Int Int] Int))
(implements add int-add-a)
(implements add int-add-b)
(add 1 2)") (Result.Success surface)
      (match (Resolve.module &surface)
        (Result.Success core)
          (match (Infer.module &core)
            (Result.Success inferred)
              (match (Specialize.module &core &inferred)
                (Result.Success specialized)
                  (and
                    (instances-name? &specialized "int-add-b")
                    (not (instances-name? &specialized "int-add-a")))
                (Result.Error _) false)
            (Result.Error _) false)
        (Result.Error _) false) (Result.Error _) false))

