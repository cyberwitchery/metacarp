(load "../carp-specialize.carp")
(load "../../carp-resolve/carp-resolve.carp")
(Project.no-echo)
(load "Test.carp")

(use-all Test)

(defn specialized-identity-count [] (match (Surface.parse "(defn identity [x] x)
(identity 1)
(identity \"ok\")") (Result.Success surface)
      (match (Resolve.module &surface)
        (Result.Success core)
          (match (Infer.module &core)
            (Result.Success inferred)
              (match (Specialize.module &core &inferred)
                (Result.Success specialized)
                  (Array.length (SpecializationModule.instances &specialized))
                (Result.Error _) -1)
            (Result.Error _) -1)
        (Result.Error _) -1) (Result.Error _) -1))

(defn specialized-forward-count []
  (match (Surface.parse "(defn forward [x] (identity x))
(defn identity [x] x)
(forward 1)") (Result.Success surface)
      (match (Resolve.module &surface)
        (Result.Success core)
          (match (Infer.module &core)
            (Result.Success inferred)
              (match (Specialize.module &core &inferred)
                (Result.Success specialized)
                  (Array.length (SpecializationModule.instances &specialized))
                (Result.Error _) -1)
            (Result.Error _) -1)
        (Result.Error _) -1) (Result.Error _) -1))

(defn retains-specialized-roots? [] (match (Surface.parse "(defn identity [x] x)
(identity 1)") (Result.Success surface)
      (match (Resolve.module &surface)
        (Result.Success core)
          (match (Infer.module &core)
            (Result.Success inferred)
              (match (Specialize.module &core &inferred)
                (Result.Success specialized)
                  (let [roots (SpecializationModule.roots &specialized)]
                    (and (Int.= 1 (Array.length roots))
                         (match-ref (Box.peek (Array.unsafe-nth roots 0))
                           (SpecializedExpr.GlobalCall _
                                                       type
                                                       target
                                                       _
                                                       _
                                                       arguments)
                             (and (= (CoreRef.name target) "identity")
                                  (and
                                    (Type.same? (Box.peek type) &(Type.integer))
                                    (Int.= 1 (Array.length arguments))))
                           _ false)))
                (Result.Error _) false)
            (Result.Error _) false)
        (Result.Error _) false) (Result.Error _) false))

