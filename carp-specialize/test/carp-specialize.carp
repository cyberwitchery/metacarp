(load "../carp-specialize.carp")
(load "../../carp-resolve/carp-resolve.carp")
(Project.no-echo)
(load "Test.carp")

(use-all Test)

(defn specialized-identity-count [] (match (Surface.parse "(defn identity [x] x)
(identity 1)
(identity \"ok\")") (Result.Success surface)
      (match (Resolve.module &surface)
        (Result.Success core)
          (match (Infer.module &core)
            (Result.Success inferred)
              (match (Specialize.module &core &inferred)
                (Result.Success specialized)
                  (Array.length (SpecializationModule.instances &specialized))
                (Result.Error _) -1)
            (Result.Error _) -1)
        (Result.Error _) -1) (Result.Error _) -1))

(defn specialized-forward-count []
