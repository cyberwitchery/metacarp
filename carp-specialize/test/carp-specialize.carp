(defn materializes-forward-bodies? []
  (match (Surface.parse "(defn forward [x] (identity x))
(defn identity [x] x)
(forward 1)") (Result.Success surface)
      (match (Resolve.module &surface)
        (Result.Success core)
          (match (Infer.module &core)
            (Result.Success inferred)
              (match (Specialize.module &core &inferred)
                (Result.Success specialized)
                  (let [bodies (SpecializationModule.bodies &specialized)]
                    (and (Int.= 2 (Array.length bodies))
                         (let-do [found false
                                  n (Array.length bodies)]
                           (for [i 0 n]
                             (let [body (Array.unsafe-nth bodies i)]
                               (when (=
                                   (CoreRef.name
                                     (Specialization.reference (SpecializedBody.specialization body)))
                                   "forward")
                                 (set! found
                                       (match-ref (Box.peek (SpecializedBody.body body))
                                         (SpecializedExpr.GlobalCall _
                                                                     _
                                                                     target
                                                                     _
                                                                     _
                                                                     _)
                                           (= (CoreRef.name target) "identity")
                                         _ false)))))
                           found)))
                (Result.Error _) false)
            (Result.Error _) false)
        (Result.Error _) false) (Result.Error _) false))

(defn specializes-function-copy-by-arity? []
  (match (Surface.parse "(copy &(the (Fn [Int] Int) (fn [x] x)))")
    (Result.Success surface)
      (match (Resolve.module &surface)
        (Result.Success core)
          (match (Infer.module &core)
            (Result.Success inferred)
              (match (Specialize.module &core &inferred)
                (Result.Success specialized)
                  (let-do [found false
                           primitives (SpecializationModule.primitives &specialized)
                           n (Array.length primitives)]
                    (for [i 0 n]
                      (let [primitive (Array.unsafe-nth primitives i)]
                        (match-ref (SpecializedPrimitive.lowering primitive)
                          (PrimitiveLowering.ParameterizedTemplate template)
                            (match-ref template
                              (PrimitiveTemplate.FunctionCopy arity)
                                (when (Int.= 1 @arity) (set! found true))
                              _ ())
                          _ ())))
                    found)
                (Result.Error _) false)
            (Result.Error _) false)
        (Result.Error _) false)
    (Result.Error _) false))

(defn materializes-interface-calls? []
  (match (Surface.parse "(definterface add (Fn [a a] a))
(register int-add (Fn [Int Int] Int))
(implements add int-add)
(defn sum [x y] (add x y))
(sum 1 2)") (Result.Success surface)
      (match (Resolve.module &surface)
        (Result.Success core)
          (match (Infer.module &core)
            (Result.Success inferred)
              (match (Specialize.module &core &inferred)
                (Result.Success specialized)
                  (let-do [found false
                           bodies (SpecializationModule.bodies &specialized)
                           n (Array.length bodies)]
                    (for [i 0 n]
                      (let [body (Array.unsafe-nth bodies i)]
                        (when (=
                            (CoreRef.name
                              (Specialization.reference (SpecializedBody.specialization body)))
                            "sum")
                          (set! found
                                (match-ref (Box.peek (SpecializedBody.body body))
                                  (SpecializedExpr.GlobalCall _ _ target _ _ _)
                                    (= (CoreRef.name target) "int-add")
                                  _ false)))))
                    found)
                (Result.Error _) false)
            (Result.Error _) false)
        (Result.Error _) false) (Result.Error _) false))

(defn preserves-source-builtin-payloads? []
  (match (Surface.parse "(register inc (Fn [Int] Int) \"external_inc\")
(deftemplate pass (Fn [Int] Int) \"int $NAME(int x)\" \"$DECL { return x; }\")
(inc 1)
(pass 1)") (Result.Success surface)
      (match (Resolve.module &surface)
        (Result.Success core)
          (match (Infer.module &core)
            (Result.Success inferred)
              (match (Specialize.module &core &inferred)
                (Result.Success specialized)
                  (let-do [found-external false
                           found-template false
                           primitives (SpecializationModule.primitives &specialized)
                           n (Array.length primitives)]
                    (for [i 0 n]
                      (let [primitive (Array.unsafe-nth primitives i)
                            instance (SpecializedPrimitive.specialization primitive)]
                        (match-ref (SpecializedPrimitive.source primitive)
                          (Maybe.Just source)
                            (match-ref (SpecializedBuiltinSource.payload source)
                              (CoreBuiltinPayload.External external-name)
                                (match-ref external-name
                                  (Maybe.Just name)
                                    (when (and (= name "external_inc")
                                               (= (Specialization.symbol instance)
                                                  "external_inc"))
                                      (set! found-external true))
                                  (Maybe.Nothing) ())
                              (CoreBuiltinPayload.Template declaration body)
                                (when (and (= declaration "int $NAME(int x)")
                                           (and (= body "$DECL { return x; }")
                                                (= (Specialization.symbol instance)
                                                   "C4_pass__F1_1_IZ1_I")))
                                  (set! found-template true)))
                          (Maybe.Nothing) ())))
                    (and found-external found-template))
                (Result.Error _) false)
            (Result.Error _) false)
        (Result.Error _) false) (Result.Error _) false))

(defn materializes-typed-nested-calls? []
  (match (Surface.parse "(defn outer [x] x)
(defn inner [x] x)
(defn compose [x] (outer (inner x)))
(compose 1)") (Result.Success surface)
      (match (Resolve.module &surface)
        (Result.Success core)
          (match (Infer.module &core)
            (Result.Success inferred)
              (match (Specialize.module &core &inferred)
                (Result.Success specialized)
                  (let-do [found false
                           bodies (SpecializationModule.bodies &specialized)
                           n (Array.length bodies)]
                    (for [i 0 n]
                      (let [body (Array.unsafe-nth bodies i)]
                        (when (=
                            (CoreRef.name
                              (Specialization.reference (SpecializedBody.specialization body)))
                            "compose")
                          (set! found
                                (match-ref (Box.peek (SpecializedBody.body body))
                                  (SpecializedExpr.GlobalCall outer-id
                                                              outer-type
                                                              outer-target
                                                              _
                                                              _
                                                              arguments)
                                    (and (Int.= 0 @outer-id)
                                         (and
                                           (Type.same? (Box.peek outer-type)
                                                       &(Type.integer))
                                           (and (= (CoreRef.name outer-target)
                                                   "outer")
                                                (match-ref (Box.peek (Array.unsafe-nth arguments
                                                                                       0))
                                                  (SpecializedExpr.GlobalCall inner-id
                                                                              inner-type
                                                                              inner-target
                                                                              _
                                                                              _
                                                                              _)
                                                    (and (Int.= 2 @inner-id)
                                                         (and
                                                           (Type.same? (Box.peek inner-type)
                                                                       &(Type.integer))
                                                           (= (CoreRef.name inner-target)
                                                              "inner")))
                                                  _ false))))
                                  _ false)))))
                    found)
                (Result.Error _) false)
            (Result.Error _) false)
        (Result.Error _) false) (Result.Error _) false))

(defn preserves-lifetimes-without-respecializing? []
  (match (Surface.parse "(sig borrow-id (Fn [(Ref String a)] (Ref String a)))
(defn borrow-id [value] value)
(borrow-id \"first\")
(borrow-id \"second\")") (Result.Success surface)
      (match (Resolve.module &surface)
        (Result.Success core)
          (match (Infer.module &core)
            (Result.Success inferred)
              (match (Specialize.module &core &inferred)
                (Result.Success specialized)
                  (let [bodies (SpecializationModule.bodies &specialized)]
                    (and (Int.= 1 (Array.length bodies))
                         (let [signature (Specialization.signature
                                 (SpecializedBody.specialization (Array.unsafe-nth bodies
                                                                                   0)))]
                           (match-ref (Box.peek signature)
                             (MonoType.Function arguments result)
                               (match-ref (Box.peek (Array.unsafe-nth arguments
                                                                      0))
                                 (MonoType.Reference _ argument-lifetime)
                                   (match-ref (Box.peek result)
                                     (MonoType.Reference _ result-lifetime)
                                       (Type.same-lifetime? argument-lifetime
                                                            result-lifetime)
                                     _ false)
                                 _ false)
                             _ false))))
                (Result.Error _) false)
            (Result.Error _) false)
        (Result.Error _) false) (Result.Error _) false))

(defn instances-name? [module name]
  (let-do [found false
           instances (SpecializationModule.instances module)
           n (Array.length instances)]
    (for [i 0 n]
      (when (String.=
          (CoreRef.name
            (Specialization.reference (Array.unsafe-nth instances i)))
          name)
        (set! found true)))
    found))

(defn specializes-delete-on-demand? []
  (match (Surface.parse "(register-type Widget)
(register make-widget (Fn [] Widget) \"make_widget\")
(defmodule Widget (register delete (Fn [Widget] ()) \"widget_delete\"))
(implements delete Widget.delete)
(defn use-it [] (make-widget))
(use-it)") (Result.Success surface)
      (match (Resolve.module &surface)
        (Result.Success core)
          (match (Infer.module &core)
            (Result.Success inferred)
              (let [widget-t (MonoType.Named @"Widget" [])
                    extra [(Specialize.delete-request &widget-t)]]
                (match (Specialize.module &core &inferred)
                  (Result.Success base)
                    (match (Specialize.module-with &core &inferred &extra)
                      (Result.Success demanded)
                        (and
                          (not (instances-name? &base "Widget.delete"))
                          (instances-name? &demanded "Widget.delete"))
                      (Result.Error _) false)
                  (Result.Error _) false))
            (Result.Error _) false)
        (Result.Error _) false) (Result.Error _) false))

(defn forward-declaration-symbols-are-distinct? [declaration]
  (match (Surface.parse &(String.append declaration "
(defn identity [x] x)
(identity 1)
(identity true)")) (Result.Success surface)
      (match (Resolve.module &surface)
        (Result.Success core)
          (match (Infer.module &core)
            (Result.Success inferred)
              (match (Specialize.module &core &inferred)
                (Result.Success specialized)
                  (let-do [symbols (the (Array String) [])
                           instances (SpecializationModule.instances &specialized)
                           mangled true]
                    (for [i 0 (Array.length instances)]
                      (let [instance (Array.unsafe-nth instances i)]
                        (when-do (=
                            (CoreRef.name (Specialization.reference instance))
                            "identity")
                          (unless (= (Specialization.symbol instance)
                                     &(CAbi.mangle "identity"
                                                   (Box.peek (Specialization.signature instance))))
                            (set! mangled false))
                          (Array.push-back! &symbols
                                            @(Specialization.symbol instance)))))
                    (and mangled
                         (and (Int.= 2 (Array.length &symbols))
                              (/= (Array.unsafe-nth &symbols 0)
                                  (Array.unsafe-nth &symbols 1)))))
                (Result.Error _) false)
            (Result.Error _) false)
        (Result.Error _) false) (Result.Error _) false))

(defmodule Specialize
  (defn one-trace [type]
    (InferredModule.init []
                         []
                         []
                         [(InferredNodeType.init 0
                                                 (Maybe.Nothing)
                                                 (Box.init (MonoType.Variable 0)))]
                         []
                         (TypeSubstitution.init [(TypeBinding.init 0
                                                                   (Box.init @type))]
                                                []
                                                [])))
  (defn independent-type-queries? []
    (let-do [left (one-trace &(MonoType.Integer))
             right (one-trace &(MonoType.Boolean))
             core (CoreIR.empty-module)
             context (prepare &core &left)
             state (work-for &left)
             _query (Specialize.named-requests &core
                                               &right
                                               &(the (Array String) []))
             owner (the (Maybe CoreRef) (Maybe.Nothing))]
      (match (expression-type-for &context
                                  &state
                                  &left
                                  &owner
                                  0
                                  &(Type.empty-substitution))
        (Result.Success found) (Type.same? &found &(MonoType.Integer))
        (Result.Error _) false)))
  (defn cache-is-lazy? []
    (let-do [inferred (one-trace &(MonoType.Integer))
             core (CoreIR.empty-module)
             context (prepare &core &inferred)
             state (work-for &inferred)
             owner (the (Maybe CoreRef) (Maybe.Nothing))
             _named (named-requests-in &context &core &inferred &[@"missing"])
             no-slots (Array.empty?
               (SpecializeWork.normalized-node-types &state))
             _bad (expression-type-for &context
                                       &state
                                       &inferred
                                       &owner
                                       99
                                       &(Type.empty-substitution))
             no-boxes (Array.all?
               &(fn [slot]
                 (match-ref slot (Maybe.Nothing) true (Maybe.Just _) false))
               (SpecializeWork.normalized-node-types &state))
             answer (expression-type-for &context
                                         &state
                                         &inferred
                                         &owner
                                         0
                                         &(Type.empty-substitution))]
      (and no-slots (and no-boxes (Result.success? &answer)))))

  (defn contexts-survive-failure-and-interleaving? []
    (let-do [left (one-trace &(MonoType.Integer))
             right (one-trace &(MonoType.Boolean))
             core (CoreIR.empty-module)
             a (prepare &core &left)
             b (prepare &core &right)
             first (work-for &left)
             second (work-for &right)
             owner (the (Maybe CoreRef) (Maybe.Nothing))
             _left (expression-type-for &a
                                        &first
                                        &left
                                        &owner
                                        0
                                        &(Type.empty-substitution))
             rejected (expression-type-for &b
                                           &second
                                           &right
                                           &owner
                                           42
                                           &(Type.empty-substitution))
             _right (expression-type-for &b
                                         &second
                                         &right
                                         &owner
                                         0
                                         &(Type.empty-substitution))]
      (and (not (Result.success? &rejected))
           (match (expression-type-for &a
                                       &first
                                       &left
                                       &owner
                                       0
                                       &(Type.empty-substitution))
             (Result.Success result) (Type.same? &result &(MonoType.Integer))
             (Result.Error _) false))))
  (defn naming-policy-is-local? []
    (let-do [core (CoreIR.empty-module)
             inferred (one-trace &(MonoType.Integer))
             reference (CoreRef.init 7 @"identity" true)
             signature (Type.integer)
             _set (use-symbol-namespace! "left" &[@&reference])
             left (prepare &core &inferred)
             _clear (clear-symbol-namespace!)
             right (prepare &core &inferred)
             before (mangled-symbol &left &reference &signature)
             other (mangled-symbol &right &reference &signature)
             after (mangled-symbol &left &reference &signature)]
      (and (not (String.= &before &other)) (String.= &before &after)))))

(deftest t
  (assert-true t
    (Specialize.naming-policy-is-local?)
    "prepared contexts retain their native naming policy across changes to the defaults")
  (assert-true t
    (Specialize.cache-is-lazy?)
    "queries allocate no trace memo and untouched slots allocate no boxed types")
  (assert-true t
    (Specialize.contexts-survive-failure-and-interleaving?)
    "independent contexts retain their substitutions across interleaved successful and failed queries")
  (assert-true t
    (Specialize.independent-type-queries?)
    "an intervening specialization query cannot substitute another module's type variables")
  (assert-true t
    (specializes-delete-on-demand?)
    "an ownership delete request materializes the concrete deleter")
  (assert-equal t
    2
    (specialized-identity-count)
    "specialization emits distinct Int and String identity instances")
  (assert-equal t
    2
    (specialized-forward-count)
    "specialization traverses the dependencies of a root instance")
  (assert-true t
    (retains-specialized-roots?)
    "specialization retains typed ownerless root expressions")
  (assert-equal t
    1
    (specialized-recursive-count)
    "specialization terminates when a body reaches its own instance")
  (assert-equal t
    1
    (specialized-interface-builtin-count)
    "specialization resolves an interface call to a builtin implementation")
  (assert-equal t
    1
    (specialized-multi-variable-interface-count)
    "specialization preserves multiple interface type variables")
  (assert-true t
    (overwrites-equal-interface-implementation?)
    "specialization lets later equal interface implementations win")
  (assert-true t
    (prefers-concrete-constructor-implementation?)
    "specialization prefers concrete constructors over generic fallbacks")
  (assert-equal t
    1
    (specialized-module-interface-builtin-count)
    "specialization resolves module-qualified builtin implementations")
  (assert-equal t
    2
    (specialized-module-local-function-count)
    "specialization emits module function and builtin dependency instances")
  (assert-equal t
    1
    (specialized-global-value-count)
    "specialization emits callable global value instances")
  (assert-true t
    (specializes-scalar-global-references?)
    "specialization reaches and materializes scalar global references")
  (assert-equal t
    1
    (specialized-use-all-import-count)
    "specialization follows use-all imports")
  (assert-equal t
    1
    (nominal-record-implementation-count)
    "record helpers constrain implementations to their nominal type")
  (assert-equal t
    4
    (specialized-polymorphic-interface-dependency-count)
    "instance substitution reaches polymorphic interface dependencies")
  (assert-equal t
    1
    (signed-module-implementation-count)
    "module-qualified signatures constrain interface implementations")

  (assert-true t
    (specializes-function-copy-by-arity?)
    "copy dispatch selects a function template by arity")
  (assert-true t
    (materializes-forward-bodies?)
    "reachable definitions carry concrete global-call nodes")
  (assert-true t
    (materializes-interface-calls?)
    "specialized global-call nodes name selected implementations")
  (assert-true t
    (preserves-source-builtin-payloads?)
    "specialization retains external names and source templates")
  (assert-true t
    (materializes-typed-nested-calls?)
    "specialized nodes retain concrete types and stable expression IDs")
  (assert-true t
    (preserves-lifetimes-without-respecializing?)
    "specialization preserves shared lifetimes without duplicating ABI instances")
  (assert-true t
    (forward-declaration-symbols-are-distinct? "(register identity (Fn [a] a))")
    "generic forward declarations use signature-specific native symbols")
  (assert-true t
    (forward-declaration-symbols-are-distinct?
      "(register identity (Fn [a] a) \"stale_foreign_symbol\")")
    "a Carp definition replaces a forward declaration's explicit foreign name"))
