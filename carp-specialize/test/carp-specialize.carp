(defn specializes-scalar-global-references? []
  (match (Surface.parse "(def answer 42)
(defn read-answer [] answer)
(read-answer)") (Result.Success surface)
      (match (Resolve.module &surface)
        (Result.Success core)
          (match (Infer.module &core)
            (Result.Success inferred)
              (match (Specialize.module &core &inferred)
                (Result.Success specialized)
                  (let-do [found-global false
                           found-reference false
                           bodies (SpecializationModule.bodies &specialized)
                           n (Array.length bodies)]
                    (for [i 0 n]
                      (let [body (Array.unsafe-nth bodies i)
                            name (CoreRef.name
                              (Specialization.reference (SpecializedBody.specialization body)))]
                        (cond
                          (= name "answer")
                            (match-ref (Box.peek (SpecializedBody.body body))
                              (SpecializedExpr.IntLit _ _ value)
                                (when (Int.= @value 42) (set! found-global true))
                              _ ())
                          (= name "read-answer")
                            (match-ref (Box.peek (SpecializedBody.body body))
                              (SpecializedExpr.GlobalValue _ _ target _ _ _)
                                (when (= (CoreRef.name target) "answer")
                                  (set! found-reference true))
                              _ ())
                          ())))
                    (and found-global found-reference))
                (Result.Error _) false)
            (Result.Error _) false)
        (Result.Error _) false) (Result.Error _) false))

