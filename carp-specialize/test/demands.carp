(load "../carp-specialize.carp")
(Project.no-echo)
(load "Test.carp")
(use-all Test)

(defn make-demands [] (SpecializationDemands.create))
(defn add-delete! [demands type]
  (SpecializationDemands.require-delete! demands type))
(defn add-copy! [demands type]
  (SpecializationDemands.require-copy! demands type))
(defn ordered-requests [demands seeds]
  (let-do [requests @(SpecializationDemands.deletes demands)
           copies (SpecializationDemands.copies demands)]
    (for [i 0 (Array.length copies)]
      (Array.push-back! &requests @(Array.unsafe-nth copies i)))
    (for [i 0 (Array.length seeds)]
      (Array.push-back! &requests @(Array.unsafe-nth seeds i)))
    requests))

(defn request-text [request]
  (let [call (SpecializationRequest.call request)]
    (fmt "%d:%s:%d:%s:%s:%s"
         @(CallSite.id call)
         (CoreRef.name (CallSite.reference call))
         @(CoreRef.id (CallSite.reference call))
         &(Type.render (Box.peek (CallSite.type call)))
         (SpecializationRequest.origin request)
         &(match-ref (CallSite.owner call)
           (Maybe.Just owner) (String.copy (CoreRef.name owner))
           (Maybe.Nothing) (String.copy "none")))))

(defn same-requests? [actual expected]
  (let-do [same (Int.= (Array.length actual) (Array.length expected))]
    (when same
      (for [i 0 (Array.length actual)]
        (let [left (Array.unsafe-nth actual i)
              right (Array.unsafe-nth expected i)]
          (unless (and
              (String.= &(request-text left) &(request-text right))
              (Type.same?
                (Box.peek (CallSite.type (SpecializationRequest.call left)))
                (Box.peek (CallSite.type (SpecializationRequest.call right)))))
            (set! same false)))))
    same))

(defn duplicate-rounds? []
  (let-do [demands (make-demands)]
    (add-delete! &demands &(Type.string))
    (add-delete! &demands &(Type.string))
    (add-delete! &demands &(Type.integer))
    (add-copy! &demands &(Type.integer))
    (add-delete! &demands &(Type.string))
    (add-copy! &demands &(Type.integer))
    (add-delete! &demands &(Type.boolean))
    (add-copy! &demands &(Type.string))
    (same-requests? &(ordered-requests &demands &[])
                    &[(Specialize.delete-request &(Type.string))
                      (Specialize.delete-request &(Type.integer))
                      (Specialize.delete-request &(Type.boolean))
                      (Specialize.copy-request &(Type.integer))
                      (Specialize.copy-request &(Type.string))])))

(defn separate-roles? []
  (let-do [demands (make-demands)]
    (add-copy! &demands &(Type.string))
    (add-delete! &demands &(Type.string))
    (add-copy! &demands &(Type.string))
    (same-requests? &(ordered-requests &demands &[])
                    &[(Specialize.delete-request &(Type.string))
                      (Specialize.copy-request &(Type.string))])))

(defn first-abi-representative? []
  (let-do [demands (make-demands)
           first (Type.reference (Type.integer) (Type.lifetime 7))
           equivalent (Type.reference (Type.integer) (Type.lifetime 9))]
    (add-delete! &demands &first)
    (add-delete! &demands &equivalent)
    (add-copy! &demands &first)
    (add-copy! &demands &equivalent)
    (same-requests? &(ordered-requests &demands &[])
                    &[(Specialize.delete-request &first)
                      (Specialize.copy-request &first)])))

(defn seed-order-and-ownership? []
  (let-do [demands (make-demands)
           seed (Specialize.copy-request &(Type.boolean))
           seeds [@&seed @&seed]]
    (add-copy! &demands &(Type.integer))
    (add-delete! &demands &(Type.string))
    (let-do [first (ordered-requests &demands &seeds)]
      (Array.push-back! &first (Specialize.delete-request &(Type.boolean)))
      (and (Int.= 5 (Array.length &first))
           (same-requests? &(ordered-requests &demands &seeds)
                           &[(Specialize.delete-request &(Type.string))
                             (Specialize.copy-request &(Type.integer))
                             @&seed
                             @&seed])))))

(deftest t
  (assert-true t
    (duplicate-rounds?)
    "repeated rounds keep first-seen order without duplicate managed demands")
  (assert-true t
    (separate-roles?)
    "the same type independently requires its copier and deleter")
  (assert-true t
    (first-abi-representative?)
    "ABI-equivalent demands retain the first concrete type representation")
  (assert-true t
    (seed-order-and-ownership?)
    "seeds retain duplicates after deletes and copies and returned requests are owned"))
