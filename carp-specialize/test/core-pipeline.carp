(load "../../carp-expand/carp-expand.carp")
(load "../../carp-module/carp-module.carp")
(load "../../carp-resolve/carp-resolve.carp")
(load "../carp-specialize.carp")
(Project.no-echo)

;; core files come from $CARP_DIR (the reference checkout, as setup-carp
;; exports it), falling back to the sibling layout used for local development.
(defn core-prefix []
  (match (IO.getenv "CARP_DIR")
    (Maybe.Just dir) (String.append &dir "/core/")
    (Maybe.Nothing) @"../../../carp/core/"))

(defn core-path [name]
  (String.append &(core-prefix) name))


(defn core-source [path]
  (let [prefix (core-prefix)
        file (String.append &prefix path)]
    (ModuleSource.init (String.copy path)
                       (String.copy &file)
                       (IO.unsafe-read-file &file))))

(defn core-sources []
  (let-do [result (the (Array ModuleSource) [])
           paths (String.split-by "Core.carp
Interfaces.carp
Blitable.carp
Bool.carp
Box.carp
Macros.carp
BoolExtras.carp
List.carp
Derive.carp
Gensym.carp
ControlMacros.carp
Project.carp
Platform.carp
Introspect.carp
Quasiquote.carp
Pointer.carp
Unsafe.carp
Function.carp
Generics.carp
Maybe.carp
Result.carp
Dynamic.carp
Format.carp
Byte.carp
Int.carp
Long.carp
Double.carp
Float.carp
Tuples.carp
Array.carp
StaticArray.carp
StdInt.carp
Char.carp
String.carp
ArrayExt.carp
System.carp
IO.carp
Pattern.carp
Debug.carp
Random.carp
Map.carp
Heap.carp
Sort.carp
Binary.carp
Control.carp
Opaque.carp
Unit.carp" &[\newline])
           n (Array.length &paths)]
    (for [i 0 n]
      (set! result
            (Array.push-back result (core-source (Array.unsafe-nth &paths i)))))
    result))

(defn append-forms [left right]
  (let-do [result (Array.copy left)
           n (Array.length right)]
    (for [i 0 n]
      (set! result
            (Array.push-back result
                             (Box.init
                               (SurfaceNode.copy (Box.peek (Array.unsafe-nth right
                                                                             i)))))))
    result))

(defn info-pos [info] @(Info.pos info))

(defn span-start-pos [span] (info-pos (SurfaceSpan.start span)))

(defn span-end-pos [span] (info-pos (SurfaceSpan.end span)))

(defn span-contains? [outer inner]
  (and
    (Int.<= (span-start-pos outer) (span-start-pos inner))
    (Int.<= (span-end-pos inner) (span-end-pos outer))))

(defn nodes-at-span [nodes span fallback]
  (let-do [result fallback
           n (Array.length nodes)]
    (for [i 0 n]
      (let [node (Box.peek (Array.unsafe-nth nodes i))]
        (match (node-at-span node span)
          (Maybe.Just found) (set! result (Maybe.Just found))
          (Maybe.Nothing) ())))
    result))

(defn node-at-span [node span]
  (if (span-contains? (SurfaceNode.span node) span)
    (let [fallback (the (Maybe SurfaceNode) (Maybe.Just (SurfaceNode.copy node)))]
      (match-ref (SurfaceNode.form node)
        (SurfaceForm.List nodes) (nodes-at-span nodes span fallback)
        (SurfaceForm.Array nodes) (nodes-at-span nodes span fallback)
        (SurfaceForm.StaticArray nodes) (nodes-at-span nodes span fallback)
        (SurfaceForm.Dictionary nodes) (nodes-at-span nodes span fallback)
        _ fallback))
    (Maybe.Nothing)))

(defn form-at-span [module span]
  (let-do [result (the (Maybe SurfaceNode) (Maybe.Nothing))
           forms (SurfaceModule.forms module)
           n (Array.length forms)]
    (for [i 0 n]
      (match-ref &result
        (Maybe.Just _) ()
        (Maybe.Nothing)
          (let [form (Box.peek (Array.unsafe-nth forms i))]
            (set! result (node-at-span form span)))))
    result))

(defn print-form-at [module span]
  (match (form-at-span module span)
    (Maybe.Just form) (do (IO.println "form:") (IO.println &(str &form)))
    (Maybe.Nothing) (IO.println "form: <not found>")))

(defn bootstrap-module []
  (Result.from-success (Surface.parse "(defndynamic host-arch [] 'aarch64)
(defndynamic host-os [] 'darwin)
(defmodule Project (defndynamic get-config [key] \"native\"))") (SurfaceModule.init [])))

(defn probe-source []
  (if (Int.> (StaticArray.length &System.args) 1)
    @(StaticArray.unsafe-nth &System.args 1)
    (String.copy "(IO.println \"ok\")")))

(defn probe-module []
  (Result.from-success (Surface.parse &(probe-source)) (SurfaceModule.init [])))

(defn input-module [core probe]
  (let [with-core (append-forms
          (SurfaceModule.forms &(bootstrap-module))
          (SurfaceModule.forms core))
        forms (append-forms &with-core (SurfaceModule.forms probe))]
    (ModuleLoader.with-compiler-prelude &(SurfaceModule.init forms))))

(defn report-resolve-error [expanded error]
  (do
    (IO.println "resolve failed:")
    (IO.println (ResolveError.message error))
    (let [start (SurfaceSpan.start (ResolveError.span error))
          end (SurfaceSpan.end (ResolveError.span error))]
      (IO.println
        &(String.concat
          &[@"span: "
            (Int.str @(Info.pos start))
            @":"
            (Int.str @(Info.line start))
            @":"
            (Int.str @(Info.col start))
            @".."
            (Int.str @(Info.pos end))
            @":"
            (Int.str @(Info.line end))
            @":"
            (Int.str @(Info.col end))])))
    (print-form-at expanded (ResolveError.span error))))

(defn report-expand-error [input error]
  (do
    (IO.println "expand failed:")
    (IO.println (CtError.message error))
    (let [start (SurfaceSpan.start (CtError.span error))
          end (SurfaceSpan.end (CtError.span error))]
      (IO.println
        &(String.concat
          &[@"span: "
            (Int.str @(Info.pos start))
            @":"
            (Int.str @(Info.line start))
            @":"
            (Int.str @(Info.col start))
            @".."
            (Int.str @(Info.pos end))
            @":"
            (Int.str @(Info.line end))
            @":"
            (Int.str @(Info.col end))])))
    (print-form-at input (CtError.span error))))

(defn main []
  (let [sources (core-sources)
        root (String.copy "Core.carp")]
    (match (ModuleLoader.load &sources &root)
      (Result.Success loaded-core)
        (let [input (input-module &loaded-core &(probe-module))
              config (ExpandConfig.init [@"Dynamic"])]
          (match (MacroExpand.expand-module-with &input &config)
            (Result.Success expanded)
              (match (Resolve.module &expanded)
                (Result.Success core)
                  (match (Infer.module &core)
                    (Result.Success inferred)
                      (match (Specialize.module &core &inferred)
                        (Result.Success specialized)
                          (do
                            (IO.println "pipeline ok")
                            (IO.println
                              &(String.concat
                                &[@"specializations: "
                                  (Int.str
                                    (Array.length
                                      (SpecializationModule.instances &specialized)))])))
                        (Result.Error error)
                          (do
                            (IO.println "specialize failed:")
                            (IO.println (SpecializeError.message &error))))
                    (Result.Error error)
                      (do
                        (IO.println "infer failed:")
                        (IO.println (InferError.message &error))))
                (Result.Error error) (report-resolve-error &expanded &error))
            (Result.Error error) (report-expand-error &input &error)))
      (Result.Error error)
        (do
          (IO.println "load failed:")
          (IO.println (ModuleError.message &error))))))
