; driver plumbing shared by both drivers: host probes, source loading, load
; targets and check names, and `load-with-core`.

(load "carp-compiler.carp")

(doc *command* "is the name the compiler reports diagnostics under.
`compiler-main` sets it.")
(def *command* @"carp-compiler")
(doc report-error "prints `message` to stderr under the compiler's name.")
(defn report-error [message] (IO.errorln &(fmt "%s: %s" &*command* message)))
(doc report "prints `message` to stdout under the compiler's name.")
(defn report [message] (IO.println &(fmt "%s: %s" &*command* message)))

(doc compiler-host-arch "returns the architecture this compiler was built for,
such as `aarch64` or `x86_64`.")
(deftemplate compiler-host-arch (Fn [] String) "String $NAME(void)" "$DECL {
  String value =
#if defined(__aarch64__) || defined(_M_ARM64)
    \"aarch64\";
#elif defined(__x86_64__) || defined(_M_X64)
    \"x86_64\";
#elif defined(__i386__) || defined(_M_IX86)
    \"i386\";
#elif defined(__arm__) || defined(_M_ARM)
    \"arm\";
#elif defined(__wasm32__)
    \"wasm32\";
#else
    \"unknown\";
#endif
  return String_copy(&value);
}")

(doc compiler-host-os "returns the operating system this compiler was built for,
such as `darwin` or `linux`.")
(deftemplate compiler-host-os (Fn [] String) "String $NAME(void)" "$DECL {
  String value =
#if defined(__APPLE__) && defined(__MACH__)
    \"darwin\";
#elif defined(_WIN32)
    \"mingw32\";
#elif defined(__linux__)
    \"linux\";
#elif defined(__FreeBSD__)
    \"freebsd\";
#elif defined(__NetBSD__)
    \"netbsd\";
#elif defined(__OpenBSD__)
    \"openbsd\";
#else
    \"unknown\";
#endif
  return String_copy(&value);
}")

(doc compiler-system-exit-code "returns the exit code of the wait status
`status`. A process killed by a signal gives 128 plus the signal number.")
(deftemplate compiler-system-exit-code
             (Fn [Int] Int)
             "int $NAME(int status)"
             "$DECL {
#if defined(_WIN32)
  return status;
#else
  if (WIFEXITED(status)) return WEXITSTATUS(status);
  if (WIFSIGNALED(status)) return 128 + WTERMSIG(status);
  return 1;
#endif
}")

(doc compiler-process-id "returns the id of this process.")
(deftemplate compiler-process-id (Fn [] Int) "int $NAME(void)" "$DECL {
#if defined(_WIN32)
  return (int)_getpid();
#else
  return (int)getpid();
#endif
}")

(doc compiler-remove-file "removes the file `path`, ignoring errors.")
(deftemplate compiler-remove-file
             (Fn [(Ref String)] Unit)
             "void $NAME(String const *path)"
             "$DECL {
  (void)remove(*path);
}")

(doc version "is the compiler's version.")
(def version "0.0.3")

(doc core-files "lists the files of Core that `read-core` reads.")
(def core-files
  [@"Core.carp"
   @"Interfaces.carp"
   @"Blitable.carp"
   @"Bool.carp"
   @"Box.carp"
   @"Macros.carp"
   @"BoolExtras.carp"
   @"List.carp"
   @"Derive.carp"
   @"Gensym.carp"
   @"ControlMacros.carp"
   @"Project.carp"
   @"Platform.carp"
   @"Introspect.carp"
   @"Quasiquote.carp"
   @"Pointer.carp"
   @"Unsafe.carp"
   @"Function.carp"
   @"Generics.carp"
   @"Maybe.carp"
   @"Result.carp"
   @"Dynamic.carp"
   @"Format.carp"
   @"Byte.carp"
   @"Int.carp"
   @"Long.carp"
   @"Double.carp"
   @"Float.carp"
   @"Tuples.carp"
   @"Array.carp"
   @"StaticArray.carp"
   @"StdInt.carp"
   @"Char.carp"
   @"String.carp"
   @"ArrayExt.carp"
   @"System.carp"
   @"IO.carp"
   @"Pattern.carp"
   @"Debug.carp"
   @"Random.carp"
   @"Map.carp"
   @"Heap.carp"
   @"Sort.carp"
   @"Binary.carp"
   @"Control.carp"
   @"Opaque.carp"
   @"Unit.carp"])

(doc read-core "reads the files in `core-files` from `dir` into module sources.")
(defn read-core [dir]
  (let-do [result (the (Array ModuleSource) [])]
    (for [i 0 (Array.length &core-files)]
      (let [name @(Array.unsafe-nth &core-files i)
            file (String.concat &[@dir @"/" @&name])
            text (IO.unsafe-read-file &file)]
        (Array.push-back! &result (ModuleSource.init name file text))))
    result))

(doc parsed-forms "returns the forms of `src`, or none if it does not parse.")
(defn parsed-forms [src]
  (match (Surface.parse src)
    (Result.Success m) @(SurfaceModule.forms &m)
    (Result.Error _) (the (Array (Box SurfaceNode)) [])))

(doc append-forms "returns copies of the forms of `left` followed by those of
`right`.")
(defn append-forms [left right]
  (let-do [result (Array.copy left)]
    (for [i 0 (Array.length right)]
      (set! result
            (Array.push-back result
                             (Box.init
                               (SurfaceNode.copy (Box.peek (Array.unsafe-nth right
                                                                             i)))))))
    result))

(doc symbol-named? "checks whether `node` is the unqualified symbol `name`.")
(defn symbol-named? [node name]
  (match-ref (SurfaceNode.form node)
    (SurfaceForm.Symbol segments)
      (and (Int.= 1 (Array.length segments))
           (String.= (Array.unsafe-nth segments 0) name))
    _ false))

(doc load-symbol? "checks whether `node` is the symbol `load` or `load-once`.")
(defn load-symbol? [node]
  (or (symbol-named? node "load") (symbol-named? node "load-once")))

(doc form-load-target "returns the file that the load form `node` names. `(load
\"X.carp\")` and `(load-once \"X.carp\")` give the string, with a leading
`core/` removed. `(load \"repo@tag\" \"file.carp\")` gives that file of the
checkout. `(load-and-use X)` gives `X.carp`.")
(defn form-load-target [node]
  (match-ref (SurfaceNode.form node)
    (SurfaceForm.List items)
      (cond
        (and (Int.= 3 (Array.length items))
             (load-symbol? (Box.peek (Array.unsafe-nth items 0))))
        ;; `(load "repo@tag" "file.carp")`: that file of the checkout
        (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth items 1)))
          (SurfaceForm.StringLit path)
            (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth items 2)))
              (SurfaceForm.StringLit file)
                (Maybe.Just (ModuleLoader.file-load-target path file))
              _ (the (Maybe String) (Maybe.Nothing)))
          _ (the (Maybe String) (Maybe.Nothing)))
        (Int.= 2 (Array.length items))
        (let [head (Box.peek (Array.unsafe-nth items 0))
              arg (Box.peek (Array.unsafe-nth items 1))]
          (cond
            (load-symbol? head)
              (match-ref (SurfaceNode.form arg)
                ;; `(load "core/Foo.carp")` names a Core file relative to the Carp
                ;; root; the core dir already IS core, so drop the prefix (this
                ;; also dedups against the same file loaded plainly as "Foo.carp").
                (SurfaceForm.StringLit path)
                (Maybe.Just
                  (if (String.starts-with? path "core/")
                    (String.suffix path 5)
                    @path))
                _
                (the (Maybe String) (Maybe.Nothing)))
            (symbol-named? head "load-and-use")
              (match-ref (SurfaceNode.form arg)
                (SurfaceForm.Symbol segments)
                  (if (Int.= 1 (Array.length segments))
                    (Maybe.Just
                      (String.concat &[@(Array.unsafe-nth segments 0) @".carp"]))
                    (the (Maybe String) (Maybe.Nothing)))
                _ (the (Maybe String) (Maybe.Nothing)))
            (the (Maybe String) (Maybe.Nothing))))
        (the (Maybe String) (Maybe.Nothing)))
    _ (the (Maybe String) (Maybe.Nothing))))

(doc collect-load-targets "returns the files that the load forms in `forms`
name.")
(defn collect-load-targets [forms]
  (let-do [result (the (Array String) [])]
    (for [i 0 (Array.length forms)]
      (match (form-load-target (Box.peek (Array.unsafe-nth forms i)))
        (Maybe.Just name) (Array.push-back! &result name)
        (Maybe.Nothing) ()))
    result))

(doc defn-name "returns the name that a `defn` or `defn-` form `node` defines,
if any.")
(defn defn-name [node]
  (match-ref (SurfaceNode.form node)
    (SurfaceForm.List items)
      (if (Int.< 2 (Array.length items))
        (let [head (Box.peek (Array.unsafe-nth items 0))
              name-node (Box.peek (Array.unsafe-nth items 1))]
          (if (or (symbol-named? head "defn") (symbol-named? head "defn-"))
            (match-ref (SurfaceNode.form name-node)
              (SurfaceForm.Symbol segments)
                (if (Int.= 1 (Array.length segments))
                  (Maybe.Just @(Array.unsafe-nth segments 0))
                  (the (Maybe String) (Maybe.Nothing)))
              _ (the (Maybe String) (Maybe.Nothing)))
            (the (Maybe String) (Maybe.Nothing))))
        (the (Maybe String) (Maybe.Nothing)))
    _ (the (Maybe String) (Maybe.Nothing))))

(sig collect-check-names!
     (Fn [(Ref (Array (Box SurfaceNode))) String (Ref (Array String))] ()))
(doc collect-check-names! "adds to `acc` the qualified name of every function
`forms` define, inside modules too, prefixed with `prefix`. A `(derive T f)`
adds `T.f`.")
(defn collect-check-names! [forms prefix acc]
  (for [i 0 (Array.length forms)]
    (let-do [node (Box.peek (Array.unsafe-nth forms i))]
      (match (defn-name node)
        (Maybe.Just name)
          (Array.push-back! acc (String.concat &[@&prefix @&name]))
        (Maybe.Nothing) ())
      ;; `(derive T f)` expands to a `T.f` defn implementing interface `f`;
      ;; seed it so the derived body is checked even when nothing calls it.
      (match-ref (SurfaceNode.form node)
        (SurfaceForm.List items)
          (when (and (Int.= 3 (Array.length items))
                     (symbol-named? (Box.peek (Array.unsafe-nth items 0))
                                    "derive"))
            (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth items 1)))
              (SurfaceForm.Symbol type-segments)
                (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth items 2)))
                  (SurfaceForm.Symbol fn-segments)
                    (when (and (Int.= 1 (Array.length type-segments))
                               (Int.= 1 (Array.length fn-segments)))
                      (Array.push-back! acc
                                        (String.concat
                                          &[@&prefix
                                            @(Array.unsafe-nth type-segments 0)
                                            @"."
                                            @(Array.unsafe-nth fn-segments 0)])))
                  _ ())
              _ ()))
        _ ())
      (match-ref (SurfaceNode.form node)
        (SurfaceForm.List items)
          (when (and (Int.< 2 (Array.length items))
                     (symbol-named? (Box.peek (Array.unsafe-nth items 0))
                                    "defmodule"))
            (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth items 1)))
              (SurfaceForm.Symbol segments)
                (when (Int.= 1 (Array.length segments))
                  (let-do [inner-prefix (String.concat
                             &[@&prefix @(Array.unsafe-nth segments 0) @"."])
                           body (the (Array (Box SurfaceNode)) [])]
                    (for [j 2 (Array.length items)]
                      (Array.push-back! &body
                                        (Box.init
                                          (SurfaceNode.copy (Box.peek (Array.unsafe-nth items
                                                                                        j))))))
                    (collect-check-names! &body inner-prefix acc)))
              _ ()))
        _ ()))))

(doc collect-check-names "returns the qualified names of the functions that
`source` defines. The driver specializes them even if nothing calls them.")
(defn collect-check-names [source]
  (let-do [acc (the (Array String) [])]
    (match (Surface.parse source)
      (Result.Success user-module)
        (collect-check-names! (SurfaceModule.forms &user-module) @"" &acc)
      (Result.Error _) ())
    acc))

(sig collect-private-names!
     (Fn [(Ref (Array (Box SurfaceNode))) String (Ref (Array String))] ()))
(doc collect-private-names! "adds to `acc` the qualified names that `forms`
declare private with `private` or `defn-`, prefixed with `prefix`.")
(defn collect-private-names! [forms prefix acc]
  (for [i 0 (Array.length forms)]
    (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth forms i)))
      (SurfaceForm.List items)
        (when (Int.<= 2 (Array.length items))
          (let [head (Box.peek (Array.unsafe-nth items 0))]
            (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth items 1)))
              (SurfaceForm.Symbol segments)
                (when (Int.= 1 (Array.length segments))
                  (cond
                    (or (symbol-named? head "private")
                        (symbol-named? head "defn-"))
                      (Array.push-back! acc
                                        (String.concat
                                          &[@&prefix
                                            @(Array.unsafe-nth segments 0)]))
                    (symbol-named? head "defmodule")
                      (let-do [body (the (Array (Box SurfaceNode)) [])]
                        (for [j 2 (Array.length items)]
                          (Array.push-back! &body
                                            (Box.init
                                              (SurfaceNode.copy (Box.peek (Array.unsafe-nth items
                                                                                            j))))))
                        (collect-private-names! &body
                                                (String.concat
                                                  &[@&prefix
                                                    @(Array.unsafe-nth segments
                                                                       0)
                                                    @"."])
                                                acc))
                    ()))
              _ ())))
      _ ())))

(doc collect-library-roots "returns the public functions that `source` defines:
the roots of a library.")
(defn collect-library-roots [source]
  (let-do [names (collect-check-names source)
           private-names (the (Array String) [])
           roots (the (Array String) [])]
    (match (Surface.parse source)
      (Result.Success user-module)
        (collect-private-names! (SurfaceModule.forms &user-module)
                                @""
                                &private-names)
      (Result.Error _) ())
    (for [i 0 (Array.length &names)]
      (let [name (Array.unsafe-nth &names i)]
        (unless (Array.contains? &private-names name)
          (Array.push-back! &roots @name))))
    roots))

(doc echo-enabled? "checks whether `forms` leave the echo of top-level results
on, that is, do not call `(Project.no-echo)`.")
(defn echo-enabled? [forms]
  (let-do [echo true]
    (for [i 0 (Array.length forms)]
      (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth forms i)))
        (SurfaceForm.List items)
          (when (Int.> (Array.length items) 0)
            (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth items 0)))
              (SurfaceForm.Symbol segments)
                (when (and (Int.= 2 (Array.length segments))
                           (and
                             (String.= (Array.unsafe-nth segments 0) "Project")
                             (String.= (Array.unsafe-nth segments 1) "no-echo")))
                  (set! echo false))
              _ ()))
        _ ()))
    echo))

(doc source-echo-enabled? "checks whether `source` leaves the echo of top-level
results on.")
(defn source-echo-enabled? [source]
  (match (Surface.parse source)
    (Result.Success user-module)
      (echo-enabled? (SurfaceModule.forms &user-module))
    (Result.Error _) false))

(doc source-present? "checks whether `registry` holds a source named `name`.")
(defn source-present? [registry name]
  (let-do [found false]
    (for [i 0 (Array.length registry)]
      (when (String.= (ModuleSource.path (Array.unsafe-nth registry i)) name)
        (set! found true)))
    found))

(doc read-core-file "reads the file `name` from `core-dir`, if it exists.")
(defn read-core-file [core-dir name]
  (match (IO.read-file &(String.concat &[@core-dir @"/" @name]))
    (Result.Success text) (Maybe.Just text)
    (Result.Error _) (the (Maybe String) (Maybe.Nothing))))

; --- git-reference loads ---
; a load target with an `@` names a git checkout: the part after the last `@`
; is the tag and the rest the remote. checkouts live in
; `<cache>/carp/libs/<dir>/<tag>`, where `<dir>` is the remote without its
; scheme or user. a missing checkout is installed with git.

(doc git-ref? "checks whether the load target `name` names a git checkout.")
(defn git-ref? [name] (Int.> (String.index-of name \@) -1))

(doc last-at-index "returns the index of the last `@` in `name`, or -1.")
(defn last-at-index [name]
  (let-do [result -1
           i 0
           n (String.length name)]
    (while-do (Int.< i n)
      (when (Char.= (String.char-at name i) \@) (set! result i))
      (set! i (Int.inc i)))
    result))

(doc git-ref-url "returns the remote of the git load target `name`.")
(defn git-ref-url [name] (String.prefix name (last-at-index name)))

(doc git-ref-tag "returns the tag of the git load target `name`.")
(defn git-ref-tag [name] (String.suffix name (Int.inc (last-at-index name))))

(doc git-ref-cache-dir "returns the cache directory of the remote `url`: without
the `http://` or `https://` scheme, or else without the user and with each `:`
replaced by `_COLON_`.")
(defn git-ref-cache-dir [url]
  (cond
    (String.starts-with? url "https://") (String.suffix url 8)
    (String.starts-with? url "http://") (String.suffix url 7)
    (let [after-user (if (git-ref? url)
            (String.byte-slice url
                               (Int.inc (String.index-of url \@))
                               (String.length url))
            @url)]
      (String.join "_COLON_" &(String.split-by &after-user &[\:])))))

(doc git-ref-repo-file "returns the file a checkout of `url` loads by default:
the repository name with `.carp`.")
(defn git-ref-repo-file [url]
  (let-do [segments (String.split-by url &[\/ \:])
           repo (if (Int.> (Array.length &segments) 0)
             @(Array.unsafe-nth &segments (Int.dec (Array.length &segments)))
             @"main")]
    (when (String.ends-with? &repo ".git")
      (set! repo (String.byte-slice &repo 0 (Int.- (String.length &repo) 4))))
    (unless (String.ends-with? &repo ".carp")
      (set! repo (String.append &repo ".carp")))
    repo))

(doc git-cache-root "returns the directory checkouts are kept in, under
`XDG_CACHE_HOME`, `HOME` or `/tmp`.")
(defn git-cache-root []
  (match (IO.getenv "XDG_CACHE_HOME")
    (Maybe.Just cache) (String.append &cache "/carp/libs")
    (Maybe.Nothing)
      (match (IO.getenv "HOME")
        (Maybe.Just home) (String.append &home "/.cache/carp/libs")
        (Maybe.Nothing) @"/tmp/carp-libs")))

(doc git-install! "checks out `tag` of `url` into `dir`, if `dir` does not
exist. The checkout is made in a directory of its own and moved into place, so
it is only seen complete.")
(defn git-install! [dir url tag]
  (ignore
    (System.system
      &(fmt
        "[ -d '%s' ] || { tmp='%s.tmp.'$$ && rm -rf \"$tmp\" && mkdir -p \"$tmp\" && (cd \"$tmp\" && git init -q && git remote add origin '%s' && git fetch -q --all --tags && git checkout -q '%s') && mv \"$tmp\" '%s'; rm -rf \"$tmp\" '%s'/\"${tmp##*/}\"; }"
        dir
        dir
        url
        tag
        dir
        dir))))

(doc read-cached-git-source "reads the git load target `target` from the cache
and installs the checkout if it is missing. A target that names a file reads
that file.")
(defn read-cached-git-source [target]
  (let-do [space (String.index-of target \space)
           name (if (Int.< space 0) @target (String.byte-slice target 0 space))
           file (if (Int.< space 0)
             (the (Maybe String) (Maybe.Nothing))
             (Maybe.Just
               (String.byte-slice target (Int.inc space) (String.length target))))]
    (match file
      (Maybe.Just f) (read-git-file &name &f)
      (Maybe.Nothing) (read-git-default &name))))

(doc git-checkout-dir "returns the cache directory of the checkout that `name`
names.")
(defn git-checkout-dir [name]
  (String.concat
    &[(git-cache-root)
      @"/"
      (git-ref-cache-dir &(git-ref-url name))
      @"/"
      (git-ref-tag name)]))

(doc read-git-file "reads `file` from the checkout that `name` names, and
installs the checkout if needed. It returns the path and the text.")
(defn read-git-file [name file]
  (let [dir (git-checkout-dir name)
        path (String.concat &[(String.copy &dir) @"/" @file])]
    (match (IO.read-file &path)
      (Result.Success text) (Maybe.Just (Pair.init @&path text))
      (Result.Error _)
        (do
          (git-install! &dir &(git-ref-url name) &(git-ref-tag name))
          (match (IO.read-file &path)
            (Result.Success text) (Maybe.Just (Pair.init @&path text))
            (Result.Error _) (the (Maybe (Pair String String)) (Maybe.Nothing)))))))

(doc read-git-default "reads the default file of the checkout that `name` names:
`<repo>.carp`, else `main.carp`. It installs the checkout if needed, and returns
the path and the text.")
(defn read-git-default [name]
  (let [url (git-ref-url name)
        dir (String.concat
          &[(git-cache-root)
            @"/"
            (git-ref-cache-dir &url)
            @"/"
            (git-ref-tag name)])
        lib-file (String.concat
          &[(String.copy &dir) @"/" (git-ref-repo-file &url)])
        main-file (String.append &dir "/main.carp")]
    (match (IO.read-file &lib-file)
      (Result.Success text) (Maybe.Just (Pair.init @&lib-file text))
      (Result.Error _)
        (match (IO.read-file &main-file)
          (Result.Success text) (Maybe.Just (Pair.init @&main-file text))
          (Result.Error _)
            (do
              (git-install! &dir &url &(git-ref-tag name))
              (match (IO.read-file &lib-file)
                (Result.Success text) (Maybe.Just (Pair.init @&lib-file text))
                (Result.Error _)
                  (match (IO.read-file &main-file)
                    (Result.Success text)
                      (Maybe.Just (Pair.init @&main-file text))
                    (Result.Error _)
                      (the (Maybe (Pair String String)) (Maybe.Nothing)))))))))

(doc *package-overrides* "maps git load targets to local source files for this
run.")
(def *package-overrides* (the (Array (Pair String String)) []))

(doc parse-package-override "parses `<git-reference>=<source.carp>` into the
reference and the file.")
(defn parse-package-override [specification]
  (let [separator (String.index-of specification \=)
        length (String.length specification)]
    (if (or (Int.<= separator 0) (Int.>= separator (Int.dec length)))
      (Result.Error @"expected <git-reference>=<source.carp>")
      (let [name (String.byte-slice specification 0 separator)
            path (String.byte-slice specification (Int.inc separator) length)]
        (if (git-ref? &name)
          (Result.Success (Pair.init name path))
          (Result.Error @"package override must name an exact git reference"))))))

(doc add-package-override! "maps the git load target in `specification` to a
local source file for this run. A second override of the same target is an
error.")
(defn add-package-override! [specification]
  (match (parse-package-override specification)
    (Result.Error error) (Result.Error error)
    (Result.Success entry)
      (match (package-override (Pair.a &entry))
        (Maybe.Just _) (Result.Error @"duplicate package override")
        (Maybe.Nothing)
          (do (Array.push-back! &*package-overrides* entry) (Result.Success ())))))

(private package-override)
(hidden package-override)
(defn package-override [name]
  (let-do [found (the (Maybe String) (Maybe.Nothing))]
    (for [i 0 (Array.length &*package-overrides*)]
      (let [entry (Array.unsafe-nth &*package-overrides* i)]
        (when (String.= (Pair.a entry) name)
          (set! found (Maybe.Just (String.copy (Pair.b entry)))))))
    found))

(doc read-git-source "reads the git load target `name`, from its local override
if there is one and from the cache otherwise.")
(defn read-git-source [name]
  (match (package-override name)
    (Maybe.Nothing) (read-cached-git-source name)
    (Maybe.Just path)
      (let [canonical (normalize-path &path)]
        (match (IO.read-file &canonical)
          (Result.Success source) (Maybe.Just (Pair.init canonical source))
          (Result.Error error)
            (do
              (report-error &(fmt "package override '%s': %s" &canonical &error))
              (the (Maybe (Pair String String)) (Maybe.Nothing)))))))

(doc add-default-package-overrides! "adds the overrides in `configuration`, one
per line. A target that is already overridden keeps its override. A malformed
line is an error.")
(defn add-default-package-overrides! [configuration]
  (let-do [lines (String.lines configuration)
           failure (the (Maybe String) (Maybe.Nothing))]
    (for [i 0 (Array.length &lines)]
      (when (Maybe.nothing? &failure)
        (let [line (Array.unsafe-nth &lines i)]
          (unless (String.empty? line)
            (match (parse-package-override line)
              (Result.Error error) (set! failure (Maybe.Just error))
              (Result.Success entry)
                (when (Maybe.nothing? &(package-override (Pair.a &entry)))
                  (Array.push-back! &*package-overrides* entry)))))))
    (match failure
      (Maybe.Just error) (Result.Error error)
      (Maybe.Nothing) (Result.Success ()))))

(doc load-env-package-overrides! "adds the overrides in
`CARP_PACKAGE_OVERRIDES`.")
(defn load-env-package-overrides! []
  (match (IO.getenv "CARP_PACKAGE_OVERRIDES")
    (Maybe.Nothing) (the (Result () String) (Result.Success ()))
    (Maybe.Just configuration) (add-default-package-overrides! &configuration)))

(doc dir-of "returns the directory part of `path`, or `.` if there is none.")
(defn dir-of [path]
  (let-do [slash -1
           i 0
           n (String.length path)]
    (while-do (Int.< i n)
      (when (Char.= (String.char-at path i) \/) (set! slash i))
      (set! i (Int.inc i)))
    (if (Int.< slash 0) @"." (String.prefix path slash))))

(doc normalize-path "removes the `.` and `..` segments of `path`, without
reading the file system.")
(defn normalize-path [path]
  (let-do [segments (String.split-by path &[\/])
           kept (the (Array String) [])
           absolute (String.starts-with? path "/")]
    (for [i 0 (Array.length &segments)]
      (let [segment (Array.unsafe-nth &segments i)]
        (cond
          (or (String.= segment "") (String.= segment ".")) ()
          (String.= segment "..")
            (if (and (Int.> (Array.length &kept) 0)
                     (not
                       (String.=
                         (Array.unsafe-nth &kept (Int.dec (Array.length &kept)))
                         "..")))
              (ignore (Array.pop-back! &kept))
              (Array.push-back! &kept @segment))
          (Array.push-back! &kept @segment))))
    (if absolute
      (String.append "/" &(String.join "/" &kept))
      (String.join "/" &kept))))

(doc same-path-ignoring-case? "checks whether `a` and `b` are equal, ignoring
ASCII case. On a case-insensitive file system a load can otherwise resolve to
the requesting file itself.")
(defn same-path-ignoring-case? [a b]
  (let-do [n (String.length a)
           equal (Int.= n (String.length b))
           i 0]
    (while-do (and equal (Int.< i n))
      (let [ca (Char.to-int (String.char-at a i))
            cb (Char.to-int (String.char-at b i))
            la (if (and (Int.>= ca 65) (Int.<= ca 90)) (Int.+ ca 32) ca)
            lb (if (and (Int.>= cb 65) (Int.<= cb 90)) (Int.+ cb 32) cb)]
        (unless (Int.= la lb) (set! equal false)))
      (set! i (Int.inc i)))
    equal))

(doc read-local-candidate "reads the file `path`, unless it is `requester-file`
itself. It returns the path and the text.")
(defn read-local-candidate [requester-file path]
  (if (same-path-ignoring-case? path &(normalize-path requester-file))
    (the (Maybe (Pair String String)) (Maybe.Nothing))
    (match (IO.read-file path)
      (Result.Success text) (Maybe.Just (Pair.init @path text))
      (Result.Error _) (the (Maybe (Pair String String)) (Maybe.Nothing)))))

(doc resolve-load-target "reads the load target `name` of `requester-file`. It
tries the name as given, then relative to the requesting file's directory, then
in `core-dir`. A git target is read from the cache. It returns the path and the
text.")
(defn resolve-load-target [core-dir requester-file name]
  (if (git-ref? name)
    (read-git-source name)
    (match (read-local-candidate requester-file &(normalize-path name))
      (Maybe.Just found) (Maybe.Just found)
      (Maybe.Nothing)
        (match (if (String.starts-with? name "/")
            (the (Maybe (Pair String String)) (Maybe.Nothing))
            (read-local-candidate requester-file
                                  &(normalize-path
                                    &(String.concat
                                      &[(dir-of requester-file)
                                        @"/"
                                        (String.copy name)]))))
          (Maybe.Just found) (Maybe.Just found)
          (Maybe.Nothing)
            (match (read-core-file core-dir name)
              (Maybe.Just found)
                (Maybe.Just
                  (Pair.init
                    (String.concat &[@core-dir @"/" (String.copy name)])
                    found))
              (Maybe.Nothing) (the (Maybe (Pair String String)) (Maybe.Nothing)))))))

(doc ensure-sources "adds to `registry` every file that the load targets in
`seed` name, and the files those load, transitively. Files already in `registry`
are skipped.")
(defn ensure-sources [registry core-dir seed]
  (let-do [result registry
           work @seed]
    (while (Int.< 0 (Array.length &work))
      (let-do [item (Array.pop-back! &work)
               requester-file (Pair.a &item)
               name (Pair.b &item)]
        (unless (source-present? &result name)
          (match (resolve-load-target core-dir requester-file name)
            (Maybe.Just entry)
              (let-do [file @(Pair.a &entry)
                       text @(Pair.b &entry)]
                (set! result
                      (Array.push-back result
                                       (ModuleSource.init (String.copy name)
                                                          (String.copy &file)
                                                          (String.copy &text))))
                (match (Surface.parse &text)
                  (Result.Success m)
                    (let-do [targets (collect-load-targets (SurfaceModule.forms &m))]
                      (for [i 0 (Array.length &targets)]
                        (set! work
                              (Array.push-back work
                                               (Pair.init (String.copy &file)
                                                          @(Array.unsafe-nth &targets
                                                                             i))))))
                  (Result.Error _) ()))
            (Maybe.Nothing) ()))))
    result))

(doc phase! "prints `name` to stderr if `CARP_DEBUG_PHASES` is set.")
(defn phase! [name]
  (match (IO.getenv "CARP_DEBUG_PHASES")
    (Maybe.Just _) (IO.errorln &(String.append "phase: " name))
    (Maybe.Nothing) ()))

(doc load-with-core "loads the program `input` with the Core in `core-dir` into
one module, ready to compile. The host architecture and system are set from this
compiler. The program's load forms resolve as in `resolve-load-target`. If
`no-core` is true, Core is not loaded. It returns the module and the program's
source.")
(defn load-with-core [input core-dir no-core]
  (match (IO.read-file input)
    (Result.Error e)
      (do
        (report-error &(fmt "cannot read '%s': %s" input &e))
        (the (Maybe (Pair SurfaceModule String)) (Maybe.Nothing)))
    (Result.Success source)
      (match (if no-core
          (Result.Success @"")
          (IO.read-file &(String.concat &[@core-dir @"/Core.carp"])))
        (Result.Error _)
          (do
            (report-error &(fmt "no Core.carp under '%s'" core-dir))
            (the (Maybe (Pair SurfaceModule String)) (Maybe.Nothing)))
        (Result.Success _)
          (let [host-arch (compiler-host-arch)
                host-os (compiler-host-os)
                boot (String.concat
                  &[@"(defndynamic host-arch [] \""
                    (String.copy &host-arch)
                    @"\")
(defndynamic host-os [] \""
                    (String.copy &host-os)
                    @"\")
(def target-arch \""
                    host-arch
                    @"\")
(def target-os \""
                    host-os
                    @"\")
(def target-abi \"unknown\")
;; the evaluator answers config and get-config itself, from the project
;; configuration it records; these only make them compile-time functions
(defmodule Project
  (defndynamic config [key value] ())
  (defndynamic no-echo [] ())
  (defndynamic get-config [key] ()))"])
                root-name "__carp-compiler-main__.carp"
                ;; `add-c` must be redefined AFTER Core loads (core's Dynamic.carp
                ;; defines it via the Project \"cmod\" config we do not track);
                ;; this variant textually includes the C module instead.
                root-text (String.concat &[@&boot (if no-core @"
" @"
(load \"Core.carp\")
") @"(defmacro add-c [relpath]
  (list (quote Unsafe.preproc)
        (list (quote Unsafe.emit-c)
              (String.concat [\"#include \\\"\" (relative-to (current-file) relpath) \"\\\"\"]))))
(defmacro relative-include [path]
  (list (quote Unsafe.preproc)
        (list (quote Unsafe.emit-c)
              (String.concat [\"#include \\\"\" (relative-to (current-file) path) \"\\\"\"]))))
(load \"__input__\")
"])]
            (match (Surface.parse &root-text)
              (Result.Error _)
                (do
                  (report-error "cannot parse input")
                  (the (Maybe (Pair SurfaceModule String)) (Maybe.Nothing)))
              (Result.Success root-module)
                (let-do [targets (collect-load-targets (SurfaceModule.forms &root-module))
                         user-targets (match (Surface.parse &source)
                           (Result.Success user-module)
                             (collect-load-targets (SurfaceModule.forms &user-module))
                           (Result.Error _) (the (Array String) []))
                         seed (the (Array (Pair String String)) [])
                         _ignored-seed (for [i 0 (Array.length &targets)]
                           (Array.push-back! &seed
                                             (Pair.init (String.copy input)
                                                        @(Array.unsafe-nth &targets
                                                                           i))))
                         _ignored-user-seed (for [i
                                                  0
                                                  (Array.length &user-targets)]
                           (Array.push-back! &seed
                                             (Pair.init (String.copy input)
                                                        @(Array.unsafe-nth &user-targets
                                                                           i))))
                         registry (ensure-sources (read-core core-dir)
                                                  core-dir
                                                  &seed)]
                  ; the program is a source of its own, so its spans are
                  ; positions in its own file
                  (set! registry
                        (Array.push-back registry
                                         (ModuleSource.init @"__input__"
                                                            (String.copy input)
                                                            (String.copy &source))))
                  (set! registry
                        (Array.push-back registry
                                         (ModuleSource.init @root-name
                                                            @root-name
                                                            @&root-text)))
                  (phase! "sources-ready")
                  ; a debug build turns spans into lines after loading, when
                  ; the registry is gone, so keep a copy of the texts
                  (when-do *want-source-map*
                    (set! *source-map-files* [])
                    (set! *source-map-texts* [])
                    (for [i 0 (Array.length &registry)]
                      (let-do [entry (Array.unsafe-nth &registry i)]
                        (Array.push-back! &*source-map-files*
                                          (String.copy (ModuleSource.file entry)))
                        (Array.push-back! &*source-map-texts*
                                          (String.copy (ModuleSource.text entry))))))
                  (match (ModuleLoader.load &registry &(String.copy root-name))
                    (Result.Error e)
                      (do
                        (report-error
                          &(String.append "cannot load: "
                                          (ModuleError.message &e)))
                        (the (Maybe (Pair SurfaceModule String)) (Maybe.Nothing)))
                    (Result.Success loaded)
                      (let-do [_ignored-phase (phase! "loaded")
                               ;; the prelude is written against Core's
                               ;; `slice`; a program without Core has none
                               module (if no-core
                                 loaded
                                 (ModuleLoader.with-compiler-prelude &loaded))]
                        (Maybe.Just (Pair.init module source))))))))))

(doc effective-core-dir "returns the Core directory: `core-dir` if given, else
`$CARP_DIR/core`.")
(defn effective-core-dir [core-dir]
  (match-ref core-dir
    (Maybe.Just dir) (Maybe.Just @dir)
    (Maybe.Nothing)
      (match (IO.getenv "CARP_DIR")
        (Maybe.Just root)
          (if (String.empty? &root)
            (Maybe.Nothing)
            (Maybe.Just (String.append &root "/core")))
        (Maybe.Nothing) (Maybe.Nothing))))

(doc project-binary "returns the path of the executable the program builds:
`<output-directory>/<title>` from its project configuration. It creates the
directory.")
(defn project-binary []
  (let-do [directory (CtEval.project-string "output-directory")]
    (ignore (System.system &(fmt "mkdir -p '%s'" &directory)))
    (fmt "%s/%s" &directory &(CtEval.project-string "title"))))
