(load "../../carp-session/carp-session.carp")
(load "https://github.com/replikativ/carp-bencode@55675b974b5ca5dc7e7d2df6214c75e39ccde32f")
(load "https://github.com/carpentry-org/socket@0.2.4")
(Project.no-echo)

;; Native, sequential nREPL: no Clojure or JVM is embedded in this process.
(deftype NreplSession
  [id String compiler (Box CompilerSession) alive (Array Bool)])

(deftype NativeRun [ok Bool output String error String])

;; Compiles and executes one emitted C cell without involving a shell. Source,
;; output paths, and argv entries are passed directly to libc/POSIX APIs.
(deftemplate native-run
  (Fn [&String &String] NativeRun)
  "#include <errno.h>\n#include <fcntl.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <sys/types.h>\n#include <sys/wait.h>\n#include <unistd.h>\nNativeRun $NAME(String const *source, String const *core)"
  "$DECL {
  NativeRun result;
  result.ok = false;
  result.output = String_from_MINUS_cstr(\"\");
  result.error = String_from_MINUS_cstr(\"native execution failed\");
  char directory[] = \"/tmp/metacarp-nrepl-XXXXXX\";
  if (mkdtemp(directory) == NULL) return result;
  char source_path[512];
  char executable_path[512];
  snprintf(source_path, sizeof(source_path), \"%s/cell.c\", directory);
  snprintf(executable_path, sizeof(executable_path), \"%s/cell\", directory);
  FILE *file = fopen(source_path, \"wb\");
  if (file == NULL) { rmdir(directory); return result; }
  size_t source_len = strlen(*source);
  bool wrote_source = fwrite(*source, 1, source_len, file) == source_len;
  bool closed_source = fclose(file) == 0;
  if (!wrote_source || !closed_source) {
    unlink(source_path); rmdir(directory); return result;
  }

  int compile_pipe[2];
  if (pipe(compile_pipe) != 0) {
    unlink(source_path); rmdir(directory); return result;
  }
  pid_t compiler = fork();
  if (compiler == 0) {
    close(compile_pipe[0]);
    dup2(compile_pipe[1], STDOUT_FILENO);
    dup2(compile_pipe[1], STDERR_FILENO);
    close(compile_pipe[1]);
    execlp(\"cc\", \"cc\", \"-std=c99\", \"-D_DEFAULT_SOURCE\",
           \"-I\", *core, \"-o\", executable_path, source_path, \"-lm\",
           (char *)NULL);
    _exit(127);
  }
  close(compile_pipe[1]);
  size_t capacity = 4096, length = 0;
  char *captured = malloc(capacity);
  if (captured == NULL) capacity = 0;
  char chunk[4096];
  ssize_t count;
  while ((count = read(compile_pipe[0], chunk, sizeof(chunk))) > 0) {
    if (length + (size_t)count + 1 > capacity) {
      size_t next = capacity == 0 ? 4096 : capacity;
      while (next < length + (size_t)count + 1) next *= 2;
      char *grown = realloc(captured, next);
      if (grown == NULL) { free(captured); captured = NULL; capacity = 0; break; }
      captured = grown; capacity = next;
    }
    memcpy(captured + length, chunk, (size_t)count);
    length += (size_t)count;
  }
  close(compile_pipe[0]);
  int compile_status = 0;
  if (compiler < 0 || waitpid(compiler, &compile_status, 0) < 0 ||
      !WIFEXITED(compile_status) || WEXITSTATUS(compile_status) != 0) {
    if (captured != NULL) captured[length] = '\\0';
    String_delete(result.error);
    result.error = String_from_MINUS_cstr(captured == NULL ? \"C compiler failed\" : captured);
    free(captured); unlink(source_path); unlink(executable_path); rmdir(directory);
    return result;
  }
  free(captured);

  int run_pipe[2];
  if (pipe(run_pipe) != 0) {
    unlink(source_path); unlink(executable_path); rmdir(directory); return result;
  }
  pid_t child = fork();
  if (child == 0) {
    close(run_pipe[0]);
    dup2(run_pipe[1], STDOUT_FILENO);
    dup2(run_pipe[1], STDERR_FILENO);
    close(run_pipe[1]);
    execl(executable_path, executable_path, (char *)NULL);
    _exit(127);
  }
  close(run_pipe[1]);
  capacity = 4096; length = 0; captured = malloc(capacity);
  if (captured == NULL) capacity = 0;
  while ((count = read(run_pipe[0], chunk, sizeof(chunk))) > 0) {
    if (length + (size_t)count + 1 > capacity) {
      size_t next = capacity == 0 ? 4096 : capacity;
      while (next < length + (size_t)count + 1) next *= 2;
      char *grown = realloc(captured, next);
      if (grown == NULL) { free(captured); captured = NULL; capacity = 0; break; }
      captured = grown; capacity = next;
    }
    memcpy(captured + length, chunk, (size_t)count);
    length += (size_t)count;
  }
  close(run_pipe[0]);
  int run_status = 0;
  bool ran = child >= 0 && waitpid(child, &run_status, 0) >= 0 &&
             WIFEXITED(run_status) && WEXITSTATUS(run_status) == 0;
  if (captured != NULL) captured[length] = '\\0';
  if (ran) {
    result.ok = true;
    String_delete(result.output);
    result.output = String_from_MINUS_cstr(captured == NULL ? \"\" : captured);
    String_delete(result.error);
    result.error = String_from_MINUS_cstr(\"\");
  } else {
    String_delete(result.error);
    result.error = String_from_MINUS_cstr(captured == NULL ? \"native cell failed\" : captured);
  }
  free(captured); unlink(source_path); unlink(executable_path); rmdir(directory);
  return result;
}")

(deftemplate write-port-file
  (Fn [&String Int] Bool)
  "#include <stdio.h>\nbool $NAME(String const *path, int port)"
  "$DECL {
  FILE *file = fopen(*path, \"wb\");
  if (file == NULL) return false;
  bool ok = fprintf(file, \"%d\\n\", port) > 0;
  return fclose(file) == 0 && ok;
}")

(defn btext [value]
  (Box.init (BencodeValue.Bytes (String.to-bytes value))))
(defn bvalues [values] (Box.init (BencodeValue.Values values)))
(defn bentries [entries] (Box.init (BencodeValue.Entries entries)))
(defn bentry [key value] (Pair.init (String.to-bytes key) value))
(sig bstatus (Fn [&(Array String)] (Box BencodeValue)))
(defn bstatus [values]
  (let-do [result (the (Array (Box BencodeValue)) [])]
    (for [i 0 (Array.length values)]
      (Array.push-back! &result (btext (Array.unsafe-nth values i))))
    (bvalues result)))

(defn bytes-text=? [bytes expected]
  (String.= &(String.from-bytes &(Array.copy bytes)) expected))

(defn dict-field [dictionary key]
  (let-do [result (the (Maybe (Box BencodeValue)) (Maybe.Nothing))]
    (match-ref dictionary
      (BencodeValue.Entries entries)
        (for [i 0 (Array.length entries)]
          (let [entry (Array.unsafe-nth entries i)]
            (when (bytes-text=? (Pair.a entry) key)
              (set! result (Maybe.Just (Box.copy (Pair.b entry)))))))
      _ ())
    result))

(defn text-field [dictionary key]
  (match (dict-field dictionary key)
    (Maybe.Nothing) (the (Maybe String) (Maybe.Nothing))
    (Maybe.Just value)
      (match-ref (Box.peek &value)
        (BencodeValue.Bytes bytes)
          (Maybe.Just (String.from-bytes &(Array.copy bytes)))
        _ (the (Maybe String) (Maybe.Nothing)))))

(defn append-request-field! [entries request key]
  (match (text-field request key)
    (Maybe.Just value) (Array.push-back! entries (bentry key (btext &value)))
    (Maybe.Nothing) ()))

(sig response-value
  (Fn [&BencodeValue
       (Array (Pair (Array Byte) (Box BencodeValue)))
       &(Array String)]
      BencodeValue))
(defn response-value [request fields statuses]
  (let-do [entries fields]
    (append-request-field! &entries request "id")
    (append-request-field! &entries request "session")
    (when (> (Array.length statuses) 0)
      (Array.push-back! &entries (bentry "status" (bstatus statuses))))
    (BencodeValue.Entries entries)))

(defn send-all [stream bytes]
  (let-do [offset 0 ok true]
    (while (and ok (< offset (Array.length bytes)))
      (let [remaining (Array.slice bytes offset (Array.length bytes))]
        (match (TcpStream.send-bytes stream &remaining)
          (Result.Error _) (set! ok false)
          (Result.Success sent)
            (if (<= sent 0) (set! ok false) (set! offset (+ offset sent))))))
    ok))

(sig send-response
  (Fn [&TcpStream &BencodeValue
       (Array (Pair (Array Byte) (Box BencodeValue)))
       &(Array String)]
      Bool))
(defn send-response [stream request fields statuses]
  (let [response (response-value request fields statuses)]
    (match (Bencode.encode &response)
      (Result.Success bytes) (send-all stream &bytes)
      (Result.Error _) false)))
(defn send-done [stream request fields]
  (let [statuses [(String.copy "done")]]
    (send-response stream request fields &statuses)))
(defn send-error [stream request kind message]
  (let [statuses [(String.copy "error") (String.copy kind) (String.copy "done")]]
    (send-response stream request [(bentry "err" (btext message))] &statuses)))

(defn incomplete? [error]
  (match-ref error (BencodeError.UnexpectedEnd _) true _ false))

(defn read-message [stream initial]
  (let-do [buffer initial done false
           result (the (Result (Pair (Box BencodeValue) (Array Byte)) String)
                       (Result.Error (String.copy "connection closed")))]
    (while (not done)
      (if (= (Array.length &buffer) 0)
        (match (TcpStream.read-append stream &buffer)
          (Result.Error error)
            (do (set! result (Result.Error error)) (set! done true))
          (Result.Success count)
            (when (= count 0)
              (do (set! result (Result.Error (String.copy "connection closed")))
                  (set! done true))))
        (match (Bencode.decode-prefix &buffer)
          (Result.Success decoded)
            (match decoded
              (BencodeDecoded.BencodeDecoded value next _)
                (do (set! result
                      (Result.Success
                        (Pair.init value
                          (Array.slice &buffer next (Array.length &buffer)))))
                    (set! done true)))
          (Result.Error error)
            (if (incomplete? &error)
              (match (TcpStream.read-append stream &buffer)
                (Result.Error message)
                  (do (set! result (Result.Error message)) (set! done true))
                (Result.Success count)
                  (when (= count 0)
                    (do (set! result
                          (Result.Error (String.copy "truncated bencode")))
                        (set! done true))))
              (do (set! result (Result.Error (String.copy "invalid bencode")))
                  (set! done true))))))
    result))

(defn session-index [sessions id]
  (let-do [result -1]
    (for [i 0 (Array.length sessions)]
      (let [entry (Box.peek (Array.unsafe-nth sessions i))]
        (when (and @(Array.unsafe-nth (NreplSession.alive entry) 0)
                   (String.= (NreplSession.id entry) id))
          (set! result i))))
    result))
(defn requested-session-index [sessions request]
  (match (text-field request "session")
    (Maybe.Just id) (session-index sessions &id)
    (Maybe.Nothing) 0))
(defn compiler-at [sessions index]
  (Box.peek (NreplSession.compiler
    (Box.peek (Array.unsafe-nth sessions index)))))

(defn definition-kind [kind]
  (match-ref kind
    (SessionDefKind.Function) (String.copy "function")
    (SessionDefKind.Value) (String.copy "value")
    (SessionDefKind.External) (String.copy "external")
    (SessionDefKind.Interface) (String.copy "interface")
    (SessionDefKind.Other label) (String.copy label)))
(defn definition-text [definition]
  (String.concat &[(String.copy (SessionDefInfo.name definition))
                   (String.copy " : ")
                   (String.copy (SessionDefInfo.scheme definition))]))
(defn definitions-text [definitions]
  (let-do [parts (the (Array String) [])]
    (for [i 0 (Array.length definitions)]
      (Array.push-back! &parts (definition-text (Array.unsafe-nth definitions i))))
    (String.join "\n" &parts)))
(defn last-expression-type [report]
  (let [expressions (CellReport.expressions report)]
    (if (= (Array.length expressions) 0) (String.copy "")
      (String.copy (SessionTypedEntity.type
        (Array.unsafe-nth expressions (dec (Array.length expressions))))))))
(defn diagnostic-response [stream request diagnostic]
  (let [statuses [(String.copy "eval-error") (String.copy "done")]]
    (send-response stream request
      [(bentry "err" (btext (Diagnostic.message diagnostic)))
       (bentry "ex" (btext (Diagnostic.phase diagnostic)))]
      &statuses)))

(defn native-error-response [stream request message]
  (let [statuses [(String.copy "eval-error") (String.copy "done")]]
    (send-response stream request
      [(bentry "err" (btext message))
       (bentry "ex" (btext "native"))]
      &statuses)))

(defn chomp [text]
  (if (and (> (String.length text) 0) (String.ends-with? text "\n"))
    (String.slice text 0 (dec (String.length text)))
    (String.copy text)))

(defn eval-request [sessions stream request]
  (let [index (requested-session-index sessions request)]
    (if (< index 0)
      (send-error stream request "unknown-session" "unknown nREPL session")
      (match (text-field request "code")
        (Maybe.Nothing)
          (send-error stream request "invalid-request" "eval requires code")
        (Maybe.Just code)
          (let [source-id (match (text-field request "file")
                            (Maybe.Just file) file
                            (Maybe.Nothing)
                              (match (text-field request "id")
                                (Maybe.Just id) (String.concat &[@"nrepl:" id])
                                (Maybe.Nothing) (String.copy "nrepl:eval")))
                input (SourceInput.init source-id code)
                compiler (compiler-at sessions index)]
            (match (Session.infer-cell compiler &input)
              (Result.Error diagnostic)
                (diagnostic-response stream request &diagnostic)
              (Result.Success report)
                (match (Session.emit-cell compiler &input)
                  (Result.Error diagnostic)
                    (diagnostic-response stream request &diagnostic)
                  (Result.Success c)
                    (let [dir (core-dir) run (native-run &c &dir)]
                      (if (not @(NativeRun.ok &run))
                        (native-error-response stream request
                                               (NativeRun.error &run))
                        (if (> (Array.length (CellReport.definitions &report)) 0)
                          (match (if (= (Array.length
                                          (CellReport.definitions &report)) 1)
                                   (match (Session.upsert compiler &input)
                                     (Result.Success upsert)
                                       (Result.Success
                                         [(SessionDefInfo.copy
                                            (UpsertReport.definition &upsert))])
                                     (Result.Error diagnostic)
                                       (Result.Error diagnostic))
                                   (Session.upsert-input compiler &input))
                            (Result.Error diagnostic)
                              (diagnostic-response stream request &diagnostic)
                            (Result.Success definitions)
                              (send-done stream request
                                [(bentry "ns" (btext "carp"))
                                 (bentry "value"
                                   (btext &(definitions-text &definitions)))]))
                          (let [value (chomp (NativeRun.output &run))]
                            (send-done stream request
                              [(bentry "ns" (btext "carp"))
                               (bentry "value" (btext &value))]))))))))))))

(defn load-file-request [sessions stream request]
  (let [index (requested-session-index sessions request)]
    (if (< index 0)
      (send-error stream request "unknown-session" "unknown nREPL session")
      (match (text-field request "file")
        (Maybe.Nothing)
          (send-error stream request "invalid-request" "load-file requires file")
        (Maybe.Just source)
          (let [source-id (match (text-field request "file-path")
                            (Maybe.Just path) path
                            (Maybe.Nothing) (String.copy "nrepl:load-file"))
                input (SourceInput.init source-id source)]
            (match (Session.upsert-input (compiler-at sessions index) &input)
              (Result.Error diagnostic) (diagnostic-response stream request &diagnostic)
              (Result.Success definitions)
                (send-done stream request
                  [(bentry "ns" (btext "carp"))
                   (bentry "value" (btext &(definitions-text &definitions)))])))))))

(defn completion-value [candidate]
  (let-do [fields [(bentry "candidate" (btext (Candidate.name candidate)))
                   (bentry "ns" (btext "carp"))
                   (bentry "type" (btext &(definition-kind (Candidate.kind candidate))))
                   (bentry "arglists" (btext (Candidate.scheme candidate)))]]
    (match-ref (Candidate.documentation candidate)
      (Maybe.Just documentation)
        (Array.push-back! &fields (bentry "doc" (btext documentation)))
      (Maybe.Nothing) ())
    (bentries fields)))

(defn complete-request [sessions stream request]
  (let [index (requested-session-index sessions request)]
    (if (< index 0)
      (send-error stream request "unknown-session" "unknown nREPL session")
      (let [prefix (match (text-field request "prefix")
                     (Maybe.Just value) value
                     (Maybe.Nothing)
                       (match (text-field request "symbol")
                         (Maybe.Just value) value
                         (Maybe.Nothing) (String.copy "")))
            candidates (Session.complete (compiler-at sessions index) &prefix)
            values (the (Array (Box BencodeValue)) [])]
        (do (for [i 0 (Array.length &candidates)]
              (Array.push-back! &values
                (completion-value (Array.unsafe-nth &candidates i))))
            (send-done stream request
              [(bentry "completions" (bvalues values))]))))))

(defn lookup-request [sessions stream request]
  (let [index (requested-session-index sessions request)]
    (if (< index 0)
      (send-error stream request "unknown-session" "unknown nREPL session")
      (match (text-field request "sym")
        (Maybe.Nothing)
          (send-error stream request "invalid-request" "lookup requires sym")
        (Maybe.Just name)
          (match (Session.doc (compiler-at sessions index) &name)
            (Maybe.Nothing) (send-done stream request [])
            (Maybe.Just info)
              (send-done stream request
                [(bentry "name" (btext (DocInfo.name &info)))
                 (bentry "ns" (btext "carp"))
                 (bentry "doc" (btext (DocInfo.documentation &info)))
                 (bentry "arglists-str" (btext (DocInfo.scheme &info)))]))))))

(defn describe-request [stream request]
  (let [empty (bentries [])
        ops (bentries [(bentry "clone" (Box.copy &empty))
                       (bentry "close" (Box.copy &empty))
                       (bentry "complete" (Box.copy &empty))
                       (bentry "completions" (Box.copy &empty))
                       (bentry "describe" (Box.copy &empty))
                       (bentry "eval" (Box.copy &empty))
                       (bentry "load-file" (Box.copy &empty))
                       (bentry "lookup" (Box.copy &empty))
                       (bentry "ls-sessions" (Box.copy &empty))])
        versions (bentries
          [(bentry "nrepl" (bentries [(bentry "major" (btext "1"))
                                      (bentry "minor" (btext "0"))]))
           (bentry "carp" (bentries [(bentry "session-api"
             (btext &(Int.str (Session.api-version))))]))])]
    (send-done stream request [(bentry "aux" empty)
                               (bentry "ops" ops)
                               (bentry "versions" versions)])))

(defn clone-request [sessions counter stream request]
  (let [index (requested-session-index sessions request)]
    (if (< index 0)
      (send-error stream request "unknown-session" "unknown nREPL session")
      (let-do [next @(Array.unsafe-nth counter 0)
               id (fmt "carp-%d" next)
               clone (Session.fork (compiler-at sessions index))]
        (Array.aset! counter 0 (inc next))
        (Array.push-back! sessions
          (Box.init (NreplSession.init (String.copy &id) (Box.init clone) [true])))
        (send-done stream request [(bentry "new-session" (btext &id))])))))

(defn close-request [sessions stream request]
  (match (text-field request "session")
    (Maybe.Nothing)
      (send-error stream request "invalid-request" "close requires session")
    (Maybe.Just id)
      (let [index (session-index sessions &id)]
        (if (<= index 0)
          (send-error stream request "unknown-session" "unknown nREPL session")
          (let [entry (Box.peek (Array.unsafe-nth sessions index))]
            (do (Array.aset! (NreplSession.alive entry) 0 false)
                (send-done stream request [])))))))

(defn ls-sessions-request [sessions stream request]
  (let-do [values (the (Array (Box BencodeValue)) [])]
    (for [i 0 (Array.length sessions)]
      (let [entry (Box.peek (Array.unsafe-nth sessions i))]
        (when @(Array.unsafe-nth (NreplSession.alive entry) 0)
          (Array.push-back! &values (btext (NreplSession.id entry))))))
    (send-done stream request [(bentry "sessions" (bvalues values))])))

(defn dispatch [sessions counter stream request]
  (match (text-field request "op")
    (Maybe.Nothing)
      (send-error stream request "invalid-request" "request requires op")
    (Maybe.Just operation)
      (cond
        (String.= &operation "describe") (describe-request stream request)
        (String.= &operation "clone") (clone-request sessions counter stream request)
        (String.= &operation "close") (close-request sessions stream request)
        (String.= &operation "ls-sessions") (ls-sessions-request sessions stream request)
        (String.= &operation "eval") (eval-request sessions stream request)
        (String.= &operation "load-file") (load-file-request sessions stream request)
        (or (String.= &operation "complete") (String.= &operation "completions"))
          (complete-request sessions stream request)
        (String.= &operation "lookup") (lookup-request sessions stream request)
        (send-error stream request "unknown-op" "unsupported nREPL operation"))))

(defn serve-client [sessions counter stream]
  (let-do [buffer (the (Array Byte) []) running true]
    (while running
      (match (read-message stream buffer)
        (Result.Error _) (set! running false)
        (Result.Success message)
          (do (set! buffer @(Pair.b &message))
              (unless (dispatch sessions counter stream (Box.peek (Pair.a &message)))
                (set! running false)))))
    (TcpStream.close! stream)))

(defn serve [session address port]
  (match (TcpListener.bind address port)
    (Result.Error error) (IO.errorln &error)
    (Result.Success listener)
      (let-do [sessions [(Box.init (NreplSession.init (String.copy "default")
                                                       (Box.init session) [true]))]
               counter [1]
               actual-port (TcpListener.local-port &listener)
               port-file (match (IO.getenv "CARP_NREPL_PORT_FILE")
                           (Maybe.Just path) path
                           (Maybe.Nothing) (String.copy ".nrepl-port"))]
        (do (unless (write-port-file &port-file actual-port)
              (IO.errorln "unable to write nREPL port file"))
            (IO.println &(fmt
              "nREPL server started on port %d on host %s - nrepl://%s:%d"
              actual-port address address actual-port))
            (while true
              (match (TcpListener.accept &listener)
                (Result.Error error) (IO.errorln &error)
                (Result.Success client) (serve-client &sessions &counter &client)))
            (TcpListener.close listener)))))

(defn core-dir []
  (match (IO.getenv "CARP_DIR")
    (Maybe.Just root)
      (if (or (String.ends-with? &root "/core")
              (String.ends-with? &root "/core/")) root
        (String.append &root (if (String.ends-with? &root "/") "core" "/core")))
    (Maybe.Nothing) (String.copy "../Carp/core")))
(defn configured-port []
  (match (IO.getenv "CARP_NREPL_PORT")
    (Maybe.Just value)
      (match (Int.from-string &value)
        (Maybe.Just port) port (Maybe.Nothing) 0)
    (Maybe.Nothing) 0))
(defn main []
  (let [dir (core-dir)]
    (match (Session.create &dir)
      (Result.Success session) (serve session "127.0.0.1" (configured-port))
      (Result.Error diagnostic)
        (do (IO.errorln (Diagnostic.phase &diagnostic))
            (IO.errorln (Diagnostic.message &diagnostic))))))
