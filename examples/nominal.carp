(deftype Signal
  (Code [Bool Int])
  (End))

(deftemplate emit
             (Fn [Int] ())
             "void $NAME(int codepoint)"
             "$DECL { putchar(codepoint); }")

(defn code [signal] (match signal (Signal.Code _ value) value (Signal.End) 0))

(emit (code (Signal.Code true 71)))
(emit 10)
