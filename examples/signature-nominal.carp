(deftype Inner
  (Value [Int])
  (Empty))

(deftype Outer
  (Wrap [Inner])
  (Other))

(deftemplate make-outer (Fn [] Outer) "Outer $NAME(void)" "$DECL {
  Outer outer;
  outer.tag = 0;
  outer.data.variant_0.member_0.tag = 0;
  outer.data.variant_0.member_0.data.variant_0.member_0 = 82;
  return outer;
}")

(deftemplate emit
             (Fn [Int] ())
             "void $NAME(int codepoint)"
             "$DECL { putchar(codepoint); }")

(defn code [outer]
  (match outer
    (Outer.Wrap (Inner.Value value)) value
    (Outer.Wrap (Inner.Empty)) 69
    (Outer.Other) 79))

(emit (code (make-outer)))
(emit 10)
