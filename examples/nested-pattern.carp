(deftype Inner
  (Value [Int])
  (Empty))

(deftype Outer
  (Wrap [Inner])
  (Other))

(deftemplate emit
             (Fn [Int] ())
             "void $NAME(int codepoint)"
             "$DECL { putchar(codepoint); }")

(defn code [outer]
  (match outer
    (Outer.Wrap (Inner.Value value)) value
    (Outer.Wrap (Inner.Empty)) 69
    (Outer.Other) 79))

(emit (code (Outer.Wrap (Inner.Value 78))))
(emit 10)
