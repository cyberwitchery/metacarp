(deftype (Choice a)
  (Some [a])
  (None))

(deftemplate emit
             (Fn [Int] ())
             "void $NAME(int codepoint)"
             "$DECL { putchar(codepoint); }")

(defn int-code [choice] (match choice (Choice.Some value) value (Choice.None) 0))

(defn bool-code [choice]
  (match choice (Choice.Some value) (if value 84 70) (Choice.None) 78))

(emit (int-code (Choice.Some 73)))
(emit (bool-code (Choice.Some true)))
(emit 10)
