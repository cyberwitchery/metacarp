(load "../carp-resolve.carp")
(load "../../carp-surface/editing.carp")
(load "Test.carp")
(Project.no-echo)
(use-all Test)

(defn observe [source]
  (let [input (SourceInput.init @"tooling:test" (String.copy source))
        editing (Surface.editing-input &input)
        sourced (SourcedSurfaceModule.init (SourceInput.copy &input)
                                           @(EditingSurfaceModule.module &editing))
        globals (PrimitiveRegistry.globals)
        allocator (IdAllocator.init [0])
        snapshot (ResolveSnapshot.init globals [])]
    (Resolve.observe-against &sourced &allocator &snapshot &[] "ambient")))

(defn has-use? [observed role name start]
  (let-do [uses (ResolutionObservations.uses
             (ObservedResolution.observations observed))
           found false]
    (for [i 0 (Array.length uses)]
      (let [use (Array.unsafe-nth uses i)]
        (when (and
            (String.= (ResolvedSourceUse.role use) role)
            (and
              (String.= (ResolvedSourceUse.name use) name)
              (Int.= @(SourceSpan.start (ResolvedSourceUse.span use)) start)))
          (set! found true))))
    found))

(defn scope-has? [observed position name]
  (let-do [scopes (ResolutionObservations.scopes
             (ObservedResolution.observations observed))
           found false]
    (for [i 0 (Array.length scopes)]
      (let [scope (Array.unsafe-nth scopes i)
            span (ResolvedSourceScope.span scope)
            locals (ResolvedSourceScope.locals scope)]
        (when (and
            (Int.<= @(SourceSpan.start span) position)
            (Int.>= @(SourceSpan.end span) position))
          (for [j 0 (Array.length locals)]
            (when (String.= (CoreRef.name (Array.unsafe-nth locals j)) name)
              (set! found true))))))
    found))

(defn has-type-head? [observed name arity]
  (let-do [heads (ResolutionObservations.type-heads
             (ObservedResolution.observations observed))
           found false]
    (for [i 0 (Array.length heads)]
      (let [head (Array.unsafe-nth heads i)]
        (when (and
            (String.= name (ResolvedTypeHead.name head))
            (Int.= arity @(ResolvedTypeHead.arity head)))
          (set! found true))))
    found))

(deftest test
  (assert-true test
    (has-use? &(observe "(let [if 1] if)") "reference" "if" 12)
    "a binding named if is a resolved reference in expression position")
  (assert-true test
    (has-use? &(observe "(if true 1 2)") "syntax" "if" 1)
    "special-form classification comes from the selected resolver branch")
  (assert-true test
    (has-use? &(observe "(let [x 1] (do x missing))") "reference" "x" 15)
    "an error preserves previously established binding facts")
  (assert-true test
    (scope-has? &(observe "(let [x 1] x") 11 "x")
    "a missing closing delimiter preserves lexical scope")
  (assert-true test
    (scope-has? &(observe "(fn [x]") 7 "x")
    "a function with an absent body still exposes its parameters for editing")
  (assert-true test
    (scope-has? &(observe "(fn [x])") 7 "x")
    "a missing body has parameter scope before an existing closer")
  (assert-true test
    (scope-has? &(observe "(let [x 1] )") 10 "x")
    "the let body scope includes whitespace after the binding array")
  (assert-true test
    (has-type-head?
      &(observe "(do (deftype (Pending a) [value a]) (the Pend))")
      "Pending"
      1)
    "partial analysis retains a declared generic type's canonical head and arity")
  (assert-false test
    (has-type-head? &(observe "(def ValueOnly 1)") "ValueOnly" 0)
    "value bindings cannot become type identities"))
