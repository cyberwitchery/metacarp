(load "../carp-surface/carp-surface.carp")
(load "../carp-ir/carp-ir.carp")
(load "../carp-primitives/carp-primitives.carp")

(doc ResolveError "is a resolution error. `message` describes it and `span` is
where it points.")
(deftype ResolveError [message String
                       span SurfaceSpan])

(doc FunctionShape "is a collected function definition. `name` is its qualified
name and `scope` the module it is in. `parameters` and `body` are its syntax.
`span` is the definition's span and `parameters-span` the span of its parameter
list. `stamp` is the type-declaration count at the definition. `withs` holds the
modules of the `with` forms around it.")
(deftype FunctionShape
  [name String
   scope String
   parameters (Array (Box SurfaceNode))
   body (Box SurfaceNode)
   span SurfaceSpan
   stamp Int
   withs (Array String)
   parameters-span SurfaceSpan])

(doc ValueShape "is a collected value definition. The fields are as in
`FunctionShape`.")
(deftype ValueShape
  [name String
   scope String
   body (Box SurfaceNode)
   span SurfaceSpan
   stamp Int
   withs (Array String)])

(doc TypedShape "is a collected declaration with a type: a builtin, a signature
or an interface. `name` is its qualified name and `signature` its type syntax.
`payload` is a builtin's declaration, if any. `span` and `stamp` are as in
`FunctionShape`.")
(deftype TypedShape
  [name String
   signature (Box SurfaceNode)
   payload (Maybe CoreBuiltinPayload)
   span SurfaceSpan
   stamp Int])

(doc TypeDeclarationShape "is a collected type declaration. `name` is its
qualified name. `representation` is the C name of a registered type, if any.
`fields` is its field syntax, if any. `span` and `stamp` are as in
`FunctionShape`.")
(deftype TypeDeclarationShape
  [name String
   representation (Maybe String)
   fields (Maybe (Box SurfaceNode))
   span SurfaceSpan
   stamp Int])

(doc ImplementationShape "is a collected `implements` form. `interface-name`
names the interface and `implementation-name` the function. `span` and `stamp`
are as in `FunctionShape`.")
(deftype ImplementationShape
  [interface-name String
   implementation-name String
   span SurfaceSpan
   stamp Int])

(doc ScopedExpression "is a collected top-level expression. `node` is its syntax
and `scope` the module it is in. `stamp` and `withs` are as in `FunctionShape`.")
(deftype ScopedExpression
  [node (Box SurfaceNode)
   scope String
   stamp Int
   withs (Array String)])

(doc TypeDeclEvent "is one `deftype` or `register-type` in source order. `form`
is the form, `scope` the module it is in, `stamp` the type-declaration count at
it, and `name` the qualified type name.")
(deftype TypeDeclEvent
  [form (Box SurfaceNode)
   scope String
   stamp Int
   name String])

(doc ScopedImport "is a `use` of the module `module-name` inside the module
`scope`.")
(deftype ScopedImport [scope String
                       module-name String])

(doc ModuleShape "is a `defmodule` form. `name` is the module name, `body` its
forms and `span` its span.")
(deftype ModuleShape
  [name String
   body (Array (Box SurfaceNode))
   span SurfaceSpan])

(doc ResolvedConstructors "is the bindings that type declarations derive.
`globals` holds their references, `builtins` the ones that are builtins, and
`declarations` the constructor declarations.")
(deftype ResolvedConstructors
  [globals (Array CoreRef)
   builtins (Array CoreBuiltin)
   declarations (Array CoreConstructorDeclaration)])

(doc CollectedForms "is what collection finds in a module. `functions`,
`values`, `builtins`, `signatures`, `type-declarations`, `interfaces` and
`implementations` hold the collected definitions. `recursive-types` holds the
types a `(recursive T)` form flags. `imports` holds the `use`s,
`system-includes` the system includes and `expressions` the top-level
expressions. `globals` holds every global binding.")
(deftype CollectedForms
  [functions (Array FunctionShape)
   values (Array ValueShape)
   builtins (Array TypedShape)
   signatures (Array TypedShape)
   type-declarations (Array TypeDeclarationShape)
   recursive-types (Array String)
   interfaces (Array TypedShape)
   implementations (Array ImplementationShape)
   imports (Array ScopedImport)
   system-includes (Array String)
   expressions (Array ScopedExpression)
   globals (Array CoreRef)])

(doc ResolveSnapshot "is the resolution environment of a base module, to resolve
later sources against. `globals` holds its global bindings and `imports` its
`use`s. `recursive-types` holds its recursive types. New declarations get fresh
global ids.")
(deftype ResolveSnapshot
  [globals (Array CoreRef)
   imports (Array ScopedImport)
   recursive-types (Array String)])

(doc *local-binder-serial* "numbers the local binders of the current resolution.
It is reset for each resolution, so local ids depend only on the module.")
(def *local-binder-serial* 0)
(doc *resolve-type-depth* "is how deeply nested the type being resolved is.")
(def *resolve-type-depth* 0)
(doc *resolve-type-parameters* "holds the type parameters met in the outermost
type being resolved, for editing observations.")
(def *resolve-type-parameters* (the (Array SourceLexicalBinding) []))

(doc *resolve-arities* "maps each callable name of the module to its arity, to
choose among candidates of the same name.")
(def *resolve-arities* (the (Map String Int) (Map.create)))

(doc *overloads* "holds the overloads that ambiguous bare names resolve to. A
name that stays ambiguous resolves to an overload over its candidates, which
inference narrows by type.")
(def *overloads* (the (Array CoreOverload) []))

(doc *private-names* "holds the qualified names declared private. A private
binding may only be referenced from inside the module that defines it, or its
submodules.")
(def *private-names* (the (Set String) (Set.create)))

(doc *definition-names* "holds the qualified names that the module defines
itself, with `defn`, `def`, `register`, `deftemplate` or `definterface`. Such a
definition shadows a binding of the same name that a type declaration derives.")
(def *definition-names* (the (Map String Int) (Map.create)))

(doc *type-decl-stamp* "counts the type declarations met so far. Each collected
definition records the count at its position. A type declared k times becomes k
types: the last keeps the plain name and the earlier ones are named
`Name--gen<i>`. A reference binds the type live at its stamp.")
(def *type-decl-stamp* 0)

(doc *collect-withs* "holds the modules of the `with` forms around the form
being collected, innermost last.")
(def *collect-withs* (the (Array String) []))
(doc *type-decl-events* "holds the type declarations of the module, in source
order.")
(def *type-decl-events* (the (Array TypeDeclEvent) []))
(doc *type-redefinitions* "maps each type name declared more than once to the
stamps of its declarations. It is set by `build-type-redefinitions!`.")
(def *type-redefinitions* (the (Array (Pair String (Array Int))) []))
(doc *resolve-stamp* "is the stamp of the definition being resolved.")
(def *resolve-stamp* 0)

(doc *provenance-enabled* "is whether resolution records provenance for a
session. Without it, expression ids are numbered per owner.")
(def *provenance-enabled* false)
(doc *provenance-source-id* "is the id of the source being resolved.")
(def *provenance-source-id* (String.copy ""))
(doc *provenance-next-node-id* "is the next node id to give out.")
(def *provenance-next-node-id* 0)
(doc *provenance-nodes* "holds the span of each node.")
(def *provenance-nodes* (the (Array NodeProvenance) []))
(doc *provenance-bindings* "holds the span of each binding.")
(def *provenance-bindings* (the (Array BindingProvenance) []))
(doc *provenance-definitions* "holds the span of each definition.")
(def *provenance-definitions* (the (Array BindingProvenance) []))

(doc *resolve-seed-globals* "holds the global bindings a resolution starts with.
Every entry point sets it.")
(def *resolve-seed-globals* (PrimitiveRegistry.globals))
(doc *resolve-seed-imports* "holds the `use`s a resolution starts with. Every
entry point sets it.")
(def *resolve-seed-imports* (the (Array ScopedImport) []))
(doc *resolve-reuse-globals* "holds the global references that the definitions
being resolved may keep, if their names match.")
(def *resolve-reuse-globals* (the (Array CoreRef) []))

(doc *global-name-index* "maps a global name to the position of the last global
with that name.")
(def *global-name-index* (the (Map String Int) (Map.create)))
(doc *global-index-count* "is how many globals `*global-name-index*` covers. A
shorter global table means a new resolution, and the index is rebuilt.")
(def *global-index-count* 0)
(doc *last-resolve-snapshot* "is the resolution environment of the last
resolution that collected its constructors.")
(def *last-resolve-snapshot* (ResolveSnapshot.init [] [] []))

(load "tooling.carp")

(doc Resolve "resolves expanded syntax to core IR: it binds every name to a
global or local reference.")
(defmodule Resolve
  (private source-span)
  (hidden source-span)
  (defn source-span [span] (SurfaceSpan.in-source span &*provenance-source-id*))

  (private record-binding!)
  (hidden record-binding!)
  (defn record-binding! [reference span definition]
    (when-do *provenance-enabled*
      (Array.push-back! &*provenance-bindings*
                        (BindingProvenance.init (CoreRef.copy reference)
                                                (source-span span)))
      (when definition
        (Array.push-back! &*provenance-definitions*
                          (BindingProvenance.init (CoreRef.copy reference)
                                                  (source-span span))))))

  (private error-at)
  (hidden error-at)
  (defn error-at [node message]
    (ResolveError.init message @(SurfaceNode.span node)))

  (doc diagnostic "converts the resolution error `error` into a diagnostic with
phase `resolve`, for the source `source-id`.")
  (defn diagnostic [error source-id]
    (Diagnostic.init (String.copy "resolve")
                     (String.copy (ResolveError.message error))
                     (Maybe.Just
                       (SurfaceSpan.in-source (ResolveError.span error)
                                              source-id))))

  (private symbol-name)
  (hidden symbol-name)
  (defn symbol-name [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.Symbol segments)
        (if (Int.= 1 (Array.length segments))
          (Maybe.Just @(Array.unsafe-nth segments 0))
          (Maybe.Nothing))
      _ (Maybe.Nothing)))

  (private symbol-key)
  (hidden symbol-key)
  (defn symbol-key [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.Symbol segments)
        (if (Int.> (Array.length segments) 0)
          (Maybe.Just (String.join "." segments))
          (Maybe.Nothing))
      _ (Maybe.Nothing)))

  (private qualified-name?)
  (hidden qualified-name?)
  (defn qualified-name? [name] (String.contains? name \.))

  (private append-scope)
  (hidden append-scope)
  (defn append-scope [scope name]
    (if (String.empty? scope)
      (String.copy name)
      (String.concat &[(String.copy scope) @"." (String.copy name)])))

  (private qualify-name)
  (hidden qualify-name)
  (defn qualify-name [scope name]
    (if (or (String.empty? scope) (qualified-name? name))
      (String.copy name)
      (append-scope scope name)))

  (private parent-scope)
  (hidden parent-scope)
  (defn parent-scope [scope]
    (let-do [last-dot -1
             n (String.length scope)]
      (for [i 0 n] (when (Char.= (String.char-at scope i) \.) (set! last-dot i)))
      (if (Int.< last-dot 0) (String.copy "") (String.prefix scope last-dot))))

  (private lowercase-start?)
  (hidden lowercase-start?)
  (defn lowercase-start? [name]
    (and (Int.> (String.length name) 0)
         (let [c (String.char-at name 0)] (and (Char.>= c \a) (Char.<= c \z)))))

  (private variable-name?)
  (hidden variable-name?)
  (doc variable-name? "checks whether `name` names a type variable: it does not
start with an uppercase letter, as in the reference's `isVarName`.")
  (defn variable-name? [name]
    (and (Int.> (String.length name) 0)
         (let [c (String.char-at name 0)]
           (not (and (Char.>= c \A) (Char.<= c \Z))))))

  (private reference-shorthand?)
  (hidden reference-shorthand?)
  (defn reference-shorthand? [name]
    (and (Int.> (String.length name) 1) (Char.= (String.char-at name 0) \&)))

  (private reference-shorthand-name)
  (hidden reference-shorthand-name)
  (defn reference-shorthand-name [name] (String.suffix name 1))

  (private named?)
  (hidden named?)
  (defn named? [node name]
    (match (symbol-name node)
      (Maybe.Just found) (= found name)
      (Maybe.Nothing) false))

  (private semantic-items)
  (hidden semantic-items)
  (defn semantic-items [items]
    (let-do [result (the (Array (Box SurfaceNode)) [])
             n (Array.length items)]
      (for [i 0 n]
        (let [item (Box.peek (Array.unsafe-nth items i))]
          (match-ref (SurfaceNode.form item)
            (SurfaceForm.Comment _) ()
            _
              (set! result
                    (Array.push-back result (Box.init (SurfaceNode.copy item)))))))
      result))

  (private redefinition-index)

  (hidden redefinition-index)

  (defn redefinition-index [name]
    (let-do [result -1
             n (Array.length &*type-redefinitions*)]
      (for [i 0 n]
        (when (and (Int.= result -1)
                   (String.=
                     (Pair.a (Array.unsafe-nth &*type-redefinitions* i))
                     name))
          (set! result i)))
      result))

  (doc generation-count-at "returns how many of `stamps` are at or before
`stamp`, and at least 1, so a site before the first declaration sees generation
1.")

  (private generation-count-at)

  (hidden generation-count-at)

  (defn generation-count-at [stamps stamp]
    (let-do [count 0
             n (Array.length stamps)]
      (for [i 0 n]
        (when (Int.<= @(Array.unsafe-nth stamps i) stamp)
          (set! count (Int.inc count))))
      (Int.max count 1)))

  (private generation-suffixed)

  (hidden generation-suffixed)

  (defn generation-suffixed [name generation]
    (String.concat &[@name @"--gen" (Int.str generation)]))

  (doc generation-type-name "returns the name that a reference at `stamp` to the
type `name` binds: the plain name, unless the type is redefined and the site
sees an earlier generation. The last generation keeps the plain name.")

  (private generation-type-name)

  (hidden generation-type-name)

  (defn generation-type-name [name stamp]
    (let [idx (redefinition-index name)]
      (if (Int.= idx -1)
        @name
        (let [entry (Array.unsafe-nth &*type-redefinitions* idx)
              stamps (Pair.b entry)
              generation (generation-count-at stamps stamp)]
          (if (Int.= generation (Array.length stamps))
            @name
            (generation-suffixed name generation))))))

  (doc generation-qualify "replaces the type prefix of the dotted name `name`,
such as `Bucket.init`, with the generation live at `stamp`. Names without a
redefined type prefix are returned unchanged.")

  (private generation-qualify)

  (hidden generation-qualify)

  (defn generation-qualify [name stamp]
    (let-do [result @name
             n (Array.length &*type-redefinitions*)]
      (for [i 0 n]
        (let [tname (Pair.a (Array.unsafe-nth &*type-redefinitions* i))
              prefix (String.concat &[@tname @"."])]
          (when (String.starts-with? name &prefix)
            (let [replacement (generation-type-name tname stamp)]
              (unless (String.= &replacement tname)
                (set! result
                      (String.concat
                        &[replacement
                          @"."
                          (String.byte-slice name
                                             (String.length &prefix)
                                             (String.length name))])))))))
      result))

  (private function-shape)
  (hidden function-shape)
  (defn function-shape [node scope]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List raw-items)
        (let [written (semantic-items raw-items)
              items (if (and *resolve-observing*
                             (Int.< (Array.length &written) 4))
                (editing-tail node &written 4)
                written)]
          (if (Int.= (Array.length &items) 4)
            (let [head (Box.peek (Array.unsafe-nth &items 0))
                  name-node (Box.peek (Array.unsafe-nth &items 1))
                  parameters (Box.peek (Array.unsafe-nth &items 2))
                  body (Box.peek (Array.unsafe-nth &items 3))]
              (if (or (operator? head @"defn") (operator? head @"defn-"))
                (match (symbol-name name-node)
                  (Maybe.Just name)
                    (match-ref (SurfaceNode.form parameters)
                      (SurfaceForm.Array names)
                        (let-do [plain (qualify-name scope &name)
                                 qualified (generation-qualify &plain
                                                               *type-decl-stamp*)]
                          (observe-name! (SurfaceNode.span name-node)
                                         &qualified
                                         "function-declaration"
                                         (Maybe.Nothing))
                          (Result.Success
                            (FunctionShape.init qualified
                                                (String.copy scope)
                                                (Array.copy names)
                                                (Box.init (SurfaceNode.copy body))
                                                @(SurfaceNode.span node)
                                                *type-decl-stamp*
                                                (Array.copy &*collect-withs*)
                                                @(SurfaceNode.span parameters))))
                      _
                        (Result.Error
                          (let [rendered (str parameters)]
                            (error-at parameters
                                      (String.append "defn parameters must be an array: "
                                                     &rendered)))))
                  (Maybe.Nothing)
                    (Result.Error
                      (error-at name-node
                                @"defn name must be an unqualified symbol")))
                (Result.Error (error-at node @"expected defn"))))
            (Result.Error
              (error-at node @"defn expects a name, parameter array, and body"))))
      _ (Result.Error (error-at node @"defn must be a list"))))

  (private defn?)
  (hidden defn?)
  (defn defn? [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List items)
        (and (Int.> (Array.length items) 0)
             (let [head (Box.peek (Array.unsafe-nth items 0))]
               (or (named? head @"defn") (named? head @"defn-"))))
      _ false))

  (private value-shape)
  (hidden value-shape)
  (defn value-shape [node scope]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (Int.= (Array.length &items) 3)
            (let [head (Box.peek (Array.unsafe-nth &items 0))
                  name-node (Box.peek (Array.unsafe-nth &items 1))
                  body (Box.peek (Array.unsafe-nth &items 2))]
              (if (or (operator? head @"def") (operator? head @"def-"))
                (match (symbol-name name-node)
                  (Maybe.Just name)
                    (let-do [plain (qualify-name scope &name)
                             qualified (generation-qualify &plain
                                                           *type-decl-stamp*)]
                      (observe-name! (SurfaceNode.span name-node)
                                     &qualified
                                     "value-declaration"
                                     (Maybe.Nothing))
                      (Result.Success
                        (ValueShape.init qualified
                                         (String.copy scope)
                                         (Box.init (SurfaceNode.copy body))
                                         @(SurfaceNode.span node)
                                         *type-decl-stamp*
                                         (Array.copy &*collect-withs*))))
                  (Maybe.Nothing)
                    (Result.Error
                      (error-at name-node
                                @"def name must be an unqualified symbol")))
                (Result.Error (error-at node @"expected def"))))
            (Result.Error (error-at node @"def expects a name and body"))))
      _ (Result.Error (error-at node @"def must be a list"))))

  (private declaration?)
  (hidden declaration?)
  (defn declaration? [node name]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List items)
        (and (Int.> (Array.length items) 0)
             (operator? (Box.peek (Array.unsafe-nth items 0)) name))
      _ false))

  (private type-head-name)
  (hidden type-head-name)
  (defn type-head-name [node scope]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.Symbol _)
        (match (symbol-key node)
          (Maybe.Just name) (Maybe.Just (qualify-name scope &name))
          (Maybe.Nothing) (Maybe.Nothing))
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (Int.> (Array.length &items) 0)
            (match (symbol-key (Box.peek (Array.unsafe-nth &items 0)))
              (Maybe.Just name) (Maybe.Just (qualify-name scope &name))
              (Maybe.Nothing) (Maybe.Nothing))
            (Maybe.Nothing)))
      _ (Maybe.Nothing)))

  (private record-recursive-type!)
  (hidden record-recursive-type!)
  (private record-type-declaration!)
  (hidden record-type-declaration!)
  (doc record-recursive-type! "records the type that a `(recursive T)` form
flags, qualified by its scope.")
  (defn record-recursive-type! [collected form scope]
    (match-ref (SurfaceNode.form form)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (when (Int.> (Array.length &items) 1)
            (match (type-head-name (Box.peek (Array.unsafe-nth &items 1)) scope)
              (Maybe.Just name)
                (Array.push-back!
                  (CollectedForms.recursive-types collected)
                  name)
              (Maybe.Nothing) ())))
      _ ()))

  (doc record-type-declaration! "counts a `deftype` or `register-type` form and
records it as a declaration event.")
  (defn record-type-declaration! [form scope]
    (match-ref (SurfaceNode.form form)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (when (Int.> (Array.length &items) 1)
            (match (type-head-name (Box.peek (Array.unsafe-nth &items 1)) scope)
              (Maybe.Just name)
                (do
                  (set! *type-decl-stamp* (Int.inc *type-decl-stamp*))
                  (Array.push-back! &*type-decl-events*
                                    (TypeDeclEvent.init (Box.init (SurfaceNode.copy form))
                                                        (String.copy scope)
                                                        *type-decl-stamp*
                                                        name)))
              (Maybe.Nothing) ())))
      _ ()))

  (private build-type-redefinitions!)
  (hidden build-type-redefinitions!)
  (doc build-type-redefinitions! "sets `*type-redefinitions*` from the recorded
declaration events: each name declared more than once, with the stamps of its
declarations.")
  (defn build-type-redefinitions! []
    (let-do [table (the (Array (Pair String (Array Int))) [])
             n (Array.length &*type-decl-events*)]
      (for [i 0 n]
        (let-do [name (TypeDeclEvent.name (Array.unsafe-nth &*type-decl-events*
                                                            i))
                 stamps (the (Array Int) [])
                 seen-before false
                 all-registered true]
          (for [j 0 n]
            (let [other (Array.unsafe-nth &*type-decl-events* j)]
              (when-do (String.= (TypeDeclEvent.name other) name)
                (when (Int.< j i) (set! seen-before true))
                (unless (declaration? (Box.peek (TypeDeclEvent.form other))
                                      @"register-type")
                  (set! all-registered false))
                (Array.push-back! &stamps @(TypeDeclEvent.stamp other)))))
          ;; re-registrations of the same EXTERNAL type share one C identity
          ;; (the reference collapses their headers behind include guards), so
          ;; they are the same type, not generations. Only when a deftype is
          ;; involved do declarations become distinct generations.
          (when (and (not seen-before)
                     (and (Int.> (Array.length &stamps) 1) (not all-registered)))
            (Array.push-back! &table (Pair.init @name stamps)))))
      (set! *type-redefinitions* table)))

  (private event-generation-name)
  (hidden event-generation-name)
  (doc event-generation-name "returns the type name of the declaration event at
`index`, adjusted for its generation.")
  (defn event-generation-name [index]
    (let-do [event-name (String.copy
               (TypeDeclEvent.name (Array.unsafe-nth &*type-decl-events* index)))
             generation 0]
      (for [j 0 (Int.inc index)]
        (when (String.=
            (TypeDeclEvent.name (Array.unsafe-nth &*type-decl-events* j))
            &event-name)
          (set! generation (Int.inc generation))))
      (let [idx (redefinition-index &event-name)]
        (if (Int.= idx -1)
          event-name
          (let [stamps (Pair.b (Array.unsafe-nth &*type-redefinitions* idx))]
            (if (Int.= generation (Array.length stamps))
              event-name
              (generation-suffixed &event-name generation)))))))

  (private register-type-fields)
  (hidden register-type-fields)
  (doc register-type-fields "returns the field array of a `register-type` form,
if it has one.")
  (defn register-type-fields [items]
    (let [at (if (and (Int.>= (Array.length items) 3)
                      (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth items
                                                                               2)))
                        (SurfaceForm.StringLit _) true
                        _ false))
            3
            2)]
      (if (Int.> (Array.length items) at)
        (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth items at)))
          (SurfaceForm.Array _)
            (Maybe.Just
              (Box.init
                (SurfaceNode.copy (Box.peek (Array.unsafe-nth items at)))))
          _ (the (Maybe (Box SurfaceNode)) (Maybe.Nothing)))
        (the (Maybe (Box SurfaceNode)) (Maybe.Nothing)))))

  (private type-declaration-shape)
  (hidden type-declaration-shape)
  (defn type-declaration-shape [node scope]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (Int.>= (Array.length &items) 2)
            (let [head (Box.peek (Array.unsafe-nth &items 0))
                  name-node (Box.peek (Array.unsafe-nth &items 1))]
              (if (named? head @"register-type")
                (match (symbol-key name-node)
                  (Maybe.Just name)
                    (let [qualified (qualify-name scope &name)
                          ;; an optional string names the type's existing C
                          ;; representation, e.g. `(register-type A "void*")`.
                          representation (if (Int.>= (Array.length &items) 3)
                            (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth &items
                                                                                     2)))
                              (SurfaceForm.StringLit text)
                                (Maybe.Just (String.copy text))
                              _ (the (Maybe String) (Maybe.Nothing)))
                            (Maybe.Nothing))
                          ;; an optional field array, after the C name if there
                          ;; is one, is carried raw; member types are resolved
                          ;; when the declarations are assembled (after
                          ;; `resolve-type`).
                          fields (register-type-fields &items)]
                      (Result.Success
                        (TypeDeclarationShape.init qualified
                                                   representation
                                                   fields
                                                   @(SurfaceNode.span node)
                                                   *type-decl-stamp*)))
                  (Maybe.Nothing)
                    (Result.Error
                      (error-at name-node @"register-type name must be a symbol")))
                (Result.Error (error-at node @"expected register-type"))))
            (Result.Error (error-at node @"register-type expects a name"))))
      _ (Result.Error (error-at node @"register-type must be a list"))))

  (private module-shape)
  (hidden module-shape)
  (private with-shape)
  (hidden with-shape)
  (defn module-shape [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (Int.>= (Array.length &items) 2)
            (let [head (Box.peek (Array.unsafe-nth &items 0))
                  name-node (Box.peek (Array.unsafe-nth &items 1))]
              (if (named? head @"defmodule")
                (match (symbol-name name-node)
                  (Maybe.Just name)
                    (let-do [body (the (Array (Box SurfaceNode)) [])
                             n (Array.length &items)]
                      (for [i 2 n]
                        (let [item (Box.peek (Array.unsafe-nth &items i))]
                          (set! body
                                (Array.push-back body
                                                 (Box.init (SurfaceNode.copy item))))))
                      (Result.Success
                        (ModuleShape.init name body @(SurfaceNode.span node))))
                  (Maybe.Nothing)
                    (Result.Error
                      (error-at name-node
                                @"defmodule name must be an unqualified symbol")))
                (Result.Error (error-at node @"expected defmodule"))))
            (Result.Error
              (error-at node @"defmodule expects a name and body forms"))))
      _ (Result.Error (error-at node @"defmodule must be a list"))))

  (defn with-shape [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (Int.>= (Array.length &items) 2)
            (let [head (Box.peek (Array.unsafe-nth &items 0))
                  name-node (Box.peek (Array.unsafe-nth &items 1))]
              (if (named? head @"with")
                (match (symbol-key name-node)
                  (Maybe.Just name)
                    (let-do [body (the (Array (Box SurfaceNode)) [])
                             n (Array.length &items)]
                      (for [i 2 n]
                        (let [item (Box.peek (Array.unsafe-nth &items i))]
                          (set! body
                                (Array.push-back body
                                                 (Box.init (SurfaceNode.copy item))))))
                      (Result.Success
                        (ModuleShape.init name body @(SurfaceNode.span node))))
                  (Maybe.Nothing)
                    (Result.Error
                      (error-at name-node @"with module name must be a symbol")))
                (Result.Error (error-at node @"expected with"))))
            (Result.Error
              (error-at node @"with expects a module name and body forms"))))
      _ (Result.Error (error-at node @"with must be a list"))))

  (private typed-shape)
  (hidden typed-shape)
  (private register-shape)
  (hidden register-shape)
  (private template-shape)
  (hidden template-shape)
  (private signature-metadata?)
  (hidden signature-metadata?)
  (private signature-metadata-shape)
  (hidden signature-metadata-shape)
  (defn typed-shape [node declaration-name allow-extra? scope]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (or (Int.= (Array.length &items) 3)
                  (and allow-extra? (Int.> (Array.length &items) 3)))
            (let [head (Box.peek (Array.unsafe-nth &items 0))
                  name-node (Box.peek (Array.unsafe-nth &items 1))
                  signature (Box.peek (Array.unsafe-nth &items 2))]
              (if (named? head declaration-name)
                (match (symbol-key name-node)
                  (Maybe.Just name)
                    (let [plain (qualify-name scope &name)
                          qualified (generation-qualify &plain *type-decl-stamp*)]
                      (Result.Success
                        (TypedShape.init qualified
                                         (Box.init (SurfaceNode.copy signature))
                                         (Maybe.Nothing)
                                         @(SurfaceNode.span node)
                                         *type-decl-stamp*)))
                  (Maybe.Nothing)
                    (Result.Error
                      (error-at name-node @"declaration name must be a symbol")))
                (Result.Error (error-at node @"unexpected declaration"))))
            (Result.Error
              (error-at node @"declaration expects a name and a signature"))))
      _ (Result.Error (error-at node @"declaration must be a list"))))

  ;; the raw (pre-qualification) name a register form declares, when qualified.
  ;; The reference rejects `(register X.x ...)`: registration must happen
  ;; inside the module that owns the name.
  (private register-qualified-name)
  (hidden register-qualified-name)
  (defn register-qualified-name [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (Int.> (Array.length &items) 1)
            (match (symbol-key (Box.peek (Array.unsafe-nth &items 1)))
              (Maybe.Just raw)
                (if (qualified-name? &raw)
                  (Maybe.Just raw)
                  (the (Maybe String) (Maybe.Nothing)))
              (Maybe.Nothing) (the (Maybe String) (Maybe.Nothing)))
            (the (Maybe String) (Maybe.Nothing))))
      _ (the (Maybe String) (Maybe.Nothing))))

  (defn register-shape [node scope]
    (match (register-qualified-name node)
      (Maybe.Just bad)
        (Result.Error
          (error-at node
                    (String.append
                      "register requires an unqualified name: "
                      &bad)))
      (Maybe.Nothing)
        (match (typed-shape node @"register" true scope)
          (Result.Success shape)
            (match-ref (SurfaceNode.form node)
              (SurfaceForm.List raw-items)
                (let [items (semantic-items raw-items)
                      n (Array.length &items)]
                  (if (or (Int.= n 3) (Int.= n 4))
                    (if (Int.= n 4)
                      (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth &items
                                                                               3)))
                        (SurfaceForm.StringLit external-name)
                          (Result.Success
                            (TypedShape.init @(TypedShape.name &shape)
                                             @(TypedShape.signature &shape)
                                             (Maybe.Just
                                               (CoreBuiltinPayload.External (Maybe.Just (String.copy external-name))))
                                             @(TypedShape.span &shape)
                                             @(TypedShape.stamp &shape)))
                        _
                          (Result.Error
                            (error-at (Box.peek (Array.unsafe-nth &items 3))
                                      @"register external name must be a string")))
                      (Result.Success
                        (TypedShape.init @(TypedShape.name &shape)
                                         @(TypedShape.signature &shape)
                                         (Maybe.Just
                                           (CoreBuiltinPayload.External (Maybe.Nothing)))
                                         @(TypedShape.span &shape)
                                         @(TypedShape.stamp &shape))))
                    (Result.Error
                      (error-at node
                                @"register expects a name, signature, and optional external name"))))
              _ (Result.Error (error-at node @"register must be a list")))
          (Result.Error error) (Result.Error error))))

  (defn template-shape [node scope]
    (match (typed-shape node @"deftemplate" true scope)
      (Result.Success shape)
        (match-ref (SurfaceNode.form node)
          (SurfaceForm.List raw-items)
            (let [items (semantic-items raw-items)]
              (if (Int.= (Array.length &items) 5)
                (let [declaration-node (Box.peek (Array.unsafe-nth &items 3))
                      body-node (Box.peek (Array.unsafe-nth &items 4))]
                  (match-ref (SurfaceNode.form declaration-node)
                    (SurfaceForm.StringLit declaration)
                      (match-ref (SurfaceNode.form body-node)
                        (SurfaceForm.StringLit body)
                          (let [signature (Box.init
                                  (SurfaceNode.copy (Box.peek (TypedShape.signature &shape))))]
                            (Result.Success
                              (TypedShape.init @(TypedShape.name &shape)
                                               signature
                                               (Maybe.Just
                                                 (CoreBuiltinPayload.Template (String.copy declaration)
                                                                              (String.copy body)))
                                               @(TypedShape.span &shape)
                                               @(TypedShape.stamp &shape))))
                        _
                          (Result.Error
                            (error-at body-node
                                      @"deftemplate body must be a string")))
                    _
                      (Result.Error
                        (error-at declaration-node
                                  @"deftemplate declaration must be a string"))))
                (Result.Error
                  (error-at node
                            @"deftemplate expects name, signature, declaration, and body"))))
          _ (Result.Error (error-at node @"deftemplate must be a list")))
      (Result.Error error) (Result.Error error)))

  (defn signature-metadata? [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (Int.= (Array.length &items) 4)
            (and
              (named? (Box.peek (Array.unsafe-nth &items 0)) @"meta-set!")
              (and
                (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth &items
                                                                         2)))
                  (SurfaceForm.StringLit key) (String.= key "sig")
                  _ false)
                (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth &items
                                                                         3)))
                  (SurfaceForm.Symbol _) true
                  (SurfaceForm.List _) true
                  _ false)))
            false))
      _ false))

  (defn signature-metadata-shape [node scope]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)
              name-node (Box.peek (Array.unsafe-nth &items 1))
              signature (Box.peek (Array.unsafe-nth &items 3))]
          (match (symbol-key name-node)
            (Maybe.Just name)
              (let [plain (qualify-name scope &name)]
                (Result.Success
                  (TypedShape.init
                    (generation-qualify &plain *type-decl-stamp*)
                    (Box.init (SurfaceNode.copy signature))
                    (Maybe.Nothing)
                    @(SurfaceNode.span node)
                    *type-decl-stamp*)))
            (Maybe.Nothing)
              (Result.Error
                (error-at name-node @"signature metadata name must be a symbol"))))
      _ (Result.Error (error-at node @"signature metadata must be a list"))))

  (private implementation-shape)
  (hidden implementation-shape)
  (defn implementation-shape [node scope]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (Int.= (Array.length &items) 3)
            (let [head (Box.peek (Array.unsafe-nth &items 0))
                  interface-node (Box.peek (Array.unsafe-nth &items 1))
                  implementation-node (Box.peek (Array.unsafe-nth &items 2))]
              (if (named? head @"implements")
                (match (symbol-key interface-node)
                  (Maybe.Just interface-name)
                    (match (symbol-key implementation-node)
                      (Maybe.Just implementation-name)
                        (let [plain (qualify-name scope &implementation-name)
                              qualified-implementation (generation-qualify &plain
                                                                           *type-decl-stamp*)]
                          (Result.Success
                            (ImplementationShape.init interface-name
                                                      qualified-implementation
                                                      @(SurfaceNode.span node)
                                                      *type-decl-stamp*)))
                      (Maybe.Nothing)
                        (Result.Error
                          (error-at implementation-node
                                    @"implementation must be a symbol")))
                  (Maybe.Nothing)
                    (Result.Error
                      (error-at interface-node @"interface must be a symbol")))
                (Result.Error (error-at node @"expected implements"))))
            (Result.Error
              (error-at node
                        @"implements expects an interface and implementation"))))
      _ (Result.Error (error-at node @"implements must be a list"))))

  (private global-by-name)
  (hidden global-by-name)
  (private global-by-name-scanned)
  (hidden global-by-name-scanned)
  (private catch-up-global-index!)
  (hidden catch-up-global-index!)
  (private reset-global-index!)
  (hidden reset-global-index!)
  (private first-global-by-name)
  (hidden first-global-by-name)
  (private append-core-interfaces)
  (hidden append-core-interfaces)
  (private append-core-builtins)
  (hidden append-core-builtins)
  (private append-core-implementations)
  (hidden append-core-implementations)
  (doc reset-global-index! "clears the global name index, so the next lookup
rebuilds it.")
  (defn reset-global-index! []
    (do
      (set! *global-name-index* (the (Map String Int) (Map.create)))
      (set! *global-index-count* 0)))

  (doc global-by-name "returns the last global named `name`. A dotted name with
a redefined type as prefix binds the generation live at the current site.")
  (private global-by-name-scanned)
  (hidden global-by-name-scanned)
  (doc global-by-name-scanned "returns the last global named `name` in
`globals`, by scanning.")
  (defn global-by-name-scanned [globals name]
    (let-do [result (the (Maybe CoreRef) (Maybe.Nothing))
             n (Array.length globals)]
      (for [i 0 n]
        (let [candidate (Array.unsafe-nth globals i)]
          (when (= (CoreRef.name candidate) name)
            (set! result (Maybe.Just @candidate)))))
      result))

  (private catch-up-global-index!)
  (hidden catch-up-global-index!)
  (doc catch-up-global-index! "adds the globals appended since the last call to
the name index. If the table is shorter than the index, the index is rebuilt.")
  (defn catch-up-global-index! [globals]
    (let-do [n (Array.length globals)]
      (when-do (Int.< n *global-index-count*)
        (set! *global-name-index* (the (Map String Int) (Map.create)))
        (set! *global-index-count* 0))
      (for [i *global-index-count* n]
        (ignore
          (Map.put! &*global-name-index*
                    (CoreRef.name (Array.unsafe-nth globals i))
                    &i)))
      (set! *global-index-count* n)))

  (defn global-by-name [globals name]
    (let-do [rewritten (generation-qualify name *resolve-stamp*)
             _caught-up (catch-up-global-index! globals)]
      (match (Map.get-maybe &*global-name-index* &rewritten)
        (Maybe.Just at) (Maybe.Just @(Array.unsafe-nth globals at))
        (Maybe.Nothing) (the (Maybe CoreRef) (Maybe.Nothing)))))

  (defn first-global-by-name [globals name]
    (let-do [result (the (Maybe CoreRef) (Maybe.Nothing))
             n (Array.length globals)]
      (for [i 0 n]
        (match-ref &result
          (Maybe.Nothing)
            (let [candidate (Array.unsafe-nth globals i)]
              (when (= (CoreRef.name candidate) name)
                (set! result (Maybe.Just @candidate))))
          (Maybe.Just _) ()))
      result))

  (defn append-core-interfaces [left right]
    (let-do [result (Array.copy left)
             n (Array.length right)]
      (for [i 0 n]
        (set! result (Array.push-back result @(Array.unsafe-nth right i))))
      result))

  (doc defined-builtin-names "returns the names in `builtins` that `functions`
also defines. Such a `register` is a forward declaration.")
  (private defined-builtin-names)
  (hidden defined-builtin-names)
  (defn defined-builtin-names [builtins functions]
    (let-do [names (the (Array String) [])]
      (for [i 0 (Array.length builtins)]
        (let [name (CoreRef.name
                (CoreBuiltin.reference (Array.unsafe-nth builtins i)))]
          (for [f 0 (Array.length functions)]
            (when (String.=
                (FunctionShape.name (Array.unsafe-nth functions f))
                name)
              (Array.push-back! &names (String.copy name))))))
      names))

  (private name-in?)
  (hidden name-in?)
  (defn name-in? [names target]
    (let-do [found false]
      (for [i 0 (Array.length names)]
        (when (String.= (Array.unsafe-nth names i) target) (set! found true)))
      found))

  (doc builtins-without "returns the builtins whose names are not in `names`.")
  (private builtins-without)
  (hidden builtins-without)
  (defn builtins-without [builtins names]
    (let-do [kept (the (Array CoreBuiltin) [])]
      (for [i 0 (Array.length builtins)]
        (let [builtin (Array.unsafe-nth builtins i)]
          (unless (name-in? names (CoreRef.name (CoreBuiltin.reference builtin)))
            (Array.push-back! &kept @builtin))))
      kept))

  (doc builtin-signatures "returns the builtins named in `names` as signatures,
so the types of the builtins a definition replaces still constrain it.")
  (private builtin-signatures)
  (hidden builtin-signatures)
  (defn builtin-signatures [builtins names]
    (let-do [result (the (Array CoreSignature) [])]
      (for [i 0 (Array.length builtins)]
        (let [builtin (Array.unsafe-nth builtins i)]
          (when (name-in? names (CoreRef.name (CoreBuiltin.reference builtin)))
            (Array.push-back! &result
                              (CoreSignature.init
                                (CoreRef.copy (CoreBuiltin.reference builtin))
                                (Box.init
                                  (CoreType.copy
                                    (Box.peek (CoreBuiltin.signature builtin)))))))))
      result))

  (defn append-core-builtins [left right]
    (let-do [result (Array.copy left)
             n (Array.length right)]
      (for [i 0 n]
        (set! result (Array.push-back result @(Array.unsafe-nth right i))))
      result))

  (defn append-core-implementations [left right]
    (let-do [result (Array.copy left)
             n (Array.length right)]
      (for [i 0 n]
        (set! result (Array.push-back result @(Array.unsafe-nth right i))))
      result))

  (private comment?)
  (hidden comment?)
  (private ignored-declaration?)
  (hidden ignored-declaration?)
  (private top-level-do-body)
  (hidden top-level-do-body)
  (defn comment? [form]
    (match-ref (SurfaceNode.form form) (SurfaceForm.Comment _) true _ false))

  (doc record-private! "records the qualified name that a `(private X)` form
marks private.")
  (private record-private!)
  (hidden record-private!)
  (defn record-private! [form scope]
    (match-ref (SurfaceNode.form form)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (when (Int.= (Array.length &items) 2)
            ;; `symbol-key`, not `symbol-name`: the target may be qualified,
            ;; as in a top-level `(private Foo.bar)` naming a record accessor.
            (match (symbol-key (Box.peek (Array.unsafe-nth &items 1)))
              (Maybe.Just name)
                (Set.put! &*private-names* &(qualify-name scope &name))
              (Maybe.Nothing) ())))
      _ ()))

  (doc private-metadata? "checks whether `form` is `(meta-set! X \"private\"
...)`, which the `private` macro expands to.")
  (private private-metadata?)
  (hidden private-metadata?)
  (defn private-metadata? [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (and (Int.= (Array.length &items) 4)
               (and
                 (named? (Box.peek (Array.unsafe-nth &items 0)) @"meta-set!")
                 (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth &items
                                                                          2)))
                   (SurfaceForm.StringLit key) (String.= key "private")
                   _ false))))
      _ false))

  (private record-private-metadata!)
  (hidden record-private-metadata!)
  (defn record-private-metadata! [form scope]
    (match-ref (SurfaceNode.form form)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (when (Int.= (Array.length &items) 4)
            (match (symbol-key (Box.peek (Array.unsafe-nth &items 1)))
              (Maybe.Just name)
                (Set.put! &*private-names* &(qualify-name scope &name))
              (Maybe.Nothing) ())))
      _ ()))

  (doc private-access-error? "checks whether `name` is private and `scope` is
outside the module that defines it and its submodules.")
  (private private-access-error?)
  (hidden private-access-error?)
  (defn private-access-error? [name scope]
    (let [private (Set.contains? &*private-names* name)]
      (if private
        (let [owner (parent-scope name)]
          (not
            (or (String.= &owner scope)
                (or (String.empty? &owner)
                    (String.starts-with? scope &(String.append &owner "."))))))
        false)))

  (defn ignored-declaration? [form]
    (cond
      (comment? form) true
      (declaration? form @"doc") true
      (declaration? form @"meta-set!") true
      (declaration? form @"hidden") true
      (declaration? form @"private") true
      (declaration? form @"c-name") true
      (declaration? form @"deprecated") true
      (declaration? form @"todo") true
      (declaration? form @"annotate") true
      (declaration? form @"defmacro") true
      (declaration? form @"defndynamic") true
      (declaration? form @"defdynamic") true
      (declaration? form @"include") true
      (declaration? form @"system-include") true
      false))

  (defn top-level-do-body [form]
    (match-ref (SurfaceNode.form form)
      (SurfaceForm.List raw-items)
        (let-do [items (semantic-items raw-items)
                 result (the (Array (Box SurfaceNode)) [])
                 n (Array.length &items)]
          (if (and (Int.> n 0)
                   (named? (Box.peek (Array.unsafe-nth &items 0)) @"do"))
            (do
              (for [i 1 n]
                (set! result
                      (Array.push-back result
                                       (Box.init
                                         (SurfaceNode.copy (Box.peek (Array.unsafe-nth &items
                                                                                       i)))))))
              (Maybe.Just result))
            (Maybe.Nothing)))
      _ (Maybe.Nothing)))

  (private collect)
  (hidden collect)
  (private collect-scoped!)
  (hidden collect-scoped!)
  (private add-function!)
  (hidden add-function!)
  (private add-value!)
  (hidden add-value!)
  (private add-typed!)
  (hidden add-typed!)
  (private add-interface!)
  (hidden add-interface!)
  (private add-import!)
  (hidden add-import!)
  (private system-include-shape)
  (hidden system-include-shape)
  (private preproc-text)
  (hidden preproc-text)
  (private qualified-head?)
  (hidden qualified-head?)

  (private next-global-id)
  (hidden next-global-id)
  (doc next-global-id "returns one more than the largest id in `globals` and the
overloads.")
  ; overloads share the global id space, so the next id covers both tables
  (defn next-global-id [globals]
    (let-do [m -1
             n (Array.length globals)]
      (for [i 0 n]
        (let [gid @(CoreRef.id (Array.unsafe-nth globals i))]
          (when (Int.> gid m) (set! m gid))))
      (for [i 0 (Array.length &*overloads*)]
        (let [oid @(CoreRef.id
                (CoreOverload.reference (Array.unsafe-nth &*overloads* i)))]
          (when (Int.> oid m) (set! m oid))))
      (Int.inc m)))

  (private name-defined?)
  (hidden name-defined?)
  (doc name-defined? "checks whether the module defines the qualified `name`
itself.")
  (defn name-defined? [name]
    (match (Map.get-maybe &*definition-names* name)
      (Maybe.Just _) true
      (Maybe.Nothing) false))

  (doc add-global! "adds the global `name` to `collected` and records it as
defined by the module. It keeps a reference from the reuse table if one has that
name, and makes a new one otherwise.")
  (defn add-global! [collected name]
    (let-do [globals (CollectedForms.globals collected)
             _ignored-definition (ignore (Map.put! &*definition-names* name &0))]
      (match (global-by-name-scanned &*resolve-reuse-globals* name)
        (Maybe.Just reusable)
          (do (Array.push-back! globals (CoreRef.copy &reusable)) reusable)
        (Maybe.Nothing)
          (let-do [reference (CoreRef.init (next-global-id globals)
                                           (String.copy name)
                                           true)]
            (Array.push-back! globals (CoreRef.copy &reference))
            reference))))

  (defn add-function! [collected shape]
    (let [name (FunctionShape.name shape)]
      (match (global-by-name (CollectedForms.globals collected) name)
        (Maybe.Just _)
          (let-do [functions (CollectedForms.functions collected)
                   replaced false
                   n (Array.length functions)]
            (for [i 0 n]
              (when-do (=
                  (FunctionShape.name (Array.unsafe-nth functions i))
                  name)
                (Array.aset! functions i (FunctionShape.copy shape))
                (set! replaced true)))
            (unless-do replaced
              (ignore (add-global! collected name))
              (Array.push-back! functions (FunctionShape.copy shape))))
        (Maybe.Nothing)
          (do
            (ignore (add-global! collected name))
            (Array.push-back! (CollectedForms.functions collected)
                              (FunctionShape.copy shape))))))

  (defn add-value! [collected shape]
    (let [name (ValueShape.name shape)]
      (match (global-by-name (CollectedForms.globals collected) name)
        (Maybe.Just _)
          (let-do [values (CollectedForms.values collected)
                   replaced false
                   n (Array.length values)]
            (for [i 0 n]
              (when-do (= (ValueShape.name (Array.unsafe-nth values i)) name)
                (Array.aset! values i (ValueShape.copy shape))
                (set! replaced true)))
            (unless-do replaced
              (ignore (add-global! collected name))
              (Array.push-back! values (ValueShape.copy shape))))
        (Maybe.Nothing)
          (do
            (ignore (add-global! collected name))
            (Array.push-back! (CollectedForms.values collected)
                              (ValueShape.copy shape))))))

  (defn add-typed! [collected shapes shape]
    (let [name (TypedShape.name shape)]
      (match (global-by-name (CollectedForms.globals collected) name)
        (Maybe.Just _)
          (let-do [replaced false
                   n (Array.length shapes)]
            (for [i 0 n]
              (when-do (= (TypedShape.name (Array.unsafe-nth shapes i)) name)
                (Array.aset! shapes i (TypedShape.copy shape))
                (set! replaced true)))
            (unless-do replaced
              (ignore (add-global! collected name))
              (Array.push-back! shapes (TypedShape.copy shape))))
        (Maybe.Nothing)
          (do
            (ignore (add-global! collected name))
            (Array.push-back! shapes (TypedShape.copy shape))))))

  (defn add-interface! [collected shape]
    (let [name (TypedShape.name shape)]
      (match (global-by-name (CollectedForms.globals collected) name)
        (Maybe.Just _)
          (let-do [interfaces (CollectedForms.interfaces collected)
                   replaced false
                   n (Array.length interfaces)]
            (for [i 0 n]
              (when-do (= (TypedShape.name (Array.unsafe-nth interfaces i)) name)
                (Array.aset! interfaces i (TypedShape.copy shape))
                (set! replaced true)))
            (unless-do replaced
              (ignore (add-global! collected name))
              (Array.push-back! interfaces (TypedShape.copy shape))))
        (Maybe.Nothing)
          (do
            (ignore (add-global! collected name))
            (Array.push-back! (CollectedForms.interfaces collected)
                              (TypedShape.copy shape))))))

  (private imports-with)
  (hidden imports-with)
  (doc imports-with "returns the imports a body is resolved with: the module's
own, plus a `use` of each module in `withs`.")
  (defn imports-with [imports scope withs]
    (let-do [result (Array.copy imports)]
      (for [i 0 (Array.length withs)]
        (Array.push-back! &result
                          (ScopedImport.init (String.copy scope)
                                             @(Array.unsafe-nth withs i))))
      result))

  (defn add-import! [collected scope module-name]
    (Array.push-back! (CollectedForms.imports collected)
                      (ScopedImport.init (String.copy scope)
                                         (String.copy module-name))))

  (doc add-imports-from-form! "adds the modules a `use` form names to the
imports of `collected`, in `scope`.")
  (defn add-imports-from-form! [collected form scope]
    (match-ref (SurfaceNode.form form)
      (SurfaceForm.List raw-items)
        (let-do [items (semantic-items raw-items)
                 result (the (Result Unit ResolveError) (Result.Success ()))
                 n (Array.length &items)]
          (for [i 1 n]
            (match-ref &result
              (Result.Success _)
                (let [module-node (Box.peek (Array.unsafe-nth &items i))]
                  (match (symbol-key module-node)
                    (Maybe.Just module-name)
                      (add-import! collected scope &module-name)
                    (Maybe.Nothing)
                      (set! result
                            (Result.Error
                              (error-at module-node
                                        @"use expects module symbols")))))
              (Result.Error _) ()))
          result)
      _ (Result.Error (error-at form @"use must be a list"))))

  ;; head check for qualified symbols like `Unsafe.preproc` — `named?` only
  ;; matches single-segment symbols, so compare the joined key instead.
  (defn qualified-head? [node name]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List items)
        (and (Int.> (Array.length items) 0)
             (match (symbol-key (Box.peek (Array.unsafe-nth items 0)))
               (Maybe.Just key) (= &key name)
               (Maybe.Nothing) false))
      _ false))

  ;; `(Unsafe.preproc (Unsafe.emit-c "<directive>"))` carries a literal C
  ;; preamble line (e.g. a `#define` emitted by `Unsafe.C.asm`). The text rides
  ;; the system-include channel; the backend emits lines starting with `#`
  ;; verbatim instead of wrapping them in `#include <...>`.
  (defn preproc-text [form]
    (match-ref (SurfaceNode.form form)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (Int.= 2 (Array.length &items))
            (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth &items 1)))
              (SurfaceForm.List inner-raw)
                (let [inner (semantic-items inner-raw)]
                  (if (and (Int.= 2 (Array.length &inner))
                           (match (symbol-key (Box.peek (Array.unsafe-nth &inner
                                                                          0)))
                             (Maybe.Just key) (= &key "Unsafe.emit-c")
                             (Maybe.Nothing) false))
                    (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth &inner
                                                                             1)))
                      (SurfaceForm.StringLit text)
                        (Result.Success (String.copy text))
                      _
                        (Result.Error
                          (error-at form
                                    @"Unsafe.emit-c expects a string literal")))
                    (Result.Error
                      (error-at form
                                @"Unsafe.preproc expects an Unsafe.emit-c form"))))
              _
                (Result.Error
                  (error-at form @"Unsafe.preproc expects an Unsafe.emit-c form")))
            (Result.Error (error-at form @"Unsafe.preproc expects one argument"))))
      _ (Result.Error (error-at form @"Unsafe.preproc must be a list"))))

  (defn system-include-shape [form]
    (match-ref (SurfaceNode.form form)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (Int.= 2 (Array.length &items))
            (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth &items 1)))
              (SurfaceForm.StringLit path) (Result.Success (String.copy path))
              _
                (Result.Error
                  (error-at (Box.peek (Array.unsafe-nth &items 1))
                            @"system-include path must be a string")))
            (Result.Error
              (error-at form @"system-include expects one path string"))))
      _ (Result.Error (error-at form @"system-include must be a list"))))

  (defn collect-scoped! [forms scope collected]
    (let-do [result (the (Result Unit ResolveError) (Result.Success ()))
             n (Array.length forms)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success _)
            (let [form (Box.peek (Array.unsafe-nth forms i))]
              (cond
                (declaration? form @"defmodule")
                (match (module-shape form)
                  (Result.Success shape)
                    (let [nested-scope (append-scope scope
                                                     (ModuleShape.name &shape))]
                      (set! result
                            (collect-scoped! (ModuleShape.body &shape)
                                             &nested-scope
                                             collected)))
                  (Result.Error error) (set! result (Result.Error error)))

                (declaration? form @"with")
                (match (with-shape form)
                  (Result.Success shape)
                    (let-do [outer @&*collect-withs*]
                      (set! *collect-withs*
                            (Array.push-back @&*collect-withs*
                                             @(ModuleShape.name &shape)))
                      (set! result
                            (collect-scoped! (ModuleShape.body &shape)
                                             scope
                                             collected))
                      (set! *collect-withs* outer))
                  (Result.Error error) (set! result (Result.Error error)))

                (declaration? form @"do")
                (match (top-level-do-body form)
                  (Maybe.Just body)
                    (set! result (collect-scoped! &body scope collected))
                  (Maybe.Nothing) ())

                (declaration? form @"if")
                (match-ref (SurfaceNode.form form)
                  (SurfaceForm.List raw-items)
                    (let [items (semantic-items raw-items)]
                      (if (Int.= (Array.length &items) 4)
                        (for [branch-index 2 4]
                          (match-ref &result
                            (Result.Success _)
                              (let [branch (Box.peek (Array.unsafe-nth &items
                                                                       branch-index))]
                                (match (top-level-do-body branch)
                                  (Maybe.Just body)
                                    (set! result
                                          (collect-scoped! &body scope collected))
                                  (Maybe.Nothing)
                                    (Array.push-back! (CollectedForms.expressions collected)
                                                      (ScopedExpression.init (Box.init (SurfaceNode.copy branch))
                                                                             (String.copy scope)
                                                                             *type-decl-stamp*
                                                                             (Array.copy &*collect-withs*)))))
                            (Result.Error _) ()))
                        (Array.push-back! (CollectedForms.expressions collected)
                                          (ScopedExpression.init (Box.init (SurfaceNode.copy form))
                                                                 (String.copy scope)
                                                                 *type-decl-stamp*
                                                                 (Array.copy &*collect-withs*)))))
                  _
                    (Array.push-back! (CollectedForms.expressions collected)
                                      (ScopedExpression.init (Box.init (SurfaceNode.copy form))
                                                             (String.copy scope)
                                                             *type-decl-stamp*
                                                             (Array.copy &*collect-withs*))))

                (signature-metadata? form)
                (match (signature-metadata-shape form scope)
                  (Result.Success shape)
                    (Array.push-back! (CollectedForms.signatures collected)
                                      shape)
                  (Result.Error error) (set! result (Result.Error error)))

                (declaration? form @"system-include")
                (match (system-include-shape form)
                  (Result.Success path)
                    (Array.push-back!
                      (CollectedForms.system-includes collected)
                      path)
                  (Result.Error error) (set! result (Result.Error error)))

                (qualified-head? form "Unsafe.preproc")
                (match (preproc-text form)
                  (Result.Success text)
                    (Array.push-back!
                      (CollectedForms.system-includes collected)
                      text)
                  (Result.Error error) (set! result (Result.Error error)))

                ;; `(private X)` marks X unusable from outside this module.
                ;; Recorded before `ignored-declaration?` swallows it.
                (declaration? form @"private")
                (record-private! form scope)

                ;; Core's `private` macro expands to this shape inside macro
                ;; output (`defn-`/`def-`); record before meta-set! is ignored.
                (private-metadata? form)
                (record-private-metadata! form scope)

                (ignored-declaration? form)
                ()
                (declaration? form @"deftype")
                (record-type-declaration! form scope)
                (or (declaration? form @"load")
                    (or (declaration? form @"load-once")
                        (declaration? form @"load-and-use")))
                ()

                (or (declaration? form @"use") (declaration? form @"use-all"))
                (set! result (add-imports-from-form! collected form scope))

                (defn? form)
                (match (function-shape form scope)
                  (Result.Success shape)
                    (do
                      ;; `defn-` is `private` + `hidden` + `defn`.
                      (when (declaration? form @"defn-")
                        (Set.put! &*private-names* (FunctionShape.name &shape)))
                      (add-function! collected &shape))
                  (Result.Error error) (set! result (Result.Error error)))

                (or (declaration? form @"def") (declaration? form @"def-"))
                (match (value-shape form scope)
                  (Result.Success shape)
                    (do
                      (when (declaration? form @"def-")
                        (Set.put! &*private-names* (ValueShape.name &shape)))
                      (add-value! collected &shape))
                  (Result.Error error) (set! result (Result.Error error)))

                (declaration? form @"register")
                (match (register-shape form scope)
                  (Result.Success shape)
                    (add-typed! collected
                                (CollectedForms.builtins collected)
                                &shape)
                  (Result.Error error) (set! result (Result.Error error)))

                (declaration? form @"deftemplate")
                (match (template-shape form scope)
                  (Result.Success shape)
                    (add-typed! collected
                                (CollectedForms.builtins collected)
                                &shape)
                  (Result.Error error) (set! result (Result.Error error)))

                (declaration? form @"sig")
                (match (typed-shape form @"sig" false scope)
                  (Result.Success shape)
                    (Array.push-back! (CollectedForms.signatures collected)
                                      shape)
                  (Result.Error error) (set! result (Result.Error error)))

                (declaration? form @"register-type")
                (do
                  (record-type-declaration! form scope)
                  (match (type-declaration-shape form scope)
                    (Result.Success shape)
                      (Array.push-back!
                        (CollectedForms.type-declarations collected)
                        shape)
                    (Result.Error error) (set! result (Result.Error error))))

                ;; an interface is global wherever it is declared: the
                ;; reference keeps interfaces by bare name
                (declaration? form @"definterface")
                (match (typed-shape form @"definterface" false "")
                  (Result.Success shape) (add-interface! collected &shape)
                  (Result.Error error) (set! result (Result.Error error)))

                (declaration? form @"implements")
                (match (implementation-shape form scope)
                  (Result.Success shape)
                    (Array.push-back!
                      (CollectedForms.implementations collected)
                      shape)
                  (Result.Error error) (set! result (Result.Error error)))

                ;; `(recursive T)` marks T as a heap indirection, so an
                ;; occurrence of it may break by-value recursion in another
                ;; type's members. The reference keeps this as metadata on the
                ;; type binder and reads it back when it validates members
                ;; (Validate.hs), so the name has to reach the Core module
                ;; instead of being dropped here. Top-level only: `recursive`
                ;; remains a valid ordinary function name in expressions.
                (declaration? form @"recursive")
                (record-recursive-type! collected form scope)

                (Array.push-back! (CollectedForms.expressions collected)
                                  (ScopedExpression.init (Box.init (SurfaceNode.copy form))
                                                         (String.copy scope)
                                                         *type-decl-stamp*
                                                         (Array.copy &*collect-withs*)))))
          (Result.Error _) ()))
      result))

  (private starting-imports)
  (hidden starting-imports)
  (doc starting-imports "returns the imports a module starts with: the seed,
plus `(use String)`, as in the reference's starting environment.")
  (defn starting-imports []
    (let-do [imports (Array.copy &*resolve-seed-imports*)
             present false]
      (for [i 0 (Array.length &imports)]
        (let [import (Array.unsafe-nth &imports i)]
          (when (and
              (String.empty? (ScopedImport.scope import))
              (= (ScopedImport.module-name import) "String"))
            (set! present true))))
      (unless present
        (Array.push-back! &imports (ScopedImport.init @"" @"String")))
      imports))

  (defn collect [forms]
    (let [_ignored-withs (set! *collect-withs* [])
          collected (CollectedForms.init []
                                         []
                                         []
                                         []
                                         []
                                         []
                                         []
                                         []
                                         (starting-imports)
                                         []
                                         []
                                         (Array.copy &*resolve-seed-globals*))]
      (match (collect-scoped! forms "" &collected)
        (Result.Success _) (Result.Success collected)
        (Result.Error error) (Result.Error error))))

  (private collect-with-generations)
  (hidden collect-with-generations)
  (doc collect-with-generations "collects `forms` and builds the type
redefinition table. If a type is redefined, it collects again, so each qualified
definition name gets its generation.")
  (defn collect-with-generations [forms]
    (match (collect forms)
      (Result.Success first-pass)
        (do
          (build-type-redefinitions!)
          (if (Int.= 0 (Array.length &*type-redefinitions*))
            (Result.Success first-pass)
            (do
              (set! *private-names* (Set.create))
              (set! *definition-names* (the (Map String Int) (Map.create)))
              (set! *type-decl-stamp* 0)
              (set! *type-decl-events* [])
              (collect forms))))
      (Result.Error error) (Result.Error error)))

  (private local-by-name)
  (hidden local-by-name)
  (defn local-by-name [locals name]
    (let-do [result (the (Maybe CoreRef) (Maybe.Nothing))
             n (Array.length locals)]
      (for [i 0 n]
        (let [candidate (Array.unsafe-nth locals i)]
          (when (= (CoreRef.name candidate) name)
            (set! result (Maybe.Just @candidate)))))
      result))

  (doc local-reference "returns a new reference for the local binder `node`
named `name`, with role `role`. Every binder gets a new id, even when macros
make several with one span.")
  (private local-reference)
  (hidden local-reference)
  (defn local-reference [node name role]
    (let-do [position @(Info.pos (SurfaceSpan.start (SurfaceNode.span node)))
             serial (do
               (set! *local-binder-serial* (Int.inc *local-binder-serial*))
               *local-binder-serial*)
             reference (CoreRef.init
               (Int.- 0 (Int.+ (Int.* serial 1048576) (Int.inc position)))
               (String.copy name)
               false)]
      (record-binding! &reference (SurfaceNode.span node) false)
      (observe-binding! &reference (SurfaceNode.span node) role)
      reference))

  (private scoped-global-by-name)
  (hidden scoped-global-by-name)
  (private root-yields-to-imports?)
  (private live-generation-member?)
  (hidden live-generation-member?)
  (doc live-generation-member? "checks whether the global `name` belongs to the
generation of its type that is live at the current site.")
  (defn live-generation-member? [name]
    (let-do [live true
             n (Array.length &*type-redefinitions*)]
      (for [i 0 n]
        (let [tname (Pair.a (Array.unsafe-nth &*type-redefinitions* i))]
          (when (String.starts-with? name tname)
            (let [rest (String.byte-slice name
                                          (String.length tname)
                                          (String.length name))
                  dot (String.index-of &rest \.)]
              (when (and (Int.>= dot 0)
                         (or (Int.= dot 0) (String.starts-with? &rest "--gen")))
                (let [segment (String.concat
                        &[@tname (String.byte-slice &rest 0 dot)])]
                  (unless (String.= &segment
                                    &(generation-type-name tname *resolve-stamp*))
                    (set! live false))))))))
      live))

  (hidden root-yields-to-imports?)
  (private compatibility-global-by-name)
  (hidden compatibility-global-by-name)
  (private unique-member-global-by-name)
  (hidden unique-member-global-by-name)
  (defn compatibility-global-by-name [globals name]
    (cond
      (= name "Int.min") (global-by-name globals "min")
      (= name "Int.max") (global-by-name globals "max")
      (= name "StringCopy.append") (global-by-name globals "String.append")
      (the (Maybe CoreRef) (Maybe.Nothing))))

  (defn unique-member-global-by-name [globals name]
    (if (qualified-name? name)
      (the (Maybe CoreRef) (Maybe.Nothing))
      (let-do [result (the (Maybe CoreRef) (Maybe.Nothing))
               suffix (String.concat &[@"." (String.copy name)])
               matches 0
               n (Array.length globals)]
        (for [i 0 n]
          (let [candidate (Array.unsafe-nth globals i)]
            (when-do (and
                (String.ends-with? (CoreRef.name candidate) &suffix)
                (live-generation-member? (CoreRef.name candidate)))
              (set! matches (Int.inc matches))
              (set! result (Maybe.Just (CoreRef.copy candidate))))))
        (if (Int.= matches 1) result (the (Maybe CoreRef) (Maybe.Nothing))))))

  (defn scoped-global-by-name [globals scope name]
    (cond
      (String.empty? scope)
      (global-by-name globals name)
      ;; a qualified name is looked for in each enclosing module, innermost
      ;; first, then at the root, as the reference searches its environment
      ;; chain
      (qualified-name? name)
      (let-do [found (the (Maybe CoreRef) (Maybe.Nothing))
               at (String.copy scope)]
        (while-do (and (Maybe.nothing? &found) (not (String.empty? &at)))
          (set! found (global-by-name globals &(append-scope &at name)))
          (set! at (parent-scope &at)))
        (match found
          (Maybe.Just reference) (Maybe.Just reference)
          (Maybe.Nothing) (global-by-name globals name)))
      (let [scoped (qualify-name scope name)]
        (match (global-by-name globals &scoped)
          (Maybe.Just reference) (Maybe.Just reference)
          (Maybe.Nothing) (global-by-name globals name)))))

  (defn root-yields-to-imports? [scope symbol reference]
    (and
      (or (= symbol "unsafe-nth")
          (or (= symbol "unsafe-raw")
              (and (= symbol "suffix") (String.empty? scope))))
      (and (not (qualified-name? symbol)) (= (CoreRef.name reference) symbol))))

  ;; resolves the implicit `.init` constructor of an imported type: `(C)` under
  ;; `(use Wrap2)` finds `Wrap2.C.init`. The bare name is qualified through each
  ;; import first, then `.init` is appended.
  (private imported-init-by-name)
  (hidden imported-init-by-name)
  (defn imported-init-by-name [globals imports scope name]
    (if (qualified-name? name)
      (Maybe.Nothing)
      (let-do [result (the (Maybe CoreRef) (Maybe.Nothing))
               n (Array.length imports)]
        (for [i 0 n]
          (match-ref &result
            (Maybe.Just _) ()
            (Maybe.Nothing)
              (let [import (Array.unsafe-nth imports i)
                    import-scope (ScopedImport.scope import)]
                (when (or (= import-scope scope) (String.empty? import-scope))
                  (let [module-name (ScopedImport.module-name import)
                        absolute (String.concat
                          &[(append-scope module-name name) @".init"])
                        relative (String.concat
                          &[(append-scope &(append-scope import-scope
                                                         module-name)
                                          name)
                            @".init"])]
                    (match (global-by-name globals &absolute)
                      (Maybe.Just reference)
                        (set! result (Maybe.Just reference))
                      (Maybe.Nothing)
                        (match (global-by-name globals &relative)
                          (Maybe.Just reference)
                            (set! result (Maybe.Just reference))
                          (Maybe.Nothing) ())))))))
        result)))

  (private resolve-arguments)
  (hidden resolve-arguments)
  (register resolve-expression
    (Fn
      [(Ref SurfaceNode)
       (Ref (Array CoreRef))
       (Ref (Array CoreRef))
       (Ref (Array ScopedImport))
       (Ref String)]
      (Result CoreExpr ResolveError)))
  (register resolve-expression-raw
    (Fn
      [(Ref SurfaceNode)
       (Ref (Array CoreRef))
       (Ref (Array CoreRef))
       (Ref (Array ScopedImport))
       (Ref String)]
      (Result CoreExpr ResolveError)))
  (register resolve-type (Fn [(Ref SurfaceNode)] (Result CoreType ResolveError)))
  (register resolve-type-raw
    (Fn [(Ref SurfaceNode)] (Result CoreType ResolveError)))

  (private resolve-expression)
  (hidden resolve-expression)
  (private resolve-expression-raw)
  (hidden resolve-expression-raw)
  (private identify-expression)
  (hidden identify-expression)
  (private resolve-parameters)
  (hidden resolve-parameters)
  (private resolve-type)
  (hidden resolve-type)
  (defn resolve-arguments [items start locals globals imports scope]
    (let-do [result (the
               (Result (Array (Box CoreExpr)) ResolveError)
               (Result.Success []))
             n (Array.length items)]
      (for [i start n]
        (match-ref &result
          (Result.Success arguments)
            (match (resolve-expression (Box.peek (Array.unsafe-nth items i))
                                       locals
                                       globals
                                       imports
                                       scope)
              (Result.Success expression)
                (Array.push-back! arguments (Box.init expression))
              (Result.Error error) (set! result (Result.Error error)))
          (Result.Error _) ()))
      result))

  (private imported-globals-matching-where)
  (hidden imported-globals-matching-where)
  (doc imported-globals-matching-where "returns the globals named `name` that
the imports visible in `scope` bring in. If `global-only` is true, only
top-level `use`s count, and only module-scoped ones otherwise.")
  (defn imported-globals-matching-where [globals imports scope name global-only]
    (let-do [result (the (Array CoreRef) [])
             n (Array.length imports)]
      (for [i 0 n]
        (let [import (Array.unsafe-nth imports i)
              import-scope (ScopedImport.scope import)]
          (when (if global-only
              (String.empty? import-scope)
              (= import-scope scope))
            (let-do [module-name (ScopedImport.module-name import)
                     absolute (append-scope module-name name)
                     relative (append-scope &(append-scope import-scope
                                                           module-name)
                                            name)]
              (match (global-by-name globals &absolute)
                (Maybe.Just reference) (Array.push-back! &result reference)
                (Maybe.Nothing) ())
              (match (global-by-name globals &relative)
                (Maybe.Just reference) (Array.push-back! &result reference)
                (Maybe.Nothing) ())))))
      result))

  (private member-globals-matching)
  (hidden member-globals-matching)
  (defn member-globals-matching [globals name]
    (let-do [result (the (Array CoreRef) [])
             suffix (String.concat &[@"." (String.copy name)])
             n (Array.length globals)]
      (unless (qualified-name? name)
        (for [i 0 n]
          (let [candidate (Array.unsafe-nth globals i)]
            (when (and
                (String.ends-with? (CoreRef.name candidate) &suffix)
                (live-generation-member? (CoreRef.name candidate)))
              (Array.push-back! &result @candidate)))))
      result))

  (private ref-id-in?)
  (hidden ref-id-in?)
  (defn ref-id-in? [ids target]
    (let-do [found false
             n (Array.length ids)]
      (for [i 0 n]
        (when (Int.= @(Array.unsafe-nth ids i) target) (set! found true)))
      found))

  (private distinct-refs)
  (hidden distinct-refs)
  (defn distinct-refs [candidates]
    (let-do [result (the (Array CoreRef) [])
             seen (the (Array Int) [])
             n (Array.length candidates)]
      (for [i 0 n]
        (let [candidate (Array.unsafe-nth candidates i)]
          (unless-do (ref-id-in? &seen @(CoreRef.id candidate))
            (Array.push-back! &seen @(CoreRef.id candidate))
            (Array.push-back! &result @candidate))))
      result))

  (private same-candidates?)
  (hidden same-candidates?)
  (defn same-candidates? [left right]
    (let-do [same (Int.= (Array.length left) (Array.length right))]
      (for [i 0 (Array.length left)]
        (let-do [candidate (Array.unsafe-nth left i)
                 present false]
          (for [j 0 (Array.length right)]
            (when (CoreIR.same-ref? (Array.unsafe-nth right j) candidate)
              (set! present true)))
          (unless present (set! same false))))
      same))

  (private synthesize-overload!)
  (hidden synthesize-overload!)
  (doc synthesize-overload! "returns the overload of `name` over `candidates`,
and makes it if it does not exist.")
  (defn synthesize-overload! [name candidates globals]
    (let-do [found (the (Maybe CoreRef) (Maybe.Nothing))]
      (for [i 0 (Array.length &*overloads*)]
        (let [entry (Array.unsafe-nth &*overloads* i)]
          (when (and
              (String.= (CoreRef.name (CoreOverload.reference entry)) name)
              (same-candidates? (CoreOverload.candidates entry) candidates))
            (set! found (Maybe.Just @(CoreOverload.reference entry))))))
      (match found
        (Maybe.Just reference)
        reference
        (Maybe.Nothing)
        ;; fresh ids come from the shared global watermark (next-global-id
        ;; also scans the overload table).
        (let-do [fresh (CoreRef.init (next-global-id globals)
                                     (String.copy name)
                                     true)]
          (set! *overloads*
                (Array.push-back @&*overloads*
                                 (CoreOverload.init (CoreRef.copy &fresh)
                                                    (Array.copy candidates))))
          fresh))))

  (private resolve-reference-name)
  (hidden resolve-reference-name)
  (private resolve-reference)
  (hidden resolve-reference)
  (private unknown-binding-error)
  (hidden unknown-binding-error)
  (private resolve-init-reference-name)
  (hidden resolve-init-reference-name)

  (private name-distance)
  (hidden name-distance)
  (doc name-distance "returns how far apart `left` and `right` are: the
difference in length plus the positions that differ in the shorter prefix. Names
whose lengths differ by more than 2 are 1000 apart.")
  (defn name-distance [left right]
    (let-do [shorter (Int.min (String.length left) (String.length right))
             longer (Int.max (String.length left) (String.length right))
             differences (Int.- longer shorter)]
      (if (Int.> differences 2)
        1000
        (do
          (for [i 0 shorter]
            (unless (Char.= (String.char-at left i) (String.char-at right i))
              (set! differences (Int.inc differences))))
          differences))))

  (private nearest-name)
  (hidden nearest-name)
  (doc nearest-name "returns the known global or local name nearest to `symbol`,
if one is near enough to suggest.")
  (defn nearest-name [symbol globals locals]
    (let-do [best @""
             best-distance 3
             n (Array.length globals)]
      (for [i 0 n]
        (let [candidate (CoreRef.name (Array.unsafe-nth globals i))
              distance (name-distance symbol candidate)]
          (when-do (Int.< distance best-distance)
            (set! best-distance distance)
            (set! best (String.copy candidate)))))
      (for [i 0 (Array.length locals)]
        (let [candidate (CoreRef.name (Array.unsafe-nth locals i))
              distance (name-distance symbol candidate)]
          (when-do (Int.< distance best-distance)
            (set! best-distance distance)
            (set! best (String.copy candidate)))))
      best))

  (defn unknown-binding-error [node symbol scope locals globals]
    (let [suggestion (nearest-name symbol globals locals)
          where (if (String.empty? scope)
            @""
            (String.concat &[@" in " (String.copy scope)]))
          hint (if (String.empty? &suggestion)
            @""
            (String.concat &[@"; did you mean " @&suggestion @"?"]))]
      (error-at node
                (String.concat
                  &[@"unknown binding " (String.copy symbol) where hint]))))

  ;; a qualified member the named module does not define falls back to the
  ;; bare name, as the reference's last lookup (`lookupEverywhere`) does: first
  ;; the top-level binding (`(Char.>= a b)` is the generic `>=` of
  ;; Generics.carp, module Char having none), then the one module member of
  ;; that name (`Array.join` is `String.join`). Several members stay unknown,
  ;; as the reference rejects a qualified multisym.
  (private unqualified-fallback-name)
  (hidden unqualified-fallback-name)
  (defn unqualified-fallback-name [globals symbol]
    (let [segments (String.split-by symbol &[\.])]
      (if (Int.> (Array.length &segments) 1)
        (let [bare (Array.unsafe-nth &segments
                                     (Int.dec (Array.length &segments)))]
          (match (global-by-name globals bare)
            (Maybe.Just reference) (Maybe.Just reference)
            (Maybe.Nothing) (unique-member-global-by-name globals bare)))
        (the (Maybe CoreRef) (Maybe.Nothing)))))

  (defn resolve-init-reference-name [node symbol locals globals imports scope]
    (let [init-name (String.concat &[(String.copy symbol) @".init"])]
      (match (scoped-global-by-name globals scope &init-name)
        (Maybe.Just reference) (Result.Success reference)
        (Maybe.Nothing)
          (match (imported-init-by-name globals imports scope symbol)
            (Maybe.Just reference) (Result.Success reference)
            (Maybe.Nothing)
              (match (unqualified-fallback-name globals symbol)
                (Maybe.Just reference) (Result.Success reference)
                (Maybe.Nothing)
                  (Result.Error
                    (unknown-binding-error node symbol scope locals globals)))))))

  (private resolve-through-imports)
  (hidden resolve-through-imports)
  (doc resolve-through-imports "returns what the bare `name` means through the
`use`d modules, as the reference's `lookupInUsed`: the one candidate, or an
overload over several.")
  (defn resolve-through-imports [globals imports scope name]
    (let-do [used (imported-globals-matching-where globals
                                                   imports
                                                   scope
                                                   name
                                                   true)
             scoped (imported-globals-matching-where globals
                                                     imports
                                                     scope
                                                     name
                                                     false)]
      (for [i 0 (Array.length &scoped)]
        (Array.push-back! &used @(Array.unsafe-nth &scoped i)))
      (let [candidates (distinct-refs &used)]
        (cond
          (Int.= 1 (Array.length &candidates))
            (Maybe.Just @(Array.unsafe-nth &candidates 0))
          (Int.>= (Array.length &candidates) 2)
            (Maybe.Just (synthesize-overload! name &candidates globals))
          (the (Maybe CoreRef) (Maybe.Nothing))))))

  (private resolve-reference-name-raw)
  (hidden resolve-reference-name-raw)
  (defn resolve-reference-name-raw [node name locals globals imports scope]
    (let [symbol (String.copy name)]
      (match (local-by-name locals &symbol)
        (Maybe.Just reference) (Result.Success reference)
        (Maybe.Nothing)
          (match (scoped-global-by-name globals scope &symbol)
            (Maybe.Just reference)
              (Result.Success
                ;; a few root names give way to a used module's (see
                ;; `root-yields-to-imports?`): resolve them as if unbound
                (if (root-yields-to-imports? scope &symbol &reference)
                  (match (resolve-through-imports globals imports scope &symbol)
                    (Maybe.Just imported) imported
                    (Maybe.Nothing) reference)
                  reference))
            (Maybe.Nothing)
              (match (resolve-through-imports globals imports scope &symbol)
                (Maybe.Just reference) (Result.Success reference)
                (Maybe.Nothing)
                  (match (compatibility-global-by-name globals &symbol)
                    (Maybe.Just reference) (Result.Success reference)
                    (Maybe.Nothing)
                      (match (unique-member-global-by-name globals &symbol)
                        (Maybe.Just reference)
                        (Result.Success reference)
                        (Maybe.Nothing)
                        ;; implicit `.init`: `(A)` on a type name `A` calls its
                        ;; zero-or-more-argument constructor `A.init`.
                        (resolve-init-reference-name node
                                                     &symbol
                                                     locals
                                                     globals
                                                     imports
                                                     scope))))))))

  (doc resolve-reference-name "resolves `name` to the binding it names and
checks that a private binding is only used from inside its module. The check
uses the resolved name.")
  (defn resolve-reference-name [node name locals globals imports scope]
    (match (resolve-reference-name-raw node name locals globals imports scope)
      (Result.Success reference)
        (if (private-access-error? (CoreRef.name &reference) scope)
          (Result.Error
            (error-at node
                      (String.concat
                        &[@(CoreRef.name &reference)
                          @" is private; it may only be used inside the module that defines it"])))
          (do
            (observe-name! (SurfaceNode.span node)
                           name
                           "reference"
                           (Maybe.Just (CoreRef.copy &reference)))
            (Result.Success reference)))
      (Result.Error error) (Result.Error error)))

  (defn resolve-reference [node locals globals imports scope]
    (match (symbol-key node)
      (Maybe.Just name)
        (resolve-reference-name node &name locals globals imports scope)
      (Maybe.Nothing) (Result.Error (error-at node @"empty symbol"))))

  (private resolve-type-arguments)
  (hidden resolve-type-arguments)
  (private resolve-type-items)
  (hidden resolve-type-items)
  (private resolve-type-name)
  (hidden resolve-type-name)
  (private inferred-lifetime)
  (hidden inferred-lifetime)
  (private resolve-lifetime)
  (hidden resolve-lifetime)
  (defn inferred-lifetime [node]
    (CoreLifetime.Inferred
      @(Info.pos (SurfaceSpan.start (SurfaceNode.span node)))))

  (defn resolve-lifetime [node]
    (match (symbol-key node)
      (Maybe.Just name)
        (if (= &name "static")
          (Result.Success (CoreLifetime.Static))
          (Result.Success (CoreLifetime.Named name)))
      (Maybe.Nothing)
        (Result.Error (error-at node @"lifetime must be a symbol"))))

  (defn resolve-type-arguments [nodes]
    (let-do [result (the
               (Result (Array (Box CoreType)) ResolveError)
               (Result.Success []))
             n (Array.length nodes)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success types)
            (match (resolve-type (Box.peek (Array.unsafe-nth nodes i)))
              (Result.Success type) (Array.push-back! types (Box.init type))
              (Result.Error error) (set! result (Result.Error error)))
          (Result.Error _) ()))
      result))

  (defn resolve-type-items [items start]
    (let-do [result (the
               (Result (Array (Box CoreType)) ResolveError)
               (Result.Success []))
             n (Array.length items)]
      (for [i start n]
        (match-ref &result
          (Result.Success types)
            (match (resolve-type (Box.peek (Array.unsafe-nth items i)))
              (Result.Success type) (Array.push-back! types (Box.init type))
              (Result.Error error) (set! result (Result.Error error)))
          (Result.Error _) ()))
      result))

  (private remember-type-parameter!)
  (hidden remember-type-parameter!)
  (defn remember-type-parameter! [node name]
    (when *resolve-observing*
      (let-do [found false]
        (for [i 0 (Array.length &*resolve-type-parameters*)]
          (when (String.= name
                          (SourceLexicalBinding.name
                            (Array.unsafe-nth &*resolve-type-parameters* i)))
            (set! found true)))
        (unless found
          (Array.push-back! &*resolve-type-parameters*
                            (SourceObservations.binding node name "type"))))))

  (defn resolve-type-name [node name]
    (cond
      (reference-shorthand? name)
        (let [inner-name (reference-shorthand-name name)]
          (match (resolve-type-name node &inner-name)
            (Result.Success inner)
              (Result.Success
                (CoreType.Reference (Box.init inner) (inferred-lifetime node)))
            (Result.Error error) (Result.Error error)))
      (String.= name "Int") (Result.Success (CoreType.Integer))
      (String.= name "String") (Result.Success (CoreType.String))
      (String.= name "Bool") (Result.Success (CoreType.Boolean))
      (String.= name "Unit") (Result.Success (CoreType.Unit))
      (lowercase-start? name)
        (do
          (remember-type-parameter! node name)
          (Result.Success (CoreType.Variable (String.copy name))))
      (Result.Success
        (CoreType.Named (generation-type-name name *resolve-stamp*) []))))

  (defn resolve-type [node]
    (do
      (SourceObservations.type-context! node)
      (if *resolve-observing*
        (let-do [outer (Int.= *resolve-type-depth* 0)
                 _begin (when outer (set! *resolve-type-parameters* []))
                 _enter (set! *resolve-type-depth*
                              (Int.inc *resolve-type-depth*))
                 result (resolve-type-raw node)
                 _leave (set! *resolve-type-depth*
                              (Int.dec *resolve-type-depth*))]
          (when-do outer
            (SourceObservations.type-bindings! node &*resolve-type-parameters*)
            (set! *resolve-type-parameters* []))
          result)
        (resolve-type-raw node))))

  (private resolve-type-raw)
  (hidden resolve-type-raw)
  (defn resolve-type-raw [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.Symbol _)
        (match (symbol-key node)
          (Maybe.Just name)
            (do
              (SourceObservations.record! node &name "type")
              (resolve-type-name node &name))
          (Maybe.Nothing)
            (Result.Error (error-at node @"unknown annotation type")))
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (and *resolve-observing*
                   (and (Int.> (Array.length &items) 0)
                        (and (Int.< (Array.length &items) 3)
                             (or
                               (named? (Box.peek (Array.unsafe-nth &items 0))
                                       @"Fn")
                               (named? (Box.peek (Array.unsafe-nth &items 0))
                                       @"λ")))))
            (let [completed (editing-tail node &items 3)
                  partial (SurfaceNode.init @(SurfaceNode.span node)
                                            (SurfaceForm.List completed))]
              (resolve-type-raw &partial))
            (cond
              (Int.= (Array.length &items) 0) (Result.Success (CoreType.Unit))

              (and (Int.>= (Array.length &items) 3)
                   (or
                     (named? (Box.peek (Array.unsafe-nth &items 0)) @"Fn")
                     (named? (Box.peek (Array.unsafe-nth &items 0)) @"λ")))
                (let [arguments (Box.peek (Array.unsafe-nth &items 1))
                      result (Box.peek (Array.unsafe-nth &items 2))]
                  (match-ref (SurfaceNode.form arguments)
                    (SurfaceForm.Array argument-nodes)
                      (match (resolve-type-arguments argument-nodes)
                        (Result.Success argument-types)
                          (match (resolve-type result)
                            (Result.Success result-type)
                              (Result.Success
                                (CoreType.Function argument-types
                                                   (Box.init result-type)))
                            (Result.Error error) (Result.Error error))
                        (Result.Error error) (Result.Error error))
                    _
                      (Result.Error
                        (error-at arguments
                                  @"Fn annotation arguments must be an array"))))

              (and (Int.>= (Array.length &items) 2)
                   (or
                     (named? (Box.peek (Array.unsafe-nth &items 0)) @"Ref")
                     (or
                       (named? (Box.peek (Array.unsafe-nth &items 0)) @"&")
                       (named? (Box.peek (Array.unsafe-nth &items 0)) @"ref"))))
                (if (Int.<= (Array.length &items) 3)
                  (match (resolve-type (Box.peek (Array.unsafe-nth &items 1)))
                    (Result.Success inner)
                      (if (Int.= (Array.length &items) 3)
                        (match (resolve-lifetime (Box.peek (Array.unsafe-nth &items
                                                                             2)))
                          (Result.Success lifetime)
                            (Result.Success
                              (CoreType.Reference (Box.init inner) lifetime))
                          (Result.Error error) (Result.Error error))
                        (Result.Success
                          (CoreType.Reference (Box.init inner)
                                              (inferred-lifetime node))))
                    (Result.Error error) (Result.Error error))
                  (Result.Error
                    (error-at node
                              @"Ref type expects an inner type and lifetime")))

              (let [head (Box.peek (Array.unsafe-nth &items 0))]
                (match (symbol-key head)
                  (Maybe.Just name)
                    (match (resolve-type-items &items 1)
                      (Result.Success arguments)
                        (Result.Success
                          (CoreType.Named
                            (generation-type-name &name *resolve-stamp*)
                            arguments))
                      (Result.Error error) (Result.Error error))
                  (Maybe.Nothing)
                    (Result.Error
                      (error-at head @"type application head must be a symbol")))))))
      _
        (Result.Error
          (error-at node
                    (String.concat
                      &[@"unsupported annotation type: " (Surface.render node)])))))

  (private resolve-if)
  (hidden resolve-if)
  (private resolve-do)
  (hidden resolve-do)
  (private resolve-let)
  (hidden resolve-let)
  (private resolve-let-bindings)
  (hidden resolve-let-bindings)
  (private resolve-body)
  (hidden resolve-body)
  (private resolve-lambda-parameters)
  (hidden resolve-lambda-parameters)
  (private resolve-lambda)
  (hidden resolve-lambda)
  (private resolve-match)
  (hidden resolve-match)
  (private resolve-set)
  (hidden resolve-set)
  (private resolve-while)
  (hidden resolve-while)
  (private resolve-break)
  (hidden resolve-break)
  (private resolve-pattern)
  (hidden resolve-pattern)
  (private resolve-pattern-items)
  (hidden resolve-pattern-items)
  (private resolve-list-pattern)
  (hidden resolve-list-pattern)
  (private pattern-bindings)
  (hidden pattern-bindings)
  (private append-pattern-bindings)
  (hidden append-pattern-bindings)
  (sig resolve-pattern
       (Fn
         [(Ref SurfaceNode)
          (Ref (Array CoreRef))
          (Ref (Array ScopedImport))
          (Ref String)]
         (Result CorePattern ResolveError)))
  (private resolve-match-branches)
  (hidden resolve-match-branches)
  (private resolve-annotation)
  (hidden resolve-annotation)
  (private resolve-call)
  (hidden resolve-call)

  (defn resolve-lambda-parameters [nodes]
    (let-do [result (the (Result (Array CoreRef) ResolveError)
                         (Result.Success []))
             n (Array.length nodes)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success parameters)
            (let [node (Box.peek (Array.unsafe-nth nodes i))]
              (match (symbol-key node)
                (Maybe.Just name)
                  (let [current (Array.copy parameters)
                        parameter-name (String.copy &name)]
                    (match (local-by-name &current &parameter-name)
                      (Maybe.Just _)
                        (set! result
                              (Result.Error
                                (error-at node @"duplicate lambda parameter")))
                      (Maybe.Nothing)
                        (set! result
                              (Result.Success
                                (Array.push-back current
                                                 (local-reference node
                                                                  &parameter-name
                                                                  "parameter"))))))
                (Maybe.Nothing)
                  (set! result
                        (Result.Error
                          (error-at node @"lambda parameters must be symbols")))))
          (Result.Error _) ()))
      result))

  (defn resolve-if [node items locals globals imports scope]
    (if (and *resolve-observing* (Int.< (Array.length items) 4))
      (let [completed (editing-tail node items 4)]
        (resolve-if node &completed locals globals imports scope))
      (cond
        (Int.= (Array.length items) 3)
          (match (resolve-expression (Box.peek (Array.unsafe-nth items 1))
                                     locals
                                     globals
                                     imports
                                     scope)
            (Result.Success condition)
              (match (resolve-expression (Box.peek (Array.unsafe-nth items 2))
                                         locals
                                         globals
                                         imports
                                         scope)
                (Result.Success then-branch)
                  (Result.Success
                    (CoreExpr.If -1
                                 (Box.init condition)
                                 (Box.init then-branch)
                                 (Box.init (CoreExpr.UnitLit -1))))
                (Result.Error error) (Result.Error error))
            (Result.Error error) (Result.Error error))
        (Int.= (Array.length items) 4)
          (match (resolve-expression (Box.peek (Array.unsafe-nth items 1))
                                     locals
                                     globals
                                     imports
                                     scope)
            (Result.Success condition)
              (match (resolve-expression (Box.peek (Array.unsafe-nth items 2))
                                         locals
                                         globals
                                         imports
                                         scope)
                (Result.Success then-branch)
                  (match (resolve-expression (Box.peek (Array.unsafe-nth items 3))
                                             locals
                                             globals
                                             imports
                                             scope)
                    (Result.Success else-branch)
                      (Result.Success
                        (CoreExpr.If -1
                                     (Box.init condition)
                                     (Box.init then-branch)
                                     (Box.init else-branch)))
                    (Result.Error error) (Result.Error error))
                (Result.Error error) (Result.Error error))
            (Result.Error error) (Result.Error error))
        (Result.Error
          (error-at node
                    (String.concat
                      &[@"if expects condition, then, and optional else expressions; got "
                        (Int.str (Array.length items))
                        @" items"]))))))

  (defn resolve-do [-node items locals globals imports scope]
    (match (resolve-arguments items 1 locals globals imports scope)
      (Result.Success expressions) (Result.Success (CoreExpr.Do -1 expressions))
      (Result.Error error) (Result.Error error)))

  (defn resolve-set [node items locals globals imports scope]
    (if (Int.= (Array.length items) 3)
      (let [target (Box.peek (Array.unsafe-nth items 1))
            value-node (Box.peek (Array.unsafe-nth items 2))]
        (match (resolve-reference target locals globals imports scope)
          (Result.Success reference)
            (match (resolve-expression value-node locals globals imports scope)
              (Result.Success value)
                (Result.Success (CoreExpr.Set -1 reference (Box.init value)))
              (Result.Error error) (Result.Error error))
          (Result.Error error) (Result.Error error)))
      (Result.Error (error-at node @"set! expects a target and value"))))

  (defn resolve-while [node items locals globals imports scope]
    (if (Int.= (Array.length items) 3)
      (match (resolve-expression (Box.peek (Array.unsafe-nth items 1))
                                 locals
                                 globals
                                 imports
                                 scope)
        (Result.Success condition)
          (match (resolve-expression (Box.peek (Array.unsafe-nth items 2))
                                     locals
                                     globals
                                     imports
                                     scope)
            (Result.Success body)
              (Result.Success
                (CoreExpr.While -1 (Box.init condition) (Box.init body)))
            (Result.Error error) (Result.Error error))
        (Result.Error error) (Result.Error error))
      (Result.Error (error-at node @"while expects a condition and body"))))

  (defn resolve-break [node items]
    (if (Int.= (Array.length items) 1)
      (Result.Success (CoreExpr.Break -1))
      (Result.Error (error-at node @"break expects no arguments"))))

  ;; the name a `let` binding position binds, if it is a plain symbol.
  (private binding-name-at)
  (hidden binding-name-at)
  (defn binding-name-at [binding-items index]
    (if (Int.< index (Array.length binding-items))
      (symbol-key (Box.peek (Array.unsafe-nth binding-items index)))
      (Maybe.Nothing)))

  (doc duplicate-binding "returns a name bound twice in one `let`, if any. The
reference rejects this too.")
  (private duplicate-binding)
  (hidden duplicate-binding)
  (private name-seen?)
  (hidden name-seen?)
  (defn name-seen? [seen name]
    (let-do [found false]
      (for [i 0 (Array.length seen)]
        (when (String.= (Array.unsafe-nth seen i) name) (set! found true)))
      found))

  (defn duplicate-binding [binding-items]
    (let-do [seen (the (Array String) [])
             found (the (Maybe String) (Maybe.Nothing))
             n (Array.length binding-items)
             index 0]
      (while-do (Int.< (Int.inc index) n)
        (match (binding-name-at binding-items index)
          (Maybe.Just name)
            (do
              (when (and (name-seen? &seen &name)
                         (match-ref &found (Maybe.Nothing) true _ false))
                (set! found (Maybe.Just (String.copy &name))))
              (Array.push-back! &seen name))
          (Maybe.Nothing) ())
        (set! index (Int.+ index 2)))
      found))

  (defn resolve-let [node items locals globals imports scope]
    (cond
      (and *resolve-observing* (Int.< (Array.length items) 3))
      (let [completed (editing-tail node items 3)]
        (resolve-let node &completed locals globals imports scope))
      ;; extra body forms are an implicit do, matching the reference.
      (Int.>= (Array.length items) 3)
      (let [bindings (Box.peek (Array.unsafe-nth items 1))
            body-start 2]
        (match-ref (SurfaceNode.form bindings)
          (SurfaceForm.Array binding-items)
            (let [semantic-bindings (semantic-items binding-items)]
              (match (duplicate-binding &semantic-bindings)
                (Maybe.Just name)
                  (Result.Error
                    (error-at bindings
                              (String.concat
                                &[@"duplicate binding `" name @"` inside `let`"])))
                (Maybe.Nothing)
                  (resolve-let-bindings node
                                        &semantic-bindings
                                        0
                                        items
                                        body-start
                                        locals
                                        globals
                                        imports
                                        scope)))
          _ (Result.Error (error-at bindings @"let bindings must be an array"))))
      (Result.Error (error-at node @"let expects a binding array and body"))))

  (defn resolve-body [items start locals globals imports scope]
    (let [remaining (Int.- (Array.length items) start)]
      (cond
        (Int.= remaining 0) (Result.Success (CoreExpr.UnitLit -1))
        (Int.= remaining 1)
          (resolve-expression
            (Box.peek (Array.unsafe-nth items start))
            locals
            globals
            imports
            scope)
        (match (resolve-arguments items start locals globals imports scope)
          (Result.Success expressions)
            (Result.Success (CoreExpr.Do -1 expressions))
          (Result.Error error) (Result.Error error)))))

  (private fn-value?)
  (hidden fn-value?)
  (defn fn-value? [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List items)
        (and (Int.> (Array.length items) 0)
             (named? (Box.peek (Array.unsafe-nth items 0)) @"fn"))
      _ false))

  (private resolve-bindings)
  (hidden resolve-bindings)
  (sig resolve-bindings
       (Fn
         [(Ref SurfaceNode)
          (Ref (Array (Box SurfaceNode)))
          Int
          (Ref (Array CoreRef))
          (Ref (Array CoreRef))
          (Ref (Array ScopedImport))
          (Ref String)
          (Ref String)
          (Ref (Fn [(Ref (Array CoreRef))] (Result CoreExpr ResolveError)))]
         (Result CoreExpr ResolveError)))
  (defn resolve-bindings [node
                          binding-items
                          index
                          locals
                          globals
                          imports
                          scope
                          role
                          body]
    (cond
      (Int.= index (Array.length binding-items)) (~body locals)
      (Int.< (Int.inc index) (Array.length binding-items))
        (let [name-node (Box.peek (Array.unsafe-nth binding-items index))
              value-node (Box.peek
                (Array.unsafe-nth binding-items (Int.inc index)))]
          (match (symbol-key name-node)
            (Maybe.Just name)
              (let [reference (local-reference name-node &name role)
                    value-locals (if (fn-value? value-node)
                      (Array.push-back (Array.copy locals)
                                       (CoreRef.copy &reference))
                      (Array.copy locals))]
                (match (resolve-expression value-node
                                           &value-locals
                                           globals
                                           imports
                                           scope)
                  (Result.Error error) (Result.Error error)
                  (Result.Success value)
                    (let [extended (Array.push-back (Array.copy locals)
                                                    (CoreRef.copy &reference))]
                      (match (resolve-bindings node
                                               binding-items
                                               (Int.+ index 2)
                                               &extended
                                               globals
                                               imports
                                               scope
                                               role
                                               body)
                        (Result.Error error) (Result.Error error)
                        (Result.Success resolved-body)
                          (Result.Success
                            (CoreExpr.Let -1
                                          reference
                                          (Box.init value)
                                          (Box.init resolved-body)))))))
            (Maybe.Nothing)
              (Result.Error (error-at name-node @"let binding must be a symbol"))))
      (Result.Error (error-at node @"let bindings must be name/value pairs"))))

  (defn resolve-let-bindings [node
                              binding-items
                              index
                              body-items
                              body-start
                              locals
                              globals
                              imports
                              scope]
    (let [body (fn [extended]
            (do
              (observe-region! (SurfaceNode.span node)
                               (SurfaceNode.span
                                 (Box.peek (Array.unsafe-nth body-items 1)))
                               extended
                               imports
                               scope)
              (resolve-body body-items body-start extended globals imports scope)))]
      (resolve-bindings node
                        binding-items
                        index
                        locals
                        globals
                        imports
                        scope
                        "local"
                        &body)))

  (defn resolve-lambda [node items locals globals imports scope]
    (cond
      (and *resolve-observing* (Int.< (Array.length items) 3))
        (let [completed (editing-tail node items 3)]
          (resolve-lambda node &completed locals globals imports scope))
      (Int.= (Array.length items) 3)
        (let [parameters-node (Box.peek (Array.unsafe-nth items 1))
              body (Box.peek (Array.unsafe-nth items 2))]
          (match-ref (SurfaceNode.form parameters-node)
            (SurfaceForm.Array parameter-nodes)
              (match (resolve-lambda-parameters parameter-nodes)
                (Result.Success parameters)
                  (let-do [extended (Array.copy locals)
                           n (Array.length &parameters)]
                    (for [i 0 n]
                      (set! extended
                            (Array.push-back extended
                                             @(Array.unsafe-nth &parameters i))))
                    (observe-region! (SurfaceNode.span node)
                                     (SurfaceNode.span parameters-node)
                                     &extended
                                     imports
                                     scope)
                    (match (resolve-expression body
                                               &extended
                                               globals
                                               imports
                                               scope)
                      (Result.Success resolved-body)
                        (Result.Success
                          (CoreExpr.Lambda -1
                                           parameters
                                           (Box.init resolved-body)))
                      (Result.Error error) (Result.Error error)))
                (Result.Error error) (Result.Error error))
            _
              (Result.Error
                (error-at parameters-node @"fn parameters must be an array"))))
      (Result.Error (error-at node @"fn expects a parameter array and body"))))

  (defn append-pattern-bindings [left right]
    (let-do [result (Array.copy left)
             n (Array.length right)]
      (for [i 0 n]
        (set! result (Array.push-back result @(Array.unsafe-nth right i))))
      result))

  (defn pattern-bindings [pattern]
    (match-ref pattern
      (CorePattern.Ignore) []
      (CorePattern.Bind reference) [(CoreRef.copy reference)]
      (CorePattern.Constructor _ children)
        (let-do [result (the (Array CoreRef) [])
                 n (Array.length children)]
          (for [i 0 n]
            (set! result
                  (append-pattern-bindings &result
                                           &(pattern-bindings (Box.peek (Array.unsafe-nth children
                                                                                          i))))))
          result)))

  (defn resolve-pattern-items [items start globals imports scope]
    (let-do [result (the
               (Result (Array (Box CorePattern)) ResolveError)
               (Result.Success []))
             n (Array.length items)]
      (for [i start n]
        (match-ref &result
          (Result.Success patterns)
            (match (resolve-pattern (Box.peek (Array.unsafe-nth items i))
                                    globals
                                    imports
                                    scope)
              (Result.Success pattern)
                (Array.push-back! patterns (Box.init pattern))
              (Result.Error error) (set! result (Result.Error error)))
          (Result.Error _) ()))
      result))

  (defn resolve-list-pattern [node items globals imports scope]
    (if (Int.> (Array.length items) 0)
      (let [head (Box.peek (Array.unsafe-nth items 0))]
        (match (symbol-key head)
          (Maybe.Just name)
            (if (lowercase-start? &name)
              (Result.Error
                (error-at head @"pattern constructor must be global"))
              (match (resolve-reference-name head
                                             &name
                                             &[]
                                             globals
                                             imports
                                             scope)
                (Result.Success reference)
                  (match (resolve-pattern-items items 1 globals imports scope)
                    (Result.Success children)
                      (Result.Success
                        (CorePattern.Constructor reference children))
                    (Result.Error error) (Result.Error error))
                (Result.Error error) (Result.Error error)))
          (Maybe.Nothing)
            (Result.Error
              (error-at head @"pattern constructor must be a symbol"))))
      (Result.Error (error-at node @"empty list is not a pattern"))))

  (defn resolve-pattern [node globals imports scope]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.Symbol _)
        (match (symbol-key node)
          (Maybe.Just name)
            (cond
              (= &name "_") (Result.Success (CorePattern.Ignore))
              (variable-name? &name)
                (Result.Success
                  (CorePattern.Bind (local-reference node &name "pattern")))
              (match (resolve-reference-name node
                                             &name
                                             &[]
                                             globals
                                             imports
                                             scope)
                (Result.Success reference)
                  (Result.Success (CorePattern.Constructor reference []))
                (Result.Error error) (Result.Error error)))
          (Maybe.Nothing)
            (Result.Error (error-at node @"invalid symbol pattern")))
      (SurfaceForm.List items)
        (resolve-list-pattern node items globals imports scope)
      _ (Result.Error (error-at node @"unsupported pattern form"))))

  (defn resolve-match-branches [items start locals globals imports scope]
    (let-do [result (the
               (Result (Array CoreMatchBranch) ResolveError)
               (Result.Success []))
             n (Array.length items)]
      (for [i start n 2]
        (match-ref &result
          (Result.Success branches)
            (let [pattern (Box.peek (Array.unsafe-nth items i))
                  body (Box.peek (Array.unsafe-nth items (Int.inc i)))]
              (match (resolve-pattern pattern globals imports scope)
                (Result.Success resolved-pattern)
                  (let [bindings (pattern-bindings &resolved-pattern)
                        extended (append-pattern-bindings locals &bindings)]
                    (match (resolve-expression body
                                               &extended
                                               globals
                                               imports
                                               scope)
                      (Result.Success resolved-body)
                        (Array.push-back! branches
                                          (CoreMatchBranch.init resolved-pattern
                                                                bindings
                                                                (Box.init resolved-body)))
                      (Result.Error error) (set! result (Result.Error error))))
                (Result.Error error) (set! result (Result.Error error))))
          (Result.Error _) ()))
      result))

  (defn resolve-match [node items locals globals imports scope]
    (if (and (Int.>= (Array.length items) 4)
             (Int.= 0 (Int.mod (Int.- (Array.length items) 2) 2)))
      (match (resolve-expression (Box.peek (Array.unsafe-nth items 1))
                                 locals
                                 globals
                                 imports
                                 scope)
        (Result.Success scrutinee)
          (match (resolve-match-branches items 2 locals globals imports scope)
            (Result.Success branches)
              (Result.Success
                (CoreExpr.Match -1
                                (named? (Box.peek (Array.unsafe-nth items 0))
                                        @"match-ref")
                                (Box.init scrutinee)
                                branches))
            (Result.Error error) (Result.Error error))
        (Result.Error error) (Result.Error error))
      (Result.Error
        (error-at node @"match expects a scrutinee and pattern/body pairs"))))

  (defn resolve-annotation [node items locals globals imports scope]
    (cond
      (and *resolve-observing* (Int.< (Array.length items) 3))
        (let [completed (editing-tail node items 3)]
          (resolve-annotation node &completed locals globals imports scope))
      (Int.= (Array.length items) 3)
        (match (resolve-type (Box.peek (Array.unsafe-nth items 1)))
          (Result.Success annotation)
            (match (resolve-expression (Box.peek (Array.unsafe-nth items 2))
                                       locals
                                       globals
                                       imports
                                       scope)
              (Result.Success expression)
                (Result.Success
                  (CoreExpr.Annotation -1
                                       (Box.init expression)
                                       (Box.init annotation)))
              (Result.Error error) (Result.Error error))
          (Result.Error error) (Result.Error error))
      (Result.Error (error-at node @"the expects a type and expression"))))

  (private arity-of)
  (hidden arity-of)
  (defn arity-of [name] (Map.get-maybe &*resolve-arities* name))

  (private arity-compatible?)
  (hidden arity-compatible?)
  ; a name with no known arity is compatible with any arity
  (defn arity-compatible? [reference arity]
    (match (arity-of (CoreRef.name reference))
      (Maybe.Just known) (Int.= known arity)
      (Maybe.Nothing) true))

  (private surface-signature-arity)
  (hidden surface-signature-arity)
  (defn surface-signature-arity [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (and (Int.= 3 (Array.length &items))
                   (or
                     (named? (Box.peek (Array.unsafe-nth &items 0)) @"Fn")
                     (named? (Box.peek (Array.unsafe-nth &items 0)) @"λ")))
            (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth &items 1)))
              (SurfaceForm.Array parameter-nodes) (Array.length parameter-nodes)
              _ -1)
            -1))
      _ -1))

  (private populate-arities!)
  (hidden populate-arities!)
  (doc populate-arities! "fills `*resolve-arities*` from the module's functions,
signatures, constructors and the primitives.")
  (defn populate-arities! [collected constructor-builtins]
    (let-do [table (the (Map String Int) (Map.create))
             ;; per-module reset of the overload-synthesis channel filled
             ;; during body resolution.
             _ignored-overloads (set! *overloads* [])]
      (let [functions (CollectedForms.functions collected)]
        (for [i 0 (Array.length functions)]
          (let [shape (Array.unsafe-nth functions i)]
            (Map.put! &table
                      (FunctionShape.name shape)
                      &(Array.length (FunctionShape.parameters shape))))))
      (let [builtins (CollectedForms.builtins collected)]
        (for [i 0 (Array.length builtins)]
          (let [shape (Array.unsafe-nth builtins i)]
            (let [arity (surface-signature-arity (Box.peek (TypedShape.signature shape)))]
              (when (Int.>= arity 0)
                (Map.put! &table (TypedShape.name shape) &arity))))))
      (let [registry (PrimitiveRegistry.builtins)]
        (for [i 0 (Array.length &registry)]
          (let [builtin (Array.unsafe-nth &registry i)]
            (match-ref (Box.peek (CoreBuiltin.signature builtin))
              (CoreType.Function signature-arguments _)
                (Map.put! &table
                          (CoreRef.name (CoreBuiltin.reference builtin))
                          &(Array.length signature-arguments))
              _ ()))))
      (for [i 0 (Array.length constructor-builtins)]
        (let [builtin (Array.unsafe-nth constructor-builtins i)]
          (match-ref (Box.peek (CoreBuiltin.signature builtin))
            (CoreType.Function signature-arguments _)
              (Map.put! &table
                        (CoreRef.name (CoreBuiltin.reference builtin))
                        &(Array.length signature-arguments))
            _ ())))
      (set! *resolve-arities* table)))

  (private arity-matching)
  (hidden arity-matching)
  (defn arity-matching [candidates arity]
    (let-do [distinct (distinct-refs candidates)
             result (the (Array CoreRef) [])]
      (for [i 0 (Array.length &distinct)]
        (let [candidate (Array.unsafe-nth &distinct i)]
          (match (arity-of (CoreRef.name candidate))
            (Maybe.Just known)
              (when (Int.= known arity) (Array.push-back! &result @candidate))
            (Maybe.Nothing) ())))
      result))

  (private resolve-call-head)
  (hidden resolve-call-head)
  (doc resolve-call-head "resolves the head `name` of a call with `arity`
arguments. A local wins. Then a global of the scope with a fitting arity. Then
the candidates of the `use`d modules with that arity, or, if there are none, the
module members with that arity: one is picked, several become an overload.
Otherwise it resolves as a plain reference.")
  (defn resolve-call-head [head name arity locals globals imports scope]
    (if (match (local-by-name locals name)
        (Maybe.Just _) true
        (Maybe.Nothing) false)
      (resolve-reference-name head name locals globals imports scope)
      (let [positional (scoped-global-by-name globals scope name)
            positional-ok (match-ref &positional
              (Maybe.Just reference) (arity-compatible? reference arity)
              (Maybe.Nothing) false)]
        (if positional-ok
          (resolve-reference-name head name locals globals imports scope)
          ; as the reference's `lookupInUsed`: candidates from the `use`d
          ; modules, top-level and module-scoped alike. the member scan
          ; (`lookupEverywhere`) supplies candidates when none of them has
          ; the arity.
          (let-do [used (imported-globals-matching-where globals
                                                         imports
                                                         scope
                                                         name
                                                         true)
                   scoped (imported-globals-matching-where globals
                                                           imports
                                                           scope
                                                           name
                                                           false)]
            (for [i 0 (Array.length &scoped)]
              (Array.push-back! &used @(Array.unsafe-nth &scoped i)))
            (let [used-matching (arity-matching &used arity)
                  candidates (if (Int.> (Array.length &used-matching) 0)
                    used-matching
                    (arity-matching &(member-globals-matching globals name)
                                    arity))]
              (cond
                (Int.= 1 (Array.length &candidates))
                  (Result.Success @(Array.unsafe-nth &candidates 0))
                (Int.>= (Array.length &candidates) 2)
                  (Result.Success
                    (synthesize-overload! name &candidates globals))
                (resolve-reference-name head name locals globals imports scope))))))))

  (defn resolve-call [-node items locals globals imports scope]
    (let [head (Box.peek (Array.unsafe-nth items 0))
          arity (Int.dec (Array.length items))]
      (match (match (symbol-key head)
          (Maybe.Just name)
            (match (resolve-call-head head
                                      &name
                                      arity
                                      locals
                                      globals
                                      imports
                                      scope)
              (Result.Success reference)
                (Result.Success
                  (identify-expression head &(CoreExpr.Reference -1 reference)))
              (Result.Error error) (Result.Error error))
          (Maybe.Nothing) (resolve-expression head locals globals imports scope))
        (Result.Success callee)
          (match (resolve-arguments items 1 locals globals imports scope)
            (Result.Success arguments)
              (Result.Success (CoreExpr.Call -1 (Box.init callee) arguments))
            (Result.Error error) (Result.Error error))
        (Result.Error error) (Result.Error error))))

  (defn resolve-expression-raw [node locals globals imports scope]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.Invalid _)
      (Result.Error (error-at node @"incomplete or invalid source"))
      (SurfaceForm.IntLit value)
      (Result.Success (CoreExpr.IntLit -1 @value))
      (SurfaceForm.ByteLit value)
      (Result.Success (CoreExpr.ByteLit -1 @value))
      (SurfaceForm.LongLit value)
      (Result.Success (CoreExpr.LongLit -1 @value))
      (SurfaceForm.FloatLit value)
      (Result.Success (CoreExpr.FloatLit -1 @value))
      (SurfaceForm.DoubleLit value)
      (Result.Success (CoreExpr.DoubleLit -1 @value))
      (SurfaceForm.CharLit value)
      (Result.Success (CoreExpr.CharLit -1 @value))
      (SurfaceForm.StringLit value)
      (Result.Success (CoreExpr.StringLit -1 (String.copy value)))
      (SurfaceForm.PatternLit value)
      (Result.Success (CoreExpr.PatternLit -1 (String.copy value)))
      (SurfaceForm.BoolLit value)
      (Result.Success (CoreExpr.BoolLit -1 @value))
      (SurfaceForm.Symbol _)
      (match (symbol-key node)
        (Maybe.Just name)
          (let [symbol (String.copy &name)]
            (cond
              (= &symbol "0b")
                (Result.Success (CoreExpr.ByteLit -1 (Byte.from-int 0)))
              (= &symbol "1b")
                (Result.Success (CoreExpr.ByteLit -1 (Byte.from-int 1)))
              (= &symbol "2b")
                (Result.Success (CoreExpr.ByteLit -1 (Byte.from-int 2)))
              (match (resolve-reference node locals globals imports scope)
                (Result.Success reference)
                  (Result.Success (CoreExpr.Reference -1 reference))
                (Result.Error error) (Result.Error error))))
        (Maybe.Nothing) (Result.Error (error-at node @"empty symbol")))
      (SurfaceForm.List raw-items)
      (let [items (semantic-items raw-items)]
        (if (Int.= (Array.length &items) 0)
          (Result.Success (CoreExpr.UnitLit -1))
          (let [head (Box.peek (Array.unsafe-nth &items 0))]
            (cond
              (ignored-declaration? node) (Result.Success (CoreExpr.UnitLit -1))
              (or (declaration? node @"register")
                  (match (symbol-key head)
                    (Maybe.Just key)
                      (or (= &key "Unsafe.preproc") (= &key "Unsafe.emit-c"))
                    (Maybe.Nothing) false))
                (Result.Success (CoreExpr.UnitLit -1))
              (operator? head @"do")
                (resolve-do node &items locals globals imports scope)
              (operator? head @"if")
                (resolve-if node &items locals globals imports scope)
              (operator? head @"set!")
                (resolve-set node &items locals globals imports scope)
              (operator? head @"while")
                (resolve-while node &items locals globals imports scope)
              (operator? head @"break") (resolve-break node &items)
              (operator? head @"let")
                (resolve-let node &items locals globals imports scope)
              (operator? head @"fn")
                (resolve-lambda node &items locals globals imports scope)
              (or (operator? head @"match") (operator? head @"match-ref"))
                (resolve-match node &items locals globals imports scope)
              (operator? head @"the")
                (resolve-annotation node &items locals globals imports scope)
              (resolve-call node &items locals globals imports scope)))))
      (SurfaceForm.Array items)
      (let [elements (semantic-items items)]
        (match (resolve-arguments &elements 0 locals globals imports scope)
          (Result.Success expressions)
            (Result.Success (CoreExpr.ArrayLit -1 expressions))
          (Result.Error error) (Result.Error error)))
      (SurfaceForm.StaticArray items)
      (let [elements (semantic-items items)]
        (match (resolve-arguments &elements 0 locals globals imports scope)
          (Result.Success expressions)
            (Result.Success (CoreExpr.StaticArrayLit -1 expressions))
          (Result.Error error) (Result.Error error)))
      ;; a `{k v ...}` literal desugars to `(Map.from-array [(Pair.init k v) ...])`,
      ;; matching the reference parser; the pairs resolve as ordinary calls.
      (SurfaceForm.Dictionary entries)
      (if (Int./= 0 (Int.mod (Array.length entries) 2))
        (Result.Error
          (error-at node @"dictionary literal needs an even number of forms"))
        (let-do [span @(SurfaceNode.span node)
                 pairs (the (Array (Box SurfaceNode)) [])]
          (for [i 0 (Int./ (Array.length entries) 2)]
            (let [k @(Array.unsafe-nth entries (Int.* i 2))
                  v @(Array.unsafe-nth entries (Int.+ (Int.* i 2) 1))
                  pair-sym (Box.init
                    (SurfaceNode.generated @&span
                                           (SurfaceForm.Symbol [@"Pair" @"init"])))]
              (Array.push-back! &pairs
                                (Box.init
                                  (SurfaceNode.generated @&span
                                                         (SurfaceForm.List [pair-sym
                                                                            k
                                                                            v]))))))
          (resolve-call node
                        &[(Box.init
                            (SurfaceNode.generated @&span
                                                   (SurfaceForm.Symbol [@"Map"
                                                                        @"from-array"])))
                          (Box.init
                            (SurfaceNode.generated @&span
                                                   (SurfaceForm.Array pairs)))]
                        locals
                        globals
                        imports
                        scope)))
      (SurfaceForm.Comment _)
      (Result.Success (CoreExpr.UnitLit -1))))

  (defn identify-expression [node expression]
    (if *provenance-enabled*
      (let-do [id *provenance-next-node-id*
               _ignored-next (set! *provenance-next-node-id* (Int.inc id))
               identified (CoreIR.with-expression-id expression id)
               origin (NodeProvenance.init id
                                           (source-span (SurfaceNode.span node)))]
        (Array.push-back! &*provenance-nodes* origin)
        identified)
      (CoreExpr.copy expression)))

  (defn resolve-expression [node locals globals imports scope]
    (if (WorkBudget.consume! 1)
      (do
        (observe-scope! node locals globals imports scope)
        (match (resolve-expression-raw node locals globals imports scope)
          (Result.Success expression)
            (Result.Success (identify-expression node &expression))
          (Result.Error error) (Result.Error error)))
      (Result.Error (error-at node (WorkBudget.reason)))))

  (defn resolve-parameters [nodes -start]
    (let-do [result (the (Result (Array CoreRef) ResolveError)
                         (Result.Success []))
             n (Array.length nodes)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success parameters)
            (let [node (Box.peek (Array.unsafe-nth nodes i))]
              (match (symbol-key node)
                (Maybe.Just name)
                  (let [current (Array.copy parameters)
                        parameter-name (String.copy &name)]
                    (match (local-by-name &current &parameter-name)
                      (Maybe.Just _)
                        (set! result
                              (Result.Error
                                (error-at node @"duplicate function parameter")))
                      (Maybe.Nothing)
                        (set! result
                              (Result.Success
                                (Array.push-back current
                                                 (local-reference node
                                                                  &parameter-name
                                                                  "parameter"))))))
                (Maybe.Nothing)
                  (set! result
                        (Result.Error
                          (error-at node @"function parameters must be symbols")))))
          (Result.Error _) ()))
      result))

  (private resolve-functions)
  (hidden resolve-functions)
  (private interface-references)
  (hidden interface-references)
  (private append-core-refs)
  (hidden append-core-refs)

  (defn interface-references [globals interface-shapes]
    (let-do [result (the (Array CoreRef) [])
             builtins (PrimitiveRegistry.interfaces)
             builtin-count (Array.length &builtins)
             interface-count (Array.length interface-shapes)]
      (for [i 0 builtin-count]
        (set! result
              (Array.push-back result
                               (CoreRef.copy
                                 (CoreInterface.reference (Array.unsafe-nth &builtins
                                                                            i))))))
      (for [i 0 interface-count]
        (let [shape (Array.unsafe-nth interface-shapes i)]
          (match (first-global-by-name globals (TypedShape.name shape))
            (Maybe.Just reference)
              (set! result (Array.push-back result reference))
            (Maybe.Nothing) ())))
      result))

  (defn append-core-refs [left right]
    (let-do [result (Array.copy left)
             n (Array.length right)]
      (for [i 0 n]
        (set! result
              (Array.push-back result (CoreRef.copy (Array.unsafe-nth right i)))))
      result))

  (defn resolve-functions [shapes globals imports interface-shapes]
    ;; Keep the error outside the accumulator. Wrapping `functions` in a new
    ;; Result after every append deep-copies every previously resolved body.
    (let-do [functions (the (Array CoreFunction) [])
             failure (the (Maybe ResolveError) (Maybe.Nothing))
             global-count (Array.length globals)
             next-local-id global-count
             interfaces (interface-references globals interface-shapes)
             n (Array.length shapes)]
      (for [i 0 n]
        (when (or (Maybe.nothing? &failure)
                  (and *resolve-observing* (not (WorkBudget.stopped?))))
          (let [shape (Array.unsafe-nth shapes i)
                name (FunctionShape.name shape)
                first-local-id next-local-id
                _ignored-next (set! next-local-id
                                    (Int.+ next-local-id
                                           (Array.length (FunctionShape.parameters shape))))
                _ignored-stamp (set! *resolve-stamp*
                                     @(FunctionShape.stamp shape))]
            (match (global-by-name globals name)
              (Maybe.Just reference)
                (match (resolve-parameters (FunctionShape.parameters shape)
                                           first-local-id)
                  (Result.Success parameters)
                    (let-do [resolution-locals (append-core-refs &interfaces
                                                                 &parameters)]
                      (observe-region! (FunctionShape.span shape)
                                       (FunctionShape.parameters-span shape)
                                       &resolution-locals
                                       &(imports-with imports
                                                      (FunctionShape.scope shape)
                                                      (FunctionShape.withs shape))
                                       (FunctionShape.scope shape))
                      (match (resolve-expression (Box.peek (FunctionShape.body shape))
                                                 &resolution-locals
                                                 globals
                                                 &(imports-with imports
                                                                (FunctionShape.scope shape)
                                                                (FunctionShape.withs shape))
                                                 (FunctionShape.scope shape))
                        (Result.Success body)
                          (Array.push-back! &functions
                                            (CoreFunction.init reference
                                                               parameters
                                                               (Box.init body)))
                        (Result.Error error) (set! failure (Maybe.Just error))))
                  (Result.Error error) (set! failure (Maybe.Just error)))
              (Maybe.Nothing)
                (set! failure
                      (Maybe.Just
                        (ResolveError.init @"missing function reference"
                                           @(FunctionShape.span shape))))))))
      (match failure
        (Maybe.Just error) (Result.Error error)
        (Maybe.Nothing) (Result.Success functions))))

  (private resolve-values)
  (hidden resolve-values)
  (doc resolve-values "resolves the body of each value in `shapes`. A name that
names an interface is the interface.")
  (defn resolve-values [shapes globals imports interface-shapes]
    (let-do [result (the (Result (Array CoreValue) ResolveError)
                         (Result.Success []))
             locals (interface-references globals interface-shapes)
             n (Array.length shapes)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success values)
            (let [shape (Array.unsafe-nth shapes i)
                  name (ValueShape.name shape)
                  _ignored-stamp (set! *resolve-stamp* @(ValueShape.stamp shape))]
              (match (global-by-name globals name)
                (Maybe.Just reference)
                  (match (resolve-expression (Box.peek (ValueShape.body shape))
                                             &locals
                                             globals
                                             &(imports-with imports
                                                            (ValueShape.scope shape)
                                                            (ValueShape.withs shape))
                                             (ValueShape.scope shape))
                    (Result.Success body)
                      (Array.push-back! values
                                        (CoreValue.init reference
                                                        (Box.init body)))
                    (Result.Error error) (set! result (Result.Error error)))
                (Maybe.Nothing)
                  (set! result
                        (Result.Error
                          (ResolveError.init @"missing value reference"
                                             @(ValueShape.span shape))))))
          (Result.Error _) ()))
      result))

  (private resolve-builtins)
  (hidden resolve-builtins)
  (private resolve-builtin-sources)
  (hidden resolve-builtin-sources)
  (defn resolve-builtins [shapes globals]
    (let-do [result (the
               (Result (Array CoreBuiltin) ResolveError)
               (Result.Success []))
             n (Array.length shapes)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success builtins)
            (let [shape (Array.unsafe-nth shapes i)
                  name (TypedShape.name shape)
                  _ignored-stamp (set! *resolve-stamp* @(TypedShape.stamp shape))]
              (match (global-by-name globals name)
                (Maybe.Just reference)
                  (match (resolve-type (Box.peek (TypedShape.signature shape)))
                    (Result.Success signature)
                      (Array.push-back! builtins
                                        (CoreBuiltin.init reference
                                                          (Box.init signature)))
                    (Result.Error error) (set! result (Result.Error error)))
                (Maybe.Nothing)
                  (set! result
                        (Result.Error
                          (ResolveError.init @"missing builtin reference"
                                             @(TypedShape.span shape))))))
          (Result.Error _) ()))
      result))

  (defn resolve-builtin-sources [shapes globals]
    (let-do [result (the
               (Result (Array CoreBuiltinSource) ResolveError)
               (Result.Success []))
             n (Array.length shapes)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success sources)
            (let [shape (Array.unsafe-nth shapes i)
                  _ignored-stamp (set! *resolve-stamp* @(TypedShape.stamp shape))]
              (match-ref (TypedShape.payload shape)
                (Maybe.Just payload)
                  (match (global-by-name globals (TypedShape.name shape))
                    (Maybe.Just reference)
                      (match (resolve-type (Box.peek (TypedShape.signature shape)))
                        (Result.Success signature)
                          (Array.push-back! sources
                                            (CoreBuiltinSource.init reference
                                                                    (Box.init signature)
                                                                    @payload))
                        (Result.Error error) (set! result (Result.Error error)))
                    (Maybe.Nothing)
                      (set! result
                            (Result.Error
                              (ResolveError.init @"missing builtin source reference"
                                                 @(TypedShape.span shape)))))
                (Maybe.Nothing) ()))
          (Result.Error _) ()))
      result))

  (private resolve-signatures)
  (hidden resolve-signatures)
  (defn resolve-signatures [shapes globals]
    (let-do [result (the
               (Result (Array CoreSignature) ResolveError)
               (Result.Success []))
             n (Array.length shapes)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success signatures)
            (let [shape (Array.unsafe-nth shapes i)
                  name (TypedShape.name shape)
                  _ignored-stamp (set! *resolve-stamp* @(TypedShape.stamp shape))]
              (match (global-by-name globals name)
                (Maybe.Just reference)
                (match (resolve-type (Box.peek (TypedShape.signature shape)))
                  (Result.Success signature)
                    (Array.push-back! signatures
                                      (CoreSignature.init reference
                                                          (Box.init signature)))
                  (Result.Error error) (set! result (Result.Error error)))
                ;; a sig naming nothing is inert metadata in the reference
                ;; (the definition may have moved or never existed); skip it.
                (Maybe.Nothing)
                (when *resolve-observing*
                  (ignore (resolve-type (Box.peek (TypedShape.signature shape)))))))
          (Result.Error _) ()))
      result))

  (private register-type-members)
  (hidden register-type-members)
  ;; best-effort: malformed member arrays yield no members here; the accessor
  ;; registration path reports proper errors for them.
  (defn register-type-members [fields]
    (let-do [members (the (Array (Pair String CoreType)) [])]
      (match-ref fields
        (Maybe.Just boxed)
          (match-ref (SurfaceNode.form (Box.peek boxed))
            (SurfaceForm.Array field-nodes)
              (let-do [items (semantic-items field-nodes)
                       n (Array.length &items)]
                (for [i 0 n 2]
                  (when (Int.< (Int.inc i) n)
                    (let [name-node (Box.peek (Array.unsafe-nth &items i))
                          type-node (Box.peek (Array.unsafe-nth &items
                                                                (Int.inc i)))]
                      (match (symbol-name name-node)
                        (Maybe.Just field-name)
                          (match (resolve-type type-node)
                            (Result.Success field-type)
                              (Array.push-back! &members
                                                (Pair.init field-name field-type))
                            (Result.Error _) ())
                        (Maybe.Nothing) ())))))
            _ ())
        (Maybe.Nothing) ())
      members))

  (private resolve-type-declarations)
  (hidden resolve-type-declarations)
  (defn resolve-type-declarations [shapes]
    (let-do [result (the (Array CoreTypeDeclaration) [])
             n (Array.length shapes)]
      (for [i 0 n]
        (let-do [shape (Array.unsafe-nth shapes i)
                 _ignored-stamp (set! *resolve-stamp*
                                      @(TypeDeclarationShape.stamp shape))]
          (set! result
                (Array.push-back result
                                 (CoreTypeDeclaration.init
                                   (generation-type-name (TypeDeclarationShape.name shape)
                                                         *resolve-stamp*)
                                   @(TypeDeclarationShape.representation shape)
                                   (register-type-members (TypeDeclarationShape.fields shape)))))))
      result))

  (private type-head-arguments)
  (hidden type-head-arguments)
  (private constructor-base-name)
  (hidden constructor-base-name)
  (private constructor-arguments)
  (hidden constructor-arguments)
  (private derived-binding!)
  (hidden derived-binding!)
  (private derived-binding-unless-defined!)
  (hidden derived-binding-unless-defined!)
  (private add-constructor!)
  (hidden add-constructor!)
  (private field-types)
  (hidden field-types)
  (private add-record-constructor!)
  (hidden add-record-constructor!)
  (private add-accessor!)
  (hidden add-accessor!)
  (private setter-name)
  (hidden setter-name)
  (private add-setter!)
  (hidden add-setter!)
  (private updater-name)
  (hidden updater-name)
  (private add-updater!)
  (hidden add-updater!)
  (private add-field-helpers!)
  (hidden add-field-helpers!)
  (private add-record-str!)
  (hidden add-record-str!)
  (private add-record-copy!)
  (hidden add-record-copy!)
  (private add-accessors-from-fields!)
  (hidden add-accessors-from-fields!)
  (private add-accessors-from-deftype!)
  (hidden add-accessors-from-deftype!)
  (private add-accessors-from-register-type!)
  (hidden add-accessors-from-register-type!)
  (private collect-constructors-scoped)
  (hidden collect-constructors-scoped)
  (private collect-constructors)
  (hidden collect-constructors)
  (private collect-constructor-declarations-scoped)
  (hidden collect-constructor-declarations-scoped)
  (private collect-constructor-declarations)
  (hidden collect-constructor-declarations)
  (private constructor-binding)
  (hidden constructor-binding)
  (private constructor-declarations-from-deftype)
  (hidden constructor-declarations-from-deftype)

  (defn type-head-arguments [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)] (resolve-type-items &items 1))
      _ (Result.Success [])))

  (defn constructor-base-name [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.Symbol _) (symbol-key node)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (Int.> (Array.length &items) 0)
            (symbol-key (Box.peek (Array.unsafe-nth &items 0)))
            (Maybe.Nothing)))
      _ (Maybe.Nothing)))

  (defn constructor-arguments [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (Int.> (Array.length &items) 1)
            (let [fields (Box.peek (Array.unsafe-nth &items 1))]
              (match-ref (SurfaceNode.form fields)
                (SurfaceForm.Array field-nodes)
                  (resolve-type-arguments field-nodes)
                _ (Result.Success [])))
            (Result.Success [])))
      _ (Result.Success [])))

  ; the derived bindings are pushed onto one shared state
  (doc derived-binding! "adds a binding that a type declaration derives: a
constructor, accessor, setter, updater, `copy` or `str`. If the module defines
the name itself, the derived binding is still added but the name stays with the
definition. Arrays passed between index resets must extend the previous one.")
  (defn derived-binding! [state name signature]
    (let-do [shadowing (if (name-defined? &name)
               (global-by-name (Pair.a state) &name)
               (the (Maybe CoreRef) (Maybe.Nothing)))
             reference (CoreRef.init (next-global-id (Pair.a state)) name true)]
      (Array.push-back! (Pair.a state) (CoreRef.copy &reference))
      (match shadowing
        (Maybe.Just definition) (Array.push-back! (Pair.a state) definition)
        (Maybe.Nothing) ())
      (Array.push-back! (Pair.b state)
                        (CoreBuiltin.init reference (Box.init signature)))))

  (doc derived-binding-unless-defined! "adds a derived binding, unless the
module defines the name itself.")
  (defn derived-binding-unless-defined! [state name signature]
    (unless (name-defined? &name) (derived-binding! state name signature)))

  (defn add-constructor! [state type-name result-type node]
    (match (constructor-base-name node)
      (Maybe.Just base-name)
        (match (constructor-arguments node)
          (Result.Success arguments)
            (let [name (append-scope type-name &base-name)
                  signature (CoreType.Function arguments
                                               (Box.init (CoreType.copy result-type)))]
              (Result.Success (derived-binding! state name signature)))
          (Result.Error error) (Result.Error error))
      (Maybe.Nothing) (Result.Success ())))

  (defn field-types [fields]
    (let-do [result (the
               (Result (Array (Box CoreType)) ResolveError)
               (Result.Success []))
             field-items (semantic-items fields)
             n (Array.length &field-items)]
      (for [i 0 n 2]
        (match-ref &result
          (Result.Success types)
            (if (Int.< (Int.inc i) n)
              (let [type-node (Box.peek
                      (Array.unsafe-nth &field-items (Int.inc i)))]
                (match (resolve-type type-node)
                  (Result.Success field-type)
                    (Array.push-back! types (Box.init field-type))
                  (Result.Error error) (set! result (Result.Error error))))
              (set! result
                    (Result.Error
                      (ResolveError.init @"record fields must be name/type pairs"
                                         (SurfaceSpan.anywhere)))))
          (Result.Error _) ()))
      result))

  (defn add-record-constructor! [state type-name result-type fields]
    (match (field-types fields)
      (Result.Success arguments)
        (let [constructor-name (String.copy "init")
              name (append-scope type-name &constructor-name)
              signature (CoreType.Function arguments
                                           (Box.init (CoreType.copy result-type)))]
          (Result.Success (derived-binding! state name signature)))
      (Result.Error error) (Result.Error error)))

  (defn add-accessor! [state type-name record-type field-name field-type]
    (let [name (append-scope type-name field-name)
          signature (CoreType.Function
            [(Box.init
               (CoreType.Reference (Box.init (CoreType.copy record-type))
                                   (CoreLifetime.Inferred 0)))]
            (Box.init
              (CoreType.Reference (Box.init (CoreType.copy field-type))
                                  (CoreLifetime.Inferred 0))))]
      (derived-binding! state name signature)))

  (defn setter-name [field-name mutating?]
    (if mutating?
      (String.concat &[@"set-" (String.copy field-name) @"!"])
      (String.concat &[@"set-" (String.copy field-name)])))

  (defn add-setter! [state type-name record-type field-name field-type mutating?]
    (let [local-name (setter-name field-name mutating?)
          name (append-scope type-name &local-name)
          record-argument (if mutating?
            (CoreType.Reference (Box.init (CoreType.copy record-type))
                                (CoreLifetime.Inferred 0))
            (CoreType.copy record-type))
          result-type (if mutating? (CoreType.Unit) (CoreType.copy record-type))
          signature (CoreType.Function
            [(Box.init record-argument) (Box.init (CoreType.copy field-type))]
            (Box.init result-type))]
      (derived-binding! state name signature)))

  (defn updater-name [field-name]
    (String.concat &[@"update-" (String.copy field-name)]))

  (defn add-updater! [state type-name record-type field-name field-type]
    (let [local-name (updater-name field-name)
          name (append-scope type-name &local-name)
          updater (CoreType.Function [(Box.init (CoreType.copy field-type))]
                                     (Box.init (CoreType.copy field-type)))
          signature (CoreType.Function
            [(Box.init (CoreType.copy record-type))
             (Box.init
               (CoreType.Reference (Box.init updater) (CoreLifetime.Inferred 0)))]
            (Box.init (CoreType.copy record-type)))]
      (derived-binding! state name signature)))

  (defn add-field-helpers! [state type-name record-type field-name field-type]
    (do
      (add-accessor! state type-name record-type field-name field-type)
      (add-setter! state type-name record-type field-name field-type false)
      (add-setter! state type-name record-type field-name field-type true)
      (add-updater! state type-name record-type field-name field-type)))

  (defn add-record-copy! [state type-name record-type]
    (let [name (append-scope type-name "copy")
          signature (CoreType.Function
            [(Box.init
               (CoreType.Reference (Box.init (CoreType.copy record-type))
                                   (CoreLifetime.Inferred 0)))]
            (Box.init (CoreType.copy record-type)))]
      (derived-binding-unless-defined! state name signature)))

  (defn add-record-str! [state type-name record-type]
    (let [name (append-scope type-name "str")
          signature (CoreType.Function
            [(Box.init
               (CoreType.Reference (Box.init (CoreType.copy record-type))
                                   (CoreLifetime.Inferred 0)))]
            (Box.init (CoreType.String)))]
      (derived-binding-unless-defined! state name signature)))

  (defn add-accessors-from-fields! [state type-name record-type fields]
    (let-do [result (the (Result () ResolveError) (Result.Success ()))
             field-items (semantic-items fields)
             n (Array.length &field-items)]
      (for [i 0 n 2]
        (when (Result.success? &result)
          (if (Int.< (Int.inc i) n)
            (let [name-node (Box.peek (Array.unsafe-nth &field-items i))
                  type-node (Box.peek
                    (Array.unsafe-nth &field-items (Int.inc i)))]
              (match (symbol-name name-node)
                (Maybe.Just field-name)
                  (match (resolve-type type-node)
                    (Result.Success field-type)
                      (add-field-helpers! state
                                          type-name
                                          record-type
                                          &field-name
                                          &field-type)
                    (Result.Error error) (set! result (Result.Error error)))
                (Maybe.Nothing)
                  (set! result
                        (Result.Error
                          (error-at name-node
                                    @"record field name must be a symbol")))))
            (set! result
                  (Result.Error
                    (ResolveError.init @"record fields must be name/type pairs"
                                       (SurfaceSpan.anywhere)))))))
      (when-do (Result.success? &result)
        (add-record-str! state type-name record-type)
        (add-record-copy! state type-name record-type))
      result))

  (defn add-accessors-from-deftype! [state form type-name]
    (match-ref (SurfaceNode.form form)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (Int.>= (Array.length &items) 3)
            (let [type-head (Box.peek (Array.unsafe-nth &items 1))
                  fields-node (Box.peek (Array.unsafe-nth &items 2))]
              (match-ref (SurfaceNode.form fields-node)
                (SurfaceForm.Array fields)
                  (match (type-head-arguments type-head)
                    (Result.Success type-arguments)
                      (let [record-type (CoreType.Named (String.copy type-name)
                                                        type-arguments)]
                        (add-accessors-from-fields! state
                                                    type-name
                                                    &record-type
                                                    fields))
                    (Result.Error error) (Result.Error error))
                _ (Result.Success ())))
            (Result.Success ())))
      _ (Result.Success ())))

  (defn add-accessors-from-register-type! [state form type-name]
    (match-ref (SurfaceNode.form form)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (match (register-type-fields &items)
            (Maybe.Just boxed-fields)
              (let [fields-node (Box.peek &boxed-fields)]
                (match-ref (SurfaceNode.form fields-node)
                  (SurfaceForm.Array fields)
                    (let [record-type (CoreType.Named (String.copy type-name) [])]
                      (match (add-record-constructor! state
                                                      type-name
                                                      &record-type
                                                      fields)
                        (Result.Success _)
                          (add-accessors-from-fields! state
                                                      type-name
                                                      &record-type
                                                      fields)
                        (Result.Error error) (Result.Error error)))
                  _ (Result.Success ())))
            (Maybe.Nothing) (Result.Success ())))
      _ (Result.Success ())))

  (doc add-constructors-from-deftype! "adds the constructor and field bindings
that the `deftype` `form` of `type-name` derives to `state`.")
  (defn add-constructors-from-deftype! [state form type-name]
    (match-ref (SurfaceNode.form form)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (Int.>= (Array.length &items) 2)
            (let [type-head (Box.peek (Array.unsafe-nth &items 1))]
              (match (type-head-arguments type-head)
                (Result.Success type-arguments)
                  (let-do [result-type (CoreType.Named (String.copy type-name)
                                                       type-arguments)
                           result (the (Result () ResolveError)
                                       (Result.Success ()))
                           n (Array.length &items)
                           last-node (Box.peek (Array.unsafe-nth &items
                                                                 (Int.dec n)))
                           record? (and (Int.= n 3)
                                        (match-ref (SurfaceNode.form last-node)
                                          (SurfaceForm.Array _) true
                                          _ false))]
                    (add-record-copy! state type-name &result-type)
                    (if record?
                      (match-ref (SurfaceNode.form last-node)
                        (SurfaceForm.Array fields)
                          (set! result
                                (add-record-constructor! state
                                                         type-name
                                                         &result-type
                                                         fields))
                        _ ())
                      (for [i 2 n]
                        (when (Result.success? &result)
                          (set! result
                                (add-constructor! state
                                                  type-name
                                                  &result-type
                                                  (Box.peek (Array.unsafe-nth &items
                                                                              i)))))))
                    result)
                (Result.Error error) (Result.Error error)))
            (Result.Success ())))
      _ (Result.Success ())))

  (doc collect-constructors-scoped "adds the bindings that each recorded type
declaration derives, in source order, under its generation's type name.")
  (defn collect-constructors-scoped [initial]
    (let-do [state initial
             result (the (Result () ResolveError) (Result.Success ()))
             n (Array.length &*type-decl-events*)]
      (for [i 0 n]
        (when (Result.success? &result)
          (let [event (Array.unsafe-nth &*type-decl-events* i)
                form (Box.peek (TypeDeclEvent.form event))
                gen-name (event-generation-name i)
                _ignored-stamp (set! *resolve-stamp*
                                     @(TypeDeclEvent.stamp event))]
            (cond
              (declaration? form @"deftype")
                (match (add-constructors-from-deftype! &state form &gen-name)
                  (Result.Success _)
                    (set! result
                          (add-accessors-from-deftype! &state form &gen-name))
                  (Result.Error error) (set! result (Result.Error error)))
              (declaration? form @"register-type")
                (set! result
                      (add-accessors-from-register-type! &state form &gen-name))
              ()))))
      (match result
        (Result.Success _) (Result.Success state)
        (Result.Error error) (Result.Error error))))

  (defn collect-constructors [globals]
    (match (collect-constructors-scoped (Pair.init (Array.copy globals) []))
      (Result.Success state)
        (match (collect-constructor-declarations (Pair.a &state) (Pair.b &state))
          (Result.Success declarations)
            (Result.Success
              (ResolvedConstructors.init @(Pair.a &state)
                                         @(Pair.b &state)
                                         declarations))
          (Result.Error error) (Result.Error error))
      (Result.Error error) (Result.Error error)))

  (doc append-constructor-declarations "returns `left` followed by `right`.")
  (defn append-constructor-declarations [left right]
    (let-do [result (Array.copy left)
             n (Array.length right)]
      (for [i 0 n]
        (set! result (Array.push-back result @(Array.unsafe-nth right i))))
      result))

  (doc field-names-of "returns the field names of the field array `fields`, in
order.")
  (defn field-names-of [fields]
    (let-do [result (the (Array String) [])
             field-items (semantic-items fields)
             n (Array.length &field-items)]
      (for [i 0 n 2]
        (when (Int.< (Int.inc i) n)
          (match (symbol-name (Box.peek (Array.unsafe-nth &field-items i)))
            (Maybe.Just name) (Array.push-back! &result name)
            (Maybe.Nothing) ())))
      result))

  (doc constructor-binding "returns the constructor `name` among `builtins`, the
bindings the type declarations derived. A definition can take the name in the
global table, but a declaration must point at the constructor itself.")
  (defn constructor-binding [builtins name]
    ; a redefined type binds the constructor of its live generation
    (let-do [rewritten (generation-qualify name *resolve-stamp*)
             result (the (Maybe CoreRef) (Maybe.Nothing))
             n (Array.length builtins)]
      (for [i 0 n]
        (let [builtin (Array.unsafe-nth builtins i)]
          (when (String.=
              (CoreRef.name (CoreBuiltin.reference builtin))
              &rewritten)
            (set! result
                  (Maybe.Just (CoreRef.copy (CoreBuiltin.reference builtin)))))))
      result))

  (doc constructor-declaration "returns the declaration of constructor
`base-name` of `type-name`, with its tag, argument types and field names. A
missing constructor binding is an error at `node`.")
  (defn constructor-declaration [globals
                                 builtins
                                 type-name
                                 result-type
                                 base-name
                                 tag
                                 arguments
                                 field-names
                                 node]
    (let [name (append-scope type-name base-name)]
      (match (match (constructor-binding builtins &name)
          (Maybe.Just reference) (Maybe.Just reference)
          (Maybe.Nothing) (global-by-name globals &name))
        (Maybe.Just reference)
          (Result.Success
            (CoreConstructorDeclaration.init reference
                                             tag
                                             arguments
                                             field-names
                                             (Box.init (CoreType.copy result-type))))
        (Maybe.Nothing)
          (Result.Error (error-at node @"missing nominal constructor reference")))))

  (defn constructor-declarations-from-deftype [form type-name globals builtins]
    (match-ref (SurfaceNode.form form)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (Int.>= (Array.length &items) 3)
            (let [type-head (Box.peek (Array.unsafe-nth &items 1))]
              (match (type-head-arguments type-head)
                (Result.Success type-arguments)
                  (let-do [result (the
                             (Result (Array CoreConstructorDeclaration)
                                     ResolveError)
                             (Result.Success []))
                           result-type (CoreType.Named (String.copy type-name)
                                                       type-arguments)
                           n (Array.length &items)
                           third (Box.peek (Array.unsafe-nth &items 2))]
                    (if (and (Int.= n 3)
                             (match-ref (SurfaceNode.form third)
                               (SurfaceForm.Array _) true
                               _ false))
                      (match-ref (SurfaceNode.form third)
                        (SurfaceForm.Array fields)
                          (match (field-types fields)
                            (Result.Success arguments)
                              (match (constructor-declaration globals
                                                              builtins
                                                              type-name
                                                              &result-type
                                                              "init"
                                                              0
                                                              arguments
                                                              (field-names-of fields)
                                                              third)
                                (Result.Success declaration)
                                  (set! result (Result.Success [declaration]))
                                (Result.Error error)
                                  (set! result (Result.Error error)))
                            (Result.Error error)
                              (set! result (Result.Error error)))
                        _ ())
                      (for [i 2 n]
                        (match-ref &result
                          (Result.Success declarations)
                            (let [constructor (Box.peek (Array.unsafe-nth &items
                                                                          i))]
                              (match (constructor-base-name constructor)
                                (Maybe.Just base-name)
                                  (match (constructor-arguments constructor)
                                    (Result.Success arguments)
                                      (match (constructor-declaration globals
                                                                      builtins
                                                                      type-name
                                                                      &result-type
                                                                      &base-name
                                                                      (Int.- i 2)
                                                                      arguments
                                                                      (the (Array String)
                                                                           [])
                                                                      constructor)
                                        (Result.Success declaration)
                                          (Array.push-back! declarations
                                                            declaration)
                                        (Result.Error error)
                                          (set! result (Result.Error error)))
                                    (Result.Error error)
                                      (set! result (Result.Error error)))
                                (Maybe.Nothing)
                                  (set! result
                                        (Result.Error
                                          (error-at constructor
                                                    @"invalid nominal constructor")))))
                          (Result.Error _) ())))
                    result)
                (Result.Error error) (Result.Error error)))
            (Result.Success [])))
      _ (Result.Success [])))

  (defn collect-constructor-declarations [globals builtins]
    (let-do [result (the
               (Result (Array CoreConstructorDeclaration) ResolveError)
               (Result.Success []))
             n (Array.length &*type-decl-events*)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success declarations)
            (let [event (Array.unsafe-nth &*type-decl-events* i)
                  form (Box.peek (TypeDeclEvent.form event))
                  _ignored-stamp (set! *resolve-stamp*
                                       @(TypeDeclEvent.stamp event))]
              (when (declaration? form @"deftype")
                (let [gen-name (event-generation-name i)]
                  (match (constructor-declarations-from-deftype form
                                                                &gen-name
                                                                globals
                                                                builtins)
                    (Result.Success found)
                      (set! result
                            (Result.Success
                              (append-constructor-declarations declarations
                                                               &found)))
                    (Result.Error error) (set! result (Result.Error error))))))
          (Result.Error _) ()))
      result))

  (private resolve-interfaces)
  (hidden resolve-interfaces)
  (defn resolve-interfaces [shapes globals]
    (let-do [result (the
               (Result (Array CoreInterface) ResolveError)
               (Result.Success []))
             n (Array.length shapes)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success interfaces)
            (let [shape (Array.unsafe-nth shapes i)
                  name (TypedShape.name shape)
                  _ignored-stamp (set! *resolve-stamp* @(TypedShape.stamp shape))]
              (match (first-global-by-name globals name)
                (Maybe.Just reference)
                  (match (resolve-type (Box.peek (TypedShape.signature shape)))
                    (Result.Success signature)
                      (Array.push-back! interfaces
                                        (CoreInterface.init reference
                                                            (Box.init signature)))
                    (Result.Error error) (set! result (Result.Error error)))
                (Maybe.Nothing)
                  (set! result
                        (Result.Error
                          (ResolveError.init @"missing interface reference"
                                             @(TypedShape.span shape))))))
          (Result.Error _) ()))
      result))

  (private resolve-implementations)
  (hidden resolve-implementations)
  (private has-generated-implementation?)
  (hidden has-generated-implementation?)
  (private generated-copy-implementations)
  (hidden generated-copy-implementations)
  (defn resolve-implementations [shapes globals]
    (let-do [result (the
               (Result (Array CoreImplementation) ResolveError)
               (Result.Success []))
             n (Array.length shapes)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success implementations)
            (let [shape (Array.unsafe-nth shapes i)
                  interface-name (ImplementationShape.interface-name shape)
                  implementation-name (ImplementationShape.implementation-name shape)
                  _ignored-stamp (set! *resolve-stamp*
                                       @(ImplementationShape.stamp shape))]
              (match (first-global-by-name globals interface-name)
                (Maybe.Just interface)
                  (match (global-by-name globals implementation-name)
                    (Maybe.Just implementation)
                      (Array.push-back! implementations
                                        (CoreImplementation.init interface
                                                                 implementation))
                    (Maybe.Nothing)
                      (set! result
                            (Result.Error
                              (ResolveError.init
                                (let [suggestion (nearest-name implementation-name
                                                               globals
                                                               &(the (Array CoreRef)
                                                                     []))]
                                  (String.concat
                                    &[@"unknown implementation "
                                      (String.copy implementation-name)
                                      (if (String.empty? &suggestion)
                                        @""
                                        (String.concat &[@"; did you mean "
                                                         @&suggestion
                                                         @"?"]))]))
                                @(ImplementationShape.span shape)))))
                (Maybe.Nothing)
                  (set! result
                        (Result.Error
                          (ResolveError.init
                            (String.concat
                              &[@"unknown interface "
                                (String.copy interface-name)])
                            @(ImplementationShape.span shape))))))
          (Result.Error _) ()))
      result))

  (defn has-generated-implementation? [implementations reference]
    (let-do [found false
             n (Array.length implementations)]
      (for [i 0 n]
        (when (=
            (CoreRef.name
              (CoreImplementation.implementation (Array.unsafe-nth implementations
                                                                   i)))
            (CoreRef.name reference))
          (set! found true)))
      found))

  (private auto-interface-implementations)
  (hidden auto-interface-implementations)
  (doc auto-interface-implementations "returns an implementation for each module
function named like an interface, such as `Map.str`, as the reference does.
Functions outside modules are skipped, and so are functions that already
implement it.")
  (defn auto-interface-implementations [functions interfaces existing]
    (let-do [result (the (Array CoreImplementation) [])
             fn-count (Array.length functions)
             iface-count (Array.length interfaces)]
      (for [i 0 fn-count]
        (let-do [fref (CoreFunction.reference (Array.unsafe-nth functions i))
                 fname (CoreRef.name fref)
                 segments (String.split-by fname &[\.])
                 local (if (Int.> (Array.length &segments) 1)
                   @(Array.unsafe-nth &segments
                                      (Int.dec (Array.length &segments)))
                   (String.copy ""))]
          (unless (String.empty? &local)
            (for [j 0 iface-count]
              (let [iref (CoreInterface.reference (Array.unsafe-nth interfaces j))]
                (when (and (String.= &local (CoreRef.name iref))
                           (not (has-generated-implementation? existing fref)))
                  (Array.push-back! &result
                                    (CoreImplementation.init (CoreRef.copy iref)
                                                             (CoreRef.copy fref)))))))))
      result))

  (defn generated-copy-implementations [builtins]
    (let-do [result (the (Array CoreImplementation) [])
             copy-interface (CoreRef.init 0 (String.copy "copy") true)
             n (Array.length builtins)]
      (for [i 0 n]
        (let [builtin (Array.unsafe-nth builtins i)
              reference (CoreBuiltin.reference builtin)
              name (CoreRef.name reference)]
          (when (and (String.ends-with? name ".copy")
                     (not (has-generated-implementation? &result reference)))
            (Array.push-back! &result
                              (CoreImplementation.init (CoreRef.copy &copy-interface)
                                                       @(CoreBuiltin.reference builtin))))))
      result))

  (private resolve-top-level-expressions)
  (hidden resolve-top-level-expressions)
  (private resolve-scoped-expressions)
  (hidden resolve-scoped-expressions)
  (defn resolve-scoped-expressions [nodes locals globals imports]
    (let-do [expressions (the (Array (Box CoreExpr)) [])
             failure (the (Maybe ResolveError) (Maybe.Nothing))]
      (for [i 0 (Array.length nodes)]
        (when (or (Maybe.nothing? &failure)
                  (and *resolve-observing* (not (WorkBudget.stopped?))))
          (let [scoped (Array.unsafe-nth nodes i)
                _stamp (set! *resolve-stamp* @(ScopedExpression.stamp scoped))]
            (match (resolve-expression
                (Box.peek (ScopedExpression.node scoped))
                locals
                globals
                &(imports-with imports
                               (ScopedExpression.scope scoped)
                               (ScopedExpression.withs scoped))
                (ScopedExpression.scope scoped))
              (Result.Success expression)
                (Array.push-back! &expressions (Box.init expression))
              (Result.Error error)
                (when (Maybe.nothing? &failure)
                  (set! failure (Maybe.Just error)))))))
      (match failure
        (Maybe.Just error) (Result.Error error)
        (Maybe.Nothing) (Result.Success expressions))))

  (defn resolve-top-level-expressions [nodes globals imports]
    (let [locals (the (Array CoreRef) [])]
      (if (and *resolve-observing* (not (Array.empty? &*resolve-root-bindings*)))
        (let [anchor (SurfaceNode.generated (SurfaceSpan.anywhere)
                                            (SurfaceForm.List []))
              body (fn [visible]
                (do
                  (observe-root-scope! visible globals imports)
                  (match (resolve-scoped-expressions nodes
                                                     visible
                                                     globals
                                                     imports)
                    (Result.Error error) (Result.Error error)
                    (Result.Success expressions)
                      (Result.Success (CoreExpr.Do -1 expressions)))))]
          (match (resolve-bindings &anchor
                                   &*resolve-root-bindings*
                                   0
                                   &locals
                                   globals
                                   imports
                                   ""
                                   &*resolve-root-role*
                                   &body)
            (Result.Error error) (Result.Error error)
            (Result.Success expression)
              (Result.Success
                [(Box.init (identify-expression &anchor &expression))])))
        (resolve-scoped-expressions nodes &locals globals imports))))

  (private record-collected-definitions!)
  (hidden record-collected-definitions!)
  (defn record-collected-definitions! [collected globals]
    (do
      (observe-declarations! collected globals)
      (when-do *provenance-enabled*
        (let [functions (CollectedForms.functions collected)]
          (for [i 0 (Array.length functions)]
            (let [shape (Array.unsafe-nth functions i)
                  _ignored-stamp (set! *resolve-stamp*
                                       @(FunctionShape.stamp shape))]
              (match (global-by-name globals (FunctionShape.name shape))
                (Maybe.Just reference)
                  (record-binding! &reference (FunctionShape.span shape) true)
                (Maybe.Nothing) ()))))
        (let [values (CollectedForms.values collected)]
          (for [i 0 (Array.length values)]
            (let [shape (Array.unsafe-nth values i)
                  _ignored-stamp (set! *resolve-stamp* @(ValueShape.stamp shape))]
              (match (global-by-name globals (ValueShape.name shape))
                (Maybe.Just reference)
                  (record-binding! &reference (ValueShape.span shape) true)
                (Maybe.Nothing) ()))))
        (let [builtins (CollectedForms.builtins collected)]
          (for [i 0 (Array.length builtins)]
            (let [shape (Array.unsafe-nth builtins i)
                  _ignored-stamp (set! *resolve-stamp* @(TypedShape.stamp shape))]
              (match (global-by-name globals (TypedShape.name shape))
                (Maybe.Just reference)
                  (record-binding! &reference (TypedShape.span shape) true)
                (Maybe.Nothing) ()))))
        (let [interfaces (CollectedForms.interfaces collected)]
          (for [i 0 (Array.length interfaces)]
            (let [shape (Array.unsafe-nth interfaces i)
                  _ignored-stamp (set! *resolve-stamp* @(TypedShape.stamp shape))]
              (match (first-global-by-name globals (TypedShape.name shape))
                (Maybe.Just reference)
                  (record-binding! &reference (TypedShape.span shape) true)
                (Maybe.Nothing) ())))))))

  (private module-inner)
  (hidden module-inner)
  (private module-with-provenance-seeded)
  (hidden module-with-provenance-seeded)
  (sig module-inner (Fn [(Ref SurfaceModule)] (Result CoreModule ResolveError)))
  (sig module (Fn [(Ref SurfaceModule)] (Result CoreModule ResolveError)))
  (sig module-with-provenance
       (Fn
         [(Ref SourcedSurfaceModule) (Ref IdAllocator)]
         (Result ProvenancedCoreModule ResolveError)))

  (sig module-with-provenance-against
       (Fn
         [(Ref SourcedSurfaceModule) (Ref IdAllocator) (Ref ResolveSnapshot)]
         (Result ProvenancedCoreModule ResolveError)))
  (sig module-with-provenance-against-reusing
       (Fn
         [(Ref SourcedSurfaceModule)
          (Ref IdAllocator)
          (Ref ResolveSnapshot)
          (Ref (Array CoreRef))]
         (Result ProvenancedCoreModule ResolveError)))
  (sig module-with-provenance-seeded
       (Fn
         [(Ref SourcedSurfaceModule) (Ref IdAllocator)]
         (Result ProvenancedCoreModule ResolveError)))

  (doc module "resolves the expanded `surface` to core IR, with expression ids
numbered per owner.")
  (defn module [surface]
    (let-do [_ignored-provenance (set! *provenance-enabled* false)
             _ignored-globals (set! *resolve-seed-globals*
                                    (PrimitiveRegistry.globals))
             _ignored-imports (set! *resolve-seed-imports* [])
             _ignored-reuse (set! *resolve-reuse-globals* [])]
      (module-inner surface)))

  ; examples of what resolution makes of syntax

  (doc a-resolved-module "is an example: a module resolved to core IR, against
the primitives only.")
  (meta-set! a-resolved-module "example" true)
  (defn a-resolved-module []
    (Result.from-success
      (Resolve.module
        &(Result.from-success (Surface.parse "(defn identity [x] x)")
                              (SurfaceModule.init [])))
      (CoreIR.empty-module)))

  (doc a-resolved-definition-count "is an example: the number of definitions of
`a-resolved-module`.")
  (meta-set! a-resolved-definition-count "example" true)
  (defn a-resolved-definition-count []
    (Array.length (CoreModule.functions &(a-resolved-module))))

  (doc module-with-provenance "resolves `sourced` with node ids from
`allocator`, and returns the core IR with its source map.")
  (defn module-with-provenance [sourced allocator]
    (let-do [_ignored-globals (set! *resolve-seed-globals*
                                    (PrimitiveRegistry.globals))
             _ignored-imports (set! *resolve-seed-imports* [])
             _ignored-reuse (set! *resolve-reuse-globals* [])]
      (module-with-provenance-seeded sourced allocator)))

  (doc module-with-provenance-against "resolves `sourced` against the base
`snapshot`, without resolving the base again.")
  (defn module-with-provenance-against [sourced allocator snapshot]
    (let-do [_ignored-globals (set! *resolve-seed-globals*
                                    (Array.copy (ResolveSnapshot.globals snapshot)))
             _ignored-imports (set! *resolve-seed-imports*
                                    (Array.copy (ResolveSnapshot.imports snapshot)))
             _ignored-reuse (set! *resolve-reuse-globals* [])]
      (module-with-provenance-seeded sourced allocator)))

  (doc module-with-provenance-against-reusing "resolves `sourced` against
`snapshot`, and keeps the references in `reuse` for definitions with the same
names. Each must be of the same kind as the definition it is kept for.")
  (defn module-with-provenance-against-reusing [sourced allocator snapshot reuse]
    (let-do [_ignored-globals (set! *resolve-seed-globals*
                                    (Array.copy (ResolveSnapshot.globals snapshot)))
             _ignored-imports (set! *resolve-seed-imports*
                                    (Array.copy (ResolveSnapshot.imports snapshot)))
             _ignored-reuse (set! *resolve-reuse-globals* (Array.copy reuse))
             result (module-with-provenance-seeded sourced allocator)
             _ignored-clear (set! *resolve-reuse-globals* [])]
      result))

  (defn module-with-provenance-seeded [sourced allocator]
    (let-do [start (IdAllocator.next-up! allocator)
             _ignored-enabled (set! *provenance-enabled* true)
             _ignored-source (set! *provenance-source-id*
                                   (String.copy
                                     (SourceInput.id (SourcedSurfaceModule.input sourced))))
             _ignored-next (set! *provenance-next-node-id* start)
             _ignored-nodes (set! *provenance-nodes* [])
             _ignored-bindings (set! *provenance-bindings* [])
             _ignored-definitions (set! *provenance-definitions* [])
             result (module-inner (SourcedSurfaceModule.module sourced))
             provenance (CoreProvenance.init (Array.copy &*provenance-nodes*)
                                             (Array.copy &*provenance-bindings*)
                                             (Array.copy &*provenance-definitions*))
             _ignored-allocator (Array.aset! (IdAllocator.cell allocator)
                                             0
                                             *provenance-next-node-id*)
             _ignored-disabled (set! *provenance-enabled* false)]
      (match result
        (Result.Success core)
          (Result.Success (ProvenancedCoreModule.init core provenance))
        (Result.Error error) (Result.Error error))))

  (doc last-snapshot "returns the resolution environment of the last resolution
that collected its constructors, failed ones and observations included.")
  (defn last-snapshot [] (ResolveSnapshot.copy &*last-resolve-snapshot*))

  (private snapshot-has-global?)
  (hidden snapshot-has-global?)
  (defn snapshot-has-global? [globals reference]
    (let-do [found false]
      (for [i 0 (Array.length globals)]
        (when (CoreIR.same-ref? (Array.unsafe-nth globals i) reference)
          (set! found true)))
      found))

  (private snapshot-add-global!)
  (hidden snapshot-add-global!)
  (defn snapshot-add-global! [globals reference]
    (unless (snapshot-has-global? globals reference)
      (Array.push-back! globals (CoreRef.copy reference))))

  (doc snapshot-with-module "adds the declarations of `core`, made after
resolution, to `snapshot`.")
  (defn snapshot-with-module [snapshot core]
    (let-do [globals (Array.copy (ResolveSnapshot.globals snapshot))]
      (for [i 0 (Array.length (CoreModule.functions core))]
        (snapshot-add-global! &globals
                              (CoreFunction.reference
                                (Array.unsafe-nth (CoreModule.functions core) i))))
      (for [i 0 (Array.length (CoreModule.values core))]
        (snapshot-add-global! &globals
                              (CoreValue.reference
                                (Array.unsafe-nth (CoreModule.values core) i))))
      (for [i 0 (Array.length (CoreModule.builtins core))]
        (snapshot-add-global! &globals
                              (CoreBuiltin.reference
                                (Array.unsafe-nth (CoreModule.builtins core) i))))
      (for [i 0 (Array.length (CoreModule.interfaces core))]
        (snapshot-add-global! &globals
                              (CoreInterface.reference
                                (Array.unsafe-nth (CoreModule.interfaces core) i))))
      (for [i 0 (Array.length (CoreModule.constructors core))]
        (snapshot-add-global! &globals
                              (CoreConstructorDeclaration.reference
                                (Array.unsafe-nth (CoreModule.constructors core)
                                                  i))))
      (let-do [recursive-types (Array.copy
                 (ResolveSnapshot.recursive-types snapshot))]
        (for [i 0 (Array.length (CoreModule.recursive-types core))]
          (let [name (Array.unsafe-nth (CoreModule.recursive-types core) i)]
            (unless (Array.contains? &recursive-types name)
              (Array.push-back! &recursive-types @name))))
        (ResolveSnapshot.init globals
                              (Array.copy (ResolveSnapshot.imports snapshot))
                              recursive-types))))

  (doc module-inner "resolves the expanded `surface` to core IR. Forms that are
not definitions are kept as top-level expressions.")
  (defn module-inner [surface]
    ; reset the tables collection fills. the overloads are reset later, in
    ; populate-arities!.
    (let-do [_ignored-private (set! *private-names* (Set.create))
             _ignored-definitions (set! *definition-names*
                                        (the (Map String Int) (Map.create)))
             _ignored-stamp (set! *type-decl-stamp* 0)
             _ignored-events (set! *type-decl-events* [])
             ; the first collection pass already names types by generation,
             ; so the table it reads must be this module's, not the last
             ; module's.
             _ignored-redefinitions (set! *type-redefinitions* [])
             _ignored-site-stamp (set! *resolve-stamp* 0)
             ; local ids reach C symbol names, so they must depend only on
             ; the module. they need only be unique within one resolution.
             _ignored-serial (set! *local-binder-serial* 0)
             ; every entry point goes through `module-inner`, so the index of
             ; the last resolution is dropped here
             _ignored-index (reset-global-index!)]
      (match (collect-with-generations (SurfaceModule.forms surface))
        (Result.Success collected)
        ;; the constructor passes resolve plain (= last-generation) names, so
        ;; they run at the maximum stamp; body passes re-set it per shape.
        (let-do [_ignored-max-stamp (set! *resolve-stamp* *type-decl-stamp*)]
          (match (collect-constructors (CollectedForms.globals &collected))
            (Result.Success constructor-state)
              (let-do [all-globals (Array.copy
                         (ResolvedConstructors.globals &constructor-state))
                       constructor-builtins (Array.copy
                         (ResolvedConstructors.builtins &constructor-state))
                       _ignored-arities (populate-arities! &collected
                                                           &constructor-builtins)
                       _ignored-provenance (record-collected-definitions! &collected
                                                                          &all-globals)
                       _ignored-snapshot (set! *last-resolve-snapshot*
                                               (ResolveSnapshot.init (Array.copy &all-globals)
                                                                     (Array.copy (CollectedForms.imports &collected))
                                                                     (Array.copy
                                                                       (CollectedForms.recursive-types &collected))))
                       type-declarations (resolve-type-declarations
                         (CollectedForms.type-declarations &collected))
                       constructor-declarations (Array.copy
                         (ResolvedConstructors.declarations &constructor-state))
                       _observed-types (observe-type-heads! &collected
                                                            &constructor-declarations)]
                (match (resolve-functions (CollectedForms.functions &collected)
                                          &all-globals
                                          (CollectedForms.imports &collected)
                                          (CollectedForms.interfaces &collected))
                  (Result.Success functions)
                    (match (resolve-values (CollectedForms.values &collected)
                                           &all-globals
                                           (CollectedForms.imports &collected)
                                           (CollectedForms.interfaces &collected))
                      (Result.Success values)
                        (match (resolve-builtins (CollectedForms.builtins &collected)
                                                 &all-globals)
                          (Result.Success builtins)
                            (match (resolve-builtin-sources (CollectedForms.builtins &collected)
                                                            &all-globals)
                              (Result.Success builtin-sources)
                                (let [base-builtins (PrimitiveRegistry.builtins)
                                      intrinsic-and-constructors (append-core-builtins &base-builtins
                                                                                       &constructor-builtins)
                                      ;; a `register`ed name that the same program
                                      ;; also DEFINES is not a builtin: the
                                      ;; definition supplies the body. Leaving the
                                      ;; declaration in place makes inference treat
                                      ;; the name as a builtin and never visit the
                                      ;; body, so every call inside it stays
                                      ;; untyped. The declared type is kept as a
                                      ;; signature, which is what `register` before
                                      ;; a definition means in the reference (its examples/mutual_recursion).
                                      defined-builtins (defined-builtin-names &builtins
                                                                              (CollectedForms.functions &collected))
                                      all-builtins (append-core-builtins &intrinsic-and-constructors
                                                                         &(builtins-without &builtins
                                                                                            &defined-builtins))
                                      all-builtin-sources (let-do [srcs (PrimitiveRegistry.template-sources)]
                                        (for [si
                                              0
                                              (Array.length &builtin-sources)]
                                          (let [source (Array.unsafe-nth &builtin-sources
                                                                         si)]
                                            ; A native definition replaces the foreign payload
                                            ; as well as the builtin declaration. Its signature
                                            ; remains in builtin-signatures below.
                                            (unless (name-in? &defined-builtins
                                                              (CoreRef.name (CoreBuiltinSource.reference source)))
                                              (Array.push-back! &srcs @source))))
                                        srcs)]
                                  (match (resolve-signatures (CollectedForms.signatures &collected)
                                                             &all-globals)
                                    (Result.Success raw-signatures)
                                      (let [signatures (let-do [merged (Array.copy &raw-signatures)
                                                                converted (builtin-signatures &builtins
                                                                                              &defined-builtins)]
                                              (for [si
                                                    0
                                                    (Array.length &converted)]
                                                (Array.push-back! &merged
                                                                  @(Array.unsafe-nth &converted
                                                                                     si)))
                                              merged)]
                                        (match (resolve-interfaces (CollectedForms.interfaces &collected)
                                                                   &all-globals)
                                          (Result.Success interfaces)
                                            (let [base-interfaces (PrimitiveRegistry.interfaces)
                                                  all-interfaces (append-core-interfaces &base-interfaces
                                                                                         &interfaces)]
                                              (match (resolve-implementations
                                                  (CollectedForms.implementations &collected)
                                                  &all-globals)
                                                (Result.Success implementations)
                                                  (let [base-implementations (PrimitiveRegistry.implementations)
                                                        generated-implementations (generated-copy-implementations &constructor-builtins)
                                                        base-and-generated (append-core-implementations &base-implementations
                                                                                                        &generated-implementations)
                                                        explicit-implementations (append-core-implementations &base-and-generated
                                                                                                              &implementations)
                                                        auto-implementations (auto-interface-implementations &functions
                                                                                                             &all-interfaces
                                                                                                             &explicit-implementations)
                                                        all-implementations (append-core-implementations &explicit-implementations
                                                                                                         &auto-implementations)]
                                                    (match (resolve-top-level-expressions (CollectedForms.expressions &collected)
                                                                                          &all-globals
                                                                                          (CollectedForms.imports &collected))
                                                      (Result.Success expressions)
                                                        (let [final-overloads @&*overloads*
                                                              module (CoreModule.init functions
                                                                                      values
                                                                                      all-builtins
                                                                                      all-builtin-sources
                                                                                      signatures
                                                                                      type-declarations
                                                                                      constructor-declarations
                                                                                      @(CollectedForms.recursive-types &collected)
                                                                                      all-interfaces
                                                                                      all-implementations
                                                                                      final-overloads
                                                                                      @(CollectedForms.system-includes &collected)
                                                                                      expressions)]
                                                          (if *provenance-enabled*
                                                            (Result.Success module)
                                                            (Result.Success (CoreIR.index-call-sites module))))
                                                      (Result.Error error)
                                                        (Result.Error error)))
                                                (Result.Error error)
                                                  (Result.Error error)))
                                          (Result.Error error)
                                            (Result.Error error)))
                                    (Result.Error error) (Result.Error error)))
                              (Result.Error error) (Result.Error error))
                          (Result.Error error) (Result.Error error))
                      (Result.Error error) (Result.Error error))
                  (Result.Error error) (Result.Error error)))
            (Result.Error error) (Result.Error error)))
        (Result.Error error)
        (Result.Error error)))))
