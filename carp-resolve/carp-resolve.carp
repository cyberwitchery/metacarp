        (Box.init
          (CoreType.Function
            [(Box.init (CoreType.copy &a)) (Box.init (CoreType.copy &b))]
            (Box.init
              (CoreType.Named (String.copy "Pair") [(Box.init a) (Box.init b)])))))))

  (defn intrinsic-unary-polymorphic [id name]
    (let [input (CoreType.Variable (String.copy "input"))
          output (CoreType.Variable (String.copy "output"))]
      (CoreBuiltin.init
        (CoreRef.init id (String.copy name) true)
        (Box.init (CoreType.Function [(Box.init input)] (Box.init output))))))

  (defn intrinsic-pair-set-b []
    (let [pair (CoreType.Variable (String.copy "pair"))
          b (CoreType.Variable (String.copy "b"))]
      (CoreBuiltin.init
        (CoreRef.init 34 (String.copy "Pair.set-b") true)
        (Box.init
          (CoreType.Function
            [(Box.init (CoreType.copy &pair)) (Box.init b)]
            (Box.init pair))))))

  (defn intrinsic-array-transform [id name]
    (let [function (CoreType.Variable (String.copy "function"))
          collection (CoreType.Variable (String.copy "collection"))]
      (CoreBuiltin.init
        (CoreRef.init id (String.copy name) true)
        (Box.init
          (CoreType.Function
            [(Box.init function) (Box.init (CoreType.copy &collection))]
            (Box.init collection))))))

  (defn intrinsic-string-builtin [id name]
    (let [input (CoreType.Variable (String.copy "input"))]
      (CoreBuiltin.init
        (CoreRef.init id (String.copy name) true)
        (Box.init
          (CoreType.Function [(Box.init input)] (Box.init (CoreType.String)))))))

  (defn intrinsic-ignore []
    (let [input (CoreType.Variable (String.copy "input"))]
      (CoreBuiltin.init
        (CoreRef.init 42 (String.copy "ignore") true)
        (Box.init
          (CoreType.Function [(Box.init input)] (Box.init (CoreType.Unit)))))))

  (defn intrinsic-int-comparison [id name]
    (CoreBuiltin.init
      (CoreRef.init id (String.copy name) true)
      (Box.init
        (CoreType.Function
          [(Box.init (CoreType.Integer)) (Box.init (CoreType.Integer))]
          (Box.init (CoreType.Boolean))))))

  (defn append-core-interfaces [left right]
    (let-do [result (Array.copy left)
             n (Array.length right)]
      (for [i 0 n]
        (set! result (Array.push-back result @(Array.unsafe-nth right i))))
      result))

  (doc defined-builtin-names "the names among `builtins` that `functions` also
defines. Such a `register` is a forward declaration, not an external binding.")
  (private defined-builtin-names)
  (hidden defined-builtin-names)
  (defn defined-builtin-names [builtins functions]
    (let-do [names (the (Array String) [])]
      (for [i 0 (Array.length builtins)]
        (let [name (CoreRef.name
                (CoreBuiltin.reference (Array.unsafe-nth builtins i)))]
          (for [f 0 (Array.length functions)]
            (when (String.=
                (FunctionShape.name (Array.unsafe-nth functions f))
                name)
              (Array.push-back! &names (String.copy name))))))
      names))

  (private name-in?)
  (hidden name-in?)
  (defn name-in? [names target]
    (let-do [found false]
      (for [i 0 (Array.length names)]
        (when (String.= (Array.unsafe-nth names i) target) (set! found true)))
      found))

  (doc builtins-without "the builtins whose names are not in `names`.")
  (private builtins-without)
  (hidden builtins-without)
  (defn builtins-without [builtins names]
    (let-do [kept (the (Array CoreBuiltin) [])]
      (for [i 0 (Array.length builtins)]
        (let [builtin (Array.unsafe-nth builtins i)]
          (unless (name-in? names (CoreRef.name (CoreBuiltin.reference builtin)))
            (Array.push-back! &kept @builtin))))
      kept))

  (doc builtin-signatures "the dropped declarations, as signatures: a
`register`ed type still constrains the definition that supersedes it.")
  (private builtin-signatures)
  (hidden builtin-signatures)
  (defn builtin-signatures [builtins names]
    (let-do [result (the (Array CoreSignature) [])]
      (for [i 0 (Array.length builtins)]
        (let [builtin (Array.unsafe-nth builtins i)]
          (when (name-in? names (CoreRef.name (CoreBuiltin.reference builtin)))
            (Array.push-back! &result
                              (CoreSignature.init
                                (CoreRef.copy (CoreBuiltin.reference builtin))
                                (Box.init
                                  (CoreType.copy
                                    (Box.peek (CoreBuiltin.signature builtin)))))))))
      result))

  (defn append-core-builtins [left right]
    (let-do [result (Array.copy left)
             n (Array.length right)]
      (for [i 0 n]
        (set! result (Array.push-back result @(Array.unsafe-nth right i))))
      result))

  (defn append-core-implementations [left right]
    (let-do [result (Array.copy left)
             n (Array.length right)]
      (for [i 0 n]
        (set! result (Array.push-back result @(Array.unsafe-nth right i))))
      result))

  (private comment?)
  (hidden comment?)
  (private ignored-declaration?)
  (hidden ignored-declaration?)
  (private top-level-do-body)
  (hidden top-level-do-body)
  (defn comment? [form]
    (match-ref (SurfaceNode.form form) (SurfaceForm.Comment _) true _ false))

  (doc record-private! "records the qualified name a `(private X)` declaration
marks, so references from outside the defining module can be rejected.")
  (private record-private!)
  (hidden record-private!)
  (defn record-private! [form scope]
    (match-ref (SurfaceNode.form form)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (when (Int.= (Array.length &items) 2)
            ;; `symbol-key`, not `symbol-name`: the target may be qualified,
            ;; as in a top-level `(private Foo.bar)` naming a record accessor.
            (match (symbol-key (Box.peek (Array.unsafe-nth &items 1)))
              (Maybe.Just name)
                (Array.push-back! &*private-names* (qualify-name scope &name))
              (Maybe.Nothing) ())))
      _ ()))

  (doc private-metadata? "whether a form is `(meta-set! X \"private\" ...)`.
Core's `private` macro expands to exactly this inside macro output — e.g. the
`defn-`/`def-` sugar expands to a `do` holding it — so it must be recorded
like a direct `(private X)` declaration.")
  (private private-metadata?)
  (hidden private-metadata?)
  (defn private-metadata? [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (and (Int.= (Array.length &items) 4)
               (and
                 (named? (Box.peek (Array.unsafe-nth &items 0)) @"meta-set!")
                 (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth &items
                                                                          2)))
                   (SurfaceForm.StringLit key) (String.= key "private")
                   _ false))))
      _ false))

  (private record-private-metadata!)
  (hidden record-private-metadata!)
  (defn record-private-metadata! [form scope]
    (match-ref (SurfaceNode.form form)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (when (Int.= (Array.length &items) 4)
            (match (symbol-key (Box.peek (Array.unsafe-nth &items 1)))
              (Maybe.Just name)
                (Array.push-back! &*private-names* (qualify-name scope &name))
              (Maybe.Nothing) ())))
      _ ()))

  (doc private-access-error? "whether `name` is private and `scope` sits
outside the module that defines it. A module's own code — and the code of its
submodules — may use its private bindings; everyone else may not.")
  (private private-access-error?)
  (hidden private-access-error?)
  (defn private-access-error? [name scope]
    (let-do [private false]
      (for [i 0 (Array.length &*private-names*)]
        (when (String.= (Array.unsafe-nth &*private-names* i) name)
          (set! private true)))
      (if private
        (let [owner (parent-scope name)]
          (not
            (or (String.= &owner scope)
                (or (String.empty? &owner)
                    (String.starts-with? scope &(String.append &owner "."))))))
        false)))

  (defn ignored-declaration? [form]
    (cond
      (comment? form) true
      (declaration? form @"doc") true
      (declaration? form @"meta-set!") true
      (declaration? form @"hidden") true
      (declaration? form @"private") true
      (declaration? form @"c-name") true
      (declaration? form @"deprecated") true
      (declaration? form @"todo") true
      (declaration? form @"annotate") true
      (declaration? form @"defmacro") true
      (declaration? form @"defndynamic") true
      (declaration? form @"defdynamic") true
      (declaration? form @"include") true
      (declaration? form @"system-include") true
      false))

  (defn top-level-do-body [form]
    (match-ref (SurfaceNode.form form)
      (SurfaceForm.List raw-items)
        (let-do [items (semantic-items raw-items)
                 result (the (Array (Box SurfaceNode)) [])
                 n (Array.length &items)]
          (if (and (Int.> n 0)
                   (named? (Box.peek (Array.unsafe-nth &items 0)) @"do"))
            (do
              (for [i 1 n]
                (set! result
                      (Array.push-back result
                                       (Box.init
                                         (SurfaceNode.copy (Box.peek (Array.unsafe-nth &items
                                                                                       i)))))))
              (Maybe.Just result))
            (Maybe.Nothing)))
      _ (Maybe.Nothing)))

  (private collect)
  (hidden collect)
  (private collect-scoped!)
  (hidden collect-scoped!)
  (private add-function!)
  (hidden add-function!)
  (private add-value!)
  (hidden add-value!)
  (private add-typed!)
  (hidden add-typed!)
  (private add-interface!)
  (hidden add-interface!)
  (private add-import!)
  (hidden add-import!)
  (private system-include-shape)
  (hidden system-include-shape)
  (private preproc-text)
  (hidden preproc-text)
  (private qualified-head?)
  (hidden qualified-head?)

  (private next-global-id)
  (hidden next-global-id)
  (doc next-global-id
    "next free global reference id: one past the largest existing id. Using the
count (Array.length) is wrong once the seed has gaps (e.g. builtins whose ids are
reserved by the intrinsic table but not registered), because a new global would
then reuse a reserved id.")
  ;; synthetic overload interfaces live in their own table but share the
  ;; global id space: the watermark covers both, so neither allocation path
  ;; can reuse the other's ids.
  (defn next-global-id [globals]
    (let-do [m -1
             n (Array.length globals)]
      (for [i 0 n]
        (let [gid @(CoreRef.id (Array.unsafe-nth globals i))]
          (when (Int.> gid m) (set! m gid))))
      (for [i 0 (Array.length &*overload-interfaces*)]
        (let [oid @(CoreRef.id
                (CoreInterface.reference
                  (Array.unsafe-nth &*overload-interfaces* i)))]
          (when (Int.> oid m) (set! m oid))))
      (Int.inc m)))

  (defn add-global! [collected name]
    (let [globals (CollectedForms.globals collected)]
      (match (global-by-name &*resolve-reuse-globals* name)
        (Maybe.Just reusable)
          (do (Array.push-back! globals (CoreRef.copy &reusable)) reusable)
        (Maybe.Nothing)
          (let-do [reference (CoreRef.init (next-global-id globals)
                                           (String.copy name)
                                           true)]
            (Array.push-back! globals (CoreRef.copy &reference))
            reference))))

  (defn add-function! [collected shape]
    (let [name (FunctionShape.name shape)]
      (match (global-by-name (CollectedForms.globals collected) name)
        (Maybe.Just _)
          (let-do [functions (CollectedForms.functions collected)
                   replaced false
                   n (Array.length functions)]
            (for [i 0 n]
              (when-do (=
                  (FunctionShape.name (Array.unsafe-nth functions i))
                  name)
                (Array.aset! functions i (FunctionShape.copy shape))
                (set! replaced true)))
            (unless-do replaced
              (ignore (add-global! collected name))
              (Array.push-back! functions (FunctionShape.copy shape))))
        (Maybe.Nothing)
          (do
            (ignore (add-global! collected name))
            (Array.push-back! (CollectedForms.functions collected)
                              (FunctionShape.copy shape))))))

  (defn add-value! [collected shape]
    (let [name (ValueShape.name shape)]
      (match (global-by-name (CollectedForms.globals collected) name)
        (Maybe.Just _)
          (let-do [values (CollectedForms.values collected)
                   replaced false
                   n (Array.length values)]
            (for [i 0 n]
              (when-do (= (ValueShape.name (Array.unsafe-nth values i)) name)
                (Array.aset! values i (ValueShape.copy shape))
                (set! replaced true)))
            (unless-do replaced
              (ignore (add-global! collected name))
              (Array.push-back! values (ValueShape.copy shape))))
        (Maybe.Nothing)
          (do
            (ignore (add-global! collected name))
            (Array.push-back! (CollectedForms.values collected)
                              (ValueShape.copy shape))))))

  (defn add-typed! [collected shapes shape]
    (let [name (TypedShape.name shape)]
      (match (global-by-name (CollectedForms.globals collected) name)
        (Maybe.Just _)
          (let-do [replaced false
                   n (Array.length shapes)]
            (for [i 0 n]
              (when-do (= (TypedShape.name (Array.unsafe-nth shapes i)) name)
                (Array.aset! shapes i (TypedShape.copy shape))
                (set! replaced true)))
            (unless-do replaced
              (ignore (add-global! collected name))
              (Array.push-back! shapes (TypedShape.copy shape))))
        (Maybe.Nothing)
          (do
            (ignore (add-global! collected name))
            (Array.push-back! shapes (TypedShape.copy shape))))))

  (defn add-interface! [collected shape]
    (let [name (TypedShape.name shape)]
      (match (global-by-name (CollectedForms.globals collected) name)
        (Maybe.Just _)
          (let-do [interfaces (CollectedForms.interfaces collected)
                   replaced false
                   n (Array.length interfaces)]
            (for [i 0 n]
              (when-do (= (TypedShape.name (Array.unsafe-nth interfaces i)) name)
                (Array.aset! interfaces i (TypedShape.copy shape))
                (set! replaced true)))
            (unless-do replaced
              (ignore (add-global! collected name))
              (Array.push-back! interfaces (TypedShape.copy shape))))
        (Maybe.Nothing)
          (do
            (ignore (add-global! collected name))
            (Array.push-back! (CollectedForms.interfaces collected)
                              (TypedShape.copy shape))))))

  (defn add-import! [collected scope module-name]
    (Array.push-back! (CollectedForms.imports collected)
                      (ScopedImport.init (String.copy scope)
                                         (String.copy module-name))))

  (defn add-imports-from-form! [collected form scope]
    (match-ref (SurfaceNode.form form)
      (SurfaceForm.List raw-items)
        (let-do [items (semantic-items raw-items)
                 result (the (Result Unit ResolveError) (Result.Success ()))
                 n (Array.length &items)]
          (for [i 1 n]
            (match-ref &result
              (Result.Success _)
                (let [module-node (Box.peek (Array.unsafe-nth &items i))]
                  (match (symbol-key module-node)
                    (Maybe.Just module-name)
                      (add-import! collected scope &module-name)
                    (Maybe.Nothing)
                      (set! result
                            (Result.Error
                              (error-at module-node
                                        @"use expects module symbols")))))
              (Result.Error _) ()))
          result)
      _ (Result.Error (error-at form @"use must be a list"))))

  ;; head check for qualified symbols like `Unsafe.preproc` — `named?` only
  ;; matches single-segment symbols, so compare the joined key instead.
  (defn qualified-head? [node name]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List items)
        (and (Int.> (Array.length items) 0)
             (match (symbol-key (Box.peek (Array.unsafe-nth items 0)))
               (Maybe.Just key) (= &key name)
               (Maybe.Nothing) false))
      _ false))

  ;; `(Unsafe.preproc (Unsafe.emit-c "<directive>"))` carries a literal C
  ;; preamble line (e.g. a `#define` emitted by `Unsafe.C.asm`). The text rides
  ;; the system-include channel; the backend emits lines starting with `#`
  ;; verbatim instead of wrapping them in `#include <...>`.
  (defn preproc-text [form]
    (match-ref (SurfaceNode.form form)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (Int.= 2 (Array.length &items))
            (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth &items 1)))
              (SurfaceForm.List inner-raw)
                (let [inner (semantic-items inner-raw)]
                  (if (and (Int.= 2 (Array.length &inner))
                           (match (symbol-key (Box.peek (Array.unsafe-nth &inner
                                                                          0)))
                             (Maybe.Just key) (= &key "Unsafe.emit-c")
                             (Maybe.Nothing) false))
                    (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth &inner
                                                                             1)))
                      (SurfaceForm.StringLit text)
                        (Result.Success (String.copy text))
                      _
                        (Result.Error
                          (error-at form
                                    @"Unsafe.emit-c expects a string literal")))
                    (Result.Error
                      (error-at form
                                @"Unsafe.preproc expects an Unsafe.emit-c form"))))
              _
                (Result.Error
                  (error-at form @"Unsafe.preproc expects an Unsafe.emit-c form")))
            (Result.Error (error-at form @"Unsafe.preproc expects one argument"))))
      _ (Result.Error (error-at form @"Unsafe.preproc must be a list"))))

  (defn system-include-shape [form]
    (match-ref (SurfaceNode.form form)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (Int.= 2 (Array.length &items))
            (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth &items 1)))
              (SurfaceForm.StringLit path) (Result.Success (String.copy path))
              _
                (Result.Error
                  (error-at (Box.peek (Array.unsafe-nth &items 1))
                            @"system-include path must be a string")))
            (Result.Error
              (error-at form @"system-include expects one path string"))))
      _ (Result.Error (error-at form @"system-include must be a list"))))

  (defn collect-scoped! [forms scope collected]
    (let-do [result (the (Result Unit ResolveError) (Result.Success ()))
             n (Array.length forms)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success _)
            (let [form (Box.peek (Array.unsafe-nth forms i))]
              (cond
                (declaration? form @"defmodule")
                (match (module-shape form)
                  (Result.Success shape)
                    (let [nested-scope (append-scope scope
                                                     (ModuleShape.name &shape))]
                      (set! result
                            (collect-scoped! (ModuleShape.body &shape)
                                             &nested-scope
                                             collected)))
                  (Result.Error error) (set! result (Result.Error error)))

                (declaration? form @"with")
                (match (with-shape form)
                  (Result.Success shape)
                    (do
                      (add-import! collected scope (ModuleShape.name &shape))
                      (set! result
                            (collect-scoped! (ModuleShape.body &shape)
                                             scope
                                             collected)))
                  (Result.Error error) (set! result (Result.Error error)))

                (declaration? form @"do")
                (match (top-level-do-body form)
                  (Maybe.Just body)
                    (set! result (collect-scoped! &body scope collected))
                  (Maybe.Nothing) ())

                (declaration? form @"if")
                (match-ref (SurfaceNode.form form)
                  (SurfaceForm.List raw-items)
                    (let [items (semantic-items raw-items)]
                      (if (Int.= (Array.length &items) 4)
                        (for [branch-index 2 4]
                          (match-ref &result
                            (Result.Success _)
                              (let [branch (Box.peek (Array.unsafe-nth &items
                                                                       branch-index))]
                                (match (top-level-do-body branch)
                                  (Maybe.Just body)
                                    (set! result
                                          (collect-scoped! &body scope collected))
                                  (Maybe.Nothing)
                                    (Array.push-back! (CollectedForms.expressions collected)
                                                      (ScopedExpression.init (Box.init (SurfaceNode.copy branch))
                                                                             (String.copy scope)
                                                                             *type-decl-stamp*))))
                            (Result.Error _) ()))
                        (Array.push-back! (CollectedForms.expressions collected)
                                          (ScopedExpression.init (Box.init (SurfaceNode.copy form))
                                                                 (String.copy scope)
                                                                 *type-decl-stamp*))))
                  _
                    (Array.push-back! (CollectedForms.expressions collected)
                                      (ScopedExpression.init (Box.init (SurfaceNode.copy form))
                                                             (String.copy scope)
                                                             *type-decl-stamp*)))

                (signature-metadata? form)
                (match (signature-metadata-shape form scope)
                  (Result.Success shape)
                    (Array.push-back! (CollectedForms.signatures collected)
                                      shape)
                  (Result.Error error) (set! result (Result.Error error)))

                (declaration? form @"system-include")
                (match (system-include-shape form)
                  (Result.Success path)
                    (Array.push-back!
                      (CollectedForms.system-includes collected)
                      path)
                  (Result.Error error) (set! result (Result.Error error)))

                (qualified-head? form "Unsafe.preproc")
                (match (preproc-text form)
                  (Result.Success text)
                    (Array.push-back!
                      (CollectedForms.system-includes collected)
                      text)
                  (Result.Error error) (set! result (Result.Error error)))

                ;; `(private X)` marks X unusable from outside this module.
                ;; Recorded before `ignored-declaration?` swallows it.
                (declaration? form @"private")
                (record-private! form scope)

                ;; Core's `private` macro expands to this shape inside macro
                ;; output (`defn-`/`def-`); record before meta-set! is ignored.
                (private-metadata? form)
                (record-private-metadata! form scope)

                (ignored-declaration? form)
                ()
                (declaration? form @"deftype")
                (record-type-declaration! form scope)
                (or (declaration? form @"load")
                    (or (declaration? form @"load-once")
                        (declaration? form @"load-and-use")))
                ()

                (or (declaration? form @"use") (declaration? form @"use-all"))
                (set! result (add-imports-from-form! collected form scope))

                (defn? form)
                (match (function-shape form scope)
                  (Result.Success shape)
                    (do
                      ;; `defn-` is `private` + `hidden` + `defn`.
                      (when (declaration? form @"defn-")
                        (Array.push-back! &*private-names*
                                          @(FunctionShape.name &shape)))
                      (add-function! collected &shape))
                  (Result.Error error) (set! result (Result.Error error)))

                (or (declaration? form @"def") (declaration? form @"def-"))
                (match (value-shape form scope)
                  (Result.Success shape)
                    (do
                      (when (declaration? form @"def-")
                        (Array.push-back! &*private-names*
                                          @(ValueShape.name &shape)))
                      (add-value! collected &shape))
                  (Result.Error error) (set! result (Result.Error error)))

                (declaration? form @"register")
                (match (register-shape form scope)
                  (Result.Success shape)
                    (add-typed! collected
                                (CollectedForms.builtins collected)
                                &shape)
                  (Result.Error error) (set! result (Result.Error error)))

                (declaration? form @"deftemplate")
                (match (template-shape form scope)
                  (Result.Success shape)
                    (add-typed! collected
                                (CollectedForms.builtins collected)
                                &shape)
                  (Result.Error error) (set! result (Result.Error error)))

                (declaration? form @"sig")
                (match (typed-shape form @"sig" false scope)
                  (Result.Success shape)
                    (Array.push-back! (CollectedForms.signatures collected)
                                      shape)
                  (Result.Error error) (set! result (Result.Error error)))

                (declaration? form @"register-type")
                (do
                  (record-type-declaration! form scope)
                  (match (type-declaration-shape form scope)
                    (Result.Success shape)
                      (Array.push-back!
                        (CollectedForms.type-declarations collected)
                        shape)
                    (Result.Error error) (set! result (Result.Error error))))

                (declaration? form @"definterface")
                (match (typed-shape form @"definterface" false scope)
                  (Result.Success shape) (add-interface! collected &shape)
                  (Result.Error error) (set! result (Result.Error error)))

                (declaration? form @"implements")
                (match (implementation-shape form scope)
                  (Result.Success shape)
                    (Array.push-back!
                      (CollectedForms.implementations collected)
                      shape)
                  (Result.Error error) (set! result (Result.Error error)))

                ;; The reference stores this as metadata on a nominal type.
                ;; Our backend already treats `Ptr`/`Box` as the indirections
                ;; that break recursive layout walks, so there is no Core IR
                ;; payload to preserve. Keep this top-level-only: `recursive`
                ;; remains a valid ordinary function name in expressions.
                (declaration? form @"recursive")
                ()

                (Array.push-back! (CollectedForms.expressions collected)
                                  (ScopedExpression.init (Box.init (SurfaceNode.copy form))
                                                         (String.copy scope)
                                                         *type-decl-stamp*))))
          (Result.Error _) ()))
      result))

  (defn collect [forms]
    (let [collected (CollectedForms.init []
                                         []
                                         []
                                         []
                                         []
                                         []
                                         []
                                         (Array.copy &*resolve-seed-imports*)
                                         []
                                         []
                                         (Array.copy &*resolve-seed-globals*))]
      (match (collect-scoped! forms "" &collected)
        (Result.Success _) (Result.Success collected)
        (Result.Error error) (Result.Error error))))

  (private collect-with-generations)
  (hidden collect-with-generations)
  (doc collect-with-generations "collects, then derives the type-redefinition
table; when a type name IS redefined, collects a second time so every
qualified definition name is born under its generation (the table is empty
during the first pass, so first-pass names are plain). The common
no-redefinition case pays no second walk.")
  (defn collect-with-generations [forms]
    (match (collect forms)
      (Result.Success first-pass)
        (do
          (build-type-redefinitions!)
          (if (Int.= 0 (Array.length &*type-redefinitions*))
            (Result.Success first-pass)
            (do
              (set! *private-names* [])
              (set! *type-decl-stamp* 0)
              (set! *type-decl-events* [])
              (collect forms))))
      (Result.Error error) (Result.Error error)))

  (private local-by-name)
  (hidden local-by-name)
  (defn local-by-name [locals name]
    (let-do [result (the (Maybe CoreRef) (Maybe.Nothing))
             n (Array.length locals)]
      (for [i 0 n]
        (let [candidate (Array.unsafe-nth locals i)]
          (when (= (CoreRef.name candidate) name)
            (set! result (Maybe.Just @candidate)))))
      result))

  (private local-reference)
  (hidden local-reference)
  ;; every local binder gets a fresh id: position-derived ids collide when a
  ;; macro synthesizes several bindings that share one source span (e.g. the
  ;; repeated `_` bindings `ignore-do` expands to).
  (defn local-reference [node name]
    (let-do [position @(Info.pos (SurfaceSpan.start (SurfaceNode.span node)))
             serial (do
               (set! *local-binder-serial* (Int.inc *local-binder-serial*))
               *local-binder-serial*)
             reference (CoreRef.init
               (Int.- 0 (Int.+ (Int.* serial 1048576) (Int.inc position)))
               (String.copy name)
               false)]
      (record-binding! &reference (SurfaceNode.span node) false)
      reference))

  (private scoped-global-by-name)
  (hidden scoped-global-by-name)
  (private imported-global-by-name)
  (hidden imported-global-by-name)
  (private prefer-imported-over-root)
  (hidden prefer-imported-over-root)
  (private compatibility-global-by-name)
  (hidden compatibility-global-by-name)
  (private unique-member-global-by-name)
  (hidden unique-member-global-by-name)
  (defn compatibility-global-by-name [globals name]
    (cond
      (= name "Int.min") (global-by-name globals "min")
      (= name "Int.max") (global-by-name globals "max")
      (= name "StringCopy.append") (global-by-name globals "String.append")
      (the (Maybe CoreRef) (Maybe.Nothing))))

  (defn unique-member-global-by-name [globals name]
    (if (qualified-name? name)
      (the (Maybe CoreRef) (Maybe.Nothing))
      (let-do [result (the (Maybe CoreRef) (Maybe.Nothing))
               suffix (String.concat &[@"." (String.copy name)])
               matches 0
               n (Array.length globals)]
        (for [i 0 n]
          (let [candidate (Array.unsafe-nth globals i)]
            (when-do (String.ends-with? (CoreRef.name candidate) &suffix)
              (set! matches (Int.inc matches))
              (set! result (Maybe.Just (CoreRef.copy candidate))))))
        (if (Int.= matches 1) result (the (Maybe CoreRef) (Maybe.Nothing))))))

  (defn scoped-global-by-name [globals scope name]
    (cond
      (String.empty? scope) (global-by-name globals name)
      (qualified-name? name)
        (let [scoped (append-scope scope name)]
          (match (global-by-name globals &scoped)
            (Maybe.Just reference) (Maybe.Just reference)
            (Maybe.Nothing)
              (let [parent (parent-scope scope)]
                (if (String.empty? &parent)
                  (global-by-name globals name)
                  (let [parent-scoped (append-scope &parent name)]
                    (match (global-by-name globals &parent-scoped)
                      (Maybe.Just reference) (Maybe.Just reference)
                      (Maybe.Nothing) (global-by-name globals name)))))))
      (let [scoped (qualify-name scope name)]
        (match (global-by-name globals &scoped)
          (Maybe.Just reference) (Maybe.Just reference)
          (Maybe.Nothing) (global-by-name globals name)))))

  (defn imported-global-by-name [globals imports scope name]
    (let-do [result (the (Maybe CoreRef) (Maybe.Nothing))
             n (Array.length imports)]
      (for [i 0 n]
        (match-ref &result
          (Maybe.Just _) ()
          (Maybe.Nothing)
            (let [import (Array.unsafe-nth imports i)
                  import-scope (ScopedImport.scope import)]
              (when (or (= import-scope scope) (String.empty? import-scope))
                (let [module-name (ScopedImport.module-name import)
                      ;; `(use Id)` in module Color may name Color.Id (relative)
                      ;; or a top-level Id (absolute); try both qualifications.
                      absolute (append-scope module-name name)
                      relative (append-scope &(append-scope import-scope
                                                            module-name)
                                             name)]
                  (match (global-by-name globals &absolute)
                    (Maybe.Just reference) (set! result (Maybe.Just reference))
                    (Maybe.Nothing)
                      (match (global-by-name globals &relative)
                        (Maybe.Just reference)
                          (set! result (Maybe.Just reference))
                        (Maybe.Nothing) ())))))))
      result))

  (defn prefer-imported-over-root [globals imports scope symbol reference]
    (let-do [result (CoreRef.copy &reference)]
      (when (and
          (or (= symbol "unsafe-nth")
              (or (= symbol "unsafe-raw")
                  (and (= symbol "suffix") (String.empty? scope))))
          (and (not (qualified-name? symbol))
               (= (CoreRef.name &reference) symbol)))
        (match (imported-global-by-name globals imports scope symbol)
          (Maybe.Just imported) (set! result imported)
          (Maybe.Nothing) ()))
      result))

  ;; like imported-global-by-name, but resolves the implicit `.init` constructor
  ;; of an imported type: `(C)` under `(use Wrap2)` finds `Wrap2.C.init`. The bare
  ;; name is qualified through each import first, then `.init` is appended.
  (private imported-init-by-name)
  (hidden imported-init-by-name)
  (defn imported-init-by-name [globals imports scope name]
    (if (qualified-name? name)
      (Maybe.Nothing)
      (let-do [result (the (Maybe CoreRef) (Maybe.Nothing))
               n (Array.length imports)]
        (for [i 0 n]
          (match-ref &result
            (Maybe.Just _) ()
            (Maybe.Nothing)
              (let [import (Array.unsafe-nth imports i)
                    import-scope (ScopedImport.scope import)]
                (when (or (= import-scope scope) (String.empty? import-scope))
                  (let [module-name (ScopedImport.module-name import)
                        absolute (String.concat
                          &[(append-scope module-name name) @".init"])
                        relative (String.concat
                          &[(append-scope &(append-scope import-scope
                                                         module-name)
                                          name)
                            @".init"])]
                    (match (global-by-name globals &absolute)
                      (Maybe.Just reference)
                        (set! result (Maybe.Just reference))
                      (Maybe.Nothing)
                        (match (global-by-name globals &relative)
                          (Maybe.Just reference)
                            (set! result (Maybe.Just reference))
                          (Maybe.Nothing) ())))))))
        result)))

  (private resolve-arguments)
  (hidden resolve-arguments)
  (private resolve-expression)
  (hidden resolve-expression)
  (private resolve-expression-raw)
  (hidden resolve-expression-raw)
  (private identify-expression)
  (hidden identify-expression)
  (private resolve-parameters)
  (hidden resolve-parameters)
  (private resolve-type)
  (hidden resolve-type)
  (defn resolve-arguments [items start locals globals imports scope]
    (let-do [result (the
               (Result (Array (Box CoreExpr)) ResolveError)
               (Result.Success []))
             n (Array.length items)]
      (for [i start n]
        (match-ref &result
          (Result.Success arguments)
            (match (resolve-expression (Box.peek (Array.unsafe-nth items i))
                                       locals
                                       globals
                                       imports
                                       scope)
              (Result.Success expression)
                (set! result
                      (Result.Success
                        (Array.push-back @arguments (Box.init expression))))
              (Result.Error error) (set! result (Result.Error error)))
          (Result.Error _) ()))
      result))

  (private imported-globals-matching-where)
  (hidden imported-globals-matching-where)
  (doc imported-globals-matching-where "collects same-named candidates from
imports; `global-only` restricts to top-level (unscoped) `use`s, whose lone
candidate the reference picks outright, while module-scoped `use`s only join
the type-dispatched candidate set.")
  (defn imported-globals-matching-where [globals imports scope name global-only]
    (let-do [result (the (Array CoreRef) [])
             n (Array.length imports)]
      (for [i 0 n]
        (let [import (Array.unsafe-nth imports i)
              import-scope (ScopedImport.scope import)]
          (when (if global-only
              (String.empty? import-scope)
              (= import-scope scope))
            (let-do [module-name (ScopedImport.module-name import)
                     absolute (append-scope module-name name)
                     relative (append-scope &(append-scope import-scope
                                                           module-name)
                                            name)]
              (match (global-by-name globals &absolute)
                (Maybe.Just reference) (Array.push-back! &result reference)
                (Maybe.Nothing) ())
              (match (global-by-name globals &relative)
                (Maybe.Just reference) (Array.push-back! &result reference)
                (Maybe.Nothing) ())))))
      result))

  (private member-globals-matching)
  (hidden member-globals-matching)
  (defn member-globals-matching [globals name]
    (let-do [result (the (Array CoreRef) [])
             suffix (String.concat &[@"." (String.copy name)])
             n (Array.length globals)]
      (unless (qualified-name? name)
        (for [i 0 n]
          (let [candidate (Array.unsafe-nth globals i)]
            (when (String.ends-with? (CoreRef.name candidate) &suffix)
              (Array.push-back! &result @candidate)))))
      result))

  (private ref-id-in?)
  (hidden ref-id-in?)
  (defn ref-id-in? [ids target]
    (let-do [found false
             n (Array.length ids)]
      (for [i 0 n]
        (when (Int.= @(Array.unsafe-nth ids i) target) (set! found true)))
      found))

  (private distinct-refs)
  (hidden distinct-refs)
  (defn distinct-refs [candidates]
    (let-do [result (the (Array CoreRef) [])
             seen (the (Array Int) [])
             n (Array.length candidates)]
      (for [i 0 n]
        (let [candidate (Array.unsafe-nth candidates i)]
          (unless-do (ref-id-in? &seen @(CoreRef.id candidate))
            (Array.push-back! &seen @(CoreRef.id candidate))
            (Array.push-back! &result @candidate))))
      result))

  (private overload-implemented?)
  (hidden overload-implemented?)
  (defn overload-implemented? [interface implementation]
    (let-do [found false
             n (Array.length &*overload-implementations*)]
      (for [i 0 n]
        (let [entry (Array.unsafe-nth &*overload-implementations* i)]
          (when (and
              (CoreIR.same-ref? (CoreImplementation.interface entry) interface)
              (CoreIR.same-ref?
                (CoreImplementation.implementation entry)
                implementation))
            (set! found true))))
      found))

  (private synthesize-overload!)
  (hidden synthesize-overload!)
  (doc synthesize-overload! "registers (or reuses) a synthetic interface for an
ambiguous bare name — the reference's multisym resolution deferred to type
dispatch. Every candidate becomes an implementation; specialization later picks
the one whose inferred type unifies with the call site.")
  (defn synthesize-overload! [name candidates globals]
    (let-do [interface-ref (the (Maybe CoreRef) (Maybe.Nothing))
             interface-count (Array.length &*overload-interfaces*)]
      (for [i 0 interface-count]
        (let [entry (Array.unsafe-nth &*overload-interfaces* i)]
          (when (String.= (CoreRef.name (CoreInterface.reference entry)) name)
            (set! interface-ref (Maybe.Just @(CoreInterface.reference entry))))))
      (let-do [reference (match interface-ref
                 (Maybe.Just found)
                 found
                 (Maybe.Nothing)
                 ;; fresh interface ids come from the shared global watermark
                 ;; (next-global-id also scans the overload table).
                 (let-do [fresh (CoreRef.init (next-global-id globals)
                                              (String.copy name)
                                              true)]
                   (set! *overload-interfaces*
                         (Array.push-back @&*overload-interfaces*
                                          (CoreInterface.init (CoreRef.copy &fresh)
                                                              (Box.init (CoreType.Variable @"a")))))
                   fresh))]
        (for [i 0 (Array.length candidates)]
          (let [candidate (Array.unsafe-nth candidates i)]
            (unless (overload-implemented? &reference candidate)
              (set! *overload-implementations*
                    (Array.push-back @&*overload-implementations*
                                     (CoreImplementation.init (CoreRef.copy &reference)
                                                              @candidate))))))
        reference)))

  (private resolve-reference-name)
  (hidden resolve-reference-name)
  (private resolve-reference)
  (hidden resolve-reference)
  (private unknown-binding-error)
  (hidden unknown-binding-error)
  (private resolve-init-reference-name)
  (hidden resolve-init-reference-name)

  (private name-distance)
  (hidden name-distance)
  (doc name-distance "how far apart two names are, counted as the letters one
would have to change to reach the other. Names of very different lengths are
not near each other whatever they share, which is what the first test says.")
  (defn name-distance [left right]
    (let-do [shorter (Int.min (String.length left) (String.length right))
             longer (Int.max (String.length left) (String.length right))
             differences (Int.- longer shorter)]
      (if (Int.> differences 2)
        1000
        (do
          (for [i 0 shorter]
            (unless (Char.= (String.char-at left i) (String.char-at right i))
              (set! differences (Int.inc differences))))
          differences))))

  (private nearest-name)
  (hidden nearest-name)
  (doc nearest-name "the known name closest to the one that was not found,
when something is close enough to be worth suggesting. A typo is usually a
letter or two away; anything further apart is a different word and guessing
at it wastes the reader's time.")
  (defn nearest-name [symbol globals locals]
    (let-do [best @""
             best-distance 3
             n (Array.length globals)]
      (for [i 0 n]
        (let [candidate (CoreRef.name (Array.unsafe-nth globals i))
              distance (name-distance symbol candidate)]
          (when-do (Int.< distance best-distance)
            (set! best-distance distance)
            (set! best (String.copy candidate)))))
      (for [i 0 (Array.length locals)]
        (let [candidate (CoreRef.name (Array.unsafe-nth locals i))
              distance (name-distance symbol candidate)]
          (when-do (Int.< distance best-distance)
            (set! best-distance distance)
            (set! best (String.copy candidate)))))
      best))

  (defn unknown-binding-error [node symbol scope locals globals]
    (let [suggestion (nearest-name symbol globals locals)
          where (if (String.empty? scope)
            @""
            (String.concat &[@" in " (String.copy scope)]))
          hint (if (String.empty? &suggestion)
            @""
            (String.concat &[@"; did you mean " @&suggestion @"?"]))]
      (error-at node
                (String.concat
                  &[@"unknown binding " (String.copy symbol) where hint]))))

  ;; a qualified member the named module does not define falls back to the
  ;; bare top-level name: the reference resolves `(Char.>= a b)` to the global
  ;; generic `>=` (Generics.carp) when module Char has no `>=` of its own.
  (private unqualified-fallback-name)
  (hidden unqualified-fallback-name)
  (defn unqualified-fallback-name [globals symbol]
    (let [segments (String.split-by symbol &[\.])]
      (if (Int.> (Array.length &segments) 1)
        (global-by-name globals
                        (Array.unsafe-nth &segments
                                          (Int.dec (Array.length &segments))))
        (the (Maybe CoreRef) (Maybe.Nothing)))))

  (defn resolve-init-reference-name [node symbol locals globals imports scope]
    (let [init-name (String.concat &[(String.copy symbol) @".init"])]
      (match (scoped-global-by-name globals scope &init-name)
        (Maybe.Just reference) (Result.Success reference)
        (Maybe.Nothing)
          (match (imported-init-by-name globals imports scope symbol)
            (Maybe.Just reference) (Result.Success reference)
            (Maybe.Nothing)
              (match (unqualified-fallback-name globals symbol)
                (Maybe.Just reference) (Result.Success reference)
                (Maybe.Nothing)
                  (Result.Error
                    (unknown-binding-error node symbol scope locals globals)))))))

  (private resolve-reference-name-raw)
  (hidden resolve-reference-name-raw)
  (defn resolve-reference-name-raw [node name locals globals imports scope]
    (let [symbol (String.copy name)]
      (match (local-by-name locals &symbol)
        (Maybe.Just reference) (Result.Success reference)
        (Maybe.Nothing)
          (match (scoped-global-by-name globals scope &symbol)
            (Maybe.Just reference)
            (Result.Success
              (prefer-imported-over-root globals imports scope &symbol reference))
            (Maybe.Nothing)
            ;; several distinct top-level-`use` candidates for a bare name:
            ;; the reference keeps the multisym and lets types decide, so
            ;; the name becomes a synthetic overload interface.
            (let [matches (imported-globals-matching-where globals
                                                           imports
                                                           scope
                                                           &symbol
                                                           true)
                  ambiguous (distinct-refs &matches)]
              (if (Int.>= (Array.length &ambiguous) 2)
                (Result.Success
                  (synthesize-overload! &symbol &ambiguous globals))
                (match (imported-global-by-name globals imports scope &symbol)
                  (Maybe.Just reference) (Result.Success reference)
                  (Maybe.Nothing)
                    (match (compatibility-global-by-name globals &symbol)
                      (Maybe.Just reference) (Result.Success reference)
                      (Maybe.Nothing)
                        (match (unique-member-global-by-name globals &symbol)
                          (Maybe.Just reference)
                          (Result.Success reference)
                          (Maybe.Nothing)
                          ;; implicit `.init`: `(A)` on a type name `A` calls its
                          ;; zero-or-more-argument constructor `A.init`.
                          (resolve-init-reference-name node
                                                       &symbol
                                                       locals
                                                       globals
                                                       imports
                                                       scope))))))))))

  (doc resolve-reference-name "resolves a symbol to the binding it names, then
enforces visibility: a `private` binding may only be referenced from inside the
module that defines it. The check runs on the RESOLVED name, so it catches an
unqualified reference that reached a private binding through an import as well
as a written-out qualified one.")
  (defn resolve-reference-name [node name locals globals imports scope]
    (match (resolve-reference-name-raw node name locals globals imports scope)
      (Result.Success reference)
        (if (private-access-error? (CoreRef.name &reference) scope)
          (Result.Error
            (error-at node
                      (String.concat
                        &[@(CoreRef.name &reference)
                          @" is private; it may only be used inside the module that defines it"])))
          (Result.Success reference))
      (Result.Error error) (Result.Error error)))

  (defn resolve-reference [node locals globals imports scope]
    (match (symbol-key node)
      (Maybe.Just name)
        (resolve-reference-name node &name locals globals imports scope)
      (Maybe.Nothing) (Result.Error (error-at node @"empty symbol"))))

  (private resolve-type-arguments)
  (hidden resolve-type-arguments)
  (private resolve-type-items)
  (hidden resolve-type-items)
  (private resolve-type-name)
  (hidden resolve-type-name)
  (private inferred-lifetime)
  (hidden inferred-lifetime)
  (private resolve-lifetime)
  (hidden resolve-lifetime)
  (defn inferred-lifetime [node]
    (CoreLifetime.Inferred
      @(Info.pos (SurfaceSpan.start (SurfaceNode.span node)))))

  (defn resolve-lifetime [node]
    (match (symbol-key node)
      (Maybe.Just name)
        (if (= &name "static")
          (Result.Success (CoreLifetime.Static))
          (Result.Success (CoreLifetime.Named name)))
      (Maybe.Nothing)
        (Result.Error (error-at node @"lifetime must be a symbol"))))

  (defn resolve-type-arguments [nodes]
    (let-do [result (the
               (Result (Array (Box CoreType)) ResolveError)
               (Result.Success []))
             n (Array.length nodes)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success types)
            (match (resolve-type (Box.peek (Array.unsafe-nth nodes i)))
              (Result.Success type)
                (set! result
                      (Result.Success (Array.push-back @types (Box.init type))))
              (Result.Error error) (set! result (Result.Error error)))
          (Result.Error _) ()))
      result))

  (defn resolve-type-items [items start]
    (let-do [result (the
               (Result (Array (Box CoreType)) ResolveError)
               (Result.Success []))
             n (Array.length items)]
      (for [i start n]
        (match-ref &result
          (Result.Success types)
            (match (resolve-type (Box.peek (Array.unsafe-nth items i)))
              (Result.Success type)
                (set! result
                      (Result.Success (Array.push-back @types (Box.init type))))
              (Result.Error error) (set! result (Result.Error error)))
          (Result.Error _) ()))
      result))

  (defn resolve-type-name [node name]
    (cond
      (reference-shorthand? name)
        (let [inner-name (reference-shorthand-name name)]
          (match (resolve-type-name node &inner-name)
            (Result.Success inner)
              (Result.Success
                (CoreType.Reference (Box.init inner) (inferred-lifetime node)))
            (Result.Error error) (Result.Error error)))
      (String.= name "Int") (Result.Success (CoreType.Integer))
      (String.= name "String") (Result.Success (CoreType.String))
      (String.= name "Bool") (Result.Success (CoreType.Boolean))
      (String.= name "Unit") (Result.Success (CoreType.Unit))
      (lowercase-start? name)
        (Result.Success (CoreType.Variable (String.copy name)))
      (Result.Success
        (CoreType.Named (generation-type-name name *resolve-stamp*) []))))

  (defn resolve-type [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.Symbol _)
        (match (symbol-key node)
          (Maybe.Just name) (resolve-type-name node &name)
          (Maybe.Nothing)
            (Result.Error (error-at node @"unknown annotation type")))
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (cond
            (Int.= (Array.length &items) 0) (Result.Success (CoreType.Unit))

            (and (Int.>= (Array.length &items) 3)
                 (or
                   (named? (Box.peek (Array.unsafe-nth &items 0)) @"Fn")
                   (named? (Box.peek (Array.unsafe-nth &items 0)) @"λ")))
              (let [arguments (Box.peek (Array.unsafe-nth &items 1))
                    result (Box.peek (Array.unsafe-nth &items 2))]
                (match-ref (SurfaceNode.form arguments)
                  (SurfaceForm.Array argument-nodes)
                    (match (resolve-type-arguments argument-nodes)
                      (Result.Success argument-types)
                        (match (resolve-type result)
                          (Result.Success result-type)
                            (Result.Success
                              (CoreType.Function argument-types
                                                 (Box.init result-type)))
                          (Result.Error error) (Result.Error error))
                      (Result.Error error) (Result.Error error))
                  _
                    (Result.Error
                      (error-at arguments
                                @"Fn annotation arguments must be an array"))))

            (and (Int.>= (Array.length &items) 2)
                 (or
                   (named? (Box.peek (Array.unsafe-nth &items 0)) @"Ref")
                   (or
                     (named? (Box.peek (Array.unsafe-nth &items 0)) @"&")
                     (named? (Box.peek (Array.unsafe-nth &items 0)) @"ref"))))
              (if (Int.<= (Array.length &items) 3)
                (match (resolve-type (Box.peek (Array.unsafe-nth &items 1)))
                  (Result.Success inner)
                    (if (Int.= (Array.length &items) 3)
                      (match (resolve-lifetime (Box.peek (Array.unsafe-nth &items
                                                                           2)))
                        (Result.Success lifetime)
                          (Result.Success
                            (CoreType.Reference (Box.init inner) lifetime))
                        (Result.Error error) (Result.Error error))
                      (Result.Success
                        (CoreType.Reference (Box.init inner)
                                            (inferred-lifetime node))))
                  (Result.Error error) (Result.Error error))
                (Result.Error
                  (error-at node @"Ref type expects an inner type and lifetime")))

            (let [head (Box.peek (Array.unsafe-nth &items 0))]
              (match (symbol-key head)
                (Maybe.Just name)
                  (match (resolve-type-items &items 1)
                    (Result.Success arguments)
                      (Result.Success
                        (CoreType.Named
                          (generation-type-name &name *resolve-stamp*)
                          arguments))
                    (Result.Error error) (Result.Error error))
                (Maybe.Nothing)
                  (Result.Error
                    (error-at head @"type application head must be a symbol"))))))
      _
        (Result.Error
          (error-at node
                    (String.concat
                      &[@"unsupported annotation type: " (Surface.render node)])))))

  (private resolve-if)
  (hidden resolve-if)
  (private resolve-do)
  (hidden resolve-do)
  (private resolve-let)
  (hidden resolve-let)
  (private resolve-let-bindings)
  (hidden resolve-let-bindings)
  (private resolve-body)
  (hidden resolve-body)
  (private resolve-lambda-parameters)
  (hidden resolve-lambda-parameters)
  (private resolve-lambda)
  (hidden resolve-lambda)
  (private resolve-match)
  (hidden resolve-match)
  (private resolve-set)
  (hidden resolve-set)
  (private resolve-while)
  (hidden resolve-while)
  (private resolve-break)
  (hidden resolve-break)
  (private negative-int-node?)
  (hidden negative-int-node?)
  (private resolve-for-step)
  (hidden resolve-for-step)
  (private for-comparison-name)
  (hidden for-comparison-name)
  (private resolve-pattern)
  (hidden resolve-pattern)
  (private resolve-pattern-items)
  (hidden resolve-pattern-items)
  (private resolve-list-pattern)
  (hidden resolve-list-pattern)
  (private pattern-bindings)
  (hidden pattern-bindings)
  (private append-pattern-bindings)
  (hidden append-pattern-bindings)
  (sig resolve-pattern
       (Fn
         [(Ref SurfaceNode)
          (Ref (Array CoreRef))
          (Ref (Array ScopedImport))
          (Ref String)]
         (Result CorePattern ResolveError)))
  (private resolve-match-branches)
  (hidden resolve-match-branches)
  (private resolve-annotation)
  (hidden resolve-annotation)
  (private resolve-call)
  (hidden resolve-call)
  (private resolve-unquote-call)
  (hidden resolve-unquote-call)

  (defn resolve-lambda-parameters [nodes]
    (let-do [result (the (Result (Array CoreRef) ResolveError)
                         (Result.Success []))
             n (Array.length nodes)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success parameters)
            (let [node (Box.peek (Array.unsafe-nth nodes i))]
              (match (symbol-key node)
                (Maybe.Just name)
                  (let [current (Array.copy parameters)
                        parameter-name (String.copy &name)]
                    (match (local-by-name &current &parameter-name)
                      (Maybe.Just _)
                        (set! result
                              (Result.Error
                                (error-at node @"duplicate lambda parameter")))
                      (Maybe.Nothing)
                        (set! result
                              (Result.Success
                                (Array.push-back current
                                                 (local-reference node
                                                                  &parameter-name))))))
                (Maybe.Nothing)
                  (set! result
                        (Result.Error
                          (error-at node @"lambda parameters must be symbols")))))
          (Result.Error _) ()))
      result))

  (defn resolve-if [node items locals globals imports scope]
    (cond
      (Int.= (Array.length items) 3)
        (match (resolve-expression (Box.peek (Array.unsafe-nth items 1))
                                   locals
                                   globals
                                   imports
                                   scope)
          (Result.Success condition)
            (match (resolve-expression (Box.peek (Array.unsafe-nth items 2))
                                       locals
                                       globals
                                       imports
                                       scope)
              (Result.Success then-branch)
                (Result.Success
                  (CoreExpr.If -1
                               (Box.init condition)
                               (Box.init then-branch)
                               (Box.init (CoreExpr.UnitLit -1))))
              (Result.Error error) (Result.Error error))
          (Result.Error error) (Result.Error error))
      (Int.= (Array.length items) 4)
        (match (resolve-expression (Box.peek (Array.unsafe-nth items 1))
                                   locals
                                   globals
                                   imports
                                   scope)
          (Result.Success condition)
            (match (resolve-expression (Box.peek (Array.unsafe-nth items 2))
                                       locals
                                       globals
                                       imports
                                       scope)
              (Result.Success then-branch)
                (match (resolve-expression (Box.peek (Array.unsafe-nth items 3))
                                           locals
                                           globals
                                           imports
                                           scope)
                  (Result.Success else-branch)
                    (Result.Success
                      (CoreExpr.If -1
                                   (Box.init condition)
                                   (Box.init then-branch)
                                   (Box.init else-branch)))
                  (Result.Error error) (Result.Error error))
              (Result.Error error) (Result.Error error))
          (Result.Error error) (Result.Error error))
      (Result.Error
        (error-at node
                  (String.concat
                    &[@"if expects condition, then, and optional else expressions; got "
                      (Int.str (Array.length items))
                      @" items"])))))

  (defn resolve-do [node items locals globals imports scope]
    (match (resolve-arguments items 1 locals globals imports scope)
      (Result.Success expressions) (Result.Success (CoreExpr.Do -1 expressions))
      (Result.Error error) (Result.Error error)))

  (defn resolve-set [node items locals globals imports scope]
    (if (Int.= (Array.length items) 3)
      (let [target (Box.peek (Array.unsafe-nth items 1))
            value-node (Box.peek (Array.unsafe-nth items 2))]
        (match (resolve-reference target locals globals imports scope)
          (Result.Success reference)
            (match (resolve-expression value-node locals globals imports scope)
              (Result.Success value)
                (Result.Success (CoreExpr.Set -1 reference (Box.init value)))
              (Result.Error error) (Result.Error error))
          (Result.Error error) (Result.Error error)))
      (Result.Error (error-at node @"set! expects a target and value"))))

  (defn resolve-while [node items locals globals imports scope]
    (if (Int.= (Array.length items) 3)
      (match (resolve-expression (Box.peek (Array.unsafe-nth items 1))
                                 locals
                                 globals
                                 imports
                                 scope)
        (Result.Success condition)
          (match (resolve-expression (Box.peek (Array.unsafe-nth items 2))
                                     locals
                                     globals
                                     imports
                                     scope)
            (Result.Success body)
              (Result.Success
                (CoreExpr.While -1 (Box.init condition) (Box.init body)))
            (Result.Error error) (Result.Error error))
        (Result.Error error) (Result.Error error))
      (Result.Error (error-at node @"while expects a condition and body"))))

  (defn resolve-break [node items]
    (if (Int.= (Array.length items) 1)
      (Result.Success (CoreExpr.Break -1))
      (Result.Error (error-at node @"break expects no arguments"))))

  (defn negative-int-node? [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.IntLit value) (Int.< @value 0)
      _ false))

  (defn resolve-for-step [binding-items locals globals imports scope]
    (if (Int.= (Array.length binding-items) 4)
      (resolve-expression
        (Box.peek (Array.unsafe-nth binding-items 3))
        locals
        globals
        imports
        scope)
      (the (Result CoreExpr ResolveError)
           (Result.Success (CoreExpr.IntLit -1 1)))))

  (defn for-comparison-name [binding-items]
    (if (and (Int.= (Array.length binding-items) 4)
             (negative-int-node? (Box.peek (Array.unsafe-nth binding-items 3))))
      (String.copy ">")
      (String.copy "<")))

  ;; the name a `let` binding position binds, if it is a plain symbol.
  (private binding-name-at)
  (hidden binding-name-at)
  (defn binding-name-at [binding-items index]
    (if (Int.< index (Array.length binding-items))
      (symbol-key (Box.peek (Array.unsafe-nth binding-items index)))
      (Maybe.Nothing)))

  (doc duplicate-binding "the name bound twice in one `let`, if any. The
reference rejects this (InitialTypes.getDuplicate): a repeated name would make
the second binding silently shadow the first within a single scope.")
  (private duplicate-binding)
  (hidden duplicate-binding)
  (private name-seen?)
  (hidden name-seen?)
  (defn name-seen? [seen name]
    (let-do [found false]
      (for [i 0 (Array.length seen)]
        (when (String.= (Array.unsafe-nth seen i) name) (set! found true)))
      found))

  (defn duplicate-binding [binding-items]
    (let-do [seen (the (Array String) [])
             found (the (Maybe String) (Maybe.Nothing))
             n (Array.length binding-items)
             index 0]
      (while-do (Int.< (Int.inc index) n)
        (match (binding-name-at binding-items index)
          (Maybe.Just name)
            (do
              (when (and (name-seen? &seen &name)
                         (match-ref &found (Maybe.Nothing) true _ false))
                (set! found (Maybe.Just (String.copy &name))))
              (Array.push-back! &seen name))
          (Maybe.Nothing) ())
        (set! index (Int.+ index 2)))
      found))

  (defn resolve-let [node items locals globals imports scope]
    ;; extra body forms are an implicit do, matching the reference.
    (if (Int.>= (Array.length items) 3)
      (let [bindings (Box.peek (Array.unsafe-nth items 1))
            body-start 2]
        (match-ref (SurfaceNode.form bindings)
          (SurfaceForm.Array binding-items)
            (let [semantic-bindings (semantic-items binding-items)]
              (match (duplicate-binding &semantic-bindings)
                (Maybe.Just name)
                  (Result.Error
                    (error-at bindings
                              (String.concat
                                &[@"duplicate binding `" name @"` inside `let`"])))
                (Maybe.Nothing)
                  (resolve-let-bindings node
                                        &semantic-bindings
                                        0
                                        items
                                        body-start
                                        locals
                                        globals
                                        imports
                                        scope)))
          _ (Result.Error (error-at bindings @"let bindings must be an array"))))
      (Result.Error (error-at node @"let expects a binding array and body"))))

  (defn resolve-body [items start locals globals imports scope]
    (let [remaining (Int.- (Array.length items) start)]
      (cond
        (Int.= remaining 0) (Result.Success (CoreExpr.UnitLit -1))
        (Int.= remaining 1)
          (resolve-expression
            (Box.peek (Array.unsafe-nth items start))
            locals
            globals
            imports
            scope)
        (match (resolve-arguments items start locals globals imports scope)
          (Result.Success expressions)
            (Result.Success (CoreExpr.Do -1 expressions))
          (Result.Error error) (Result.Error error)))))

  (private fn-value?)
  (hidden fn-value?)
  (defn fn-value? [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List items)
        (and (Int.> (Array.length items) 0)
             (named? (Box.peek (Array.unsafe-nth items 0)) @"fn"))
      _ false))

  (defn resolve-let-bindings [node
                              binding-items
                              index
                              body-items
                              body-start
                              locals
                              globals
                              imports
                              scope]
    (cond
      (Int.= index (Array.length binding-items))
        (resolve-body body-items body-start locals globals imports scope)
      (Int.< (Int.inc index) (Array.length binding-items))
        (let [name-node (Box.peek (Array.unsafe-nth binding-items index))
              value-node (Box.peek
                (Array.unsafe-nth binding-items (Int.inc index)))]
          (match (symbol-key name-node)
            (Maybe.Just name)
              (let [binding-name (String.copy &name)
                    reference (local-reference name-node &binding-name)
                    ;; a `fn`-valued binding may reference itself (recursive let,
                    ;; issue #402); bring it into scope for its own value. Other
                    ;; values must not, so `(let [x (+ x 1)])` still sees the outer x.
                    value-locals (if (fn-value? value-node)
                      (Array.push-back (Array.copy locals)
                                       (CoreRef.copy &reference))
                      (Array.copy locals))]
                (match (resolve-expression value-node
                                           &value-locals
                                           globals
                                           imports
                                           scope)
                  (Result.Success value)
                    (let [extended (Array.push-back (Array.copy locals)
                                                    (CoreRef.copy &reference))]
                      (match (resolve-let-bindings node
                                                   binding-items
                                                   (Int.+ index 2)
                                                   body-items
                                                   body-start
                                                   &extended
                                                   globals
                                                   imports
                                                   scope)
                        (Result.Success body)
                          (Result.Success
                            (CoreExpr.Let -1
                                          reference
                                          (Box.init value)
                                          (Box.init body)))
                        (Result.Error error) (Result.Error error)))
                  (Result.Error error) (Result.Error error)))
            (Maybe.Nothing)
              (Result.Error
                (error-at name-node
                          (String.concat
                            &[@"let binding must be a symbol: " (str name-node)])))))
      (Result.Error (error-at node @"let bindings must be name/value pairs"))))

  (defn resolve-lambda [node items locals globals imports scope]
    (if (Int.= (Array.length items) 3)
      (let [parameters-node (Box.peek (Array.unsafe-nth items 1))
            body (Box.peek (Array.unsafe-nth items 2))]
        (match-ref (SurfaceNode.form parameters-node)
          (SurfaceForm.Array parameter-nodes)
            (match (resolve-lambda-parameters parameter-nodes)
              (Result.Success parameters)
                (let-do [extended (Array.copy locals)
                         n (Array.length &parameters)]
                  (for [i 0 n]
                    (set! extended
                          (Array.push-back extended
                                           @(Array.unsafe-nth &parameters i))))
                  (match (resolve-expression body
                                             &extended
                                             globals
                                             imports
                                             scope)
                    (Result.Success resolved-body)
                      (Result.Success
                        (CoreExpr.Lambda -1 parameters (Box.init resolved-body)))
                    (Result.Error error) (Result.Error error)))
              (Result.Error error) (Result.Error error))
          _
            (Result.Error
              (error-at parameters-node @"fn parameters must be an array"))))
      (Result.Error (error-at node @"fn expects a parameter array and body"))))

  (defn append-pattern-bindings [left right]
    (let-do [result (Array.copy left)
             n (Array.length right)]
      (for [i 0 n]
        (set! result (Array.push-back result @(Array.unsafe-nth right i))))
      result))

  (defn pattern-bindings [pattern]
    (match-ref pattern
      (CorePattern.Ignore) []
      (CorePattern.Bind reference) [(CoreRef.copy reference)]
      (CorePattern.Constructor _ children)
        (let-do [result (the (Array CoreRef) [])
                 n (Array.length children)]
          (for [i 0 n]
            (set! result
                  (append-pattern-bindings &result
                                           &(pattern-bindings (Box.peek (Array.unsafe-nth children
                                                                                          i))))))
          result)))

  (defn resolve-pattern-items [items start globals imports scope]
    (let-do [result (the
               (Result (Array (Box CorePattern)) ResolveError)
               (Result.Success []))
             n (Array.length items)]
      (for [i start n]
        (match-ref &result
          (Result.Success patterns)
            (match (resolve-pattern (Box.peek (Array.unsafe-nth items i))
                                    globals
                                    imports
                                    scope)
              (Result.Success pattern)
                (set! result
                      (Result.Success
                        (Array.push-back @patterns (Box.init pattern))))
              (Result.Error error) (set! result (Result.Error error)))
          (Result.Error _) ()))
      result))

  (defn resolve-list-pattern [node items globals imports scope]
    (if (Int.> (Array.length items) 0)
      (let [head (Box.peek (Array.unsafe-nth items 0))]
        (match (symbol-key head)
          (Maybe.Just name)
            (if (lowercase-start? &name)
              (Result.Error
                (error-at head @"pattern constructor must be global"))
              (match (resolve-reference-name head
                                             &name
                                             &[]
                                             globals
                                             imports
                                             scope)
                (Result.Success reference)
                  (match (resolve-pattern-items items 1 globals imports scope)
                    (Result.Success children)
                      (Result.Success
                        (CorePattern.Constructor reference children))
                    (Result.Error error) (Result.Error error))
                (Result.Error error) (Result.Error error)))
          (Maybe.Nothing)
            (Result.Error
              (error-at head @"pattern constructor must be a symbol"))))
      (Result.Error (error-at node @"empty list is not a pattern"))))

  (defn resolve-pattern [node globals imports scope]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.Symbol _)
        (match (symbol-key node)
          (Maybe.Just name)
            (cond
              (= &name "_") (Result.Success (CorePattern.Ignore))
              (lowercase-start? &name)
                (Result.Success (CorePattern.Bind (local-reference node &name)))
              (match (resolve-reference-name node
                                             &name
                                             &[]
                                             globals
                                             imports
                                             scope)
                (Result.Success reference)
                  (Result.Success (CorePattern.Constructor reference []))
                (Result.Error error) (Result.Error error)))
          (Maybe.Nothing)
            (Result.Error (error-at node @"invalid symbol pattern")))
      (SurfaceForm.List items)
        (resolve-list-pattern node items globals imports scope)
      _ (Result.Error (error-at node @"unsupported pattern form"))))

  (defn resolve-match-branches [items start locals globals imports scope]
    (let-do [result (the
               (Result (Array CoreMatchBranch) ResolveError)
               (Result.Success []))
             n (Array.length items)]
      (for [i start n 2]
        (match-ref &result
          (Result.Success branches)
            (let [pattern (Box.peek (Array.unsafe-nth items i))
                  body (Box.peek (Array.unsafe-nth items (Int.inc i)))]
              (match (resolve-pattern pattern globals imports scope)
                (Result.Success resolved-pattern)
                  (let [bindings (pattern-bindings &resolved-pattern)
                        extended (append-pattern-bindings locals &bindings)]
                    (match (resolve-expression body
                                               &extended
                                               globals
                                               imports
                                               scope)
                      (Result.Success resolved-body)
                        (set! result
                              (Result.Success
                                (Array.push-back @branches
                                                 (CoreMatchBranch.init resolved-pattern
                                                                       bindings
                                                                       (Box.init resolved-body)))))
                      (Result.Error error) (set! result (Result.Error error))))
                (Result.Error error) (set! result (Result.Error error))))
          (Result.Error _) ()))
      result))

  (defn resolve-match [node items locals globals imports scope]
    (if (and (Int.>= (Array.length items) 4)
             (Int.= 0 (Int.mod (Int.- (Array.length items) 2) 2)))
      (match (resolve-expression (Box.peek (Array.unsafe-nth items 1))
                                 locals
                                 globals
                                 imports
                                 scope)
        (Result.Success scrutinee)
          (match (resolve-match-branches items 2 locals globals imports scope)
            (Result.Success branches)
              (Result.Success
                (CoreExpr.Match -1
                                (named? (Box.peek (Array.unsafe-nth items 0))
                                        @"match-ref")
                                (Box.init scrutinee)
                                branches))
            (Result.Error error) (Result.Error error))
        (Result.Error error) (Result.Error error))
      (Result.Error
        (error-at node @"match expects a scrutinee and pattern/body pairs"))))

  (defn resolve-annotation [node items locals globals imports scope]
    (if (Int.= (Array.length items) 3)
      (match (resolve-type (Box.peek (Array.unsafe-nth items 1)))
        (Result.Success annotation)
          (match (resolve-expression (Box.peek (Array.unsafe-nth items 2))
                                     locals
                                     globals
                                     imports
                                     scope)
            (Result.Success expression)
              (Result.Success
                (CoreExpr.Annotation -1
                                     (Box.init expression)
                                     (Box.init annotation)))
            (Result.Error error) (Result.Error error))
        (Result.Error error) (Result.Error error))
      (Result.Error (error-at node @"the expects a type and expression"))))

  (private arity-of)
  (hidden arity-of)
  (defn arity-of [name]
    (let-do [result (the (Maybe Int) (Maybe.Nothing))
             n (Array.length &*resolve-arities*)]
      (for [i 0 n]
        (let [entry (Array.unsafe-nth &*resolve-arities* i)]
          (when (String.= (Pair.a entry) name)
            (set! result (Maybe.Just @(Pair.b entry))))))
      result))

  (private arity-compatible?)
  (hidden arity-compatible?)
  ;; an unknown arity matches conservatively, so untabulated candidates keep
  ;; the existing selection behavior.
  (defn arity-compatible? [reference arity]
    (match (arity-of (CoreRef.name reference))
      (Maybe.Just known) (Int.= known arity)
      (Maybe.Nothing) true))

  (private unique-arity-candidate)
  (hidden unique-arity-candidate)
  (defn unique-arity-candidate [candidates arity]
    (let-do [result (the (Maybe CoreRef) (Maybe.Nothing))
             matches 0
             seen (the (Array Int) [])
             n (Array.length candidates)]
      (for [i 0 n]
        (let [candidate (Array.unsafe-nth candidates i)]
          (unless-do (ref-id-in? &seen @(CoreRef.id candidate))
            (Array.push-back! &seen @(CoreRef.id candidate))
            (match (arity-of (CoreRef.name candidate))
              (Maybe.Just known)
                (when-do (Int.= known arity)
                  (set! matches (Int.inc matches))
                  (set! result (Maybe.Just @candidate)))
              (Maybe.Nothing) ()))))
      (if (Int.= matches 1) result (the (Maybe CoreRef) (Maybe.Nothing)))))

  (private surface-signature-arity)
  (hidden surface-signature-arity)
  (defn surface-signature-arity [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (and (Int.= 3 (Array.length &items))
                   (or
                     (named? (Box.peek (Array.unsafe-nth &items 0)) @"Fn")
                     (named? (Box.peek (Array.unsafe-nth &items 0)) @"λ")))
            (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth &items 1)))
              (SurfaceForm.Array parameter-nodes) (Array.length parameter-nodes)
              _ -1)
            -1))
      _ -1))

  (private populate-arities!)
  (hidden populate-arities!)
  (doc populate-arities!
    "fills the module-wide name → arity table consulted by
resolve-call-head, from function shapes, register/deftemplate signatures, and
the primitive registry.")
  (defn populate-arities! [collected constructor-builtins]
    (let-do [table (the (Array (Pair String Int)) [])
             ;; per-module reset of the overload-synthesis channel filled
             ;; during body resolution.
             _ignored-interfaces (set! *overload-interfaces* [])
             _ignored-implementations (set! *overload-implementations* [])]
      (let [functions (CollectedForms.functions collected)]
        (for [i 0 (Array.length functions)]
          (let [shape (Array.unsafe-nth functions i)]
            (Array.push-back! &table
                              (Pair.init @(FunctionShape.name shape)
                                         (Array.length (FunctionShape.parameters shape)))))))
      (let [builtins (CollectedForms.builtins collected)]
        (for [i 0 (Array.length builtins)]
          (let [shape (Array.unsafe-nth builtins i)]
            (let [arity (surface-signature-arity (Box.peek (TypedShape.signature shape)))]
              (when (Int.>= arity 0)
                (Array.push-back! &table
                                  (Pair.init @(TypedShape.name shape) arity)))))))
      (let [registry (PrimitiveRegistry.builtins)]
        (for [i 0 (Array.length &registry)]
          (let [builtin (Array.unsafe-nth &registry i)]
            (match-ref (Box.peek (CoreBuiltin.signature builtin))
              (CoreType.Function signature-arguments _)
                (Array.push-back! &table
                                  (Pair.init
                                    @(CoreRef.name (CoreBuiltin.reference builtin))
                                    (Array.length signature-arguments)))
              _ ()))))
      (for [i 0 (Array.length constructor-builtins)]
        (let [builtin (Array.unsafe-nth constructor-builtins i)]
          (match-ref (Box.peek (CoreBuiltin.signature builtin))
            (CoreType.Function signature-arguments _)
              (Array.push-back! &table
                                (Pair.init
                                  @(CoreRef.name (CoreBuiltin.reference builtin))
                                  (Array.length signature-arguments)))
            _ ())))
      (set! *resolve-arities* table)))

  (private arity-matching)
  (hidden arity-matching)
  (defn arity-matching [candidates arity]
    (let-do [distinct (distinct-refs candidates)
             result (the (Array CoreRef) [])]
      (for [i 0 (Array.length &distinct)]
        (let [candidate (Array.unsafe-nth &distinct i)]
          (match (arity-of (CoreRef.name candidate))
            (Maybe.Just known)
              (when (Int.= known arity) (Array.push-back! &result @candidate))
            (Maybe.Nothing) ())))
      result))

  (private resolve-call-head)
  (hidden resolve-call-head)
  (doc resolve-call-head "resolves a call's head symbol with the call's arity
in hand, mirroring the reference's multisym preference order: a `use`d module's
lone arity-matching candidate wins outright, several become a synthetic
overload interface dispatched by type, and only an import-less name falls back
to the module-member scan (same single/several policy). Everything else falls
back to plain reference resolution.")
  (defn resolve-call-head [head name arity locals globals imports scope]
    (if (match (local-by-name locals name)
        (Maybe.Just _) true
        (Maybe.Nothing) false)
      (resolve-reference-name head name locals globals imports scope)
      (let [positional (scoped-global-by-name globals scope name)
            positional-ok (match-ref &positional
              (Maybe.Just reference) (arity-compatible? reference arity)
              (Maybe.Nothing) false)]
        (if positional-ok
          (resolve-reference-name head name locals globals imports scope)
          ;; top-level `use`s pin types like the reference: a lone candidate is
          ;; picked outright, several dispatch by type. Module-scoped `use`s
          ;; and the member scan never pin — their candidates always join a
          ;; type-dispatched overload set.
          (let [hard (imported-globals-matching-where globals
                                                      imports
                                                      scope
                                                      name
                                                      true)
                hard-matching (arity-matching &hard arity)]
            (cond
              (Int.= 1 (Array.length &hard-matching))
                (Result.Success @(Array.unsafe-nth &hard-matching 0))
              (Int.>= (Array.length &hard-matching) 2)
                (Result.Success
                  (synthesize-overload! name &hard-matching globals))
              (let-do [soft (imported-globals-matching-where globals
                                                             imports
                                                             scope
                                                             name
                                                             false)
                       members (member-globals-matching globals name)]
                (for [i 0 (Array.length &members)]
                  (Array.push-back! &soft @(Array.unsafe-nth &members i)))
                (let [soft-matching (arity-matching &soft arity)]
                  (cond
                    (Int.= 1 (Array.length &soft-matching))
                      (Result.Success @(Array.unsafe-nth &soft-matching 0))
                    (Int.>= (Array.length &soft-matching) 2)
                      (Result.Success
                        (synthesize-overload! name &soft-matching globals))
                    (resolve-reference-name head
                                            name
                                            locals
                                            globals
                                            imports
                                            scope))))))))))

  (defn resolve-call [node items locals globals imports scope]
    (let [head (Box.peek (Array.unsafe-nth items 0))
          arity (Int.dec (Array.length items))]
      (match (match (symbol-key head)
          (Maybe.Just name)
            (match (resolve-call-head head
                                      &name
                                      arity
                                      locals
                                      globals
                                      imports
                                      scope)
              (Result.Success reference)
                (Result.Success
                  (identify-expression head &(CoreExpr.Reference -1 reference)))
              (Result.Error error) (Result.Error error))
          (Maybe.Nothing) (resolve-expression head locals globals imports scope))
        (Result.Success callee)
          (match (resolve-arguments items 1 locals globals imports scope)
            (Result.Success arguments)
              (Result.Success (CoreExpr.Call -1 (Box.init callee) arguments))
            (Result.Error error) (Result.Error error))
        (Result.Error error) (Result.Error error))))

  (defn resolve-unquote-call [node items locals globals imports scope]
    (if (Int.>= (Array.length items) 2)
      (match (resolve-expression (Box.peek (Array.unsafe-nth items 1))
                                 locals
                                 globals
                                 imports
                                 scope)
        (Result.Success callee)
          (match (resolve-arguments items 2 locals globals imports scope)
            (Result.Success arguments)
              (Result.Success (CoreExpr.Call -1 (Box.init callee) arguments))
            (Result.Error error) (Result.Error error))
        (Result.Error error) (Result.Error error))
      (Result.Error (error-at node @"unquote call expects a callee"))))

  (defn resolve-expression-raw [node locals globals imports scope]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.IntLit value)
      (Result.Success (CoreExpr.IntLit -1 @value))
      (SurfaceForm.ByteLit value)
      (Result.Success (CoreExpr.ByteLit -1 @value))
      (SurfaceForm.LongLit value)
      (Result.Success (CoreExpr.LongLit -1 @value))
      (SurfaceForm.FloatLit value)
      (Result.Success (CoreExpr.FloatLit -1 @value))
      (SurfaceForm.DoubleLit value)
      (Result.Success (CoreExpr.DoubleLit -1 @value))
      (SurfaceForm.CharLit value)
      (Result.Success (CoreExpr.CharLit -1 @value))
      (SurfaceForm.StringLit value)
      (Result.Success (CoreExpr.StringLit -1 (String.copy value)))
      (SurfaceForm.PatternLit value)
      (Result.Success (CoreExpr.PatternLit -1 (String.copy value)))
      (SurfaceForm.BoolLit value)
      (Result.Success (CoreExpr.BoolLit -1 @value))
      (SurfaceForm.Symbol _)
      (match (symbol-key node)
        (Maybe.Just name)
          (let [symbol (String.copy &name)]
            (cond
              (= &symbol "0b")
                (Result.Success (CoreExpr.ByteLit -1 (Byte.from-int 0)))
              (= &symbol "1b")
                (Result.Success (CoreExpr.ByteLit -1 (Byte.from-int 1)))
              (= &symbol "2b")
                (Result.Success (CoreExpr.ByteLit -1 (Byte.from-int 2)))
              (match (resolve-reference node locals globals imports scope)
                (Result.Success reference)
                  (Result.Success (CoreExpr.Reference -1 reference))
                (Result.Error error) (Result.Error error))))
        (Maybe.Nothing) (Result.Error (error-at node @"empty symbol")))
      (SurfaceForm.List raw-items)
      (let [items (semantic-items raw-items)]
        (if (Int.= (Array.length &items) 0)
          (Result.Success (CoreExpr.UnitLit -1))
          (let [head (Box.peek (Array.unsafe-nth &items 0))]
            (cond
              (ignored-declaration? node) (Result.Success (CoreExpr.UnitLit -1))
              (or (declaration? node @"register")
                  (match (symbol-key head)
                    (Maybe.Just key)
                      (or (= &key "Unsafe.preproc") (= &key "Unsafe.emit-c"))
                    (Maybe.Nothing) false))
                (Result.Success (CoreExpr.UnitLit -1))
              (named? head @"do")
                (resolve-do node &items locals globals imports scope)
              (named? head @"if")
                (resolve-if node &items locals globals imports scope)
              (named? head @"set!")
                (resolve-set node &items locals globals imports scope)
              (named? head @"while")
                (resolve-while node &items locals globals imports scope)
              (named? head @"break") (resolve-break node &items)
              (named? head @"let")
                (resolve-let node &items locals globals imports scope)
              (named? head @"fn")
                (resolve-lambda node &items locals globals imports scope)
              (or (named? head @"match") (named? head @"match-ref"))
                (resolve-match node &items locals globals imports scope)
              (named? head @"the")
                (resolve-annotation node &items locals globals imports scope)
              (named? head @"unquote")
                (resolve-unquote-call node &items locals globals imports scope)
              (resolve-call node &items locals globals imports scope)))))
      (SurfaceForm.Array items)
      (let [elements (semantic-items items)]
        (match (resolve-arguments &elements 0 locals globals imports scope)
          (Result.Success expressions)
            (Result.Success (CoreExpr.ArrayLit -1 expressions))
          (Result.Error error) (Result.Error error)))
      (SurfaceForm.StaticArray items)
      (let [elements (semantic-items items)]
        (match (resolve-arguments &elements 0 locals globals imports scope)
          (Result.Success expressions)
            (Result.Success (CoreExpr.StaticArrayLit -1 expressions))
          (Result.Error error) (Result.Error error)))
      ;; a `{k v ...}` literal desugars to `(Map.from-array [(Pair.init k v) ...])`,
      ;; matching the reference parser; the pairs resolve as ordinary calls.
      (SurfaceForm.Dictionary entries)
      (if (Int./= 0 (Int.mod (Array.length entries) 2))
        (Result.Error
          (error-at node @"dictionary literal needs an even number of forms"))
        (let-do [span @(SurfaceNode.span node)
                 pairs (the (Array (Box SurfaceNode)) [])]
          (for [i 0 (Int./ (Array.length entries) 2)]
            (let [k @(Array.unsafe-nth entries (Int.* i 2))
                  v @(Array.unsafe-nth entries (Int.+ (Int.* i 2) 1))
                  pair-sym (Box.init
                    (SurfaceNode.init @&span
                                      (SurfaceForm.Symbol [@"Pair" @"init"])))]
              (Array.push-back! &pairs
                                (Box.init
                                  (SurfaceNode.init @&span
                                                    (SurfaceForm.List [pair-sym
                                                                       k
                                                                       v]))))))
          (resolve-call node
                        &[(Box.init
                            (SurfaceNode.init @&span
                                              (SurfaceForm.Symbol [@"Map"
                                                                   @"from-array"])))
                          (Box.init
                            (SurfaceNode.init @&span (SurfaceForm.Array pairs)))]
                        locals
                        globals
                        imports
                        scope)))
      (SurfaceForm.Comment _)
      (Result.Success (CoreExpr.UnitLit -1))))

  (defn identify-expression [node expression]
    (if *provenance-enabled*
      (let-do [id *provenance-next-node-id*
               _ignored-next (set! *provenance-next-node-id* (Int.inc id))
               identified (CoreIR.with-expression-id expression id)
               origin (NodeProvenance.init id
                                           (source-span (SurfaceNode.span node)))]
        (Array.push-back! &*provenance-nodes* origin)
        identified)
      (CoreExpr.copy expression)))

  (defn resolve-expression [node locals globals imports scope]
    (match (resolve-expression-raw node locals globals imports scope)
      (Result.Success expression)
        (Result.Success (identify-expression node &expression))
      (Result.Error error) (Result.Error error)))

  (defn resolve-parameters [nodes start]
    (let-do [result (the (Result (Array CoreRef) ResolveError)
                         (Result.Success []))
             n (Array.length nodes)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success parameters)
            (let [node (Box.peek (Array.unsafe-nth nodes i))]
              (match (symbol-key node)
                (Maybe.Just name)
                  (let [current (Array.copy parameters)
                        parameter-name (String.copy &name)]
                    (match (local-by-name &current &parameter-name)
                      (Maybe.Just _)
                        (set! result
                              (Result.Error
                                (error-at node @"duplicate function parameter")))
                      (Maybe.Nothing)
                        (set! result
                              (Result.Success
                                (Array.push-back current
                                                 (local-reference node
                                                                  &parameter-name))))))
                (Maybe.Nothing)
                  (set! result
                        (Result.Error
                          (error-at node @"function parameters must be symbols")))))
          (Result.Error _) ()))
      result))

  (private resolve-functions)
  (hidden resolve-functions)
  (private parameter-start)
  (hidden parameter-start)
  (private interface-references)
  (hidden interface-references)
  (private append-core-refs)
  (hidden append-core-refs)
  (defn parameter-start [shapes global-count function-index]
    (let-do [result global-count]
      (for [i 0 function-index]
        (set! result
              (Int.+ result
                     (Array.length
                       (FunctionShape.parameters (Array.unsafe-nth shapes i))))))
      result))

  (defn interface-references [globals interface-shapes]
    (let-do [result (the (Array CoreRef) [])
             builtins (PrimitiveRegistry.interfaces)
             builtin-count (Array.length &builtins)
             interface-count (Array.length interface-shapes)]
      (for [i 0 builtin-count]
        (set! result
              (Array.push-back result
                               (CoreRef.copy
                                 (CoreInterface.reference (Array.unsafe-nth &builtins
                                                                            i))))))
      (for [i 0 interface-count]
        (let [shape (Array.unsafe-nth interface-shapes i)]
          (match (first-global-by-name globals (TypedShape.name shape))
            (Maybe.Just reference)
              (set! result (Array.push-back result reference))
            (Maybe.Nothing) ())))
      result))

  (defn append-core-refs [left right]
    (let-do [result (Array.copy left)
             n (Array.length right)]
      (for [i 0 n]
        (set! result
              (Array.push-back result (CoreRef.copy (Array.unsafe-nth right i)))))
      result))

  (defn resolve-functions [shapes globals imports interface-shapes]
    ;; Keep the error outside the accumulator. Wrapping `functions` in a new
    ;; Result after every append deep-copies every previously resolved body.
    (let-do [functions (the (Array CoreFunction) [])
             failure (the (Maybe ResolveError) (Maybe.Nothing))
             global-count (Array.length globals)
             next-local-id global-count
             interfaces (interface-references globals interface-shapes)
             n (Array.length shapes)]
      (for [i 0 n]
        (match-ref &failure
          (Maybe.Nothing)
            (let [shape (Array.unsafe-nth shapes i)
                  name (FunctionShape.name shape)
                  first-local-id next-local-id
                  _ignored-next (set! next-local-id
                                      (Int.+ next-local-id
                                             (Array.length (FunctionShape.parameters shape))))
                  _ignored-stamp (set! *resolve-stamp*
                                       @(FunctionShape.stamp shape))]
              (match (global-by-name globals name)
                (Maybe.Just reference)
                  (match (resolve-parameters (FunctionShape.parameters shape)
                                             first-local-id)
                    (Result.Success parameters)
                      (let [resolution-locals (append-core-refs &interfaces
                                                                &parameters)]
                        (match (resolve-expression (Box.peek (FunctionShape.body shape))
                                                   &resolution-locals
                                                   globals
                                                   imports
                                                   (FunctionShape.scope shape))
                          (Result.Success body)
                            (Array.push-back! &functions
                                              (CoreFunction.init reference
                                                                 parameters
                                                                 (Box.init body)))
                          (Result.Error error) (set! failure (Maybe.Just error))))
                    (Result.Error error) (set! failure (Maybe.Just error)))
                (Maybe.Nothing)
                  (set! failure
                        (Maybe.Just
                          (ResolveError.init @"missing function reference"
                                             @(FunctionShape.span shape))))))
          (Maybe.Just _) ()))
      (match failure
        (Maybe.Just error) (Result.Error error)
        (Maybe.Nothing) (Result.Success functions))))

  (private resolve-values)
  (hidden resolve-values)
  (defn resolve-values [shapes globals imports]
    (let-do [result (the (Result (Array CoreValue) ResolveError)
                         (Result.Success []))
             locals (the (Array CoreRef) [])
             n (Array.length shapes)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success values)
            (let [shape (Array.unsafe-nth shapes i)
                  name (ValueShape.name shape)
                  _ignored-stamp (set! *resolve-stamp* @(ValueShape.stamp shape))]
              (match (global-by-name globals name)
                (Maybe.Just reference)
                  (match (resolve-expression (Box.peek (ValueShape.body shape))
                                             &locals
                                             globals
                                             imports
                                             (ValueShape.scope shape))
                    (Result.Success body)
                      (set! result
                            (Result.Success
                              (Array.push-back @values
                                               (CoreValue.init reference
                                                               (Box.init body)))))
                    (Result.Error error) (set! result (Result.Error error)))
                (Maybe.Nothing)
                  (set! result
                        (Result.Error
                          (ResolveError.init @"missing value reference"
                                             @(ValueShape.span shape))))))
          (Result.Error _) ()))
      result))

  (private resolve-builtins)
  (hidden resolve-builtins)
  (private resolve-builtin-sources)
  (hidden resolve-builtin-sources)
  (defn resolve-builtins [shapes globals]
    (let-do [result (the
               (Result (Array CoreBuiltin) ResolveError)
               (Result.Success []))
             n (Array.length shapes)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success builtins)
            (let [shape (Array.unsafe-nth shapes i)
                  name (TypedShape.name shape)
                  _ignored-stamp (set! *resolve-stamp* @(TypedShape.stamp shape))]
              (match (global-by-name globals name)
                (Maybe.Just reference)
                  (match (resolve-type (Box.peek (TypedShape.signature shape)))
                    (Result.Success signature)
                      (set! result
                            (Result.Success
                              (Array.push-back @builtins
                                               (CoreBuiltin.init reference
                                                                 (Box.init signature)))))
                    (Result.Error error) (set! result (Result.Error error)))
                (Maybe.Nothing)
                  (set! result
                        (Result.Error
                          (ResolveError.init @"missing builtin reference"
                                             @(TypedShape.span shape))))))
          (Result.Error _) ()))
      result))

  (defn resolve-builtin-sources [shapes globals]
    (let-do [result (the
               (Result (Array CoreBuiltinSource) ResolveError)
               (Result.Success []))
             n (Array.length shapes)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success sources)
            (let [shape (Array.unsafe-nth shapes i)
                  _ignored-stamp (set! *resolve-stamp* @(TypedShape.stamp shape))]
              (match-ref (TypedShape.payload shape)
                (Maybe.Just payload)
                  (match (global-by-name globals (TypedShape.name shape))
                    (Maybe.Just reference)
                      (match (resolve-type (Box.peek (TypedShape.signature shape)))
                        (Result.Success signature)
                          (set! result
                                (Result.Success
                                  (Array.push-back @sources
                                                   (CoreBuiltinSource.init reference
                                                                           (Box.init signature)
                                                                           @payload))))
                        (Result.Error error) (set! result (Result.Error error)))
                    (Maybe.Nothing)
                      (set! result
                            (Result.Error
                              (ResolveError.init @"missing builtin source reference"
                                                 @(TypedShape.span shape)))))
                (Maybe.Nothing) ()))
          (Result.Error _) ()))
      result))

  (private resolve-signatures)
  (hidden resolve-signatures)
  (defn resolve-signatures [shapes globals]
    (let-do [result (the
               (Result (Array CoreSignature) ResolveError)
               (Result.Success []))
             n (Array.length shapes)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success signatures)
            (let [shape (Array.unsafe-nth shapes i)
                  name (TypedShape.name shape)
                  _ignored-stamp (set! *resolve-stamp* @(TypedShape.stamp shape))]
              (match (global-by-name globals name)
                (Maybe.Just reference)
                (match (resolve-type (Box.peek (TypedShape.signature shape)))
                  (Result.Success signature)
                    (set! result
                          (Result.Success
                            (Array.push-back @signatures
                                             (CoreSignature.init reference
                                                                 (Box.init signature)))))
                  (Result.Error error) (set! result (Result.Error error)))
                ;; a sig naming nothing is inert metadata in the reference
                ;; (the definition may have moved or never existed); skip it.
                (Maybe.Nothing)
                ()))
          (Result.Error _) ()))
      result))

  (private register-type-members)
  (hidden register-type-members)
  ;; best-effort: malformed member arrays yield no members here; the accessor
  ;; registration path reports proper errors for them.
  (defn register-type-members [fields]
    (let-do [members (the (Array (Pair String CoreType)) [])]
      (match-ref fields
        (Maybe.Just boxed)
          (match-ref (SurfaceNode.form (Box.peek boxed))
            (SurfaceForm.Array field-nodes)
              (let-do [items (semantic-items field-nodes)
                       n (Array.length &items)]
                (for [i 0 n 2]
                  (when (Int.< (Int.inc i) n)
                    (let [name-node (Box.peek (Array.unsafe-nth &items i))
                          type-node (Box.peek (Array.unsafe-nth &items
                                                                (Int.inc i)))]
                      (match (symbol-name name-node)
                        (Maybe.Just field-name)
                          (match (resolve-type type-node)
                            (Result.Success field-type)
                              (Array.push-back! &members
                                                (Pair.init field-name field-type))
                            (Result.Error _) ())
                        (Maybe.Nothing) ())))))
            _ ())
        (Maybe.Nothing) ())
      members))

  (private resolve-type-declarations)
  (hidden resolve-type-declarations)
  (defn resolve-type-declarations [shapes]
    (let-do [result (the (Array CoreTypeDeclaration) [])
             n (Array.length shapes)]
      (for [i 0 n]
        (let-do [shape (Array.unsafe-nth shapes i)
                 _ignored-stamp (set! *resolve-stamp*
                                      @(TypeDeclarationShape.stamp shape))]
          (set! result
                (Array.push-back result
                                 (CoreTypeDeclaration.init
                                   (generation-type-name (TypeDeclarationShape.name shape)
                                                         *resolve-stamp*)
                                   @(TypeDeclarationShape.representation shape)
                                   (register-type-members (TypeDeclarationShape.fields shape)))))))
      result))

  (private type-head-arguments)
  (hidden type-head-arguments)
  (private constructor-base-name)
  (hidden constructor-base-name)
  (private constructor-arguments)
  (hidden constructor-arguments)
  (private add-constructor)
  (hidden add-constructor)
  (private field-types)
  (hidden field-types)
  (private add-record-constructor)
  (hidden add-record-constructor)
  (private add-accessor)
  (hidden add-accessor)
  (private setter-name)
  (hidden setter-name)
  (private add-setter)
  (hidden add-setter)
  (private updater-name)
  (hidden updater-name)
  (private add-updater)
  (hidden add-updater)
  (private add-field-helpers)
  (hidden add-field-helpers)
  (private add-record-str)
  (hidden add-record-str)
  (private add-record-copy)
  (hidden add-record-copy)
  (private add-accessors-from-fields)
  (hidden add-accessors-from-fields)
  (private add-accessors-from-deftype)
  (hidden add-accessors-from-deftype)
  (private add-accessors-from-register-type)
  (hidden add-accessors-from-register-type)
  (private collect-constructors-scoped)
  (hidden collect-constructors-scoped)
  (private collect-constructors)
  (hidden collect-constructors)
  (private collect-constructor-declarations-scoped)
  (hidden collect-constructor-declarations-scoped)
  (private collect-constructor-declarations)
  (hidden collect-constructor-declarations)
  (private constructor-declarations-from-deftype)
  (hidden constructor-declarations-from-deftype)

  (defn type-head-arguments [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)] (resolve-type-items &items 1))
      _ (Result.Success [])))

  (defn constructor-base-name [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.Symbol _) (symbol-key node)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (Int.> (Array.length &items) 0)
            (symbol-key (Box.peek (Array.unsafe-nth &items 0)))
            (Maybe.Nothing)))
      _ (Maybe.Nothing)))

  (defn constructor-arguments [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (Int.> (Array.length &items) 1)
            (let [fields (Box.peek (Array.unsafe-nth &items 1))]
              (match-ref (SurfaceNode.form fields)
                (SurfaceForm.Array field-nodes)
                  (resolve-type-arguments field-nodes)
                _ (Result.Success [])))
            (Result.Success [])))
      _ (Result.Success [])))

  (defn add-constructor [state type-name result-type node]
    (match (constructor-base-name node)
      (Maybe.Just base-name)
        (match (constructor-arguments node)
          (Result.Success arguments)
            (let [globals (Pair.a state)
                  constructors (Pair.b state)
                  name (append-scope type-name &base-name)
                  reference (CoreRef.init (next-global-id globals) name true)
                  signature (CoreType.Function arguments
                                               (Box.init (CoreType.copy result-type)))]
              (Result.Success
                (Pair.init
                  (Array.push-back @globals (CoreRef.copy &reference))
                  (Array.push-back @constructors
                                   (CoreBuiltin.init reference
                                                     (Box.init signature))))))
          (Result.Error error) (Result.Error error))
      (Maybe.Nothing) (Result.Success @state)))

  (defn field-types [fields]
    (let-do [result (the
               (Result (Array (Box CoreType)) ResolveError)
               (Result.Success []))
             field-items (semantic-items fields)
             n (Array.length &field-items)]
      (for [i 0 n 2]
        (match-ref &result
          (Result.Success types)
            (if (Int.< (Int.inc i) n)
              (let [type-node (Box.peek
                      (Array.unsafe-nth &field-items (Int.inc i)))]
                (match (resolve-type type-node)
                  (Result.Success field-type)
                    (set! result
                          (Result.Success
                            (Array.push-back @types (Box.init field-type))))
                  (Result.Error error) (set! result (Result.Error error))))
              (set! result
                    (Result.Error
                      (ResolveError.init @"record fields must be name/type pairs"
                                         (SurfaceSpan.anywhere)))))
          (Result.Error _) ()))
      result))

  (defn add-record-constructor [state type-name result-type fields]
    (match (field-types fields)
      (Result.Success arguments)
        (let [globals (Pair.a state)
              constructors (Pair.b state)
              constructor-name (String.copy "init")
              name (append-scope type-name &constructor-name)
              reference (CoreRef.init (next-global-id globals) name true)
              signature (CoreType.Function arguments
                                           (Box.init (CoreType.copy result-type)))]
          (Result.Success
            (Pair.init
              (Array.push-back @globals (CoreRef.copy &reference))
              (Array.push-back @constructors
                               (CoreBuiltin.init reference (Box.init signature))))))
      (Result.Error error) (Result.Error error)))

  (defn add-accessor [state type-name record-type field-name field-type]
    (let [globals (Pair.a state)
          accessors (Pair.b state)
          name (append-scope type-name field-name)
          reference (CoreRef.init (next-global-id globals) name true)
          signature (CoreType.Function
            [(Box.init
               (CoreType.Reference (Box.init (CoreType.copy record-type))
                                   (CoreLifetime.Inferred 0)))]
            (Box.init
              (CoreType.Reference (Box.init (CoreType.copy field-type))
                                  (CoreLifetime.Inferred 0))))]
      (Result.Success
        (Pair.init
          (Array.push-back @globals (CoreRef.copy &reference))
          (Array.push-back @accessors
                           (CoreBuiltin.init reference (Box.init signature)))))))

  (defn setter-name [field-name mutating?]
    (if mutating?
      (String.concat &[@"set-" (String.copy field-name) @"!"])
      (String.concat &[@"set-" (String.copy field-name)])))

  (defn add-setter [state type-name record-type field-name field-type mutating?]
    (let [globals (Pair.a state)
          accessors (Pair.b state)
          local-name (setter-name field-name mutating?)
          name (append-scope type-name &local-name)
          reference (CoreRef.init (next-global-id globals) name true)
          record-argument (if mutating?
            (CoreType.Reference (Box.init (CoreType.copy record-type))
                                (CoreLifetime.Inferred 0))
            (CoreType.copy record-type))
          result-type (if mutating? (CoreType.Unit) (CoreType.copy record-type))
          signature (CoreType.Function
            [(Box.init record-argument) (Box.init (CoreType.copy field-type))]
            (Box.init result-type))]
      (Result.Success
        (Pair.init
          (Array.push-back @globals (CoreRef.copy &reference))
          (Array.push-back @accessors
                           (CoreBuiltin.init reference (Box.init signature)))))))

  (defn updater-name [field-name]
    (String.concat &[@"update-" (String.copy field-name)]))

  (defn add-updater [state type-name record-type field-name field-type]
    (let [globals (Pair.a state)
          accessors (Pair.b state)
          local-name (updater-name field-name)
          name (append-scope type-name &local-name)
          reference (CoreRef.init (next-global-id globals) name true)
          updater (CoreType.Function [(Box.init (CoreType.copy field-type))]
                                     (Box.init (CoreType.copy field-type)))
          signature (CoreType.Function
            [(Box.init (CoreType.copy record-type))
             (Box.init
               (CoreType.Reference (Box.init updater) (CoreLifetime.Inferred 0)))]
            (Box.init (CoreType.copy record-type)))]
      (Result.Success
        (Pair.init
          (Array.push-back @globals (CoreRef.copy &reference))
          (Array.push-back @accessors
                           (CoreBuiltin.init reference (Box.init signature)))))))

  (defn add-field-helpers [state type-name record-type field-name field-type]
    (match (add-accessor state type-name record-type field-name field-type)
      (Result.Success with-accessor)
        (match (add-setter &with-accessor
                           type-name
                           record-type
                           field-name
                           field-type
                           false)
          (Result.Success with-setter)
            (match (add-setter &with-setter
                               type-name
                               record-type
                               field-name
                               field-type
                               true)
              (Result.Success with-mutating-setter)
                (add-updater &with-mutating-setter
                             type-name
                             record-type
                             field-name
                             field-type)
              (Result.Error error) (Result.Error error))
          (Result.Error error) (Result.Error error))
      (Result.Error error) (Result.Error error)))

  ;; only Int/Bool/Unit fields are recognized as blittable here; String, Named,
  ;; and reference fields are conservatively treated as non-scalar so a managed
  ;; type is never given a shallow value copy.
  (defn scalar-core-type? [type]
    (match-ref type
      (CoreType.Integer) true
      (CoreType.Boolean) true
      (CoreType.Unit) true
      _ false))

  (defn add-record-copy [state type-name record-type]
    (let [globals (Pair.a state)
          accessors (Pair.b state)
          name (append-scope type-name "copy")]
      (match (global-by-name globals &name)
        (Maybe.Just _) (Result.Success @state)
        (Maybe.Nothing)
          (let [reference (CoreRef.init (next-global-id globals) name true)
                signature (CoreType.Function
                  [(Box.init
                     (CoreType.Reference (Box.init (CoreType.copy record-type))
                                         (CoreLifetime.Inferred 0)))]
                  (Box.init (CoreType.copy record-type)))]
            (Result.Success
              (Pair.init
                (Array.push-back @globals (CoreRef.copy &reference))
                (Array.push-back @accessors
                                 (CoreBuiltin.init reference
                                                   (Box.init signature)))))))))

  (defn add-record-str [state type-name record-type]
    (let [globals (Pair.a state)
          accessors (Pair.b state)
          name (append-scope type-name "str")]
      (match (global-by-name globals &name)
        (Maybe.Just _) (Result.Success @state)
        (Maybe.Nothing)
          (let [reference (CoreRef.init (next-global-id globals) name true)
                signature (CoreType.Function
                  [(Box.init
                     (CoreType.Reference (Box.init (CoreType.copy record-type))
                                         (CoreLifetime.Inferred 0)))]
                  (Box.init (CoreType.String)))]
            (Result.Success
              (Pair.init
                (Array.push-back @globals (CoreRef.copy &reference))
                (Array.push-back @accessors
                                 (CoreBuiltin.init reference
                                                   (Box.init signature)))))))))

  (defn add-accessors-from-fields [state type-name record-type fields]
    (let-do [result (the
               (Result (Pair (Array CoreRef) (Array CoreBuiltin)) ResolveError)
               (Result.Success @state))
             field-items (semantic-items fields)
             n (Array.length &field-items)
             all-scalar true]
      (for [i 0 n 2]
        (match-ref &result
          (Result.Success current)
            (if (Int.< (Int.inc i) n)
              (let [name-node (Box.peek (Array.unsafe-nth &field-items i))
                    type-node (Box.peek
                      (Array.unsafe-nth &field-items (Int.inc i)))]
                (match (symbol-name name-node)
                  (Maybe.Just field-name)
                    (match (resolve-type type-node)
                      (Result.Success field-type)
                        (do
                          (unless (scalar-core-type? &field-type)
                            (set! all-scalar false))
                          (set! result
                                (add-field-helpers current
                                                   type-name
                                                   record-type
                                                   &field-name
                                                   &field-type)))
                      (Result.Error error) (set! result (Result.Error error)))
                  (Maybe.Nothing)
                    (set! result
                          (Result.Error
                            (error-at name-node
                                      @"record field name must be a symbol")))))
              (set! result
                    (Result.Error
                      (ResolveError.init @"record fields must be name/type pairs"
                                         (SurfaceSpan.anywhere)))))
          (Result.Error _) ()))
      (match result
        (Result.Success current)
          (match (add-record-str &current type-name record-type)
            (Result.Success with-str)
              (add-record-copy &with-str type-name record-type)
            (Result.Error error) (Result.Error error))
        (Result.Error error) (Result.Error error))))

  (defn add-accessors-from-deftype [state form type-name]
    (match-ref (SurfaceNode.form form)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (Int.>= (Array.length &items) 3)
            (let [type-head (Box.peek (Array.unsafe-nth &items 1))
                  fields-node (Box.peek (Array.unsafe-nth &items 2))]
              (match-ref (SurfaceNode.form fields-node)
                (SurfaceForm.Array fields)
                  (match (type-head-arguments type-head)
                    (Result.Success type-arguments)
                      (let [record-type (CoreType.Named (String.copy type-name)
                                                        type-arguments)]
                        (add-accessors-from-fields state
                                                   type-name
                                                   &record-type
                                                   fields))
                    (Result.Error error) (Result.Error error))
                _ (Result.Success @state)))
            (Result.Success @state)))
      _ (Result.Success @state)))

  (defn add-accessors-from-register-type [state form type-name]
    (match-ref (SurfaceNode.form form)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (Int.>= (Array.length &items) 3)
            (let [fields-node (Box.peek (Array.unsafe-nth &items 2))]
              (match-ref (SurfaceNode.form fields-node)
                (SurfaceForm.Array fields)
                  (let [record-type (CoreType.Named (String.copy type-name) [])]
                    (match (add-record-constructor state
                                                   type-name
                                                   &record-type
                                                   fields)
                      (Result.Success with-constructor)
                        (add-accessors-from-fields &with-constructor
                                                   type-name
                                                   &record-type
                                                   fields)
                      (Result.Error error) (Result.Error error)))
                _ (Result.Success @state)))
            (Result.Success @state)))
      _ (Result.Success @state)))

  (defn add-constructors-from-deftype [state form type-name]
    (match-ref (SurfaceNode.form form)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (Int.>= (Array.length &items) 2)
            (let [type-head (Box.peek (Array.unsafe-nth &items 1))]
              (match (type-head-arguments type-head)
                (Result.Success type-arguments)
                  (let-do [result-type (CoreType.Named (String.copy type-name)
                                                       type-arguments)
                           result (the
                             (Result
                               (Pair (Array CoreRef) (Array CoreBuiltin))
                               ResolveError)
                             (add-record-copy state type-name &result-type))
                           n (Array.length &items)]
                    (if (Int.= n 3)
                      (let [fields-node (Box.peek (Array.unsafe-nth &items 2))]
                        (match-ref (SurfaceNode.form fields-node)
                          (SurfaceForm.Array fields)
                            (match-ref &result
                              (Result.Success current)
                                (set! result
                                      (add-record-constructor current
                                                              type-name
                                                              &result-type
                                                              fields))
                              (Result.Error _) ())
                          _
                            (for [i 2 n]
                              (match-ref &result
                                (Result.Success current)
                                  (set! result
                                        (add-constructor current
                                                         type-name
                                                         &result-type
                                                         (Box.peek (Array.unsafe-nth &items
                                                                                     i))))
                                (Result.Error _) ()))))
                      (for [i 2 n]
                        (match-ref &result
                          (Result.Success current)
                            (set! result
                                  (add-constructor current
                                                   type-name
                                                   &result-type
                                                   (Box.peek (Array.unsafe-nth &items
                                                                               i))))
                          (Result.Error _) ())))
                    result)
                (Result.Error error) (Result.Error error)))
            (Result.Success @state)))
      _ (Result.Success @state)))

  (doc collect-constructors-scoped "mints constructor/accessor globals for
every recorded type-declaration event, in source order. Each event's minted
names use its generation-adjusted type name, so redefined types coexist under
distinct identities.")
  (defn collect-constructors-scoped [initial]
    (let-do [result (the
               (Result (Pair (Array CoreRef) (Array CoreBuiltin)) ResolveError)
               (Result.Success initial))
             n (Array.length &*type-decl-events*)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success state)
            (let [event (Array.unsafe-nth &*type-decl-events* i)
                  form (Box.peek (TypeDeclEvent.form event))
                  gen-name (event-generation-name i)
                  _ignored-stamp (set! *resolve-stamp*
                                       @(TypeDeclEvent.stamp event))]
              (cond
                (declaration? form @"deftype")
                  (match (add-constructors-from-deftype state form &gen-name)
                    (Result.Success with-constructors)
                      (set! result
                            (add-accessors-from-deftype &with-constructors
                                                        form
                                                        &gen-name))
                    (Result.Error error) (set! result (Result.Error error)))
                (declaration? form @"register-type")
                  (set! result
                        (add-accessors-from-register-type state form &gen-name))
                ()))
          (Result.Error _) ()))
      result))

  (defn collect-constructors [globals]
    (match (collect-constructors-scoped (Pair.init (Array.copy globals) []))
      (Result.Success state)
        (match (collect-constructor-declarations (Pair.a &state))
          (Result.Success declarations)
            (Result.Success
              (ResolvedConstructors.init @(Pair.a &state)
                                         @(Pair.b &state)
                                         declarations))
          (Result.Error error) (Result.Error error))
      (Result.Error error) (Result.Error error)))

  (defn append-constructor-declarations [left right]
    (let-do [result (Array.copy left)
             n (Array.length right)]
      (for [i 0 n]
        (set! result (Array.push-back result @(Array.unsafe-nth right i))))
      result))

  ;; field names in declaration order for a record constructor; empty for a sum
  ;; constructor whose arguments are positional. Derive uses these to generate
  ;; accessor bodies.
  (defn field-names-of [fields]
    (let-do [result (the (Array String) [])
             field-items (semantic-items fields)
             n (Array.length &field-items)]
      (for [i 0 n 2]
        (when (Int.< (Int.inc i) n)
          (match (symbol-name (Box.peek (Array.unsafe-nth &field-items i)))
            (Maybe.Just name) (Array.push-back! &result name)
            (Maybe.Nothing) ())))
      result))

  (defn constructor-declaration [globals
                                 type-name
                                 result-type
                                 base-name
                                 tag
                                 arguments
                                 field-names
                                 record
                                 node]
    (let [name (append-scope type-name base-name)]
      (match (global-by-name globals &name)
        (Maybe.Just reference)
          (Result.Success
            (CoreConstructorDeclaration.init reference
                                             tag
                                             arguments
                                             field-names
                                             (Box.init (CoreType.copy result-type))
                                             record))
        (Maybe.Nothing)
          (Result.Error (error-at node @"missing nominal constructor reference")))))

  (defn constructor-declarations-from-deftype [form type-name globals]
    (match-ref (SurfaceNode.form form)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (Int.>= (Array.length &items) 3)
            (let [type-head (Box.peek (Array.unsafe-nth &items 1))]
              (match (type-head-arguments type-head)
                (Result.Success type-arguments)
                  (let-do [result (the
                             (Result (Array CoreConstructorDeclaration)
                                     ResolveError)
                             (Result.Success []))
                           result-type (CoreType.Named (String.copy type-name)
                                                       type-arguments)
                           n (Array.length &items)
                           third (Box.peek (Array.unsafe-nth &items 2))]
                    (if (and (Int.= n 3)
                             (match-ref (SurfaceNode.form third)
                               (SurfaceForm.Array _) true
                               _ false))
                      (match-ref (SurfaceNode.form third)
                        (SurfaceForm.Array fields)
                          (match (field-types fields)
                            (Result.Success arguments)
                              (match (constructor-declaration globals
                                                              type-name
                                                              &result-type
                                                              "init"
                                                              0
                                                              arguments
                                                              (field-names-of fields)
                                                              true
                                                              third)
                                (Result.Success declaration)
                                  (set! result (Result.Success [declaration]))
                                (Result.Error error)
                                  (set! result (Result.Error error)))
                            (Result.Error error)
                              (set! result (Result.Error error)))
                        _ ())
                      (for [i 2 n]
                        (match-ref &result
                          (Result.Success declarations)
                            (let [constructor (Box.peek (Array.unsafe-nth &items
                                                                          i))]
                              (match (constructor-base-name constructor)
                                (Maybe.Just base-name)
                                  (match (constructor-arguments constructor)
                                    (Result.Success arguments)
                                      (match (constructor-declaration globals
                                                                      type-name
                                                                      &result-type
                                                                      &base-name
                                                                      (Int.- i 2)
                                                                      arguments
                                                                      (the (Array String)
                                                                           [])
                                                                      false
                                                                      constructor)
                                        (Result.Success declaration)
                                          (set! result
                                                (Result.Success
                                                  (Array.push-back @declarations
                                                                   declaration)))
                                        (Result.Error error)
                                          (set! result (Result.Error error)))
                                    (Result.Error error)
                                      (set! result (Result.Error error)))
                                (Maybe.Nothing)
                                  (set! result
                                        (Result.Error
                                          (error-at constructor
                                                    @"invalid nominal constructor")))))
                          (Result.Error _) ())))
                    result)
                (Result.Error error) (Result.Error error)))
            (Result.Success [])))
      _ (Result.Success [])))

  (defn collect-constructor-declarations [globals]
    (let-do [result (the
               (Result (Array CoreConstructorDeclaration) ResolveError)
               (Result.Success []))
             n (Array.length &*type-decl-events*)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success declarations)
            (let [event (Array.unsafe-nth &*type-decl-events* i)
                  form (Box.peek (TypeDeclEvent.form event))
                  _ignored-stamp (set! *resolve-stamp*
                                       @(TypeDeclEvent.stamp event))]
              (when (declaration? form @"deftype")
                (let [gen-name (event-generation-name i)]
                  (match (constructor-declarations-from-deftype form
                                                                &gen-name
                                                                globals)
                    (Result.Success found)
                      (set! result
                            (Result.Success
                              (append-constructor-declarations declarations
                                                               &found)))
                    (Result.Error error) (set! result (Result.Error error))))))
          (Result.Error _) ()))
      result))

  (private resolve-interfaces)
  (hidden resolve-interfaces)
  (defn resolve-interfaces [shapes globals]
    (let-do [result (the
               (Result (Array CoreInterface) ResolveError)
               (Result.Success []))
             n (Array.length shapes)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success interfaces)
            (let [shape (Array.unsafe-nth shapes i)
                  name (TypedShape.name shape)
                  _ignored-stamp (set! *resolve-stamp* @(TypedShape.stamp shape))]
              (match (first-global-by-name globals name)
                (Maybe.Just reference)
                  (match (resolve-type (Box.peek (TypedShape.signature shape)))
                    (Result.Success signature)
                      (set! result
                            (Result.Success
                              (Array.push-back @interfaces
                                               (CoreInterface.init reference
                                                                   (Box.init signature)))))
                    (Result.Error error) (set! result (Result.Error error)))
                (Maybe.Nothing)
                  (set! result
                        (Result.Error
                          (ResolveError.init @"missing interface reference"
                                             @(TypedShape.span shape))))))
          (Result.Error _) ()))
      result))

  (private resolve-implementations)
  (hidden resolve-implementations)
  (private has-generated-implementation?)
  (hidden has-generated-implementation?)
  (private generated-copy-implementations)
  (hidden generated-copy-implementations)
  (defn resolve-implementations [shapes globals]
    (let-do [result (the
               (Result (Array CoreImplementation) ResolveError)
               (Result.Success []))
             n (Array.length shapes)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success implementations)
            (let [shape (Array.unsafe-nth shapes i)
                  interface-name (ImplementationShape.interface-name shape)
                  implementation-name (ImplementationShape.implementation-name shape)
                  _ignored-stamp (set! *resolve-stamp*
                                       @(ImplementationShape.stamp shape))]
              (match (first-global-by-name globals interface-name)
                (Maybe.Just interface)
                  (match (global-by-name globals implementation-name)
                    (Maybe.Just implementation)
                      (set! result
                            (Result.Success
                              (Array.push-back @implementations
                                               (CoreImplementation.init interface
                                                                        implementation))))
                    (Maybe.Nothing)
                      (set! result
                            (Result.Error
                              (ResolveError.init
                                (let [suggestion (nearest-name implementation-name
                                                               globals
                                                               &(the (Array CoreRef)
                                                                     []))]
                                  (String.concat
                                    &[@"unknown implementation "
                                      (String.copy implementation-name)
                                      (if (String.empty? &suggestion)
                                        @""
                                        (String.concat &[@"; did you mean "
                                                         @&suggestion
                                                         @"?"]))]))
                                @(ImplementationShape.span shape)))))
                (Maybe.Nothing)
                  (set! result
                        (Result.Error
                          (ResolveError.init
                            (String.concat
                              &[@"unknown interface "
                                (String.copy interface-name)])
                            @(ImplementationShape.span shape))))))
          (Result.Error _) ()))
      result))

  (defn has-generated-implementation? [implementations reference]
    (let-do [found false
             n (Array.length implementations)]
      (for [i 0 n]
        (when (=
            (CoreRef.name
              (CoreImplementation.implementation (Array.unsafe-nth implementations
                                                                   i)))
            (CoreRef.name reference))
          (set! found true)))
      found))

  (private auto-interface-implementations)
  (hidden auto-interface-implementations)
  (doc auto-interface-implementations "the reference implicitly implements an
interface when a module-level function carries the interface's name (e.g. core's
`Map.str` has no explicit `implements`). Dispatch still unifies signatures, so a
name-matched function that does not fit the interface is never selected.")
  (defn auto-interface-implementations [functions interfaces existing]
    (let-do [result (the (Array CoreImplementation) [])
             fn-count (Array.length functions)
             iface-count (Array.length interfaces)]
      (for [i 0 fn-count]
        (let-do [fref (CoreFunction.reference (Array.unsafe-nth functions i))
                 fname (CoreRef.name fref)
                 segments (String.split-by fname &[\.])
                 local (if (Int.> (Array.length &segments) 1)
                   @(Array.unsafe-nth &segments
                                      (Int.dec (Array.length &segments)))
                   (String.copy ""))]
          (unless (String.empty? &local)
            (for [j 0 iface-count]
              (let [iref (CoreInterface.reference (Array.unsafe-nth interfaces j))]
                (when (and (String.= &local (CoreRef.name iref))
                           (not (has-generated-implementation? existing fref)))
                  (Array.push-back! &result
                                    (CoreImplementation.init (CoreRef.copy iref)
                                                             (CoreRef.copy fref)))))))))
      result))

  (defn generated-copy-implementations [builtins]
    (let-do [result (the (Array CoreImplementation) [])
             copy-interface (CoreRef.init 0 (String.copy "copy") true)
             n (Array.length builtins)]
      (for [i 0 n]
        (let [builtin (Array.unsafe-nth builtins i)
              reference (CoreBuiltin.reference builtin)
              name (CoreRef.name reference)]
          (when (and (String.ends-with? name ".copy")
                     (not (has-generated-implementation? &result reference)))
            (Array.push-back! &result
                              (CoreImplementation.init (CoreRef.copy &copy-interface)
                                                       @(CoreBuiltin.reference builtin))))))
      result))

  (private resolve-top-level-expressions)
  (hidden resolve-top-level-expressions)
  (defn resolve-top-level-expressions [nodes globals imports]
    (let-do [result (the
               (Result (Array (Box CoreExpr)) ResolveError)
               (Result.Success []))
             locals (the (Array CoreRef) [])
             n (Array.length nodes)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success expressions)
            (let [scoped (Array.unsafe-nth nodes i)
                  _ignored-stamp (set! *resolve-stamp*
                                       @(ScopedExpression.stamp scoped))]
              (match (resolve-expression
                  (Box.peek (ScopedExpression.node scoped))
                  &locals
                  globals
                  imports
                  (ScopedExpression.scope scoped))
                (Result.Success expression)
                  (set! result
                        (Result.Success
                          (Array.push-back @expressions (Box.init expression))))
                (Result.Error error) (set! result (Result.Error error))))
          (Result.Error _) ()))
      result))

  (private record-collected-definitions!)
  (hidden record-collected-definitions!)
  (defn record-collected-definitions! [collected globals]
    (when-do *provenance-enabled*
      (let [functions (CollectedForms.functions collected)]
        (for [i 0 (Array.length functions)]
          (let [shape (Array.unsafe-nth functions i)
                _ignored-stamp (set! *resolve-stamp*
                                     @(FunctionShape.stamp shape))]
            (match (global-by-name globals (FunctionShape.name shape))
              (Maybe.Just reference)
                (record-binding! &reference (FunctionShape.span shape) true)
              (Maybe.Nothing) ()))))
      (let [values (CollectedForms.values collected)]
        (for [i 0 (Array.length values)]
          (let [shape (Array.unsafe-nth values i)
                _ignored-stamp (set! *resolve-stamp* @(ValueShape.stamp shape))]
            (match (global-by-name globals (ValueShape.name shape))
              (Maybe.Just reference)
                (record-binding! &reference (ValueShape.span shape) true)
              (Maybe.Nothing) ()))))
      (let [builtins (CollectedForms.builtins collected)]
        (for [i 0 (Array.length builtins)]
          (let [shape (Array.unsafe-nth builtins i)
                _ignored-stamp (set! *resolve-stamp* @(TypedShape.stamp shape))]
            (match (global-by-name globals (TypedShape.name shape))
              (Maybe.Just reference)
                (record-binding! &reference (TypedShape.span shape) true)
              (Maybe.Nothing) ()))))
      (let [interfaces (CollectedForms.interfaces collected)]
        (for [i 0 (Array.length interfaces)]
          (let [shape (Array.unsafe-nth interfaces i)
                _ignored-stamp (set! *resolve-stamp* @(TypedShape.stamp shape))]
            (match (first-global-by-name globals (TypedShape.name shape))
              (Maybe.Just reference)
                (record-binding! &reference (TypedShape.span shape) true)
              (Maybe.Nothing) ()))))))

  (private module-inner)
  (hidden module-inner)
  (private module-with-provenance-seeded)
  (hidden module-with-provenance-seeded)
  (sig module-inner (Fn [(Ref SurfaceModule)] (Result CoreModule ResolveError)))
  (sig module (Fn [(Ref SurfaceModule)] (Result CoreModule ResolveError)))
  (sig module-with-provenance
       (Fn
         [(Ref SourcedSurfaceModule) (Ref IdAllocator)]
         (Result ProvenancedCoreModule ResolveError)))

  (sig module-with-provenance-against
       (Fn
         [(Ref SourcedSurfaceModule) (Ref IdAllocator) (Ref ResolveSnapshot)]
         (Result ProvenancedCoreModule ResolveError)))
  (sig module-with-provenance-against-reusing
       (Fn
         [(Ref SourcedSurfaceModule)
          (Ref IdAllocator)
          (Ref ResolveSnapshot)
          (Ref (Array CoreRef))]
         (Result ProvenancedCoreModule ResolveError)))
  (sig module-with-provenance-seeded
       (Fn
         [(Ref SourcedSurfaceModule) (Ref IdAllocator)]
         (Result ProvenancedCoreModule ResolveError)))

  (doc module "lowers expanded surface syntax to resolved core IR using the
historical owner-relative expression IDs.")
  (defn module [surface]
    (let-do [_ignored-provenance (set! *provenance-enabled* false)
             _ignored-globals (set! *resolve-seed-globals*
                                    (PrimitiveRegistry.globals))
             _ignored-imports (set! *resolve-seed-imports* [])
             _ignored-reuse (set! *resolve-reuse-globals* [])]
      (module-inner surface)))

  ;; Examples: what this phase turns syntax into.

  (doc a-resolved-module "surface syntax lowered to core IR: names are bound
to references, and everything downstream works on this rather than on text.
The source uses no standard library, because a phase resolves against the
primitives it is given and nothing else.")
  (meta-set! a-resolved-module "example" true)
  (defn a-resolved-module []
    (Result.from-success
      (Resolve.module
        &(Result.from-success (Surface.parse "(defn identity [x] x)")
                              (SurfaceModule.init [])))
      (CoreIR.empty-module)))

  (doc a-resolved-definition-count "how many definitions a resolved module
holds, the smallest thing worth asking it.")
  (meta-set! a-resolved-definition-count "example" true)
  (defn a-resolved-definition-count []
    (Array.length (CoreModule.functions &(a-resolved-module))))

  (doc module-with-provenance "resolves caller-identified syntax with node IDs
from a caller-owned monotonic allocator, returning the core IR and source map.")
  (defn module-with-provenance [sourced allocator]
    (let-do [_ignored-globals (set! *resolve-seed-globals*
                                    (PrimitiveRegistry.globals))
             _ignored-imports (set! *resolve-seed-imports* [])
             _ignored-reuse (set! *resolve-reuse-globals* [])]
      (module-with-provenance-seeded sourced allocator)))

  (doc module-with-provenance-against "resolves caller syntax against a warm
base snapshot without collecting or resolving the base module again.")
  (defn module-with-provenance-against [sourced allocator snapshot]
    (let-do [_ignored-globals (set! *resolve-seed-globals*
                                    (Array.copy (ResolveSnapshot.globals snapshot)))
             _ignored-imports (set! *resolve-seed-imports*
                                    (Array.copy (ResolveSnapshot.imports snapshot)))
             _ignored-reuse (set! *resolve-reuse-globals* [])]
      (module-with-provenance-seeded sourced allocator)))

  (doc module-with-provenance-against-reusing "resolves caller syntax against
a warm snapshot while retaining explicitly supplied compatible definition
identities. Callers must only provide references whose name and definition kind
match the replacement being resolved.")
  (defn module-with-provenance-against-reusing [sourced allocator snapshot reuse]
    (let-do [_ignored-globals (set! *resolve-seed-globals*
                                    (Array.copy (ResolveSnapshot.globals snapshot)))
             _ignored-imports (set! *resolve-seed-imports*
                                    (Array.copy (ResolveSnapshot.imports snapshot)))
             _ignored-reuse (set! *resolve-reuse-globals* (Array.copy reuse))
             result (module-with-provenance-seeded sourced allocator)
             _ignored-clear (set! *resolve-reuse-globals* [])]
      result))

  (defn module-with-provenance-seeded [sourced allocator]
    (let-do [start (IdAllocator.next-up! allocator)
             _ignored-enabled (set! *provenance-enabled* true)
             _ignored-source (set! *provenance-source-id*
                                   (String.copy
                                     (SourceInput.id (SourcedSurfaceModule.input sourced))))
             _ignored-next (set! *provenance-next-node-id* start)
             _ignored-nodes (set! *provenance-nodes* [])
             _ignored-bindings (set! *provenance-bindings* [])
             _ignored-definitions (set! *provenance-definitions* [])
             result (module-inner (SourcedSurfaceModule.module sourced))
             provenance (CoreProvenance.init (Array.copy &*provenance-nodes*)
                                             (Array.copy &*provenance-bindings*)
                                             (Array.copy &*provenance-definitions*))
             _ignored-allocator (Array.aset! (IdAllocator.cell allocator)
                                             0
                                             *provenance-next-node-id*)
             _ignored-disabled (set! *provenance-enabled* false)]
      (match result
        (Result.Success core)
          (Result.Success (ProvenancedCoreModule.init core provenance))
        (Result.Error error) (Result.Error error))))

  (doc last-snapshot "returns the name-resolution environment produced by the
most recent successful module resolution.")
  (defn last-snapshot [] (ResolveSnapshot.copy &*last-resolve-snapshot*))

  (private snapshot-has-global?)
  (hidden snapshot-has-global?)
  (defn snapshot-has-global? [globals reference]
    (let-do [found false]
      (for [i 0 (Array.length globals)]
        (when (CoreIR.same-ref? (Array.unsafe-nth globals i) reference)
          (set! found true)))
      found))

  (private snapshot-add-global!)
  (hidden snapshot-add-global!)
  (defn snapshot-add-global! [globals reference]
    (unless (snapshot-has-global? globals reference)
      (Array.push-back! globals (CoreRef.copy reference))))

  (doc snapshot-with-module "adds declarations generated after resolution to a
warm snapshot, retaining all original import visibility.")
  (defn snapshot-with-module [snapshot core]
    (let-do [globals (Array.copy (ResolveSnapshot.globals snapshot))]
      (for [i 0 (Array.length (CoreModule.functions core))]
        (snapshot-add-global! &globals
                              (CoreFunction.reference
                                (Array.unsafe-nth (CoreModule.functions core) i))))
      (for [i 0 (Array.length (CoreModule.values core))]
        (snapshot-add-global! &globals
                              (CoreValue.reference
                                (Array.unsafe-nth (CoreModule.values core) i))))
      (for [i 0 (Array.length (CoreModule.builtins core))]
        (snapshot-add-global! &globals
                              (CoreBuiltin.reference
                                (Array.unsafe-nth (CoreModule.builtins core) i))))
      (for [i 0 (Array.length (CoreModule.interfaces core))]
        (snapshot-add-global! &globals
                              (CoreInterface.reference
                                (Array.unsafe-nth (CoreModule.interfaces core) i))))
      (for [i 0 (Array.length (CoreModule.constructors core))]
        (snapshot-add-global! &globals
                              (CoreConstructorDeclaration.reference
                                (Array.unsafe-nth (CoreModule.constructors core)
                                                  i))))
      (ResolveSnapshot.init globals
                            (Array.copy (ResolveSnapshot.imports snapshot)))))

  (doc module-inner
    "lowers expanded surface syntax to resolved core IR. The first
typed gate supports functions, builtins, interfaces, literals, references, and
calls; unsupported forms produce a source-spanned error rather than being
guessed at.")
  (defn module-inner [surface]
    ;; per-module reset of the visibility channel, which `collect` fills.
    ;; (The overload channel is reset later, in populate-arities!, which runs
    ;; AFTER collection — resetting private names there would wipe them.)
    (let-do [_ignored-private (set! *private-names* [])
             _ignored-stamp (set! *type-decl-stamp* 0)
             _ignored-events (set! *type-decl-events* [])
             _ignored-site-stamp (set! *resolve-stamp* 0)]
      (match (collect-with-generations (SurfaceModule.forms surface))
        (Result.Success collected)
        ;; the constructor passes resolve plain (= last-generation) names, so
        ;; they run at the maximum stamp; body passes re-set it per shape.
        (let-do [_ignored-max-stamp (set! *resolve-stamp* *type-decl-stamp*)]
          (match (collect-constructors (CollectedForms.globals &collected))
            (Result.Success constructor-state)
              (let-do [all-globals (Array.copy
                         (ResolvedConstructors.globals &constructor-state))
                       constructor-builtins (Array.copy
                         (ResolvedConstructors.builtins &constructor-state))
                       _ignored-arities (populate-arities! &collected
                                                           &constructor-builtins)
                       _ignored-provenance (record-collected-definitions! &collected
                                                                          &all-globals)
                       _ignored-snapshot (set! *last-resolve-snapshot*
                                               (ResolveSnapshot.init (Array.copy &all-globals)
                                                                     (Array.copy (CollectedForms.imports &collected))))
                       type-declarations (resolve-type-declarations
                         (CollectedForms.type-declarations &collected))
                       constructor-declarations (Array.copy
                         (ResolvedConstructors.declarations &constructor-state))]
                (match (resolve-functions (CollectedForms.functions &collected)
                                          &all-globals
                                          (CollectedForms.imports &collected)
                                          (CollectedForms.interfaces &collected))
                  (Result.Success functions)
                    (match (resolve-values (CollectedForms.values &collected)
                                           &all-globals
                                           (CollectedForms.imports &collected))
                      (Result.Success values)
                        (match (resolve-builtins (CollectedForms.builtins &collected)
                                                 &all-globals)
                          (Result.Success builtins)
                            (match (resolve-builtin-sources (CollectedForms.builtins &collected)
                                                            &all-globals)
                              (Result.Success builtin-sources)
                                (let [base-builtins (PrimitiveRegistry.builtins)
                                      intrinsic-and-constructors (append-core-builtins &base-builtins
                                                                                       &constructor-builtins)
                                      ;; a `register`ed name that the same program
                                      ;; also DEFINES is not a builtin: the
                                      ;; definition supplies the body. Leaving the
                                      ;; declaration in place makes inference treat
                                      ;; the name as a builtin and never visit the
                                      ;; body, so every call inside it stays
                                      ;; untyped. The declared type is kept as a
                                      ;; signature, which is what `register` before
                                      ;; a definition means (examples/mutual_recursion).
                                      defined-builtins (defined-builtin-names &builtins
                                                                              (CollectedForms.functions &collected))
                                      all-builtins (append-core-builtins &intrinsic-and-constructors
                                                                         &(builtins-without &builtins
                                                                                            &defined-builtins))
                                      all-builtin-sources (let-do [srcs (PrimitiveRegistry.template-sources)]
                                        (for [si
                                              0
                                              (Array.length &builtin-sources)]
                                          (Array.push-back! &srcs
                                                            @(Array.unsafe-nth &builtin-sources
                                                                               si)))
                                        srcs)]
                                  (match (resolve-signatures (CollectedForms.signatures &collected)
                                                             &all-globals)
                                    (Result.Success raw-signatures)
                                      (let [signatures (let-do [merged (Array.copy &raw-signatures)
                                                                converted (builtin-signatures &builtins
                                                                                              &defined-builtins)]
                                              (for [si
                                                    0
                                                    (Array.length &converted)]
                                                (Array.push-back! &merged
                                                                  @(Array.unsafe-nth &converted
                                                                                     si)))
                                              merged)]
                                        (match (resolve-interfaces (CollectedForms.interfaces &collected)
                                                                   &all-globals)
                                          (Result.Success interfaces)
                                            (let [base-interfaces (PrimitiveRegistry.interfaces)
                                                  all-interfaces (append-core-interfaces &base-interfaces
                                                                                         &interfaces)]
                                              (match (resolve-implementations
                                                  (CollectedForms.implementations &collected)
                                                  &all-globals)
                                                (Result.Success implementations)
                                                  (let [base-implementations (PrimitiveRegistry.implementations)
                                                        generated-implementations (generated-copy-implementations &constructor-builtins)
                                                        base-and-generated (append-core-implementations &base-implementations
                                                                                                        &generated-implementations)
                                                        explicit-implementations (append-core-implementations &base-and-generated
                                                                                                              &implementations)
                                                        auto-implementations (auto-interface-implementations &functions
                                                                                                             &all-interfaces
                                                                                                             &explicit-implementations)
                                                        all-implementations (append-core-implementations &explicit-implementations
                                                                                                         &auto-implementations)]
                                                    (match (resolve-top-level-expressions (CollectedForms.expressions &collected)
                                                                                          &all-globals
                                                                                          (CollectedForms.imports &collected))
                                                      (Result.Success expressions)
                                                        (let [final-interfaces (append-core-interfaces &all-interfaces
                                                                                                       &*overload-interfaces*)
                                                              final-implementations (append-core-implementations &all-implementations
                                                                                                                 &*overload-implementations*)
                                                              module (CoreModule.init functions
                                                                                      values
                                                                                      all-builtins
                                                                                      all-builtin-sources
                                                                                      signatures
                                                                                      type-declarations
                                                                                      constructor-declarations
                                                                                      final-interfaces
                                                                                      final-implementations
                                                                                      @(CollectedForms.system-includes &collected)
                                                                                      expressions)]
                                                          (if *provenance-enabled*
                                                            (Result.Success module)
                                                            (Result.Success (CoreIR.index-call-sites &module))))
                                                      (Result.Error error)
                                                        (Result.Error error)))
                                                (Result.Error error)
                                                  (Result.Error error)))
                                          (Result.Error error)
                                            (Result.Error error)))
                                    (Result.Error error) (Result.Error error)))
                              (Result.Error error) (Result.Error error))
                          (Result.Error error) (Result.Error error))
                      (Result.Error error) (Result.Error error))
                  (Result.Error error) (Result.Error error)))
            (Result.Error error) (Result.Error error)))
        (Result.Error error)
        (Result.Error error)))))
