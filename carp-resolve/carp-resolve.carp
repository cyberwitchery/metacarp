  (doc global-by-name "the LAST global whose name matches; the single funnel
where a candidate name meets the global table, so the type-generation rewrite
happens here (a dotted name prefixed by a redefined type binds the generation
live at the current resolve stamp).")
  (defn global-by-name [globals name]
    (let-do [rewritten (generation-qualify name *resolve-stamp*)
             result (the (Maybe CoreRef) (Maybe.Nothing))
             n (Array.length globals)]
      (for [i 0 n]
        (let [candidate (Array.unsafe-nth globals i)]
          (when (= (CoreRef.name candidate) &rewritten)
            (set! result (Maybe.Just @candidate)))))
      result))

  (defn first-global-by-name [globals name]
    (let-do [result (the (Maybe CoreRef) (Maybe.Nothing))
             n (Array.length globals)]
      (for [i 0 n]
        (match-ref &result
          (Maybe.Nothing)
            (let [candidate (Array.unsafe-nth globals i)]
              (when (= (CoreRef.name candidate) name)
                (set! result (Maybe.Just @candidate))))
          (Maybe.Just _) ()))
      result))

  (defn duplicate-definition-message [name]
    (String.concat &[@"duplicate top-level definition: " (String.copy name)]))

