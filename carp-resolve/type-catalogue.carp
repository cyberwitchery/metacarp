(load "../carp-ir/carp-ir.carp")

(doc ResolvedTypeHead "is a type constructor. `name` is its name and `arity` its
number of parameters, or -1 for function types.")
(deftype ResolvedTypeHead [name String
                           arity Int])

(doc TypeCatalogue "lists the type constructors of a resolved module.")
(defmodule TypeCatalogue
  (doc add! "adds the type constructor `name` with `arity` to `heads`, or raises
its arity if it is there with a smaller one.")
  (defn add! [heads name arity]
    (let-do [found false]
      (for [i 0 (Array.length heads)]
        (let [head (Array.unsafe-nth heads i)]
          (when-do (String.= (ResolvedTypeHead.name head) name)
            (set! found true)
            (when (Int.> arity @(ResolvedTypeHead.arity head))
              (ResolvedTypeHead.set-arity! head arity)))))
      (unless found
        (Array.push-back! heads (ResolvedTypeHead.init (String.copy name) arity)))))

  (doc collect! "adds the type constructors in `type` to `heads`.")
  (sig collect! (Fn [(Ref (Array ResolvedTypeHead)) (Ref CoreType)] ()))
  (defn collect! [heads type]
    (when (WorkBudget.consume! 1)
      (match-ref type
        (CoreType.Integer) (add! heads "Int" 0)
        (CoreType.String) (add! heads "String" 0)
        (CoreType.Boolean) (add! heads "Bool" 0)
        (CoreType.Unit) (add! heads "Unit" 0)
        (CoreType.Variable _) ()
        (CoreType.Named name arguments)
          (do
            (add! heads name (Array.length arguments))
            (for [i 0 (Array.length arguments)]
              (collect! heads (Box.peek (Array.unsafe-nth arguments i)))))
        (CoreType.Reference inner _)
          (do (add! heads "Ref" 1) (collect! heads (Box.peek inner)))
        (CoreType.Function arguments result)
          (do
            (add! heads "Fn" -1)
            (for [i 0 (Array.length arguments)]
              (collect! heads (Box.peek (Array.unsafe-nth arguments i))))
            (collect! heads (Box.peek result))))))

  (doc constructors! "adds the type constructors in the result and argument
types of `constructors` to `heads`.")
  (defn constructors! [heads constructors]
    (for [i 0 (Array.length constructors)]
      (let-do [constructor (Array.unsafe-nth constructors i)
               arguments (CoreConstructorDeclaration.arguments constructor)]
        (collect! heads
                  (Box.peek (CoreConstructorDeclaration.result constructor)))
        (for [j 0 (Array.length arguments)]
          (collect! heads (Box.peek (Array.unsafe-nth arguments j)))))))

  (doc module "returns the type constructors of `core`: its declared types and
the types in its members, builtins, signatures, interfaces and constructors.")
  (defn module [core]
    (let-do [heads (the (Array ResolvedTypeHead) [])
             declarations (CoreModule.type-declarations core)
             builtins (CoreModule.builtins core)
             signatures (CoreModule.signatures core)
             interfaces (CoreModule.interfaces core)]
      (for [i 0 (Array.length declarations)]
        (let-do [declaration (Array.unsafe-nth declarations i)
                 members (CoreTypeDeclaration.members declaration)]
          (add! &heads (CoreTypeDeclaration.name declaration) 0)
          (for [j 0 (Array.length members)]
            (collect! &heads (Pair.b (Array.unsafe-nth members j))))))
      (for [i 0 (Array.length builtins)]
        (collect! &heads
                  (Box.peek
                    (CoreBuiltin.signature (Array.unsafe-nth builtins i)))))
      (for [i 0 (Array.length signatures)]
        (collect! &heads
                  (Box.peek
                    (CoreSignature.signature (Array.unsafe-nth signatures i)))))
      (for [i 0 (Array.length interfaces)]
        (collect! &heads
                  (Box.peek
                    (CoreInterface.signature (Array.unsafe-nth interfaces i)))))
      (constructors! &heads (CoreModule.constructors core))
      heads))
  (doc name "returns the name of the head of `type`, or the name of a type
variable.")
  (defn name [type]
    (match-ref type
      (CoreType.Integer) @"Int"
      (CoreType.String) @"String"
      (CoreType.Boolean) @"Bool"
      (CoreType.Unit) @"Unit"
      (CoreType.Variable name) @name
      (CoreType.Named name _) @name
      (CoreType.Reference _ _) @"Ref"
      (CoreType.Function _ _) @"Fn")))
