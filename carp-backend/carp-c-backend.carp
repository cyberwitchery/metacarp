  (defn sanitize [value] (CAbi.identifier value))

  (defn valid-system-include? [path]
    (let-do [valid (Int.> (String.length path) 0)
             n (String.length path)]
      (for [i 0 n]
        (let [codepoint (Char.to-int (String.char-at path i))]
          (when (or (Int.= codepoint 0)
                    (or (Int.= codepoint 10)
                        (or (Int.= codepoint 13)
                            (or (Int.= codepoint 34)
                                (or (Int.= codepoint 60) (Int.= codepoint 62))))))
            (set! valid false))))
      valid))

  (sig string-listed? (Fn [(Ref (Array String)) (Ref String)] Bool))
  (defn string-listed? [values target]
    (let-do [found false
             n (Array.length values)]
      (for [i 0 n]
        (when (= (Array.unsafe-nth values i) target) (set! found true)))
      found))

  (sig append-system-include!
       (Fn
         [(Ref StringBuf) (Ref (Array String)) (Ref String)]
         (Result Unit BackendError)))
  (defn append-system-include! [buffer includes path]
    (cond
      ;; entries starting with `#` (from `Unsafe.preproc`) or `typedef ` (from
      ;; `register-type` C representations) are verbatim preamble lines; they
      ;; are ordered and may legitimately repeat, so they skip deduplication.
      (or (String.starts-with? path "#") (String.starts-with? path "typedef "))
      (do (StringBuf.append-str buffer path) (StringBuf.append-str buffer "
") (Result.Success ()))
      (string-listed? includes path)
      (Result.Success ())
      (valid-system-include? path)
      (do
        (StringBuf.append-str buffer "#include <")
        (StringBuf.append-str buffer path)
        (StringBuf.append-str buffer ">
")
        (Array.push-back! includes (String.copy path))
        (Result.Success ()))
      (Result.Error
        (BackendError.init
          (String.concat &[@"invalid system include path: " (String.copy path)])))))

  (doc system-includes "renders the baseline C headers and ordered,
deduplicated source-requested system includes.")
  (defn system-includes [module]
    (let-do [buffer (StringBuf.create)
             seen (the (Array String) [])
             result (the (Result Unit BackendError) (Result.Success ()))
             defaults [@"stdbool.h"
                       @"stddef.h"
                       @"stdint.h"
                       @"stdio.h"
                       @"stdlib.h"
                       @"core.h"
                       @"carp_memory.h"]
             default-count (Array.length &defaults)]
      (for [i 0 default-count]
        (match-ref &result
          (Result.Success _)
            (set! result
                  (append-system-include! &buffer
                                          &seen
                                          (Array.unsafe-nth &defaults i)))
          (Result.Error _) ()))
      (let [requested (BackendModule.system-includes module)
            requested-count (Array.length requested)]
        (for [i 0 requested-count]
          (match-ref &result
            (Result.Success _)
              (set! result
                    (append-system-include! &buffer
                                            &seen
                                            (Array.unsafe-nth requested i)))
            (Result.Error _) ())))
      (match result
        (Result.Success _) (Result.Success (StringBuf.into-string buffer))
        (Result.Error error) (Result.Error error))))

  (doc render-type "returns the C type of `type`.")
  (defn render-type [type]
    (match (CAbi.render-type type)
      (Result.Success rendered) (Result.Success rendered)
      (Result.Error error)
        (Result.Error (BackendError.init @(CAbiError.message &error)))))

  (doc plain-local? "checks whether binder `id` keeps its plain Carp name in C.")
  (defn plain-local? [id]
    (let-do [found false
             n (Array.length &*plain-local-ids*)]
      (for [i 0 n]
        (when (Int.= @(Array.unsafe-nth &*plain-local-ids* i) id)
          (set! found true)))
      found))

  (defn local-symbol [reference]
    (let [name (CAbi.component (CoreRef.name reference))
          id (CAbi.component &(Int.str @(CoreRef.id reference)))]
      (if (plain-local? @(CoreRef.id reference))
        name
        (String.concat &[@"L" (Int.str (String.length &name)) @"_" name @"_" id]))))

  (defn specialized-type [expression] (Specialize.expression-type expression))

  (defn bind-template-variable [bindings name concrete]
    (let-do [found false
             matches true
             n (Array.length bindings)]
      (for [i 0 n]
        (let [binding (Array.unsafe-nth bindings i)]
          (when-do (= (TemplateTypeBinding.name binding) name)
            (set! found true)
            (unless-do (Type.same-representation?
                (Box.peek (TemplateTypeBinding.type binding))
                concrete)
              (set! matches false)))))
      (if found
        (if matches
          (Result.Success (Array.copy bindings))
          (Result.Error
            (BackendError.init
              (String.concat
                &[@"template variable "
                  (String.copy name)
                  @" has inconsistent concrete types"]))))
        (Result.Success
          (Array.push-back (Array.copy bindings)
                           (TemplateTypeBinding.init (String.copy name)
                                                     (Box.init (MonoType.copy concrete))))))))

  (defn collect-template-arguments [source concrete bindings]
    (if (/= (Array.length source) (Array.length concrete))
      (Result.Error
        (BackendError.init @"template type constructor arity mismatch"))
      (let-do [result (the
                 (Result (Array TemplateTypeBinding) BackendError)
                 (Result.Success (Array.copy bindings)))
               n (Array.length source)]
        (for [i 0 n]
          (match-ref &result
            (Result.Success current)
              (set! result
                    (collect-template-bindings (Box.peek (Array.unsafe-nth source
                                                                           i))
                                               (Box.peek (Array.unsafe-nth concrete
                                                                           i))
                                               current))
            (Result.Error _) ()))
        result)))

  (defn collect-template-bindings [source concrete bindings]
    (match-ref source
      (CoreType.Variable name) (bind-template-variable bindings name concrete)
      (CoreType.Integer)
        (match-ref concrete
          (MonoType.Integer) (Result.Success (Array.copy bindings))
          _ (Result.Error (BackendError.init @"template expected Int")))
      (CoreType.String)
        (match-ref concrete
          (MonoType.String) (Result.Success (Array.copy bindings))
          _ (Result.Error (BackendError.init @"template expected String")))
      (CoreType.Boolean)
        (match-ref concrete
          (MonoType.Boolean) (Result.Success (Array.copy bindings))
          _ (Result.Error (BackendError.init @"template expected Bool")))
      (CoreType.Unit)
        (match-ref concrete
          (MonoType.Unit) (Result.Success (Array.copy bindings))
          _ (Result.Error (BackendError.init @"template expected Unit")))
      (CoreType.Named source-name source-arguments)
        (match-ref concrete
          (MonoType.Named concrete-name concrete-arguments)
            (if (= source-name concrete-name)
              (collect-template-arguments source-arguments
                                          concrete-arguments
                                          bindings)
              (Result.Error
                (BackendError.init
                  @"template named type does not match specialization")))
          _ (Result.Error (BackendError.init @"template expected a named type")))
      (CoreType.Reference source-inner _)
        (match-ref concrete
          (MonoType.Reference concrete-inner _)
            (collect-template-bindings (Box.peek source-inner)
                                       (Box.peek concrete-inner)
                                       bindings)
          _
            (Result.Error
              (BackendError.init @"template expected a reference type")))
      (CoreType.Function source-arguments source-result)
        (match-ref concrete
          (MonoType.Function concrete-arguments concrete-result)
            (match (collect-template-arguments source-arguments
                                               concrete-arguments
                                               bindings)
              (Result.Success argument-bindings)
                (collect-template-bindings (Box.peek source-result)
                                           (Box.peek concrete-result)
                                           &argument-bindings)
              (Result.Error error) (Result.Error error))
          _
            (Result.Error
              (BackendError.init @"template expected a function type")))))

  (private lookup-layout-variable)
  (hidden lookup-layout-variable)
  (defn lookup-layout-variable [bindings name]
    (let-do [result (the (Result MonoType String)
                         (Result.Error
                           @"nominal layout variable has no concrete binding"))
             n (Array.length bindings)]
      (for [i 0 n]
        (let [binding (Array.unsafe-nth bindings i)]
          (when (= (TemplateTypeBinding.name binding) name)
            (set! result
                  (Result.Success
                    (MonoType.copy (Box.peek (TemplateTypeBinding.type binding))))))))
      result))

  (defn concretize-core-arguments [bindings arguments]
    (match (CoreInstantiation.arguments-with arguments
                                             bindings
                                             &lookup-layout-variable)
      (Result.Success concrete) (Result.Success concrete)
      (Result.Error error) (Result.Error (BackendError.init error))))

  (defn concretize-core-type [bindings type]
    (match (CoreInstantiation.type-with type bindings &lookup-layout-variable)
      (Result.Success concrete) (Result.Success concrete)
      (Result.Error error) (Result.Error (BackendError.init error))))

  (defn render-core-type [bindings type]
    (match (concretize-core-type bindings type)
      (Result.Success concrete) (render-type &concrete)
      (Result.Error error) (Result.Error error))))

;; expressions, declarations and translation units are rendered in the files
;; loaded here
(load "carp-c-expressions.carp")
(load "carp-c-declarations.carp")
(load "carp-c-translation-unit.carp")

(defmodule CBackend
  (doc concrete-type "returns the C type of the declared field type `type`,
which has no type variables.")
  (defn concrete-type [type] (concretize-core-type &[] type))

  (doc constructor-fields "returns the field types of `constructor` for the
concrete type `type`.")
  (defn constructor-fields [constructor type]
    (match (collect-template-bindings
        (Box.peek (CoreConstructorDeclaration.result constructor))
        type
        &[])
      (Result.Error error) (Result.Error error)
      (Result.Success bindings)
        (concretize-core-arguments &bindings
                                   (CoreConstructorDeclaration.arguments constructor)))))
