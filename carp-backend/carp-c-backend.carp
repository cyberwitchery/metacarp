;; C rendering for the backend model defined by carp-backend.carp. This file is
;; loaded by that public facade after BackendLower has been defined.

;; binder ids granted their plain Carp name as C identifier in the function
;; being rendered (first binder of each eligible name wins; the rest keep the
;; mangled form). Plain names let `Unsafe.C.asm` macros reference locals.
(def *plain-local-ids* (the (Array Int) []))

;; the C symbol whose declaration is currently being rendered; diagnostic
;; context only (set per declaration, read by render guards).
(def *render-context* (the (Array String) []))
(def *array-data-cache-refs* (the (Array CoreRef) []))
(def *array-data-cache-symbols* (the (Array String) []))

(defn cached-array-data-symbol-for-ref [reference]
  (let-do [result (the (Maybe String) (Maybe.Nothing))
           n (Array.length &*array-data-cache-refs*)]
    (for [i 0 n]
      (when (CoreIR.same-ref?
          (Array.unsafe-nth &*array-data-cache-refs* i)
          reference)
        (set! result
              (Maybe.Just
                (String.copy (Array.unsafe-nth &*array-data-cache-symbols* i))))))
    result))

(defn cached-array-data-symbol [expression]
  (match-ref expression
    (SpecializedExpr.Reference _ _ reference)
      (cached-array-data-symbol-for-ref reference)
    (SpecializedExpr.Annotation _ _ inner _)
      (cached-array-data-symbol (Box.peek inner))
    _ (the (Maybe String) (Maybe.Nothing))))

