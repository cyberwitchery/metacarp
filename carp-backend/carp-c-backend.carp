;; C rendering for the backend model defined by carp-backend.carp. This file is
;; loaded by that public facade after BackendLower has been defined.

;; binder ids granted their plain Carp name as C identifier in the function
;; being rendered (first binder of each eligible name wins; the rest keep the
;; mangled form). Plain names let `Unsafe.C.asm` macros reference locals.
(def *plain-local-ids* (the (Array Int) []))

;; Where the Carp behind the C is, for a build that wants to be debugged. Both
;; arrays are indexed by expression ID, which a provenanced resolve hands out
;; from a monotonic allocator, so a lookup is an index rather than a search.
;; Empty unless a caller installed a map, and then nothing here emits anything.
(def *line-node-files* (the (Array String) []))
(def *line-node-lines* (the (Array Int) []))
(def *emit-line-directives* false)
;; the place the last directive claimed, so a line is not restated before every
;; statement that shares it
(def *line-last-file* @"")
(def *line-last-line* -1)

(defmodule LineMap
  (doc reset! "forgets the source map, and stops emitting line directives.")
  (defn reset! []
    (do
      (set! *line-node-files* [])
      (set! *line-node-lines* [])
      (set! *emit-line-directives* false)
      (set! *line-last-file* @"")
      (set! *line-last-line* -1)))

  (doc install! "takes a map of expression ID to the file and line it was
written at, and turns on the directives that carry it into the generated C.")
  (defn install! [files lines]
    (do
      (set! *line-node-files* (Array.copy files))
      (set! *line-node-lines* (Array.copy lines))
      (set! *emit-line-directives* true)
      (set! *line-last-file* @"")
      (set! *line-last-line* -1)))

  (doc line-of "the line an expression was written on, or -1 when the map has
nothing for it. Code a phase generated was written nowhere, and says so rather
than borrowing a line from whatever it was derived from.")
  (defn line-of [id]
    (if (and (Int.>= id 0) (Int.< id (Array.length &*line-node-lines*)))
      @(Array.unsafe-nth &*line-node-lines* id)
      -1))

  (doc reset-mark "the text a boundary is marked with, and what a later pass
looks for. It is a comment so a translation unit carrying one still compiles
even if nothing resolves it.")
  (defn reset-mark [] @"/*carp-line-reset*/")

  (doc mark-reset! "marks a place that belongs to the generated C rather than
to any Carp: the top of a function, where the previous function's last line
would otherwise be inherited by whatever this one turns out to be.

Rendering cannot write the directive itself. A directive has to name the line
it stands on, and the line is only known once the whole unit has been built —
so this leaves a mark, and `Carp.resolve-line-resets` turns it into a
directive once there is an output to count lines in.")
  (defn mark-reset! [buffer]
    (when-do *emit-line-directives* (StringBuf.append-str buffer "
") (StringBuf.append-str buffer &(reset-mark)) (StringBuf.append-str buffer "
") (set! *line-last-line* -1) (set! *line-last-file* @"")))

  (doc file-of "the file an expression was written in.")
  (defn file-of [id]
    (if (and (Int.>= id 0) (Int.< id (Array.length &*line-node-files*)))
      (String.copy (Array.unsafe-nth &*line-node-files* id))
      @"")))

;; the C symbol whose declaration is currently being rendered; diagnostic
;; context only (set per declaration, read by render guards).
(def *render-context* (the (Array String) []))
(def *array-data-cache-refs* (the (Array CoreRef) []))
(def *array-data-cache-symbols* (the (Array String) []))

(defn cached-array-data-symbol-for-ref [reference]
  (let-do [result (the (Maybe String) (Maybe.Nothing))
           n (Array.length &*array-data-cache-refs*)]
    (for [i 0 n]
      (when (CoreIR.same-ref?
          (Array.unsafe-nth &*array-data-cache-refs* i)
          reference)
        (set! result
              (Maybe.Just
                (String.copy (Array.unsafe-nth &*array-data-cache-symbols* i))))))
    result))

(defn cached-array-data-symbol [expression]
  (match-ref expression
    (SpecializedExpr.Reference _ _ reference)
      (cached-array-data-symbol-for-ref reference)
    (SpecializedExpr.Annotation _ _ inner _)
      (cached-array-data-symbol (Box.peek inner))
    _ (the (Maybe String) (Maybe.Nothing))))

(defn unit-type? [type] (match-ref type (MonoType.Unit) true _ false))

