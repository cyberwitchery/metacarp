  (defn sanitize [value] (CAbi.identifier value))

  (defn valid-system-include? [path]
    (let-do [valid (Int.> (String.length path) 0)
             n (String.length path)]
      (for [i 0 n]
        (let [codepoint (Char.to-int (String.char-at path i))]
          (when (or (Int.= codepoint 0)
                    (or (Int.= codepoint 10)
                        (or (Int.= codepoint 13)
                            (or (Int.= codepoint 34)
                                (or (Int.= codepoint 60) (Int.= codepoint 62))))))
            (set! valid false))))
      valid))

  (sig string-listed? (Fn [(Ref (Array String)) (Ref String)] Bool))
  (defn string-listed? [values target]
    (let-do [found false
             n (Array.length values)]
      (for [i 0 n]
        (when (= (Array.unsafe-nth values i) target) (set! found true)))
      found))

  (sig append-system-include!
       (Fn
         [(Ref StringBuf) (Ref (Array String)) (Ref String)]
         (Result Unit BackendError)))
  (defn append-system-include! [buffer includes path]
    (cond
      ;; entries starting with `#` (from `Unsafe.preproc`), `typedef ` (from
      ;; `register-type` C representations), or `//` (generated registered-type
      ;; accessors) are verbatim preamble lines; they are ordered and may
      ;; legitimately repeat, so they skip deduplication.
      (or (String.starts-with? path "#")
          (or (String.starts-with? path "typedef ")
              (String.starts-with? path "//")))
      (do (StringBuf.append-str buffer path) (StringBuf.append-str buffer "
") (Result.Success ()))
      (string-listed? includes path)
      (Result.Success ())
      (valid-system-include? path)
      (do
        (StringBuf.append-str buffer "#include <")
        (StringBuf.append-str buffer path)
        (StringBuf.append-str buffer ">
")
        (Array.push-back! includes (String.copy path))
        (Result.Success ()))
      (Result.Error
        (BackendError.init
          (String.concat &[@"invalid system include path: " (String.copy path)])))))

  (doc system-includes "renders the baseline C headers and ordered,
deduplicated source-requested system includes.")
  (defn system-includes [module]
    (let-do [buffer (StringBuf.create)
             seen (the (Array String) [])
             result (the (Result Unit BackendError) (Result.Success ()))
             defaults [@"stdbool.h"
                       @"stddef.h"
                       @"stdint.h"
                       @"stdio.h"
                       @"stdlib.h"
                       @"core.h"
                       @"carp_memory.h"]
             default-count (Array.length &defaults)]
      (for [i 0 default-count]
        (match-ref &result
          (Result.Success _)
            (set! result
                  (append-system-include! &buffer
                                          &seen
                                          (Array.unsafe-nth &defaults i)))
          (Result.Error _) ()))
      (let [requested (BackendModule.system-includes module)
            requested-count (Array.length requested)]
        (for [i 0 requested-count]
          (match-ref &result
            (Result.Success _)
              (set! result
                    (append-system-include! &buffer
                                            &seen
                                            (Array.unsafe-nth requested i)))
            (Result.Error _) ())))
      (match result
        (Result.Success _) (Result.Success (StringBuf.to-string &buffer))
        (Result.Error error) (Result.Error error))))

  (defn render-type [type]
    (match (CAbi.render-type type)
      (Result.Success rendered) (Result.Success rendered)
      (Result.Error error)
        (Result.Error (BackendError.init @(CAbiError.message &error)))))

  (defn plain-local? [id]
    (let-do [found false
             n (Array.length &*plain-local-ids*)]
      (for [i 0 n]
        (when (Int.= @(Array.unsafe-nth &*plain-local-ids* i) id)
          (set! found true)))
      found))

  (defn local-symbol [reference]
    (let [name (CAbi.component (CoreRef.name reference))
          id (CAbi.component &(Int.str @(CoreRef.id reference)))]
      (if (plain-local? @(CoreRef.id reference))
        name
        (String.concat &[@"L" (Int.str (String.length &name)) @"_" name @"_" id]))))

  (defn specialized-type [expression] (Specialize.expression-type expression))

  (defn bind-template-variable [bindings name concrete]
    (let-do [found false
             matches true
             n (Array.length bindings)]
      (for [i 0 n]
        (let [binding (Array.unsafe-nth bindings i)]
          (when-do (= (TemplateTypeBinding.name binding) name)
            (set! found true)
            (unless-do (Type.same-representation?
                (Box.peek (TemplateTypeBinding.type binding))
                concrete)
              (set! matches false)))))
      (if found
        (if matches
          (Result.Success (Array.copy bindings))
          (Result.Error
            (BackendError.init
              (String.concat
                &[@"template variable "
                  (String.copy name)
                  @" has inconsistent concrete types"]))))
        (Result.Success
          (Array.push-back (Array.copy bindings)
                           (TemplateTypeBinding.init (String.copy name)
                                                     (Box.init (MonoType.copy concrete))))))))

  (defn collect-template-arguments [source concrete bindings]
    (if (/= (Array.length source) (Array.length concrete))
      (Result.Error
        (BackendError.init @"template type constructor arity mismatch"))
      (let-do [result (the
                 (Result (Array TemplateTypeBinding) BackendError)
                 (Result.Success (Array.copy bindings)))
               n (Array.length source)]
        (for [i 0 n]
          (match-ref &result
            (Result.Success current)
              (set! result
                    (collect-template-bindings (Box.peek (Array.unsafe-nth source
                                                                           i))
                                               (Box.peek (Array.unsafe-nth concrete
                                                                           i))
                                               current))
            (Result.Error _) ()))
        result)))

  (defn collect-template-bindings [source concrete bindings]
    (match-ref source
      (CoreType.Variable name) (bind-template-variable bindings name concrete)
      (CoreType.Integer)
        (match-ref concrete
          (MonoType.Integer) (Result.Success (Array.copy bindings))
          _ (Result.Error (BackendError.init @"template expected Int")))
      (CoreType.String)
        (match-ref concrete
          (MonoType.String) (Result.Success (Array.copy bindings))
          _ (Result.Error (BackendError.init @"template expected String")))
      (CoreType.Boolean)
        (match-ref concrete
          (MonoType.Boolean) (Result.Success (Array.copy bindings))
          _ (Result.Error (BackendError.init @"template expected Bool")))
      (CoreType.Unit)
        (match-ref concrete
          (MonoType.Unit) (Result.Success (Array.copy bindings))
          _ (Result.Error (BackendError.init @"template expected Unit")))
      (CoreType.Named source-name source-arguments)
        (match-ref concrete
          (MonoType.Named concrete-name concrete-arguments)
            (if (= source-name concrete-name)
              (collect-template-arguments source-arguments
                                          concrete-arguments
                                          bindings)
              (Result.Error
                (BackendError.init
                  @"template named type does not match specialization")))
          _ (Result.Error (BackendError.init @"template expected a named type")))
      (CoreType.Reference source-inner _)
        (match-ref concrete
          (MonoType.Reference concrete-inner _)
            (collect-template-bindings (Box.peek source-inner)
                                       (Box.peek concrete-inner)
                                       bindings)
          _
            (Result.Error
              (BackendError.init @"template expected a reference type")))
      (CoreType.Function source-arguments source-result)
        (match-ref concrete
          (MonoType.Function concrete-arguments concrete-result)
            (match (collect-template-arguments source-arguments
                                               concrete-arguments
                                               bindings)
              (Result.Success argument-bindings)
                (collect-template-bindings (Box.peek source-result)
                                           (Box.peek concrete-result)
                                           &argument-bindings)
              (Result.Error error) (Result.Error error))
          _
            (Result.Error
              (BackendError.init @"template expected a function type")))))

  (defn concretize-core-arguments [bindings arguments]
    (let-do [result (the
               (Result (Array (Box MonoType)) BackendError)
               (Result.Success []))
             n (Array.length arguments)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success concrete)
            (match (concretize-core-type bindings
                                         (Box.peek (Array.unsafe-nth arguments i)))
              (Result.Success argument)
                (set! result
                      (Result.Success
                        (Array.push-back @concrete (Box.init argument))))
              (Result.Error error) (set! result (Result.Error error)))
          (Result.Error _) ()))
      result))

  (defn concretize-core-type [bindings type]
    (match-ref type
      (CoreType.Integer) (Result.Success (Type.integer))
      (CoreType.String) (Result.Success (Type.string))
      (CoreType.Boolean) (Result.Success (Type.boolean))
      (CoreType.Unit) (Result.Success (Type.unit))
      (CoreType.Variable name)
        (let-do [result (the (Result MonoType BackendError)
                             (Result.Error
                               (BackendError.init
                                 @"nominal layout variable has no concrete binding")))
                 n (Array.length bindings)]
          (for [i 0 n]
            (let [binding (Array.unsafe-nth bindings i)]
              (when (= (TemplateTypeBinding.name binding) name)
                (set! result
                      (Result.Success
                        (MonoType.copy
                          (Box.peek (TemplateTypeBinding.type binding))))))))
          result)
      (CoreType.Named name arguments)
        (match (concretize-core-arguments bindings arguments)
          (Result.Success concrete) (Result.Success (Type.named name concrete))
          (Result.Error error) (Result.Error error))
      (CoreType.Reference inner _)
        (match (concretize-core-type bindings (Box.peek inner))
          (Result.Success concrete)
            (Result.Success (Type.reference concrete (MonoLifetime.Static)))
          (Result.Error error) (Result.Error error))
      (CoreType.Function arguments result)
        (match (concretize-core-arguments bindings arguments)
          (Result.Success concrete-arguments)
            (match (concretize-core-type bindings (Box.peek result))
              (Result.Success concrete-result)
                (Result.Success
                  (Type.function concrete-arguments concrete-result))
              (Result.Error error) (Result.Error error))
          (Result.Error error) (Result.Error error))))

  (defn render-core-type [bindings type]
    (match (concretize-core-type bindings type)
      (Result.Success concrete) (render-type &concrete)
      (Result.Error error) (Result.Error error))))

(defn unmanaged-type? [constructors type]
  (if (CAbi.unmanaged-scalar? type)
    true
    (match-ref type
      (MonoType.Named name _)
        (let-do [found false
                 supported true
                 n (Array.length constructors)]
          (for [i 0 n]
            (let [constructor (Array.unsafe-nth constructors i)
                  empty-bindings (the (Array TemplateTypeBinding) [])]
              (match-ref (Box.peek
                  (CoreConstructorDeclaration.result constructor))
                (CoreType.Named candidate _)
                  (when (= candidate name)
                    (match (collect-template-bindings
                        (Box.peek
                          (CoreConstructorDeclaration.result constructor))
                        type
                        &empty-bindings)
                      (Result.Success bindings)
                        (do
                          (set! found true)
                          (let [fields (CoreConstructorDeclaration.arguments constructor)
                                field-count (Array.length fields)]
                            (for [j 0 field-count]
                              (match (concretize-core-type &bindings
                                                           (Box.peek (Array.unsafe-nth fields
                                                                                       j)))
                                (Result.Success field-type)
                                  (unless-do (unmanaged-type? constructors
                                                              &field-type)
                                    (set! supported false))
                                (Result.Error _) (set! supported false)))))
                      (Result.Error _) ()))
                _ ())))
          (and found supported))
      _ false)))

;; unit-typed arguments are elided from the call, matching the elided unit
;; parameters (`Unit__EQ_()`); trivial unit expressions vanish, side-effecting
;; ones become prelude statements the caller runs before the call. The result
;; pair is (prelude statements, argument list).
(defn render-call-arguments [constructors arguments]
  (let-do [result (the
             (Result (Pair String String) BackendError)
             (Result.Success (Pair.init @"" @"")))
           emitted 0
           n (Array.length arguments)]
    (for [i 0 n]
      (match-ref &result
        (Result.Success rendered-pair)
          (let [argument-expression (Box.peek (Array.unsafe-nth arguments i))]
            (if (unit-type? &(specialized-type argument-expression))
              (match-ref argument-expression
                (SpecializedExpr.UnitLit _ _) ()
                (SpecializedExpr.Reference _ _ _) ()
                _
                  (match (render-value-expression constructors
                                                  argument-expression)
                    (Result.Success statement)
                      (set! result
                            (Result.Success
                              (Pair.init
                                (String.concat
                                  &[(String.copy (Pair.a rendered-pair))
                                    statement
                                    @"; "])
                                (String.copy (Pair.b rendered-pair)))))
                    (Result.Error error) (set! result (Result.Error error))))
              (match (render-value-expression constructors argument-expression)
                (Result.Success argument)
                  (do
                    (set! result
                          (Result.Success
                            (Pair.init (String.copy (Pair.a rendered-pair))
                                       (String.concat
                                         &[(String.copy (Pair.b rendered-pair))
                                           (if (Int.> emitted 0) @", " @"")
                                           argument]))))
                    (set! emitted (Int.inc emitted)))
                (Result.Error error) (set! result (Result.Error error)))))
        (Result.Error _) ()))
    result))

(private managed-renderable?)
(hidden managed-renderable?)
(doc managed-renderable? "reports whether a managed-typed expression is safe to
render directly as a C value. A local reference renders as its C variable (an
ownership move, sound because the ownership phase has verified the use is
linear); a global call renders as the call that produces the owned value. Other
managed forms still require dedicated lowering.")
(defn escape-c-string [value]
  (let-do [buffer (StringBuf.create)
           n (String.length value)]
    (for [i 0 n]
      (let [byte (String.char-at value i)]
        (cond
          (= byte (Char.from-int 92)) (StringBuf.append-str &buffer "\\\\")
          (= byte (Char.from-int 34)) (StringBuf.append-str &buffer "\\\"")
          (= byte (Char.from-int 10)) (StringBuf.append-str &buffer "\\n")
          (= byte (Char.from-int 9)) (StringBuf.append-str &buffer "\\t")
          (= byte (Char.from-int 13)) (StringBuf.append-str &buffer "\\r")
          (StringBuf.append-char &buffer byte))))
    (StringBuf.to-string &buffer)))

(defn managed-renderable? [expression]
  (match-ref expression
    (SpecializedExpr.Reference _ _ reference)
    (not @(CoreRef.global reference))
    (SpecializedExpr.GlobalCall _ _ _ _ _ _)
    true
    (SpecializedExpr.StringLit _ _ _)
    true
    (SpecializedExpr.PatternLit _ _ _)
    true
    (SpecializedExpr.GlobalValue _ _ _ _ _ _)
    true
    (SpecializedExpr.Call _ _ _ _)
    true
    (SpecializedExpr.StaticArrayLit _ _ _)
    true
    ;; statement-shaped forms lower to a GNU statement expression via
    ;; `render-statement-value`, which drives the ownership-aware `append-result!`
    ;; and so is sound for managed results too.
    (SpecializedExpr.Do _ _ _)
    true
    (SpecializedExpr.Let _ _ _ _ _)
    true
    (SpecializedExpr.While _ _ _ _)
    true
    (SpecializedExpr.Match _ _ _ _ _)
    true
    (SpecializedExpr.If _ _ _ _ _)
    true
    (SpecializedExpr.Annotation _ _ inner _)
    (managed-renderable? (Box.peek inner))
    _
    false))

;; the full-precision formatters print a bare mantissa (e.g. "2" or "3.14e5");
;; ensure a decimal point so clang reads it as floating point, and add the `f`
;; suffix for `float` literals.
(defn has-dot? [s]
  (let-do [found false]
    (for [i 0 (String.length s)]
      (let [c (String.char-at s i)]
        (when (or (= c \.) (or (= c \e) (= c \E))) (set! found true))))
    found))

(defn c-float-literal [s]
  (if (has-dot? s)
    (String.concat &[(String.copy s) @"f"])
    (String.concat &[(String.copy s) @".0f"])))

(defn c-double-literal [s]
  (if (has-dot? s) (String.copy s) (String.concat &[(String.copy s) @".0"])))

(defn literal-int [expression]
  (match-ref expression
    (SpecializedExpr.IntLit _ _ value) @value
    (SpecializedExpr.Annotation _ _ inner _) (literal-int (Box.peek inner))
    _ -1))

(defn render-value-expression [constructors expression]
  (let [type (specialized-type expression)]
    (if (and
        (not (unmanaged-type? constructors &type))
        (not (managed-renderable? expression)))
      (Result.Error
        (BackendError.init
          (String.concat
            &[@"expression requires ownership or lifetime lowering: "
              (expression-form-name expression)
              @" of type "
              (Type.name &type)
              @" (expr "
              (Int.str (Specialize.expression-id expression))
              @" in "
              (if (Int.> (Array.length &*render-context*) 0)
                (String.copy (Array.unsafe-nth &*render-context* 0))
                @"<unknown>")
              @")"])))
      (match-ref expression
        (SpecializedExpr.IntLit _ _ value)
        (Result.Success (Int.str @value))
        (SpecializedExpr.ByteLit _ _ value)
        (Result.Success (Int.str (Byte.to-int @value)))
        (SpecializedExpr.LongLit _ _ value)
        (Result.Success (String.append &(Long.str @value) "LL"))
        (SpecializedExpr.FloatLit _ _ value)
        (Result.Success (c-float-literal &(full-float-string @value)))
        (SpecializedExpr.DoubleLit _ _ value)
        (Result.Success (c-double-literal &(full-double-string @value)))
        (SpecializedExpr.CharLit _ _ value)
        (Result.Success (Int.str (Char.to-int @value)))
        (SpecializedExpr.BoolLit _ _ value)
        (Result.Success (if @value (String.copy "true") (String.copy "false")))
        ;; a string literal has type `(Ref String)`; `String` is `char*`, so the
        ;; value is a `String*` to a static `char*` holding the literal (the
        ;; reference emits `static String v = ...; &v`). A statement expression
        ;; with a static local gives the same static storage inline, so the
        ;; borrow stays valid even when it escapes (e.g. a returned constant).
        (SpecializedExpr.StringLit _ _ value)
        (Result.Success
          (String.concat
            &[@"({ static String _carp_strlit = \""
              (escape-c-string value)
              @"\"; &_carp_strlit; })"]))
        ;; a pattern literal works exactly like a string literal: `Pattern` is
        ;; also `char*`, so the value is a borrowed pointer to static storage.
        (SpecializedExpr.PatternLit _ _ value)
        (Result.Success
          (String.concat
            &[@"({ static Pattern _carp_patlit = \""
              (escape-c-string value)
              @"\"; &_carp_patlit; })"]))
        (SpecializedExpr.StaticArrayLit _ array-type elements)
        (render-static-array-literal constructors (Box.peek array-type) elements)
        (SpecializedExpr.UnitLit _ _)
        (Result.Success (String.copy "((void)0)"))
        (SpecializedExpr.Reference _ reference-type reference)
        (cond
          ;; unit-typed bindings have no C storage (their parameters are
          ;; elided); reading one is the unit value.
          (unit-type? (Box.peek reference-type))
          (Result.Success (String.copy "((void)0)"))
          @(CoreRef.global reference)
          ;; a global read reconstructs the definition's C symbol the same way
          ;; specialization mangles it (name + concrete signature).
          (Result.Success
            (sanitize
              &(CAbi.mangle (CoreRef.name reference) (Box.peek reference-type))))
          (Result.Success (local-symbol reference)))
        (SpecializedExpr.GlobalValue _ value-type value-reference _ symbol value)
        (cond
          ;; the `NULL` builtin (id 7) is C's own null literal, not a linkable
          ;; global; every `(Ptr a)` instance renders to the same token.
          (Int.= @(CoreRef.id value-reference) 7)
          (Result.Success (String.copy "NULL"))
          ;; a function-typed `def` global is a C `Lambda` variable already;
          ;; only a lifted function symbol needs wrapping in a closure struct.
          (and (not @value)
               (match-ref (Box.peek value-type)
                 (MonoType.Function _ _) true
                 _ false))
          (Result.Success
            (String.concat
              &[@"((Lambda){ .callback = (void*)"
                (sanitize symbol)
                @", .env = NULL, .delete = NULL, .copy = NULL })"]))
          (Result.Success (sanitize symbol)))
        (SpecializedExpr.GlobalCall _ result-type reference _ symbol arguments)
        (cond
          ;; a capturing lambda's closure-construction site: build a `Lambda`
          ;; struct whose environment holds the captured values. The environment
          ;; is always heap-allocated, like the reference (Emit.hs CARP_MALLOCs
          ;; whenever a lambda captures) — a stack env dangles as soon as the
          ;; Lambda outlives the constructing frame, and escape is not visible
          ;; here (the closure may be bound to a local before being returned).
          (String.starts-with? symbol "_carp_closure_")
          (render-closure-construction-heap constructors symbol arguments)
          ;; A loop may materialize a stable typed view of a borrowed array's
          ;; backing allocation. Index through that local when available; the
          ;; ordinary direct lowering remains the fallback outside such a
          ;; proven non-reallocating loop.
          (and
            (or (Int.= @(CoreRef.id reference) 12)
                (Int.= @(CoreRef.id reference) 13))
            (and (Int.= (Array.length arguments) 2)
                 (match (cached-array-data-symbol
                     (Box.peek (Array.unsafe-nth arguments 0)))
                   (Maybe.Just _) true
                   (Maybe.Nothing) false)))
          (match (cached-array-data-symbol
              (Box.peek (Array.unsafe-nth arguments 0)))
            (Maybe.Just data-symbol)
              (match (render-value-expression constructors
                                              (Box.peek (Array.unsafe-nth arguments
                                                                          1)))
                (Result.Success index)
                  (Result.Success
                    (String.concat &[@"(&" data-symbol @"[" index @"])"]))
                (Result.Error error) (Result.Error error))
            (Maybe.Nothing)
              (Result.Error
                (BackendError.init @"missing array data cache during rendering")))
          ;; Outside a proven stable loop, load the current backing pointer for
          ;; every access so a preceding mutation or reallocation is observed.
          (and
            (or (Int.= @(CoreRef.id reference) 12)
                (Int.= @(CoreRef.id reference) 13))
            (Int.= (Array.length arguments) 2))
          (match (render-type &(deref-type (Box.peek result-type)))
            (Result.Success element)
              (match (render-value-expression constructors
                                              (Box.peek (Array.unsafe-nth arguments
                                                                          0)))
                (Result.Success container)
                  (match (render-value-expression constructors
                                                  (Box.peek (Array.unsafe-nth arguments
                                                                              1)))
                    (Result.Success index)
                      (Result.Success
                        (String.concat
                          &[@"(&(("
                            element
                            @"*)(*"
                            container
                            @").data)["
                            index
                            @"])"]))
                    (Result.Error error) (Result.Error error))
                (Result.Error error) (Result.Error error))
            (Result.Error error) (Result.Error error))
          ;; `unsafe-raw` (id 65) exposes a borrowed heap array's backing allocation as
          ;; a raw pointer. It borrows the array storage; no ownership transfer
          ;; or cleanup is attached to the returned `Ptr`.
          (and (Int.= @(CoreRef.id reference) 65)
               (Int.= (Array.length arguments) 1))
          (match (render-type (Box.peek result-type))
            (Result.Success pointer-type)
              (match (render-value-expression constructors
                                              (Box.peek (Array.unsafe-nth arguments
                                                                          0)))
                (Result.Success container)
                  (Result.Success
                    (String.concat
                      &[@"((" pointer-type @")(*" container @").data)"]))
                (Result.Error error) (Result.Error error))
            (Result.Error error) (Result.Error error))
          ;; `Array.raw` (id 70) exposes an owned heap array value's backing
          ;; allocation as a raw pointer.
          (and (Int.= @(CoreRef.id reference) 70)
               (Int.= (Array.length arguments) 1))
          (match (render-type (Box.peek result-type))
            (Result.Success pointer-type)
              (match (render-value-expression constructors
                                              (Box.peek (Array.unsafe-nth arguments
                                                                          0)))
                (Result.Success container)
                  (Result.Success
                    (String.concat
                      &[@"((" pointer-type @")(" container @").data)"]))
                (Result.Error error) (Result.Error error))
            (Result.Error error) (Result.Error error))
          ;; Build-configuration commands are compile-time side effects in the
          ;; reference compiler. The self compiler's C emission ignores them.
          (and
            (or (Int.= @(CoreRef.id reference) 73)
                (or (Int.= @(CoreRef.id reference) 74)
                    (Int.= @(CoreRef.id reference) 75)))
            (Int.= (Array.length arguments) 1))
          (Result.Success (String.copy "((void)0)"))
          ;; the array-free sentinel frees the heap `data` of an `(Array a)`;
          ;; Array is a builtin with no runtime deleter function.
          (and (String.= symbol "__carp_array_free")
               (Int.= (Array.length arguments) 1))
          (match (render-value-expression constructors
                                          (Box.peek (Array.unsafe-nth arguments
                                                                      0)))
            (Result.Success operand)
              (Result.Success
                (String.concat
                  &[@"if (("
                    (String.copy &operand)
                    @").data) CARP_FREE(("
                    operand
                    @").data)"]))
            (Result.Error error) (Result.Error error))
          ;; the `ref` (id 5) and `deref` (id 6) intrinsics are inline C address-of
          ;; and dereference operators, not calls to runtime functions.
          (and (Int.= @(CoreRef.id reference) 5)
               (Int.= (Array.length arguments) 1))
          (match (render-value-expression constructors
                                          (Box.peek (Array.unsafe-nth arguments
                                                                      0)))
            (Result.Success operand)
              (Result.Success (String.concat &[@"(&" operand @")"]))
            (Result.Error error) (Result.Error error))
          (and (Int.= @(CoreRef.id reference) 6)
               (Int.= (Array.length arguments) 1))
          (match (render-value-expression constructors
                                          (Box.peek (Array.unsafe-nth arguments
                                                                      0)))
            (Result.Success operand)
              (Result.Success (String.concat &[@"(*" operand @")"]))
            (Result.Error error) (Result.Error error))
          ;; `Array.length`/`StaticArray.length` (ids 9/10) read the `.len`
          ;; field behind the reference they are passed; no runtime function
          ;; exists.
          (and
            (or (Int.= @(CoreRef.id reference) 9)
                (Int.= @(CoreRef.id reference) 10))
            (Int.= (Array.length arguments) 1))
          (match (render-value-expression constructors
                                          (Box.peek (Array.unsafe-nth arguments
                                                                      0)))
            (Result.Success operand)
              (Result.Success (String.concat &[@"(*" operand @").len"]))
            (Result.Error error) (Result.Error error))
          ;; the generic `length` (id 8) lowers by argument type: char*-backed
          ;; values (String, Pattern) via strlen, collections via `.len`.
          (and (Int.= @(CoreRef.id reference) 8)
               (Int.= (Array.length arguments) 1))
          (match (render-value-expression constructors
                                          (Box.peek (Array.unsafe-nth arguments
                                                                      0)))
            (Result.Success operand)
              (match-ref &(deref-type
                  &(specialized-type (Box.peek (Array.unsafe-nth arguments 0))))
                (MonoType.String)
                  (Result.Success
                    (String.concat &[@"((int)strlen(*" operand @"))"]))
                (MonoType.Named length-type-name _)
                  (if (String.= length-type-name "Pattern")
                    (Result.Success
                      (String.concat &[@"((int)strlen(*" operand @"))"]))
                    (Result.Success (String.concat &[@"(*" operand @").len"])))
                _ (Result.Success (String.concat &[@"(*" operand @").len"])))
            (Result.Error error) (Result.Error error))
          ;; `get-tag` (id 48) reads the `.tag` field of a sum type. A
          ;; single-constructor nominal has no stored tag; its logical tag is
          ;; the constant zero.
          (and (Int.= @(CoreRef.id reference) 48)
               (Int.= (Array.length arguments) 1))
          (match (render-value-expression constructors
                                          (Box.peek (Array.unsafe-nth arguments
                                                                      0)))
            (Result.Success operand)
              (match-ref &(deref-type
                  &(specialized-type (Box.peek (Array.unsafe-nth arguments 0))))
                (MonoType.Named name _)
                  (if (single-constructor-name? constructors name)
                    (Result.Success (String.copy "0"))
                    (Result.Success (String.concat &[@"(*" operand @").tag"])))
                _ (Result.Success (String.concat &[@"(*" operand @").tag"])))
            (Result.Error error) (Result.Error error))
          ;; `field-set!` (id 49) writes a struct field in place behind a ref:
          ;; args are [self, IntLit tag, IntLit member-index, value].
          (and (Int.= @(CoreRef.id reference) 49)
               (Int.= (Array.length arguments) 4))
          (match (render-value-expression constructors
                                          (Box.peek (Array.unsafe-nth arguments
                                                                      0)))
            (Result.Success self-c)
              (match (render-value-expression constructors
                                              (Box.peek (Array.unsafe-nth arguments
                                                                          3)))
                (Result.Success value-c)
                  (Result.Success
                    (String.concat
                      &[@"((*"
                        self-c
                        @").data.variant_"
                        (Int.str
                          (literal-int (Box.peek (Array.unsafe-nth arguments 1))))
                        @".member_"
                        (Int.str
                          (literal-int (Box.peek (Array.unsafe-nth arguments 2))))
                        @" = "
                        value-c
                        @")"]))
                (Result.Error error) (Result.Error error))
            (Result.Error error) (Result.Error error))
          ;; `allocate`/`Array.allocate` (ids 14/15) build an uninitialized heap
          ;; array of the requested length; the element type comes from the
          ;; `(Array a)` result type.
          (and
            (or (Int.= @(CoreRef.id reference) 14)
                (Int.= @(CoreRef.id reference) 15))
            (Int.= (Array.length arguments) 1))
          (match-ref (Box.peek result-type)
            (MonoType.Named _ type-arguments)
              (match (render-type (Box.peek (Array.unsafe-nth type-arguments 0)))
                (Result.Success element)
                  (match (render-value-expression constructors
                                                  (Box.peek (Array.unsafe-nth arguments
                                                                              0)))
                    (Result.Success count)
                      (Result.Success
                        (String.concat
                          &[@"((Array){ .len = "
                            (String.copy &count)
                            @", .capacity = "
                            (String.copy &count)
                            @", .data = (("
                            (String.copy &count)
                            @") == 0 ? NULL : CARP_MALLOC(sizeof("
                            element
                            @") * ("
                            (String.copy &count)
                            @"))) })"]))
                    (Result.Error error) (Result.Error error))
                (Result.Error error) (Result.Error error))
            _
              (Result.Error
                (BackendError.init @"allocate result is not an array type")))
          ;; `aset-uninitialized!`/array and static-array indexed setters write a
          ;; value into a slot in place; the element type is the value's type.
          (and
            (or (Int.= @(CoreRef.id reference) 16)
                (or (Int.= @(CoreRef.id reference) 17)
                    (or (Int.= @(CoreRef.id reference) 18)
                        (Int.= @(CoreRef.id reference) 21))))
            (Int.= (Array.length arguments) 3))
          (match (render-type
              &(specialized-type (Box.peek (Array.unsafe-nth arguments 2))))
            (Result.Success element)
              (match (render-value-expression constructors
                                              (Box.peek (Array.unsafe-nth arguments
                                                                          0)))
                (Result.Success container)
                  (match (render-value-expression constructors
                                                  (Box.peek (Array.unsafe-nth arguments
                                                                              1)))
                    (Result.Success index)
                      (match (render-value-expression constructors
                                                      (Box.peek (Array.unsafe-nth arguments
                                                                                  2)))
                        (Result.Success value)
                          (Result.Success
                            (String.concat
                              &[@"(("
                                element
                                @"*)(*"
                                container
                                @").data)["
                                index
                                @"] = "
                                value]))
                        (Result.Error error) (Result.Error error))
                    (Result.Error error) (Result.Error error))
                (Result.Error error) (Result.Error error))
            (Result.Error error) (Result.Error error))
          (match (render-call-arguments constructors arguments)
            (Result.Success rendered-arguments)
              (if (String.empty? (Pair.a &rendered-arguments))
                (Result.Success
                  (String.concat
                    &[(sanitize symbol)
                      @"("
                      (String.copy (Pair.b &rendered-arguments))
                      @")"]))
                ;; elided unit arguments still run for their effects, in order,
                ;; before the call.
                (Result.Success
                  (String.concat
                    &[@"({ "
                      (String.copy (Pair.a &rendered-arguments))
                      (sanitize symbol)
                      @"("
                      (String.copy (Pair.b &rendered-arguments))
                      @"); })"])))
            (Result.Error error) (Result.Error error)))
        (SpecializedExpr.If _ _ condition then-branch else-branch)
        ;; a managed `if` cannot be a C ternary (a branch may need cleanup
        ;; statements); lower it to a statement expression. Unmanaged ifs stay
        ;; ternaries.
        (if (not (unmanaged-type? constructors &(specialized-type expression)))
          (render-statement-value constructors expression)
          (match (render-value-expression constructors (Box.peek condition))
            (Result.Success rendered-condition)
              (match (render-value-expression constructors
                                              (Box.peek then-branch))
                (Result.Success rendered-then)
                  (match (render-value-expression constructors
                                                  (Box.peek else-branch))
                    (Result.Success rendered-else)
                      (Result.Success
                        (String.concat
                          &[@"("
                            rendered-condition
                            @" ? "
                            rendered-then
                            @" : "
                            rendered-else
                            @")"]))
                    (Result.Error error) (Result.Error error))
                (Result.Error error) (Result.Error error))
            (Result.Error error) (Result.Error error)))
        (SpecializedExpr.Annotation _ _ inner _)
        (render-value-expression constructors (Box.peek inner))
        (SpecializedExpr.Call _ _ callee arguments)
        (render-closure-call constructors (Box.peek callee) arguments)
        ;; statement-shaped forms in value position (e.g. a cleanup-wrapped scope
        ;; result) lower to a GNU statement expression via `append-result!`.
        (SpecializedExpr.Do _ _ _)
        (render-statement-value constructors expression)
        (SpecializedExpr.Let _ _ _ _ _)
        (render-statement-value constructors expression)
        (SpecializedExpr.While _ _ _ _)
        (render-statement-value constructors expression)
        (SpecializedExpr.Match _ _ _ _ _)
        (render-statement-value constructors expression)
        ;; a `set!` in value position is a unit-typed assignment expression.
        (SpecializedExpr.Set _ _ set-reference set-value)
        (match (render-value-expression constructors (Box.peek set-value))
          (Result.Success rendered-set-value)
            (let [target (if @(CoreRef.global set-reference)
                    (sanitize
                      &(CAbi.mangle (CoreRef.name set-reference)
                                    &(specialized-type (Box.peek set-value))))
                    (local-symbol set-reference))]
              (Result.Success
                (String.concat
                  &[@"({ " target @" = " rendered-set-value @"; ((void)0); })"])))
          (Result.Error error) (Result.Error error))
        _
        (Result.Error
          (BackendError.init
            (String.concat
              &[@"expression form is not supported in unmanaged bodies: "
                (expression-form-name expression)])))))))

(defn expression-form-name [expression]
  (match-ref expression
    (SpecializedExpr.Set _ _ _ _) (String.copy "set!")
    (SpecializedExpr.Break _ _) (String.copy "break")
    (SpecializedExpr.Lambda _ _ _ _) (String.copy "lambda")
    (SpecializedExpr.PatternLit _ _ _) (String.copy "pattern literal")
    (SpecializedExpr.ArrayLit _ _ _) (String.copy "array literal")
    (SpecializedExpr.StaticArrayLit _ _ _) (String.copy "static array literal")
    (SpecializedExpr.GlobalValue _ _ _ _ _ _) (String.copy "global value")
    (SpecializedExpr.Reference _ _ _) (String.copy "reference")
    _ (String.copy "unknown")))

(defn render-argument-types [argument-types]
  (let-do [rendered (the String (String.copy ""))
           failure (the (Maybe BackendError) (Maybe.Nothing))
           n (Array.length argument-types)]
    (for [i 0 n]
      (match-ref &failure
        (Maybe.Nothing)
          (match (render-type (Box.peek (Array.unsafe-nth argument-types i)))
            (Result.Success piece)
              (do
                (when (Int.> i 0) (set! rendered (String.append &rendered ", ")))
                (set! rendered (String.append &rendered &piece)))
            (Result.Error error) (set! failure (Maybe.Just error)))
        (Maybe.Just _) ()))
    (match-ref &failure
      (Maybe.Just error) (Result.Error @error)
      (Maybe.Nothing) (Result.Success rendered))))

(doc render-closure-call "renders an indirect call through a `Lambda` closure
value: dispatches at runtime on the captured environment, calling
`callback(env, args)` for capturing closures and `callback(args)` otherwise.")
(defn render-closure-call [constructors callee arguments]
  (let [callee-type (specialized-type callee)]
    (match-ref &callee-type
      (MonoType.Function argument-types result-type)
        (match (render-value-expression constructors callee)
          (Result.Success callee-c)
            (match (render-type (Box.peek result-type))
              (Result.Success ret-c)
                (match (render-argument-types argument-types)
                  (Result.Success args-c)
                    (match (render-call-arguments constructors arguments)
                      (Result.Success rendered-values)
                        (let [values-c (String.copy (Pair.b &rendered-values))
                              values-prelude (String.copy (Pair.a &rendered-values))
                              type-comma (if (Int.= 0
                                                    (Array.length argument-types))
                                @""
                                @", ")
                              value-comma (if (String.empty? &values-c)
                                @""
                                @", ")
                              dispose-callee (match-ref callee
                                (SpecializedExpr.GlobalCall _ _ _ _ symbol _)
                                  (String.starts-with? symbol "_carp_closure_")
                                _ false)
                              unit-result (match-ref (Box.peek result-type)
                                (MonoType.Unit) true
                                _ false)]
                          (Result.Success
                            (String.concat
                              &[@"({ "
                                (String.copy &values-prelude)
                                @"Lambda _carp_call = "
                                (String.copy &callee-c)
                                @"; "
                                (if (and dispose-callee (not unit-result))
                                  (String.concat
                                    &[(String.copy &ret-c)
                                      @" _carp_call_result = "])
                                  @"")
                                @"_carp_call.env ? (("
                                (String.copy &ret-c)
                                @"(*)(void*"
                                type-comma
                                (String.copy &args-c)
                                @"))_carp_call.callback)(_carp_call.env"
                                value-comma
                                (String.copy &values-c)
                                @") : (("
                                (String.copy &ret-c)
                                @"(*)("
                                (String.copy &args-c)
                                @"))_carp_call.callback)("
                                (String.copy &values-c)
                                @")"
                                (if dispose-callee
                                  @"; if (_carp_call.delete) { ((void(*)(void*))_carp_call.delete)(_carp_call.env); CARP_FREE(_carp_call.env); } "
                                  @";")
                                (if (and dispose-callee (not unit-result))
                                  @"_carp_call_result; "
                                  @"")
                                @"})"])))
                      (Result.Error error) (Result.Error error))
                  (Result.Error error) (Result.Error error))
              (Result.Error error) (Result.Error error))
          (Result.Error error) (Result.Error error))
      _ (Result.Error (BackendError.init @"call target is not a function type")))))

(doc render-statement-value
  "renders a statement-shaped form (do/let/while/match)
used in value position as a GNU statement expression: the result is assigned to a
temporary whose value the expression yields. The temporary name is fixed and
relies on C block scoping (nested statement expressions shadow it).")
;; the value a statement-shaped form yields is its tail: a `let` evaluates to its
;; body, a `do` to its last element. The top node's own type field can lie (the
;; hoist wrapper stamps a `let` with the hoisted binding's type), so recurse to
;; the tail for the storage type of the `({ ... })` statement expression.
(defn statement-result-type [expression] (tail-expression-type expression))

(defn render-statement-value [constructors expression]
  (let [result-type (statement-result-type expression)]
    (if (match-ref &result-type (MonoType.Unit) true _ false)
      ;; a unit-typed scope has no value to capture: run it for its effects as
      ;; a void statement expression (`void _carp_sv;` would not compile).
      (let-do [buffer (StringBuf.create)
               ignored-open (StringBuf.append-str &buffer "({ ")]
        (match (append-statement! constructors &buffer expression 0)
          (Result.Success _)
            (do
              (StringBuf.append-str &buffer " })")
              (Result.Success (StringBuf.to-string &buffer)))
          (Result.Error error) (Result.Error error)))
      (match (render-type &result-type)
        (Result.Success type-c)
          (let-do [buffer (StringBuf.create)
                   ignored-open (StringBuf.append-str &buffer "({ ")
                   ignored-type (StringBuf.append-str &buffer &type-c)
                   ignored-space (StringBuf.append-char &buffer \space)
                   ignored-name (StringBuf.append-str &buffer "_carp_sv; ")
                   destination (ResultDestination.Assign (String.copy "_carp_sv")
                                                         (Box.init (MonoType.copy &result-type)))]
            (match (append-result! constructors
                                   &buffer
                                   expression
                                   &destination
                                   0)
              (Result.Success _)
                (do
                  (StringBuf.append-str &buffer "_carp_sv; })")
                  (Result.Success (StringBuf.to-string &buffer)))
              (Result.Error error) (Result.Error error)))
        (Result.Error error) (Result.Error error)))))

(defn render-env-fields [constructors arguments]
  (let-do [rendered (the String (String.copy ""))
           failure (the (Maybe BackendError) (Maybe.Nothing))
           n (Array.length arguments)]
    (for [i 0 n]
      (match-ref &failure
        (Maybe.Nothing)
          (match (render-value-expression constructors
                                          (Box.peek (Array.unsafe-nth arguments
                                                                      i)))
            (Result.Success value)
              (do
                (when (Int.> i 0) (set! rendered (String.append &rendered ", ")))
                (set! rendered
                      (String.append &rendered
                                     &(String.concat
                                       &[@".f"
                                         (Int.str i)
                                         @" = "
                                         (String.copy &value)]))))
            (Result.Error error) (set! failure (Maybe.Just error)))
        (Maybe.Just _) ()))
    (match-ref &failure
      (Maybe.Just error) (Result.Error @error)
      (Maybe.Nothing) (Result.Success rendered))))

(defn render-recursive-env-fields [constructors arguments self]
  (let-do [fields (the String (String.copy ""))
           assignments (the String (String.copy ""))
           failure (the (Maybe BackendError) (Maybe.Nothing))
           n (Array.length arguments)]
    (for [i 0 n]
      (match-ref &failure
        (Maybe.Nothing)
          (let-do [argument (Box.peek (Array.unsafe-nth arguments i))
                   field-name (String.concat &[@"f" (Int.str i)])
                   field (String.concat &[@"." (String.copy &field-name)])]
            (when (Int.> i 0) (set! fields (String.append &fields ", ")))
            (if (match-ref argument
                (SpecializedExpr.Reference _ _ reference)
                  (CoreIR.same-ref? reference self)
                _ false)
              (do
                (set! fields
                      (String.concat
                        &[(String.copy &fields) field @" = ((Lambda){0})"]))
                (set! assignments
                      (String.concat
                        &[(String.copy &assignments)
                          @" _carp_env->"
                          field-name
                          @" = ((Lambda){ .callback = _carp_self.callback, .env = _carp_self.env, .delete = NULL, .copy = NULL });"])))
              (match (render-value-expression constructors argument)
                (Result.Success value)
                  (set! fields
                        (String.concat
                          &[(String.copy &fields)
                            field
                            @" = "
                            (String.copy &value)]))
                (Result.Error error) (set! failure (Maybe.Just error)))))
        (Maybe.Just _) ()))
    (match-ref &failure
      (Maybe.Just error) (Result.Error @error)
      (Maybe.Nothing) (Result.Success (Pair.init fields assignments)))))

(defn render-recursive-closure-construction [constructors symbol arguments self]
  (let [lambda-symbol (String.concat
          &[@"_carp_lambda_" (String.suffix symbol 14)])
        env-type (String.concat &[(String.copy &lambda-symbol) @"_env"])]
    (match (render-recursive-env-fields constructors arguments self)
      (Result.Success rendered)
        (Result.Success
          (String.concat
            &[@"({ "
              (String.copy &env-type)
              @"* _carp_env = CARP_MALLOC(sizeof("
              (String.copy &env-type)
              @")); *_carp_env = (("
              (String.copy &env-type)
              @"){ "
              (String.copy (Pair.a &rendered))
              @" }); Lambda _carp_self = ((Lambda){ .callback = (void*)"
              (String.copy &lambda-symbol)
              @", .env = (void*)_carp_env, .delete = (void*)"
              (String.copy &env-type)
              @"_delete, .copy = (void*)"
              (String.copy &env-type)
              @"_copy });"
              (String.copy (Pair.b &rendered))
              @" _carp_self; })"]))
      (Result.Error error) (Result.Error error))))

(doc render-closure-construction "renders a capturing lambda's closure site: a
`Lambda` struct whose environment points at a compound literal of the captured
values (block-scoped, valid for non-escaping closures).")
(defn render-closure-construction [constructors symbol arguments]
  (let [lambda-symbol (String.concat
          &[@"_carp_lambda_" (String.suffix symbol 14)])
        env-type (String.concat &[(String.copy &lambda-symbol) @"_env"])]
    (match (render-env-fields constructors arguments)
      (Result.Success fields)
        (Result.Success
          (String.concat
            &[@"((Lambda){ .callback = (void*)"
              (String.copy &lambda-symbol)
              @", .env = &(("
              (String.copy &env-type)
              @"){ "
              fields
              @" }), .delete = NULL, .copy = NULL })"]))
      (Result.Error error) (Result.Error error))))

(doc render-closure-construction-heap "renders a closure construction whose
Lambda escapes the constructing function (return position): the environment
must outlive the stack frame, so it is heap-allocated and carries its generated
environment deleter.")
(defn render-closure-construction-heap [constructors symbol arguments]
  (let [lambda-symbol (String.concat
          &[@"_carp_lambda_" (String.suffix symbol 14)])
        env-type (String.concat &[(String.copy &lambda-symbol) @"_env"])]
    (match (render-env-fields constructors arguments)
      (Result.Success fields)
        (Result.Success
          (String.concat
            &[@"((Lambda){ .callback = (void*)"
              (String.copy &lambda-symbol)
              @", .env = ({ "
              (String.copy &env-type)
              @"* _carp_env = CARP_MALLOC(sizeof("
              (String.copy &env-type)
              @")); *_carp_env = (("
              (String.copy &env-type)
              @"){ "
              fields
              @" }); (void*)_carp_env; }), .delete = (void*)"
              (String.copy &env-type)
              @"_delete, .copy = (void*)"
              (String.copy &env-type)
              @"_copy })"]))
      (Result.Error error) (Result.Error error))))

(defn append-indent! [buffer depth]
  (for [i 0 depth] (StringBuf.append-str buffer "  ")))

(defn array-element-type [array-type]
  (let [storage-type (deref-type array-type)]
    (match-ref &storage-type
      (MonoType.Named _ arguments)
        (if (Int.> (Array.length arguments) 0)
          (Maybe.Just (MonoType.copy (Box.peek (Array.unsafe-nth arguments 0))))
          (Maybe.Nothing))
      _ (Maybe.Nothing))))

(defn render-static-array-literal [constructors array-type elements]
  (match (array-element-type array-type)
    (Maybe.Nothing)
      (Result.Error
        (BackendError.init @"static array literal has no element type"))
    (Maybe.Just element-type)
      (match (render-type &element-type)
        (Result.Success rendered-element)
          (let-do [buffer (StringBuf.create)
                   count (Array.length elements)
                   result (the (Result Unit BackendError) (Result.Success ()))]
            ;; elements are assigned at runtime: they may be calls or hoisted
            ;; heap values, which a `static` initializer cannot reference.
            (StringBuf.append-str &buffer "({ static ")
            (StringBuf.append-str &buffer &rendered-element)
            (StringBuf.append-str &buffer " _carp_static_array_data[")
            (StringBuf.append-str &buffer &(Int.str (Int.max 1 count)))
            (StringBuf.append-str &buffer
                                  "]; static Array _carp_static_array = { .len = ")
            (StringBuf.append-str &buffer &(Int.str count))
            (StringBuf.append-str &buffer ", .capacity = ")
            (StringBuf.append-str &buffer &(Int.str count))
            (StringBuf.append-str &buffer
                                  ", .data = _carp_static_array_data }; ")
            (for [i 0 count]
              (match-ref &result
                (Result.Success _)
                  (match (render-value-expression constructors
                                                  (Box.peek (Array.unsafe-nth elements
                                                                              i)))
                    (Result.Success rendered-value)
                      (do
                        (StringBuf.append-str &buffer "_carp_static_array_data[")
                        (StringBuf.append-str &buffer &(Int.str i))
                        (StringBuf.append-str &buffer "] = ")
                        (StringBuf.append-str &buffer &rendered-value)
                        (StringBuf.append-str &buffer "; "))
                    (Result.Error error) (set! result (Result.Error error)))
                (Result.Error _) ()))
            (StringBuf.append-str &buffer "&_carp_static_array; })")
            (match result
              (Result.Success _) (Result.Success (StringBuf.to-string &buffer))
              (Result.Error error) (Result.Error error)))
        (Result.Error error) (Result.Error error))))

(doc append-array-literal! "lowers a managed `(Array a)` literal to the
reference form: a heap allocation sized to the elements, then one assignment per
element into the malloc'd data. Emitted as the initializer statements of a local
binding so the value is the binding itself.")
(defn append-array-literal! [constructors
                             buffer
                             reference
                             array-type
                             elements
                             depth]
  (match (array-element-type array-type)
    (Maybe.Nothing)
      (Result.Error (BackendError.init @"array literal has no element type"))
    (Maybe.Just element-type)
      (match (render-type &element-type)
        (Result.Success rendered-element)
          (let-do [symbol (local-symbol reference)
                   count (Array.length elements)
                   result (the (Result Unit BackendError) (Result.Success ()))]
            (append-indent! buffer depth)
            (StringBuf.append-str buffer "Array ")
            (StringBuf.append-str buffer &symbol)
            (StringBuf.append-str buffer " = { .len = ")
            (StringBuf.append-str buffer &(Int.str count))
            (StringBuf.append-str buffer ", .capacity = ")
            (StringBuf.append-str buffer &(Int.str count))
            (if (Int.= count 0) (StringBuf.append-str buffer ", .data = NULL };
") (do
                (StringBuf.append-str buffer ", .data = CARP_MALLOC(sizeof(")
                (StringBuf.append-str buffer &rendered-element)
                (StringBuf.append-str buffer ") * ")
                (StringBuf.append-str buffer &(Int.str count))
                (StringBuf.append-str buffer ") };
")))
            (for [i 0 count]
              (match-ref &result
                (Result.Success _)
                  (match (render-value-expression constructors
                                                  (Box.peek (Array.unsafe-nth elements
                                                                              i)))
                    (Result.Success rendered-element-value)
                      (do
                        (append-indent! buffer depth)
                        (StringBuf.append-str buffer "((")
                        (StringBuf.append-str buffer &rendered-element)
                        (StringBuf.append-str buffer "*)")
                        (StringBuf.append-str buffer &symbol)
                        (StringBuf.append-str buffer ".data)[")
                        (StringBuf.append-str buffer &(Int.str i))
                        (StringBuf.append-str buffer "] = ")
                        (StringBuf.append-str buffer &rendered-element-value)
                        (StringBuf.append-str buffer ";
"))
                    (Result.Error error) (set! result (Result.Error error)))
                (Result.Error _) ()))
            result)
        (Result.Error error) (Result.Error error))))

(defn append-local-declaration! [constructors buffer reference value depth]
  (match-ref value
    (SpecializedExpr.ArrayLit _ array-type elements)
    (append-array-literal! constructors
                           buffer
                           reference
                           (Box.peek array-type)
                           elements
                           depth)
    _
    ;; a scope-shaped value (e.g. RefLift's lifted `let`) evaluates to its tail,
    ;; whose type is the true storage type; the node's own type field can be the
    ;; hoist wrapper's binding type, which would mislabel the C local.
    (let [value-type (statement-result-type value)]
      (if (match-ref &value-type (MonoType.Unit) true _ false)
        ;; a unit-typed binding has no C storage; evaluate the initializer for
        ;; its side effects as an expression statement and bind nothing.
        (match (render-value-expression constructors value)
          (Result.Success rendered-value)
            (do
              (append-indent! buffer depth)
              (StringBuf.append-str buffer &rendered-value)
              (StringBuf.append-str buffer ";
")
              (Result.Success ()))
          (Result.Error error) (Result.Error error))
        (match (render-type &value-type)
          (Result.Success rendered-type)
            (match (match-ref value
                (SpecializedExpr.GlobalCall _ _ _ _ symbol arguments)
                  (if (String.starts-with? symbol "_carp_closure_")
                    (render-recursive-closure-construction constructors
                                                           symbol
                                                           arguments
                                                           reference)
                    (render-value-expression constructors value))
                _ (render-value-expression constructors value))
              (Result.Success rendered-value)
                (do
                  (append-indent! buffer depth)
                  (StringBuf.append-str buffer &rendered-type)
                  (StringBuf.append-char buffer \space)
                  (StringBuf.append-str buffer &(local-symbol reference))
                  (StringBuf.append-str buffer " = ")
                  (StringBuf.append-str buffer &rendered-value)
                  (StringBuf.append-str buffer ";
")
                  (Result.Success ()))
              (Result.Error error) (Result.Error error))
          (Result.Error error) (Result.Error error))))))

(defn array-reference-expression? [expression]
  (match-ref &(deref-type &(specialized-type expression))
    (MonoType.Named name _)
      (or (String.= name "Array") (String.= name "StaticArray"))
    _ false))

(defn index-or-length-primitive? [reference]
  (let [id @(CoreRef.id reference)]
    (or (Int.= id 8)
        (or (Int.= id 9)
            (or (Int.= id 10)
                (or (Int.= id 11) (or (Int.= id 12) (Int.= id 13))))))))

(defn arguments-contain-array-reference? [arguments]
  (let-do [found false]
    (for [i 0 (Array.length arguments)]
      (when (array-reference-expression?
          (Box.peek (Array.unsafe-nth arguments i)))
        (set! found true)))
    found))

(defn loop-array-cache-safe? [expression]
  (match-ref expression
    (SpecializedExpr.GlobalCall _ _ reference _ _ arguments)
    (let-do [safe (or (index-or-length-primitive? reference)
                      (not (arguments-contain-array-reference? arguments)))]
      (for [i 0 (Array.length arguments)]
        (unless (loop-array-cache-safe?
            (Box.peek (Array.unsafe-nth arguments i)))
          (set! safe false)))
      safe)
    ;; A closure may mutate an array captured in its environment even when no
    ;; array is among its explicit arguments, so dynamic calls invalidate the
    ;; proof conservatively.
    (SpecializedExpr.Call _ _ _ _)
    false
    (SpecializedExpr.Do _ _ expressions)
    (let-do [safe true]
      (for [i 0 (Array.length expressions)]
        (unless (loop-array-cache-safe?
            (Box.peek (Array.unsafe-nth expressions i)))
          (set! safe false)))
      safe)
    (SpecializedExpr.Let _ _ _ value body)
    (and
      (loop-array-cache-safe? (Box.peek value))
      (loop-array-cache-safe? (Box.peek body)))
    (SpecializedExpr.If _ _ condition then-branch else-branch)
    (and
      (loop-array-cache-safe? (Box.peek condition))
      (and
        (loop-array-cache-safe? (Box.peek then-branch))
        (loop-array-cache-safe? (Box.peek else-branch))))
    (SpecializedExpr.While _ _ condition body)
    (and
      (loop-array-cache-safe? (Box.peek condition))
      (loop-array-cache-safe? (Box.peek body)))
    (SpecializedExpr.Match _ _ _ scrutinee branches)
    (let-do [safe (loop-array-cache-safe? (Box.peek scrutinee))]
      (for [i 0 (Array.length branches)]
        (unless (loop-array-cache-safe?
            (Box.peek
              (SpecializedMatchBranch.body (Array.unsafe-nth branches i))))
          (set! safe false)))
      safe)
    (SpecializedExpr.Set _ _ _ value)
    (loop-array-cache-safe? (Box.peek value))
    (SpecializedExpr.Annotation _ _ inner _)
    (loop-array-cache-safe? (Box.peek inner))
    (SpecializedExpr.ArrayLit _ _ elements)
    (let-do [safe true]
      (for [i 0 (Array.length elements)]
        (unless (loop-array-cache-safe? (Box.peek (Array.unsafe-nth elements i)))
          (set! safe false)))
      safe)
    (SpecializedExpr.StaticArrayLit _ _ elements)
    (let-do [safe true]
      (for [i 0 (Array.length elements)]
        (unless (loop-array-cache-safe? (Box.peek (Array.unsafe-nth elements i)))
          (set! safe false)))
      safe)
    _
    true))

(defn index-candidate-listed? [candidates reference]
  (let-do [found false]
    (for [i 0 (Array.length candidates)]
      (when (CoreIR.same-ref? (Pair.a (Array.unsafe-nth candidates i)) reference)
        (set! found true)))
    found))

(sig collect-loop-index-candidates!
     (Fn [(Ref SpecializedExpr) (Ref (Array (Pair CoreRef (Box MonoType))))] ()))
(defn collect-loop-index-candidates! [expression candidates]
  (match-ref expression
    (SpecializedExpr.GlobalCall _ result-type reference _ _ arguments)
      (do
        (when-do (and
            (or (Int.= @(CoreRef.id reference) 12)
                (Int.= @(CoreRef.id reference) 13))
            (Int.> (Array.length arguments) 0))
          (match-ref (Box.peek (Array.unsafe-nth arguments 0))
            (SpecializedExpr.Reference _ _ container-reference)
              (unless-do (or @(CoreRef.global container-reference)
                             (index-candidate-listed? candidates
                                                      container-reference))
                (match-ref (Box.peek result-type)
                  (MonoType.Reference element _)
                    (Array.push-back! candidates
                                      (Pair.init (CoreRef.copy container-reference)
                                                 (Box.init (MonoType.copy (Box.peek element)))))
                  _ ()))
            _ ()))
        (for [i 0 (Array.length arguments)]
          (collect-loop-index-candidates!
            (Box.peek (Array.unsafe-nth arguments i))
            candidates)))
    (SpecializedExpr.Call _ _ callee arguments)
      (do
        (collect-loop-index-candidates! (Box.peek callee) candidates)
        (for [i 0 (Array.length arguments)]
          (collect-loop-index-candidates!
            (Box.peek (Array.unsafe-nth arguments i))
            candidates)))
    (SpecializedExpr.Do _ _ expressions)
      (for [i 0 (Array.length expressions)]
        (collect-loop-index-candidates!
          (Box.peek (Array.unsafe-nth expressions i))
          candidates))
    (SpecializedExpr.Let _ _ _ value body)
      (do
        (collect-loop-index-candidates! (Box.peek value) candidates)
        (collect-loop-index-candidates! (Box.peek body) candidates))
    (SpecializedExpr.If _ _ condition then-branch else-branch)
      (do
        (collect-loop-index-candidates! (Box.peek condition) candidates)
        (collect-loop-index-candidates! (Box.peek then-branch) candidates)
        (collect-loop-index-candidates! (Box.peek else-branch) candidates))
    (SpecializedExpr.While _ _ condition body)
      (do
        (collect-loop-index-candidates! (Box.peek condition) candidates)
        (collect-loop-index-candidates! (Box.peek body) candidates))
    (SpecializedExpr.Match _ _ _ scrutinee branches)
      (do
        (collect-loop-index-candidates! (Box.peek scrutinee) candidates)
        (for [i 0 (Array.length branches)]
          (collect-loop-index-candidates!
            (Box.peek
              (SpecializedMatchBranch.body (Array.unsafe-nth branches i)))
            candidates)))
    (SpecializedExpr.Set _ _ _ value)
      (collect-loop-index-candidates! (Box.peek value) candidates)
    (SpecializedExpr.Annotation _ _ inner _)
      (collect-loop-index-candidates! (Box.peek inner) candidates)
    (SpecializedExpr.ArrayLit _ _ elements)
      (for [i 0 (Array.length elements)]
        (collect-loop-index-candidates! (Box.peek (Array.unsafe-nth elements i))
                                        candidates))
    (SpecializedExpr.StaticArrayLit _ _ elements)
      (for [i 0 (Array.length elements)]
        (collect-loop-index-candidates! (Box.peek (Array.unsafe-nth elements i))
                                        candidates))
    _ ()))

(defn append-cached-while! [constructors buffer condition body depth]
  (let-do [old-refs (Array.copy &*array-data-cache-refs*)
           old-symbols (Array.copy &*array-data-cache-symbols*)
           candidates (the (Array (Pair CoreRef (Box MonoType))) [])
           free-references (the (Array (Pair CoreRef (Box MonoType))) [])
           no-bindings (the (Array Int) [])
           setup-result (the (Result Unit BackendError) (Result.Success ()))]
    ;; A cached view is valid only while no operation in the loop can receive
    ;; the array and mutate or reallocate it. Unknown calls are deliberately
    ;; unsafe; length and indexing primitives are the allowed array operations.
    (when-do (and (loop-array-cache-safe? condition)
                  (loop-array-cache-safe? body))
      ;; Only references free in the loop are in scope at the hoist site.
      ;; This excludes arrays introduced by a let or match inside the loop.
      (collect-free condition &no-bindings &free-references)
      (collect-free body &no-bindings &free-references)
      (collect-loop-index-candidates! condition &candidates)
      (collect-loop-index-candidates! body &candidates))
    (for [i 0 (Array.length &candidates)]
      (match-ref &setup-result
        (Result.Success _)
          (let [candidate (Array.unsafe-nth &candidates i)
                reference (Pair.a candidate)]
            (when (capture-listed? &free-references @(CoreRef.id reference))
              (match (cached-array-data-symbol-for-ref reference)
                (Maybe.Just _) ()
                (Maybe.Nothing)
                  (match (render-type (Box.peek (Pair.b candidate)))
                    (Result.Success element)
                      (let-do [symbol (String.concat
                                 &[@"L0_array_data_"
                                   (CAbi.component &(Int.str @(CoreRef.id reference)))])]
                        (append-indent! buffer depth)
                        (StringBuf.append-str buffer &element)
                        (StringBuf.append-str buffer "* ")
                        (StringBuf.append-str buffer &symbol)
                        (StringBuf.append-str buffer " = (")
                        (StringBuf.append-str buffer &element)
                        (StringBuf.append-str buffer "*)(*")
                        (StringBuf.append-str buffer &(local-symbol reference))
                        (StringBuf.append-str buffer ").data;
")
                        (Array.push-back! &*array-data-cache-refs*
                                          (CoreRef.copy reference))
                        (Array.push-back! &*array-data-cache-symbols* symbol))
                    (Result.Error error)
                      (set! setup-result (Result.Error error))))))
        (Result.Error _) ()))
    (let-do [result (match setup-result
               (Result.Success _)
                 (match (render-value-expression constructors condition)
                   (Result.Success rendered-condition)
                     (do
                       (append-indent! buffer depth)
                       (StringBuf.append-str buffer "while (")
                       (StringBuf.append-str buffer &rendered-condition)
                       (StringBuf.append-str buffer ") {
")
                       (match (the (Result Unit BackendError)
                                   (append-statement! constructors
                                                      buffer
                                                      body
                                                      (Int.inc depth)))
                         (Result.Success _)
                           (do
                             (append-indent! buffer depth)
                             (StringBuf.append-str buffer "}
")
                             (Result.Success ()))
                         (Result.Error error) (Result.Error error)))
                   (Result.Error error) (Result.Error error))
               (Result.Error error) (Result.Error error))]
      (set! *array-data-cache-refs* old-refs)
      (set! *array-data-cache-symbols* old-symbols)
      result)))

(defn append-statement! [constructors buffer expression depth]
  (match-ref expression
    (SpecializedExpr.Do _ _ expressions)
      (let-do [result (the (Result Unit BackendError) (Result.Success ()))
               n (Array.length expressions)]
        (for [i 0 n]
          (match-ref &result
            (Result.Success _)
              (set! result
                    (append-statement! constructors
                                       buffer
                                       (Box.peek (Array.unsafe-nth expressions i))
                                       depth))
            (Result.Error _) ()))
        result)
    (SpecializedExpr.Let _ _ reference value body)
      (match (append-local-declaration! constructors
                                        buffer
                                        reference
                                        (Box.peek value)
                                        depth)
        (Result.Success _)
          (append-statement! constructors buffer (Box.peek body) depth)
        (Result.Error error) (Result.Error error))
    (SpecializedExpr.Set _ _ reference value)
      (match (render-value-expression constructors (Box.peek value))
        (Result.Success rendered)
          (let-do [target (if @(CoreRef.global reference)
                     ;; assign the global through its reconstructed C symbol.
                     (sanitize
                       &(CAbi.mangle (CoreRef.name reference)
                                     &(specialized-type (Box.peek value))))
                     (local-symbol reference))]
            (append-indent! buffer depth)
            (StringBuf.append-str buffer &target)
            (StringBuf.append-str buffer " = ")
            (StringBuf.append-str buffer &rendered)
            (StringBuf.append-str buffer ";
")
            (Result.Success ()))
        (Result.Error error) (Result.Error error))
    (SpecializedExpr.While _ _ condition body)
      (append-cached-while! constructors
                            buffer
                            (Box.peek condition)
                            (Box.peek body)
                            depth)
    (SpecializedExpr.Break _ _)
      (do (append-indent! buffer depth) (StringBuf.append-str buffer "break;
") (Result.Success ()))
    (SpecializedExpr.If _ _ condition then-branch else-branch)
      (match (render-value-expression constructors (Box.peek condition))
        (Result.Success rendered-condition)
          (do
            (append-indent! buffer depth)
            (StringBuf.append-str buffer "if (")
            (StringBuf.append-str buffer &rendered-condition)
            (StringBuf.append-str buffer ") {
")
            (match (append-statement! constructors
                                      buffer
                                      (Box.peek then-branch)
                                      (Int.inc depth))
              (Result.Success _)
                (do
                  (append-indent! buffer depth)
                  (StringBuf.append-str buffer "} else {
")
                  (match (append-statement! constructors
                                            buffer
                                            (Box.peek else-branch)
                                            (Int.inc depth))
                    (Result.Success _)
                      (do
                        (append-indent! buffer depth)
                        (StringBuf.append-str buffer "}
")
                        (Result.Success ()))
                    (Result.Error error) (Result.Error error)))
              (Result.Error error) (Result.Error error)))
        (Result.Error error) (Result.Error error))
    (SpecializedExpr.Match id _ by-reference scrutinee branches)
      (let [destination (ResultDestination.Return (Box.init (Type.unit)))]
        (append-match! constructors
                       buffer
                       @id
                       @by-reference
                       (Box.peek scrutinee)
                       branches
                       depth
                       false
                       &destination))
    _
      (match (render-value-expression constructors expression)
        (Result.Success rendered)
          (do
            (append-indent! buffer depth)
            (StringBuf.append-str buffer &rendered)
            (StringBuf.append-str buffer ";
")
            (Result.Success ()))
        (Result.Error error) (Result.Error error))))

(defn append-result! [constructors buffer expression destination depth]
  (match-ref expression
    (SpecializedExpr.Do _ _ expressions)
      (let [n (Array.length expressions)]
        (if (Int.= n 0)
          (match-ref destination
            (ResultDestination.Return result-type)
              (if (match-ref (Box.peek result-type) (MonoType.Unit) true _ false)
                (do
                  (append-indent! buffer depth)
                  (StringBuf.append-str buffer "return;
")
                  (Result.Success ()))
                (Result.Error
                  (BackendError.init @"empty do has a non-unit result")))
            (ResultDestination.Assign _ _)
              (Result.Error
                (BackendError.init @"empty do cannot initialize a scalar global")))
          (let-do [result (the (Result Unit BackendError) (Result.Success ()))]
            (for [i 0 (Int.dec n)]
              (match-ref &result
                (Result.Success _)
                  (set! result
                        (append-statement! constructors
                                           buffer
                                           (Box.peek (Array.unsafe-nth expressions
                                                                       i))
                                           depth))
                (Result.Error _) ()))
            (match-ref &result
              (Result.Success _)
                (append-result! constructors
                                buffer
                                (Box.peek
                                  (Array.unsafe-nth expressions (Int.dec n)))
                                destination
                                depth)
              (Result.Error error) (Result.Error @error)))))
    (SpecializedExpr.Let _ _ reference value body)
      (match (append-local-declaration! constructors
                                        buffer
                                        reference
                                        (Box.peek value)
                                        depth)
        (Result.Success _)
          (append-result! constructors buffer (Box.peek body) destination depth)
        (Result.Error error) (Result.Error error))
    (SpecializedExpr.If _ _ condition then-branch else-branch)
      (match (render-value-expression constructors (Box.peek condition))
        (Result.Success rendered-condition)
          (do
            (append-indent! buffer depth)
            (StringBuf.append-str buffer "if (")
            (StringBuf.append-str buffer &rendered-condition)
            (StringBuf.append-str buffer ") {
")
            (match (append-result! constructors
                                   buffer
                                   (Box.peek then-branch)
                                   destination
                                   (Int.inc depth))
              (Result.Success _)
                (do
                  (append-indent! buffer depth)
                  (StringBuf.append-str buffer "} else {
")
                  (match (append-result! constructors
                                         buffer
                                         (Box.peek else-branch)
                                         destination
                                         (Int.inc depth))
                    (Result.Success _)
                      (do
                        (append-indent! buffer depth)
                        (StringBuf.append-str buffer "}
")
                        (Result.Success ()))
                    (Result.Error error) (Result.Error error)))
              (Result.Error error) (Result.Error error)))
        (Result.Error error) (Result.Error error))
    (SpecializedExpr.Match id _ by-reference scrutinee branches)
      (append-match! constructors
                     buffer
                     @id
                     @by-reference
                     (Box.peek scrutinee)
                     branches
                     depth
                     true
                     destination)
    _
      (match-ref destination
        (ResultDestination.Return return-type)
          (if (match-ref (Box.peek return-type) (MonoType.Unit) true _ false)
            (let [statement-result (the (Result Unit BackendError)
                                        (append-statement! constructors
                                                           buffer
                                                           expression
                                                           depth))]
              (match statement-result
                (Result.Success _)
                  (do
                    (append-indent! buffer depth)
                    (StringBuf.append-str buffer "return;
")
                    (Result.Success ()))
                (Result.Error error) (Result.Error error)))
            ;; a closure constructed directly in return position escapes its
            ;; frame: its environment moves to the heap.
            (match (match-ref expression
                (SpecializedExpr.GlobalCall _ _ _ _ call-symbol call-arguments)
                  (if (String.starts-with? call-symbol "_carp_closure_")
                    (render-closure-construction-heap constructors
                                                      call-symbol
                                                      call-arguments)
                    (render-value-expression constructors expression))
                _ (render-value-expression constructors expression))
              (Result.Success rendered)
                (do
                  (append-indent! buffer depth)
                  (StringBuf.append-str buffer "return ")
                  (StringBuf.append-str buffer &rendered)
                  (StringBuf.append-str buffer ";
")
                  (Result.Success ()))
              (Result.Error error) (Result.Error error)))
        (ResultDestination.Assign target result-type)
          (let [expression-type (specialized-type expression)]
            (if (Type.same-representation? &expression-type
                                           (Box.peek result-type))
              (match (render-value-expression constructors expression)
                (Result.Success rendered)
                  (do
                    (append-indent! buffer depth)
                    (StringBuf.append-str buffer target)
                    (StringBuf.append-str buffer " = ")
                    (StringBuf.append-str buffer &rendered)
                    (StringBuf.append-str buffer ";
")
                    (Result.Success ()))
                (Result.Error error) (Result.Error error))
              (Result.Error
                (BackendError.init
                  @"global initializer result type does not match storage")))))))

(defn unmanaged-signature? [constructors signature]
  (match-ref signature
    (MonoType.Function arguments result)
      (let-do [supported (unmanaged-type? constructors (Box.peek result))
               n (Array.length arguments)]
        (for [i 0 n]
          (unless-do (unmanaged-type? constructors
                                      (Box.peek (Array.unsafe-nth arguments i)))
            (set! supported false)))
        supported)
    _ false))

(private renderable-signature?)
(hidden renderable-signature?)
(doc renderable-signature? "reports whether a function signature can be lowered.
Managed parameters and a managed result are both allowed now: the ownership
plan schedules a deleter for every owned parameter the body does not consume,
and a managed result is a move-out to the caller. Only the function shape is
required; concreteness is enforced separately.")
(defn renderable-signature? [constructors signature]
  (match-ref signature (MonoType.Function _ _) true _ false))

(defn constructor-for-reference [constructors reference]
  (let-do [result (the (Maybe CoreConstructorDeclaration) (Maybe.Nothing))
           n (Array.length constructors)]
    (for [i 0 n]
      (let [constructor (Array.unsafe-nth constructors i)]
        (when (CoreIR.same-ref?
            (CoreConstructorDeclaration.reference constructor)
            reference)
          (set! result (Maybe.Just @constructor)))))
    result))

(defn unqualified-suffix [name]
  (let-do [last-dot -1
           n (String.length name)]
    (for [i 0 n] (when (Char.= (String.char-at name i) \.) (set! last-dot i)))
    (if (Int.< last-dot 0)
      (String.copy name)
      (String.suffix name (Int.inc last-dot)))))

(doc constructor-for-pattern "the constructor a pattern names. An ambiguous
bare pattern name (two sumtypes sharing a constructor name under `use`)
resolves to a synthetic overload reference that names no constructor directly;
the scrutinee's concrete type then picks the real one — the same type-directed
choice the reference's multisym resolution makes.")
(defn constructor-for-pattern [constructors reference subject-type]
  (match (constructor-for-reference constructors reference)
    (Maybe.Just constructor) (Maybe.Just constructor)
    (Maybe.Nothing)
      (let [subject (match-ref subject-type
              (MonoType.Reference inner _) (MonoType.copy (Box.peek inner))
              _ (MonoType.copy subject-type))]
        (match-ref &subject
          (MonoType.Named subject-name _)
            (let-do [result (the (Maybe CoreConstructorDeclaration)
                                 (Maybe.Nothing))
                     want (unqualified-suffix (CoreRef.name reference))
                     n (Array.length constructors)]
              (for [i 0 n]
                (let [candidate (Array.unsafe-nth constructors i)]
                  (match-ref (Box.peek
                      (CoreConstructorDeclaration.result candidate))
                    (CoreType.Named rname _)
                      (when (and (String.= rname subject-name)
                                 (String.=
                                   &(unqualified-suffix
                                     (CoreRef.name
                                       (CoreConstructorDeclaration.reference candidate)))
                                   &want))
                        (set! result (Maybe.Just @candidate)))
                    _ ())))
              result)
          _ (the (Maybe CoreConstructorDeclaration) (Maybe.Nothing))))))

(defn single-constructor-name? [constructors name]
  (let-do [count 0
           previous-tag -1
           n (Array.length constructors)]
    ;; Tags restart when a later declaration shadows an earlier type. Keep
    ;; only the size of the last declaration group, matching layout lookup.
    (for [i 0 n]
      (let [constructor (Array.unsafe-nth constructors i)]
        (match-ref (Box.peek (CoreConstructorDeclaration.result constructor))
          (CoreType.Named result-name _)
            (when-do (String.= result-name name)
              (if (Int.<=
                  @(CoreConstructorDeclaration.tag constructor)
                  previous-tag)
                (set! count 1)
                (set! count (Int.inc count)))
              (set! previous-tag @(CoreConstructorDeclaration.tag constructor)))
          _ ())))
    (Int.= count 1)))

(defn pattern-condition [constructors pattern subject-type expression]
  (match-ref pattern
    (CorePattern.Ignore) (Result.Success (String.copy ""))
    (CorePattern.Bind _) (Result.Success (String.copy ""))
    (CorePattern.Constructor reference children)
      (match (constructor-for-pattern constructors reference subject-type)
        (Maybe.Just constructor)
          (match (collect-template-bindings
              (Box.peek (CoreConstructorDeclaration.result &constructor))
              subject-type
              &[])
            (Result.Success layout-bindings)
              (let-do [result (the (Result Unit BackendError)
                                   (Result.Success ()))
                       buffer (StringBuf.create)
                       fields (CoreConstructorDeclaration.arguments &constructor)
                       n (Array.length children)]
                (if (/= n (Array.length fields))
                  (set! result
                        (Result.Error
                          (BackendError.init
                            @"match constructor pattern arity mismatch")))
                  (do
                    (match-ref subject-type
                      (MonoType.Named subject-name _)
                        (if (single-constructor-name? constructors subject-name)
                          (StringBuf.append-str &buffer "true")
                          (do
                            (StringBuf.append-str &buffer expression)
                            (StringBuf.append-str &buffer ".tag == ")
                            (StringBuf.append-str &buffer
                                                  &(Int.str
                                                    @(CoreConstructorDeclaration.tag &constructor)))))
                      _
                        (do
                          (StringBuf.append-str &buffer expression)
                          (StringBuf.append-str &buffer ".tag == ")
                          (StringBuf.append-str &buffer
                                                &(Int.str
                                                  @(CoreConstructorDeclaration.tag &constructor)))))
                    (for [i 0 n]
                      (match-ref &result
                        (Result.Success _)
                          (match (concretize-core-type &layout-bindings
                                                       (Box.peek (Array.unsafe-nth fields
                                                                                   i)))
                            (Result.Success field-type)
                              (let [child-expression (String.concat
                                      &[(String.copy expression)
                                        @".data.variant_"
                                        (Int.str
                                          @(CoreConstructorDeclaration.tag &constructor))
                                        @".member_"
                                        (Int.str i)])]
                                (match (pattern-condition constructors
                                                          (Box.peek (Array.unsafe-nth children
                                                                                      i))
                                                          &field-type
                                                          &child-expression)
                                  (Result.Success child-condition)
                                    (unless-do (String.empty? &child-condition)
                                      (StringBuf.append-str &buffer " && (")
                                      (StringBuf.append-str &buffer
                                                            &child-condition)
                                      (StringBuf.append-char &buffer \)))
                                  (Result.Error error)
                                    (set! result (Result.Error error))))
                            (Result.Error error)
                              (set! result (Result.Error error)))
                        (Result.Error _) ()))))
                (match result
                  (Result.Success _)
                    (Result.Success (StringBuf.to-string &buffer))
                  (Result.Error error) (Result.Error error)))
            (Result.Error error) (Result.Error error))
        (Maybe.Nothing)
          (Result.Error
            (BackendError.init @"match constructor has no nominal layout")))))

(defn append-pattern-bindings! [constructors
                                buffer
                                pattern
                                subject-type
                                expression
                                depth
                                by-ref]
  (match-ref pattern
    (CorePattern.Ignore)
    (Result.Success ())
    (CorePattern.Bind binding)
    ;; a unit-typed field has no C storage (elided from the struct); the
    ;; binding binds nothing and its uses render as unit.
    (if (unit-type? subject-type)
      (Result.Success ())
      (match (render-type subject-type)
        (Result.Success field-type)
          (do
            (append-indent! buffer depth)
            (StringBuf.append-str buffer &field-type)
            (when by-ref (StringBuf.append-char buffer \*))
            (StringBuf.append-char buffer \space)
            (StringBuf.append-str buffer &(local-symbol binding))
            (StringBuf.append-str buffer " = ")
            (when by-ref (StringBuf.append-char buffer \&))
            (StringBuf.append-str buffer expression)
            (StringBuf.append-str buffer ";
")
            (Result.Success ()))
        (Result.Error error) (Result.Error error)))
    (CorePattern.Constructor reference children)
    (match (constructor-for-pattern constructors reference subject-type)
      (Maybe.Just constructor)
        (match (collect-template-bindings
            (Box.peek (CoreConstructorDeclaration.result &constructor))
            subject-type
            &[])
          (Result.Success layout-bindings)
            (let-do [result (the (Result Unit BackendError) (Result.Success ()))
                     fields (CoreConstructorDeclaration.arguments &constructor)
                     n (Array.length children)]
              (if (/= n (Array.length fields))
                (set! result
                      (Result.Error
                        (BackendError.init
                          @"match constructor pattern arity mismatch")))
                (for [i 0 n]
                  (match-ref &result
                    (Result.Success _)
                      (match (concretize-core-type &layout-bindings
                                                   (Box.peek (Array.unsafe-nth fields
                                                                               i)))
                        (Result.Success field-type)
                          (let [child-expression (String.concat
                                  &[(String.copy expression)
                                    @".data.variant_"
                                    (Int.str
                                      @(CoreConstructorDeclaration.tag &constructor))
                                    @".member_"
                                    (Int.str i)])]
                            (set! result
                                  (append-pattern-bindings! constructors
                                                            buffer
                                                            (Box.peek (Array.unsafe-nth children
                                                                                        i))
                                                            &field-type
                                                            &child-expression
                                                            depth
                                                            by-ref)))
                        (Result.Error error) (set! result (Result.Error error)))
                    (Result.Error _) ())))
              result)
          (Result.Error error) (Result.Error error))
      (Maybe.Nothing)
        (Result.Error
          (BackendError.init @"match constructor has no nominal layout")))))

(defn append-match-pattern-body! [constructors
                                  buffer
                                  temporary
                                  scrutinee-type
                                  branch
                                  depth
                                  tail?
                                  destination
                                  by-ref]
  (match (append-pattern-bindings! constructors
                                   buffer
                                   (SpecializedMatchBranch.pattern branch)
                                   scrutinee-type
                                   temporary
                                   (Int.inc depth)
                                   by-ref)
    (Result.Success _)
      (let [body-result (if tail?
              (append-result! constructors
                              buffer
                              (Box.peek (SpecializedMatchBranch.body branch))
                              destination
                              (Int.inc depth))
              (append-statement! constructors
                                 buffer
                                 (Box.peek (SpecializedMatchBranch.body branch))
                                 (Int.inc depth)))]
        (match body-result
          (Result.Success _)
            (do (append-indent! buffer depth) (StringBuf.append-str buffer "}
") (Result.Success ()))
          (Result.Error error) (Result.Error error)))
    (Result.Error error) (Result.Error error)))

(defn deref-type [type]
  (match-ref type
    (MonoType.Reference inner _) (MonoType.copy (Box.peek inner))
    _ (MonoType.copy type)))

(defn append-match! [constructors
                     buffer
                     id
                     by-reference
                     scrutinee
                     branches
                     depth
                     tail?
                     destination]
  (match (render-value-expression constructors scrutinee)
    (Result.Success rendered-scrutinee)
      (let [scrutinee-type (specialized-type scrutinee)
            subject-type (deref-type &scrutinee-type)]
        (match (render-type &scrutinee-type)
          (Result.Success rendered-type)
            (let-do [temporary (String.concat &[@"match_" (Int.str id)])
                     base-expr (if (match-ref &scrutinee-type
                         (MonoType.Reference _ _) true
                         _ false)
                       (String.concat &[@"(*" (String.copy &temporary) @")"])
                       (String.copy &temporary))
                     result (the (Result Unit BackendError) (Result.Success ()))
                     emitted-condition false
                     emitted-wildcard false
                     n (Array.length branches)]
              (append-indent! buffer depth)
              (StringBuf.append-str buffer &rendered-type)
              (StringBuf.append-char buffer \space)
              (StringBuf.append-str buffer &temporary)
              (StringBuf.append-str buffer " = ")
              (StringBuf.append-str buffer &rendered-scrutinee)
              (StringBuf.append-str buffer ";
")
              (for [i 0 n]
                (match-ref &result
                  (Result.Success _)
                    (let [branch (Array.unsafe-nth branches i)]
                      (match (pattern-condition constructors
                                                (SpecializedMatchBranch.pattern branch)
                                                &subject-type
                                                &base-expr)
                        (Result.Success condition)
                          (cond
                            (and (String.empty? &condition) emitted-wildcard)
                              (set! result
                                    (Result.Error
                                      (BackendError.init @"match has multiple wildcard branches")))
                            (String.empty? &condition)
                              (do
                                (append-indent! buffer depth)
                                (StringBuf.append-str buffer
                                                      (if emitted-condition
                                                        "else {
"
                                                        "{
"))
                                (set! emitted-wildcard true)
                                (set! result
                                      (append-match-pattern-body! constructors
                                                                  buffer
                                                                  &base-expr
                                                                  &subject-type
                                                                  branch
                                                                  depth
                                                                  tail?
                                                                  destination
                                                                  by-reference)))
                            emitted-wildcard
                              (set! result
                                    (Result.Error
                                      (BackendError.init @"conditional branch follows wildcard")))
                            (do
                              (append-indent! buffer depth)
                              (StringBuf.append-str buffer
                                                    (if emitted-condition
                                                      "else if ("
                                                      "if ("))
                              (StringBuf.append-str buffer &condition)
                              (StringBuf.append-str buffer ") {
")
                              (set! emitted-condition true)
                              (set! result
                                    (append-match-pattern-body! constructors
                                                                buffer
                                                                &base-expr
                                                                &subject-type
                                                                branch
                                                                depth
                                                                tail?
                                                                destination
                                                                by-reference))))
                        (Result.Error error) (set! result (Result.Error error))))
                  (Result.Error _) ()))
              (match result
                (Result.Success _)
                  (if (and emitted-condition (not emitted-wildcard))
                    (do
                      (append-indent! buffer depth)
                      (StringBuf.append-str buffer "else {
")
                      (append-indent! buffer (Int.inc depth))
                      (StringBuf.append-str buffer "abort();
")
                      (append-indent! buffer depth)
                      (StringBuf.append-str buffer "}
")
                      (Result.Success ()))
                    (Result.Success ()))
                (Result.Error error) (Result.Error error)))
          (Result.Error error) (Result.Error error)))
    (Result.Error error) (Result.Error error)))

(defn replace-template-token [text token replacement]
  (let-do [buffer (StringBuf.create)
           cursor 0
           length (String.length text)
           searching true]
    (while searching
      (let [remaining (String.byte-slice text cursor length)
            relative (String.index-of-string &remaining token)]
        (if (Int.< relative 0)
          (let-do [suffix (String.byte-slice text cursor length)]
            (StringBuf.append-str &buffer &suffix)
            (set! searching false))
          (let [found (Int.+ cursor relative)
                token-end (Int.+ found (String.length token))
                followed-by-identifier? (and (Int.< token-end length)
                                             (let [next (String.char-at text
                                                                        token-end)]
                                               (or (Char.alphanum? next)
                                                   (Char.= next \_))))]
            (if followed-by-identifier?
              (let-do [unchanged (String.byte-slice text cursor token-end)]
                (StringBuf.append-str &buffer &unchanged)
                (set! cursor token-end))
              (let-do [prefix (String.byte-slice text cursor found)]
                (StringBuf.append-str &buffer &prefix)
                (StringBuf.append-str &buffer replacement)
                (set! cursor token-end)))))))
    (StringBuf.to-string &buffer)))

(defn instantiate-template-text [text bindings]
  (let-do [result (the (Result String BackendError)
                       (Result.Success (String.copy text)))
           n (Array.length bindings)]
    (for [i 0 n]
      (match-ref &result
        (Result.Success current)
          (let [binding (Array.unsafe-nth bindings i)]
            (match (render-type (Box.peek (TemplateTypeBinding.type binding)))
              (Result.Success rendered)
                (let [token (String.append "$"
                                           (TemplateTypeBinding.name binding))]
                  (set! result
                        (Result.Success
                          (replace-template-token current &token &rendered))))
              (Result.Error error) (set! result (Result.Error error))))
        (Result.Error _) ()))
    result))

(defn source-template-declaration [declaration]
  (match-ref declaration
    (BackendDeclaration.SourceTemplate symbol
                                       concrete-signature
                                       source-signature
                                       source-declaration
                                       _)
      (match (collect-template-bindings (Box.peek source-signature)
                                        (Box.peek concrete-signature)
                                        &[])
        (Result.Success bindings)
          (match (instantiate-template-text source-declaration &bindings)
            (Result.Success typed-declaration)
              (Result.Success
                (replace-template-token &typed-declaration
                                        "$NAME"
                                        &(sanitize symbol)))
            (Result.Error error) (Result.Error error))
        (Result.Error error) (Result.Error error))
    _ (Result.Error (BackendError.init @"declaration is not a source template"))))

(defn source-template-definition [declaration]
  (match-ref declaration
    (BackendDeclaration.SourceTemplate symbol
                                       concrete-signature
                                       source-signature
                                       _
                                       source-body)
      (match (collect-template-bindings (Box.peek source-signature)
                                        (Box.peek concrete-signature)
                                        &[])
        (Result.Success bindings)
          (match (instantiate-template-text source-body &bindings)
            (Result.Success typed-body)
              (match (source-template-declaration declaration)
                (Result.Success rendered-declaration)
                  (let [named-body (replace-template-token &typed-body
                                                           "$NAME"
                                                           &(sanitize symbol))]
                    (Result.Success
                      (replace-template-token &named-body
                                              "$DECL"
                                              &rendered-declaration)))
                (Result.Error error) (Result.Error error))
            (Result.Error error) (Result.Error error))
        (Result.Error error) (Result.Error error))
    _ (Result.Error (BackendError.init @"declaration is not a source template"))))

(defn template-declaration? [declaration]
  (match-ref declaration
    (BackendDeclaration.Template _ _ _ _) true
    (BackendDeclaration.SourceTemplate _ _ _ _ _) true
    _ false))

(defn unit-type? [type] (match-ref type (MonoType.Unit) true _ false))

;; unit-typed parameters are elided entirely, matching the reference
;; (`bool Unit__EQ_()`); references to them render as `((void)0)`.
(defn append-parameters! [buffer arguments parameters]
  (let-do [result (the (Result Unit BackendError) (Result.Success ()))
           emitted 0
           n (Array.length arguments)]
    (for [i 0 n]
      (match-ref &result
        (Result.Success _)
          (unless (unit-type? (Box.peek (Array.unsafe-nth arguments i)))
            (match (render-type (Box.peek (Array.unsafe-nth arguments i)))
              (Result.Success rendered)
                (do
                  (when (Int.> emitted 0) (StringBuf.append-str buffer ", "))
                  (StringBuf.append-str buffer &rendered)
                  (StringBuf.append-char buffer \space)
                  (if (Int.< i (Array.length parameters))
                    (StringBuf.append-str buffer
                                          &(local-symbol (Array.unsafe-nth parameters
                                                                           i)))
                    (StringBuf.append-str buffer
                                          &(String.concat &[@"arg" (Int.str i)])))
                  (set! emitted (Int.inc emitted)))
              (Result.Error error) (set! result (Result.Error error))))
        (Result.Error _) ()))
    (when (Int.= emitted 0) (StringBuf.append-str buffer "void"))
    result))

(defn contains-string? [items key]
  (let-do [found false
           n (Array.length items)]
    (for [i 0 n]
      (when (String.= (Array.unsafe-nth items i) key) (set! found true)))
    found))

(defn c-reserved-word? [name]
  (let-do [found false
           keywords [@"auto"
                     @"break"
                     @"case"
                     @"char"
                     @"const"
                     @"continue"
                     @"default"
                     @"do"
                     @"double"
                     @"else"
                     @"enum"
                     @"extern"
                     @"float"
                     @"for"
                     @"goto"
                     @"if"
                     @"inline"
                     @"int"
                     @"long"
                     @"register"
                     @"restrict"
                     @"return"
                     @"short"
                     @"signed"
                     @"sizeof"
                     @"static"
                     @"struct"
                     @"switch"
                     @"typedef"
                     @"union"
                     @"unsigned"
                     @"void"
                     @"volatile"
                     @"while"
                     ;; identifiers the rendered C already claims in scope
                     @"argc"
                     @"argv"
                     @"main"
                     @"_env"]
           n (Array.length &keywords)]
    (for [i 0 n]
      (when (String.= (Array.unsafe-nth &keywords i) name) (set! found true)))
    found))

(doc plain-name-eligible? "whether a binder's Carp name can be its C
identifier: lowercase-or-underscore start keeps clear of the (capitalized)
runtime typedefs, and C keywords are excluded.")
(defn plain-name-eligible? [name]
  (and (Int.> (String.length name) 0)
       (and (not (c-reserved-word? name))
            (let [first-char (Char.to-int (String.char-at name 0))]
              (or
                (and (Int.>= first-char 97) (Int.<= first-char 122))
                (Int.= first-char 95))))))

(defn note-plain-binder! [reference seen winners]
  (let [name (CAbi.component (CoreRef.name reference))]
    (when-do (and (plain-name-eligible? &name)
                  (not (contains-string? seen &name)))
      (Array.push-back! seen name)
      (Array.push-back! winners @(CoreRef.id reference)))))

(sig collect-plain-locals!
     (Fn [(Ref SpecializedExpr) (Ref (Array String)) (Ref (Array Int))] ()))
(defn collect-plain-locals! [expression seen winners]
  (match-ref expression
    (SpecializedExpr.Let _ _ reference value body)
      (do
        (note-plain-binder! reference seen winners)
        (collect-plain-locals! (Box.peek value) seen winners)
        (collect-plain-locals! (Box.peek body) seen winners))
    (SpecializedExpr.Match _ _ _ scrutinee branches)
      (do
        (collect-plain-locals! (Box.peek scrutinee) seen winners)
        (for [i 0 (Array.length branches)]
          (let-do [branch (Array.unsafe-nth branches i)
                   bindings (SpecializedMatchBranch.bindings branch)]
            (for [j 0 (Array.length bindings)]
              (note-plain-binder! (Array.unsafe-nth bindings j) seen winners))
            (collect-plain-locals!
              (Box.peek (SpecializedMatchBranch.body branch))
              seen
              winners))))
    (SpecializedExpr.Do _ _ expressions)
      (for [i 0 (Array.length expressions)]
        (collect-plain-locals!
          (Box.peek (Array.unsafe-nth expressions i))
          seen
          winners))
    (SpecializedExpr.ArrayLit _ _ expressions)
      (for [i 0 (Array.length expressions)]
        (collect-plain-locals!
          (Box.peek (Array.unsafe-nth expressions i))
          seen
          winners))
    (SpecializedExpr.StaticArrayLit _ _ expressions)
      (for [i 0 (Array.length expressions)]
        (collect-plain-locals!
          (Box.peek (Array.unsafe-nth expressions i))
          seen
          winners))
    (SpecializedExpr.Call _ _ callee arguments)
      (do
        (collect-plain-locals! (Box.peek callee) seen winners)
        (for [i 0 (Array.length arguments)]
          (collect-plain-locals!
            (Box.peek (Array.unsafe-nth arguments i))
            seen
            winners)))
    (SpecializedExpr.GlobalCall _ _ _ _ _ arguments)
      (for [i 0 (Array.length arguments)]
        (collect-plain-locals!
          (Box.peek (Array.unsafe-nth arguments i))
          seen
          winners))
    (SpecializedExpr.If _ _ condition then-branch else-branch)
      (do
        (collect-plain-locals! (Box.peek condition) seen winners)
        (collect-plain-locals! (Box.peek then-branch) seen winners)
        (collect-plain-locals! (Box.peek else-branch) seen winners))
    (SpecializedExpr.While _ _ condition body)
      (do
        (collect-plain-locals! (Box.peek condition) seen winners)
        (collect-plain-locals! (Box.peek body) seen winners))
    (SpecializedExpr.Set _ _ _ value)
      (collect-plain-locals! (Box.peek value) seen winners)
    (SpecializedExpr.Lambda _ _ parameters body)
      (do
        (for [i 0 (Array.length parameters)]
          (note-plain-binder! (Array.unsafe-nth parameters i) seen winners))
        (collect-plain-locals! (Box.peek body) seen winners))
    (SpecializedExpr.Annotation _ _ inner _)
      (collect-plain-locals! (Box.peek inner) seen winners)
    _ ()))

(doc set-plain-locals! "computes and installs the plain-name grants for one
rendered C function: its parameters and prelude binders first, then every
binder in the body, first-of-a-name wins.")
(defn set-plain-locals! [prelude-binders body]
  (let-do [seen (the (Array String) [])
           winners (the (Array Int) [])]
    (for [i 0 (Array.length prelude-binders)]
      (note-plain-binder! (Array.unsafe-nth prelude-binders i) &seen &winners))
    (collect-plain-locals! body &seen &winners)
    (set! *plain-local-ids* winners)))

(defn clear-plain-locals! [] (set! *plain-local-ids* []))

(defn callable-prototype [symbol signature parameters]
  (match-ref signature
    (MonoType.Function arguments return-type)
      (match (render-type (Box.peek return-type))
        (Result.Success rendered-return)
          (let-do [buffer (StringBuf.create)
                   ignored-a (StringBuf.append-str &buffer &rendered-return)
                   ignored-b (StringBuf.append-char &buffer \space)
                   ignored-c (StringBuf.append-str &buffer &(sanitize symbol))
                   ignored-d (StringBuf.append-char &buffer \()
                   parameter-result (append-parameters! &buffer
                                                        arguments
                                                        parameters)]
            (match parameter-result
              (Result.Success _)
                (do
                  (StringBuf.append-str &buffer ");")
                  (Result.Success (StringBuf.to-string &buffer)))
              (Result.Error error) (Result.Error error)))
        (Result.Error error) (Result.Error error))
    _
      (Result.Error
        (BackendError.init @"callable declaration has a non-function signature"))))

(defn prototype [declaration]
  (match-ref declaration
    (BackendDeclaration.Function symbol signature parameters _)
      (callable-prototype symbol (Box.peek signature) parameters)
    (BackendDeclaration.Global symbol signature _)
      (match (render-type (Box.peek signature))
        (Result.Success rendered)
          (Result.Success
            (String.concat &[@"extern " rendered @" " (sanitize symbol) @";"]))
        (Result.Error error) (Result.Error error))
    (BackendDeclaration.Intrinsic symbol signature external)
      (match-ref external
        ;; a `register`ed external C function is declared by an included header;
        ;; emitting our own prototype would conflict (e.g. `const` qualifiers).
        (Maybe.Just _)
        (Result.Success (String.copy ""))
        (Maybe.Nothing)
        (match-ref (Box.peek signature)
          (MonoType.Function _ _)
            (callable-prototype symbol (Box.peek signature) &[])
          _
            (match (render-type (Box.peek signature))
              (Result.Success rendered)
                (Result.Success
                  (String.concat
                    &[@"extern " rendered @" " (sanitize symbol) @";"]))
              (Result.Error error) (Result.Error error))))
    (BackendDeclaration.Constructor symbol signature _)
      (callable-prototype symbol (Box.peek signature) &[])
    (BackendDeclaration.Template symbol signature _ _)
      (callable-prototype symbol (Box.peek signature) &[])
    (BackendDeclaration.SourceTemplate _ _ _ _ _)
      (match (source-template-declaration declaration)
        (Result.Success rendered) (Result.Success (String.append &rendered ";"))
        (Result.Error error) (Result.Error error))))

(defn template-element-type [signature]
  (match-ref signature
    (MonoType.Function arguments _)
      (if (Int.= 1 (Array.length arguments))
        (match-ref (Box.peek (Array.unsafe-nth arguments 0))
          (MonoType.Reference container _)
            (match-ref (Box.peek container)
              (MonoType.Named _ type-arguments)
                (if (Int.= 1 (Array.length type-arguments))
                  (Result.Success
                    (MonoType.copy
                      (Box.peek (Array.unsafe-nth type-arguments 0))))
                  (Result.Error
                    (BackendError.init
                      @"template container must have one type argument")))
              _
                (Result.Error
                  (BackendError.init
                    @"template argument must reference a named container")))
          _
            (Result.Error
              (BackendError.init @"template argument must be a reference")))
        (Result.Error (BackendError.init @"template must have one argument")))
    _
      (Result.Error
        (BackendError.init @"template must have a function signature"))))

(defn prototype-head [declaration]
  (match (prototype declaration)
    (Result.Success rendered)
      (Result.Success
        (String.byte-slice &rendered 0 (Int.dec (String.length &rendered))))
    (Result.Error error) (Result.Error error)))

(defn concrete-type-listed? [types type]
  (let-do [found false
           n (Array.length types)]
    (for [i 0 n]
      (when (Type.same-representation? (Box.peek (Array.unsafe-nth types i))
                                       type)
        (set! found true)))
    found))

(defn source-nominal? [constructors name]
  (let-do [found false
           n (Array.length constructors)]
    (for [i 0 n]
      (match-ref (Box.peek
          (CoreConstructorDeclaration.result (Array.unsafe-nth constructors i)))
        (CoreType.Named candidate _) (when (= candidate name) (set! found true))
        _ ()))
    found))

(defn collect-nominal-application! [constructors type visiting ordered]
  (if (concrete-type-listed? ordered type)
    (Result.Success ())
    (match-ref type
      (MonoType.Named name arguments)
      (if (source-nominal? constructors name)
        (if (concrete-type-listed? visiting type)
          (Result.Error
            (BackendError.init
              @"recursive by-value nominal layouts are not supported"))
          (let-do [result (the (Result Unit BackendError) (Result.Success ()))
                   ignored-visiting (Array.push-back! visiting
                                                      (Box.init (MonoType.copy type)))
                   n (Array.length constructors)]
            (for [i 0 n]
              (match-ref &result
                (Result.Success _)
                  (let [constructor (Array.unsafe-nth constructors i)]
                    (match-ref (Box.peek
                        (CoreConstructorDeclaration.result constructor))
                      (CoreType.Named candidate _)
                        (when (= candidate name)
                          (match (collect-template-bindings
                              (Box.peek
                                (CoreConstructorDeclaration.result constructor))
                              type
                              &[])
                            (Result.Success bindings)
                              (let [fields (CoreConstructorDeclaration.arguments constructor)
                                    field-count (Array.length fields)]
                                (for [j 0 field-count]
                                  (match-ref &result
                                    (Result.Success _)
                                      (match (concretize-core-type &bindings
                                                                   (Box.peek (Array.unsafe-nth fields
                                                                                               j)))
                                        (Result.Success field-type)
                                          (set! result
                                                (collect-nominal-application! constructors
                                                                              &field-type
                                                                              visiting
                                                                              ordered))
                                        (Result.Error error)
                                          (set! result (Result.Error error)))
                                    (Result.Error _) ())))
                            (Result.Error error)
                              (set! result (Result.Error error))))
                      _ ()))
                (Result.Error _) ()))
            (match result
              (Result.Success _)
                (do
                  (Array.push-back! ordered (Box.init (MonoType.copy type)))
                  (Result.Success ()))
              (Result.Error error) (Result.Error error))))
        ;; a builtin container (Array, Box, Ptr, ...) stores its payload
        ;; behind a heap pointer, never inline, so a recursive occurrence
        ;; through one is legal: skip any type already being visited (that
        ;; skip also terminates the walk), and descend into the rest only
        ;; for typedef ordering.
        (let-do [result (the (Result Unit BackendError) (Result.Success ()))
                 n (Array.length arguments)]
          (for [i 0 n]
            (match-ref &result
              (Result.Success _)
                (let [argument (Box.peek (Array.unsafe-nth arguments i))]
                  (unless (concrete-type-listed? visiting argument)
                    (set! result
                          (collect-nominal-application! constructors
                                                        argument
                                                        visiting
                                                        ordered))))
              (Result.Error _) ()))
          result))
      (MonoType.Reference inner _)
      (collect-nominal-application! constructors
                                    (Box.peek inner)
                                    visiting
                                    ordered)
      ;; A function value is a fixed-size `Lambda` struct: a callback plus an
      ;; environment pointer, never its argument or result inline. So a member
      ;; typed `(Fn [T] T)` does NOT make T contain itself by value — descend to
      ;; collect the types for typedef ORDERING, but skip any type already being
      ;; visited instead of reporting unsupported recursion. Skipping is also
      ;; what terminates the walk: in produces-output/function_members,
      ;; `(deftype SelfReferencer [hp Int f (λ [SelfReferencer] SelfReferencer)])`
      ;; has a Lambda over SelfReferencer forever.
      (MonoType.Function arguments result-type)
      (let-do [result (the (Result Unit BackendError) (Result.Success ()))
               n (Array.length arguments)]
        (for [i 0 n]
          (match-ref &result
            (Result.Success _)
              (let [argument (Box.peek (Array.unsafe-nth arguments i))]
                (unless (concrete-type-listed? visiting argument)
                  (set! result
                        (collect-nominal-application! constructors
                                                      argument
                                                      visiting
                                                      ordered))))
            (Result.Error _) ()))
        (match result
          (Result.Success _)
            (let [inner (Box.peek result-type)]
              (if (concrete-type-listed? visiting inner)
                (Result.Success ())
                (collect-nominal-application! constructors
                                              inner
                                              visiting
                                              ordered)))
          (Result.Error error) (Result.Error error)))
      _
      (Result.Success ()))))

(defn nominal-applications [module]
  (let-do [result (the (Result Unit BackendError) (Result.Success ()))
           visiting (the (Array (Box MonoType)) [])
           ordered (the (Array (Box MonoType)) [])
           declarations (BackendModule.declarations module)
           constructors (BackendModule.constructors module)
           declaration-count (Array.length declarations)]
    (for [i 0 declaration-count]
      (match-ref &result
        (Result.Success _)
          (match-ref (Array.unsafe-nth declarations i)
            (BackendDeclaration.Function _ signature _ _)
              (set! result
                    (collect-nominal-application! constructors
                                                  (Box.peek signature)
                                                  &visiting
                                                  &ordered))
            (BackendDeclaration.Global _ signature _)
              (set! result
                    (collect-nominal-application! constructors
                                                  (Box.peek signature)
                                                  &visiting
                                                  &ordered))
            (BackendDeclaration.Intrinsic _ signature _)
              (set! result
                    (collect-nominal-application! constructors
                                                  (Box.peek signature)
                                                  &visiting
                                                  &ordered))
            (BackendDeclaration.Constructor _ signature _)
              (set! result
                    (collect-nominal-application! constructors
                                                  (Box.peek signature)
                                                  &visiting
                                                  &ordered))
            (BackendDeclaration.Template _ signature _ _)
              (set! result
                    (collect-nominal-application! constructors
                                                  (Box.peek signature)
                                                  &visiting
                                                  &ordered))
            (BackendDeclaration.SourceTemplate _ signature _ _ _)
              (set! result
                    (collect-nominal-application! constructors
                                                  (Box.peek signature)
                                                  &visiting
                                                  &ordered)))
        (Result.Error _) ()))
    (let [roots (BackendModule.roots module)
          root-count (Array.length roots)]
      (for [i 0 root-count]
        (match-ref &result
          (Result.Success _)
            (let [root-type (specialized-type (Box.peek (Array.unsafe-nth roots
                                                                          i)))]
              (set! result
                    (collect-nominal-application! constructors
                                                  &root-type
                                                  &visiting
                                                  &ordered)))
          (Result.Error _) ())))
    (match result
      (Result.Success _) (Result.Success ordered)
      (Result.Error error) (Result.Error error))))

(defn append-nominal-variant! [buffer variant concrete-result]
  (match (collect-template-bindings
      (Box.peek (CoreConstructorDeclaration.result variant))
      concrete-result
      &[])
    (Result.Success bindings)
      (let-do [result (the (Result Unit BackendError) (Result.Success ()))
               fields (CoreConstructorDeclaration.arguments variant)
               field-count (Array.length fields)]
        (StringBuf.append-str buffer "    struct {
")
        (let-do [emitted 0]
          (for [i 0 field-count]
            (match-ref &result
              (Result.Success _)
                (match (render-core-type &bindings
                                         (Box.peek (Array.unsafe-nth fields i)))
                  (Result.Success field-type)
                  ;; a unit member has no C storage; eliding it keeps the
                  ;; remaining member_i names aligned with their field index.
                  (unless-do (String.= &field-type "void")
                    (StringBuf.append-str buffer "      ")
                    (StringBuf.append-str buffer &field-type)
                    (StringBuf.append-str buffer
                                          &(String.concat &[@" member_"
                                                            (Int.str i)
                                                            @";
"]))
                    (set! emitted (Int.inc emitted)))
                  (Result.Error error)
                  (set! result (Result.Error error)))
              (Result.Error _) ()))
          ;; C forbids empty structs: a field-less (or all-unit) variant keeps
          ;; a placeholder byte.
          (when (Int.= emitted 0)
            (StringBuf.append-str buffer "      unsigned char unused;
")))
        (match result
          (Result.Success _)
            (do
              (StringBuf.append-str buffer
                                    &(String.concat
                                      &[@"    } variant_"
                                        (Int.str
                                          @(CoreConstructorDeclaration.tag variant))
                                        @";
"]))
              (Result.Success ()))
          (Result.Error error) (Result.Error error)))
    (Result.Error error) (Result.Error error)))

(doc last-declaration-start "the index at which the LAST declaration of a
type name begins in the constructor array. A user deftype may shadow an
earlier (e.g. Core) type of the same name; tags restart at the boundary, and
the later declaration is the one later code means.")
(defn last-declaration-start [constructors name]
  (let-do [start -1
           previous-tag -1
           n (Array.length constructors)]
    (for [i 0 n]
      (let [c (Array.unsafe-nth constructors i)]
        (match-ref (Box.peek (CoreConstructorDeclaration.result c))
          (CoreType.Named rname _)
            (when-do (= rname name)
              (if (Int.< start 0)
                (set! start i)
                (when (Int.<= @(CoreConstructorDeclaration.tag c) previous-tag)
                  (set! start i)))
              (set! previous-tag @(CoreConstructorDeclaration.tag c)))
          _ ())))
    start))

(defn render-nominal-definition [constructors concrete-result]
  (match-ref concrete-result
    (MonoType.Named source-name _)
      (match (render-type concrete-result)
        (Result.Success c-name)
          (let-do [result (the (Result Unit BackendError) (Result.Success ()))
                   buffer (StringBuf.create)
                   group-start (last-declaration-start constructors source-name)
                   single-constructor (single-constructor-name? constructors
                                                                source-name)
                   constructor-count (Array.length constructors)]
            ;; the payload union comes FIRST and the tag LAST, matching the
            ;; reference layout: `Unsafe.coerce` of a sum reference to a payload
            ;; pointer (e.g. `Maybe.unsafe-ptr`) relies on the payload sitting
            ;; at offset zero.
            (StringBuf.append-str &buffer "typedef struct ")
            (StringBuf.append-str &buffer &c-name)
            (StringBuf.append-str &buffer " {
  union {
")
            (for [i 0 constructor-count]
              (match-ref &result
                (Result.Success _)
                  (let [variant (Array.unsafe-nth constructors i)]
                    (match-ref (Box.peek
                        (CoreConstructorDeclaration.result variant))
                      (CoreType.Named variant-name _)
                        (when (and (= variant-name source-name)
                                   (Int.>= i group-start))
                          (set! result
                                (append-nominal-variant! &buffer
                                                         variant
                                                         concrete-result)))
                      _ ()))
                (Result.Error _) ()))
            (match result
              (Result.Success _) (do (StringBuf.append-str &buffer "  } data;
") (unless single-constructor (StringBuf.append-str &buffer "  int tag;
")) (StringBuf.append-str &buffer "} ") (StringBuf.append-str &buffer &c-name) (StringBuf.append-str &buffer
                                                                                                     ";
") (Result.Success (StringBuf.to-string &buffer)))
              (Result.Error error) (Result.Error error)))
        (Result.Error error) (Result.Error error))
    _
      (Result.Error
        (BackendError.init @"nominal application is not a named type"))))

(doc nominal-definitions "renders one unmanaged nominal layout per reachable
concrete application. Each constructor receives its stable source-order tag.")
(defn nominal-definitions [module]
  (match (nominal-applications module)
    (Result.Success applications)
      (let-do [result (the (Result String BackendError)
                           (Result.Success (String.copy "")))
               constructors (BackendModule.constructors module)
               n (Array.length &applications)]
        ;; forward-declare every nominal struct first: a recursive type
        ;; reaches itself through a heap indirection (`Box`, `Ptr`), whose
        ;; pointer member must name the struct before its full definition.
        (for [i 0 n]
          (match-ref &result
            (Result.Success output)
              (match (render-type (Box.peek (Array.unsafe-nth &applications i)))
                (Result.Success c-name)
                  (set! result
                        (Result.Success
                          (String.concat
                            &[(String.copy output)
                              @"typedef struct "
                              (String.copy &c-name)
                              @" "
                              (String.copy &c-name)
                              @";
"])))
                (Result.Error error) (set! result (Result.Error error)))
            (Result.Error _) ()))
        (for [i 0 n]
          (match-ref &result
            (Result.Success output)
              (match (render-nominal-definition constructors
                                                (Box.peek (Array.unsafe-nth &applications
                                                                            i)))
                (Result.Success rendered)
                  (set! result
                        (Result.Success
                          (if (String.empty? output)
                            rendered
                            (String.concat &[(String.copy output) @"
" rendered]))))
                (Result.Error error) (set! result (Result.Error error)))
            (Result.Error _) ()))
        result)
    (Result.Error error) (Result.Error error)))

(doc constructor-definition "renders one reachable nominal constructor.")
(defn constructor-definition [constructors declaration]
  (match-ref declaration
    (BackendDeclaration.Constructor _ signature constructor)
      (match (prototype-head declaration)
        (Result.Success head)
          (match-ref (Box.peek signature)
            (MonoType.Function arguments result-type)
              (match (render-type (Box.peek result-type))
                (Result.Success c-name)
                  (let-do [buffer (StringBuf.create)
                           ignored-head (StringBuf.append-str &buffer &head)]
                    (StringBuf.append-str &buffer " {
  ")
                    (StringBuf.append-str &buffer &c-name)
                    (StringBuf.append-str &buffer " value;
")
                    (match-ref (Box.peek
                        (CoreConstructorDeclaration.result constructor))
                      (CoreType.Named source-name _)
                        (unless-do (single-constructor-name? constructors
                                                             source-name)
                          (StringBuf.append-str &buffer "  value.tag = ")
                          (StringBuf.append-str &buffer
                                                &(Int.str
                                                  @(CoreConstructorDeclaration.tag constructor)))
                          (StringBuf.append-str &buffer ";
"))
                      _ ())
                    (let [n (Array.length arguments)]
                      (for [i 0 n]
                        ;; unit members have no C storage and no C parameter
                        ;; (append-parameters! skips them, keeping the
                        ;; original argI numbering for the rest).
                        (unless-do (unit-type?
                            (Box.peek (Array.unsafe-nth arguments i)))
                          (StringBuf.append-str &buffer "  value.data.variant_")
                          (StringBuf.append-str &buffer
                                                &(Int.str
                                                  @(CoreConstructorDeclaration.tag constructor)))
                          (StringBuf.append-str &buffer
                                                &(String.concat
                                                  &[@".member_"
                                                    (Int.str i)
                                                    @" = arg"
                                                    (Int.str i)
                                                    @";
"])))))
                    (StringBuf.append-str &buffer "  return value;
}")
                    (Result.Success (StringBuf.to-string &buffer)))
                (Result.Error error) (Result.Error error))
            _
              (Result.Error
                (BackendError.init @"constructor has a non-function signature")))
        (Result.Error error) (Result.Error error))
    _
      (Result.Error
        (BackendError.init @"declaration is not a nominal constructor"))))

(defn constructor-definitions [module]
  (let-do [result (the (Result Unit BackendError) (Result.Success ()))
           buffer (StringBuf.create)
           rendered-any false
           declarations (BackendModule.declarations module)
           n (Array.length declarations)]
    (for [i 0 n]
      (match-ref &result
        (Result.Success _)
          (let [declaration (Array.unsafe-nth declarations i)]
            (match-ref declaration
              (BackendDeclaration.Constructor _ _ _)
                (match (constructor-definition (BackendModule.constructors module)
                                               declaration)
                  (Result.Success rendered)
                    (do (when rendered-any (StringBuf.append-str &buffer "

")) (StringBuf.append-str &buffer &rendered) (set! rendered-any true))
                  (Result.Error error) (set! result (Result.Error error)))
              _ ()))
        (Result.Error _) ()))
    (match result
      (Result.Success _) (Result.Success (StringBuf.to-string &buffer))
      (Result.Error error) (Result.Error error))))

(doc function-definition "renders one typed user-function body when its
signature and every emitted expression are in the unmanaged scalar subset.")
(defn closure-env-typedef [captures env-type]
  (let-do [buffer (StringBuf.create)
           failure (the (Maybe BackendError) (Maybe.Nothing))
           ignored-open (StringBuf.append-str &buffer "typedef struct { ")]
    (for [i 0 (Array.length captures)]
      (match-ref &failure
        (Maybe.Nothing)
          (match (render-type (Box.peek (Pair.b (Array.unsafe-nth captures i))))
            (Result.Success rendered)
              (do
                (StringBuf.append-str &buffer &rendered)
                (StringBuf.append-str &buffer " f")
                (StringBuf.append-str &buffer &(Int.str i))
                (StringBuf.append-str &buffer "; "))
            (Result.Error error) (set! failure (Maybe.Just error)))
        (Maybe.Just _) ()))
    (StringBuf.append-str &buffer "} ")
    (StringBuf.append-str &buffer env-type)
    (StringBuf.append-char &buffer \;)
    (match-ref &failure
      (Maybe.Just error) (Result.Error @error)
      (Maybe.Nothing) (Result.Success (StringBuf.to-string &buffer)))))

(defn closure-head [symbol signature parameters env-type]
  (match-ref signature
    (MonoType.Function arguments return-type)
      (match (render-type (Box.peek return-type))
        (Result.Success rendered-return)
          (let-do [buffer (StringBuf.create)
                   ignored-a (StringBuf.append-str &buffer &rendered-return)
                   ignored-b (StringBuf.append-char &buffer \space)
                   ignored-c (StringBuf.append-str &buffer &(sanitize symbol))
                   ignored-d (StringBuf.append-char &buffer \()
                   ignored-e (StringBuf.append-str &buffer env-type)
                   ignored-f (StringBuf.append-str &buffer "* _env")]
            ;; the env is always a parameter, so never let `append-parameters!`
            ;; emit its zero-argument "void" marker (which would fuse into
            ;; "_envvoid"); only append the regular parameters when present.
            (if (Int.> (Array.length arguments) 0)
              (do
                (StringBuf.append-str &buffer ", ")
                (match (append-parameters! &buffer arguments parameters)
                  (Result.Success _)
                    (do
                      (StringBuf.append-char &buffer \))
                      (Result.Success (StringBuf.to-string &buffer)))
                  (Result.Error error) (Result.Error error)))
              (do
                (StringBuf.append-char &buffer \))
                (Result.Success (StringBuf.to-string &buffer)))))
        (Result.Error error) (Result.Error error))
    _ (Result.Error (BackendError.init @"closure has a non-function signature"))))

(defn closure-delete-symbol [delete-symbols value-type]
  (let-do [result (the (Maybe String) (Maybe.Nothing))
           key (CAbi.type-key value-type)
           n (Array.length delete-symbols)]
    (for [i 0 n]
      (let [entry (Array.unsafe-nth delete-symbols i)]
        (when (String.= (Pair.a entry) &key)
          (set! result (Maybe.Just (sanitize (Pair.b entry)))))))
    result))

(defn closure-copy-symbol [copy-symbols value-type]
  (let-do [result (the (Maybe String) (Maybe.Nothing))
           key (CAbi.type-key value-type)
           n (Array.length copy-symbols)]
    (for [i 0 n]
      (let [entry (Array.unsafe-nth copy-symbols i)]
        (when (String.= (Pair.a entry) &key)
          (set! result (Maybe.Just (sanitize (Pair.b entry)))))))
    result))

(doc closure-env-copy-definition "renders the callback stored in `Lambda.copy`:
it allocates a fresh environment and deep-copies managed captures. A recursive
self edge is rebuilt as a non-owning view of the fresh environment.")
(defn closure-env-copy-definition [closure-fn delete-symbols copy-symbols]
  (let-do [lambda-symbol (sanitize (ClosureFunction.symbol closure-fn))
           env-type (String.concat &[(String.copy &lambda-symbol) @"_env"])
           captures (ClosureFunction.captures closure-fn)
           buffer (StringBuf.create)]
    (StringBuf.append-str &buffer "void* ")
    (StringBuf.append-str &buffer &env-type)
    (StringBuf.append-str &buffer "_copy(void* _raw) {
  ")
    (StringBuf.append-str &buffer &env-type)
    (StringBuf.append-str &buffer "* _env = _raw;
  ")
    (StringBuf.append-str &buffer &env-type)
    (StringBuf.append-str &buffer "* _copy = CARP_MALLOC(sizeof(")
    (StringBuf.append-str &buffer &env-type)
    (StringBuf.append-str &buffer "));
")
    (for [i 0 (Array.length captures)]
      (let [capture (Array.unsafe-nth captures i)
            capture-type (Box.peek (Pair.b capture))
            field (String.concat &[@"f" (Int.str i)])]
        (if (match-ref capture-type (MonoType.Function _ _) true _ false)
          (do
            (StringBuf.append-str &buffer "  if (_env->")
            (StringBuf.append-str &buffer &field)
            (StringBuf.append-str &buffer ".env == _env && _env->")
            (StringBuf.append-str &buffer &field)
            (StringBuf.append-str &buffer ".callback == (void*)")
            (StringBuf.append-str &buffer &lambda-symbol)
            (StringBuf.append-str &buffer ") {
    _copy->")
            (StringBuf.append-str &buffer &field)
            (StringBuf.append-str &buffer " = (Lambda){ .callback = (void*)")
            (StringBuf.append-str &buffer &lambda-symbol)
            (StringBuf.append-str &buffer
                                  ", .env = _copy, .delete = NULL, .copy = NULL };
  } else ")
            (match (closure-copy-symbol copy-symbols capture-type)
              (Maybe.Just symbol)
                (do
                  (StringBuf.append-str &buffer "if (_env->")
                  (StringBuf.append-str &buffer &field)
                  (StringBuf.append-str &buffer ".env) {
    _copy->")
                  (StringBuf.append-str &buffer &field)
                  (StringBuf.append-str &buffer " = ")
                  (StringBuf.append-str &buffer &symbol)
                  (StringBuf.append-str &buffer "(&_env->")
                  (StringBuf.append-str &buffer &field)
                  (StringBuf.append-str &buffer ");
  } else {
    _copy->")
                  (StringBuf.append-str &buffer &field)
                  (StringBuf.append-str &buffer " = _env->")
                  (StringBuf.append-str &buffer &field)
                  (StringBuf.append-str &buffer ";
  }
"))
              (Maybe.Nothing) (do (StringBuf.append-str &buffer "{
    _copy->") (StringBuf.append-str &buffer &field) (StringBuf.append-str &buffer
                                                                          " = _env->") (StringBuf.append-str &buffer
                                                                                                             &field) (StringBuf.append-str &buffer
                                                                                                                                           ";
  }
"))))
          (match (closure-delete-symbol delete-symbols capture-type)
            (Maybe.Just _)
              (match (closure-copy-symbol copy-symbols capture-type)
                (Maybe.Just symbol)
                  (do
                    (StringBuf.append-str &buffer "  _copy->")
                    (StringBuf.append-str &buffer &field)
                    (StringBuf.append-str &buffer " = ")
                    (StringBuf.append-str &buffer &symbol)
                    (StringBuf.append-str &buffer "(&_env->")
                    (StringBuf.append-str &buffer &field)
                    (StringBuf.append-str &buffer ");
"))
                (Maybe.Nothing)
                  (do
                    (StringBuf.append-str &buffer "  _copy->")
                    (StringBuf.append-str &buffer &field)
                    (StringBuf.append-str &buffer " = _env->")
                    (StringBuf.append-str &buffer &field)
                    (StringBuf.append-str &buffer ";
")))
            (Maybe.Nothing)
              (do
                (StringBuf.append-str &buffer "  _copy->")
                (StringBuf.append-str &buffer &field)
                (StringBuf.append-str &buffer " = _env->")
                (StringBuf.append-str &buffer &field)
                (StringBuf.append-str &buffer ";
"))))))
    (StringBuf.append-str &buffer "  return _copy;
}")
    (StringBuf.to-string &buffer)))

(doc closure-env-delete-definition "renders the callback stored in
`Lambda.delete`: it releases every managed capture. `Function.delete` invokes
this callback and then frees the environment cell itself.")
(defn closure-env-delete-definition [closure-fn delete-symbols]
  (let-do [env-type (String.concat
             &[(sanitize (ClosureFunction.symbol closure-fn)) @"_env"])
           captures (ClosureFunction.captures closure-fn)
           buffer (StringBuf.create)]
    (StringBuf.append-str &buffer "void ")
    (StringBuf.append-str &buffer &env-type)
    (StringBuf.append-str &buffer "_delete(void* _raw) {
  ")
    (StringBuf.append-str &buffer &env-type)
    (StringBuf.append-str &buffer "* _env = _raw;
")
    (for [i 0 (Array.length captures)]
      (let [capture (Array.unsafe-nth captures i)]
        (match (closure-delete-symbol delete-symbols (Box.peek (Pair.b capture)))
          (Maybe.Just symbol)
            (do
              (StringBuf.append-str &buffer "  ")
              (StringBuf.append-str &buffer &symbol)
              (StringBuf.append-str &buffer "(_env->f")
              (StringBuf.append-str &buffer &(Int.str i))
              (StringBuf.append-str &buffer ");
"))
          (Maybe.Nothing) ())))
    (StringBuf.append-char &buffer \})
    (StringBuf.to-string &buffer)))

(defn closure-function-definition [constructors closure-fn]
  (let-do [signature (Box.peek (ClosureFunction.signature closure-fn))
           captures (ClosureFunction.captures closure-fn)
           env-type (String.concat
             &[(sanitize (ClosureFunction.symbol closure-fn)) @"_env"])
           prelude (Array.copy (ClosureFunction.parameters closure-fn))]
    (for [i 0 (Array.length captures)]
      (Array.push-back! &prelude @(Pair.a (Array.unsafe-nth captures i))))
    (set-plain-locals! &prelude (Box.peek (ClosureFunction.body closure-fn)))
    (match-ref signature
      (MonoType.Function _ return-type)
        (match (closure-head (ClosureFunction.symbol closure-fn)
                             signature
                             (ClosureFunction.parameters closure-fn)
                             &env-type)
          (Result.Success head)
            (let-do [buffer (StringBuf.create)
                     ignored-head (StringBuf.append-str &buffer &head)
                     ignored-open (StringBuf.append-str &buffer " {")
                     ignored-nl (StringBuf.append-char &buffer \newline)
                     failure (the (Maybe BackendError) (Maybe.Nothing))]
              (for [i 0 (Array.length captures)]
                (match-ref &failure
                  (Maybe.Nothing)
                    (let [capture (Array.unsafe-nth captures i)]
                      (match (render-type (Box.peek (Pair.b capture)))
                        (Result.Success rendered)
                          (do
                            (StringBuf.append-str &buffer "  ")
                            (StringBuf.append-str &buffer &rendered)
                            (StringBuf.append-char &buffer \space)
                            (StringBuf.append-str &buffer
                                                  &(local-symbol (Pair.a capture)))
                            (StringBuf.append-str &buffer " = _env->f")
                            (StringBuf.append-str &buffer &(Int.str i))
                            (StringBuf.append-char &buffer \;)
                            (StringBuf.append-char &buffer \newline))
                        (Result.Error error) (set! failure (Maybe.Just error))))
                  (Maybe.Just _) ()))
              (match-ref &failure
                (Maybe.Just error) (Result.Error @error)
                (Maybe.Nothing)
                  (let [destination (ResultDestination.Return
                          (Box.init (MonoType.copy (Box.peek return-type))))]
                    (match (append-result! constructors
                                           &buffer
                                           (Box.peek (ClosureFunction.body closure-fn))
                                           &destination
                                           1)
                      (Result.Success _)
                        (do
                          (StringBuf.append-char &buffer \})
                          (Result.Success (StringBuf.to-string &buffer)))
                      (Result.Error error) (Result.Error error)))))
          (Result.Error error) (Result.Error error))
      _
        (Result.Error
          (BackendError.init @"closure has a non-function signature")))))

(doc closure-prototypes-of "renders environment typedefs and callback prototypes
for every capturing closure, emitted in the declarations section so both closure
sites and callback definitions can refer to them.")
(defn closure-prototypes-of [module]
  (let-do [result (the (Result Unit BackendError) (Result.Success ()))
           buffer (StringBuf.create)
           closures (BackendModule.closure-functions module)
           n (Array.length closures)]
    (for [i 0 n]
      (match-ref &result
        (Result.Success _)
          (let [closure-fn (Array.unsafe-nth closures i)
                env-type (String.concat
                  &[(sanitize (ClosureFunction.symbol closure-fn)) @"_env"])]
            (match (closure-env-typedef (ClosureFunction.captures closure-fn)
                                        &env-type)
              (Result.Success typedef)
                (match (closure-head (ClosureFunction.symbol closure-fn)
                                     (Box.peek (ClosureFunction.signature closure-fn))
                                     (ClosureFunction.parameters closure-fn)
                                     &env-type)
                  (Result.Success head)
                    (do
                      (StringBuf.append-str &buffer &typedef)
                      (StringBuf.append-char &buffer \newline)
                      (StringBuf.append-str &buffer "void ")
                      (StringBuf.append-str &buffer &env-type)
                      (StringBuf.append-str &buffer "_delete(void* _raw);")
                      (StringBuf.append-char &buffer \newline)
                      (StringBuf.append-str &buffer "void* ")
                      (StringBuf.append-str &buffer &env-type)
                      (StringBuf.append-str &buffer "_copy(void* _raw);")
                      (StringBuf.append-char &buffer \newline)
                      (StringBuf.append-str &buffer &head)
                      (StringBuf.append-char &buffer \;)
                      (StringBuf.append-char &buffer \newline))
                  (Result.Error error) (set! result (Result.Error error)))
              (Result.Error error) (set! result (Result.Error error))))
        (Result.Error _) ()))
    (match result
      (Result.Success _) (Result.Success (StringBuf.to-string &buffer))
      (Result.Error error) (Result.Error error))))

(doc closure-definitions-of "renders every capturing closure callback definition
with a leading environment pointer and captured-value unpacking.")
(defn closure-definitions-of [module]
  (let-do [result (the (Result Unit BackendError) (Result.Success ()))
           buffer (StringBuf.create)
           closures (BackendModule.closure-functions module)
           n (Array.length closures)]
    (for [i 0 n]
      (match-ref &result
        (Result.Success _)
          (let-do [closure-fn (Array.unsafe-nth closures i)]
            (StringBuf.append-char &buffer \newline)
            (StringBuf.append-char &buffer \newline)
            (StringBuf.append-str &buffer
                                  &(closure-env-delete-definition closure-fn
                                                                  (BackendModule.delete-symbols module)))
            (StringBuf.append-char &buffer \newline)
            (StringBuf.append-char &buffer \newline)
            (StringBuf.append-str &buffer
                                  &(closure-env-copy-definition closure-fn
                                                                (BackendModule.delete-symbols module)
                                                                (BackendModule.copy-symbols module)))
            (match (closure-function-definition (BackendModule.constructors module)
                                                closure-fn)
              (Result.Success rendered)
                (do
                  (StringBuf.append-char &buffer \newline)
                  (StringBuf.append-char &buffer \newline)
                  (StringBuf.append-str &buffer &rendered))
              (Result.Error error) (set! result (Result.Error error))))
        (Result.Error _) ()))
    (match result
      (Result.Success _) (Result.Success (StringBuf.to-string &buffer))
      (Result.Error error) (Result.Error error))))

(defn function-definition [constructors declaration]
  (match-ref declaration
    (BackendDeclaration.Function fn-symbol signature parameters body)
      (let-do [ignored-context (set! *render-context* [(String.copy fn-symbol)])]
        (if (renderable-signature? constructors (Box.peek signature))
          (match-ref (Box.peek signature)
            (MonoType.Function _ return-type)
              (match (do
                  (set-plain-locals! parameters (Box.peek body))
                  (prototype-head declaration))
                (Result.Success head)
                  (let-do [buffer (StringBuf.create)
                           ignored-head (StringBuf.append-str &buffer &head)
                           ignored-open (StringBuf.append-str &buffer " {
")
                           destination (ResultDestination.Return
                             (Box.init (MonoType.copy (Box.peek return-type))))
                           body-result (append-result! constructors
                                                       &buffer
                                                       (Box.peek body)
                                                       &destination
                                                       1)]
                    (match body-result
                      (Result.Success _)
                        (do
                          (StringBuf.append-char &buffer \})
                          (Result.Success (StringBuf.to-string &buffer)))
                      (Result.Error error) (Result.Error error)))
                (Result.Error error) (Result.Error error))
            _
              (Result.Error
                (BackendError.init @"user function has a non-function signature")))
          (Result.Error
            (BackendError.init
              @"user function signature requires ownership or lifetime lowering"))))
    _ (Result.Error (BackendError.init @"declaration is not a user function"))))

(doc function-definitions "renders every reachable typed user-function body
supported by the unmanaged scalar subset.")
(defn function-definitions [module]
  (let-do [result (the (Result Unit BackendError) (Result.Success ()))
           buffer (StringBuf.create)
           rendered-any false
           declarations (BackendModule.declarations module)
           n (Array.length declarations)]
    (for [i 0 n]
      (match-ref &result
        (Result.Success _)
          (let [declaration (Array.unsafe-nth declarations i)]
            (match-ref declaration
              (BackendDeclaration.Function _ _ _ _)
                (match (function-definition (BackendModule.constructors module)
                                            declaration)
                  (Result.Success rendered)
                    (do (when rendered-any (StringBuf.append-str &buffer "

")) (StringBuf.append-str &buffer &rendered) (set! rendered-any true))
                  (Result.Error error) (set! result (Result.Error error)))
              _ ()))
        (Result.Error _) ()))
    (match result
      (Result.Success _)
        (match (closure-definitions-of module)
          (Result.Success closures)
            (do
              (StringBuf.append-str &buffer &closures)
              (Result.Success (StringBuf.to-string &buffer)))
          (Result.Error error) (Result.Error error))
      (Result.Error error) (Result.Error error))))

(defn constant-global-initializer? [expression]
  (match-ref expression
    (SpecializedExpr.IntLit _ _ _) true
    (SpecializedExpr.ByteLit _ _ _) true
    (SpecializedExpr.LongLit _ _ _) true
    (SpecializedExpr.FloatLit _ _ _) true
    (SpecializedExpr.DoubleLit _ _ _) true
    (SpecializedExpr.CharLit _ _ _) true
    (SpecializedExpr.BoolLit _ _ _) true
    (SpecializedExpr.Annotation _ _ inner _)
      (constant-global-initializer? (Box.peek inner))
    _ false))

(doc global-definition "renders one ownership-free scalar global with a
compile-time C initializer.")
(defn global-definition [constructors declaration]
  (match-ref declaration
    (BackendDeclaration.Global symbol signature body)
      (match-ref (Box.peek signature)
        ;; the reference elides unit definitions (issue #1296): no C storage.
        (MonoType.Unit)
        (Result.Success (String.copy ""))
        _
        (if (unmanaged-type? constructors (Box.peek signature))
          (match (render-type (Box.peek signature))
            (Result.Success rendered-type)
              (if (constant-global-initializer? (Box.peek body))
                (match (render-value-expression constructors (Box.peek body))
                  (Result.Success initializer)
                    (Result.Success
                      (String.concat
                        &[rendered-type
                          @" "
                          (sanitize symbol)
                          @" = "
                          initializer
                          @";"]))
                  (Result.Error error) (Result.Error error))
                (Result.Success
                  (String.concat &[rendered-type @" " (sanitize symbol) @";"])))
            (Result.Error error) (Result.Error error))
          ;; a managed global is declared bare here; `global-initializers` emits
          ;; its startup assignment through the ownership-aware `append-result!`.
          (match (render-type (Box.peek signature))
            (Result.Success rendered-type)
              (Result.Success
                (String.concat &[rendered-type @" " (sanitize symbol) @";"]))
            (Result.Error error) (Result.Error error))))
    _ (Result.Error (BackendError.init @"declaration is not a global value"))))

(doc global-definitions "renders every reachable ownership-free scalar
global definition.")
(defn global-definitions [module]
  (let-do [result (the (Result Unit BackendError) (Result.Success ()))
           buffer (StringBuf.create)
           rendered-any false
           declarations (BackendModule.declarations module)
           n (Array.length declarations)]
    (for [i 0 n]
      (match-ref &result
        (Result.Success _)
          (let [declaration (Array.unsafe-nth declarations i)]
            (match-ref declaration
              (BackendDeclaration.Global _ _ _)
                (match (global-definition (BackendModule.constructors module)
                                          declaration)
                  (Result.Success rendered)
                    (do (when rendered-any (StringBuf.append-str &buffer "

")) (StringBuf.append-str &buffer &rendered) (set! rendered-any true))
                  (Result.Error error) (set! result (Result.Error error)))
              _ ()))
        (Result.Error _) ()))
    (match result
      (Result.Success _) (Result.Success (StringBuf.to-string &buffer))
      (Result.Error error) (Result.Error error))))

(defn greater-score [left right] (if (Int.> left right) left right))

(sig expressions-global-score
     (Fn
       [(Ref BackendModule)
        (Ref (Array (Box SpecializedExpr)))
        (Ref (Array String))]
       Int))
(defn expressions-global-score [module expressions visited]
  (let-do [score 0
           n (Array.length expressions)]
    (for [i 0 n]
      (set! score
            (greater-score score
                           (expression-global-score module
                                                    (Box.peek (Array.unsafe-nth expressions
                                                                                i))
                                                    visited))))
    score))

(sig branches-global-score
     (Fn
       [(Ref BackendModule)
        (Ref (Array SpecializedMatchBranch))
        (Ref (Array String))]
       Int))
(defn branches-global-score [module branches visited]
  (let-do [score 0
           n (Array.length branches)]
    (for [i 0 n]
      (set! score
            (greater-score score
                           (expression-global-score module
                                                    (Box.peek
                                                      (SpecializedMatchBranch.body (Array.unsafe-nth branches
                                                                                                     i)))
                                                    visited))))
    score))

(sig global-symbol-score
     (Fn [(Ref BackendModule) (Ref String) (Ref (Array String))] Int))
(defn global-symbol-score [module symbol visited]
  (if (string-listed? visited symbol)
    0
    (let-do [score 0
             next (Array.copy visited)
             ignored-next (Array.push-back! &next (String.copy symbol))
             declarations (BackendModule.declarations module)
             n (Array.length declarations)]
      (for [i 0 n]
        (match-ref (Array.unsafe-nth declarations i)
          (BackendDeclaration.Global candidate _ body)
            (when (= candidate symbol)
              (set! score (expression-global-score module (Box.peek body) &next)))
          (BackendDeclaration.Function candidate _ _ body)
            (when (= candidate symbol)
              (set! score (expression-global-score module (Box.peek body) &next)))
          _ ()))
      score)))

(sig expression-global-score
     (Fn [(Ref BackendModule) (Ref SpecializedExpr) (Ref (Array String))] Int))
(defn expression-global-score [module expression visited]
  (match-ref expression
    (SpecializedExpr.ArrayLit _ _ expressions)
      (expressions-global-score module expressions visited)
    (SpecializedExpr.StaticArrayLit _ _ expressions)
      (expressions-global-score module expressions visited)
    (SpecializedExpr.GlobalValue _ _ _ _ symbol _)
      (Int.inc (global-symbol-score module symbol visited))
    (SpecializedExpr.Call _ _ callee arguments)
      (greater-score
        (expression-global-score module (Box.peek callee) visited)
        (expressions-global-score module arguments visited))
    (SpecializedExpr.GlobalCall _ _ _ _ symbol arguments)
      (greater-score
        (Int.inc (global-symbol-score module symbol visited))
        (expressions-global-score module arguments visited))
    (SpecializedExpr.Do _ _ expressions)
      (expressions-global-score module expressions visited)
    (SpecializedExpr.If _ _ condition then-branch else-branch)
      (greater-score
        (expression-global-score module (Box.peek condition) visited)
        (greater-score
          (expression-global-score module (Box.peek then-branch) visited)
          (expression-global-score module (Box.peek else-branch) visited)))
    (SpecializedExpr.Let _ _ _ value body)
      (greater-score
        (expression-global-score module (Box.peek value) visited)
        (expression-global-score module (Box.peek body) visited))
    (SpecializedExpr.Set _ _ _ value)
      (expression-global-score module (Box.peek value) visited)
    (SpecializedExpr.While _ _ condition body)
      (greater-score
        (expression-global-score module (Box.peek condition) visited)
        (expression-global-score module (Box.peek body) visited))
    (SpecializedExpr.Lambda _ _ _ body)
      (expression-global-score module (Box.peek body) visited)
    (SpecializedExpr.Match _ _ _ scrutinee branches)
      (greater-score
        (expression-global-score module (Box.peek scrutinee) visited)
        (branches-global-score module branches visited))
    (SpecializedExpr.Annotation _ _ inner _)
      (expression-global-score module (Box.peek inner) visited)
    _ 0))

(doc global-initializers "renders ordered startup assignments for reachable
ownership-free globals whose initializers are not C constant expressions.
Ordering follows transitive global dependencies through called functions;
cycles retain declaration order.")
(defn global-initializers [module]
  (let-do [result (the (Result Unit BackendError) (Result.Success ()))
           global-indices (the (Array Int) [])
           scores (the (Array Int) [])
           maximum-score 0
           declarations (BackendModule.declarations module)
           declaration-count (Array.length declarations)]
    (for [i 0 declaration-count]
      (match-ref (Array.unsafe-nth declarations i)
        (BackendDeclaration.Global symbol global-type body)
          (unless (or
              (constant-global-initializer? (Box.peek body))
              ;; elided unit globals have no storage to initialize
              (match-ref (Box.peek global-type) (MonoType.Unit) true _ false))
            (let-do [visited (the (Array String) [])
                     score (global-symbol-score module symbol &visited)]
              (Array.push-back! &global-indices i)
              (Array.push-back! &scores score)
              (set! maximum-score (greater-score maximum-score score))))
        _ ()))
    (let-do [buffer (StringBuf.create)
             ignored-plain (clear-plain-locals!)
             ;; the reference signature: argc/argv feed `System.args` before
             ;; any other global initializes. The tentative definition merges
             ;; with the extern declaration programs that read it emit.
             ignored-open (StringBuf.append-str &buffer "Array System_args;
void carp_init_globals(int argc, char** argv) {
  System_args.len = argc;
  System_args.data = argv;
")
             global-count (Array.length &global-indices)]
      (for [score 0 (Int.inc maximum-score)]
        (for [offset 0 global-count]
          (when (Int.= score @(Array.unsafe-nth &scores offset))
            (let [declaration-index @(Array.unsafe-nth &global-indices offset)]
              (match-ref (Array.unsafe-nth declarations declaration-index)
                (BackendDeclaration.Global symbol signature body)
                  (match-ref &result
                    (Result.Success _)
                      (let-do [destination (ResultDestination.Assign (sanitize symbol)
                                                                     (Box.init (MonoType.copy (Box.peek signature))))]
                        (set! *render-context* [(String.copy symbol)])
                        (set! result
                              (append-result! (BackendModule.constructors module)
                                              &buffer
                                              (Box.peek body)
                                              &destination
                                              1)))
                    (Result.Error _) ())
                _ ())))))
      (StringBuf.append-str &buffer "}
")
      (match result
        (Result.Success _) (Result.Success (StringBuf.to-string &buffer))
        (Result.Error error) (Result.Error error)))))

(doc template-definition "renders the body of a registry-declared
parameterized primitive. All interface dependencies must already have been
selected by specialization.")
(defn template-definition [declaration]
  (match-ref declaration
    (BackendDeclaration.Template _ signature template dependencies)
      (match (prototype-head declaration)
        (Result.Success head)
          (match-ref template
            (PrimitiveTemplate.IntComparison comparison)
            (if (Int.= 0 (Array.length dependencies))
              (let-do [buffer (StringBuf.create)
                       operator (match-ref comparison
                         (PrimitiveIntComparison.LessEqual) (String.copy "<=")
                         (PrimitiveIntComparison.GreaterEqual)
                           (String.copy ">=")
                         (PrimitiveIntComparison.NotEqual) (String.copy "!="))
                       ignored-head (StringBuf.append-str &buffer &head)]
                (StringBuf.append-str &buffer " {
  return arg0 ")
                (StringBuf.append-str &buffer &operator)
                (StringBuf.append-str &buffer " arg1;
}")
                (Result.Success (StringBuf.to-string &buffer)))
              (Result.Error
                (BackendError.init
                  @"Int comparison template must not have dependencies")))
            (PrimitiveTemplate.PointerCopy)
            (if (Int.= 0 (Array.length dependencies))
              (let-do [buffer (StringBuf.create)
                       ignored-head (StringBuf.append-str &buffer &head)]
                (StringBuf.append-str &buffer " {
  return *arg0;
}")
                (Result.Success (StringBuf.to-string &buffer)))
              (Result.Error
                (BackendError.init
                  @"pointer copy template must not have dependencies")))
            ;; only reached when a length is referenced as a value (call sites
            ;; inline `.len`/`strlen`); the body mirrors that call lowering.
            (PrimitiveTemplate.CollectionLength)
            (if (Int.= 0 (Array.length dependencies))
              (let-do [buffer (StringBuf.create)
                       ignored-head (StringBuf.append-str &buffer &head)
                       behind-ref (match-ref (Box.peek signature)
                         (MonoType.Function length-arguments _)
                           (if (Int.= 1 (Array.length length-arguments))
                             (match-ref (Box.peek (Array.unsafe-nth length-arguments
                                                                    0))
                               (MonoType.Reference _ _) true
                               _ false)
                             false)
                         _ false)
                       strlen-backed (match-ref (Box.peek signature)
                         (MonoType.Function length-arguments _)
                           (if (Int.= 1 (Array.length length-arguments))
                             (match-ref &(deref-type
                                 (Box.peek (Array.unsafe-nth length-arguments 0)))
                               (MonoType.String) true
                               (MonoType.Named length-type-name _)
                                 (String.= length-type-name "Pattern")
                               _ false)
                             false)
                         _ false)]
                (StringBuf.append-str &buffer
                                      (cond (and strlen-backed behind-ref) " {
  return (int)strlen(*arg0);
}" strlen-backed " {
  return (int)strlen(arg0);
}" behind-ref " {
  return arg0->len;
}" " {
  return arg0.len;
}"))
                (Result.Success (StringBuf.to-string &buffer)))
              (Result.Error
                (BackendError.init @"length template must not have dependencies")))
            ;; the reference renders any function value as the fixed string
            ;; "λ" (StartingEnv.generateTemplateFuncStrOrPrn).
            (PrimitiveTemplate.FunctionStr)
            (if (Int.= 0 (Array.length dependencies))
              (let-do [buffer (StringBuf.create)
                       ignored-head (StringBuf.append-str &buffer &head)]
                (StringBuf.append-str &buffer " {
  static String lambda = \"\\u03bb\";
  return String_copy(&lambda);
}")
                (Result.Success (StringBuf.to-string &buffer)))
              (Result.Error
                (BackendError.init
                  @"function str template must not have dependencies")))
            (PrimitiveTemplate.FunctionCopy _)
            (if (Int.= 0 (Array.length dependencies))
              (let-do [buffer (StringBuf.create)
                       ignored-head (StringBuf.append-str &buffer &head)]
                (StringBuf.append-str &buffer " {
  if(arg0->env) {
    Lambda copy;
    copy.callback = arg0->callback;
    copy.delete = arg0->delete;
    copy.copy = arg0->copy;
    copy.env = ((void*(*)(void*))arg0->copy)(arg0->env);
    return copy;
  }
  return *arg0;
}")
                (Result.Success (StringBuf.to-string &buffer)))
              (Result.Error
                (BackendError.init
                  @"function copy template must not have dependencies")))
            (PrimitiveTemplate.FunctionDelete _)
            (if (Int.= 0 (Array.length dependencies))
              (let-do [buffer (StringBuf.create)
                       ignored-head (StringBuf.append-str &buffer &head)]
                (StringBuf.append-str &buffer " {
  if(arg0.delete) {
    ((void(*)(void*))arg0.delete)(arg0.env);
    CARP_FREE(arg0.env);
  }
}")
                (Result.Success (StringBuf.to-string &buffer)))
              (Result.Error
                (BackendError.init
                  @"function delete template must not have dependencies")))
            (PrimitiveTemplate.BoxCopy _)
            (if (Int.= 1 (Array.length dependencies))
              (match (template-element-type (Box.peek signature))
                (Result.Success element)
                  (match (CBackend.render-type &element)
                    (Result.Success rendered-element)
                      (let [dependency (Array.unsafe-nth dependencies 0)
                            dependency-symbol (sanitize (BackendDependency.symbol dependency))]
                        (let-do [buffer (StringBuf.create)
                                 ignored-head (StringBuf.append-str &buffer
                                                                    &head)]
                          (StringBuf.append-str &buffer " {
  ")
                          (StringBuf.append-str &buffer &rendered-element)
                          (StringBuf.append-str &buffer
                                                "* copy = CARP_MALLOC(sizeof(")
                          (StringBuf.append-str &buffer &rendered-element)
                          (StringBuf.append-str &buffer "));
  *copy = ")
                          (StringBuf.append-str &buffer &dependency-symbol)
                          (StringBuf.append-str &buffer "(*arg0);
  return copy;
}")
                          (Result.Success (StringBuf.to-string &buffer))))
                    (Result.Error error) (Result.Error error))
                (Result.Error error) (Result.Error error))
              (Result.Error
                (BackendError.init
                  @"box copy template requires one copy dependency")))
            (PrimitiveTemplate.PairCopy _)
            (if (Int.= 2 (Array.length dependencies))
              (match-ref (Box.peek signature)
                (MonoType.Function _ result-type)
                  (match (CBackend.render-type (Box.peek result-type))
                    (Result.Success rendered-pair)
                      (let [first-dependency (Array.unsafe-nth dependencies 0)
                            second-dependency (Array.unsafe-nth dependencies 1)
                            first-symbol (sanitize
                              (BackendDependency.symbol first-dependency))
                            second-symbol (sanitize
                              (BackendDependency.symbol second-dependency))]
                        (let-do [buffer (StringBuf.create)
                                 ignored-head (StringBuf.append-str &buffer
                                                                    &head)]
                          (StringBuf.append-str &buffer " {
  ")
                          (StringBuf.append-str &buffer &rendered-pair)
                          (StringBuf.append-str &buffer " copy;
  copy.a = ")
                          (StringBuf.append-str &buffer &first-symbol)
                          (StringBuf.append-str &buffer "(&arg0->a);
  copy.b = ")
                          (StringBuf.append-str &buffer &second-symbol)
                          (StringBuf.append-str &buffer "(&arg0->b);
  return copy;
}")
                          (Result.Success (StringBuf.to-string &buffer))))
                    (Result.Error error) (Result.Error error))
                _
                  (Result.Error
                    (BackendError.init
                      @"pair copy template needs a function signature")))
              (Result.Error
                (BackendError.init
                  @"pair copy template requires two copy dependencies")))
            (PrimitiveTemplate.BoxStr _)
            (if (Int.= 1 (Array.length dependencies))
              (let-do [dependency (Array.unsafe-nth dependencies 0)
                       dependency-symbol (sanitize (BackendDependency.symbol dependency))
                       by-ref (match-ref (Box.peek (BackendDependency.signature dependency))
                         (MonoType.Function str-arguments _)
                           (if (Int.= 1 (Array.length str-arguments))
                             (match-ref (Box.peek (Array.unsafe-nth str-arguments
                                                                    0))
                               (MonoType.Reference _ _) true
                               _ false)
                             false)
                         _ false)
                       ;; `arg0` is elt**: the boxed element pointer is *arg0.
                       str-call (if by-ref
                         (fmt "String temp = %s(*arg0);" &dependency-symbol)
                         (fmt "String temp = %s(**arg0);" &dependency-symbol))
                       buffer (StringBuf.create)
                       ignored-head (StringBuf.append-str &buffer &head)]
                (StringBuf.append-str &buffer " {
  ")
                (StringBuf.append-str &buffer &str-call)
                (StringBuf.append-str &buffer "
  int size = snprintf(NULL, 0, \"(Box %s)\", temp) + 1;
  String buffer = CARP_MALLOC(size);
  snprintf(buffer, size, \"(Box %s)\", temp);
  if(temp) { CARP_FREE(temp); temp = NULL; }
  return buffer;
}")
                (Result.Success (StringBuf.to-string &buffer)))
              (Result.Error
                (BackendError.init
                  @"box str template requires one str dependency")))
            ;; a Box is a bare element pointer: delete the boxed element when
            ;; it is managed (one delete dependency), then free the cell.
            (PrimitiveTemplate.BoxDelete _)
            (match-ref (Box.peek signature)
              (MonoType.Function box-delete-arguments _)
                (if (Int.= 1 (Array.length box-delete-arguments))
                  (let-do [buffer (StringBuf.create)
                           ignored-head (StringBuf.append-str &buffer &head)]
                    (StringBuf.append-str &buffer " {
  if (arg0) {
")
                    (when (Int.= 1 (Array.length dependencies))
                      (let-do [dependency (Array.unsafe-nth dependencies 0)
                               dependency-symbol (sanitize (BackendDependency.symbol dependency))]
                        (StringBuf.append-str &buffer "    ")
                        (StringBuf.append-str &buffer &dependency-symbol)
                        (StringBuf.append-str &buffer "(*arg0);
")))
                    (StringBuf.append-str &buffer "    CARP_FREE(arg0);
  }
}")
                    (Result.Success (StringBuf.to-string &buffer)))
                  (Result.Error
                    (BackendError.init
                      @"box delete template must have one argument")))
              _
                (Result.Error
                  (BackendError.init
                    @"box delete template needs a function signature")))
            (PrimitiveTemplate.ArrayDelete _)
            (match-ref (Box.peek signature)
              (MonoType.Function delete-arguments _)
                (if (Int.= 1 (Array.length delete-arguments))
                  (match-ref (Box.peek (Array.unsafe-nth delete-arguments 0))
                    (MonoType.Named _ element-arguments)
                      (if (Int.= 1 (Array.length element-arguments))
                        (match (render-type
                            (Box.peek (Array.unsafe-nth element-arguments 0)))
                          (Result.Success rendered-element)
                            (let-do [buffer (StringBuf.create)
                                     ignored-head (StringBuf.append-str &buffer
                                                                        &head)]
                              (StringBuf.append-str &buffer " {
")
                              (StringBuf.append-str &buffer "  if (arg0.data) {
")
                              (when (Int.= 1 (Array.length dependencies))
                                (let-do [dependency (Array.unsafe-nth dependencies
                                                                      0)
                                         dependency-symbol (sanitize (BackendDependency.symbol dependency))]
                                  (StringBuf.append-str &buffer
                                                        "  for(int i = 0; i < arg0.len; i++) {
    ")
                                  (StringBuf.append-str &buffer
                                                        &dependency-symbol)
                                  (StringBuf.append-str &buffer "(((")
                                  (StringBuf.append-str &buffer
                                                        &rendered-element)
                                  (StringBuf.append-str &buffer
                                                        "*)arg0.data)[i]);
  }
")))
                              (StringBuf.append-str &buffer
                                                    "    CARP_FREE(arg0.data);
  }
}")
                              (Result.Success (StringBuf.to-string &buffer)))
                          (Result.Error error) (Result.Error error))
                        (Result.Error
                          (BackendError.init
                            @"array delete template container must have one type argument")))
                    _
                      (Result.Error
                        (BackendError.init
                          @"array delete template argument must be a named container")))
                  (Result.Error
                    (BackendError.init
                      @"array delete template must have one argument")))
              _
                (Result.Error
                  (BackendError.init
                    @"array delete template needs a function signature")))
            (PrimitiveTemplate.ArraySet _)
            (match-ref (Box.peek signature)
              (MonoType.Function arguments return-type)
                (if (Int.= 3 (Array.length arguments))
                  (match (render-type (Box.peek (Array.unsafe-nth arguments 2)))
                    (Result.Success rendered-element)
                      (let-do [buffer (StringBuf.create)
                               by-reference (match-ref (Box.peek (Array.unsafe-nth arguments
                                                                                   0))
                                 (MonoType.Reference _ _) true
                                 _ false)
                               data (if by-reference @"arg0->data" @"arg0.data")
                               ignored-head (StringBuf.append-str &buffer &head)]
                        (StringBuf.append-str &buffer " {
")
                        (when (Int.> (Array.length dependencies) 0)
                          (let-do [dependency (Array.unsafe-nth dependencies 0)]
                            (StringBuf.append-str &buffer "  ")
                            (StringBuf.append-str &buffer
                                                  &(sanitize (BackendDependency.symbol dependency)))
                            (StringBuf.append-str &buffer "(((")
                            (StringBuf.append-str &buffer &rendered-element)
                            (StringBuf.append-str &buffer "*)")
                            (StringBuf.append-str &buffer &data)
                            (StringBuf.append-str &buffer ")[arg1]);
")))
                        (StringBuf.append-str &buffer "  ((")
                        (StringBuf.append-str &buffer &rendered-element)
                        (StringBuf.append-str &buffer "*)")
                        (StringBuf.append-str &buffer &data)
                        (StringBuf.append-str &buffer ")[arg1] = arg2;
")
                        (unless by-reference
                          (StringBuf.append-str &buffer "  return arg0;
"))
                        (StringBuf.append-char &buffer \})
                        (Result.Success (StringBuf.to-string &buffer)))
                    (Result.Error error) (Result.Error error))
                  (Result.Error
                    (BackendError.init
                      @"array set template must have three arguments")))
              _
                (Result.Error
                  (BackendError.init
                    @"array set template needs a function signature")))
            (PrimitiveTemplate.ArrayFilter _)
            (match-ref (Box.peek signature)
              (MonoType.Function arguments _)
                (if (Int.= 2 (Array.length arguments))
                  (match-ref (Box.peek (Array.unsafe-nth arguments 1))
                    (MonoType.Named _ element-arguments)
                      (if (Int.= 1 (Array.length element-arguments))
                        (match (render-type
                            (Box.peek (Array.unsafe-nth element-arguments 0)))
                          (Result.Success rendered-element)
                            (let-do [buffer (StringBuf.create)
                                     ignored-head (StringBuf.append-str &buffer
                                                                        &head)]
                              (StringBuf.append-str &buffer " {
  int insertIndex = 0;
  for(int i = 0; i < arg1.len; ++i) {
    if((*arg0).env
       ? ((bool (*)(void*, ")
                              (StringBuf.append-str &buffer &rendered-element)
                              (StringBuf.append-str &buffer
                                                    "*))(*arg0).callback)((*arg0).env, &((")
                              (StringBuf.append-str &buffer &rendered-element)
                              (StringBuf.append-str &buffer "*)arg1.data)[i])
       : ((bool (*) (")
                              (StringBuf.append-str &buffer &rendered-element)
                              (StringBuf.append-str &buffer
                                                    "*))(*arg0).callback)(&((")
                              (StringBuf.append-str &buffer &rendered-element)
                              (StringBuf.append-str &buffer "*)arg1.data)[i])) {
      ((")
                              (StringBuf.append-str &buffer &rendered-element)
                              (StringBuf.append-str &buffer
                                                    "*)arg1.data)[insertIndex++] = ((")
                              (StringBuf.append-str &buffer &rendered-element)
                              (StringBuf.append-str &buffer "*)arg1.data)[i];
    }")
                              (when (Int.> (Array.length dependencies) 0)
                                (let-do [dependency (Array.unsafe-nth dependencies
                                                                      0)]
                                  (StringBuf.append-str &buffer " else {
      ")
                                  (StringBuf.append-str &buffer
                                                        &(sanitize (BackendDependency.symbol dependency)))
                                  (StringBuf.append-str &buffer "(((")
                                  (StringBuf.append-str &buffer
                                                        &rendered-element)
                                  (StringBuf.append-str &buffer
                                                        "*)arg1.data)[i]);
    }")))
                              (StringBuf.append-str &buffer "
  }
  arg1.len = insertIndex;
  return arg1;
}")
                              (Result.Success (StringBuf.to-string &buffer)))
                          (Result.Error error) (Result.Error error))
                        (Result.Error
                          (BackendError.init
                            @"array filter container must have one type argument")))
                    _
                      (Result.Error
                        (BackendError.init
                          @"array filter template needs an array argument")))
                  (Result.Error
                    (BackendError.init
                      @"array filter template must have two arguments")))
              _
                (Result.Error
                  (BackendError.init
                    @"array filter template needs a function signature")))
            (PrimitiveTemplate.ArrayStr _)
            (if (Int.= 1 (Array.length dependencies))
              (match (template-element-type (Box.peek signature))
                (Result.Success element)
                  (match (CBackend.render-type &element)
                    (Result.Success rendered-element)
                      (let-do [dependency (Array.unsafe-nth dependencies 0)
                               dependency-symbol (sanitize (BackendDependency.symbol dependency))
                               ;; the dependency's own signature says whether the
                               ;; element `str` takes its argument by reference.
                               by-ref (match-ref (Box.peek (BackendDependency.signature dependency))
                                 (MonoType.Function str-arguments _)
                                   (if (Int.= 1 (Array.length str-arguments))
                                     (match-ref (Box.peek (Array.unsafe-nth str-arguments
                                                                            0))
                                       (MonoType.Reference _ _) true
                                       _ false)
                                     false)
                                 _ false)
                               element-access (fmt "((%s*)arg0->data)[i]"
                                                   &rendered-element)
                               call-arg (if by-ref
                                 (fmt "&(%s)" &element-access)
                                 (String.copy &element-access))
                               str-call (fmt "temp = %s(%s);"
                                             &dependency-symbol
                                             &call-arg)
                               buffer (StringBuf.create)
                               ignored-head (StringBuf.append-str &buffer &head)]
                        (StringBuf.append-str &buffer " {
  String temp = NULL;
  int tempsize = 0;
  (void)tempsize;
  int size = 3;
  for(int i = 0; i < arg0->len; i++) {
    ")
                        (StringBuf.append-str &buffer &str-call)
                        (StringBuf.append-str &buffer "
    size += snprintf(NULL, 0, \"%s \", temp);
    if(temp) { CARP_FREE(temp); temp = NULL; }
  }
  String buffer = CARP_MALLOC(size);
  String bufferPtr = buffer;
  snprintf(buffer, size, \"[\");
  bufferPtr += 1;
  for(int i = 0; i < arg0->len; i++) {
    ")
                        (StringBuf.append-str &buffer &str-call)
                        (StringBuf.append-str &buffer "
    tempsize = snprintf(bufferPtr, size - (bufferPtr - buffer), \"%s \", temp);
    bufferPtr += tempsize;
    if(temp) { CARP_FREE(temp); temp = NULL; }
  }
  if(arg0->len > 0) { bufferPtr -= 1; }
  snprintf(bufferPtr, size - (bufferPtr - buffer), \"]\");
  return buffer;
}")
                        (Result.Success (StringBuf.to-string &buffer)))
                    (Result.Error error) (Result.Error error))
                (Result.Error error) (Result.Error error))
              (Result.Error
                (BackendError.init
                  @"array str template requires one str dependency")))
            (PrimitiveTemplate.ArrayCopy _)
            (if (Int.= 1 (Array.length dependencies))
              (match (template-element-type (Box.peek signature))
                (Result.Success element)
                  (match (CBackend.render-type &element)
                    (Result.Success rendered-element)
                      (let [dependency (Array.unsafe-nth dependencies 0)
                            dependency-symbol (sanitize (BackendDependency.symbol dependency))]
                        (let-do [buffer (StringBuf.create)
                                 ignored-head (StringBuf.append-str &buffer
                                                                    &head)]
                          (StringBuf.append-str &buffer " {
  Array copy;
  copy.len = arg0->len;
  copy.capacity = arg0->capacity;
  copy.data = arg0->capacity == 0 ? NULL : CARP_MALLOC(sizeof(")
                          (StringBuf.append-str &buffer &rendered-element)
                          (StringBuf.append-str &buffer ") * arg0->capacity);
  for(size_t i = 0; i < arg0->len; i++) {
    ((")
                          (StringBuf.append-str &buffer &rendered-element)
                          (StringBuf.append-str &buffer "*)copy.data)[i] = ")
                          (StringBuf.append-str &buffer &dependency-symbol)
                          (StringBuf.append-str &buffer "(&(((")
                          (StringBuf.append-str &buffer &rendered-element)
                          (StringBuf.append-str &buffer "*)arg0->data)[i]));
  }
  return copy;
}")
                          (Result.Success (StringBuf.to-string &buffer))))
                    (Result.Error error) (Result.Error error))
                (Result.Error error) (Result.Error error))
              (Result.Error
                (BackendError.init
                  @"array copy template requires one copy dependency"))))
        (Result.Error error) (Result.Error error))
    (BackendDeclaration.SourceTemplate _ _ _ _ _)
      (source-template-definition declaration)
    _ (Result.Error (BackendError.init @"declaration is not a template"))))

(doc template-definitions "renders every reachable registry-declared
primitive template. User function bodies and source-defined intrinsic payloads
are separate backend inputs.")
(defn template-definitions [module]
  (let-do [result (the (Result Unit BackendError) (Result.Success ()))
           buffer (StringBuf.create)
           rendered-any false
           declarations (BackendModule.declarations module)
           n (Array.length declarations)]
    (for [i 0 n]
      (match-ref &result
        (Result.Success _)
          (let [declaration (Array.unsafe-nth declarations i)]
            (when (template-declaration? declaration)
              (match (template-definition declaration)
                (Result.Success rendered)
                  (do (when rendered-any (StringBuf.append-str &buffer "

")) (StringBuf.append-str &buffer &rendered) (set! rendered-any true))
                (Result.Error error) (set! result (Result.Error error)))))
        (Result.Error _) ()))
    (match result
      (Result.Success _) (Result.Success (StringBuf.to-string &buffer))
      (Result.Error error) (Result.Error error))))

(doc prototypes "renders valid C declarations for every concrete backend
declaration.")
(defn prototypes [module]
  (let-do [result (the (Result Unit BackendError) (Result.Success ()))
           buffer (StringBuf.create)
           declarations (BackendModule.declarations module)
           n (Array.length declarations)]
    (for [i 0 n]
      (match-ref &result
        (Result.Success _)
          (match (prototype (Array.unsafe-nth declarations i))
            (Result.Success rendered)
              (do
                (StringBuf.append-str &buffer &rendered)
                (when (Int.< (Int.inc i) n)
                  (StringBuf.append-char &buffer \newline))
                ())
            (Result.Error error) (set! result (Result.Error error)))
        (Result.Error _) ()))
    (match result
      (Result.Success _)
        (match (closure-prototypes-of module)
          (Result.Success rendered-closures)
            (do
              (StringBuf.append-str &buffer &rendered-closures)
              (Result.Success (StringBuf.to-string &buffer)))
          (Result.Error error) (Result.Error error))
      (Result.Error error) (Result.Error error))))

(doc translation-unit "assembles runtime includes, declarations, primitive
definitions, and supported user-function definitions into one C source
artifact without an entry point.")
(defn translation-unit [module]
  (match (prototypes module)
    (Result.Success declarations)
      (match (template-definitions module)
        (Result.Success templates)
          (match (function-definitions module)
            (Result.Success functions)
              (match (global-definitions module)
                (Result.Success globals)
                  (match (global-initializers module)
                    (Result.Success initializers)
                      (match (nominal-definitions module)
                        (Result.Success nominals)
                          (match (constructor-definitions module)
                            (Result.Success nominal-constructors)
                              (match (system-includes module)
                                (Result.Success includes)
                                  (let-do [buffer (StringBuf.create)
                                           ignored-includes (StringBuf.append-str &buffer
                                                                                  &includes)]
                                    (unless-do (String.empty? &nominals)
                                      (StringBuf.append-char &buffer \newline)
                                      (StringBuf.append-str &buffer &nominals)
                                      (StringBuf.append-char &buffer \newline))
                                    (unless-do (String.empty? &declarations)
                                      (StringBuf.append-char &buffer \newline)
                                      (StringBuf.append-str &buffer
                                                            &declarations)
                                      (StringBuf.append-char &buffer \newline))
                                    (unless-do (String.empty? &templates)
                                      (StringBuf.append-char &buffer \newline)
                                      (StringBuf.append-str &buffer &templates)
                                      (StringBuf.append-char &buffer \newline))
                                    (unless-do (String.empty? &nominal-constructors)
                                      (StringBuf.append-char &buffer \newline)
                                      (StringBuf.append-str &buffer
                                                            &nominal-constructors)
                                      (StringBuf.append-char &buffer \newline))
                                    (unless-do (String.empty? &globals)
                                      (StringBuf.append-char &buffer \newline)
                                      (StringBuf.append-str &buffer &globals)
                                      (StringBuf.append-char &buffer \newline))
                                    (unless-do (String.empty? &initializers)
                                      (StringBuf.append-char &buffer \newline)
                                      (StringBuf.append-str &buffer
                                                            &initializers)
                                      (StringBuf.append-char &buffer \newline))
                                    (unless-do (String.empty? &functions)
                                      (StringBuf.append-char &buffer \newline)
                                      (StringBuf.append-str &buffer &functions)
                                      (StringBuf.append-char &buffer \newline))
                                    (Result.Success (StringBuf.to-string &buffer)))
                                (Result.Error error) (Result.Error error))
                            (Result.Error error) (Result.Error error))
                        (Result.Error error) (Result.Error error))
                    (Result.Error error) (Result.Error error))
                (Result.Error error) (Result.Error error))
            (Result.Error error) (Result.Error error))
        (Result.Error error) (Result.Error error))
    (Result.Error error) (Result.Error error)))

(doc find-entry "locates a specialized `main` function to call from the C entry
point, returning its C symbol paired with whether it returns an `Int` (an exit
code) or `Unit`. `main` is nullary, so only those two mangled symbols can match.")
(defn find-entry [module]
  (let-do [result (the (Maybe (Pair String Bool)) (Maybe.Nothing))
           declarations (BackendModule.declarations module)
           int-symbol (CAbi.mangle "main"
                                   &(MonoType.Function []
                                                       (Box.init (MonoType.Integer))))
           unit-symbol (CAbi.mangle "main"
                                    &(MonoType.Function []
                                                        (Box.init (MonoType.Unit))))
           n (Array.length declarations)]
    (for [i 0 n]
      (match-ref (Array.unsafe-nth declarations i)
        (BackendDeclaration.Function symbol _ _ _)
          (cond
            (String.= symbol &int-symbol)
              (set! result (Maybe.Just (Pair.init (String.copy symbol) true)))
            (String.= symbol &unit-symbol)
              (set! result (Maybe.Just (Pair.init (String.copy symbol) false)))
            ())
        _ ()))
    result))

(doc entry-definition "renders ownerless specialized root expressions as a
C entry point. This policy is requested explicitly by a compiler driver.")
(defn entry-definition [module]
  (let-do [buffer (StringBuf.create)
           ignored-open (StringBuf.append-str &buffer
                                              "int main(int argc, char** argv) {
")
           ignored-globals (StringBuf.append-str &buffer
                                                 "  carp_init_globals(argc, argv);
")
           result (the (Result Unit BackendError) (Result.Success ()))
           roots (BackendModule.roots module)
           seen (the (Array String) [])
           winners (the (Array Int) [])
           n (Array.length roots)]
    (for [i 0 n]
      (collect-plain-locals! (Box.peek (Array.unsafe-nth roots i))
                             &seen
                             &winners))
    (set! *plain-local-ids* winners)
    (for [i 0 n]
      (match-ref &result
        (Result.Success _)
          (set! result
                (append-statement! (BackendModule.constructors module)
                                   &buffer
                                   (Box.peek (Array.unsafe-nth roots i))
                                   1))
        (Result.Error _) ()))
    (match result
      (Result.Success _)
        (do
          (match (find-entry module)
            (Maybe.Just entry)
              (if @(Pair.b &entry)
                (do
                  (StringBuf.append-str &buffer "  return ")
                  (StringBuf.append-str &buffer (Pair.a &entry))
                  (StringBuf.append-str &buffer "();
}
"))
                (do
                  (StringBuf.append-str &buffer "  ")
                  (StringBuf.append-str &buffer (Pair.a &entry))
                  (StringBuf.append-str &buffer "();
  return 0;
}
")))
            (Maybe.Nothing) (StringBuf.append-str &buffer "  return 0;
}
"))
          (Result.Success (StringBuf.to-string &buffer)))
      (Result.Error error) (Result.Error error))))

(doc executable-translation-unit "adds an explicit C entry wrapper to a
backend translation unit.")
(defn executable-translation-unit [module]
  (match (translation-unit module)
    (Result.Success c)
      (match (entry-definition module)
        (Result.Success entry) (Result.Success (String.concat &[c @"
" entry]))
        (Result.Error error) (Result.Error error))
    (Result.Error error) (Result.Error error)))
