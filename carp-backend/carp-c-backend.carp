(load "../carp-types/core-instantiation.carp")

(doc CArtifactEntity "is one definition in emitted C. `symbol` is the symbol it
defines, `source` its C text and `dependencies` the symbols it uses.")
(deftype CArtifactEntity
  [symbol String
   source String
   dependencies (Array String)])
(doc CTranslationUnit "is emitted C. `source` is the whole text. `entities`
holds its definitions.")
(deftype CTranslationUnit [source String
                           entities (Array CArtifactEntity)])

(doc CArtifacts "records the definitions of emitted C.")
(defmodule CArtifacts
  (doc append! "appends `source`, the C definition of `symbol` that uses
`dependencies`, to `buffer` and records it in `entities`. Empty source is
skipped.")
  (defn append! [buffer entities symbol dependencies source]
    (unless-do (String.empty? source)
      (StringBuf.append-str buffer source)
      (Array.push-back! entities
                        (CArtifactEntity.init (String.copy symbol)
                                              (String.copy source)
                                              (Array.copy dependencies))))))

;; C rendering for the backend model of carp-backend.carp, which loads this
;; file after `BackendLower`.

(doc *plain-local-ids* "holds the binder ids that keep their plain Carp name as
C name in the function being rendered: the first binder of each name that can.
Plain names let `Unsafe.C.asm` macros name locals.")
(def *plain-local-ids* (the (Array Int) []))

(doc LineMap "marks places in emitted C whose line belongs to the C itself.")
(defmodule LineMap
  (doc reset-mark "returns the text that marks a line reset: a C comment, so the
unit compiles if nothing replaces it.")
  (defn reset-mark [] @"/*carp-line-reset*/")

  (doc mark-reset! "appends a line reset mark to `buffer`, if `line-map` is on,
at a place that belongs to generated C rather than Carp, such as the top of a
function. `CarpCompiler.resolve-line-resets` turns the marks into `#line`
directives once the whole unit is known.")
  (defn mark-reset! [line-map buffer]
    (when-do (BackendLineMap.enabled? line-map) (StringBuf.append-str buffer "
") (StringBuf.append-str buffer &(reset-mark)) (StringBuf.append-str buffer "
"))))

(doc *render-context* "holds the C symbol of the declaration being rendered, for
error messages.")
(def *render-context* (the (Array String) []))
(doc *library-exports* "holds the C symbols a library unit exports, or `Nothing`
for an executable. In a library the other definitions get internal linkage, so
two libraries do not bind to each other's symbols.")
(def *library-exports* (the (Maybe (Array String)) (Maybe.Nothing)))
(doc *array-data-cache-refs* "holds the arrays whose data pointer is cached in a
local in the loop being rendered.")
(def *array-data-cache-refs* (the (Array CoreRef) []))
(doc *array-data-cache-symbols* "holds the names of the locals that cache the
data pointers of `*array-data-cache-refs*`.")
(def *array-data-cache-symbols* (the (Array String) []))

(doc cached-array-data-symbol-for-ref "returns the local that caches the data
pointer of the array `reference`, if any.")
(defn cached-array-data-symbol-for-ref [reference]
  (let-do [result (the (Maybe String) (Maybe.Nothing))
           n (Array.length &*array-data-cache-refs*)]
    (for [i 0 n]
      (when (CoreIR.same-ref?
          (Array.unsafe-nth &*array-data-cache-refs* i)
          reference)
        (set! result
              (Maybe.Just
                (String.copy (Array.unsafe-nth &*array-data-cache-symbols* i))))))
    result))

(doc cached-array-data-symbol "returns the local that caches the data pointer of
the array that `expression` refers to, if any.")
(defn cached-array-data-symbol [expression]
  (match-ref expression
    (SpecializedExpr.Reference _ _ reference)
      (cached-array-data-symbol-for-ref reference)
    (SpecializedExpr.Annotation _ _ inner _)
      (cached-array-data-symbol (Box.peek inner))
    _ (the (Maybe String) (Maybe.Nothing))))

(doc unit-type? "checks whether values of `type` have no C storage, as
`CAbi.storage-free?` does.")
(defn unit-type? [type] (CAbi.storage-free? type))

