(load "../carp-backend.carp")
(load "../../carp-resolve/carp-resolve.carp")
(load "Test.carp")
(Project.no-echo)
(use-all Test)

(defn declarations [source]
  (match (Surface.parse source)
    (Result.Error _) (Result.Error (BackendError.init @"parse"))
    (Result.Success surface)
      (match (Resolve.module &surface)
        (Result.Error error)
          (Result.Error (BackendError.init @(ResolveError.message &error)))
        (Result.Success core)
          (match (Infer.module &core)
            (Result.Error error)
              (Result.Error (BackendError.init @(InferError.message &error)))
            (Result.Success inferred)
              (match (Specialize.module &core &inferred)
                (Result.Error error)
                  (Result.Error
                    (BackendError.init @(SpecializeError.message &error)))
                (Result.Success specialized)
                  (match (BackendLower.module &specialized &[] &[] &[])
                    (Result.Error error) (Result.Error error)
                    (Result.Success backend)
                      (CBackend.nominal-definitions &backend)))))))

(defn orders-pointer-cycle? []
  (match (declarations "(deftype Link [next (Ptr Node)])
(deftype Node [payload Payload])
(deftype Payload (Children [(Array Link)]) (End []))
(register make (Fn [] Payload) \"make_payload\")
(make)") (Result.Error _) false (Result.Success text)
      (let [link (String.index-of-string &text "struct Link {")
            node (String.index-of-string &text "struct Node {")
            payload (String.index-of-string &text "struct Payload {")]
        (and (Int.>= link 0) (and (Int.> node payload) (Int.>= payload 0))))))

(defn rejects-value-cycle? [] (Result.error? &(declarations "(deftype A [b B])
(deftype B [a A])
(register make (Fn [] A) \"make_a\")
(make)")))

(deftest test
  (assert-true test
    (orders-pointer-cycle?)
    "pointer recursion does not become a false by-value cycle")
  (assert-true test
    (rejects-value-cycle?)
    "a cycle containing only by-value fields remains invalid"))
