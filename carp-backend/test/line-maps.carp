(load "../../carp-compiler.carp")
(Project.no-echo)
(load "Test.carp")
(use-all Test)

(defmodule CarpCompiler
  (defn test-render-mapped [module] (render-owned @module)))

(defn mapped-module [file line]
  (match (CarpCompiler.lower-source "(deftype Counter [value Int])
(defn make [] (Counter.init 7))
(make)") (Result.Success backend)
      (do
        (BackendModule.set-line-map! &backend
                                     (BackendLineMap.init (Array.replicate 4096
                                                                           file)
                                                          (Array.replicate 4096
                                                                           &line)
                                                          (Array.replicate 4096
                                                                           &3)))
        (Result.Success backend)) (Result.Error error) (Result.Error error)))

(defn has-text? [text fragment]
  (Int.>= (String.index-of-string text fragment) 0))

(defn names-map? [rendered file line]
  (and
    (has-text? rendered &(fmt "#line %d \"%s\"" line file))
    (not (has-text? rendered "other.carp"))))

(defn direct-map? []
  (match (mapped-module "first.carp" 11)
    (Result.Success backend)
      (let [reset (CarpCompiler.compile-source "(defn main [] ())")]
        (and (Result.success? &reset)
             (match (CBackend.executable-translation-unit &backend)
               (Result.Success c) (names-map? &c "first.carp" 11)
               (Result.Error _) false)))
    (Result.Error _) false))

(defn interleaved-map? [section]
  (match (mapped-module "first.carp" 11)
    (Result.Success first)
      (match (mapped-module "other.carp" 29)
        (Result.Success other)
          (match (CarpCompiler.test-render-mapped &first)
            (Result.Success before)
              (let [interleaved (CarpCompiler.test-render-mapped &other)]
                (and (Result.success? &interleaved)
                     (match (if section
                         (CBackend.function-definitions &first)
                         (CBackend.executable-translation-unit &first))
                       (Result.Success after)
                         (and (names-map? &after "first.carp" 11)
                              (if section true (String.= &before &after)))
                       (Result.Error _) false)))
            (Result.Error _) false)
        (Result.Error _) false)
    (Result.Error _) false))

(defn unmapped-after-mapped? [constructors]
  (match (mapped-module "other.carp" 29)
    (Result.Success mapped)
      (match (CarpCompiler.test-render-mapped &mapped)
        (Result.Success _)
          (do
            (BackendModule.set-line-map! &mapped (BackendLineMap.empty))
            (match (if constructors
                (CBackend.constructor-definitions &mapped)
                (CBackend.executable-translation-unit &mapped))
              (Result.Success c)
                (and (not (has-text? &c "#line"))
                     (not (has-text? &c &(LineMap.reset-mark))))
              (Result.Error _) false))
        (Result.Error _) false)
    (Result.Error _) false))

(deftest t
  (assert-true t (direct-map?) "direct C emission reads the module's source map")
  (assert-true t
    (interleaved-map? false)
    "interleaved C rendering preserves a deferred module's source locations")
  (assert-true t
    (interleaved-map? true)
    "standalone function emission reads the module's source map")
  (assert-true t
    (unmapped-after-mapped? false)
    "an unmapped module does not inherit another module's source directives")
  (assert-true t
    (unmapped-after-mapped? true)
    "unmapped constructors do not inherit another module's reset marks")

  (assert-true t
    (let [map (BackendLineMap.empty)]
      (and (not (BackendLineMap.enabled? &map))
           (and
             (Int.= -1 (BackendLineMap.line-of &map 0))
             (and
               (Int.= 0 (BackendLineMap.column-of &map -1))
               (String.empty? &(BackendLineMap.file-of &map 0))))))
    "empty line maps return backend-neutral missing-location defaults")
  (assert-true t
    (let [map (BackendLineMap.init [@"first.carp" @"last.carp"] [11] [2 3 4])]
      (and
        (Int.= -1 (BackendLineMap.line-of &map 1))
        (and
          (Int.= 4 (BackendLineMap.column-of &map 2))
          (String.= "last.carp" &(BackendLineMap.file-of &map 1)))))
    "each location field checks its own bounds in a ragged map")
  (assert-true t
    (let [map (BackendLineMap.init [@"first.carp"] [11] [2])]
      (and
        (Int.= -1 (BackendLineMap.line-of &map -1))
        (and
          (Int.= 0 (BackendLineMap.column-of &map 1))
          (String.empty? &(BackendLineMap.file-of &map -1)))))
    "negative and past-end expression identities have no source location")
  (assert-true t
    (let [map (BackendLineMap.init [@"exact/ä.carp"] [0] [0])]
      (and (BackendLineMap.enabled? &map)
           (and
             (Int.= 0 (BackendLineMap.line-of &map 0))
             (and
               (Int.= 0 (BackendLineMap.column-of &map 0))
               (String.= "exact/ä.carp" &(BackendLineMap.file-of &map 0))))))
    "line-table presence enables mapping while zero locations and file spelling stay exact"))
