(load "../symbols.carp")
(Project.no-echo)
(load "Test.carp")
(use-all Test)

(deftype TestSymbols
  [deletes (Array (Pair String String))
   copies (Array (Pair String String))
   echo (Maybe EchoPlan)])

(defn select-symbols [impls instances keys]
  (let [core (CoreModule.set-implementations (CoreIR.empty-module) @impls)
        module (SpecializationModule.init @instances [] [] [] [] [] [])]
    (match (BackendSymbolSelection.for-module &core &module keys)
      (BackendSymbols.init deletes copies echo)
        (TestSymbols.init deletes copies echo))))

(defn native-reference [id name global]
  (CoreRef.init id (String.copy name) global))

(defn native-spec [id name global signature symbol]
  (Specialization.init (native-reference id name global)
                       (Box.init signature)
                       (String.copy symbol)))

(defn unary [arg result] (Type.function [(Box.init arg)] result))

(defn implementation [interface id name global]
  (CoreImplementation.init interface (native-reference id name global)))

(defn fixture-implementations []
  [(implementation (PrimitiveRegistry.delete-reference) 10 "drop" true)
   (implementation (PrimitiveRegistry.reference 0 "copy") 11 "clone" true)
   (implementation (PrimitiveRegistry.delete-reference) 12 "dual" true)
   (implementation (PrimitiveRegistry.reference 0 "copy") 12 "dual" true)
   (implementation (PrimitiveRegistry.delete-reference) 13 "drop-last" true)
   (implementation (PrimitiveRegistry.delete-reference) 14 "bad-drop" true)
   (implementation (PrimitiveRegistry.reference 0 "copy") 15 "bad-copy" true)
   (implementation (PrimitiveRegistry.str-reference) 16 "show-int" true)
   (implementation (PrimitiveRegistry.str-reference) 17 "show-widget" true)
   (implementation (PrimitiveRegistry.str-reference) 18 "bad-str" true)
   (implementation
     (CoreRef.set-name (PrimitiveRegistry.delete-reference) @"wrong-interface")
     19
     "false-interface"
     true)])

(defn fixture-instances []
  [(native-spec 10 "drop" true (unary (Type.string) (Type.unit)) "drop_first")
   (native-spec 11
                "clone"
                true
                (unary
                  (Type.reference (Type.integer) (Type.lifetime 0))
                  (Type.named "Widget" []))
                "clone-widget")
   (native-spec 10
                "different-name"
                true
                (unary (Type.string) (Type.unit))
                "wrong_name")
   (native-spec 10
                "drop"
                false
                (unary (Type.string) (Type.unit))
                "wrong_globality")
   (native-spec 20 "drop" true (unary (Type.string) (Type.unit)) "wrong_id")
   (native-spec 12 "dual" true (unary (Type.integer) (Type.string)) "dual")
   (native-spec 13
                "drop-last"
                true
                (unary (Type.string) (Type.unit))
                "drop_last")
   (native-spec 14 "bad-drop" true (Type.function [] (Type.unit)) "bad_drop")
   (native-spec 15 "bad-copy" true (Type.integer) "bad_copy")
   (native-spec 16
                "show-int"
                true
                (unary (Type.integer) (Type.string))
                "show_int")
   (native-spec 17
                "show-widget"
                true
                (unary
                  (Type.reference (Type.named "Widget" []) (Type.lifetime 0))
                  (Type.string))
                "show_widget")
   (native-spec 18
                "bad-str"
                true
                (Type.function
                  [(Box.init (Type.integer)) (Box.init (Type.integer))]
                  (Type.string))
                "bad_str")
   (native-spec 19
                "false-interface"
                true
                (unary (Type.string) (Type.unit))
                "wrong_interface")
   (native-spec 30
                "IO.println"
                true
                (unary
                  (Type.reference (Type.string) (Type.lifetime 0))
                  (Type.unit))
                "println_first")
   (native-spec 31
                "IO.println"
                true
                (unary
                  (Type.reference (Type.string) (Type.lifetime 0))
                  (Type.unit))
                "println_last")])

(defn table-policies? []
  (let [symbols (select-symbols &(fixture-implementations)
                                &(fixture-instances)
                                &[])
        deletes (TestSymbols.deletes &symbols)
        copies (TestSymbols.copies &symbols)]
    (and
      (and (Int.= 3 (Array.length deletes)) (Int.= 2 (Array.length copies)))
      (and
        (and
          (String.= (Pair.a (Array.unsafe-nth deletes 1))
                    &(CAbi.type-key &(Type.integer)))
          (String.= (Pair.b (Array.unsafe-nth deletes 0)) "drop_first"))
        (and
          (String.= (Pair.b (Array.unsafe-nth deletes 2)) "drop_last")
          (and
            (String.= (Pair.a (Array.unsafe-nth copies 0))
                      &(CAbi.type-key &(Type.named "Widget" [])))
            (String.= (Pair.b (Array.unsafe-nth copies 0)) "clone-widget")))))))

(defn selected-echo? []
  (let [integer-key (CAbi.type-key &(Type.integer))
        widget-key (CAbi.type-key &(Type.named "Widget" []))
        symbols (select-symbols &(fixture-implementations)
                                &(fixture-instances)
                                &[(String.copy &integer-key)
                                  widget-key
                                  integer-key])]
    (match-ref (TestSymbols.echo &symbols)
      (Maybe.Just plan)
        (let [strs (EchoPlan.strs plan)]
          (and
            (and
              (String.= (EchoPlan.println-symbol plan) "println_last")
              (String.= (EchoPlan.string-delete plan) "drop_last"))
            (and (Int.= 3 (Array.length strs))
                 (and
                   (and
                     (String.=
                       (EchoStr.symbol (Pair.b (Array.unsafe-nth strs 0)))
                       "show_int")
                     (not @(EchoStr.by-ref (Pair.b (Array.unsafe-nth strs 0)))))
                   (and
                     (String.=
                       (EchoStr.symbol (Pair.b (Array.unsafe-nth strs 1)))
                       "show_int")
                     (and
                       (String.=
                         (EchoStr.symbol (Pair.b (Array.unsafe-nth strs 2)))
                         "show_widget")
                       @(EchoStr.by-ref (Pair.b (Array.unsafe-nth strs 2)))))))))
      (Maybe.Nothing) false)))

(defn incomplete-echo? []
  (let [impls (fixture-implementations)
        no-delete [(native-spec 16
                                "show-int"
                                true
                                (unary (Type.integer) (Type.string))
                                "show_int")
                   (native-spec 30
                                "IO.println"
                                true
                                (unary
                                  (Type.reference (Type.string)
                                                  (Type.lifetime 0))
                                  (Type.unit))
                                "println")]
        no-println [(native-spec 10
                                 "drop"
                                 true
                                 (unary (Type.string) (Type.unit))
                                 "drop")
                    (native-spec 16
                                 "show-int"
                                 true
                                 (unary (Type.integer) (Type.string))
                                 "show_int")]
        keys [(CAbi.type-key &(Type.integer))]
        first (select-symbols &impls &no-delete &keys)
        second (select-symbols &impls &no-println &keys)]
    (and
      (Maybe.nothing? (TestSymbols.echo &first))
      (Maybe.nothing? (TestSymbols.echo &second)))))

(deftest t
  (assert-true t
    (table-policies?)
    "symbol tables preserve full reference identity, signature policies, order and raw names")
  (assert-true t
    (selected-echo?)
    "echo selection preserves duplicate order, last symbols and actual borrowing conventions")
  (assert-true t
    (incomplete-echo?)
    "echo selection requires both println and a String deleter")
  (assert-true t
    (let [symbols (select-symbols &(fixture-implementations)
                                  &(fixture-instances)
                                  &[])]
      (Maybe.nothing? (TestSymbols.echo &symbols)))
    "empty echo demand does not create an echo plan"))
