(load "../carp-specialize/carp-specialize.carp")
(load "../carp-ownership/carp-ownership.carp")
(load "../carp-c-abi/carp-c-abi.carp")
(load "git@github.com:carpentry-org/strbuf@0.2.1")

;; `Double.str`/`Float.str` format with `%g` (6 significant digits), losing
;; precision for literals like `Double.e`; the reference compiler emits the full
;; value. Format with enough digits to round-trip (17 for double, 9 for float).
(deftemplate full-double-string
             (Fn [Double] String)
             "String $NAME(double x)"
             "$DECL { char b[32]; snprintf(b, sizeof(b), \"%.17g\", x); String s = CARP_MALLOC(strlen(b)+1); strcpy(s, b); return s; }")

;; process-wide serial for hoisted array-literal temporaries. Global
;; initializers all render into one C function, so their hoisted names must not
;; restart per body.
(def *hoist-serial* 20000000)

(doc *backend-local-cell* "the downward id allocator for locals the backend
synthesizes (cleanup, root, echo, and param temporaries). Seeded per module
from one below the specialized module's lowest local id, so a synthesized
temp can never collide with an existing binder — the retired hardcoded
offsets could, once a program grew large enough.")
(def *backend-local-cell* (the (Array Int) [-1048577]))

(defn seed-backend-locals! [specialized]
  (Array.aset! &*backend-local-cell*
               0
               (Int.dec (Specialize.min-local-id specialized))))

(defn next-backend-local! []
  (let-do [value @(Array.unsafe-nth &*backend-local-cell* 0)]
    (Array.aset! &*backend-local-cell* 0 (Int.dec value))
    value))

(deftemplate full-float-string
             (Fn [Float] String)
             "String $NAME(float x)"
             "$DECL { char b[32]; snprintf(b, sizeof(b), \"%.9g\", (double)x); String s = CARP_MALLOC(strlen(b)+1); strcpy(s, b); return s; }")

(deftype BackendDependency [symbol String
                            signature (Box MonoType)])

(deftype BackendDeclaration
  (Function [String (Box MonoType) (Array CoreRef) (Box SpecializedExpr)])
  (Global [String (Box MonoType) (Box SpecializedExpr)])
  (Intrinsic [String (Box MonoType) (Maybe String)])
  (Constructor [String (Box MonoType) CoreConstructorDeclaration])
  (Template [String (Box MonoType) PrimitiveTemplate (Array BackendDependency)])
  (SourceTemplate [String (Box MonoType) (Box CoreType) String String]))

(doc ClosureFunction "a lifted lambda that captures free variables: its callback
is generated with a leading environment pointer, and the closure site populates
an environment struct of the captured values.")
(deftype ClosureFunction
  [symbol String
   signature (Box MonoType)
   captures (Array (Pair CoreRef (Box MonoType)))
   parameters (Array CoreRef)
   body (Box SpecializedExpr)])

(deftype BackendModule
  [declarations (Array BackendDeclaration)
   roots (Array (Box SpecializedExpr))
   constructors (Array CoreConstructorDeclaration)
   system-includes (Array String)
   closure-functions (Array ClosureFunction)])

(deftype BackendError [message String])

(doc ScopeDelete "a delete the ownership plan schedules for one owner in a
definition context: the owner binding, the deleter's C symbol, the concrete
type deleted, and the site (expression id) the plan anchored it to. Local
(let-bound) owners are cleaned up at their let scope, parameters at the
function's exit, set! overwrites at the set site, and by-value match bindings
at their branch's exit — the site disambiguates which node consumes each
delete.")
(deftype ScopeDelete [binder CoreRef
                      symbol String
                      type (Box MonoType)
                      site Int])

(doc EchoStr "how one concrete type renders for top-level result echo: the
specialized str C symbol and whether it takes its argument by reference.")
(deftype EchoStr [symbol String
                  by-ref Bool])

(doc EchoPlan "the driver's plan for echoing top-level expression results into
`main`, the way the reference compiles REPL echo: a table from concrete type
key to its str rendering, the specialized `IO.println` symbol, and the String
deleter for the rendered text.")
(deftype EchoPlan
  [strs (Array (Pair String EchoStr))
   println-symbol String
   string-delete String])

(deftype TemplateTypeBinding [name String
                              type (Box MonoType)])

(deftype ResultDestination
  (Return [(Box MonoType)])
  (Assign [String (Box MonoType)]))

(doc tail-expression-type "the type a statement-shaped expression actually
yields, taken from its tail. Scope nodes' own type fields can carry a hoist or
reflift wrapper's binding type, which would mislabel the result.")
(defn tail-expression-type [expression]
  (match-ref expression
    (SpecializedExpr.Let _ _ _ _ let-body)
      (tail-expression-type (Box.peek let-body))
    (SpecializedExpr.Do _ _ do-elements)
      (if (Int.> (Array.length do-elements) 0)
        (tail-expression-type
          (Box.peek
            (Array.unsafe-nth do-elements (Int.dec (Array.length do-elements)))))
        (Specialize.expression-type expression))
    (SpecializedExpr.If _ _ _ if-then _)
      (tail-expression-type (Box.peek if-then))
    (SpecializedExpr.Match _ _ _ _ match-branches)
      (if (Int.> (Array.length match-branches) 0)
        (tail-expression-type
          (Box.peek
            (SpecializedMatchBranch.body (Array.unsafe-nth match-branches 0))))
        (Specialize.expression-type expression))
    (SpecializedExpr.Annotation _ _ annotated _)
      (tail-expression-type (Box.peek annotated))
    _ (Specialize.expression-type expression)))

(defmodule BackendLower
  (private concrete?)
  (hidden concrete?)
  (private lower-dependencies)
  (hidden lower-dependencies)
  (private constructor-for)
  (hidden constructor-for)
  (defn concrete? [signature]
    (Int.= 0 (Array.length &(Type.free-variables signature))))

  (defn lower-dependencies [dependencies]
    (let-do [result (the (Array BackendDependency) [])
             n (Array.length dependencies)]
      (for [i 0 n]
        (let [dependency (Array.unsafe-nth dependencies i)]
          (set! result
                (Array.push-back result
                                 (BackendDependency.init
                                   (String.copy (SpecializedCall.symbol dependency))
                                   @(SpecializedCall.signature dependency))))))
      result))

  (defn constructor-for [constructors reference]
    (let-do [result (the (Maybe CoreConstructorDeclaration) (Maybe.Nothing))
             n (Array.length constructors)]
      (for [i 0 n]
        (let [constructor (Array.unsafe-nth constructors i)]
          (when (CoreIR.same-ref?
              (CoreConstructorDeclaration.reference constructor)
              reference)
            (set! result (Maybe.Just @constructor)))))
      result))

  (doc module "converts specialization output into concrete backend
  declarations. It rejects residual type variables rather than delegating them
  to a backend.")
  (defn module [specialized closures]
    (let-do [declarations (the (Array BackendDeclaration) [])
             failure (the (Maybe BackendError) (Maybe.Nothing))
             bodies (SpecializationModule.bodies specialized)
             primitives (SpecializationModule.primitives specialized)
             body-count (Array.length bodies)
             primitive-count (Array.length primitives)]
      (for [i 0 body-count]
        (match-ref &failure
          (Maybe.Nothing)
            (let [body (Array.unsafe-nth bodies i)
                  instance (SpecializedBody.specialization body)
                  signature (Box.peek (Specialization.signature instance))]
              (if (concrete? signature)
                ;; a `def` with a function type is still a global Lambda
                ;; variable, so the value flag decides, not the signature.
                (let [declaration (if (and
                          (match-ref signature
                            (MonoType.Function _ _) true
                            _ false)
                          (not @(SpecializedBody.value body)))
                        (BackendDeclaration.Function
                          (String.copy (Specialization.symbol instance))
                          @(Specialization.signature instance)
                          @(SpecializedBody.parameters body)
                          @(SpecializedBody.body body))
                        (BackendDeclaration.Global
                          (String.copy (Specialization.symbol instance))
                          @(Specialization.signature instance)
                          @(SpecializedBody.body body)))]
                  (Array.push-back! &declarations declaration))
                (set! failure
                      (Maybe.Just
                        (BackendError.init
                          @"backend function signature is not concrete")))))
          (Maybe.Just _) ()))
      (for [i 0 primitive-count]
        (match-ref &failure
          (Maybe.Nothing)
            (let [primitive (Array.unsafe-nth primitives i)
                  instance (SpecializedPrimitive.specialization primitive)
                  signature (Box.peek (Specialization.signature instance))]
              (if (concrete? signature)
                (let [constructor (constructor-for
                        (SpecializationModule.constructors specialized)
                        (Specialization.reference instance))
                      declaration (match constructor
                        (Maybe.Just found)
                          (BackendDeclaration.Constructor
                            (String.copy (Specialization.symbol instance))
                            @(Specialization.signature instance)
                            found)
                        (Maybe.Nothing)
                          (match-ref (SpecializedPrimitive.source primitive)
                            (Maybe.Just source)
                              (match-ref (SpecializedBuiltinSource.payload source)
                                (CoreBuiltinPayload.External _)
                                ;; a `register`ed external is declared by an
                                ;; included header; mark it so `prototype`
                                ;; skips emitting a (conflicting) declaration.
                                (BackendDeclaration.Intrinsic
                                  (String.copy (Specialization.symbol instance))
                                  @(Specialization.signature instance)
                                  (Maybe.Just
                                    (String.copy (Specialization.symbol instance))))
                                (CoreBuiltinPayload.Template source-declaration
                                                             source-body)
                                (BackendDeclaration.SourceTemplate
                                  (String.copy (Specialization.symbol instance))
                                  @(Specialization.signature instance)
                                  @(SpecializedBuiltinSource.signature source)
                                  (String.copy source-declaration)
                                  (String.copy source-body)))
                            (Maybe.Nothing)
                              (match-ref (SpecializedPrimitive.lowering primitive)
                                (PrimitiveLowering.Intrinsic)
                                  (BackendDeclaration.Intrinsic
                                    (String.copy (Specialization.symbol instance))
                                    @(Specialization.signature instance)
                                    (Maybe.Nothing))
                                (PrimitiveLowering.ParameterizedTemplate template)
                                  (BackendDeclaration.Template
                                    (String.copy (Specialization.symbol instance))
                                    @(Specialization.signature instance)
                                    @template
                                    (lower-dependencies
                                      (SpecializedPrimitive.dependencies primitive))))))]
                  (Array.push-back! &declarations declaration))
                (set! failure
                      (Maybe.Just
                        (BackendError.init
                          @"backend primitive signature is not concrete")))))
          (Maybe.Just _) ()))
      (match failure
        (Maybe.Just error) (Result.Error error)
        (Maybe.Nothing)
          (Result.Success
            (BackendModule.init declarations
                                @(SpecializationModule.roots specialized)
                                @(SpecializationModule.constructors specialized)
                                @(SpecializationModule.system-includes specialized)
                                @closures)))))

  (private lookup-delete-symbol)
  (hidden lookup-delete-symbol)
  (defn lookup-delete-symbol [delete-symbols key]
    (let-do [result (the (Maybe String) (Maybe.Nothing))
             n (Array.length delete-symbols)]
      (for [i 0 n]
        (when (String.= (Pair.a (Array.unsafe-nth delete-symbols i)) key)
          (set! result
                (Maybe.Just
                  (String.copy (Pair.b (Array.unsafe-nth delete-symbols i)))))))
      result))

  (private cleanup-for)
  (hidden cleanup-for)
  (defn cleanup-for [binder site body-deletes]
    (let-do [result (the (Maybe ScopeDelete) (Maybe.Nothing))
             n (Array.length body-deletes)]
      (for [i 0 n]
        (let [sd (Array.unsafe-nth body-deletes i)]
          (when (and
              (CoreIR.same-ref? (ScopeDelete.binder sd) binder)
              (Int.= @(ScopeDelete.site sd) site))
            (set! result (Maybe.Just @sd)))))
      result))

  (private make-delete-node)
  (hidden make-delete-node)
  (defn make-delete-node [binder value-type symbol]
    ;; a bare `Reference` to a global is rejected as a managed value (it would
    ;; be a move); a delete's argument deliberately consumes the old value, so
    ;; global owners pass through a `GlobalValue` node instead, which renders
    ;; as the global's C symbol.
    (let [argument (if @(CoreRef.global binder)
            (SpecializedExpr.GlobalValue -1
                                         (Box.init (MonoType.copy value-type))
                                         (CoreRef.copy binder)
                                         (Box.init (MonoType.copy value-type))
                                         (CAbi.mangle (CoreRef.name binder)
                                                      value-type)
                                         true)
            (SpecializedExpr.Reference -1
                                       (Box.init (MonoType.copy value-type))
                                       (CoreRef.copy binder)))]
      (SpecializedExpr.GlobalCall -1
                                  (Box.init (MonoType.Unit))
                                  (CoreRef.copy binder)
                                  (Box.init
                                    (MonoType.Function [(Box.init (MonoType.copy value-type))]
                                                       (Box.init (MonoType.Unit))))
                                  (String.copy symbol)
                                  [(Box.init argument)])))

  (private next-hoist)
  (hidden next-hoist)
  (defn next-hoist [counter]
    (let-do [value @(Array.unsafe-nth counter 0)]
      (Array.aset! counter 0 (Int.inc value))
      value))

  (private hoist-collect)
  (hidden hoist-collect)
  (private hoist-collect-array)
  (hidden hoist-collect-array)
  ;; forward declaration: statement-shaped arguments recurse back into
  ;; hoist-node (defined below) so literals inside them still get lifted.
  (sig hoist-node (Fn [(Ref SpecializedExpr) (Ref (Array Int))] SpecializedExpr))
  (sig hoist-collect
       (Fn
         [(Ref SpecializedExpr)
          (Ref (Array (Pair CoreRef SpecializedExpr)))
          (Ref (Array Int))]
         SpecializedExpr))
  (sig hoist-collect-array
       (Fn
         [(Ref (Array (Box SpecializedExpr)))
          (Ref (Array (Pair CoreRef SpecializedExpr)))
          (Ref (Array Int))]
         (Array (Box SpecializedExpr))))
  (defn hoist-collect-array [args cell counter]
    (let-do [result (the (Array (Box SpecializedExpr)) [])]
      (for [i 0 (Array.length args)]
        (Array.push-back! &result
                          (Box.init
                            (hoist-collect (Box.peek (Array.unsafe-nth args i))
                                           cell
                                           counter))))
      result))

  (doc hoist-collect
    "rewrites a value expression, lifting each managed `(Array a)`
literal into a fresh binding recorded in `cell` and replacing it with a reference
to that binding. Recurses through value-transparent constructs (calls, the `ref`
intrinsic, annotations); leaves statement-introducing nodes untouched.")
  (defn hoist-collect [expr cell counter]
    (match-ref expr
      (SpecializedExpr.ArrayLit id type elements)
      (let-do [hoisted (hoist-collect-array elements cell counter)
               fresh-id (next-hoist counter)
               fresh (CoreRef.init fresh-id
                                   (String.concat &[@"_hoist" (Int.str fresh-id)])
                                   false)]
        (Array.push-back! cell
                          (Pair.init (CoreRef.copy &fresh)
                                     (SpecializedExpr.ArrayLit @id
                                                               (Box.init (MonoType.copy (Box.peek type)))
                                                               hoisted)))
        (SpecializedExpr.Reference -1
                                   (Box.init (MonoType.copy (Box.peek type)))
                                   fresh))
      ;; statement-shaped forms in value position keep their own scopes; their
      ;; inner literals are lifted by recursing at statement level.
      (SpecializedExpr.Do _ _ _)
      (hoist-node expr counter)
      (SpecializedExpr.Let _ _ _ _ _)
      (hoist-node expr counter)
      (SpecializedExpr.If _ _ _ _ _)
      (hoist-node expr counter)
      (SpecializedExpr.Match _ _ _ _ _)
      (hoist-node expr counter)
      (SpecializedExpr.While _ _ _ _)
      (hoist-node expr counter)
      ;; a static array literal itself is stack storage (never hoisted), but
      ;; heap-array ELEMENTS inside it must still be lifted.
      (SpecializedExpr.StaticArrayLit id type elements)
      (SpecializedExpr.StaticArrayLit @id
                                      (Box.init (MonoType.copy (Box.peek type)))
                                      (hoist-collect-array elements cell counter))
      (SpecializedExpr.GlobalCall id type reference signature symbol args)
      (SpecializedExpr.GlobalCall @id
                                  (Box.init (MonoType.copy (Box.peek type)))
                                  (CoreRef.copy reference)
                                  (Box.init (MonoType.copy (Box.peek signature)))
                                  (String.copy symbol)
                                  (hoist-collect-array args cell counter))
      (SpecializedExpr.Call id type callee args)
      (SpecializedExpr.Call @id
                            (Box.init (MonoType.copy (Box.peek type)))
                            (Box.init
                              (hoist-collect (Box.peek callee) cell counter))
                            (hoist-collect-array args cell counter))
      (SpecializedExpr.Annotation id type inner annotation)
      (SpecializedExpr.Annotation @id
                                  (Box.init (MonoType.copy (Box.peek type)))
                                  (Box.init
                                    (hoist-collect (Box.peek inner) cell counter))
                                  (Box.init (CoreType.copy (Box.peek annotation))))
      _
      (SpecializedExpr.copy expr)))

  (private wrap-hoisted)
  (hidden wrap-hoisted)
  ;; a hoisted array that `inner` passes BY VALUE to a call is moved: the callee
  ;; owns it and deletes it, so freeing it here too is a double free. Only
  ;; borrowed (or unused) hoists get a free.
  (private hoist-freed?)
  (hidden hoist-freed?)
  ;; a hoisted literal is freed only if NOTHING consumed it: neither the
  ;; wrapped expression nor another hoisted literal's payload (nested array
  ;; literals hoist inner-first, so an inner binding is consumed inside an
  ;; OUTER binding's payload, not inside `inner`).
  (defn hoist-freed? [cell index binding inner]
    (if (Ownership.consumed? (Pair.a binding) inner)
      false
      (let-do [free true
               n (Array.length cell)]
        (for [j 0 n]
          (unless (Int.= j index)
            (when (Ownership.consumed? (Pair.a binding)
                                       (Pair.b (Array.unsafe-nth cell j)))
              (set! free false))))
        free)))

  (doc wrap-hoisted
    "wraps `inner` in a binding per hoisted array literal, freeing
each after `inner` is evaluated unless `inner` moves it into a call: unit results
become `(do inner frees...)`, other results are captured in a temporary so the
frees run before the result is returned.")
  (defn wrap-hoisted [cell inner counter]
    (if (Int.= 0 (Array.length cell))
      (SpecializedExpr.copy &inner)
      (let-do [inner-type (Specialize.expression-type &inner)
               is-unit (match-ref &inner-type (MonoType.Unit) true _ false)
               sentinel (the String (String.copy "__carp_array_free"))
               core (the SpecializedExpr
                         (SpecializedExpr.UnitLit -1 (Box.init (Type.unit))))]
        (if is-unit
          (let-do [elems (the (Array (Box SpecializedExpr)) [])]
            (Array.push-back! &elems (Box.init (SpecializedExpr.copy &inner)))
            (for [k 0 (Array.length cell)]
              (let [idx (Int.- (Int.- (Array.length cell) 1) k)
                    binding (Array.unsafe-nth cell idx)
                    array-type (Specialize.expression-type (Pair.b binding))]
                (when (hoist-freed? cell idx binding &inner)
                  (Array.push-back! &elems
                                    (Box.init
                                      (make-delete-node (Pair.a binding)
                                                        &array-type
                                                        &sentinel))))))
            (set! core (SpecializedExpr.Do -1 (Box.init (Type.unit)) elems)))
          (let-do [result-id (next-hoist counter)
                   result-ref (CoreRef.init result-id
                                            (String.concat &[@"_hoistr"
                                                             (Int.str result-id)])
                                            false)
                   elems (the (Array (Box SpecializedExpr)) [])]
            (for [k 0 (Array.length cell)]
              (let [idx (Int.- (Int.- (Array.length cell) 1) k)
                    binding (Array.unsafe-nth cell idx)
                    array-type (Specialize.expression-type (Pair.b binding))]
                (when (hoist-freed? cell idx binding &inner)
                  (Array.push-back! &elems
                                    (Box.init
                                      (make-delete-node (Pair.a binding)
                                                        &array-type
                                                        &sentinel))))))
            (Array.push-back! &elems
                              (Box.init
                                (SpecializedExpr.Reference -1
                                                           (Box.init (MonoType.copy &inner-type))
                                                           (CoreRef.copy &result-ref))))
            (set! core
                  (SpecializedExpr.Let -1
                                       (Box.init (MonoType.copy &inner-type))
                                       (CoreRef.copy &result-ref)
                                       (Box.init (SpecializedExpr.copy &inner))
                                       (Box.init
                                         (SpecializedExpr.Do -1
                                                             (Box.init (MonoType.copy &inner-type))
                                                             elems))))))
        (let-do [result core]
          (for [k 0 (Array.length cell)]
            (let [idx (Int.- (Int.- (Array.length cell) 1) k)
                  binding (Array.unsafe-nth cell idx)]
              ;; the wrapper Let's TYPE is its result's type, not the hoisted
              ;; array's: a statement-position wrapper must stay unit-typed or
              ;; root cleanup mistakes it for a leaked managed value.
              (set! result
                    (SpecializedExpr.Let -1
                                         (Box.init
                                           (if is-unit
                                             (Type.unit)
                                             (MonoType.copy &inner-type)))
                                         (CoreRef.copy (Pair.a binding))
                                         (Box.init (SpecializedExpr.copy (Pair.b binding)))
                                         (Box.init result)))))
          result))))

  (private hoist-node)
  (hidden hoist-node)
  (private hoist-branches)
  (hidden hoist-branches)
  (sig hoist-node (Fn [(Ref SpecializedExpr) (Ref (Array Int))] SpecializedExpr))
  (sig hoist-branches
       (Fn
         [(Ref (Array SpecializedMatchBranch)) (Ref (Array Int))]
         (Array SpecializedMatchBranch)))
  (defn hoist-branches [branches counter]
    (let-do [result (the (Array SpecializedMatchBranch) [])]
      (for [i 0 (Array.length branches)]
        (let [branch (Array.unsafe-nth branches i)]
          (Array.push-back! &result
                            (SpecializedMatchBranch.init @(SpecializedMatchBranch.pattern branch)
                                                         @(SpecializedMatchBranch.bindings branch)
                                                         (Box.init
                                                           (hoist-node
                                                             (Box.peek (SpecializedMatchBranch.body branch))
                                                             counter))))))
      result))

  (doc hoist-node "ANF-normalizes managed array literals out of value positions
so they only appear as `let` values (which the backend can allocate). Handles
each statement/tail context; while-loop conditions are left untouched since they
re-evaluate each iteration.")
  (defn hoist-node [expr counter]
    (match-ref expr
      (SpecializedExpr.Do id type elements)
        (let-do [result (the (Array (Box SpecializedExpr)) [])]
          (for [i 0 (Array.length elements)]
            (Array.push-back! &result
                              (Box.init
                                (hoist-node (Box.peek (Array.unsafe-nth elements
                                                                        i))
                                            counter))))
          (SpecializedExpr.Do @id
                              (Box.init (MonoType.copy (Box.peek type)))
                              result))
      (SpecializedExpr.Let id type reference value body)
        (let-do [cell (the (Array (Pair CoreRef SpecializedExpr)) [])
                 new-value (match-ref (Box.peek value)
                   (SpecializedExpr.ArrayLit vid vtype velems)
                   (SpecializedExpr.ArrayLit @vid
                                             (Box.init (MonoType.copy (Box.peek vtype)))
                                             (hoist-collect-array velems
                                                                  &cell
                                                                  counter))
                   ;; a binding whose value is itself a scope (as RefLift produces
                   ;; when it lifts `&(let ...)`) must be recursed into as a
                   ;; statement context so array literals nested inside it are
                   ;; hoisted; `hoist-collect` would otherwise leave them in value
                   ;; position.
                   (SpecializedExpr.Let _ _ _ _ _)
                   (hoist-node (Box.peek value) counter)
                   (SpecializedExpr.Do _ _ _)
                   (hoist-node (Box.peek value) counter)
                   (SpecializedExpr.If _ _ _ _ _)
                   (hoist-node (Box.peek value) counter)
                   (SpecializedExpr.Match _ _ _ _ _)
                   (hoist-node (Box.peek value) counter)
                   (SpecializedExpr.While _ _ _ _)
                   (hoist-node (Box.peek value) counter)
                   ;; a let-bound `set!` (the `ignored-x (set! ...)` idiom) is
                   ;; statement-shaped too: its value needs the Set arm's own
                   ;; hoisting, not value-position collection.
                   (SpecializedExpr.Set _ _ _ _)
                   (hoist-node (Box.peek value) counter)
                   _
                   (hoist-collect (Box.peek value) &cell counter))]
          (wrap-hoisted &cell
                        (SpecializedExpr.Let @id
                                             (Box.init (MonoType.copy (Box.peek type)))
                                             (CoreRef.copy reference)
                                             (Box.init new-value)
                                             (Box.init (hoist-node (Box.peek body)
                                                                   counter)))
                        counter))
      (SpecializedExpr.If id type condition then-branch else-branch)
        (let-do [cell (the (Array (Pair CoreRef SpecializedExpr)) [])
                 new-condition (hoist-collect (Box.peek condition) &cell counter)]
          (wrap-hoisted &cell
                        (SpecializedExpr.If @id
                                            (Box.init (MonoType.copy (Box.peek type)))
                                            (Box.init new-condition)
                                            (Box.init
                                              (hoist-node (Box.peek then-branch)
                                                          counter))
                                            (Box.init
                                              (hoist-node (Box.peek else-branch)
                                                          counter)))
                        counter))
      (SpecializedExpr.While id type condition body)
        (SpecializedExpr.While @id
                               (Box.init (MonoType.copy (Box.peek type)))
                               (Box.init
                                 (SpecializedExpr.copy (Box.peek condition)))
                               (Box.init (hoist-node (Box.peek body) counter)))
      (SpecializedExpr.Set id type reference value)
        (let-do [cell (the (Array (Pair CoreRef SpecializedExpr)) [])
                 new-value (hoist-collect (Box.peek value) &cell counter)]
          (wrap-hoisted &cell
                        (SpecializedExpr.Set @id
                                             (Box.init (MonoType.copy (Box.peek type)))
                                             (CoreRef.copy reference)
                                             (Box.init new-value))
                        counter))
      (SpecializedExpr.Match id type by-reference scrutinee branches)
        (let-do [cell (the (Array (Pair CoreRef SpecializedExpr)) [])
                 new-scrutinee (hoist-collect (Box.peek scrutinee) &cell counter)]
          (wrap-hoisted &cell
                        (SpecializedExpr.Match @id
                                               (Box.init (MonoType.copy (Box.peek type)))
                                               @by-reference
                                               (Box.init new-scrutinee)
                                               (hoist-branches branches counter))
                        counter))
      (SpecializedExpr.Lambda id type parameters body)
        (SpecializedExpr.Lambda @id
                                (Box.init (MonoType.copy (Box.peek type)))
                                (Array.copy parameters)
                                (Box.init (hoist-node (Box.peek body) counter)))
      _
        (let-do [cell (the (Array (Pair CoreRef SpecializedExpr)) [])
                 atomized (hoist-collect expr &cell counter)]
          (wrap-hoisted &cell atomized counter))))

  (doc hoist-array-literals
    "ANF entry point: lifts managed array literals out of
value positions in one body so the backend can allocate and free them. The
counter is process-wide, not per body: every global initializer renders into the
same `carp_init_globals` function, so a per-body counter gives two globals'
hoisted temporaries the same C name (issue seen in produces-output/globals).")
  (defn hoist-array-literals [expr]
    (let-do [counter (the (Array Int) [*hoist-serial*])
             lifted (hoist-node expr &counter)]
      (set! *hoist-serial* @(Array.unsafe-nth &counter 0))
      lifted))

  (private ref-id-listed?)
  (hidden ref-id-listed?)
  (defn ref-id-listed? [ids target]
    (let-do [found false]
      (for [i 0 (Array.length ids)]
        (when (Int.= @(Array.unsafe-nth ids i) target) (set! found true)))
      found))

  (private capture-listed?)
  (hidden capture-listed?)
  (defn capture-listed? [captures target]
    (let-do [found false]
      (for [i 0 (Array.length captures)]
        (when (Int.= @(CoreRef.id (Pair.a (Array.unsafe-nth captures i))) target)
          (set! found true)))
      found))

  (private collect-free)
  (hidden collect-free)
  (private collect-free-array)
  (hidden collect-free-array)
  (sig collect-free
       (Fn
         [(Ref SpecializedExpr)
          (Ref (Array Int))
          (Ref (Array (Pair CoreRef (Box MonoType))))]
         ()))
  (sig collect-free-array
       (Fn
         [(Ref (Array (Box SpecializedExpr)))
          (Ref (Array Int))
          (Ref (Array (Pair CoreRef (Box MonoType))))]
         ()))
  (defn collect-free-array [es bound acc]
    (for [i 0 (Array.length es)]
      (collect-free (Box.peek (Array.unsafe-nth es i)) bound acc)))

  (doc collect-free "accumulates the free local-variable references of `expr`
into `acc` (deduplicated): references not bound by `bound` (an id set extended at
every binding form). Local variables always appear as `Reference` nodes; globals
never do, so they are naturally excluded.")
  (defn collect-free [expr bound acc]
    (match-ref expr
      (SpecializedExpr.Reference _ type reference)
        (let [rid @(CoreRef.id reference)]
          (unless (or (ref-id-listed? bound rid) (capture-listed? acc rid))
            (Array.push-back! acc
                              (Pair.init @reference
                                         (Box.init (MonoType.copy (Box.peek type)))))))
      (SpecializedExpr.Let _ _ reference value body)
        (do
          (collect-free (Box.peek value) bound acc)
          (let-do [inner (Array.copy bound)]
            (Array.push-back! &inner @(CoreRef.id reference))
            (collect-free (Box.peek body) &inner acc)))
      (SpecializedExpr.Lambda _ _ parameters body)
        (let-do [inner (Array.copy bound)]
          (for [i 0 (Array.length parameters)]
            (Array.push-back! &inner
                              @(CoreRef.id (Array.unsafe-nth parameters i))))
          (collect-free (Box.peek body) &inner acc))
      (SpecializedExpr.Match _ _ _ scrutinee branches)
        (do
          (collect-free (Box.peek scrutinee) bound acc)
          (for [i 0 (Array.length branches)]
            (let-do [branch (Array.unsafe-nth branches i)
                     bindings (SpecializedMatchBranch.bindings branch)
                     inner (Array.copy bound)]
              (for [j 0 (Array.length bindings)]
                (Array.push-back! &inner
                                  @(CoreRef.id (Array.unsafe-nth bindings j))))
              (collect-free
                (Box.peek (SpecializedMatchBranch.body branch))
                &inner
                acc))))
      (SpecializedExpr.If _ _ condition then-branch else-branch)
        (do
          (collect-free (Box.peek condition) bound acc)
          (collect-free (Box.peek then-branch) bound acc)
          (collect-free (Box.peek else-branch) bound acc))
      (SpecializedExpr.While _ _ condition body)
        (do
          (collect-free (Box.peek condition) bound acc)
          (collect-free (Box.peek body) bound acc))
      (SpecializedExpr.Set _ _ _ value)
        (collect-free (Box.peek value) bound acc)
      (SpecializedExpr.Call _ _ callee args)
        (do
          (collect-free (Box.peek callee) bound acc)
          (collect-free-array args bound acc))
      (SpecializedExpr.GlobalCall _ _ _ _ _ args)
        (collect-free-array args bound acc)
      (SpecializedExpr.ArrayLit _ _ es) (collect-free-array es bound acc)
      (SpecializedExpr.StaticArrayLit _ _ es) (collect-free-array es bound acc)
      (SpecializedExpr.Do _ _ es) (collect-free-array es bound acc)
      (SpecializedExpr.Annotation _ _ inner _)
        (collect-free (Box.peek inner) bound acc)
      _ ()))

  (private free-vars)
  (hidden free-vars)
  (defn free-vars [body parameters]
    (let-do [bound (the (Array Int) [])
             acc (the (Array (Pair CoreRef (Box MonoType))) [])]
      (for [i 0 (Array.length parameters)]
        (Array.push-back! &bound @(CoreRef.id (Array.unsafe-nth parameters i))))
      (collect-free body &bound &acc)
      acc))

  (private lift-in-expr)
  (hidden lift-in-expr)
  (private lift-array-elems)
  (hidden lift-array-elems)
  (private lift-branches)
  (hidden lift-branches)
  (sig lift-in-expr
       (Fn
         [(Ref SpecializedExpr)
          (Ref (Array Int))
          (Ref (Array SpecializedBody))
          (Ref (Array ClosureFunction))]
         SpecializedExpr))
  (sig lift-array-elems
       (Fn
         [(Ref (Array (Box SpecializedExpr)))
          (Ref (Array Int))
          (Ref (Array SpecializedBody))
          (Ref (Array ClosureFunction))]
         (Array (Box SpecializedExpr))))
  (sig lift-branches
       (Fn
         [(Ref (Array SpecializedMatchBranch))
          (Ref (Array Int))
          (Ref (Array SpecializedBody))
          (Ref (Array ClosureFunction))]
         (Array SpecializedMatchBranch)))
  (defn lift-array-elems [es counter lifted closures]
    (let-do [result (the (Array (Box SpecializedExpr)) [])]
      (for [i 0 (Array.length es)]
        (Array.push-back! &result
                          (Box.init
                            (lift-in-expr (Box.peek (Array.unsafe-nth es i))
                                          counter
                                          lifted
                                          closures))))
      result))
  (defn lift-branches [branches counter lifted closures]
    (let-do [result (the (Array SpecializedMatchBranch) [])]
      (for [i 0 (Array.length branches)]
        (let [branch (Array.unsafe-nth branches i)]
          (Array.push-back! &result
                            (SpecializedMatchBranch.init @(SpecializedMatchBranch.pattern branch)
                                                         @(SpecializedMatchBranch.bindings branch)
                                                         (Box.init
                                                           (lift-in-expr
                                                             (Box.peek (SpecializedMatchBranch.body branch))
                                                             counter
                                                             lifted
                                                             closures))))))
      result))

  (doc lift-in-expr
    "lambda lifting: replaces each `(fn ...)` with a reference to a freshly
generated top-level function. Non-capturing lambdas become a `Lambda` struct with
no environment; capturing lambdas become a closure-construction call carrying the
captured values, plus a `ClosureFunction` (collected in `closures`) rendered with
a leading environment pointer. Recurses everywhere so nested lambdas lift too.")
  (defn lift-in-expr [expr counter lifted closures]
    (match-ref expr
      (SpecializedExpr.Lambda id type parameters body)
        (let-do [lifted-body (lift-in-expr (Box.peek body)
                                           counter
                                           lifted
                                           closures)
                 captures (free-vars &lifted-body parameters)
                 fresh-id (next-hoist counter)]
          (if (Int.= 0 (Array.length &captures))
            (let-do [symbol (String.concat &[@"_carp_lambda_" (Int.str fresh-id)])
                     reference (CoreRef.init fresh-id (String.copy &symbol) true)]
              (Array.push-back! lifted
                                (SpecializedBody.init
                                  (Specialization.init (CoreRef.copy &reference)
                                                       (Box.init (MonoType.copy (Box.peek type)))
                                                       (String.copy &symbol))
                                  (Array.copy parameters)
                                  (Box.init lifted-body)
                                  false))
              (SpecializedExpr.GlobalValue @id
                                           (Box.init (MonoType.copy (Box.peek type)))
                                           reference
                                           (Box.init (MonoType.copy (Box.peek type)))
                                           symbol
                                           false))
            (let-do [lambda-symbol (String.concat &[@"_carp_lambda_"
                                                    (Int.str fresh-id)])
                     closure-symbol (String.concat &[@"_carp_closure_"
                                                     (Int.str fresh-id)])
                     capture-exprs (the (Array (Box SpecializedExpr)) [])]
              (for [i 0 (Array.length &captures)]
                (let [capture (Array.unsafe-nth &captures i)]
                  (Array.push-back! &capture-exprs
                                    (Box.init
                                      (SpecializedExpr.Reference -1
                                                                 (Box.init
                                                                   (MonoType.copy (Box.peek (Pair.b capture))))
                                                                 (CoreRef.copy (Pair.a capture)))))))
              (Array.push-back! closures
                                (ClosureFunction.init (String.copy &lambda-symbol)
                                                      (Box.init (MonoType.copy (Box.peek type)))
                                                      @&captures
                                                      (Array.copy parameters)
                                                      (Box.init lifted-body)))
              (SpecializedExpr.GlobalCall @id
                                          (Box.init (MonoType.copy (Box.peek type)))
                                          (CoreRef.init fresh-id
                                                        (String.copy &closure-symbol)
                                                        true)
                                          (Box.init (MonoType.copy (Box.peek type)))
                                          closure-symbol
                                          capture-exprs))))
      (SpecializedExpr.Do id type es)
        (SpecializedExpr.Do @id
                            (Box.init (MonoType.copy (Box.peek type)))
                            (lift-array-elems es counter lifted closures))
      (SpecializedExpr.Let id type reference value body)
        (SpecializedExpr.Let @id
                             (Box.init (MonoType.copy (Box.peek type)))
                             (CoreRef.copy reference)
                             (Box.init
                               (lift-in-expr (Box.peek value)
                                             counter
                                             lifted
                                             closures))
                             (Box.init
                               (lift-in-expr (Box.peek body)
                                             counter
                                             lifted
                                             closures)))
      (SpecializedExpr.If id type condition then-branch else-branch)
        (SpecializedExpr.If @id
                            (Box.init (MonoType.copy (Box.peek type)))
                            (Box.init
                              (lift-in-expr (Box.peek condition)
                                            counter
                                            lifted
                                            closures))
                            (Box.init
                              (lift-in-expr (Box.peek then-branch)
                                            counter
                                            lifted
                                            closures))
                            (Box.init
                              (lift-in-expr (Box.peek else-branch)
                                            counter
                                            lifted
                                            closures)))
      (SpecializedExpr.While id type condition body)
        (SpecializedExpr.While @id
                               (Box.init (MonoType.copy (Box.peek type)))
                               (Box.init
                                 (lift-in-expr (Box.peek condition)
                                               counter
                                               lifted
                                               closures))
                               (Box.init
                                 (lift-in-expr (Box.peek body)
                                               counter
                                               lifted
                                               closures)))
      (SpecializedExpr.Set id type reference value)
        (SpecializedExpr.Set @id
                             (Box.init (MonoType.copy (Box.peek type)))
                             (CoreRef.copy reference)
                             (Box.init
                               (lift-in-expr (Box.peek value)
                                             counter
                                             lifted
                                             closures)))
      (SpecializedExpr.Match id type by-reference scrutinee branches)
        (SpecializedExpr.Match @id
                               (Box.init (MonoType.copy (Box.peek type)))
                               @by-reference
                               (Box.init
                                 (lift-in-expr (Box.peek scrutinee)
                                               counter
                                               lifted
                                               closures))
                               (lift-branches branches counter lifted closures))
      (SpecializedExpr.Call id type callee args)
        (SpecializedExpr.Call @id
                              (Box.init (MonoType.copy (Box.peek type)))
                              (Box.init
                                (lift-in-expr (Box.peek callee)
                                              counter
                                              lifted
                                              closures))
                              (lift-array-elems args counter lifted closures))
      (SpecializedExpr.GlobalCall id type reference signature symbol args)
        (SpecializedExpr.GlobalCall @id
                                    (Box.init (MonoType.copy (Box.peek type)))
                                    (CoreRef.copy reference)
                                    (Box.init (MonoType.copy (Box.peek signature)))
                                    (String.copy symbol)
                                    (lift-array-elems args
                                                      counter
                                                      lifted
                                                      closures))
      (SpecializedExpr.ArrayLit id type es)
        (SpecializedExpr.ArrayLit @id
                                  (Box.init (MonoType.copy (Box.peek type)))
                                  (lift-array-elems es counter lifted closures))
      (SpecializedExpr.StaticArrayLit id type es)
        (SpecializedExpr.StaticArrayLit @id
                                        (Box.init (MonoType.copy (Box.peek type)))
                                        (lift-array-elems es
                                                          counter
                                                          lifted
                                                          closures))
      (SpecializedExpr.Annotation id type inner annotation)
        (SpecializedExpr.Annotation @id
                                    (Box.init (MonoType.copy (Box.peek type)))
                                    (Box.init
                                      (lift-in-expr (Box.peek inner)
                                                    counter
                                                    lifted
                                                    closures))
                                    (Box.init (CoreType.copy (Box.peek annotation))))
      _ (SpecializedExpr.copy expr)))

  (doc lift-lambdas "lifts every lambda in the module's bodies and roots to a
top-level function. Non-capturing callbacks are appended to the module's bodies
(emitted through the normal path); capturing callbacks are returned separately as
`ClosureFunction`s for environment-aware rendering.")
  (defn lift-lambdas [specialized]
    (let-do [counter (the (Array Int) [30000000])
             lifted (the (Array SpecializedBody) [])
             closures (the (Array ClosureFunction) [])
             bodies (SpecializationModule.bodies specialized)
             roots (SpecializationModule.roots specialized)
             new-bodies (the (Array SpecializedBody) [])
             new-roots (the (Array (Box SpecializedExpr)) [])]
      (for [i 0 (Array.length bodies)]
        (let [body (Array.unsafe-nth bodies i)]
          (Array.push-back! &new-bodies
                            (SpecializedBody.init @(SpecializedBody.specialization body)
                                                  @(SpecializedBody.parameters body)
                                                  (Box.init
                                                    (lift-in-expr (Box.peek (SpecializedBody.body body))
                                                                  &counter
                                                                  &lifted
                                                                  &closures))
                                                  @(SpecializedBody.value body)))))
      (for [i 0 (Array.length roots)]
        (Array.push-back! &new-roots
                          (Box.init
                            (lift-in-expr (Box.peek (Array.unsafe-nth roots i))
                                          &counter
                                          &lifted
                                          &closures))))
      (for [i 0 (Array.length &lifted)]
        (Array.push-back! &new-bodies @(Array.unsafe-nth &lifted i)))
      (Pair.init
        (SpecializationModule.init
          @(SpecializationModule.instances specialized)
          new-bodies
          @(SpecializationModule.primitives specialized)
          new-roots
          @(SpecializationModule.constructors specialized)
          @(SpecializationModule.system-includes specialized))
        closures)))

  (private insert-cleanup)
  (hidden insert-cleanup)
  (private map-recurse)
  (hidden map-recurse)
  (private rewrite-root)
  (hidden rewrite-root)
  (doc array-managed-type?
    "reports whether a concrete type is a heap `(Array a)`
whose `data` allocation must be freed. `StaticArray` is stack-allocated and is
not included.")
  (defn array-managed-type? [type]
    (match-ref type
      (MonoType.Named name arguments)
        (and (String.= name "Array") (Int.> (Array.length arguments) 0))
      _ false))

  (doc array-free-symbol "the sentinel delete symbol for `(Array a)`. Array is a
builtin with no runtime deleter function; the backend inlines this sentinel to a
`CARP_FREE` of the array's data.")
  (defn array-free-symbol [] (String.copy "__carp_array_free"))

  (sig insert-cleanup
       (Fn
         [(Ref SpecializedExpr)
          (Ref (Array ScopeDelete))
          (Ref (Array (Pair String String)))
          (Ref (Array CoreConstructorDeclaration))]
         SpecializedExpr))
  (sig map-recurse
       (Fn
         [(Ref (Array (Box SpecializedExpr)))
          (Ref (Array ScopeDelete))
          (Ref (Array (Pair String String)))
          (Ref (Array CoreConstructorDeclaration))]
         (Array (Box SpecializedExpr))))
  (sig rewrite-root
       (Fn
         [(Ref SpecializedExpr) (Ref (Array (Pair String String)))]
         SpecializedExpr))
  (sig cleanup-after
       (Fn
         [SpecializedExpr (Ref CoreRef) (Ref MonoType) (Ref String)]
         SpecializedExpr))
  (sig insert-path-cleanup
       (Fn
         [(Ref SpecializedExpr) (Ref CoreRef) (Ref MonoType) (Ref String)]
         SpecializedExpr))

  (doc cleanup-after "evaluates an expression, deletes one still-owned
binding, then yields the expression's result.")
  (defn cleanup-after [expr binder value-type symbol]
    (let [body-type (tail-expression-type &expr)
          delete-node (make-delete-node binder value-type symbol)]
      (if (match-ref &body-type (MonoType.Unit) true _ false)
        (SpecializedExpr.Do -1
                            (Box.init (MonoType.Unit))
                            [(Box.init expr) (Box.init delete-node)])
        (let [temp (CoreRef.init (next-backend-local!) @"path-cleanup" false)]
          (SpecializedExpr.Let -1
                               (Box.init (MonoType.copy &body-type))
                               (CoreRef.copy &temp)
                               (Box.init expr)
                               (Box.init
                                 (SpecializedExpr.Do -1
                                                     (Box.init (MonoType.copy &body-type))
                                                     [(Box.init delete-node)
                                                      (Box.init
                                                        (SpecializedExpr.Reference
                                                          -1
                                                          (Box.init (MonoType.copy &body-type))
                                                          (CoreRef.copy &temp)))])))))))

  (doc insert-path-cleanup "inserts a delete on exactly the exits where
`binder` has not been moved. Conditional tail expressions are rewritten
branch-by-branch; an expression that never consumes the binder gets one
ordinary scope-exit cleanup.")
  (defn insert-path-cleanup [expr binder value-type symbol]
    (if (not (Ownership.consumed? binder expr))
      (cleanup-after (SpecializedExpr.copy expr) binder value-type symbol)
      (match-ref expr
        (SpecializedExpr.If id type c t e)
          (if (Ownership.consumed? binder (Box.peek c))
            (SpecializedExpr.copy expr)
            (SpecializedExpr.If @id
                                (Box.init (MonoType.copy (Box.peek type)))
                                (Box.init (SpecializedExpr.copy (Box.peek c)))
                                (Box.init
                                  (insert-path-cleanup (Box.peek t)
                                                       binder
                                                       value-type
                                                       symbol))
                                (Box.init
                                  (insert-path-cleanup (Box.peek e)
                                                       binder
                                                       value-type
                                                       symbol))))
        (SpecializedExpr.Match id type by-reference scrutinee branches)
          (if (Ownership.consumed? binder (Box.peek scrutinee))
            (SpecializedExpr.copy expr)
            (let-do [new-branches (the (Array SpecializedMatchBranch) [])
                     n (Array.length branches)]
              (for [i 0 n]
                (let [branch (Array.unsafe-nth branches i)]
                  (Array.push-back!
                    &new-branches
                    (SpecializedMatchBranch.init
                      @(SpecializedMatchBranch.pattern branch)
                      @(SpecializedMatchBranch.bindings branch)
                      (Box.init
                        (insert-path-cleanup
                          (Box.peek (SpecializedMatchBranch.body branch))
                          binder
                          value-type
                          symbol))))))
              (SpecializedExpr.Match @id
                                     (Box.init (MonoType.copy (Box.peek type)))
                                     @by-reference
                                     (Box.init
                                       (SpecializedExpr.copy (Box.peek scrutinee)))
                                     new-branches)))
        (SpecializedExpr.Let id type inner-binder value body)
          (if (Ownership.consumed? binder (Box.peek value))
            (SpecializedExpr.copy expr)
            (SpecializedExpr.Let @id
                                 (Box.init (MonoType.copy (Box.peek type)))
                                 (CoreRef.copy inner-binder)
                                 (Box.init (SpecializedExpr.copy (Box.peek value)))
                                 (Box.init
                                   (insert-path-cleanup (Box.peek body)
                                                        binder
                                                        value-type
                                                        symbol))))
        (SpecializedExpr.Do id type es)
          (let-do [n (Array.length es)
                   prefix-consumes false]
            (when (Int.> n 1)
              (for [i 0 (Int.dec n)]
                (when (Ownership.consumed? binder
                                            (Box.peek (Array.unsafe-nth es i)))
                  (set! prefix-consumes true))))
            (if (or prefix-consumes (Int.= n 0))
              (SpecializedExpr.copy expr)
              (let-do [new-es (the (Array (Box SpecializedExpr)) [])]
                (for [i 0 n]
                  (Array.push-back!
                    &new-es
                    (Box.init
                      (if (Int.= i (Int.dec n))
                        (insert-path-cleanup (Box.peek (Array.unsafe-nth es i))
                                             binder
                                             value-type
                                             symbol)
                        (SpecializedExpr.copy
                          (Box.peek (Array.unsafe-nth es i)))))))
                (SpecializedExpr.Do @id
                                    (Box.init (MonoType.copy (Box.peek type)))
                                    new-es))))
        (SpecializedExpr.Annotation id type inner core-type)
          (SpecializedExpr.Annotation
            @id
            (Box.init (MonoType.copy (Box.peek type)))
            (Box.init
              (insert-path-cleanup (Box.peek inner) binder value-type symbol))
            @core-type)
        _ (SpecializedExpr.copy expr))))

  (doc map-recurse "applies cleanup insertion to each element of an expression
list without treating any element as discarded (used for positions like call
arguments and array literals whose values are consumed, not dropped).")
  (defn map-recurse [es body-deletes delete-symbols constructors]
    (let-do [result (the (Array (Box SpecializedExpr)) [])
             n (Array.length es)]
      (for [i 0 n]
        (set! result
              (Array.push-back result
                               (Box.init
                                 (insert-cleanup (Box.peek (Array.unsafe-nth es
                                                                             i))
                                                 body-deletes
                                                 delete-symbols
                                                 constructors)))))
      result))

  (defn insert-cleanup [expr body-deletes delete-symbols constructors]
    (match-ref expr
      (SpecializedExpr.Let id type binder value body)
        (let [new-value (insert-cleanup (Box.peek value)
                                        body-deletes
                                        delete-symbols
                                        constructors)
              new-body (insert-cleanup (Box.peek body)
                                       body-deletes
                                       delete-symbols
                                       constructors)
              ;; the tail type, not the node's stamped field: a reflift/hoist
              ;; wrapper stamps the binding's type, which would mistype the
              ;; cleanup temp (and everything reading the tail downstream).
              body-type (tail-expression-type &new-body)]
          (match (cleanup-for binder @id body-deletes)
            (Maybe.Just sd)
              (let [value-type (Specialize.expression-type (Box.peek value))]
                (SpecializedExpr.Let
                  @id
                  (Box.init (MonoType.copy &body-type))
                  (CoreRef.copy binder)
                  (Box.init new-value)
                  (Box.init
                    (insert-path-cleanup &new-body
                                         binder
                                         &value-type
                                         (ScopeDelete.symbol &sd)))))
            (Maybe.Nothing)
              (SpecializedExpr.Let @id
                                   (Box.init (MonoType.copy (Box.peek type)))
                                   (CoreRef.copy binder)
                                   (Box.init new-value)
                                   (Box.init new-body))))
      (SpecializedExpr.Do id type es)
        (let-do [result (the (Array (Box SpecializedExpr)) [])
                 n (Array.length es)]
          (for [i 0 n]
            (let [cleaned (insert-cleanup (Box.peek (Array.unsafe-nth es i))
                                          body-deletes
                                          delete-symbols
                                          constructors)]
              (if (Int.< i (Int.dec n))
                (set! result
                      (Array.push-back result
                                       (Box.init (rewrite-root &cleaned
                                                               delete-symbols))))
                (set! result (Array.push-back result (Box.init cleaned))))))
          (SpecializedExpr.Do @id
                              (Box.init (MonoType.copy (Box.peek type)))
                              result))
      (SpecializedExpr.If id type c t e)
        (SpecializedExpr.If @id
                            (Box.init (MonoType.copy (Box.peek type)))
                            (Box.init
                              (insert-cleanup (Box.peek c)
                                              body-deletes
                                              delete-symbols
                                              constructors))
                            (Box.init
                              (insert-cleanup (Box.peek t)
                                              body-deletes
                                              delete-symbols
                                              constructors))
                            (Box.init
                              (insert-cleanup (Box.peek e)
                                              body-deletes
                                              delete-symbols
                                              constructors)))
      (SpecializedExpr.While id type c b)
        (SpecializedExpr.While @id
                               (Box.init (MonoType.copy (Box.peek type)))
                               (Box.init
                                 (insert-cleanup (Box.peek c)
                                                 body-deletes
                                                 delete-symbols
                                                 constructors))
                               (Box.init
                                 (insert-cleanup (Box.peek b)
                                                 body-deletes
                                                 delete-symbols
                                                 constructors)))
      (SpecializedExpr.Match id type by-reference scrutinee branches)
        (let-do [new-branches (the (Array SpecializedMatchBranch) [])
                 scrutinee-type (Specialize.expression-type (Box.peek scrutinee))
                 n (Array.length branches)]
          (for [i 0 n]
            (let-do [branch (Array.unsafe-nth branches i)
                     original-body (Box.peek (SpecializedMatchBranch.body branch))
                     body-id (Specialize.expression-id original-body)
                     cleaned (insert-cleanup original-body
                                             body-deletes
                                             delete-symbols
                                             constructors)
                     path-cleaned cleaned
                     bindings (SpecializedMatchBranch.bindings branch)
                     pattern @(SpecializedMatchBranch.pattern branch)
                     deletes (the (Array (Box SpecializedExpr)) [])]
              ;; A by-value binding can be moved on only some exits. Rewrite
              ;; its body so the scheduled delete lands only on exits that
              ;; retain ownership; an unconditional append would double-free
              ;; the paths that do move it.
              (for [j 0 (Array.length bindings)]
                (let [b (Array.unsafe-nth bindings j)]
                  (match (cleanup-for b body-id body-deletes)
                    (Maybe.Just sd)
                      (set! path-cleaned
                            (insert-path-cleanup
                              &path-cleaned
                              b
                              (Box.peek (ScopeDelete.type &sd))
                              (ScopeDelete.symbol &sd)))
                    (Maybe.Nothing) ())))
              ;; unbound (`_`) slots of a by-value match drop owned payloads:
              ;; bind each slot with a deleter to a fresh local and free it
              ;; at branch exit, alongside the scheduled binding deletes.
              ;; Slots without a deleter stay `Ignore`.
              (unless @by-reference
                (let [slots (Specialize.unbound-slot-types (SpecializedMatchBranch.pattern branch)
                                                           &scrutinee-type
                                                           constructors)]
                  (unless (Int.= 0 (Array.length &slots))
                    (let-do [fresh (the (Array CoreRef) [])
                             symbols (the (Array (Maybe String)) [])
                             mask (the (Array Bool) [])
                             any false
                             cursor (the (Array Int) [0])]
                      (for [j 0 (Array.length &slots)]
                        (let-do [slot (Array.unsafe-nth &slots j)
                                 symbol (match (lookup-delete-symbol delete-symbols
                                                                     &(CAbi.type-key slot))
                                   (Maybe.Just found) (Maybe.Just found)
                                   (Maybe.Nothing)
                                     (if (array-managed-type? slot)
                                       (Maybe.Just (array-free-symbol))
                                       (the (Maybe String) (Maybe.Nothing))))]
                          (Array.push-back! &fresh
                                            (CoreRef.init (next-backend-local!)
                                                          @"drop"
                                                          false))
                          (Array.push-back! &mask (Maybe.just? &symbol))
                          (when (Maybe.just? &symbol) (set! any true))
                          (Array.push-back! &symbols symbol)))
                      (when-do any
                        (set! pattern
                              (Specialize.bind-unbound-slots (SpecializedMatchBranch.pattern branch)
                                                             &fresh
                                                             &mask
                                                             &cursor))
                        (for [j 0 (Array.length &slots)]
                          (match-ref (Array.unsafe-nth &symbols j)
                            (Maybe.Just symbol)
                              (Array.push-back! &deletes
                                                (Box.init
                                                  (make-delete-node (Array.unsafe-nth &fresh
                                                                                      j)
                                                                    (Array.unsafe-nth &slots
                                                                                      j)
                                                                    symbol)))
                            (Maybe.Nothing) ())))))))
              (let [final-body (if (Int.= 0 (Array.length &deletes))
                      path-cleaned
                      (let [body-type (tail-expression-type &path-cleaned)]
                        (if (match-ref &body-type (MonoType.Unit) true _ false)
                          (let-do [elements [(Box.init path-cleaned)]]
                            (for [k 0 (Array.length &deletes)]
                              (Array.push-back! &elements
                                                @(Array.unsafe-nth &deletes k)))
                            (SpecializedExpr.Do -1
                                                (Box.init (MonoType.Unit))
                                                elements))
                          (let-do [temp (CoreRef.init (next-backend-local!)
                                                      @"branch"
                                                      false)
                                   elements (the (Array (Box SpecializedExpr))
                                                 [])]
                            (for [k 0 (Array.length &deletes)]
                              (Array.push-back! &elements
                                                @(Array.unsafe-nth &deletes k)))
                            (Array.push-back! &elements
                                              (Box.init
                                                (SpecializedExpr.Reference -1
                                                                           (Box.init (MonoType.copy &body-type))
                                                                           (CoreRef.copy &temp))))
                            (SpecializedExpr.Let -1
                                                 (Box.init (MonoType.copy &body-type))
                                                 (CoreRef.copy &temp)
                                                 (Box.init path-cleaned)
                                                 (Box.init
                                                   (SpecializedExpr.Do -1
                                                                       (Box.init (MonoType.copy &body-type))
                                                                       elements)))))))]
                (set! new-branches
                      (Array.push-back new-branches
                                       (SpecializedMatchBranch.init pattern
                                                                    @(SpecializedMatchBranch.bindings branch)
                                                                    (Box.init final-body)))))))
          (SpecializedExpr.Match @id
                                 (Box.init (MonoType.copy (Box.peek type)))
                                 @by-reference
                                 (Box.init
                                   (insert-cleanup (Box.peek scrutinee)
                                                   body-deletes
                                                   delete-symbols
                                                   constructors))
                                 new-branches))
      (SpecializedExpr.Set id type target value)
        (let [new-value (insert-cleanup (Box.peek value)
                                        body-deletes
                                        delete-symbols
                                        constructors)]
          (match (cleanup-for target @id body-deletes)
            ;; the plan scheduled a delete of the overwritten value here:
            ;; evaluate the new value first (it may borrow the old one), then
            ;; delete the old value, then assign.
            (Maybe.Just sd)
            (let [value-type (Specialize.expression-type (Box.peek value))
                  temp (CoreRef.init (next-backend-local!) @"setold" false)]
              (SpecializedExpr.Let -1
                                   (Box.init (MonoType.Unit))
                                   (CoreRef.copy &temp)
                                   (Box.init new-value)
                                   (Box.init
                                     (SpecializedExpr.Do -1
                                                         (Box.init (MonoType.Unit))
                                                         [(Box.init
                                                            (make-delete-node target
                                                                              &value-type
                                                                              (ScopeDelete.symbol &sd)))
                                                          (Box.init
                                                            (SpecializedExpr.Set @id
                                                                                 (Box.init (MonoType.copy (Box.peek type)))
                                                                                 (CoreRef.copy target)
                                                                                 (Box.init
                                                                                   (SpecializedExpr.Reference -1
                                                                                                              (Box.init (MonoType.copy &value-type))
                                                                                                              (CoreRef.copy &temp)))))]))))
            (Maybe.Nothing)
            (SpecializedExpr.Set @id
                                 (Box.init (MonoType.copy (Box.peek type)))
                                 (CoreRef.copy target)
                                 (Box.init new-value))))
      (SpecializedExpr.Annotation id type inner core-type)
        (SpecializedExpr.Annotation @id
                                    (Box.init (MonoType.copy (Box.peek type)))
                                    (Box.init
                                      (insert-cleanup (Box.peek inner)
                                                      body-deletes
                                                      delete-symbols
                                                      constructors))
                                    @core-type)
      (SpecializedExpr.Call id type callee args)
        (SpecializedExpr.Call @id
                              (Box.init (MonoType.copy (Box.peek type)))
                              (Box.init
                                (insert-cleanup (Box.peek callee)
                                                body-deletes
                                                delete-symbols
                                                constructors))
                              (map-recurse args
                                           body-deletes
                                           delete-symbols
                                           constructors))
      (SpecializedExpr.GlobalCall id type callee signature symbol args)
        (SpecializedExpr.GlobalCall @id
                                    (Box.init (MonoType.copy (Box.peek type)))
                                    (CoreRef.copy callee)
                                    @signature
                                    (String.copy symbol)
                                    (map-recurse args
                                                 body-deletes
                                                 delete-symbols
                                                 constructors))
      (SpecializedExpr.ArrayLit id type es)
        (SpecializedExpr.ArrayLit @id
                                  (Box.init (MonoType.copy (Box.peek type)))
                                  (map-recurse es
                                               body-deletes
                                               delete-symbols
                                               constructors))
      (SpecializedExpr.StaticArrayLit id type es)
        (SpecializedExpr.StaticArrayLit @id
                                        (Box.init (MonoType.copy (Box.peek type)))
                                        (map-recurse es
                                                     body-deletes
                                                     delete-symbols
                                                     constructors))
      (SpecializedExpr.Lambda id type params body)
        (SpecializedExpr.Lambda @id
                                (Box.init (MonoType.copy (Box.peek type)))
                                @params
                                (Box.init
                                  (insert-cleanup (Box.peek body)
                                                  body-deletes
                                                  delete-symbols
                                                  constructors)))
      _ (SpecializedExpr.copy expr)))

  (private deletes-for-context)
  (hidden deletes-for-context)
  (defn deletes-for-context [actions context-id delete-symbols]
    (let-do [result (the (Array ScopeDelete) [])
             failed false
             n (Array.length actions)]
      (for [i 0 n]
        (match-ref (Array.unsafe-nth actions i)
          (OwnershipAction.Delete site resource type)
            (when (Int.= @(OwnershipSite.context site) context-id)
              (match-ref resource
                (OwnershipResource.Binding binder)
                  (match (lookup-delete-symbol delete-symbols
                                               &(CAbi.type-key (Box.peek type)))
                    (Maybe.Just symbol)
                    (set! result
                          (Array.push-back result
                                           (ScopeDelete.init (CoreRef.copy binder)
                                                             symbol
                                                             (Box.init (MonoType.copy (Box.peek type)))
                                                             @(OwnershipSite.expression site))))
                    (Maybe.Nothing)
                    ;; arrays whose deleter instance was not demanded fall back
                    ;; to the shallow data free.
                    (if (array-managed-type? (Box.peek type))
                      (set! result
                            (Array.push-back result
                                             (ScopeDelete.init (CoreRef.copy binder)
                                                               (array-free-symbol)
                                                               (Box.init (MonoType.copy (Box.peek type)))
                                                               @(OwnershipSite.expression site))))
                      (set! failed true)))
                _ ()))
          _ ()))
      (if failed
        (Result.Error
          (BackendError.init @"no concrete deleter for an owned local"))
        (Result.Success result))))

  (private echo-str-for)
  (hidden echo-str-for)
  (defn echo-str-for [echo key]
    (match-ref echo
      (Maybe.Just plan)
        (let-do [result (the (Maybe EchoStr) (Maybe.Nothing))
                 strs (EchoPlan.strs plan)
                 n (Array.length strs)]
          (for [i 0 n]
            (when (String.= (Pair.a (Array.unsafe-nth strs i)) key)
              (set! result (Maybe.Just @(Pair.b (Array.unsafe-nth strs i))))))
          result)
      (Maybe.Nothing) (the (Maybe EchoStr) (Maybe.Nothing))))

  (private make-ref-node)
  (hidden make-ref-node)
  (defn make-ref-node [operand operand-type]
    (SpecializedExpr.GlobalCall -1
                                (Box.init
                                  (MonoType.Reference (Box.init (MonoType.copy operand-type))
                                                      (MonoLifetime.Static)))
                                (PrimitiveRegistry.ref-reference)
                                (Box.init
                                  (MonoType.Function
                                    [(Box.init (MonoType.copy operand-type))]
                                    (Box.init
                                      (MonoType.Reference (Box.init (MonoType.copy operand-type))
                                                          (MonoLifetime.Static)))))
                                (String.copy "ref")
                                [(Box.init operand)]))

  (doc echo-root "wraps a top-level expression so its result is rendered with
its specialized str and printed, mirroring the reference's REPL echo compiled
into `main`: bind the result, str it (by ref or value per the impl), println
the text, delete the text, delete the result when owned.")
  (private echo-root)
  (hidden echo-root)
  (defn echo-root [root root-type echo-str plan delete-symbols]
    (let-do [value-temp (CoreRef.init (next-backend-local!) @"root" false)
             text-temp (CoreRef.init (next-backend-local!) @"echo" false)
             by-ref @(EchoStr.by-ref echo-str)
             str-argument (if by-ref
               (make-ref-node
                 (SpecializedExpr.Reference -1
                                            (Box.init (MonoType.copy root-type))
                                            (CoreRef.copy &value-temp))
                 root-type)
               (SpecializedExpr.Reference -1
                                          (Box.init (MonoType.copy root-type))
                                          (CoreRef.copy &value-temp)))
             str-call (SpecializedExpr.GlobalCall -1
                                                  (Box.init (MonoType.String))
                                                  (CoreRef.copy &text-temp)
                                                  (Box.init
                                                    (MonoType.Function [(Box.init (MonoType.copy root-type))]
                                                                       (Box.init (MonoType.String))))
                                                  (String.copy (EchoStr.symbol echo-str))
                                                  [(Box.init str-argument)])
             println-call (SpecializedExpr.GlobalCall -1
                                                      (Box.init (MonoType.Unit))
                                                      (CoreRef.copy &text-temp)
                                                      (Box.init
                                                        (MonoType.Function
                                                          [(Box.init
                                                             (MonoType.Reference (Box.init (MonoType.String))
                                                                                 (MonoLifetime.Static)))]
                                                          (Box.init (MonoType.Unit))))
                                                      (String.copy (EchoPlan.println-symbol plan))
                                                      [(Box.init
                                                         (make-ref-node
                                                           (SpecializedExpr.Reference -1
                                                                                      (Box.init (MonoType.String))
                                                                                      (CoreRef.copy &text-temp))
                                                           &(MonoType.String)))])
             elements [(Box.init println-call)
                       (Box.init
                         (make-delete-node &text-temp
                                           &(MonoType.String)
                                           (EchoPlan.string-delete plan)))]]
      ;; a by-value str consumed the result; a by-ref str left it live, so an
      ;; owned result still needs its deleter.
      (when by-ref
        (match (lookup-delete-symbol delete-symbols &(CAbi.type-key root-type))
          (Maybe.Just symbol)
            (Array.push-back! &elements
                              (Box.init
                                (make-delete-node &value-temp root-type &symbol)))
          (Maybe.Nothing) ()))
      (Array.push-back! &elements
                        (Box.init
                          (SpecializedExpr.UnitLit -1 (Box.init (MonoType.Unit)))))
      (SpecializedExpr.Let -1
                           (Box.init (MonoType.Unit))
                           (CoreRef.copy &value-temp)
                           (Box.init (SpecializedExpr.copy root))
                           (Box.init
                             (SpecializedExpr.Let -1
                                                  (Box.init (MonoType.Unit))
                                                  (CoreRef.copy &text-temp)
                                                  (Box.init str-call)
                                                  (Box.init
                                                    (SpecializedExpr.Do -1
                                                                        (Box.init (MonoType.Unit))
                                                                        elements)))))))

  (doc rewrite-root "wraps an ownerless top-level expression whose result is an
owned value in a temporary binding plus its deleter, since a root expression
always discards its result. Roots that produce unmanaged values are left as-is.")
  (defn rewrite-root [root delete-symbols]
    (let [root-type (Specialize.expression-type root)]
      (match (match (lookup-delete-symbol delete-symbols
                                          &(CAbi.type-key &root-type))
          (Maybe.Just symbol) (Maybe.Just symbol)
          (Maybe.Nothing)
            (if (array-managed-type? &root-type)
              (Maybe.Just (array-free-symbol))
              (the (Maybe String) (Maybe.Nothing))))
        (Maybe.Just symbol)
          (let [temp (CoreRef.init (next-backend-local!) @"root" false)]
            (SpecializedExpr.Let -1
                                 (Box.init (MonoType.Unit))
                                 (CoreRef.copy &temp)
                                 (Box.init (SpecializedExpr.copy root))
                                 (Box.init
                                   (SpecializedExpr.Do -1
                                                       (Box.init (MonoType.Unit))
                                                       [(Box.init
                                                          (make-delete-node &temp
                                                                            &root-type
                                                                            &symbol))
                                                        (Box.init
                                                          (SpecializedExpr.UnitLit -1
                                                                                   (Box.init (MonoType.Unit))))]))))
        (Maybe.Nothing) (SpecializedExpr.copy root))))

  (private rewrite-root-echoed)
  (hidden rewrite-root-echoed)
  (defn rewrite-root-echoed [root delete-symbols echo]
    (let [root-type (Specialize.expression-type root)]
      (match-ref &root-type
        (MonoType.Unit) (rewrite-root root delete-symbols)
        _
          (match (echo-str-for echo &(CAbi.type-key &root-type))
            (Maybe.Just estr)
              (match-ref echo
                (Maybe.Just plan)
                  (echo-root root &root-type &estr plan delete-symbols)
                (Maybe.Nothing) (rewrite-root root delete-symbols))
            (Maybe.Nothing) (rewrite-root root delete-symbols)))))

  (private rewrite-roots-array)
  (hidden rewrite-roots-array)
  (defn rewrite-roots-array [roots delete-symbols echo]
    (let-do [result (the (Array (Box SpecializedExpr)) [])
             n (Array.length roots)]
      (for [i 0 n]
        (set! result
              (Array.push-back result
                               (Box.init
                                 (rewrite-root-echoed
                                   &(hoist-array-literals (Box.peek (Array.unsafe-nth roots
                                                                                      i)))
                                   delete-symbols
                                   echo)))))
      result))

  (private binder-in?)
  (hidden binder-in?)
  (defn binder-in? [refs binder]
    (let-do [found false
             n (Array.length refs)]
      (for [i 0 n]
        (when (CoreIR.same-ref? (Array.unsafe-nth refs i) binder)
          (set! found true)))
      found))

  (private wrap-params)
  (hidden wrap-params)
  (doc wrap-params "wraps a function body so its owned parameters are deleted at
function exit on exactly the paths that do not consume them.")
  (defn wrap-params [body param-deletes]
    (let-do [result body]
      (for [i 0 (Array.length param-deletes)]
        (let [pd (Array.unsafe-nth param-deletes i)]
          (set! result
                (insert-path-cleanup &result
                                     (ScopeDelete.binder pd)
                                     (Box.peek (ScopeDelete.type pd))
                                     (ScopeDelete.symbol pd)))))
      result))

  (private rewrite-bodies)
  (hidden rewrite-bodies)
  (defn rewrite-bodies [specialized ownership delete-symbols echo]
    (let-do [bodies (SpecializationModule.bodies specialized)
             actions (OwnershipPlan.actions ownership)
             new-bodies (the (Array SpecializedBody) [])
             failure (the (Maybe BackendError) (Maybe.Nothing))
             n (Array.length bodies)]
      (for [i 0 n]
        (match-ref &failure
          (Maybe.Nothing)
            (let [body (Array.unsafe-nth bodies i)]
              (match (deletes-for-context actions i delete-symbols)
                (Result.Success all-deletes)
                  (let-do [params (SpecializedBody.parameters body)
                           root-id (Specialize.expression-id (Box.peek (SpecializedBody.body body)))
                           locals (the (Array ScopeDelete) [])
                           param-dels (the (Array ScopeDelete) [])]
                    (for [j 0 (Array.length &all-deletes)]
                      (let [sd (Array.unsafe-nth &all-deletes j)]
                        ;; parameter deletes are the ones sited at the body
                        ;; root; a set!-site delete on a parameter stays local.
                        (if (and
                            (binder-in? params (ScopeDelete.binder sd))
                            (Int.= @(ScopeDelete.site sd) root-id))
                          (set! param-dels (Array.push-back param-dels @sd))
                          (set! locals (Array.push-back locals @sd)))))
                    (set! new-bodies
                          (Array.push-back new-bodies
                                           (SpecializedBody.init @(SpecializedBody.specialization body)
                                                                 @(SpecializedBody.parameters body)
                                                                 (Box.init
                                                                   (wrap-params
                                                                     (insert-cleanup
                                                                       &(hoist-array-literals (Box.peek (SpecializedBody.body body)))
                                                                       &locals
                                                                       delete-symbols
                                                                       (SpecializationModule.constructors specialized))
                                                                     &param-dels))
                                                                 @(SpecializedBody.value body)))))
                (Result.Error e) (set! failure (Maybe.Just e))))
          (Maybe.Just _) ()))
      (match failure
        (Maybe.Just e) (Result.Error e)
        (Maybe.Nothing)
          (Result.Success
            (SpecializationModule.init
              @(SpecializationModule.instances specialized)
              new-bodies
              @(SpecializationModule.primitives specialized)
              (rewrite-roots-array (SpecializationModule.roots specialized)
                                   delete-symbols
                                   echo)
              @(SpecializationModule.constructors specialized)
              @(SpecializationModule.system-includes specialized))))))

  (doc module-with-ownership-echoed "like module-with-ownership, additionally
echoing each non-unit root result through the driver's echo plan (top-level
REPL-echo semantics compiled into `main`).")
  (defn module-with-ownership-echoed [specialized ownership delete-symbols echo]
    (do
      (seed-backend-locals! specialized)
      ;; the hoist stream also names lifted-lambda globals: keep it above both
      ;; its legacy floor (positive C-name suffixes) and every specialized
      ;; global id.
      (set! *hoist-serial*
            (Int.max 20000000 (Int.inc (Specialize.max-global-id specialized))))
      (let [contexts (OwnershipPlan.contexts ownership)
            lifted-pair (lift-lambdas specialized)]
        (if (Int.> (Array.length contexts) 0)
          (match (rewrite-bodies (Pair.a &lifted-pair)
                                 ownership
                                 delete-symbols
                                 echo)
            (Result.Success rewritten) (module &rewritten (Pair.b &lifted-pair))
            (Result.Error e) (Result.Error e))
          (Result.Error
            (BackendError.init @"ownership plan has no root context"))))))

  (doc module-with-ownership "lowers a specialized module after the ownership
phase has established its side table, rewriting each body to insert the concrete
delete calls its plan schedules (resolved through `delete-symbols`, a table from
concrete type key to deleter C symbol).")
  (defn module-with-ownership [specialized ownership delete-symbols]
    (module-with-ownership-echoed specialized
                                  ownership
                                  delete-symbols
                                  &(the (Maybe EchoPlan) (Maybe.Nothing)))))

;; binder ids granted their plain Carp name as C identifier in the function
;; being rendered (first binder of each eligible name wins; the rest keep the
;; mangled form). Plain names let `Unsafe.C.asm` macros reference locals.
(def *plain-local-ids* (the (Array Int) []))

;; the C symbol whose declaration is currently being rendered; diagnostic
;; context only (set per declaration, read by render guards).
(def *render-context* (the (Array String) []))

(defmodule CBackend
  (private sanitize)
  (hidden sanitize)
  (private valid-system-include?)
  (hidden valid-system-include?)
  (private string-listed?)
  (hidden string-listed?)
  (private append-system-include!)
  (hidden append-system-include!)
  (private expression-global-score)
  (hidden expression-global-score)
  (private expressions-global-score)
  (hidden expressions-global-score)
  (private branches-global-score)
  (hidden branches-global-score)
  (private global-symbol-score)
  (hidden global-symbol-score)
  (private greater-score)
  (hidden greater-score)
  (private constant-global-initializer?)
  (hidden constant-global-initializer?)

  (private local-symbol)
  (hidden local-symbol)
  (private specialized-type)
  (hidden specialized-type)
  (private render-call-arguments)
  (hidden render-call-arguments)
  (private render-value-expression)
  (hidden render-value-expression)

  (private render-argument-types)
  (hidden render-argument-types)
  (private render-statement-value)
  (hidden render-statement-value)
  (sig render-statement-value
       (Fn
         [(Ref (Array CoreConstructorDeclaration)) (Ref SpecializedExpr)]
         (Result String BackendError)))
  (private render-closure-construction)
  (hidden render-closure-construction)
  (sig render-closure-construction
       (Fn
         [(Ref (Array CoreConstructorDeclaration))
          (Ref String)
          (Ref (Array (Box SpecializedExpr)))]
         (Result String BackendError)))
  (private render-env-fields)
  (hidden render-env-fields)
  (sig render-env-fields
       (Fn
         [(Ref (Array CoreConstructorDeclaration))
          (Ref (Array (Box SpecializedExpr)))]
         (Result String BackendError)))
  (private unmanaged-type?)
  (hidden unmanaged-type?)
  (sig unmanaged-type?
       (Fn [(Ref (Array CoreConstructorDeclaration)) (Ref MonoType)] Bool))
  (private append-indent!)
  (hidden append-indent!)
  (private append-local-declaration!)
  (hidden append-local-declaration!)
  (private append-statement!)
  (hidden append-statement!)
  (sig append-statement!
       (Fn
         [(Ref (Array CoreConstructorDeclaration))
          (Ref StringBuf)
          (Ref SpecializedExpr)
          Int]
         (Result Unit BackendError)))
  (private append-result!)
  (hidden append-result!)
  (sig append-result!
       (Fn
         [(Ref (Array CoreConstructorDeclaration))
          (Ref StringBuf)
          (Ref SpecializedExpr)
          (Ref ResultDestination)
          Int]
         (Result Unit BackendError)))
