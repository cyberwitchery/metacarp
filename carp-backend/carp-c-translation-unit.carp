;; translation units and the C entry point. loaded last, since it uses the
;; other renderers.

(doc prototypes "returns the C declarations of every declaration and closure of
`module`.")
(defn prototypes [module]
  (let-do [result (the (Result Unit BackendError) (Result.Success ()))
           buffer (StringBuf.create)
           declarations (BackendModule.declarations module)
           n (Array.length declarations)]
    (for [i 0 n]
      (match-ref &result
        (Result.Success _)
          (match (prototype (Array.unsafe-nth declarations i))
            (Result.Success rendered)
              (do
                (StringBuf.append-str &buffer &rendered)
                (when (Int.< (Int.inc i) n)
                  (StringBuf.append-char &buffer \newline))
                ())
            (Result.Error error) (set! result (Result.Error error)))
        (Result.Error _) ()))
    (match result
      (Result.Success _)
        (match (closure-prototypes-of module)
          (Result.Success rendered-closures)
            (do
              (StringBuf.append-str &buffer &rendered-closures)
              (Result.Success (StringBuf.into-string buffer)))
          (Result.Error error) (Result.Error error))
      (Result.Error error) (Result.Error error))))

(private runtime-begin!)
(hidden runtime-begin!)
(defn runtime-begin! [buffer enabled]
  (when enabled (StringBuf.append-str buffer "
#pragma clang attribute push(__attribute__((annotate(\"metacarp.runtime\"))), apply_to = any(function, variable(is_global)))
")))

(private runtime-end!)
(hidden runtime-end!)
(defn runtime-end! [buffer enabled] (when enabled (StringBuf.append-str buffer "
#pragma clang attribute pop
")))

(private translation-unit-emission-with-runtime)
(hidden translation-unit-emission-with-runtime)
(defn translation-unit-emission-with-runtime [module runtime-imports]
  (match (prototypes module)
    (Result.Success declarations)
      (match (template-emission module)
        (Result.Success templates)
          (match (function-definitions module)
            (Result.Success functions)
              (match (global-definitions module)
                (Result.Success globals)
                  (match (global-initializers module)
                    (Result.Success initializers)
                      (match (nominal-definitions module)
                        (Result.Success nominals)
                          (match (constructor-definitions module)
                            (Result.Success nominal-constructors)
                              (match (system-includes module)
                                (Result.Success includes)
                                  (let-do [buffer (StringBuf.create)
                                           _runtime-begin (runtime-begin! &buffer
                                                                          runtime-imports)
                                           _ignored-includes (StringBuf.append-str &buffer
                                                                                   &includes)
                                           _runtime-end (runtime-end! &buffer
                                                                      runtime-imports)]
                                    ;; a library hides whatever it defines
                                    ;; from here on, so an emitter that
                                    ;; forgets `linkage` still stays out of
                                    ;; a shared library's exports. the
                                    ;; headers above keep their visibility,
                                    ;; and with it every c function the
                                    ;; library calls.
                                    (when (Maybe.just? &*library-exports*)
                                      (StringBuf.append-str &buffer "
#pragma GCC visibility push(hidden)
"))
                                    (unless-do (String.empty? &nominals)
                                      (StringBuf.append-char &buffer \newline)
                                      (StringBuf.append-str &buffer &nominals)
                                      (StringBuf.append-char &buffer \newline))
                                    (unless-do (String.empty? &declarations)
                                      (StringBuf.append-char &buffer \newline)
                                      (StringBuf.append-str &buffer
                                                            &declarations)
                                      (StringBuf.append-char &buffer \newline))
                                    (unless-do (String.empty? (CTranslationUnit.source &templates))
                                      (StringBuf.append-char &buffer \newline)
                                      (StringBuf.append-str &buffer
                                                            (CTranslationUnit.source &templates))
                                      (StringBuf.append-char &buffer \newline))
                                    (unless-do (String.empty? &nominal-constructors)
                                      (StringBuf.append-char &buffer \newline)
                                      (StringBuf.append-str &buffer
                                                            &nominal-constructors)
                                      (StringBuf.append-char &buffer \newline))
                                    (unless-do (String.empty? &globals)
                                      (StringBuf.append-char &buffer \newline)
                                      (StringBuf.append-str &buffer &globals)
                                      (StringBuf.append-char &buffer \newline))
                                    (unless-do (String.empty? &initializers)
                                      (StringBuf.append-char &buffer \newline)
                                      (runtime-begin! &buffer runtime-imports)
                                      (StringBuf.append-str &buffer
                                                            &initializers)
                                      (runtime-end! &buffer runtime-imports)
                                      (StringBuf.append-char &buffer \newline))
                                    (unless-do (String.empty? &functions)
                                      (StringBuf.append-char &buffer \newline)
                                      (StringBuf.append-str &buffer &functions)
                                      (StringBuf.append-char &buffer \newline))
                                    (Result.Success
                                      (CTranslationUnit.init (StringBuf.into-string buffer)
                                                             @(CTranslationUnit.entities &templates))))
                                (Result.Error error) (Result.Error error))
                            (Result.Error error) (Result.Error error))
                        (Result.Error error) (Result.Error error))
                    (Result.Error error) (Result.Error error))
                (Result.Error error) (Result.Error error))
            (Result.Error error) (Result.Error error))
        (Result.Error error) (Result.Error error))
    (Result.Error error) (Result.Error error)))

(doc translation-unit-emission "returns the C of `module` without an entry
point, with each definition recorded: runtime includes, prototypes, templates,
functions, globals and their initializer.")
(defn translation-unit-emission [module]
  (translation-unit-emission-with-runtime module false))

(doc native-support-emission "returns the C of `module` as
`translation-unit-emission` does, but marks the included runtime definitions and
the initializer as runtime imports, for a JIT session.")
(defn native-support-emission [module]
  (translation-unit-emission-with-runtime module true))

(doc translation-unit "returns the C source of `module` without an entry point.")
(defn translation-unit [module]
  (match (translation-unit-emission module)
    (Result.Success emission)
      (Result.Success @(CTranslationUnit.source &emission))
    (Result.Error error) (Result.Error error)))

(doc find-entry "returns the C symbol of the program's `main`, if it has one,
and whether it returns `Int` rather than `Unit`.")
(defn find-entry [module]
  (let-do [result (the (Maybe (Pair String Bool)) (Maybe.Nothing))
           declarations (BackendModule.declarations module)
           int-symbol (CAbi.mangle "main"
                                   &(MonoType.Function []
                                                       (Box.init (MonoType.Integer))))
           unit-symbol (CAbi.mangle "main"
                                    &(MonoType.Function []
                                                        (Box.init (MonoType.Unit))))
           n (Array.length declarations)]
    (for [i 0 n]
      (match-ref (Array.unsafe-nth declarations i)
        (BackendDeclaration.Function symbol _ _ _)
          (cond
            (String.= symbol &int-symbol)
              (set! result (Maybe.Just (Pair.init (String.copy symbol) true)))
            (String.= symbol &unit-symbol)
              (set! result (Maybe.Just (Pair.init (String.copy symbol) false)))
            ())
        _ ()))
    result))

(doc entry-definition "returns the C `main` of `module`. It initializes the
globals with `carp_init_globals`, runs the top-level forms, then calls the
program's `main` if there is one and returns its exit code.")
(defn entry-definition [module]
  (let-do [buffer (StringBuf.create)
           ;; the entry point is the compiler's own code, not anyone's Carp
           _ignored-reset (LineMap.mark-reset! (BackendModule.line-map module)
                                               &buffer)
           _ignored-open (StringBuf.append-str &buffer
                                               "int main(int argc, char** argv) {
")
           _ignored-globals (StringBuf.append-str &buffer
                                                  "  carp_init_globals(argc, argv);
")
           result (the (Result Unit BackendError) (Result.Success ()))
           roots (BackendModule.roots module)
           seen (the (Array String) [])
           winners (the (Array Int) [])
           n (Array.length roots)]
    (for [i 0 n]
      (collect-plain-locals! (Box.peek (Array.unsafe-nth roots i))
                             &seen
                             &winners))
    (set! *plain-local-ids* winners)
    (for [i 0 n]
      (match-ref &result
        (Result.Success _)
          (set! result
                (append-statement! module
                                   &buffer
                                   (Box.peek (Array.unsafe-nth roots i))
                                   1))
        (Result.Error _) ()))
    (match result
      (Result.Success _)
        (do
          ;; what follows is the call into the program and the return the C
          ;; standard wants, neither of which anyone wrote in Carp: without
          ;; this they inherit the last root expression's line
          (LineMap.mark-reset! (BackendModule.line-map module) &buffer)
          (match (find-entry module)
            (Maybe.Just entry)
              (if @(Pair.b &entry)
                (do
                  (StringBuf.append-str &buffer "  return ")
                  (StringBuf.append-str &buffer (Pair.a &entry))
                  (StringBuf.append-str &buffer "();
}
"))
                (do
                  (StringBuf.append-str &buffer "  ")
                  (StringBuf.append-str &buffer (Pair.a &entry))
                  (StringBuf.append-str &buffer "();
  return 0;
}
")))
            (Maybe.Nothing) (StringBuf.append-str &buffer "  return 0;
}
"))
          (Result.Success (StringBuf.into-string buffer)))
      (Result.Error error) (Result.Error error))))

(doc executable-translation-unit "returns the C source of `module` with its
entry point.")
(defn executable-translation-unit [module]
  (match (translation-unit module)
    (Result.Success c)
      (match (entry-definition module)
        (Result.Success entry) (Result.Success (String.concat &[c @"
" entry]))
        (Result.Error error) (Result.Error error))
    (Result.Error error) (Result.Error error)))

(doc effectful-root? "checks whether running the top-level form `expr` does
anything. Literals, references and a `do` of only those do nothing.")
(sig effectful-root? (Fn [(Ref SpecializedExpr)] Bool))
(defn effectful-root? [expr]
  (match-ref expr
    (SpecializedExpr.IntLit _ _ _) false
    (SpecializedExpr.ByteLit _ _ _) false
    (SpecializedExpr.LongLit _ _ _) false
    (SpecializedExpr.FloatLit _ _ _) false
    (SpecializedExpr.DoubleLit _ _ _) false
    (SpecializedExpr.CharLit _ _ _) false
    (SpecializedExpr.StringLit _ _ _) false
    (SpecializedExpr.PatternLit _ _ _) false
    (SpecializedExpr.BoolLit _ _ _) false
    (SpecializedExpr.UnitLit _ _) false
    (SpecializedExpr.Reference _ _ _) false
    (SpecializedExpr.GlobalValue _ _ _ _ _ _) false
    (SpecializedExpr.Do _ _ forms)
      (let-do [found false]
        (for [i 0 (Array.length forms)]
          (when (effectful-root? (Box.peek (Array.unsafe-nth forms i)))
            (set! found true)))
        found)
    _ true))

(doc library-translation-unit "returns the C of `module` for a shared or static
library: no `main`, and a constructor that runs `carp_init_globals` at load
time. Only the `exports` symbols are visible outside the unit. Functions and
globals the unit defines are static, except `System.args`, which is empty. A
top-level form that does something is an error, since a library cannot run it.")
(defn library-translation-unit [module exports]
  (if (not
      (Array.any?
        &(fn [root] (effectful-root? (Box.peek root)))
        (BackendModule.roots module)))
    (match (let-do [_ignored-exports (set! *library-exports*
                                           (Maybe.Just (Array.copy exports)))
                    rendered (translation-unit module)]
        (set! *library-exports* (the (Maybe (Array String)) (Maybe.Nothing)))
        rendered)
      (Result.Success c) (Result.Success (String.concat &[c @"
#pragma GCC visibility pop

__attribute__((constructor)) static void carp_library_init(void) {
  carp_init_globals(0, NULL);
}
"]))
      (Result.Error error) (Result.Error error))
    (Result.Error
      (BackendError.init
        @"a library has no main to run top-level expressions in; call them from a function instead"))))
