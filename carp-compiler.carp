(load "carp-frontend/carp-frontend.carp")
(load "carp-ownership/ref-lift.carp")
(load "carp-backend/symbols.carp")

(doc ConcretePlan "is a specialization closed over its ownership demands.
`prepared` holds the specialized module and the complete instance cache.
`ownership` is its ownership plan. `echo-types` holds the type keys of the
top-level results that are echoed.")
(deftype ConcretePlan
  [prepared IncrementalSpecialization
   ownership OwnershipPlan
   echo-types (Array String)])

(defmodule ConcretePlan
  (doc specialized "returns the specialized module of `plan`.")
  (defn specialized [plan]
    (IncrementalSpecialization.module (ConcretePlan.prepared plan)))
  (doc instances "returns the complete instance cache of `plan`.")
  (defn instances [plan]
    (IncrementalSpecialization.instances (ConcretePlan.prepared plan))))

(doc IncrementalLowering "is the backend result of one cell. `module` is the
lowered delta. `instances` is the complete instance cache, to commit once the
cell succeeds.")
(deftype IncrementalLowering
  [module BackendModule
   instances (Array Specialization)])

(doc PlannedModule "is a module run through ownership planning. `core` is the
core module, `inferred` its inference result and `plan` its ownership plan.")
(deftype PlannedModule
  [core CoreModule
   inferred InferredModule
   plan OwnershipPlan])

(doc CarpCompiler "runs the compiler pipeline: expansion, resolution, inference,
specialization, ownership, lowering and C rendering.")
(defmodule CarpCompiler
  (doc require-captures! "adds to `demands` a delete and a copy demand for each
owned type that a closure in `specialized` captures.")
  (private require-captures!)
  (hidden require-captures!)
  (defn require-captures! [demands specialized facts]
    (let [closures (CaptureAnalysis.module specialized)]
      (for [i 0 (Array.length &closures)]
        (let [captures (Array.unsafe-nth &closures i)]
          (for [j 0 (Array.length captures)]
            (let [type (Box.peek (Pair.b (Array.unsafe-nth captures j)))]
              (match (OwnershipClassify.classify type facts)
                (OwnershipClass.Owned)
                  (do
                    (SpecializationDemands.require-delete! demands type)
                    (SpecializationDemands.require-copy! demands type))
                _ ())))))))

  (private append-requests)
  (hidden append-requests)
  (defn append-requests [base extra]
    (let-do [result base
             n (Array.length extra)]
      (for [i 0 n]
        (set! result (Array.push-back result @(Array.unsafe-nth extra i))))
      result))

  (doc specialize-closed-known "specializes the reachable program and `seeds`,
starting from the `known` instances, then adds the delete and copy demands that
ownership needs and specializes again, until no demand is new.")
  (private specialize-closed-known)
  (hidden specialize-closed-known)
  (defn specialize-closed-known [context core inferred facts seeds known]
    (let-do [demands (SpecializationDemands.create)
             outcome (the (Result ConcretePlan CompileError)
                          (Result.Error
                            (CompileError.init @"specialize" @"no fixed point")))
             done false]
      (while-do (not done)
        (match (Specialize.module-with-demands context
                                               core
                                               inferred
                                               &demands
                                               seeds
                                               known)
          (Result.Success incremental)
            (let-do [specialized (RefLift.module-with-source-map
                       (IncrementalSpecialization.module &incremental)
                       *want-source-map*)]
              (IncrementalSpecialization.set-module! &incremental specialized)
              (match (Ownership.prepare
                  (IncrementalSpecialization.module &incremental)
                  facts)
                (Result.Success ownership)
                  (let-do [requirements (OwnershipPlan.requirements &ownership)
                           previous (SpecializationDemands.count &demands)]
                    (for [i 0 (Array.length requirements)]
                      (match-ref (Array.unsafe-nth requirements i)
                        (OwnershipRequirement.DeleteFunction type)
                          (SpecializationDemands.require-delete! &demands
                                                                 (Box.peek type))))
                    (require-captures! &demands
                                       (IncrementalSpecialization.module &incremental)
                                       facts)
                    (when-do (Int.= previous
                                    (SpecializationDemands.count &demands))
                      (set! outcome
                            (Result.Success
                              (ConcretePlan.init incremental
                                                 ownership
                                                 (the (Array String) []))))
                      (set! done true)))
                (Result.Error error)
                  (do
                    (set! outcome
                          (Result.Error
                            (CompileError.init @"ownership"
                                               @(OwnershipError.message &error))))
                    (set! done true))))
          (Result.Error error)
            (do
              (set! outcome
                    (Result.Error
                      (CompileError.init @"specialize"
                                         @(SpecializeError.message &error))))
              (set! done true))))
      outcome))

  (doc echo-augment-known "adds the demands for echoing the top-level results of
`plan` and closes the result again. If nothing is echoed, it returns `plan`.")
  (private echo-augment-known)
  (hidden echo-augment-known)
  (defn echo-augment-known [context core inferred facts seeds plan known]
    (let-do [roots (SpecializationModule.roots (ConcretePlan.specialized &plan))
             keys (the (Array String) [])
             seen (the (Set String) (Set.create))
             requests (the (Array (Pair SpecializationRequest Bool)) [])]
      (for [i 0 (Array.length roots)]
        (let [type (Specialize.expression-type (Box.peek (Array.unsafe-nth roots
                                                                           i)))]
          (match-ref &type
            (MonoType.Unit) ()
            _
              (let [key (CAbi.type-key &type)]
                (unless (Set.contains? &seen &key)
                  (match (Specialize.echo-request-with-context context
                                                               core
                                                               inferred
                                                               &type)
                    (Maybe.Just request)
                      (do
                        (Set.put! &seen &key)
                        (Array.push-back! &keys key)
                        (Array.push-back! &requests request))
                    (Maybe.Nothing) ()))))))
      (if (Int.= 0 (Array.length &requests))
        (Result.Success plan)
        (let-do [all-seeds (Array.copy seeds)]
          (for [i 0 (Array.length &requests)]
            (Array.push-back! &all-seeds
                              @(Pair.a (Array.unsafe-nth &requests i))))
          (set! all-seeds
                (append-requests all-seeds
                                 &(Specialize.named-requests-with-context context
                                                                          core
                                                                          inferred
                                                                          &[@"IO.println"])))
          (set! all-seeds
                (Array.push-back all-seeds
                                 (Specialize.delete-request &(Type.string))))
          (match (specialize-closed-known context
                                          core
                                          inferred
                                          facts
                                          &all-seeds
                                          known)
            (Result.Success final)
              (Result.Success (ConcretePlan.set-echo-types final keys))
            (Result.Error error) (Result.Error error))))))

  (private debug-describe-expr)
  (hidden debug-describe-expr)
  (defn debug-describe-expr [expr depth lo hi]
    (let [id (CoreIR.expression-id expr)]
      (when (and (Int.>= id lo) (Int.<= id hi))
        (match-ref expr
          (CoreExpr.Reference _ reference)
            (IO.errorln
              &(fmt "  d%d #%d Reference %s (ref-id %d)"
                    depth
                    id
                    (CoreRef.name reference)
                    @(CoreRef.id reference)))
          (CoreExpr.Call _ _ _) (IO.errorln &(fmt "  d%d #%d Call" depth id))
          (CoreExpr.Let _ binder _ _)
            (IO.errorln
              &(fmt "  d%d #%d Let %s (id %d)"
                    depth
                    id
                    (CoreRef.name binder)
                    @(CoreRef.id binder)))
          (CoreExpr.Match _ _ _ _)
            (IO.errorln &(fmt "  d%d #%d Match" depth id))
          (CoreExpr.If _ _ _ _) (IO.errorln &(fmt "  d%d #%d If" depth id))
          (CoreExpr.Do _ _) (IO.errorln &(fmt "  d%d #%d Do" depth id))
          (CoreExpr.StringLit _ s)
            (IO.errorln &(fmt "  d%d #%d Str %s" depth id s))
          (CoreExpr.Annotation _ _ _)
            (IO.errorln &(fmt "  d%d #%d Annotation" depth id))
          _ (IO.errorln &(fmt "  d%d #%d <other>" depth id))))))

  (private debug-walk-expr)
  (hidden debug-walk-expr)
  (defn debug-walk-expr [expr depth lo hi]
    (do
      (debug-describe-expr expr depth lo hi)
      (match-ref expr
        (CoreExpr.Call _ callee arguments)
          (do
            (debug-walk-expr (Box.peek callee) (Int.inc depth) lo hi)
            (for [i 0 (Array.length arguments)]
              (debug-walk-expr
                (Box.peek (Array.unsafe-nth arguments i))
                (Int.inc depth)
                lo
                hi)))
        (CoreExpr.Do _ expressions)
          (for [i 0 (Array.length expressions)]
            (debug-walk-expr
              (Box.peek (Array.unsafe-nth expressions i))
              (Int.inc depth)
              lo
              hi))
        (CoreExpr.If _ c t f)
          (do
            (debug-walk-expr (Box.peek c) (Int.inc depth) lo hi)
            (debug-walk-expr (Box.peek t) (Int.inc depth) lo hi)
            (debug-walk-expr (Box.peek f) (Int.inc depth) lo hi))
        (CoreExpr.Let _ _ value body)
          (do
            (debug-walk-expr (Box.peek value) (Int.inc depth) lo hi)
            (debug-walk-expr (Box.peek body) (Int.inc depth) lo hi))
        (CoreExpr.While _ c b)
          (do
            (debug-walk-expr (Box.peek c) (Int.inc depth) lo hi)
            (debug-walk-expr (Box.peek b) (Int.inc depth) lo hi))
        (CoreExpr.Set _ _ value)
          (debug-walk-expr (Box.peek value) (Int.inc depth) lo hi)
        (CoreExpr.Match _ _ scrutinee branches)
          (do
            (debug-walk-expr (Box.peek scrutinee) (Int.inc depth) lo hi)
            (for [i 0 (Array.length branches)]
              (let-do [branch (Array.unsafe-nth branches i)
                       bindings (CoreMatchBranch.bindings branch)]
                (for [j 0 (Array.length bindings)]
                  (let [binding (Array.unsafe-nth bindings j)]
                    (IO.errorln
                      &(fmt "  d%d  branch-binding %s (id %d)"
                            depth
                            (CoreRef.name binding)
                            @(CoreRef.id binding)))))
                (debug-walk-expr (Box.peek (CoreMatchBranch.body branch))
                                 (Int.inc depth)
                                 lo
                                 hi))))
        (CoreExpr.Lambda _ _ body)
          (debug-walk-expr (Box.peek body) (Int.inc depth) lo hi)
        (CoreExpr.Annotation _ inner _)
          (debug-walk-expr (Box.peek inner) (Int.inc depth) lo hi)
        (CoreExpr.ArrayLit _ es)
          (for [i 0 (Array.length es)]
            (debug-walk-expr (Box.peek (Array.unsafe-nth es i))
                             (Int.inc depth)
                             lo
                             hi))
        _ ())))

  (doc debug-dump-function "prints to stderr the expression tree of each
function whose name ends with `fn-name`, for expression ids from `lo` to `hi`. A
failed specialization calls it when `CARP_DEBUG_FN` is set.")
  (private debug-dump-function)
  (hidden debug-dump-function)
  (defn debug-dump-function [core fn-name lo hi]
    (let [functions (CoreModule.functions core)]
      (for [i 0 (Array.length functions)]
        (let [function (Array.unsafe-nth functions i)]
          (when-do (String.ends-with?
              (CoreRef.name (CoreFunction.reference function))
              fn-name)
            (IO.errorln
              &(fmt "-- debug dump: %s --"
                    (CoreRef.name (CoreFunction.reference function))))
            (debug-walk-expr (Box.peek (CoreFunction.body function)) 0 lo hi))))))

  ; lowering and rendering are separate calls, so the specialized IR, the
  ; backend IR and the C string are not all alive at once.

  (private lower-owned-raw)
  (hidden lower-owned-raw)
  (defn lower-owned-raw [plan symbols]
    (BackendLower.module-with-ownership-echoed (ConcretePlan.specialized plan)
                                               (ConcretePlan.ownership plan)
                                               (BackendSymbols.deletes symbols)
                                               (BackendSymbols.copies symbols)
                                               (BackendSymbols.echo symbols)))

  (doc line-starts
    "returns the byte offset at which each line of `text` starts.")
  (private line-starts)
  (hidden line-starts)
  (defn line-starts [text]
    (let-do [starts (the (Array Int) [0])
             n (String.length text)]
      (for [i 0 n]
        (when (= (String.char-at text i) \newline)
          (Array.push-back! &starts (Int.inc i))))
      starts))

  (private line-at)
  (hidden line-at)
  (doc line-at "returns the line of `offset`, counting from one, using `starts`
from `line-starts`.")
  (defn line-at [starts offset]
    (let-do [low 0
             high (Int.dec (Array.length starts))]
      (while (Int.< low high)
        (let [middle (Int./ (Int.inc (Int.+ low high)) 2)]
          (if (Int.<= @(Array.unsafe-nth starts middle) offset)
            (set! low middle)
            (set! high (Int.dec middle)))))
      (Int.inc low)))

  (private column-at)
  (hidden column-at)
  (doc column-at "returns the byte column of `offset`, counting from one, using
`starts` from `line-starts`.")
  (defn column-at [starts offset]
    (let [line (Int.dec (line-at starts offset))]
      (Int.inc (Int.- offset @(Array.unsafe-nth starts line)))))

  (private text-of-file)
  (hidden text-of-file)
  (defn text-of-file [file]
    (let-do [found (the (Maybe String) (Maybe.Nothing))
             n (Array.length &*source-map-files*)]
      (for [i 0 n]
        (when (String.= (Array.unsafe-nth &*source-map-files* i) file)
          (set! found
                (Maybe.Just
                  (String.copy (Array.unsafe-nth &*source-map-texts* i))))))
      found))

  (doc backend-line-map "returns the file, line and column of every node in the
source map. Nodes in files this compilation did not read are left out.")
  (private backend-line-map)
  (hidden backend-line-map)
  (defn backend-line-map []
    (let-do [nodes (CoreProvenance.nodes &*source-map*)
             count (Array.length nodes)
             highest -1]
      (for [i 0 count]
        (let [id @(NodeProvenance.id (Array.unsafe-nth nodes i))]
          (when (Int.> id highest) (set! highest id))))
      (let-do [size (Int.inc (Int.max highest 0))
               files (Array.replicate size &@"")
               lines (Array.replicate size &-1)
               columns (Array.replicate size &0)
               ;; one index per file, built the first time a span points into it
               indexed-names (the (Array String) [])
               indexed-starts (the (Array (Array Int)) [])]
        (for [i 0 count]
          (let [node (Array.unsafe-nth nodes i)
                span (NodeProvenance.span node)
                id @(NodeProvenance.id node)
                file (SourceSpan.source-id span)]
            (when (and (Int.>= id 0) (Int.< id size))
              (let-do [slot -1
                       n (Array.length &indexed-names)]
                (for [j 0 n]
                  (when (String.= (Array.unsafe-nth &indexed-names j) file)
                    (set! slot j)))
                (when (Int.< slot 0)
                  (match (text-of-file file)
                    (Maybe.Just text)
                      (do
                        (Array.push-back! &indexed-names (String.copy file))
                        (Array.push-back! &indexed-starts (line-starts &text))
                        (set! slot (Int.dec (Array.length &indexed-names))))
                    (Maybe.Nothing) ()))
                (when-do (Int.>= slot 0)
                  (Array.aset! &files id (String.copy file))
                  (let-do [starts (Array.unsafe-nth &indexed-starts slot)
                           offset @(SourceSpan.start span)]
                    (Array.aset! &lines id (line-at starts offset))
                    (Array.aset! &columns id (column-at starts offset))))))))
        (match (IO.getenv "CARP_DEBUG_SOURCE_MAP")
          (Maybe.Just _)
            (IO.errorln
              &(fmt
                "source map: %d nodes, ids up to %d, %d files indexed"
                count
                highest
                (Array.length &indexed-names)))
          (Maybe.Nothing) ())
        (BackendLineMap.init files lines columns))))

  (private lower-owned)
  (hidden lower-owned)
  (defn lower-owned [plan symbols]
    (match (lower-owned-raw plan symbols)
      (Result.Success backend)
        (do
          (when *want-source-map*
            (BackendModule.set-line-map! &backend (backend-line-map)))
          (Result.Success backend))
      (Result.Error error) (Result.Error error)))

  (doc resolve-line-resets "replaces each line reset mark in `rendered` with a
`#line` directive that points at the generated file `path` itself, so generated
code is not attributed to Carp source. If `path` is empty, it returns `rendered`
unchanged.")
  (defn resolve-line-resets [rendered path]
    (if (String.empty? path)
      (String.copy rendered)
      (let-do [lines (String.split-by rendered &[\newline])
               out (the (Array String) [])
               mark (LineMap.reset-mark)
               n (Array.length &lines)]
        (for [i 0 n]
          (let [line (Array.unsafe-nth &lines i)]
            (Array.push-back! &out
                              (if (String.= line &mark)
                                ;; the directive names the line after the one
                                ;; it stands on, which is where this one is
                                (fmt "#line %d \"%s\"" (Int.+ i 2) path)
                                (String.copy line)))))
        (String.join "
" &out))))

  (private render-owned)
  (hidden render-owned)
  (defn render-owned [backend]
    (let-do [_ignored (CompilerFrontend.phase-mark! "phase: lowered")
             rendered (CBackend.executable-translation-unit &backend)]
      rendered))

  (private render-library)
  (hidden render-library)
  (defn render-library [backend exports]
    (let-do [_ignored (CompilerFrontend.phase-mark! "phase: lowered")
             rendered (CBackend.library-translation-unit &backend exports)]
      rendered))

  (private lower-inferred-module-rooted)
  (hidden lower-inferred-module-rooted)

  (private lower-inferred-module-seeded)
  (hidden lower-inferred-module-seeded)
  (doc lower-inferred-module-seeded "lowers `core` with `context`, which was
made for `core` and `inferred`, and the demands `seeds`.")
  (defn lower-inferred-module-seeded [context
                                      core
                                      inferred
                                      echo
                                      known
                                      seeds
                                      finish]
    (let-do [facts (OwnershipClassify.facts-from-module core)]
      (match (specialize-closed-known context core inferred &facts seeds known)
        (Result.Success plan)
          (match (let-do [_mark (CompilerFrontend.phase-mark! "phase: specialized")]
              (if echo
                (echo-augment-known context
                                    core
                                    inferred
                                    &facts
                                    seeds
                                    plan
                                    known)
                (Result.Success plan)))
            (Result.Success final)
              (let [symbols (BackendSymbolSelection.for-module core
                                                               (ConcretePlan.specialized &final)
                                                               (ConcretePlan.echo-types &final))]
                (match (lower-owned &final &symbols)
                  (Result.Success backend)
                    (Result.Success
                      (~finish backend (ConcretePlan.instances &final)))
                  (Result.Error error)
                    (Result.Error
                      (CompileError.init @"backend"
                                         @(BackendError.message &error)))))
            (Result.Error error) (Result.Error error))
        (Result.Error error)
          (do
            (match (IO.getenv "CARP_DEBUG_FN")
              (Maybe.Just fn-name) (debug-dump-function core &fn-name 830 985)
              (Maybe.Nothing) ())
            (Result.Error error)))))

  (defn lower-inferred-module-rooted [core inferred echo known names finish]
    (let [context (Specialize.prepare core inferred)
          seeds (Specialize.named-requests-with-context &context
                                                        core
                                                        inferred
                                                        names)]
      (lower-inferred-module-seeded &context
                                    core
                                    inferred
                                    echo
                                    known
                                    &seeds
                                    finish)))

  (doc lower-inferred-module-with-known "lowers one cell, starting from the
`known` instances. The result holds the backend delta and the complete instance
cache, to commit once the cell succeeds.")
  (private backend-only)
  (hidden backend-only)
  (defn backend-only [backend _instances] backend)

  (private backend-with-cache)
  (hidden backend-with-cache)
  (defn backend-with-cache [backend instances]
    (IncrementalLowering.init backend (Array.copy instances)))

  (defn lower-inferred-module-with-known [core inferred echo known]
    (lower-inferred-module-rooted core
                                  inferred
                                  echo
                                  known
                                  &(the (Array String) [])
                                  &backend-with-cache))

  (private lower-inferred-module-with)
  (hidden lower-inferred-module-with)
  (defn lower-inferred-module-with [core inferred echo]
    (lower-inferred-module-rooted core
                                  inferred
                                  echo
                                  &(the (Array Specialization) [])
                                  &(the (Array String) [])
                                  &backend-only))

  (doc lower-inferred-module "specializes, plans ownership and lowers `core` to
a `BackendModule`, without echoing top-level results.")
  (defn lower-inferred-module [core inferred]
    (lower-inferred-module-with core inferred false))

  (doc lower-inferred-module-echoed "lowers `core` as `lower-inferred-module`
does, and prints each non-unit top-level result.")
  (defn lower-inferred-module-echoed [core inferred]
    (lower-inferred-module-with core inferred true))

  (private compile-inferred-module-with)
  (hidden compile-inferred-module-with)
  (defn compile-inferred-module-with [core inferred echo]
    (match (lower-inferred-module-with core inferred echo)
      (Result.Success backend)
        (match (render-owned backend)
          (Result.Success c) (Result.Success c)
          (Result.Error error)
            (Result.Error
              (CompileError.init (String.copy "backend")
                                 @(BackendError.message &error))))
      (Result.Error error) (Result.Error error)))

  (doc compile-inferred-module "specializes, plans ownership, lowers and renders
`core` to C, without echoing top-level results.")
  (defn compile-inferred-module [core inferred]
    (compile-inferred-module-with core inferred false))

  (doc compile-inferred-module-echoed "compiles `core` as
`compile-inferred-module` does, and prints each non-unit top-level result with
`str`.")
  (defn compile-inferred-module-echoed [core inferred]
    (compile-inferred-module-with core inferred true))

  (private module-function?)
  (hidden module-function?)
  (defn module-function? [core name]
    (let-do [found false
             functions (CoreModule.functions core)]
      (for [i 0 (Array.length functions)]
        (when (String.= name
                        (CoreRef.name
                          (CoreFunction.reference (Array.unsafe-nth functions i))))
          (set! found true)))
      found))

  (doc unreachable-roots "returns the names in `roots` that specialization would
drop: unknown names and functions whose type is not concrete.")
  (private unreachable-roots)
  (hidden unreachable-roots)
  (defn unreachable-roots [core roots requests]
    (let-do [missing (the (Array String) [])]
      (for [i 0 (Array.length roots)]
        (let-do [root (Array.unsafe-nth roots i)
                 found false]
          ;; `named-requests` also answers for registered builtins, which
          ;; the library would not define; a root must be this module's own.
          (for [j 0 (Array.length requests)]
            (when (String.= root
                            (CoreRef.name
                              (CallSite.reference
                                (SpecializationRequest.call (Array.unsafe-nth requests
                                                                              j)))))
              (set! found true)))
          (unless (and found (module-function? core root))
            (Array.push-back! &missing @root))))
      (if (Array.empty? &missing)
        (the (Maybe String) (Maybe.Nothing))
        (Maybe.Just
          (String.append
            "not a concrete function of this module: "
            &(String.join ", " &missing))))))

  (private root-symbols)
  (hidden root-symbols)
  (doc root-symbols "returns the C symbols of the roots in `requests`.")
  (defn root-symbols [core requests]
    (let-do [symbols (the (Array String) [])]
      (for [i 0 (Array.length requests)]
        (let [call (SpecializationRequest.call (Array.unsafe-nth requests i))
              name (CoreRef.name (CallSite.reference call))]
          (when (module-function? core name)
            (Array.push-back! &symbols
                              (CAbi.mangle name (Box.peek (CallSite.type call)))))))
      symbols))

  (doc compile-inferred-library-roots "compiles `core` to C without a `main`,
for a library. Only the functions named in `roots` are exported, and an
unreachable root is an error.")
  (defn compile-inferred-library-roots [core inferred roots]
    (let [context (Specialize.prepare core inferred)
          requests (Specialize.named-requests-with-context &context
                                                           core
                                                           inferred
                                                           roots)]
      (match (unreachable-roots core roots &requests)
        (Maybe.Just message)
          (Result.Error (CompileError.init (String.copy "library") message))
        (Maybe.Nothing)
          (match (lower-inferred-module-seeded &context
                                               core
                                               inferred
                                               false
                                               &(the (Array Specialization) [])
                                               &requests
                                               &backend-only)
            (Result.Success backend)
              (match (render-library backend &(root-symbols core &requests))
                (Result.Success c) (Result.Success c)
                (Result.Error error)
                  (Result.Error
                    (CompileError.init (String.copy "backend")
                                       @(BackendError.message &error))))
            (Result.Error error) (Result.Error error)))))

  (doc lower-module-full "runs `module` through the pipeline to a
`BackendModule`, without rendering C. The functions in `check-names` are
specialized even if nothing calls them. If `echo` is true, top-level results are
printed.")
  (defn lower-module-full [module config check-names echo]
    (match (CompilerFrontend.infer-module-with module config)
      (Result.Success annotated)
        (lower-inferred-module-rooted (AnnotatedModule.core &annotated)
                                      (AnnotatedModule.inferred &annotated)
                                      echo
                                      &(the (Array Specialization) [])
                                      check-names
                                      &backend-only)
      (Result.Error error) (Result.Error error)))

  (doc compile-module-full "runs `module` through `lower-module-full` and
renders it to C.")
  (defn compile-module-full [module config check-names echo]
    (match (lower-module-full module config check-names echo)
      (Result.Success backend)
        (match (render-owned backend)
          (Result.Success c)
            (do
              (CompilerFrontend.phase-mark! "phase: rendered")
              (Result.Success c))
          (Result.Error error)
            (Result.Error
              (CompileError.init (String.copy "backend")
                                 @(BackendError.message &error))))
      (Result.Error error) (Result.Error error)))

  (doc compile-module-checked "compiles `module` as `compile-module-with` does,
and specializes the functions in `check-names` even if nothing calls them.")
  (defn compile-module-checked [module config check-names]
    (compile-module-full module config check-names false))

  (doc compile-module-with "compiles the loaded `module` to C with `config`.")
  (defn compile-module-with [module config]
    (compile-module-checked module config &(the (Array String) [])))

  (doc compile-module "compiles the loaded `module` to C with no prelude
modules.")
  (defn compile-module [module]
    (let [config (ExpandConfig.init [])] (compile-module-with module &config)))

  (doc compile-source-with "parses `source` and compiles it to C with `config`.")
  (defn compile-source-with [source config]
    (match (Surface.parse source)
      (Result.Success module) (compile-module-with &module config)
      (Result.Error error)
        (Result.Error
          (CompileError.init (String.copy "parse") (Parser.format-error &error)))))

  (doc compile-source "parses `source` and compiles it to C with no prelude
modules.")
  (defn compile-source [source]
    (let [config (ExpandConfig.init [])] (compile-source-with source &config)))

  (doc lower-source "parses `source` and lowers it to a `BackendModule`, without
rendering C.")
  (defn lower-source [source]
    (match (Surface.parse source)
      (Result.Success module)
        (lower-module-full &module
                           &(ExpandConfig.init [])
                           &(the (Array String) [])
                           false)
      (Result.Error error)
        (Result.Error
          (CompileError.init (String.copy "parse") (Parser.format-error &error)))))

  ; examples of the pipeline's artifacts. they live here because they need
  ; several phases at once.

  (doc an-expanded-module "is an example: a definition after macro expansion.")
  (meta-set! an-expanded-module "example" true)
  (defn an-expanded-module []
    (Result.from-success
      (MacroExpand.expand-module-with
        &(Result.from-success
          (Surface.parse "(defn twice [x] (+ x x))")
          (SurfaceModule.init []))
        &(ExpandConfig.init []))
      (SurfaceModule.init [])))

  (doc an-inferred-module "is an example: a resolved module after inference.")
  (meta-set! an-inferred-module "example" true)
  (defn an-inferred-module []
    ;; an empty result stands in for a failure the example cannot have: the
    ;; module it infers is a literal one, and it resolves
    (Result.from-success
      (Infer.module &(Resolve.a-resolved-module))
      (InferredModule.init [] [] [] [] [] (TypeSubstitution.init [] [] []))))

  (doc an-inferred-scheme "is an example: the inferred type of a definition, as
diagnostics write it.")
  (meta-set! an-inferred-scheme "example" true)
  (defn an-inferred-scheme []
    (let-do [inferred (an-inferred-module)
             environment (InferredModule.environment &inferred)
             answer @"(identity was not inferred)"]
      (for [i 0 (Array.length environment)]
        (let [binding (Array.unsafe-nth environment i)]
          (when (String.=
              (CoreRef.name (SchemeBinding.reference binding))
              "identity")
            (set! answer
                  (Type.render
                    (Box.peek (TypeScheme.body (SchemeBinding.scheme binding))))))))
      answer))

  (doc a-compiled-translation-unit "is an example: the C of a program with no
standard library.")
  (meta-set! a-compiled-translation-unit "example" true)
  (defn a-compiled-translation-unit []
    (Result.from-success
      (CarpCompiler.compile-source "(defn main [] ())")
      @"/* this program did not compile */"))

  (doc a-compile-error "is an example: the error for a program that does not
compile.")
  (meta-set! a-compile-error "example" true)
  (defn a-compile-error []
    (match (CarpCompiler.compile-source "(defn main [] (undefined-name 1))")
      (Result.Error error) error
      (Result.Success _) (CompileError.init @"none" @"this program compiles")))

  (doc compile-sources-with "loads `root` from the source registry `sources` and
compiles it with `config`.")
  (defn compile-sources-with [sources root config]
    (do
      (when-do *want-source-map*
        ;; the texts outlive the loader here: a span is a byte offset, and only
        ;; the file it points into can turn that into a line
        (set! *source-map-files* [])
        (set! *source-map-texts* [])
        (for [i 0 (Array.length sources)]
          (let-do [source (Array.unsafe-nth sources i)]
            (Array.push-back! &*source-map-files*
                              (String.copy (ModuleSource.file source)))
            (Array.push-back! &*source-map-texts*
                              (String.copy (ModuleSource.text source))))))
      (match (ModuleLoader.load sources root)
        (Result.Success module) (compile-module-with &module config)
        (Result.Error error)
          (Result.Error
            (CompileError.init (String.copy "load")
                               (String.concat
                                 &[(String.copy (ModuleError.path &error))
                                   @": "
                                   (String.copy (ModuleError.message &error))]))))))

  (doc compile-sources "loads `root` from `sources` and compiles it with no
prelude modules.")
  (defn compile-sources [sources root]
    (let [config (ExpandConfig.init [])]
      (compile-sources-with sources root &config)))

  (doc plan-module-checked "runs `module` through ownership planning, without
lowering. The functions in `check-names` are planned even if nothing calls them.")
  (defn plan-module-checked [module config check-names]
    (match (CompilerFrontend.infer-module-with module config)
      (Result.Success annotated)
        (let [core (AnnotatedModule.core &annotated)
              inferred (AnnotatedModule.inferred &annotated)
              context (Specialize.prepare core inferred)
              facts (OwnershipClassify.facts-from-module core)
              seeds (Specialize.named-requests-with-context &context
                                                            core
                                                            inferred
                                                            check-names)]
          (match (specialize-closed-known &context
                                          core
                                          inferred
                                          &facts
                                          &seeds
                                          &(the (Array Specialization) []))
            (Result.Success concrete)
              (Result.Success
                (PlannedModule.init @core
                                    @inferred
                                    @(ConcretePlan.ownership &concrete)))
            (Result.Error error) (Result.Error error)))
      (Result.Error error) (Result.Error error)))

  (doc compile-module-library-full "compiles the loaded `module` to C without a
`main`, as `compile-inferred-library-roots` does.")
  (defn compile-module-library-full [module config roots]
    (match (CompilerFrontend.infer-module-with module config)
      (Result.Success annotated)
        (compile-inferred-library-roots (AnnotatedModule.core &annotated)
                                        (AnnotatedModule.inferred &annotated)
                                        roots)
      (Result.Error error) (Result.Error error)))
  (doc infer-module-with "expands, resolves, validates, derives and infers the
loaded `module`.")
  (defn infer-module-with [module config]
    (CompilerFrontend.infer-module-with module config))

  (doc derive-module-for-inference "validates and derives the resolved `core`.")
  (defn derive-module-for-inference [core]
    (CompilerFrontend.derive-module-for-inference core))

  (doc derive-module-for-inference-provenanced "derives a session module. User
ids are kept, and generated ids come from `allocator`.")
  (defn derive-module-for-inference-provenanced [resolved
                                                 allocator
                                                 fallback
                                                 known-recursive]
    (CompilerFrontend.derive-module-for-inference-provenanced resolved
                                                              allocator
                                                              fallback
                                                              known-recursive)))
