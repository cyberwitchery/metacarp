(load "carp-ct-ir.carp")

(doc CtSymbol "is a name that a code object refers to. `name` is the name,
`reference` how to reach it and `span` where it is written.")
(deftype CtSymbol [name String
                   reference CtRef
                   span SurfaceSpan])

(doc CtCallSite "is what a call instruction needs that is fixed where the call
is written. `name` is the head's name and `reference` how to reach it. `builtin`
is the builtin it names, or -1. `raws` holds the argument syntax, which a macro
takes unevaluated. `node` is the call form.")
(deftype CtCallSite
  [name String
   reference CtRef
   builtin Int
   raws (Array (Box SurfaceNode))
   node (Box SurfaceNode)])

(doc CtInstr "is one instruction of compile-time bytecode. Operands are indices
into the code object's tables, so the tables are shared by every run of the
body. Jumps carry absolute targets in the instruction array, so `if`, `when`,
`and`, `or`, `cond`, `while` and `let` run without nested calls. Calls, macro
expansion, and the `eval`, `apply`, `s-expr`, `expand` and `compose` forms run
other code and recurse. The comment above each instruction says what it does.")
(deftype CtInstr
  ;; push constants[i] as syntax
  (Push [Int])
  ;; push an empty list at spans[i], the value of a false `when`, a `while`
  ;; and an empty `do`
  (PushEmpty [Int])
  ;; push a Bool literal at spans[i]
  (PushBool [Int Bool])
  ;; push the value of symbols[i]
  (Resolve [Int])
  ;; as Resolve, but an unresolved name stays as its own syntax: nodes[j]
  (ArgResolve [Int Int])
  ;; pop n values, push the collection they make
  (MakeColl [Int])
  ;; push a closure over the current frame from prototype i
  (MakeClosure [Int])
  ;; resolve the head of sites[i]. A macro takes its arguments unevaluated,
  ;; so it expands here and jumps past the argument code to the second
  ;; operand; anything else falls through to it.
  (CallMacroTest [Int Int])
  ;; pop n arguments and apply the head of sites[i] to them
  (CallApply [Int Int])
  ;; pop a callee and n arguments below it, and apply
  (CallApplyValue [Int Int])
  ;; enter a child frame, leave it, bind names[i] in it
  (EnterFrame [])
  (LeaveFrame [])
  (Bind [Int])
  ;; assign names[i] the value on the stack, which stays there, blaming
  ;; spans[j] if there is nothing of that name to assign to
  (Assign [Int Int])
  (Jump [Int])
  ;; pop a Bool and jump when it is false. `JumpUnlessBool` accepts what
  ;; `bool-argument` accepts; `JumpUnlessStrict` is `if`, which the reference
  ;; only lets Bool syntax through. The second operand is the span to blame.
  (JumpUnlessBool [Int Int])
  (JumpUnlessStrict [Int Int])
  ;; peek a Bool: jump keeping the value when the test fails, otherwise drop
  ;; it and fall through. `and` and `or` answer with the value that decided
  ;; them, so the deciding value must survive the jump.
  (JumpUnlessKeep [Int Int])
  (JumpIfKeep [Int Int])
  (Drop [])
  ;; run special form `op` over sites[i], having evaluated `n` arguments
  (Special [Int Int Int])
  ;; fail with names[i] at spans[j]
  (Fail [Int Int])
  ;; duplicate the top of the stack, for `case`, which compares one value
  ;; against many patterns
  (Dup [])
  ;; pop a pattern and the copy of the matched value below it, and jump when
  ;; they are not equal syntax. The matched value itself stays, for the next
  ;; pattern or for the branch to drop.
  (JumpUnlessEqual [Int Int])
  ;; push what the recorded-source table holds for the symbol in nodes[i]
  ;; and jump past the fallback; fall through when it holds nothing
  (SexprResolve [Int Int])
  (Halt []))

(doc CtCode "is one compiled compile-time body. `instructions` holds its code.
`constants`, `symbols`, `names`, `spans`, `sites` and `nodes` are the tables its
operands index.")
(deftype CtCode
  [instructions (Array CtInstr)
   constants (Array (Box SurfaceNode))
   symbols (Array CtSymbol)
   names (Array String)
   spans (Array SurfaceSpan)
   sites (Array CtCallSite)
   nodes (Array (Box SurfaceNode))])

(doc *ct-codes* "holds every compiled body, by the id a prototype holds. Bodies
are boxed, so adding one does not move one that is running.")
(def *ct-codes* (the (Array (Box CtCode)) []))

(doc CtCodeStore "holds the compiled compile-time bodies.")
(defmodule CtCodeStore
  (doc add! "adds the compiled body `code` and returns its id.")
  (defn add! [code]
    (let-do [id (Array.length &*ct-codes*)]
      (Array.push-back! &*ct-codes* (Box.init code))
      id))

  (doc count "returns the number of compiled bodies.")
  (defn count [] (Array.length &*ct-codes*)))
