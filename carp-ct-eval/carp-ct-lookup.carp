(doc CtLookup
  "is the shared compile-time name-resolution kernel. Editing views and evaluation supply different cell payloads to the same lookup rules.")
(defmodule CtLookup
  (defn module-frame [modules path]
    (let-do [result (the (Maybe FrameId) (Maybe.Nothing))
             n (Array.length modules)]
      (for [i 0 n]
        (match-ref &result
          (Maybe.Nothing)
            (let [entry (Array.unsafe-nth modules i)]
              (when (= (CtModuleFrame.path entry) path)
                (set! result (Maybe.Just @(CtModuleFrame.frame entry)))))
          (Maybe.Just _) ()))
      result))

  (defn module-member [environment modules path local]
    (match (module-frame modules path)
      (Maybe.Just target) (CtEnv.lookup-status environment &target local)
      (Maybe.Nothing) (CtEnvLookup.Missing)))

  (defn status [environment modules frame name static-definition?]
    (match (CtEnv.lookup-status environment frame name)
      (CtEnvLookup.Found cell)
      (if (and (not (String.contains? name \.))
               (~static-definition? (CtEnv.peek-cell environment &cell)))
        (match (module-member environment modules "Dynamic" name)
          (CtEnvLookup.Found dynamic-cell) (CtEnvLookup.Found dynamic-cell)
          _ (CtEnvLookup.Found cell))
        (CtEnvLookup.Found cell))
      (CtEnvLookup.Ambiguous)
      (CtEnvLookup.Ambiguous)
      (CtEnvLookup.Missing)
      ;; a qualified name reaches into the named module's frame. Compile-time
      ;; code prefers the `Dynamic` module (the reference resolves `Map.len`
      ;; in dynamic code to `Dynamic.Map.len`, never the static function).
      (if (String.contains? name \.)
        (let-do [segments (String.split-by name &[\.])
                 segment-count (Array.length &segments)
                 local (String.copy
                   (Array.unsafe-nth &segments (Int.dec segment-count)))
                 module-path (String.join "."
                                          &(Array.prefix &segments
                                                         (Int.dec segment-count)))
                 found (module-member environment
                                      modules
                                      &(String.concat
                                        &[@"Dynamic." (String.copy &module-path)])
                                      &local)]
          (match found
            (CtEnvLookup.Missing)
              (module-member environment modules &module-path &local)
            _ found))
        (module-member environment modules "Dynamic" name)))))
