  (hidden type-syntax)
  (doc type-syntax "returns the concrete `type` as the reference writes it as
syntax, at `span`: a name is a symbol, an application a list, and a function
`(Fn [args] result)`.")
  (sig type-syntax (Fn [(Ref SurfaceSpan) (Ref MonoType)] SurfaceNode))
  (defn type-syntax [span type]
    (match-ref type
      (MonoType.Integer) (symbol-syntax span "Int")
      (MonoType.String) (symbol-syntax span "String")
      (MonoType.Boolean) (symbol-syntax span "Bool")
      (MonoType.Unit) (list-syntax span (the (Array (Box SurfaceNode)) []))
      (MonoType.Variable variable)
        (symbol-syntax span &(String.concat &[@"t" (Int.str @variable)]))
      (MonoType.Reference inner _)
        (list-syntax span
                     [(Box.init (symbol-syntax span "Ref"))
                      (Box.init (type-syntax span (Box.peek inner)))])
      (MonoType.Function arguments result)
        (let-do [rendered (the (Array (Box SurfaceNode)) [])]
          (for [i 0 (Array.length arguments)]
            (Array.push-back! &rendered
                              (Box.init
                                (type-syntax span
                                             (Box.peek (Array.unsafe-nth arguments
                                                                         i))))))
          (list-syntax span
                       [(Box.init (symbol-syntax span "Fn"))
                        (Box.init (array-syntax span rendered))
                        (Box.init (type-syntax span (Box.peek result)))]))
      (MonoType.Named name arguments)
        (if (Int.= 0 (Array.length arguments))
          (symbol-syntax span name)
          (let-do [rendered (the (Array (Box SurfaceNode)) [])]
            (Array.push-back! &rendered (Box.init (symbol-syntax span name)))
            (for [i 0 (Array.length arguments)]
              (Array.push-back! &rendered
                                (Box.init
                                  (type-syntax span
                                               (Box.peek (Array.unsafe-nth arguments
                                                                           i))))))
            (list-syntax span rendered)))))

  (sig symbol-syntax (Fn [(Ref SurfaceSpan) (Ref String)] SurfaceNode))
  (defn symbol-syntax [span name]
    (SurfaceNode.generated @span (SurfaceForm.Symbol [(String.copy name)])))

  (sig list-syntax
       (Fn [(Ref SurfaceSpan) (Array (Box SurfaceNode))] SurfaceNode))
  (defn list-syntax [span items]
    (SurfaceNode.generated @span (SurfaceForm.List items)))

  (sig array-syntax
       (Fn [(Ref SurfaceSpan) (Array (Box SurfaceNode))] SurfaceNode))
  (defn array-syntax [span items]
    (SurfaceNode.generated @span (SurfaceForm.Array items)))

  (private special-type)
  (hidden special-type)
  (doc special-type "runs `(type x)`: it infers the type of `argument` against
the forms expanded so far.")
  (defn special-type [call argument]
    (let-do [forms (Array.copy &*ct-typing-forms*)
             count 0]
      (Array.push-back! &forms (Box.init (SurfaceNode.copy argument)))
      (set! count (Array.length &forms))
      (match (Resolve.module &(SurfaceModule.init forms))
        (Result.Success core)
          (match (Infer.module &core)
            (Result.Success inferred)
              (let [types (InferredModule.expression-types &inferred)
                    n (Array.length types)]
                (if (Int.= 0 n)
                  (Result.Error (error-at call @"type cannot type this form"))
                  ;; inference leaves variables behind; the module's final
                  ;; substitution is what resolves them
                  (Result.Success
                    (CtValue.Syntax
                      (Box.init
                        (type-syntax (SurfaceNode.span call)
                                     &(Type.apply (InferredModule.substitution &inferred)
                                                  (Box.peek (Array.unsafe-nth types
                                                                              (Int.dec n))))))))))
            (Result.Error error)
              (Result.Error
                (error-at call
                          (String.concat
                            &[@"type cannot type this form: infer: "
                              (String.copy (InferError.message &error))
                              @" (forms "
                              (Int.str count)
                              @")"]))))
        (Result.Error error)
          (Result.Error
            (error-at call
                      (String.concat
                        &[@"type cannot type this form: resolve: "
                          (String.copy (ResolveError.message &error))
                          @" (forms "
                          (Int.str count)
                          @")"]))))))

  (private special-meta)
  (hidden special-meta)
  (doc special-meta "runs `(meta name key)`: it returns what was recorded for
`name`, or the empty list, as the reference returns nil. A qualified name is
read as written, and a bare one through `scoped-meta-value`.")
  (private enclosing-module-path)
  (hidden enclosing-module-path)
  (doc enclosing-module-path "returns the path of the innermost module whose
frame encloses `frame`, or the empty string at the root.")
  (defn enclosing-module-path [state frame]
    (let-do [result (the (Maybe String) (Maybe.Nothing))
             current (Maybe.Just @frame)
             modules (CtState.modules state)]
      (while (Maybe.nothing? &result)
        (match @&current
          (Maybe.Nothing) (set! result (Maybe.Just @""))
          (Maybe.Just at)
            (do
              (for [i 0 (Array.length modules)]
                (let [entry (Array.unsafe-nth modules i)]
                  (when (and (Maybe.nothing? &result)
                             (Int.=
                               @(FrameId.index (CtModuleFrame.frame entry))
                               @(FrameId.index &at)))
                    (set! result (Maybe.Just @(CtModuleFrame.path entry))))))
              (set! current (CtEnv.parent-frame (CtState.environment state) &at)))))
      (Maybe.from result @"")))

  (private scoped-meta-value)
  (hidden scoped-meta-value)
  (doc scoped-meta-value "returns the metadata for `key` of the bare `name`
read in `frame`. Metadata is recorded under qualified names, so inside `A.B` it
tries `A.B.f`, then `A.f`, then `f`, as the reference does.")
  (defn scoped-meta-value [state frame name key]
    (let-do [path (enclosing-module-path state frame)
             segments (if (String.empty? &path)
               (the (Array String) [])
               (String.split-by &path &[\.]))
             result (the (Maybe (Box SurfaceNode)) (Maybe.Nothing))
             k (Array.length &segments)]
      (while (and (Maybe.nothing? &result) (Int.>= k 0))
        (let-do [qualified (if (Int.= k 0)
                   (String.copy name)
                   (String.concat
                     &[(String.join "." &(Array.prefix &segments k))
                       @"."
                       (String.copy name)]))]
          (set! result (CtEval.meta-value &qualified key))
          (set! k (Int.dec k))))
      result))

  (defn special-meta [call name-form key-value state frame]
    (match (symbol-key name-form)
      (Maybe.Just name)
        (match (string-argument call key-value)
          (Result.Success key)
            (match (scoped-meta-value state frame &name &key)
              (Maybe.Just found)
              (Result.Success (CtValue.Syntax (Box.copy &found)))
              (Maybe.Nothing)
              ;; the empty list, which is what `'()` evaluates to here and
              ;; what the reference answers an unset annotation with
              (Result.Success
                (CtValue.Syntax
                  (Box.init
                    (SurfaceNode.generated @(SurfaceNode.span call)
                                           (SurfaceForm.List []))))))
          (Result.Error error) (Result.Error error))
      (Maybe.Nothing) (Result.Error (error-at call @"meta expects a symbol"))))

  (private special-sexpr)
  (hidden special-sexpr)
  (private special-use)
  (hidden special-use)
  (private special-concat)
  (hidden special-concat)
  (private special-with-test)
  (hidden special-with-test)
  (private bool-at)
  (hidden bool-at)
  (private strict-bool-at)
  (hidden strict-bool-at)
  (private pop-arguments!)
  (hidden pop-arguments!)
  (private run-call-values)
  (hidden run-call-values)
  (private resolve-free)
  (hidden resolve-free)
  (private resolve-now)
  (hidden resolve-now)
  (private resolve-ref)
  (hidden resolve-ref)
  (private cell-value)
  (hidden cell-value)
  (private macro-in-cell)
  (hidden macro-in-cell)
  (private span-anchor)
  (hidden span-anchor)
  (private error-at-span)
  (hidden error-at-span)
  (private symbol-key-of-head)
  (hidden symbol-key-of-head)
  (private sexpr-for-binding)
  (hidden sexpr-for-binding)
  (private sexpr-from-value)
  (hidden sexpr-from-value)
  (private syntax-value?)
  (hidden syntax-value?)
  (private apply-function-value)
  (hidden apply-function-value)
  (private applied-call-syntax)
  (hidden applied-call-syntax)
  (private expand-known-syntax)
  (hidden expand-known-syntax)
  (private eval-compose)
  (hidden eval-compose)
  (defn builtin-name? [name] (Int.>= (CtLower.builtin-id name) 0))

  (defn sexpr-for-binding [state frame body binding]
    (let [binding-name (String.concat &[@"__sexpr_" (String.copy binding)])]
      (match (lookup-status state frame &binding-name)
        (CtEnvLookup.Found cell)
          (match (read-cell state &cell)
            (Maybe.Just value) (Result.Success value)
            (Maybe.Nothing)
              (Result.Error (error-at body @"s-expr: invalid cell")))
        _
          (Result.Error
            (error-at body
                      (String.append "unknown compile-time symbol: " binding))))))

  (defn sexpr-from-value [state frame body value]
    (match (syntax-from-value body value)
      (Result.Success node)
        (match (symbol-key &node)
          (Maybe.Just binding) (sexpr-for-binding state frame body &binding)
          (Maybe.Nothing)
            (Result.Error (error-at body @"s-expr expects a symbol")))
      (Result.Error error) (Result.Error error)))

  (defn eval-compose [body f-form g-form state frame]
    (match (symbol-key g-form)
      (Maybe.Just g-name)
        (match (sexpr-for-binding state frame body &g-name)
          (Result.Success g-source)
            (match (list-item body &g-source 2)
              (Result.Success parameters-value)
                (match (syntax-from-value body &parameters-value)
                  (Result.Success parameters)
                    (let [quoted-parameters (call-node body
                                                       "quote"
                                                       &[(Box.init (SurfaceNode.copy &parameters))])
                          apply-call (call-node body
                                                "apply"
                                                &[(Box.init (SurfaceNode.copy g-form))
                                                  (Box.init quoted-parameters)])
                          eval-call (call-node body
                                               "eval"
                                               &[(Box.init apply-call)])
                          composed-body (call-node-with-head body
                                                             f-form
                                                             &[(Box.init eval-call)])
                          fn-node (call-node body
                                             "fn"
                                             &[(Box.init parameters)
                                               (Box.init composed-body)])]
                      (Result.Success (CtValue.Syntax (Box.init fn-node))))
                  (Result.Error error) (Result.Error error))
              (Result.Error error) (Result.Error error))
          (Result.Error error) (Result.Error error))
      (Maybe.Nothing)
        (Result.Error
          (error-at g-form @"Dynamic.compose expects named functions"))))

  (sig expand-ct-macro
       (Fn
         [(Ref SurfaceNode)
          (Ref CtClosure)
          (Ref (Array (Box SurfaceNode)))
          (Ref CtState)]
         (Result SurfaceNode CtError)))

  (sig expand-ct-macro-args
       (Fn
         [(Ref SurfaceNode)
          (Ref CtClosure)
          (Ref (Array (Box SurfaceNode)))
          (Ref CtState)]
         (Result SurfaceNode CtError)))

  (sig apply-macro-to-values
       (Fn
         [(Ref SurfaceNode)
          (Ref CtClosure)
          (Ref (Array (Box CtValue)))
          (Ref CtState)
          (Ref FrameId)]
         (Result CtValue CtError)))
  (sig eval-closure-body
       (Fn
         [(Ref CtClosure) (Ref CtState) (Ref FrameId)]
         (Result CtValue CtError)))

  (private eval-closure-body)
  (hidden eval-closure-body)
  (doc eval-closure-body "runs the body of `closure` with the closure's file as
the step file. A closure without a file pushes the empty string.")
  (defn eval-closure-body [closure state frame]
    (let-do [_pushed (push-step-file! (CtClosure.file closure))
             result (run-code
               @(CtProto.code
                 (Box.peek
                   (Array.unsafe-nth &*ct-protos* @(CtClosure.proto closure))))
               state
               frame
               @(FrameId.index (CtClosure.defining-frame closure)))
             _popped (pop-step-file!)]
      result))

  (defn apply-function-value [call function-value values state frame]
    (match-ref function-value
      (CtValue.Syntax syntax)
        (match (eval-node (Box.peek syntax) state frame)
          (Result.Success evaluated)
          ; syntax in head position is evaluated once, then applied. a
          ; literal evaluates to itself, so evaluating again would never end:
          ; `(1)` is an error.
          (if (syntax-value? &evaluated)
            (Result.Error
              (error-at call
                        (String.append
                          "compile-time application expects a function: "
                          &(Surface.render (Box.peek syntax)))))
            (apply-function-value call &evaluated values state frame))
          (Result.Error error)
          (Result.Error error))
      (CtValue.Closure closure)
        (match (bind-closure call state (Box.peek closure) values)
          (Result.Success closure-frame)
            (eval-closure-body (Box.peek closure) state &closure-frame)
          (Result.Error error) (Result.Error error))
      (CtValue.Builtin builtin-name)
        (match (apply-builtin-name call builtin-name values)
          (Maybe.Just result) result
          (Maybe.Nothing)
            (Result.Error (error-at call @"unknown compile-time builtin")))
      (CtValue.Macro macro-closure)
        (apply-macro-to-values call (Box.peek macro-closure) values state frame)
      _
        (Result.Error
          (error-at call @"compile-time application expects a function"))))

  (defn applied-call-syntax [call function-form values]
    (let-do [result (the
               (Result (Array (Box SurfaceNode)) CtError)
               (Result.Success [(Box.init (SurfaceNode.copy function-form))]))
             n (Array.length values)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success items)
            (match (syntax-from-value call
                                      (Box.peek (Array.unsafe-nth values i)))
              (Result.Success node) (Array.push-back! items (Box.init node))
              (Result.Error error) (set! result (Result.Error error)))
          (Result.Error error) (set! result (Result.Error @error))))
      (match result
        (Result.Success items)
          (Result.Success
            (CtValue.Syntax
              (Box.init
                (SurfaceNode.generated @(SurfaceNode.span call)
                                       (SurfaceForm.List items)))))
        (Result.Error error) (Result.Error error))))

  (defn expand-known-syntax [call node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (and (Int.> (Array.length &items) 0)
                   (named? (Box.peek (Array.unsafe-nth &items 0)) @"ignore*"))
            (let-do [expanded (the (Array (Box SurfaceNode)) [])
                     n (Array.length &items)]
              (for [i 1 n]
                (let [ignored (call-node call
                                         "ignore"
                                         &[(Box.init
                                             (SurfaceNode.copy (Box.peek (Array.unsafe-nth &items
                                                                                           i))))])]
                  (Array.push-back! &expanded (Box.init ignored))))
              (Result.Success (list-with-items call expanded)))
            (Result.Success (CtValue.Syntax (Box.init (SurfaceNode.copy node))))))
      _ (Result.Success (CtValue.Syntax (Box.init (SurfaceNode.copy node))))))

  (private macro-rest-syntax)
  (hidden macro-rest-syntax)
  (defn macro-rest-syntax [call arguments start]
    (let-do [items (the (Array (Box SurfaceNode)) [])
             n (Array.length arguments)]
      (for [i start n]
        (set! items
              (Array.push-back items
                               (Box.init
                                 (SurfaceNode.copy
                                   (Box.peek (Array.unsafe-nth arguments i)))))))
      (SurfaceNode.generated @(SurfaceNode.span call) (SurfaceForm.List items))))

  (private expand-ct-macro)
  (hidden expand-ct-macro)
  (private expand-ct-macro-args)
  (hidden expand-ct-macro-args)
  (doc expand-ct-macro "binds the argument syntax `items`, fixed then rest, in a
child of the macro's frame, evaluates its body and returns the expansion as
syntax. The caller decides whether to evaluate it.")
  (defn expand-ct-macro [call closure items state]
    (expand-ct-macro-args call closure &(Array.suffix items 1) state))

  (doc expand-ct-macro-args "expands a macro from its argument syntax, as
`expand-ct-macro` does, without taking the arguments from the call form.")
  (defn expand-ct-macro-args [call closure arguments state]
    (let [prototype (Box.peek
            (Array.unsafe-nth &*ct-protos* @(CtClosure.proto closure)))
          fixed (CtProto.parameters prototype)
          rest @(CtProto.rest prototype)
          fixed-count (Array.length fixed)
          argument-count (Array.length arguments)]
      (if (or (Int.< argument-count fixed-count)
              (and (Maybe.nothing? &rest) (/= fixed-count argument-count)))
        (Result.Error
          (error-at call
                    (String.concat
                      &[@"this macro takes "
                        (if (Maybe.just? &rest)
                          (String.concat &[@"at least " (Int.str fixed-count)])
                          (Int.str fixed-count))
                        (if (Int.= fixed-count 1)
                          @" argument, got "
                          @" arguments, got ")
                        (Int.str argument-count)])))
        (let-do [macro-frame (child! state (CtClosure.defining-frame closure))]
          (for [i 0 fixed-count]
            (ignore
              (CtEnv.define-local! (CtState.environment state)
                                   &macro-frame
                                   (Array.unsafe-nth fixed i)
                                   (CtValue.Syntax
                                     (Box.init
                                       (SurfaceNode.copy
                                         (Box.peek (Array.unsafe-nth arguments i))))))))
          (match rest
            (Maybe.Just rest-name)
              (ignore
                (CtEnv.define-local! (CtState.environment state)
                                     &macro-frame
                                     &rest-name
                                     (CtValue.Syntax
                                       (Box.init
                                         (macro-rest-syntax call
                                                            arguments
                                                            fixed-count)))))
            (Maybe.Nothing) ())
          (match (eval-closure-body closure state &macro-frame)
            (Result.Success expansion-value)
              (syntax-from-value call &expansion-value)
            (Result.Error error) (Result.Error error))))))

  (private apply-macro-to-values)
  (hidden apply-macro-to-values)
  (doc apply-macro-to-values "applies a macro reached as a value, as `apply`
does: each argument value is turned back into syntax and bound unevaluated, as
in the reference.")
  (defn apply-macro-to-values [call closure values state -frame]
    (let-do [items (the (Array (Box SurfaceNode))
                        [(Box.init (SurfaceNode.copy call))])
             failure (the (Maybe CtError) (Maybe.Nothing))
             n (Array.length values)]
      (for [i 0 n]
        (when (match-ref &failure (Maybe.Nothing) true _ false)
          (match (syntax-from-value call (Box.peek (Array.unsafe-nth values i)))
            (Result.Success node) (Array.push-back! &items (Box.init node))
            (Result.Error error) (set! failure (Maybe.Just error)))))
      (match failure
        (Maybe.Just error)
        (Result.Error error)
        (Maybe.Nothing)
        ;; the reference's `apply` on a macro yields the expansion as DATA
        ;; (dynamic code like ControlMacros' `(expand (apply ignore* forms))`
        ;; goes on to manipulate it), so no evaluation here.
        (match (expand-ct-macro call closure &items state)
          (Result.Success expansion)
            (Result.Success (CtValue.Syntax (Box.init expansion)))
          (Result.Error error) (Result.Error error)))))

  (doc pure-string-command? "checks whether `name` is a string command that a
top-level call runs at load time, as in the reference: `String.char-at` can fail
on a bad index, while the others clamp or return -1.")
  (defn pure-string-command? [name]
    (or (String.= name "String.char-at")
        (or (String.= name "String.slice") (String.= name "String.index-of"))))

  (doc register-macro! "binds `name` in `frame` to the macro with `fixed`,
`rest` and `body`, defined in `defining-frame`, so evaluation can expand it. The
macro keeps the file it is defined in.")
  (defn register-macro! [state frame name fixed rest body defining-frame]
    (ignore
      (define! state
               frame
               name
               (CtValue.Macro
                 (Box.init
                   (CtClosure.init
                     (CtLower.lower-macro-proto fixed rest body)
                     defining-frame
                     (definition-file)))))))

  (doc span-anchor "returns an empty list at `span`, to build syntax and errors
relative to a lowered form, which keeps only its span.")
  (defn span-anchor [span] (SurfaceNode.generated @span (SurfaceForm.List [])))

  (defn error-at-span [span message] (CtError.init message @span))

  (doc resolve-now "resolves `name` through the frames from `frame`, without a
cache.")
  (defn resolve-now [state frame name]
    (match (let-do [_counted (CtIRStore.count-name-resolution!)]
        (lookup-status state frame name))
      (CtEnvLookup.Found cell) (CtEnv.cell-index &cell)
      (CtEnvLookup.Ambiguous) (CtCacheCode.ambiguous)
      (CtEnvLookup.Missing) (CtCacheCode.missing)))

  (doc resolve-free "resolves `name` through inline cache `cache`, if the cache
answers for `base` at the current epoch, and fills it otherwise. It returns a
cell index or a code from `CtCacheCode`.")
  (defn resolve-free [state frame base cache name]
    (let [epoch (CtEnv.epoch (CtState.environment state))]
      (if (CtIRStore.cache-hit? cache base epoch)
        (CtIRStore.cache-value cache)
        (let-do [answer (resolve-now state frame name)]
          (CtIRStore.cache-fill! cache base epoch answer)
          answer))))

  (doc resolve-ref "resolves the lowered reference `reference` to a cell index
or a code from `CtCacheCode`. A `Name` is resolved through the frames and a
`Free` through its inline cache.")
  (defn resolve-ref [state frame base reference name]
    (match-ref reference
      (CtRef.Name) (resolve-now state frame name)
      (CtRef.Free cache) (resolve-free state frame base @cache name)))

  (defn cell-value [state index]
    (CtEnv.read-cell (CtState.environment state) &(CtEnv.cell-at index)))

  (doc macro-in-cell "returns the macro in cell `index`, if it holds one,
without copying other values.")
  (defn macro-in-cell [state index]
    (match-ref (CtEnv.peek-cell (CtState.environment state)
                                &(CtEnv.cell-at index))
      (CtValue.Macro closure) (Maybe.Just @(Box.peek closure))
      _ (the (Maybe CtClosure) (Maybe.Nothing))))

  (doc run-call-values "applies a resolved head to evaluated arguments. A
builtin is used before a binding, and a binding to syntax that names a function
is evaluated first.")
  (defn run-call-values [call builtin resolved state frame values]
    (cond
      (Int.>= builtin 0)
        (match (apply-builtin call builtin values)
          (Maybe.Just result) result
          (Maybe.Nothing)
            (Result.Error (error-at call @"unknown compile-time builtin")))
      (Int.>= resolved 0)
        (match (cell-value state resolved)
          (Maybe.Just function-value)
            (apply-function-value call &function-value values state frame)
          (Maybe.Nothing)
            (Result.Error (error-at call @"invalid compile-time cell")))
      (Result.Error
        (error-at call
                  (String.append
                    (if (Int.= resolved (CtCacheCode.ambiguous))
                      "ambiguous compile-time function: "
                      "unknown compile-time function: ")
                    &(match (symbol-key-of-head call)
                      (Maybe.Just name) name
                      (Maybe.Nothing) @"?"))))))

  (defn symbol-key-of-head [call]
    (match-ref (SurfaceNode.form call)
      (SurfaceForm.List items)
        (if (Int.> (Array.length items) 0)
          (symbol-key (Box.peek (Array.unsafe-nth items 0)))
          (the (Maybe String) (Maybe.Nothing)))
      _ (the (Maybe String) (Maybe.Nothing))))

  (private bool-at)
  (hidden bool-at)
  (doc bool-at "reads a value as a Bool as `when`, `while`, `cond`, `and` and
`or` do.")
  (defn bool-at [value span] (bool-argument &(span-anchor span) value))

  (private strict-bool-at)
  (hidden strict-bool-at)
  (doc strict-bool-at "reads a value as a Bool as `if` does: only Bool syntax
counts, as in the reference.")
  (defn strict-bool-at [value span]
    (match-ref value
      (CtValue.Syntax syntax)
        (match-ref (SurfaceNode.form (Box.peek syntax))
          (SurfaceForm.BoolLit found) (Result.Success @found)
          _
            (Result.Error
              (error-at-span span
                             @"compile-time if condition must evaluate to Bool syntax")))
      _
        (Result.Error
          (error-at-span span
                         @"compile-time if condition must evaluate to Bool syntax"))))

  (private pop-arguments!)
  (hidden pop-arguments!)
  (doc eval-node "lowers, compiles and runs `node` in `frame`. Expansions,
`eval` arguments and top-level compile-time calls run this way. It also records
the environment for editing.")
  (register observe-environment!
    (Fn [(Ref SurfaceNode) (Ref CtState) (Ref FrameId)] Unit))

  (defn eval-node [node state frame]
    (do
      (observe-environment! node state frame)
      (run-code
        (CtCompile.compile &(CtLower.lower node &(CtLower.empty-scope)))
        state
        frame
        @(FrameId.index frame))))

  (private special-apply)
  (hidden special-apply)
  (doc special-apply "runs `(apply f args)`. A name bound to a closure is
applied to the evaluated `args`. A qualified, builtin, unbound or syntax-bound
name gives the call form unevaluated. Any other head is evaluated first.")
  (defn special-apply [call function-form argument-list state frame]
    (let [values-result (collection-values call argument-list)]
      (match-ref &values-result
        (Result.Success values)
          (match (symbol-key function-form)
            (Maybe.Just function-name)
              (if (or (String.contains? &function-name \.)
                      (builtin-name? &function-name))
                (applied-call-syntax call function-form values)
                (match (lookup-status state frame &function-name)
                  (CtEnvLookup.Found cell)
                    (match (read-cell state &cell)
                      (Maybe.Just function-value)
                        (let [syntax-candidate (CtValue.copy &function-value)]
                          (match (syntax-from-value call &syntax-candidate)
                            (Result.Success function-node)
                              (applied-call-syntax call &function-node values)
                            (Result.Error _)
                              (let [callable-copy (CtValue.copy &function-value)]
                                (apply-function-value call
                                                      &callable-copy
                                                      values
                                                      state
                                                      frame))))
                      (Maybe.Nothing)
                        (Result.Error
                          (error-at call @"invalid compile-time cell")))
                  (CtEnvLookup.Ambiguous)
                    (Result.Error
                      (error-at call
                                (String.append "ambiguous compile-time function: "
                                               &function-name)))
                  (CtEnvLookup.Missing)
                    (applied-call-syntax call function-form values)))
            (Maybe.Nothing)
              (match (eval-node function-form state frame)
                (Result.Success function-value)
                  (apply-function-value call &function-value values state frame)
                (Result.Error error) (Result.Error error)))
        (Result.Error error) (Result.Error @error))))

  (private special-eval)
  (hidden special-eval)
  (doc special-eval "runs `(eval x)` on the evaluated `value`: syntax is
evaluated again. A symbol that names only a builtin evaluates; one that names
nothing stays as it is.")
  (defn special-eval [value state frame]
    (match-ref value
      (CtValue.Syntax node)
        (let [syntax (Box.peek node)]
          (match (symbol-key syntax)
            (Maybe.Just syntax-name)
              (match (lookup-status state frame &syntax-name)
                (CtEnvLookup.Missing)
                  (if (builtin-name? &syntax-name)
                    (eval-node syntax state frame)
                    (Result.Success
                      (CtValue.Syntax (Box.init (SurfaceNode.copy syntax)))))
                _ (eval-node syntax state frame))
            (Maybe.Nothing) (eval-node syntax state frame)))
      _ (Result.Success (CtValue.copy value))))

  (private special-members)
  (hidden special-members)
  ; a qualified type `A.T` keeps its members in module `A`, as `A.__members_T`
  (defn special-members [call type-form state frame prefix]
    (match (symbol-key type-form)
      (Maybe.Just type-name)
        (let [segments (String.split-by &type-name &[\.])
              last (Int.dec (Array.length &segments))
              local (String.concat
                &[@prefix (String.copy (Array.unsafe-nth &segments last))])
              ; an unqualified type is looked up from the call's scope; a
              ; qualified one only in the frame of the module it names
              found (if (Int.= last 0)
                (match (lookup-status state frame &local)
                  (CtEnvLookup.Found cell) (Maybe.Just cell)
                  _ (Maybe.Nothing))
                (match (CtLookup.module-frame (CtState.modules state)
                                              &(String.join "."
                                                            &(Array.prefix &segments
                                                                           last)))
                  (Maybe.Just owner)
                    (CtEnv.local-cell (CtState.environment state) &owner &local)
                  (Maybe.Nothing) (Maybe.Nothing)))]
          (match found
            (Maybe.Just cell)
              (match (read-cell state &cell)
                (Maybe.Just value) (Result.Success value)
                (Maybe.Nothing)
                  (Result.Error (error-at call @"members: invalid cell")))
            (Maybe.Nothing)
              (Result.Error
                (error-at call (String.append "not a type: " &type-name)))))
      (Maybe.Nothing)
        (Result.Error (error-at call @"members expects a type symbol"))))

  (private special-managed)
  (hidden special-managed)
  (defn special-managed [call type-form state frame]
    (match (symbol-key type-form)
      (Maybe.Just type-name)
        (let [binding-name (String.concat
                &[@"__managed_" (String.copy &type-name)])]
          (match (lookup-status state frame &binding-name)
            (CtEnvLookup.Found _) (Result.Success (syntax-bool call true))
            _ (Result.Success (syntax-bool call false))))
      (Maybe.Nothing)
        (Result.Error (error-at call @"managed? expects a type symbol"))))

  (private special-sexpr)
  (hidden special-sexpr)
  (defn special-sexpr [call argument state frame]
    (match (symbol-key argument)
      (Maybe.Just binding)
        (match (lookup-status state frame &binding)
          (CtEnvLookup.Found _)
            (match (eval-node argument state frame)
              (Result.Success value) (sexpr-from-value state frame call &value)
              (Result.Error error) (Result.Error error))
          (CtEnvLookup.Ambiguous)
            (Result.Error
              (error-at call
                        (String.append "ambiguous compile-time binding: "
                                       &binding)))
          (CtEnvLookup.Missing) (sexpr-for-binding state frame call &binding))
      (Maybe.Nothing)
        (match (eval-node argument state frame)
          (Result.Success value) (sexpr-from-value state frame call &value)
          (Result.Error error) (Result.Error error))))

  (private special-use)
  (hidden special-use)
  (defn special-use [call target state frame]
    (match (symbol-key target)
      (Maybe.Just path)
        (match (module-frame state &path)
          (Maybe.Just imported)
            (if (import! state frame &imported)
              (Result.Success (syntax-empty call))
              (Result.Error
                (error-at target @"invalid compile-time module frame")))
          (Maybe.Nothing)
            (Result.Error
              (error-at target
                        (String.append "unknown compile-time module: " &path))))
      (Maybe.Nothing)
        (Result.Error (error-at target @"use expects a module symbol"))))

  (private special-concat)
  (hidden special-concat)
  (defn special-concat [call left right]
    (match-ref left
      (CtValue.Collection left-items)
        (match-ref right
          (CtValue.Collection right-items)
            (let-do [items @left-items
                     n (Array.length right-items)]
              (for [i 0 n]
                (set! items
                      (Array.push-back items
                                       (Box.init
                                         (CtValue.copy
                                           (Box.peek (Array.unsafe-nth right-items
                                                                       i)))))))
              (Result.Success (CtValue.Collection items)))
          _
            (Result.Error
              (error-at call @"concat expects compile-time collections")))
      _
        (Result.Error (error-at call @"concat expects compile-time collections"))))

  (private special-with-test)
  (hidden special-with-test)
  (defn special-with-test [call name-value forms-value]
    (match (syntax-from-value call name-value)
      (Result.Success name-node)
        (match (list-items call forms-value)
          (Result.Success forms)
            (let-do [result (the (Array (Box CtValue)) [])
                     n (Array.length &forms)]
              (for [i 0 n]
                (Array.push-back! &result
                                  (Box.init
                                    (CtValue.Syntax
                                      (Box.init
                                        (set-ref-node call
                                                      &name-node
                                                      (Box.peek (Array.unsafe-nth &forms
                                                                                  i))))))))
              (Result.Success (CtValue.Collection result)))
          (Result.Error error) (Result.Error error))
      (Result.Error error) (Result.Error error)))

  (private run-special)
  (hidden run-special)
  (doc run-special "runs the special form `opcode`. The opcodes are
`CtSpecial`'s.")
  (defn run-special [opcode call raws values state frame]
    (cond
      (Int.= opcode (CtSpecial.apply-op))
        (special-apply call
                       (Box.peek (Array.unsafe-nth raws 0))
                       (Box.peek (Array.unsafe-nth values 0))
                       state
                       frame)
      (Int.= opcode (CtSpecial.expand-op))
        (match (syntax-from-value call (Box.peek (Array.unsafe-nth values 0)))
          (Result.Success node) (expand-known-syntax call &node)
          (Result.Error error) (Result.Error error))
      (Int.= opcode (CtSpecial.eval-op))
        (special-eval (Box.peek (Array.unsafe-nth values 0)) state frame)
      (Int.= opcode (CtSpecial.members-op))
        (special-members call
                         (Box.peek (Array.unsafe-nth raws 0))
                         state
                         frame
                         "__members_")
      (Int.= opcode (CtSpecial.managed-op))
        (special-managed call (Box.peek (Array.unsafe-nth raws 0)) state frame)
      (Int.= opcode (CtSpecial.type-op))
        (special-type call (Box.peek (Array.unsafe-nth raws 0)))
      (Int.= opcode (CtSpecial.meta-op))
        (special-meta call
                      (Box.peek (Array.unsafe-nth raws 0))
                      (Box.peek (Array.unsafe-nth values 0))
                      state
                      frame)
      (Int.= opcode (CtSpecial.sexpr-op))
        (special-sexpr call (Box.peek (Array.unsafe-nth raws 0)) state frame)
      (Int.= opcode (CtSpecial.use-op))
        (special-use call (Box.peek (Array.unsafe-nth raws 0)) state frame)
      (Int.= opcode (CtSpecial.concat-op))
        (special-concat call
                        (Box.peek (Array.unsafe-nth values 0))
                        (Box.peek (Array.unsafe-nth values 1)))
      (Int.= opcode (CtSpecial.with-test-op))
        (special-with-test call
                           (Box.peek (Array.unsafe-nth values 0))
                           (Box.peek (Array.unsafe-nth values 1)))
      (Int.= opcode (CtSpecial.compose-op))
        (eval-compose call
                      (Box.peek (Array.unsafe-nth raws 0))
                      (Box.peek (Array.unsafe-nth raws 1))
                      state
                      frame)
      (Result.Error (error-at call @"unknown compile-time special form"))))

  (doc pop-arguments! "removes the top `n` values of `stack` and returns them in
the order they were pushed. They are moved, not copied.")
  (defn pop-arguments! [stack n]
    (let-do [values (Array.allocate n)
             i (Int.dec n)]
      (while-do (Int.>= i 0)
        (Array.aset-uninitialized! &values i (Box.init (Array.pop-back! stack)))
        (set! i (Int.dec i)))
      values))

  (doc run-code "runs the compiled body `code-id` in `frame`. `base` is the
frame the body was defined in, which its inline caches are keyed by. Calls,
macro tests and some special forms run other code by calling back into the
evaluator.")
  (defn run-code [code-id state frame base]
    (let-do [stack (the (Array CtValue) [])
             saved (the (Array FrameId) [])
             current @frame
             pc 0
             failure (the (Maybe CtError) (Maybe.Nothing))
             answer (the (Maybe CtValue) (Maybe.Nothing))]
      (while-do (and (Maybe.nothing? &failure) (Maybe.nothing? &answer))
        (if (WorkBudget.consume! 1)
          (let [code (Box.peek (Array.unsafe-nth &*ct-codes* code-id))]
            (match-ref (Array.unsafe-nth (CtCode.instructions code) pc)
              (CtInstr.Push index)
                (do
                  (Array.push-back! &stack
                                    (CtValue.Syntax
                                      (Box.init
                                        (SurfaceNode.copy
                                          (Box.peek
                                            (Array.unsafe-nth (CtCode.constants code)
                                                              @index))))))
                  (set! pc (Int.inc pc)))
              (CtInstr.PushEmpty index)
                (do
                  (Array.push-back! &stack
                                    (syntax-empty
                                      &(span-anchor
                                        (Array.unsafe-nth (CtCode.spans code)
                                                          @index))))
                  (set! pc (Int.inc pc)))
              (CtInstr.PushBool index value)
                (do
                  (Array.push-back! &stack
                                    (syntax-bool
                                      &(span-anchor
                                        (Array.unsafe-nth (CtCode.spans code)
                                                          @index))
                                      @value))
                  (set! pc (Int.inc pc)))
              (CtInstr.Resolve index)
                (let [entry (Array.unsafe-nth (CtCode.symbols code) @index)]
                  (let [resolved (resolve-ref state
                                              &current
                                              base
                                              (CtSymbol.reference entry)
                                              (CtSymbol.name entry))]
                    (cond
                      (Int.>= resolved 0)
                        (match (cell-value state resolved)
                          (Maybe.Just value)
                            (do
                              (Array.push-back! &stack value)
                              (set! pc (Int.inc pc)))
                          (Maybe.Nothing)
                            (set! failure
                                  (Maybe.Just
                                    (error-at-span (CtSymbol.span entry)
                                                   @"invalid compile-time cell"))))
                      (Int.= resolved (CtCacheCode.ambiguous))
                        (set! failure
                              (Maybe.Just
                                (error-at-span (CtSymbol.span entry)
                                               (String.append "ambiguous compile-time binding: "
                                                              (CtSymbol.name entry)))))
                      (builtin-name? (CtSymbol.name entry))
                        (do
                          (Array.push-back! &stack
                                            (CtValue.Builtin @(CtSymbol.name entry)))
                          (set! pc (Int.inc pc)))
                      (set! failure
                            (Maybe.Just
                              (error-at-span (CtSymbol.span entry)
                                             (String.append "unknown compile-time symbol: "
                                                            (CtSymbol.name entry))))))))
              (CtInstr.ArgResolve index node-index)
                (let [entry (Array.unsafe-nth (CtCode.symbols code) @index)]
                  (let [resolved (resolve-ref state
                                              &current
                                              base
                                              (CtSymbol.reference entry)
                                              (CtSymbol.name entry))]
                    (cond
                      (Int.>= resolved 0)
                        (match (cell-value state resolved)
                          (Maybe.Just value)
                            (do
                              (Array.push-back! &stack value)
                              (set! pc (Int.inc pc)))
                          (Maybe.Nothing)
                            (set! failure
                                  (Maybe.Just
                                    (error-at-span (CtSymbol.span entry)
                                                   @"invalid compile-time cell"))))
                      (Int.= resolved (CtCacheCode.ambiguous))
                        (set! failure
                              (Maybe.Just
                                (error-at-span (CtSymbol.span entry)
                                               (String.append "ambiguous compile-time binding: "
                                                              (CtSymbol.name entry)))))
                      (builtin-name? (CtSymbol.name entry))
                        (do
                          (Array.push-back! &stack
                                            (CtValue.Builtin @(CtSymbol.name entry)))
                          (set! pc (Int.inc pc)))
                      (do
                        (Array.push-back! &stack
                                          (CtValue.Syntax
                                            (Box.init
                                              (SurfaceNode.copy
                                                (Box.peek
                                                  (Array.unsafe-nth (CtCode.nodes code)
                                                                    @node-index))))))
                        (set! pc (Int.inc pc))))))
              (CtInstr.MakeColl count)
                (do
                  (Array.push-back! &stack
                                    (CtValue.Collection (pop-arguments! &stack
                                                                        @count)))
                  (set! pc (Int.inc pc)))
              (CtInstr.MakeClosure proto)
                (do
                  (Array.push-back! &stack
                                    (CtValue.Closure
                                      (Box.init
                                        (CtClosure.init @proto
                                                        @&current
                                                        (definition-file)))))
                  (set! pc (Int.inc pc)))
              (CtInstr.CallMacroTest index after)
                (let [site (Array.unsafe-nth (CtCode.sites code) @index)]
                  (let [resolved (resolve-ref state
                                              &current
                                              base
                                              (CtCallSite.reference site)
                                              (CtCallSite.name site))]
                    (match (if (Int.>= resolved 0)
                        (macro-in-cell state resolved)
                        (the (Maybe CtClosure) (Maybe.Nothing)))
                      (Maybe.Just macro-closure)
                        (match (expand-ct-macro-args (Box.peek (CtCallSite.node site))
                                                     &macro-closure
                                                     (CtCallSite.raws site)
                                                     state)
                          (Result.Success expansion)
                            (match (eval-node &expansion state &current)
                              (Result.Success value)
                                (do
                                  (Array.push-back! &stack value)
                                  (set! pc @after))
                              (Result.Error error)
                                (set! failure (Maybe.Just error)))
                          (Result.Error error) (set! failure (Maybe.Just error)))
                      (Maybe.Nothing) (set! pc (Int.inc pc)))))
              (CtInstr.CallApply index count)
                (let-do [site (Array.unsafe-nth (CtCode.sites code) @index)
                         values (pop-arguments! &stack @count)
                         resolved (resolve-ref state
                                               &current
                                               base
                                               (CtCallSite.reference site)
                                               (CtCallSite.name site))]
                  (match (run-call-values (Box.peek (CtCallSite.node site))
                                          @(CtCallSite.builtin site)
                                          resolved
                                          state
                                          &current
                                          &values)
                    (Result.Success value)
                      (do (Array.push-back! &stack value) (set! pc (Int.inc pc)))
                    (Result.Error error) (set! failure (Maybe.Just error))))
              (CtInstr.CallApplyValue node-index count)
                (let-do [callee (Array.pop-back! &stack)
                         values (pop-arguments! &stack @count)
                         call (Box.peek
                           (Array.unsafe-nth (CtCode.nodes code) @node-index))]
                  (match (apply-function-value call
                                               &callee
                                               &values
                                               state
                                               &current)
                    (Result.Success value)
                      (do (Array.push-back! &stack value) (set! pc (Int.inc pc)))
                    (Result.Error error) (set! failure (Maybe.Just error))))
              (CtInstr.EnterFrame)
                (do
                  (Array.push-back! &saved @&current)
                  (set! current (child! state &current))
                  (set! pc (Int.inc pc)))
              (CtInstr.LeaveFrame)
                (do
                  (set! current (Array.pop-back! &saved))
                  (set! pc (Int.inc pc)))
              (CtInstr.Bind index)
                (do
                  (ignore
                    (CtEnv.define-local! (CtState.environment state)
                                         &current
                                         (Array.unsafe-nth (CtCode.names code)
                                                           @index)
                                         (Array.pop-back! &stack)))
                  (set! pc (Int.inc pc)))
              (CtInstr.Assign index span-index)
                (let [target (Array.unsafe-nth (CtCode.names code) @index)]
                  (if (CtEnv.set! (CtState.environment state)
                                  &current
                                  target
                                  (CtValue.copy
                                    (Array.unsafe-nth &stack
                                                      (Int.dec (Array.length &stack)))))
                    (set! pc (Int.inc pc))
                    (set! failure
                          (Maybe.Just
                            (error-at-span
                              (Array.unsafe-nth (CtCode.spans code) @span-index)
                              (String.append "unknown compile-time set! target: "
                                             target))))))
              (CtInstr.Jump target) (set! pc @target)
              (CtInstr.JumpUnlessBool target span-index)
                (match (bool-at &(Array.pop-back! &stack)
                                (Array.unsafe-nth (CtCode.spans code)
                                                  @span-index))
                  (Result.Success value)
                    (if value (set! pc (Int.inc pc)) (set! pc @target))
                  (Result.Error error) (set! failure (Maybe.Just error)))
              (CtInstr.JumpUnlessStrict target span-index)
                (match (strict-bool-at &(Array.pop-back! &stack)
                                       (Array.unsafe-nth (CtCode.spans code)
                                                         @span-index))
                  (Result.Success value)
                    (if value (set! pc (Int.inc pc)) (set! pc @target))
                  (Result.Error error) (set! failure (Maybe.Just error)))
              (CtInstr.JumpUnlessKeep target span-index)
                (match (bool-at
                    (Array.unsafe-nth &stack (Int.dec (Array.length &stack)))
                    (Array.unsafe-nth (CtCode.spans code) @span-index))
                  (Result.Success value)
                    (if value
                      (do
                        (ignore (Array.pop-back! &stack))
                        (set! pc (Int.inc pc)))
                      (set! pc @target))
                  (Result.Error error) (set! failure (Maybe.Just error)))
              (CtInstr.JumpIfKeep target span-index)
                (match (bool-at
                    (Array.unsafe-nth &stack (Int.dec (Array.length &stack)))
                    (Array.unsafe-nth (CtCode.spans code) @span-index))
                  (Result.Success value)
                    (if value
                      (set! pc @target)
                      (do
                        (ignore (Array.pop-back! &stack))
                        (set! pc (Int.inc pc))))
                  (Result.Error error) (set! failure (Maybe.Just error)))
              (CtInstr.Drop)
                (do (ignore (Array.pop-back! &stack)) (set! pc (Int.inc pc)))
              (CtInstr.Special opcode index count)
                (let-do [site (Array.unsafe-nth (CtCode.sites code) @index)
                         values (pop-arguments! &stack @count)]
                  (match (run-special @opcode
                                      (Box.peek (CtCallSite.node site))
                                      (CtCallSite.raws site)
                                      &values
                                      state
                                      &current)
                    (Result.Success value)
                      (do (Array.push-back! &stack value) (set! pc (Int.inc pc)))
                    (Result.Error error) (set! failure (Maybe.Just error))))
              (CtInstr.Fail index span-index)
                (set! failure
                      (Maybe.Just
                        (error-at-span
                          (Array.unsafe-nth (CtCode.spans code) @span-index)
                          @(Array.unsafe-nth (CtCode.names code) @index))))
              (CtInstr.Dup)
                (do
                  (Array.push-back! &stack
                                    (CtValue.copy
                                      (Array.unsafe-nth &stack
                                                        (Int.dec (Array.length &stack)))))
                  (set! pc (Int.inc pc)))
              (CtInstr.JumpUnlessEqual target span-index)
                (let-do [pattern (Array.pop-back! &stack)
                         matched (Array.pop-back! &stack)
                         anchor (span-anchor
                           (Array.unsafe-nth (CtCode.spans code) @span-index))]
                  (match (syntax-from-value &anchor &matched)
                    (Result.Success left)
                      (match (syntax-from-value &anchor &pattern)
                        (Result.Success right)
                          (if (syntax-equal? &left &right)
                            (set! pc (Int.inc pc))
                            (set! pc @target))
                        (Result.Error error) (set! failure (Maybe.Just error)))
                    (Result.Error error) (set! failure (Maybe.Just error))))
              (CtInstr.SexprResolve index target)
                (let [source (Box.peek
                        (Array.unsafe-nth (CtCode.nodes code) @index))]
                  (match (symbol-key source)
                    (Maybe.Just binding)
                      (match (sexpr-for-binding state &current source &binding)
                        (Result.Success value)
                          (do (Array.push-back! &stack value) (set! pc @target))
                        (Result.Error _) (set! pc (Int.inc pc)))
                    (Maybe.Nothing) (set! pc (Int.inc pc))))
              (CtInstr.Halt)
                (set! answer
                      (Maybe.Just
                        (if (Int.= 0 (Array.length &stack))
                          (syntax-empty &(span-anchor &(SurfaceSpan.anywhere)))
                          (Array.pop-back! &stack))))))
          (set! failure
                (Maybe.Just
                  (CtError.init (WorkBudget.reason) (SurfaceSpan.anywhere))))))
      (match failure
        (Maybe.Just error) (Result.Error error)
        (Maybe.Nothing)
          (match answer
            (Maybe.Just value) (Result.Success value)
            (Maybe.Nothing)
              (Result.Error
                (CtError.init
                  @"compile-time code ended without a value"
                  (SurfaceSpan.anywhere)))))))

  (doc eval-proto-template "evaluates the body of the macro prototype `proto`
and returns its result as syntax. `base` is the frame the macro was defined in.")
  (defn eval-proto-template [proto anchor state frame base]
    (match (run-code
        @(CtProto.code (Box.peek (Array.unsafe-nth &*ct-protos* proto)))
        state
        frame
        base)
      (Result.Success value) (syntax-from-value anchor &value)
      (Result.Error error) (Result.Error error)))

  (doc eval-template "evaluates the macro body `body` and returns its result as
syntax. A collection of syntax is turned into an array. Any other value, such as
a closure, is an error: a macro must return code.")
  (defn eval-template [body state frame]
    (match (eval-node body state frame)
      (Result.Success value) (syntax-from-value body &value)
      (Result.Error error) (Result.Error error))))

(load "carp-ct-editing.carp")
