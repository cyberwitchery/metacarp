(load "../carp-surface/carp-surface.carp")
;; `type` answers with the type of an expression, so the compile-time
;; evaluator needs the two passes that produce one. Neither loads this file,
;; so the dependency runs one way.
(load "../carp-resolve/carp-resolve.carp")
(load "../carp-infer/carp-infer.carp")
(load "../carp-ct-env/carp-ct-env.carp")
(load "carp-ct-lower.carp")

(doc CtValue "is a value in the compile-time evaluator. Syntax is kept
separate from closures and computed collections so macro execution never has
to use generated-program values.")
(deftype CtValue
  (Syntax [(Box SurfaceNode)])
  (Closure [(Box CtClosure)])
  (Builtin [String])
  (Collection [(Array (Box CtValue))])
  ;; a macro is a compile-time closure whose arguments bind UNEVALUATED and
  ;; whose result is evaluated again. Registering macros as environment
  ;; citizens (the reference's model) lets the evaluator expand macros it
  ;; meets mid-evaluation — the unification that makes real Core macro code
  ;; runnable.
  (Macro [(Box CtClosure)]))

(doc CtClosure "is a lexical compile-time function: a prototype, the stable
ID of the frame it closed over, and the file it was written in so a step
inside its body can say where it is. The file is empty when the closure was
defined from source that had none.

Everything about the FUNCTION — parameters, rest parameter, lowered body —
lives in the prototype, which is lowered once where the function is written.
A closure is therefore three words, and copying one out of the environment to
call it copies three words rather than a syntax tree.")
(deftype CtClosure [proto Int
                    defining-frame FrameId
                    file String])

(deftype CtParameters [fixed (Array String)
                       rest (Maybe String)])

(doc CtModuleFrame "records the compile-time frame for one module path.")
(deftype CtModuleFrame [path String
                        frame FrameId])

(doc CtState "owns the persistent frame-and-cell store for one compile-time
evaluation session.")
(deftype CtState
  [environment (CtEnvStore CtValue)
   root FrameId
   modules (Array CtModuleFrame)])

(doc CtError "is an error raised while evaluating compile-time syntax. The
span points to the macro body or invocation that caused the failure.")
(deftype CtError [message String
                  span SurfaceSpan])

(doc CtNumber "is a compile-time number the way the reference evaluator holds
one: a value in either the integral or the floating domain, plus the width
the literal will be rendered at. Widths follow the reference's promotion
ladder -- 0 Byte, 1 Int, 2 Long, 3 Float, 4 Double -- so promotion is a max
and width 3 or above means the floating field carries the value.")
(deftype CtNumber [width Int
                   integral Long
                   floating Double])

;; the compile-time load stack: the filesystem path of every file whose forms
;; are currently being expanded, innermost last. Maintained by the expander
;; from the loader's `Unsafe.load-stack-push!`/`-pop!` markers; `current-file`
;; (Core Dynamic) reads it through the `Unsafe.load-stack` builtin.
(def *ct-load-stack* (the (Array String) []))

;; metadata a `meta-set!` recorded, as (qualified name + key) to the value
;; syntax. The reference keeps this on the binder it annotates; expansion here
;; runs before any binding exists, so the table lives beside the load stack
;; and `meta` reads it back. Append-only: a later `meta-set!` for the same
;; name and key shadows the earlier one, which is what a lookup takes.
(def *ct-meta* (the (Array (Pair String (Box SurfaceNode))) []))

;; the top-level forms expansion has finished so far, in source order. `type`
;; infers against them: the reference can ask its global environment because
;; it evaluates and types a form at a time, and this compiler expands
;; everything before it resolves anything, so the forms are what there is.
(def *ct-typing-forms* (the (Array (Box SurfaceNode)) []))

;; compile-time build commands (`system-include`, `add-cflag`, `add-lib`,
;; `add-pkg`) applied as dynamic functions: includes become synthesized
;; top-level forms the expansion drains into its output, flags accumulate for
;; the driver's compiler invocation.
(def *ct-pending-includes* (the (Array SurfaceNode) []))
(def *ct-collected-cflags* (the (Array String) []))

;; where the FORMS BEING EVALUATED are written, innermost last. This is not
;; the load stack: `current-file` (and so `relative-include`) means the file
;; being loaded, which stays the caller's while a macro from another file
;; runs. A debugger needs the opposite — the file the running body is written
;; in — and the two must not be confused for each other.
(def *ct-step-files* (the (Array String) []))

(doc CtBinding "one name in scope at a step, and what it held at that moment.
The value is text because that is all a reader of a recording can use: the
value itself belongs to an evaluation that has already finished.")
(deftype CtBinding [name String
                    value String])

(doc CtStep "one step of compile-time evaluation: the form that was about to
be evaluated, where it came from, which frame it ran in, how deep in the
evaluation it was, and what was in scope. A trace of these is what the
dynamic debugger walks.

Scope is captured per step rather than reconstructed afterwards: a binding
can be rebound as evaluation proceeds, so the environment at the end does not
say what a step in the middle saw.")
(deftype CtStep
  [form String
   file String
   span SurfaceSpan
   frame Int
   depth Int
   bindings (Array CtBinding)])

;; Compile-time evaluation is deterministic, so a debugger does not have to
;; suspend it: record every step of one run, and stepping is walking the
;; recording. Off by default — a compiler that is not being debugged pays one
;; boolean test per form.
(def *ct-tracing* false)
(def *ct-trace* (the (Array CtStep) []))
(def *ct-depth* 0)

(defmodule CtEval
  (defn reset-load-stack! [] (set! *ct-load-stack* []))

  (private meta-entry-key)
  (hidden meta-entry-key)
  (defn meta-entry-key [name key]
    (String.concat &[(String.copy name) @" " (String.copy key)]))

  (doc reset-meta! "drops recorded metadata; a fresh compile-time session
annotates nothing.")
  (defn reset-meta! [] (set! *ct-meta* []))

  (doc reset-typing-forms! "drops the forms `type` infers against.")
  (defn reset-typing-forms! [] (set! *ct-typing-forms* []))

  (doc record-typing-form! "keeps one finished top-level form for `type`.")
  (defn record-typing-form! [form]
    (Array.push-back! &*ct-typing-forms* (Box.init (SurfaceNode.copy form))))

  (doc record-meta! "records one metadata entry for a qualified name.")
  (defn record-meta! [name key value]
    (Array.push-back! &*ct-meta*
                      (Pair.init (meta-entry-key name key)
                                 (Box.init (SurfaceNode.copy value)))))

  (doc meta-value "the value recorded for a name and key, latest first.")
  (defn meta-value [name key]
    (let-do [composed (meta-entry-key name key)
             result (the (Maybe (Box SurfaceNode)) (Maybe.Nothing))
             n (Array.length &*ct-meta*)]
      (for [i 0 n]
        (let [entry (Array.unsafe-nth &*ct-meta* i)]
          (when (String.= (Pair.a entry) &composed)
            (set! result (Maybe.Just (Box.copy (Pair.b entry)))))))
      result))

  (doc drain-pending-includes! "the `(system-include ...)` forms compile-time
evaluation requested since the last drain, cleared on return; the expansion
appends them to its output so resolution collects them like written ones.")
  (defn drain-pending-includes! []
    (let-do [drained (Array.copy &*ct-pending-includes*)]
      (set! *ct-pending-includes* [])
      drained))

  (doc collected-cflags "the deduplicated compiler flags (`add-cflag`,
`add-lib`, `add-pkg`) compile-time evaluation has requested, in first-use
order, for the driver's C compiler invocation.")
  (defn collected-cflags []
    (let-do [flags (the (Array String) [])]
      (for [i 0 (Array.length &*ct-collected-cflags*)]
        (let-do [flag (Array.unsafe-nth &*ct-collected-cflags* i)
                 seen false]
          (for [j 0 (Array.length &flags)]
            (when (String.= (Array.unsafe-nth &flags j) flag) (set! seen true)))
          (unless seen (Array.push-back! &flags @flag))))
      flags))

  (doc record-cflag! "adds one flag to the collected compiler flags.")
  (defn record-cflag! [flag] (Array.push-back! &*ct-collected-cflags* @flag))

  (doc push-step-file! "enters a file for the purpose of recording steps: the
body about to run is written there. Push the empty string when the file is
unknown, so a body cannot inherit its caller's.")
  (defn push-step-file! [path] (Array.push-back! &*ct-step-files* @path))

  (defn pop-step-file! []
    (when (Int.> (Array.length &*ct-step-files*) 0)
      (ignore (Array.pop-back! &*ct-step-files*))))

  (private current-step-file)
  (hidden current-step-file)
  (doc current-step-file "the file the forms being evaluated are written in,
or the empty string when nothing has claimed one.")
  (defn current-step-file []
    (let [n (Array.length &*ct-step-files*)]
      (if (Int.= n 0) @"" @(Array.unsafe-nth &*ct-step-files* (Int.dec n)))))

  (doc current-load-file "the file being loaded, innermost first. This stays
the caller's file while a macro from somewhere else runs, which is what
`current-file` and so `relative-include` mean by it. Where the running body
is written is a different question, and `current-step-file` answers it.")
  (defn current-load-file []
    (let [n (Array.length &*ct-load-stack*)]
      (if (Int.= n 0) @"" @(Array.unsafe-nth &*ct-load-stack* (Int.dec n)))))

  (doc definition-file "the file a definition being read is written in. A
file being loaded says so through the load stack; source handed over as text
says so through the step file, which is the only thing that knows where a
macro defined in a cell lives.")
  (defn definition-file []
    (let [inner (current-step-file)]
      (if (String.empty? &inner) (current-load-file) inner)))

  (doc trace-on! "starts recording compile-time steps, dropping whatever an
earlier run recorded.")
  (defn trace-on! []
    (do (set! *ct-tracing* true) (set! *ct-trace* []) (set! *ct-depth* 0)))

  (doc trace-off! "stops recording. What was recorded stays until the next
run starts.")
  (defn trace-off! [] (set! *ct-tracing* false))

  (doc trace "the steps the last recorded run took, in the order it took
them.")
  (defn trace [] (Array.copy &*ct-trace*))

  (private binding-text)
  (hidden binding-text)
  (doc binding-text "what a compile-time value looks like to a reader of a
recording. Syntax renders as the code it is; the rest say what they are,
because a closure or a builtin has no text worth showing.")
  (defn binding-text [value]
    (match-ref value
      (CtValue.Syntax syntax) (Surface.render (Box.peek syntax))
      (CtValue.Collection values) (fmt "«%d values»" (Array.length values))
      (CtValue.Closure _) @"«compile-time function»"
      (CtValue.Macro _) @"«macro»"
      (CtValue.Builtin name) (fmt "«builtin %s»" name)))

  (private step-bindings)
  (hidden step-bindings)
  (doc step-bindings "what is in scope at a step: the names bound in its frame
and in the frames it is nested inside, innermost first.

The root frame is left out on purpose. It holds every global the session
knows, so including it would bury the handful of names a reader is actually
looking at, and would copy that list once per recorded step. The walk is
capped for the same reason.")
  (defn step-bindings [state frame]
    (let-do [result (the (Array CtBinding) [])
             store (CtState.environment state)
             root @(FrameId.index (CtState.root state))
             current (Maybe.Just @frame)
             frames-left 8]
      (while-do (and (Int.> frames-left 0)
                     (match-ref &current
                       (Maybe.Just _) true
                       (Maybe.Nothing) false))
        (let-do [here (match-ref &current
                   (Maybe.Just f) @f
                   (Maybe.Nothing) (FrameId.init 0))]
          (if (Int.= @(FrameId.index &here) root)
            (set! current (the (Maybe FrameId) (Maybe.Nothing)))
            (let-do [bindings (CtEnv.local-bindings store &here)
                     n (Array.length &bindings)]
              (for [i 0 n]
                (when (Int.< (Array.length &result) 64)
                  (let [binding (Array.unsafe-nth &bindings i)]
                    (match (CtEnv.read-cell store (CtEnvBinding.cell binding))
                      (Maybe.Just value)
                        (Array.push-back! &result
                                          (CtBinding.init @(CtEnvBinding.name binding)
                                                          (binding-text &value)))
                      (Maybe.Nothing) ()))))
              (set! current (CtEnv.parent-frame store &here))
              (set! frames-left (Int.dec frames-left))))))
      result))

  (private record-step!)
  (hidden record-step!)
  (defn record-step! [body state frame]
    (Array.push-back! &*ct-trace*
                      (CtStep.init (Surface.render body)
                                   (current-step-file)
                                   @(SurfaceNode.span body)
                                   @(FrameId.index frame)
                                   *ct-depth*
                                   (step-bindings state frame))))

  (doc enter-call! "records a call the expander is about to run the body of,
and enters it. Expanding a macro evaluates its body without ever evaluating
the call, so without this the recording starts inside the macro and a reader
has no way to see what invoked it. The call is recorded before the macro's
file is entered, so it keeps the caller's.")
  (defn enter-call! [call state frame]
    (when-do *ct-tracing*
      (record-step! call state frame)
      (set! *ct-depth* (Int.inc *ct-depth*))))

  (doc leave-call! "leaves a call entered by `enter-call!`.")
  (defn leave-call! []
    (when *ct-tracing* (set! *ct-depth* (Int.dec *ct-depth*))))

  (defn push-load-file! [path] (Array.push-back! &*ct-load-stack* @path))

  (defn pop-load-file! []
    (when (Int.> (Array.length &*ct-load-stack*) 0)
      (ignore (Array.pop-back! &*ct-load-stack*))))

  (private symbol-name)
  (hidden symbol-name)
  (defn symbol-name [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.Symbol segments)
        (if (Int.= 1 (Array.length segments))
          (Maybe.Just @(Array.unsafe-nth segments 0))
          (Maybe.Nothing))
      _ (Maybe.Nothing)))

  (private symbol-key)
  (hidden symbol-key)
  (defn symbol-key [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.Symbol segments)
        (if (Int.> (Array.length segments) 0)
          (Maybe.Just (String.join "." segments))
          (Maybe.Nothing))
      _ (Maybe.Nothing)))

  (private named?)
  (hidden named?)
  (defn named? [node name]
    (match (symbol-key node)
      (Maybe.Just found) (= found name)
      (Maybe.Nothing) false))

  (private error-at)
  (hidden error-at)
  (defn error-at [node message] (CtError.init message @(SurfaceNode.span node)))

  (private path-directory)
  (hidden path-directory)
  (defn path-directory [path]
    (let-do [slash -1
             i 0
             n (String.length path)]
      (while-do (Int.< i n)
        (when (Char.= (String.char-at path i) \/) (set! slash i))
        (set! i (Int.inc i)))
      (cond
        (Int.< slash 0) (String.copy ".")
        (Int.= slash 0) (String.copy "/")
        (String.slice path 0 slash))))

  (private semantic-items)
  (hidden semantic-items)
  (defn semantic-items [items]
    (let-do [result (the (Array (Box SurfaceNode)) [])
             n (Array.length items)]
      (for [i 0 n]
        (let [item (Box.peek (Array.unsafe-nth items i))]
          (match-ref (SurfaceNode.form item)
            (SurfaceForm.Comment _) ()
            _
              (set! result
                    (Array.push-back result (Box.init (SurfaceNode.copy item)))))))
      result))

  (doc state "creates a compile-time state with one root frame.")
  (defn state []
    (let-do [environment (CtEnv.empty)
             root (CtEnv.root! &environment)]
      (CtState.init environment
                    root
                    [(CtModuleFrame.init @"" (FrameId.copy &root))])))

  (doc root "returns the root frame of a compile-time state.")
  (defn root [state] @(CtState.root state))

  (doc child! "allocates a lexical child frame.")
  (defn child! [state parent] (CtEnv.child! (CtState.environment state) parent))

  (doc define! "defines a value in a compile-time frame.")
  (defn define! [state frame name value]
    (CtEnv.define! (CtState.environment state) frame name value))

  (doc define-local! "binds a name that only this frame's own code can see —
a macro's parameters, a call's arguments. Resolutions cached elsewhere cannot
be affected by one, so it leaves the binding epoch alone.")
  (defn define-local! [state frame name value]
    (CtEnv.define-local! (CtState.environment state) frame name value))

  (doc alias! "binds `name` to an existing compile-time cell.")
  (defn alias! [state frame name cell]
    (CtEnv.bind-cell! (CtState.environment state) frame name cell))

  (doc import! "adds an imported compile-time frame.")
  (defn import! [state frame imported]
    (CtEnv.add-import! (CtState.environment state) frame imported))

  (doc register-module! "records the compile-time frame for a module path.")
  (defn register-module! [state path frame]
    (let-do [known false
             modules (CtState.modules state)
             n (Array.length modules)]
      (for [i 0 n]
        (let [entry (Array.unsafe-nth modules i)]
          (when (= (CtModuleFrame.path entry) path) (set! known true))))
      (unless known (Array.push-back! modules (CtModuleFrame.init @path @frame)))
      true))

  (doc module-frame "looks up the compile-time frame for a module path.")
  (defn module-frame [state path]
    (let-do [result (the (Maybe FrameId) (Maybe.Nothing))
             modules (CtState.modules state)
             n (Array.length modules)]
      (for [i 0 n]
        (match-ref &result
          (Maybe.Nothing)
            (let [entry (Array.unsafe-nth modules i)]
              (when (= (CtModuleFrame.path entry) path)
                (set! result (Maybe.Just @(CtModuleFrame.frame entry)))))
          (Maybe.Just _) ()))
      result))

  (doc lookup-value "looks up a compile-time binding by name.")
  (defn lookup-value [state frame name]
    (CtEnv.lookup (CtState.environment state) frame name))

  (doc lookup-status "resolves a compile-time name while preserving import
ambiguity.")
  (private module-member-lookup)
  (hidden module-member-lookup)
  (defn module-member-lookup [state path local]
    (match (module-frame state path)
      (Maybe.Just target)
        (CtEnv.lookup-status (CtState.environment state) &target local)
      (Maybe.Nothing) (CtEnvLookup.Missing)))

  (private static-definition-value?)
  (hidden static-definition-value?)
  ;; a static definition's recorded source syntax is not evaluable; dynamic
  ;; evaluation must not let it shadow a same-named `Dynamic` binding (the
  ;; reference's dynamic lookup preference) — e.g. `(length m)` inside the
  ;; `Map` module means `Dynamic.length`, not the static `Map.length` source.
  (private definition-head?)
  (hidden definition-head?)
  (doc definition-head? "whether `name` heads a static definition form. The
first byte settles it for everything that is not one, which matters because
this runs on every name that resolves to a piece of list syntax.")
  (defn definition-head? [name]
    (let [first (String.char-at name 0)]
      (cond
        (Char.= first \d)
          (or (String.= name "defn")
              (or (String.= name "defn-")
                  (or (String.= name "def")
                      (or (String.= name "def-")
                          (or (String.= name "deftype")
                              (or (String.= name "deftemplate")
                                  (or (String.= name "definterface")
                                      (String.= name "defmodule"))))))))
        (Char.= first \r) (String.= name "register")
        false)))

  (defn static-definition-value? [value]
    (match-ref value
      (CtValue.Syntax boxed)
        (match-ref (SurfaceNode.form (Box.peek boxed))
          (SurfaceForm.List items)
            (if (Int.> (Array.length items) 0)
              (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth items 0)))
                (SurfaceForm.Symbol segments)
                  (and (Int.= 1 (Array.length segments))
                       (definition-head? (Array.unsafe-nth segments 0)))
                _ false)
              false)
          _ false)
      _ false))

  (defn lookup-status [state frame name]
    (match (CtEnv.lookup-status (CtState.environment state) frame name)
      (CtEnvLookup.Found cell)
      (if (and (not (String.contains? name \.))
               (static-definition-value?
                 (CtEnv.peek-cell (CtState.environment state) &cell)))
        (match (module-member-lookup state "Dynamic" name)
          (CtEnvLookup.Found dynamic-cell) (CtEnvLookup.Found dynamic-cell)
          _ (CtEnvLookup.Found cell))
        (CtEnvLookup.Found cell))
      (CtEnvLookup.Ambiguous)
      (CtEnvLookup.Ambiguous)
      (CtEnvLookup.Missing)
      ;; a qualified name reaches into the named module's frame. Compile-time
      ;; code prefers the `Dynamic` module (the reference resolves `Map.len`
      ;; in dynamic code to `Dynamic.Map.len`, never the static function).
      (if (String.contains? name \.)
        (let-do [segments (String.split-by name &[\.])
                 segment-count (Array.length &segments)
                 local (String.copy
                   (Array.unsafe-nth &segments (Int.dec segment-count)))
                 module-path (String.join "."
                                          &(Array.prefix &segments
                                                         (Int.dec segment-count)))
                 found (module-member-lookup state
                                             &(String.concat
                                               &[@"Dynamic."
                                                 (String.copy &module-path)])
                                             &local)]
          (match found
            (CtEnvLookup.Missing)
              (module-member-lookup state &module-path &local)
            _ found))
        (module-member-lookup state "Dynamic" name))))

  (doc read-cell "copies a compile-time value from a resolved cell.")
  (defn read-cell [state cell]
    (CtEnv.read-cell (CtState.environment state) cell))

  (doc lookup "looks up syntax bound to `name`. It remains public for clients
that only need syntax parameters; closures and collections return `Nothing`.")
  (defn lookup [state frame name]
    (match (lookup-value state frame name)
      (Maybe.Just value)
        (match value
          (CtValue.Syntax syntax)
            (Maybe.Just (SurfaceNode.copy (Box.peek &syntax)))
          _ (Maybe.Nothing))
      (Maybe.Nothing) (Maybe.Nothing)))

  (private copy-children)
  (hidden copy-children)
  (defn copy-children [items]
    (let-do [result (the (Array (Box SurfaceNode)) [])
             n (Array.length items)]
      (for [i 0 n]
        (set! result
              (Array.push-back result
                               (Box.init
                                 (SurfaceNode.copy (Box.peek (Array.unsafe-nth items
                                                                               i)))))))
      result))

  (private append-children)
  (hidden append-children)
  (private append-values)
  (hidden append-values)
  (defn append-children [left right]
    (let-do [result left
             n (Array.length right)]
      (for [i 0 n]
        (set! result
              (Array.push-back result
                               (Box.init
                                 (SurfaceNode.copy (Box.peek (Array.unsafe-nth right
                                                                               i)))))))
      result))

  (defn append-values [left right]
    (let-do [result left
             n (Array.length right)]
      (for [i 0 n]
        (set! result
              (Array.push-back result
                               (Box.init
                                 (CtValue.copy (Box.peek (Array.unsafe-nth right
                                                                           i)))))))
      result))

  (private splice-children)
  (hidden splice-children)
  (defn splice-children [node value]
    (match-ref (SurfaceNode.form value)
      (SurfaceForm.List items) (Result.Success (copy-children items))
      (SurfaceForm.Array items) (Result.Success (copy-children items))
      (SurfaceForm.StaticArray items) (Result.Success (copy-children items))
      (SurfaceForm.Dictionary items) (Result.Success (copy-children items))
      _
        (Result.Error
          (error-at node @"unquote-splicing requires a collection of syntax"))))

  (private syntax-from-value)
  (hidden syntax-from-value)
  (defn syntax-from-value [node value]
    (match-ref value
      (CtValue.Syntax syntax)
        (Result.Success (SurfaceNode.copy (Box.peek syntax)))
      (CtValue.Collection values)
        (let-do [result (the
                   (Result (Array (Box SurfaceNode)) CtError)
                   (Result.Success []))
                 n (Array.length values)]
          (for [i 0 n]
            (match-ref &result
              (Result.Success items)
                (match-ref (Box.peek (Array.unsafe-nth values i))
                  (CtValue.Syntax syntax)
                    (set! result
                          (Result.Success
                            (Array.push-back @items
                                             (Box.init (SurfaceNode.copy (Box.peek syntax))))))
                  _
                    (set! result
                          (Result.Error
                            (error-at node
                                      @"compile-time collection contains a non-syntax value"))))
              (Result.Error error) (set! result (Result.Error @error))))
          (match result
            (Result.Success items)
              (Result.Success
                (SurfaceNode.init @(SurfaceNode.span node)
                                  (SurfaceForm.Array items)))
            (Result.Error error) (Result.Error error)))
      _
        (Result.Error
          (error-at node @"compile-time expression must evaluate to syntax"))))

  (private splice-value)
  (hidden splice-value)
  (defn splice-value [node value]
    (match-ref value
      (CtValue.Syntax syntax) (splice-children node (Box.peek syntax))
      (CtValue.Collection values)
        (let-do [result (the
                   (Result (Array (Box SurfaceNode)) CtError)
                   (Result.Success []))
                 n (Array.length values)]
          (for [i 0 n]
            (match-ref &result
              (Result.Success syntax-items)
                (let [item (Box.peek (Array.unsafe-nth values i))]
                  (match (syntax-from-value node item)
                    (Result.Success syntax)
                      (set! result
                            (Result.Success
                              (Array.push-back @syntax-items (Box.init syntax))))
                    (Result.Error error) (set! result (Result.Error error))))
              (Result.Error error) (set! result (Result.Error @error))))
          result)
      _
        (Result.Error
          (error-at node
                    @"unquote-splicing requires syntax or a syntax collection"))))

  (private closure-parameters)
  (hidden closure-parameters)
  (private list-or-collection)
  (hidden list-or-collection)
  (defn closure-parameters [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.Array forms)
        (let-do [fixed (the (Array String) [])
                 rest (the (Maybe String) (Maybe.Nothing))
                 result (the (Result CtParameters CtError)
                             (Result.Success (CtParameters.init []
                                                                (Maybe.Nothing))))
                 n (Array.length forms)]
          (for [i 0 n]
            (match-ref &result
              (Result.Success _)
                (let [form (Box.peek (Array.unsafe-nth forms i))]
                  (let [name-result (symbol-name form)]
                    (match-ref &name-result
                      (Maybe.Just name)
                        (cond
                          (= name ":rest")
                            (if (Int.= (Int.inc i) (Int.dec n))
                              (let [rest-form (Box.peek (Array.unsafe-nth forms
                                                                          (Int.inc i)))]
                                (let [rest-name-result (symbol-name rest-form)]
                                  (match-ref &rest-name-result
                                    (Maybe.Just rest-name)
                                      (do
                                        (set! rest
                                              (Maybe.Just (String.copy rest-name)))
                                        (set! i (Int.inc i)))
                                    (Maybe.Nothing)
                                      (set! result
                                            (Result.Error
                                              (error-at rest-form
                                                        @"compile-time :rest must be followed by an unqualified symbol"))))))
                              (set! result
                                    (Result.Error
                                      (error-at form
                                                @"compile-time :rest must be followed by the final parameter"))))
                          (Maybe.nothing? &rest)
                            (set! fixed
                                  (Array.push-back fixed (String.copy name)))
                          (set! result
                                (Result.Error
                                  (error-at form
                                            @"compile-time parameters cannot follow :rest"))))
                      (Maybe.Nothing)
                        (set! result
                              (Result.Error
                                (error-at form
                                          @"compile-time fn parameters must be symbols"))))))
              (Result.Error error) (set! result (Result.Error @error))))
          (match result
            (Result.Success _) (Result.Success (CtParameters.init fixed rest))
            (Result.Error error) (Result.Error error)))
      _
        (Result.Error
          (error-at node @"compile-time fn parameters must be an array"))))

  (private bind-closure)
  (hidden bind-closure)
  (defn bind-closure [call state closure arguments]
    (let [proto (Box.peek
            (Array.unsafe-nth &*ct-protos* @(CtClosure.proto closure)))
          parameters (CtProto.parameters proto)
          rest @(CtProto.rest proto)
          expected (Array.length parameters)
          actual (Array.length arguments)]
      (if (or (Int.< actual expected)
              (and (Maybe.nothing? &rest) (/= expected actual)))
        (Result.Error
          (error-at call
                    @"compile-time function called with the wrong number of arguments"))
        (let-do [frame (child! state (CtClosure.defining-frame closure))]
          (for [i 0 expected]
            (ignore
              (CtEnv.define-local! (CtState.environment state)
                                   &frame
                                   (Array.unsafe-nth parameters i)
                                   (CtValue.copy
                                     (Box.peek (Array.unsafe-nth arguments i))))))
          (match rest
            (Maybe.Just rest-name)
              (let-do [rest-values (the (Array (Box CtValue)) [])]
                (for [i expected actual]
                  (Array.push-back! &rest-values
                                    (Box.init
                                      (CtValue.copy
                                        (Box.peek (Array.unsafe-nth arguments i))))))
                (ignore
                  (CtEnv.define-local! (CtState.environment state)
                                       &frame
                                       &rest-name
                                       (list-or-collection call &rest-values))))
            (Maybe.Nothing) ())
          (Result.Success frame)))))

  (doc define-function "creates a lexical compile-time closure from a
parameter array and body. Macro loaders use this for `defndynamic` bindings.

The closure keeps the file it is being defined in, which is the only moment
that file is known: by the time it is called, the caller's file is the one
being loaded.")
  (defn define-function [parameters body frame]
    (match (closure-parameters parameters)
      (Result.Success parsed)
        (match (CtLower.lower-proto parameters body &(CtLower.empty-scope))
          (Maybe.Just proto)
            (Result.Success
              (CtValue.Closure
                (Box.init (CtClosure.init proto @frame (definition-file)))))
          (Maybe.Nothing)
            (Result.Error
              (error-at parameters @"compile-time fn parameters must be symbols")))
      (Result.Error error) (Result.Error error)))

  (doc define-dynamic-function "creates a top-level `defndynamic` closure in
its definition frame.")
  (defn define-dynamic-function [parameters body frame]
    (define-function parameters body frame))

  (private syntax-arguments)
  (hidden syntax-arguments)
  (defn syntax-arguments [call values]
    (let-do [result (the
               (Result (Array (Box SurfaceNode)) CtError)
               (Result.Success []))
             n (Array.length values)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success syntax)
            (let [value (Box.peek (Array.unsafe-nth values i))]
              (match (syntax-from-value call value)
                (Result.Success node)
                  (set! result
                        (Result.Success
                          (Array.push-back @syntax (Box.init node))))
                (Result.Error error) (set! result (Result.Error error))))
          (Result.Error error) (set! result (Result.Error @error))))
      result))

  (private list-items)
  (hidden list-items)
  (private values-from-syntax-items)
  (hidden values-from-syntax-items)
  (private collection-values)
  (hidden collection-values)
  (private operation-name)
  (hidden operation-name)
  (defn operation-name [call]
    (match-ref (SurfaceNode.form call)
      (SurfaceForm.List items)
        (if (Int.> (Array.length items) 0)
          (match (symbol-key (Box.peek (Array.unsafe-nth items 0)))
            (Maybe.Just name) name
            (Maybe.Nothing) @"unknown")
          @"unknown")
      _ @"unknown"))

  (defn list-items [call value]
    (match-ref value
      (CtValue.Collection values) (syntax-arguments call values)
      _
        (match (syntax-from-value call value)
          (Result.Success node)
            (match-ref (SurfaceNode.form &node)
              (SurfaceForm.List items) (Result.Success (copy-children items))
              (SurfaceForm.Array items) (Result.Success (copy-children items))
              (SurfaceForm.StaticArray items)
                (Result.Success (copy-children items))
              (SurfaceForm.Symbol _)
                (Result.Error
                  (error-at call
                            @"compile-time operation expected a list or array, got a symbol"))
              (SurfaceForm.IntLit _)
                (Result.Error
                  (error-at call
                            @"compile-time operation expected a list or array, got an Int"))
              (SurfaceForm.StringLit _)
                (Result.Error
                  (error-at call
                            @"compile-time operation expected a list or array, got a String"))
              (SurfaceForm.BoolLit _)
                (Result.Error
                  (error-at call
                            @"compile-time operation expected a list or array, got a Bool"))
              (SurfaceForm.CharLit _)
                (Result.Success [(Box.init (SurfaceNode.copy &node))])
              _
                (Result.Error
                  (error-at call
                            (String.append
                              "compile-time list operation expects a list or array: "
                              &(operation-name call)))))
          (Result.Error error) (Result.Error error))))

  (defn values-from-syntax-items [items]
    (let-do [result (the (Array (Box CtValue)) [])
             n (Array.length items)]
      (for [i 0 n]
        (set! result
              (Array.push-back result
                               (Box.init
                                 (CtValue.Syntax
                                   (Box.init
                                     (SurfaceNode.copy (Box.peek (Array.unsafe-nth items
                                                                                   i)))))))))
      result))

  (doc syntax-value? "whether a compile-time value is still syntax. Syntax is
never applicable, and evaluating it answers with itself.")
  (defn syntax-value? [value] (match-ref value (CtValue.Syntax _) true _ false))

  (defn collection-values [call value]
    (match-ref value
      (CtValue.Collection values) (Result.Success @values)
      _
        (match (syntax-from-value call value)
          (Result.Success node)
            (match-ref (SurfaceNode.form &node)
              (SurfaceForm.List items)
                (Result.Success (values-from-syntax-items items))
              (SurfaceForm.Array items)
                (Result.Success (values-from-syntax-items items))
              (SurfaceForm.StaticArray items)
                (Result.Success (values-from-syntax-items items))
              (SurfaceForm.Symbol _)
                (Result.Error
                  (error-at call
                            @"compile-time operation expected a list or array, got a symbol"))
              (SurfaceForm.IntLit _)
                (Result.Error
                  (error-at call
                            @"compile-time operation expected a list or array, got an Int"))
              (SurfaceForm.StringLit _)
                (Result.Error
                  (error-at call
                            @"compile-time operation expected a list or array, got a String"))
              (SurfaceForm.BoolLit _)
                (Result.Error
                  (error-at call
                            @"compile-time operation expected a list or array, got a Bool"))
              (SurfaceForm.CharLit _)
                (Result.Success
                  [(Box.init
                     (CtValue.Syntax (Box.init (SurfaceNode.copy &node))))])
              _
                (Result.Error
                  (error-at call
                            (String.append
                              "compile-time list operation expects a list or array: "
                              &(operation-name call)))))
          (Result.Error error) (Result.Error error))))

  (private syntax-int)
  (hidden syntax-int)
  (defn syntax-int [call value]
    (CtValue.Syntax
      (Box.init
        (SurfaceNode.init @(SurfaceNode.span call) (SurfaceForm.IntLit value)))))

  (private syntax-bool)
  (hidden syntax-bool)
  (defn syntax-bool [call value]
    (CtValue.Syntax
      (Box.init
        (SurfaceNode.init @(SurfaceNode.span call) (SurfaceForm.BoolLit value)))))

  (private syntax-string)
  (hidden syntax-string)
  (defn syntax-string [call value]
    (CtValue.Syntax
      (Box.init
        (SurfaceNode.init @(SurfaceNode.span call)
                          (SurfaceForm.StringLit (String.copy value))))))

  (private syntax-string-collection)
  (hidden syntax-string-collection)
  (defn syntax-string-collection [call source array?]
    (let-do [items (the (Array (Box SurfaceNode)) [])
             characters (String.chars source)
             n (Array.length &characters)]
      (for [i 0 n]
        (let [piece (String.from-chars &[@(Array.unsafe-nth &characters i)])]
          (Array.push-back! &items
                            (Box.init
                              (SurfaceNode.init @(SurfaceNode.span call)
                                                (SurfaceForm.StringLit piece))))))
      (if array?
        (CtValue.Syntax
          (Box.init
            (SurfaceNode.init @(SurfaceNode.span call) (SurfaceForm.Array items))))
        (CtValue.Syntax
          (Box.init
            (SurfaceNode.init @(SurfaceNode.span call) (SurfaceForm.List items)))))))

  (private syntax-char)
  (hidden syntax-char)
  (defn syntax-char [call value]
    (CtValue.Syntax
      (Box.init
        (SurfaceNode.init @(SurfaceNode.span call) (SurfaceForm.CharLit value)))))

  (private syntax-empty)
  (hidden syntax-empty)
  (defn syntax-empty [call]
    (CtValue.Syntax
      (Box.init
        (SurfaceNode.init @(SurfaceNode.span call) (SurfaceForm.List [])))))

  (private syntax-symbol)
  (hidden syntax-symbol)
  (defn syntax-symbol [call segments]
    (CtValue.Syntax
      (Box.init
        (SurfaceNode.init @(SurfaceNode.span call) (SurfaceForm.Symbol segments)))))

  (private source-line)
  (hidden source-line)
  (defn source-line [node]
    @(Info.line (SurfaceSpan.start (SurfaceNode.span node))))

  (private source-column)
  (hidden source-column)
  (defn source-column [node]
    @(Info.col (SurfaceSpan.start (SurfaceNode.span node))))

  (private concat-symbols)
  (hidden concat-symbols)
  (defn concat-symbols [call value]
    (match (list-items call value)
      (Result.Success items)
        (let-do [result (the (Result String CtError) (Result.Success @""))
                 n (Array.length &items)]
          (for [i 0 n]
            (match-ref &result
              (Result.Success text)
                (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth &items
                                                                         i)))
                  (SurfaceForm.Symbol parts)
                    (let [part (String.join "." parts)]
                      (set! result (Result.Success (String.append text &part))))
                  _
                    (set! result
                          (Result.Error
                            (error-at call @"Symbol.concat expects symbols"))))
              (Result.Error error) (set! result (Result.Error @error))))
          (match result
            (Result.Success text) (Result.Success (syntax-symbol call [text]))
            (Result.Error error) (Result.Error error)))
      (Result.Error error) (Result.Error error)))

  (private prefix-symbols)
  (hidden prefix-symbols)
  (defn prefix-symbols [call left right]
    (match (syntax-from-value call left)
      (Result.Success left-node)
        (match (syntax-from-value call right)
          (Result.Success right-node)
            (match-ref (SurfaceNode.form &left-node)
              (SurfaceForm.Symbol left-parts)
                (match-ref (SurfaceNode.form &right-node)
                  (SurfaceForm.Symbol right-parts)
                    (let-do [segments (Array.copy left-parts)
                             n (Array.length right-parts)]
                      (for [i 0 n]
                        (set! segments
                              (Array.push-back segments
                                               @(Array.unsafe-nth right-parts i))))
                      (Result.Success (syntax-symbol call segments)))
                  _
                    (Result.Error
                      (error-at call @"Symbol.prefix expects symbols")))
              _ (Result.Error (error-at call @"Symbol.prefix expects symbols")))
          (Result.Error error) (Result.Error error))
      (Result.Error error) (Result.Error error)))

  (private int-argument)
  (hidden int-argument)
  (defn int-argument [call value]
    (match (syntax-from-value call value)
      (Result.Success node)
        (match-ref (SurfaceNode.form &node)
          (SurfaceForm.IntLit integer) (Result.Success @integer)
          _
            (Result.Error
              (error-at call @"compile-time operation expects Int syntax")))
      (Result.Error error) (Result.Error error)))

  (private number-from-node)
  (hidden number-from-node)
  (defn number-from-node [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.IntLit value) (Maybe.Just (Double.from-int @value))
      (SurfaceForm.ByteLit value)
        (Maybe.Just (Double.from-int (Byte.to-int @value)))
      (SurfaceForm.LongLit value) (Maybe.Just (Double.from-long @value))
      (SurfaceForm.FloatLit value) (Maybe.Just (Double.from-float @value))
      (SurfaceForm.DoubleLit value) (Maybe.Just @value)
      _ (Maybe.Nothing)))

  (private number-argument)
  (hidden number-argument)
  (defn number-argument [call value]
    (match (syntax-from-value call value)
      (Result.Success node)
        (match (number-from-node &node)
          (Maybe.Just number) (Result.Success number)
          (Maybe.Nothing)
            (Result.Error
              (error-at call @"compile-time operation expects numeric syntax")))
      (Result.Error error) (Result.Error error)))

  ;; the reference evaluator's numbers are two-domain (Integral or Floating)
  ;; with a type tag, and arithmetic promotes the tag through the ladder
  ;; Byte < Int < Long < Float < Double (Types.hs promoteNumber): the widths
  ;; below follow that order, so promotion is a max and a width of Float or
  ;; wider means the value lives in the floating domain, exactly like the
  ;; reference's Num instance on Number (Obj.hs).
  (private ct-number-from-node)
  (hidden ct-number-from-node)
  (defn ct-number-from-node [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.ByteLit value)
        (Maybe.Just (CtNumber.init 0 (Long.from-int (Byte.to-int @value)) 0.0))
      (SurfaceForm.IntLit value)
        (Maybe.Just (CtNumber.init 1 (Long.from-int @value) 0.0))
      (SurfaceForm.LongLit value) (Maybe.Just (CtNumber.init 2 @value 0.0))
      (SurfaceForm.FloatLit value)
        (Maybe.Just (CtNumber.init 3 0l (Double.from-float @value)))
      (SurfaceForm.DoubleLit value) (Maybe.Just (CtNumber.init 4 0l @value))
      _ (Maybe.Nothing)))

  (private ct-number-argument)
  (hidden ct-number-argument)
  (defn ct-number-argument [call value]
    (match (syntax-from-value call value)
      (Result.Success node)
        (match (ct-number-from-node &node)
          (Maybe.Just number) (Result.Success number)
          (Maybe.Nothing)
            (Result.Error
              (error-at call @"compile-time operation expects numeric syntax")))
      (Result.Error error) (Result.Error error)))

  (private ct-number-double)
  (hidden ct-number-double)
  (defn ct-number-double [number]
    (if (Int.>= @(CtNumber.width number) 3)
      @(CtNumber.floating number)
      (Double.from-long @(CtNumber.integral number))))

  (private syntax-number)
  (hidden syntax-number)
  (doc syntax-number "renders a computed number back to the literal its
promoted width dictates, so an expansion carries the type the reference
would give it.")
  (defn syntax-number [call number]
    (let [width @(CtNumber.width number)]
      (CtValue.Syntax
        (Box.init
          (SurfaceNode.init @(SurfaceNode.span call)
                            (cond
                              (Int.= width 0)
                                (SurfaceForm.ByteLit
                                  (Byte.from-int
                                    (Long.to-int @(CtNumber.integral number))))
                              (Int.= width 1)
                                (SurfaceForm.IntLit
                                  (Long.to-int @(CtNumber.integral number)))
                              (Int.= width 2)
                                (SurfaceForm.LongLit @(CtNumber.integral number))
                              (Int.= width 3)
                                (SurfaceForm.FloatLit
                                  (Double.to-float @(CtNumber.floating number)))
                              (SurfaceForm.DoubleLit @(CtNumber.floating number))))))))

  (private ct-arith)
  (hidden ct-arith)
  (doc ct-arith "adds, subtracts, or multiplies two numbers (operation 0, 1,
and 2) the way the reference's commandArith does: the result width is the
promoted one, and any floating operand moves the operation to the floating
domain.")
  (defn ct-arith [call operation left right]
    (match (ct-number-argument call left)
      (Result.Success a)
        (match (ct-number-argument call right)
          (Result.Success b)
            (let [width (Int.max @(CtNumber.width &a) @(CtNumber.width &b))]
              (Result.Success
                (syntax-number call
                               &(if (Int.>= width 3)
                                 (let [da (ct-number-double &a)
                                       db (ct-number-double &b)]
                                   (CtNumber.init width
                                                  0l
                                                  (cond
                                                    (Int.= operation 0)
                                                      (Double.+ da db)
                                                    (Int.= operation 1)
                                                      (Double.- da db)
                                                    (Double.* da db))))
                                 (let [ia @(CtNumber.integral &a)
                                       ib @(CtNumber.integral &b)]
                                   (CtNumber.init width
                                                  (cond
                                                    (Int.= operation 0)
                                                      (Long.+ ia ib)
                                                    (Int.= operation 1)
                                                      (Long.- ia ib)
                                                    (Long.* ia ib))
                                                  0.0))))))
          (Result.Error error) (Result.Error error))
      (Result.Error error) (Result.Error error)))

  (private ct-divide)
  (hidden ct-divide)
  (doc ct-divide "divides like the reference's commandDiv: two integral
operands use floor division (Haskell `div`, which Core's dynamic `imod`
depends on), anything floating divides in the floating domain.")
  (defn ct-divide [call left right]
    (match (ct-number-argument call left)
      (Result.Success a)
        (match (ct-number-argument call right)
          (Result.Success b)
            (let [width (Int.max @(CtNumber.width &a) @(CtNumber.width &b))]
              (if (Int.>= width 3)
                (Result.Success
                  (syntax-number call
                                 &(CtNumber.init width
                                                 0l
                                                 (Double./ (ct-number-double &a)
                                                           (ct-number-double &b)))))
                (let [ia @(CtNumber.integral &a)
                      ib @(CtNumber.integral &b)]
                  (if (Long.= 0l ib)
                    (Result.Error
                      (error-at call @"compile-time division by zero"))
                    (let [quotient (Long./ ia ib)
                          remainder (Long.mod ia ib)
                          floored (if (and (not (Long.= 0l remainder))
                                           (not (Bool.= (Long.< ia 0l)
                                                        (Long.< ib 0l))))
                            (Long.dec quotient)
                            quotient)]
                      (Result.Success
                        (syntax-number call &(CtNumber.init width floored 0.0))))))))
          (Result.Error error) (Result.Error error))
      (Result.Error error) (Result.Error error)))

  (private symbol-from-value)
  (hidden symbol-from-value)
  (defn symbol-from-value [call value]
    (match (syntax-from-value call value)
      (Result.Success node)
        (match-ref (SurfaceNode.form &node)
          (SurfaceForm.IntLit integer)
            (Result.Success (syntax-symbol call [(Int.str @integer)]))
          (SurfaceForm.StringLit string)
            (Result.Success (syntax-symbol call [@string]))
          _
            (Result.Error
              (error-at call @"Symbol.from expects Int or String syntax")))
      (Result.Error error) (Result.Error error)))

  (private bool-argument)
  (hidden bool-argument)
  (defn bool-argument [call value]
    (match (syntax-from-value call value)
      (Result.Success node)
        (match-ref (SurfaceNode.form &node)
          (SurfaceForm.BoolLit boolean) (Result.Success @boolean)
          _
            (Result.Error
              (error-at call @"compile-time operation expects Bool syntax")))
      (Result.Error error) (Result.Error error)))

  (private dynamic-type)
  (hidden dynamic-type)
  (defn dynamic-type [call value]
    (match-ref value
      (CtValue.Closure _) (Result.Success (syntax-symbol call [@"closure"]))
      (CtValue.Builtin _) (Result.Success (syntax-symbol call [@"fn"]))
      (CtValue.Collection _) (Result.Success (syntax-symbol call [@"array"]))
      (CtValue.Syntax syntax)
        (match-ref (SurfaceNode.form (Box.peek syntax))
          (SurfaceForm.IntLit _) (Result.Success (syntax-symbol call [@"int"]))
          (SurfaceForm.ByteLit _)
            (Result.Success (syntax-symbol call [@"byte"]))
          (SurfaceForm.LongLit _)
            (Result.Success (syntax-symbol call [@"long"]))
          (SurfaceForm.FloatLit _)
            (Result.Success (syntax-symbol call [@"float"]))
          (SurfaceForm.DoubleLit _)
            (Result.Success (syntax-symbol call [@"double"]))
          (SurfaceForm.BoolLit _)
            (Result.Success (syntax-symbol call [@"bool"]))
          (SurfaceForm.CharLit _)
            (Result.Success (syntax-symbol call [@"char"]))
          (SurfaceForm.StringLit _)
            (Result.Success (syntax-symbol call [@"string"]))
          (SurfaceForm.Symbol _)
            (Result.Success (syntax-symbol call [@"symbol"]))
          (SurfaceForm.List _) (Result.Success (syntax-symbol call [@"list"]))
          (SurfaceForm.Array _) (Result.Success (syntax-symbol call [@"array"]))
          (SurfaceForm.StaticArray _)
            (Result.Success (syntax-symbol call [@"array"]))
          (SurfaceForm.Dictionary _)
            (Result.Success (syntax-symbol call [@"array"]))
          (SurfaceForm.Comment _)
            (Result.Success (syntax-symbol call [@"comment"]))
          (SurfaceForm.PatternLit _)
            (Result.Success (syntax-symbol call [@"pattern"])))))

  (private value-at)
  (hidden value-at)
  (defn value-at [call values index]
    (if (and (Int.>= index 0) (Int.< index (Array.length values)))
      (Result.Success (CtValue.copy (Box.peek (Array.unsafe-nth values index))))
      (Result.Error
        (error-at call @"compile-time operation received too few arguments"))))

  (private source-position-node)
  (hidden source-position-node)
  (defn source-position-node [call values]
    (if (Int.= 0 (Array.length values))
      (Result.Success (SurfaceNode.copy call))
      (match (value-at call values 0)
        (Result.Success value) (syntax-from-value call &value)
        (Result.Error error) (Result.Error error))))

  (private symbol-node)
  (hidden symbol-node)
  (defn symbol-node [anchor name]
    (SurfaceNode.init @(SurfaceNode.span anchor)
                      (SurfaceForm.Symbol [(String.copy name)])))

  (private call-node)
  (hidden call-node)
  (private call-node-with-head)
  (hidden call-node-with-head)
  (defn call-node [anchor head arguments]
    (let-do [items [(Box.init (symbol-node anchor head))]
             n (Array.length arguments)]
      (for [i 0 n]
        (Array.push-back! &items
                          (Box.init
                            (SurfaceNode.copy
                              (Box.peek (Array.unsafe-nth arguments i))))))
      (SurfaceNode.init @(SurfaceNode.span anchor) (SurfaceForm.List items))))

  (defn call-node-with-head [anchor head arguments]
    (let-do [items [(Box.init (SurfaceNode.copy head))]
             n (Array.length arguments)]
      (for [i 0 n]
        (Array.push-back! &items
                          (Box.init
                            (SurfaceNode.copy
                              (Box.peek (Array.unsafe-nth arguments i))))))
      (SurfaceNode.init @(SurfaceNode.span anchor) (SurfaceForm.List items))))

  (private ref-node)
  (hidden ref-node)
  (defn ref-node [anchor value]
    (call-node anchor "ref" &[(Box.init (SurfaceNode.copy value))]))

  (private set-ref-node)
  (hidden set-ref-node)
  (defn set-ref-node [anchor name value]
    (call-node anchor
               "set!"
               &[(Box.init (SurfaceNode.copy name))
                 (Box.init (ref-node anchor value))]))

  (private list-with-items)
  (hidden list-with-items)
  (private list-or-collection)
  (hidden list-or-collection)
  (private collection-like)
  (hidden collection-like)
  (defn list-with-items [call items]
    (CtValue.Syntax
      (Box.init
        (SurfaceNode.init @(SurfaceNode.span call) (SurfaceForm.List items)))))

  (defn list-or-collection [call values]
    (match (syntax-arguments call values)
      (Result.Success items) (list-with-items call items)
      (Result.Error _) (CtValue.Collection @values)))

  (defn collection-like [call prototype values]
    (match-ref prototype
      (CtValue.Collection _) (CtValue.Collection @values)
      (CtValue.Syntax syntax)
        (match-ref (SurfaceNode.form (Box.peek syntax))
          (SurfaceForm.Array _)
            (match (syntax-arguments call values)
              (Result.Success items)
                (CtValue.Syntax
                  (Box.init
                    (SurfaceNode.init @(SurfaceNode.span call)
                                      (SurfaceForm.Array items))))
              (Result.Error _) (CtValue.Collection @values))
          (SurfaceForm.StaticArray _)
            (match (syntax-arguments call values)
              (Result.Success items)
                (CtValue.Syntax
                  (Box.init
                    (SurfaceNode.init @(SurfaceNode.span call)
                                      (SurfaceForm.StaticArray items))))
              (Result.Error _) (CtValue.Collection @values))
          _ (list-or-collection call values))
      _ (list-or-collection call values)))

  (private syntax-equal?)
  (private syntax-items-equal?)
  (hidden syntax-items-equal?)
  (sig syntax-equal? (Fn [(Ref SurfaceNode) (Ref SurfaceNode)] Bool))
  (sig syntax-items-equal?
       (Fn
         [(Ref (Array (Box SurfaceNode))) (Ref (Array (Box SurfaceNode)))]
         Bool))
  (hidden syntax-equal?)
  (defn syntax-equal? [left right]
    (match (number-from-node left)
      (Maybe.Just left-number)
        (match (number-from-node right)
          (Maybe.Just right-number) (Double.= left-number right-number)
          (Maybe.Nothing) false)
      (Maybe.Nothing)
        (match-ref (SurfaceNode.form left)
          (SurfaceForm.BoolLit left-value)
          (match-ref (SurfaceNode.form right)
            (SurfaceForm.BoolLit right-value) (Bool.= @left-value @right-value)
            _ false)
          (SurfaceForm.StringLit left-value)
          (match-ref (SurfaceNode.form right)
            (SurfaceForm.StringLit right-value)
              (String.= left-value right-value)
            (SurfaceForm.CharLit right-value)
              (and (Int.= (String.length left-value) 1)
                   (Char.= (String.char-at left-value 0) @right-value))
            _ false)
          (SurfaceForm.CharLit left-value)
          (match-ref (SurfaceNode.form right)
            (SurfaceForm.CharLit right-value) (Char.= @left-value @right-value)
            (SurfaceForm.StringLit right-value)
              (and (Int.= (String.length right-value) 1)
                   (Char.= @left-value (String.char-at right-value 0)))
            _ false)
          (SurfaceForm.Symbol left-segments)
          (match-ref (SurfaceNode.form right)
            (SurfaceForm.Symbol right-segments) (= left-segments right-segments)
            _ false)
          ;; lists and arrays compare structurally, element by element (see
          ;; syntax-items-equal? below); without this `(= value '())` (i.e.
          ;; `nil?`) is never true and dynamic list recursion cannot terminate.
          (SurfaceForm.List left-items)
          (match-ref (SurfaceNode.form right)
            (SurfaceForm.List right-items)
              (syntax-items-equal? left-items right-items)
            _ false)
          (SurfaceForm.Array left-items)
          (match-ref (SurfaceNode.form right)
            (SurfaceForm.Array right-items)
              (syntax-items-equal? left-items right-items)
            _ false)
          _
          false)))

  (defn syntax-items-equal? [left-raw right-raw]
    (let-do [left (semantic-items left-raw)
             right (semantic-items right-raw)
             n (Array.length &left)
             same (Int.= n (Array.length &right))]
      (when same
        (for [i 0 n]
          (unless (syntax-equal? (Box.peek (Array.unsafe-nth &left i))
                                 (Box.peek (Array.unsafe-nth &right i)))
            (set! same false))))
      same))

  (private list-item)
  (hidden list-item)
  (defn list-item [call value index]
    (let [items-result (collection-values call value)]
      (match-ref &items-result
        (Result.Success items)
          (if (and (Int.>= index 0) (Int.< index (Array.length items)))
            (Result.Success
              (CtValue.copy (Box.peek (Array.unsafe-nth items index))))
            (Result.Error
              (error-at call @"compile-time list index is out of bounds")))
        (Result.Error error) (Result.Error @error))))

  (private list-tail)
  (hidden list-tail)
  (defn list-tail [call value start]
    (let [items-result (collection-values call value)]
      (match-ref &items-result
        (Result.Success items)
          (let-do [result (the (Array (Box CtValue)) [])
                   n (Array.length items)]
            (for [i start n]
              (set! result
                    (Array.push-back result
                                     (Box.init
                                       (CtValue.copy (Box.peek (Array.unsafe-nth items
                                                                                 i)))))))
            (Result.Success (list-or-collection call &result)))
        (Result.Error error) (Result.Error @error))))

  (private list-prefix)
  (hidden list-prefix)
  (defn list-prefix [call value end]
    (let [items-result (collection-values call value)]
      (match-ref &items-result
        (Result.Success items)
          (let-do [result (the (Array (Box CtValue)) [])]
            (for [i 0 end]
              (set! result
                    (Array.push-back result
                                     (Box.init
                                       (CtValue.copy (Box.peek (Array.unsafe-nth items
                                                                                 i)))))))
            (Result.Success (list-or-collection call &result)))
        (Result.Error error) (Result.Error @error))))

  (private string-argument)
  (hidden string-argument)
  (defn string-argument [call value]
    (match (syntax-from-value call value)
      (Result.Success node)
        (match-ref (SurfaceNode.form &node)
          (SurfaceForm.StringLit string) (Result.Success @string)
          _
            (Result.Error
              (error-at call @"compile-time operation expects String syntax")))
      (Result.Error error) (Result.Error error)))

  (private concat-strings)
  (hidden concat-strings)
  (defn concat-strings [call value]
    (match (collection-values call value)
      (Result.Success values)
        (let-do [parts (the (Result (Array String) CtError) (Result.Success []))
                 n (Array.length &values)]
          (for [i 0 n]
            (match-ref &parts
              (Result.Success strings)
                (match (string-argument call
                                        (Box.peek (Array.unsafe-nth &values i)))
                  (Result.Success string)
                    (set! parts
                          (Result.Success (Array.push-back @strings string)))
                  (Result.Error error) (set! parts (Result.Error error)))
              (Result.Error error) (set! parts (Result.Error @error))))
          (match parts
            (Result.Success strings)
              (let [joined (String.concat &strings)]
                (Result.Success (syntax-string call &joined)))
            (Result.Error error) (Result.Error error)))
      (Result.Error error) (Result.Error error)))

  (private char-argument)
  (hidden char-argument)
  (defn char-argument [call value]
    (match (syntax-from-value call value)
      (Result.Success node)
        (match-ref (SurfaceNode.form &node)
          (SurfaceForm.CharLit character) (Result.Success @character)
          _
            (Result.Error
              (error-at call @"compile-time operation expects Char syntax")))
      (Result.Error error) (Result.Error error)))

  (private apply-builtin)
  (hidden apply-builtin)
  (defn apply-builtin [call id values]
    (cond
      (Int.= id 0)
      (let-do [items (the (Array (Box CtValue)) [])
               n (Array.length &*ct-load-stack*)]
        (for [i 0 n]
          (Array.push-back! &items
                            (Box.init
                              (CtValue.Syntax
                                (Box.init
                                  (SurfaceNode.init @(SurfaceNode.span call)
                                                    (SurfaceForm.StringLit
                                                      @(Array.unsafe-nth &*ct-load-stack*
                                                                         (Int.- (Int.dec n)
                                                                                i)))))))))
        (Maybe.Just (Result.Success (CtValue.Collection items))))
      (Int.= id 1)
      (Maybe.Just (Result.Success (list-or-collection call values)))
      (Int.= id 2)
      (match (syntax-arguments call values)
        (Result.Success items)
          (Maybe.Just
            (Result.Success
              (CtValue.Syntax
                (Box.init
                  (SurfaceNode.init @(SurfaceNode.span call)
                                    (SurfaceForm.Array items))))))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (Int.= id 3)
      (match (value-at call values 0)
        (Result.Success value) (Maybe.Just (symbol-from-value call &value))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (Int.= id 4)
      (match (value-at call values 0)
        (Result.Success value) (Maybe.Just (concat-symbols call &value))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (Int.= id 5)
      (match (value-at call values 0)
        (Result.Success left)
          (match (value-at call values 1)
            (Result.Success right)
              (Maybe.Just (prefix-symbols call &left &right))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (or (Int.= id 6) (Int.= id 7))
      (match (value-at call values 0)
        (Result.Success value) (Maybe.Just (list-item call &value 0))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (or (Int.= id 8) (Int.= id 9))
      (match (value-at call values 0)
        (Result.Success value) (Maybe.Just (list-tail call &value 1))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (or (Int.= id 10) (Int.= id 11))
      (match (value-at call values 0)
        (Result.Success value) (Maybe.Just (list-item call &value 1))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (or (Int.= id 12) (Int.= id 13))
      (match (value-at call values 0)
        (Result.Success value) (Maybe.Just (list-item call &value 2))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (or (Int.= id 14) (Int.= id 15))
      (match (value-at call values 0)
        (Result.Success value) (Maybe.Just (list-item call &value 3))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (or (Int.= id 16) (Int.= id 17))
      (match (value-at call values 0)
        (Result.Success value) (Maybe.Just (list-tail call &value 2))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (or (Int.= id 18) (Int.= id 19))
      (match (value-at call values 0)
        (Result.Success value)
          (match (list-item call &value 1)
            (Result.Success nested) (Maybe.Just (list-item call &nested 0))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (or (Int.= id 20) (Int.= id 21))
      (match (value-at call values 0)
        (Result.Success value)
          (match (list-item call &value 1)
            (Result.Success nested) (Maybe.Just (list-tail call &nested 1))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (or (Int.= id 22) (Int.= id 23))
      (match (value-at call values 0)
        (Result.Success value)
          (let [items-result (collection-values call &value)]
            (match-ref &items-result
              (Result.Success items)
                (Maybe.Just
                  (list-item call &value (Int.dec (Array.length items))))
              (Result.Error error) (Maybe.Just (Result.Error @error))))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (or (Int.= id 24) (Int.= id 25))
      (match (value-at call values 0)
        (Result.Success value)
          (let [items-result (collection-values call &value)]
            (match-ref &items-result
              (Result.Success items)
                (Maybe.Just
                  (list-prefix call &value (Int.dec (Array.length items))))
              (Result.Error error) (Maybe.Just (Result.Error @error))))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (or (Int.= id 26) (Int.= id 27))
      (match (value-at call values 0)
        (Result.Success first)
          (match (value-at call values 1)
            (Result.Success rest)
              (let [items-result (collection-values call &rest)]
                (match-ref &items-result
                  (Result.Success rest-items)
                    (Maybe.Just
                      (Result.Success
                        (let [combined (append-values [(Box.init first)]
                                                      rest-items)]
                          (list-or-collection call &combined))))
                  (Result.Error error) (Maybe.Just (Result.Error @error))))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (or (Int.= id 28) (Int.= id 29))
      (match (value-at call values 0)
        (Result.Success last-value)
          (match (value-at call values 1)
            (Result.Success initial)
              (let [items-result (collection-values call &initial)]
                (match-ref &items-result
                  (Result.Success initial-items)
                    (Maybe.Just
                      (Result.Success
                        (let [combined (Array.push-back @initial-items
                                                        (Box.init last-value))]
                          (list-or-collection call &combined))))
                  (Result.Error error) (Maybe.Just (Result.Error @error))))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (or (Int.= id 30) (Int.= id 31))
      (match (value-at call values 0)
        (Result.Success left)
          (match (value-at call values 1)
            (Result.Success right)
              (let [left-result (collection-values call &left)
                    right-result (collection-values call &right)]
                (match-ref &left-result
                  (Result.Success left-items)
                    (match-ref &right-result
                      (Result.Success right-items)
                        (Maybe.Just
                          (Result.Success
                            (let [combined (append-values @left-items
                                                          right-items)]
                              (collection-like call &left &combined))))
                      (Result.Error error) (Maybe.Just (Result.Error @error)))
                  (Result.Error error) (Maybe.Just (Result.Error @error))))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (or (Int.= id 32) (Int.= id 33))
      (match (value-at call values 0)
        (Result.Success value)
          (let [items-result (collection-values call &value)]
            (match-ref &items-result
              (Result.Success items)
                (Maybe.Just
                  (Result.Success (syntax-int call (Array.length items))))
              (Result.Error error) (Maybe.Just (Result.Error @error))))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (or (Int.= id 34) (Int.= id 35))
      (match (value-at call values 0)
        (Result.Success value)
          (let [items-result (collection-values call &value)]
            (match-ref &items-result
              (Result.Success items)
                (Maybe.Just
                  (Result.Success
                    (syntax-bool call (Int.= 0 (Array.length items)))))
              (Result.Error error) (Maybe.Just (Result.Error @error))))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (or (Int.= id 36) (Int.= id 37))
      (match (value-at call values 0)
        (Result.Success value)
          (match (syntax-from-value call &value)
            (Result.Success node)
              (match-ref (SurfaceNode.form &node)
                (SurfaceForm.List _)
                  (Maybe.Just (Result.Success (syntax-bool call true)))
                _ (Maybe.Just (Result.Success (syntax-bool call false))))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (or (Int.= id 38) (Int.= id 39))
      (match (value-at call values 0)
        (Result.Success value)
          (match (syntax-from-value call &value)
            (Result.Success node)
              (match-ref (SurfaceNode.form &node)
                (SurfaceForm.Array _)
                  (Maybe.Just (Result.Success (syntax-bool call true)))
                _ (Maybe.Just (Result.Success (syntax-bool call false))))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (Int.= id 40)
      (match (value-at call values 0)
        (Result.Success value)
          (match (bool-argument call &value)
            (Result.Success boolean)
              (Maybe.Just (Result.Success (syntax-bool call (not boolean))))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (Int.= id 41)
      (match (value-at call values 0)
        (Result.Success value) (Maybe.Just (dynamic-type call &value))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (or (Int.= id 42) (Int.= id 43))
      (match (value-at call values 0)
        (Result.Success left)
          (match (value-at call values 1)
            (Result.Success right)
              (match (syntax-from-value call &left)
                (Result.Success left-node)
                  (match (syntax-from-value call &right)
                    (Result.Success right-node)
                      (Maybe.Just
                        (Result.Success
                          (syntax-bool call
                                       (syntax-equal? &left-node &right-node))))
                    (Result.Error error) (Maybe.Just (Result.Error error)))
                (Result.Error error) (Maybe.Just (Result.Error error)))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      ;; `mod`, `imod`, `neg`, `inc`, and `dec` are deliberately NOT builtins:
      ;; the reference defines them as Core dynamic functions (Dynamic.carp)
      ;; on top of these four commands, and a builtin here would shadow the
      ;; real definitions (builtins win over same-named definitions, like the
      ;; reference's command dispatch).
      (Int.= id 44)
      (match (value-at call values 0)
        (Result.Success left)
          (match (value-at call values 1)
            (Result.Success right) (Maybe.Just (ct-arith call 0 &left &right))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (Int.= id 45)
      (match (value-at call values 0)
        (Result.Success left)
          (match (value-at call values 1)
            (Result.Success right) (Maybe.Just (ct-arith call 1 &left &right))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (Int.= id 46)
      (match (value-at call values 0)
        (Result.Success left)
          (match (value-at call values 1)
            (Result.Success right) (Maybe.Just (ct-arith call 2 &left &right))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (Int.= id 47)
      (match (value-at call values 0)
        (Result.Success left)
          (match (value-at call values 1)
            (Result.Success right) (Maybe.Just (ct-divide call &left &right))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (Int.= id 48)
      (match (value-at call values 0)
        (Result.Success value)
          (match (syntax-from-value call &value)
            (Result.Success node)
              (match (ct-number-from-node &node)
                (Maybe.Just number)
                ;; an integral number rounds to itself, width and all; a
                ;; floating one rounds half-to-even to Int, both like the
                ;; reference (Haskell `round`, commandRound).
                (if (Int.< @(CtNumber.width &number) 3)
                  (Maybe.Just (Result.Success (CtValue.Syntax (Box.init node))))
                  (let-do [x @(CtNumber.floating &number)
                           floored (Double.floor x)
                           difference (Double.- x floored)
                           base (Double.to-int floored)]
                    (Maybe.Just
                      (Result.Success
                        (syntax-int call
                                    (cond
                                      (Double.< difference 0.5) base
                                      (Double.> difference 0.5) (Int.inc base)
                                      (Int.= 0 (Int.mod base 2)) base
                                      (Int.inc base)))))))
                (Maybe.Nothing)
                (Maybe.Just
                  (Result.Error
                    (error-at call
                              @"compile-time operation expects numeric syntax"))))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (Int.= id 49)
      (match (value-at call values 0)
        (Result.Success left)
          (match (value-at call values 1)
            (Result.Success right)
              (match (number-argument call &left)
                (Result.Success left-number)
                  (match (number-argument call &right)
                    (Result.Success right-number)
                      (Maybe.Just
                        (Result.Success
                          (syntax-bool call (Double.> left-number right-number))))
                    (Result.Error error) (Maybe.Just (Result.Error error)))
                (Result.Error error) (Maybe.Just (Result.Error error)))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (Int.= id 50)
      (match (value-at call values 0)
        (Result.Success left)
          (match (value-at call values 1)
            (Result.Success right)
              (match (number-argument call &left)
                (Result.Success left-number)
                  (match (number-argument call &right)
                    (Result.Success right-number)
                      (Maybe.Just
                        (Result.Success
                          (syntax-bool call (Double.< left-number right-number))))
                    (Result.Error error) (Maybe.Just (Result.Error error)))
                (Result.Error error) (Maybe.Just (Result.Error error)))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (Int.= id 51)
      (match (value-at call values 0)
        (Result.Success value)
          (match (string-argument call &value)
            (Result.Success source)
              (let [characters (String.chars &source)]
                (Maybe.Just
                  (Result.Success (syntax-int call (Array.length &characters)))))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (Int.= id 52)
      (match (value-at call values 0)
        (Result.Success source-value)
          (match (value-at call values 1)
            (Result.Success char-value)
              (match (string-argument call &source-value)
                (Result.Success source)
                  (match (char-argument call &char-value)
                    (Result.Success character)
                      (let-do [characters (String.chars &source)
                               index -1
                               n (Array.length &characters)]
                        (for [i 0 n]
                          (when (and (Int.= index -1)
                                     (Char.= @(Array.unsafe-nth &characters i)
                                             character))
                            (set! index i)))
                        (Maybe.Just (Result.Success (syntax-int call index))))
                    (Result.Error error) (Maybe.Just (Result.Error error)))
                (Result.Error error) (Maybe.Just (Result.Error error)))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (Int.= id 53)
      (match (value-at call values 0)
        (Result.Success source-value)
          (match (value-at call values 1)
            (Result.Success index-value)
              (match (string-argument call &source-value)
                (Result.Success source)
                  (match (int-argument call &index-value)
                    (Result.Success index)
                      (let [characters (String.chars &source)]
                        ;; bounds-checked like the reference command
                        ;; (Commands.hs commandCharAt), in Unicode character
                        ;; indices rather than UTF-8 byte offsets.
                        (if (or (Int.< index 0)
                                (Int.>= index (Array.length &characters)))
                          (Maybe.Just
                            (Result.Error
                              (error-at call
                                        (String.concat
                                          &[@"Can't call char-at with \""
                                            (String.copy &source)
                                            @"\" and "
                                            (Int.str index)
                                            @", index too large"]))))
                          (Maybe.Just
                            (Result.Success
                              (syntax-char call
                                           @(Array.unsafe-nth &characters index))))))
                    (Result.Error error) (Maybe.Just (Result.Error error)))
                (Result.Error error) (Maybe.Just (Result.Error error)))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (Int.= id 54)
      (match (value-at call values 0)
        (Result.Success source-value)
          (match (value-at call values 1)
            (Result.Success start-value)
              (match (value-at call values 2)
                (Result.Success end-value)
                  (match (string-argument call &source-value)
                    (Result.Success source)
                      (match (int-argument call &start-value)
                        (Result.Success start)
                          (match (int-argument call &end-value)
                            (Result.Success end)
                              (if (Int.> start end)
                                (Maybe.Just
                                  (Result.Error
                                    (error-at call
                                              @"String.slice stop index must not precede start")))
                                (let [characters (String.chars &source)
                                      count (Array.length &characters)
                                      lo (Int.max 0 start)
                                      hi (Int.min count end)
                                      slice (if (Int.>= lo hi)
                                        @""
                                        (String.from-chars &(Array.slice &characters
                                                                         lo
                                                                         hi)))]
                                  (Maybe.Just
                                    (Result.Success (syntax-string call &slice)))))
                            (Result.Error error)
                              (Maybe.Just (Result.Error error)))
                        (Result.Error error) (Maybe.Just (Result.Error error)))
                    (Result.Error error) (Maybe.Just (Result.Error error)))
                (Result.Error error) (Maybe.Just (Result.Error error)))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (Int.= id 55)
      (match (value-at call values 0)
        (Result.Success source-value)
          (match (value-at call values 1)
            (Result.Success end-value)
              (match (string-argument call &source-value)
                (Result.Success source)
                  (match (int-argument call &end-value)
                    (Result.Success end)
                      (let [prefix (String.prefix &source end)]
                        (Maybe.Just
                          (Result.Success (syntax-string call &prefix))))
                    (Result.Error error) (Maybe.Just (Result.Error error)))
                (Result.Error error) (Maybe.Just (Result.Error error)))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (Int.= id 56)
      (match (value-at call values 0)
        (Result.Success source-value)
          (match (value-at call values 1)
            (Result.Success start-value)
              (match (string-argument call &source-value)
                (Result.Success source)
                  (match (int-argument call &start-value)
                    (Result.Success start)
                      (let [suffix (String.suffix &source start)]
                        (Maybe.Just
                          (Result.Success (syntax-string call &suffix))))
                    (Result.Error error) (Maybe.Just (Result.Error error)))
                (Result.Error error) (Maybe.Just (Result.Error error)))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (Int.= id 57)
      (match (value-at call values 0)
        (Result.Success value)
          (match (string-argument call &value)
            (Result.Success source)
              (Maybe.Just
                ;; Compile-time String commands follow the reference
                ;; evaluator's dynamic API, where `String.head` returns a
                ;; one-character String. The runtime/static Core function
                ;; returns Char, but leaking that type here breaks macros
                ;; which immediately compose the result with String.concat.
                (Result.Success (syntax-string call &(String.slice &source 0 1))))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (Int.= id 58)
      (match (value-at call values 0)
        (Result.Success value)
          (match (string-argument call &value)
            (Result.Success source)
              (let [tail (String.tail &source)]
                (Maybe.Just (Result.Success (syntax-string call &tail))))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (Int.= id 59)
      (match (value-at call values 0)
        (Result.Success value)
          (match (string-argument call &value)
            (Result.Success source)
              (Maybe.Just
                (Result.Success (syntax-bool call (String.empty? &source))))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (or (Int.= id 60) (Int.= id 61))
      (match (value-at call values 0)
        (Result.Success value)
          (match (string-argument call &value)
            (Result.Success source)
              (Maybe.Just
                (Result.Success (syntax-string-collection call &source false)))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (or (Int.= id 62) (Int.= id 63))
      (match (value-at call values 0)
        (Result.Success value)
          (match (string-argument call &value)
            (Result.Success source)
              (Maybe.Just
                (Result.Success (syntax-string-collection call &source true)))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (Int.= id 64)
      (match (value-at call values 0)
        (Result.Success left-value)
          (match (value-at call values 1)
            (Result.Success right-value)
              (match (string-argument call &left-value)
                (Result.Success left)
                  (match (string-argument call &right-value)
                    (Result.Success right)
                      (let [appended (String.append &left &right)]
                        (Maybe.Just
                          (Result.Success (syntax-string call &appended))))
                    (Result.Error error) (Maybe.Just (Result.Error error)))
                (Result.Error error) (Maybe.Just (Result.Error error)))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (or (Int.= id 65) (Int.= id 66))
      (match (value-at call values 0)
        (Result.Success value) (Maybe.Just (concat-strings call &value))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (Int.= id 67)
      (match (value-at call values 0)
        (Result.Success value)
          (match (string-argument call &value)
            (Result.Success source)
              (match (Surface.parse &source)
                (Result.Success module)
                  (let [forms (SurfaceModule.forms &module)]
                    (if (Int.= (Array.length forms) 1)
                      (Maybe.Just
                        (Result.Success
                          (CtValue.Syntax
                            (Box.init
                              (SurfaceNode.copy (Box.peek (Array.unsafe-nth forms
                                                                            0)))))))
                      (Maybe.Just
                        (Result.Error
                          (error-at call @"parse expects exactly one form")))))
                (Result.Error message)
                  (Maybe.Just (Result.Error (error-at call (str &message)))))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (Int.= id 68)
      (match (value-at call values 0)
        (Result.Success value)
          (match (string-argument call &value)
            (Result.Success path)
              (let [directory (path-directory &path)]
                (Maybe.Just (Result.Success (syntax-string call &directory))))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (Int.= id 69)
      (match (value-at call values 0)
        (Result.Success value)
          (match (string-argument call &value)
            (Result.Success path)
              (let [direct-result (IO.read-file &path)]
                (match-ref &direct-result
                  (Result.Success text)
                  (Maybe.Just (Result.Success (syntax-string call text)))
                  (Result.Error _)
                  ;; a path that misses from the invocation directory is
                  ;; retried against the reference checkout ($CARP_DIR,
                  ;; falling back to the sibling layout), matching where
                  ;; core sources resolve their own compile-time reads.
                  (let [root (match (IO.getenv "CARP_DIR")
                          (Maybe.Just dir) (String.append &dir "/")
                          (Maybe.Nothing) @"../../carp/")
                        fallback (String.concat &[root path])
                        fallback-result (IO.read-file &fallback)]
                    (match-ref &fallback-result
                      (Result.Success text)
                        (Maybe.Just (Result.Success (syntax-string call text)))
                      (Result.Error error)
                        (Maybe.Just
                          (Result.Error
                            (error-at call
                                      (String.append "read-file failed: " error))))))))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (Int.= id 70)
      (match (source-position-node call values)
        (Result.Success node)
          (Maybe.Just (Result.Success (syntax-int call (source-line &node))))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (Int.= id 71)
      (match (source-position-node call values)
        (Result.Success node)
          (Maybe.Just (Result.Success (syntax-int call (source-column &node))))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (Int.= id 72)
      (Maybe.Just (Result.Success (syntax-string call "unknown")))
      (Int.= id 73)
      (Maybe.Just (Result.Success (syntax-empty call)))
      ;; the build commands are dynamic functions in the reference; applying
      ;; one at compile time records its effect for the pipeline
      (Int.= id 74)
      (match (value-at call values 0)
        (Result.Success value)
          (match (string-argument call &value)
            (Result.Success path)
              (do
                (Array.push-back! &*ct-pending-includes*
                                  (SurfaceNode.init @(SurfaceNode.span call)
                                                    (SurfaceForm.List
                                                      [(Box.init
                                                         (SurfaceNode.init @(SurfaceNode.span call)
                                                                           (SurfaceForm.Symbol [@"system-include"])))
                                                       (Box.init
                                                         (SurfaceNode.init @(SurfaceNode.span call)
                                                                           (SurfaceForm.StringLit path)))])))
                (Maybe.Just (Result.Success (syntax-empty call))))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (or (Int.= id 75) (or (Int.= id 76) (Int.= id 77)))
      (match (value-at call values 0)
        (Result.Success value)
          (match (string-argument call &value)
            (Result.Success flag)
              (do
                (Array.push-back! &*ct-collected-cflags* flag)
                (Maybe.Just (Result.Success (syntax-empty call))))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (Int.= id 78)
      (match (value-at call values 0)
        (Result.Success value)
          (match (syntax-from-value call &value)
            (Result.Success syntax)
            ;; `str` of a string is the string itself; quoting is `prn`'s job.
            (match-ref (SurfaceNode.form &syntax)
              (SurfaceForm.StringLit text)
                (Maybe.Just (Result.Success (syntax-string call text)))
              _
                (let [rendered (str &syntax)]
                  (Maybe.Just (Result.Success (syntax-string call &rendered)))))
            (Result.Error error)
            (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (Int.= id 79)
      (match (value-at call values 0)
        (Result.Success value)
          (match (syntax-from-value call &value)
            (Result.Success syntax)
            ;; any deterministic hash works: dynamic maps only need
            ;; internal consistency, and the suite compares unordered.
            (let-do [rendered (str &syntax)
                     hashed 5381
                     n (String.length &rendered)]
              (for [i 0 n]
                (set! hashed
                      (Int.bit-and 1073741823
                                   (Int.+ (Int.* hashed 33)
                                          (Char.to-int (String.char-at &rendered
                                                                       i))))))
              (Maybe.Just (Result.Success (syntax-int call hashed))))
            (Result.Error error)
            (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (Int.= id 80)
      (match (value-at call values 0)
        (Result.Success value)
          (match (string-argument call &value)
            (Result.Success message)
              (Maybe.Just (Result.Error (error-at call message)))
            (Result.Error error) (Maybe.Just (Result.Error error)))
        (Result.Error error) (Maybe.Just (Result.Error error)))
      (Maybe.Nothing)))

  (private apply-builtin-name)
  (hidden apply-builtin-name)
  (defn apply-builtin-name [call name values]
    (apply-builtin call (CtLower.builtin-id name) values))

  (private builtin-id-of)
  (hidden builtin-id-of)
  (doc builtin-id-of "the builtin a head form names, or -1.")
  (defn builtin-id-of [head]
    (match (symbol-key head)
      (Maybe.Just name) (CtLower.builtin-id &name)
      (Maybe.Nothing) -1))

