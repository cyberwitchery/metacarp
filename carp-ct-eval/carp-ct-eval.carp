(load "../carp-surface/carp-surface.carp")
; `type` needs resolution and inference
(load "../carp-resolve/carp-resolve.carp")
(load "../carp-infer/carp-infer.carp")
(load "../carp-ct-env/carp-ct-env.carp")
(load "carp-ct-lower.carp")

(doc CtValue "is a value of the compile-time evaluator. `Syntax` holds a form.
`Closure` holds a compile-time function. `Builtin` holds a builtin's name.
`Collection` holds the values of an array. `Macro` holds a closure whose
arguments are bound unevaluated and whose result is evaluated again. Macros live
in the environment, as in the reference, so the evaluator can expand one it
meets inside other code.")
(deftype CtValue
  (Syntax [(Box SurfaceNode)])
  (Closure [(Box CtClosure)])
  (Builtin [String])
  (Collection [(Array (Box CtValue))])
  (Macro [(Box CtClosure)]))

(doc CtClosure "is a compile-time function. `proto` is the index of its
prototype, which holds its parameters and body, lowered once where it is
written. `defining-frame` is the frame it closed over. `file` is the file it was
written in, or the empty string, so a step in its body can say where it is.")
(deftype CtClosure [proto Int
                    defining-frame FrameId
                    file String])

(doc CtParameters "is a compile-time parameter list. `fixed` holds the fixed
parameters and `rest` the rest parameter, if any.")
(deftype CtParameters [fixed (Array String)
                       rest (Maybe String)])

(doc CtModuleFrame "is the compile-time frame `frame` of the module `path`.")
(deftype CtModuleFrame [path String
                        frame FrameId])
(load "carp-ct-lookup.carp")

(doc CtState "is the state of one compile-time evaluation session. `environment`
holds the frames and cells. `root` is the root frame. `modules` holds the module
frames.")
(deftype CtState
  [environment (CtEnvStore CtValue)
   root FrameId
   modules (Array CtModuleFrame)])

(doc CtError "is an error of compile-time evaluation. `message` describes it and
`span` points at the macro body or call that failed.")
(deftype CtError [message String
                  span SurfaceSpan])

(doc CtNumber "is a compile-time number, as the reference evaluator holds one.
`width` is the width it is rendered at: 0 Byte, 1 Int, 2 Long, 3 Float, 4
Double. Promotion takes the larger width. Below 3, `integral` holds the value,
and from 3 `floating` does.")
(deftype CtNumber [width Int
                   integral Long
                   floating Double])

(load "carp-ct-work.carp")

(doc *ct-load-stack* "holds the path of each file whose forms are being
expanded, innermost last. The expander maintains it from the loader's
`Unsafe.load-stack-push!` and `-pop!` markers. `current-file` reads it through
the `Unsafe.load-stack` builtin.")
(def *ct-load-stack* (the (Array String) []))

(doc *ct-meta* "holds the metadata that `meta-set!` and `doc` recorded, by name
and key, oldest first. A later entry for the same name and key wins. Expansion
runs before any binding exists, so the table lives here instead of on the
binder.")
(def *ct-meta* (the (Array (Pair String (Box SurfaceNode))) []))

(doc *ct-typing-forms* "holds the top-level forms expanded so far, in source
order, for `type` to infer against.")
(def *ct-typing-forms* (the (Array (Box SurfaceNode)) []))

(doc *ct-pending-includes* "holds the `system-include` forms that compile-time
code ran. Expansion appends them to its result.")
(def *ct-pending-includes* (the (Array SurfaceNode) []))
(doc *ct-collected-cflags* "holds the C flags: those of `add-cflag`, the
`--cflags` query of `add-pkg`, or the list `Project.config` sets for `cflag`.")
(def *ct-collected-cflags* (the (Array String) []))
(doc *ct-collected-libflags* "holds the linker flags: those of `add-lib`, the
`--libs` query of `add-pkg`, or the list `Project.config` sets for `libflag`.")
(def *ct-collected-libflags* (the (Array String) []))

(doc *ct-project-config* "holds the other `Project.config` settings, such as
`title` and `output-directory`, the latest last.")
(def *ct-project-config* (the (Array (Pair String (Box SurfaceNode))) []))
(doc *ct-pkgconfig-flags* "holds the list `Project.config` sets for
`pkgconfigflag`.")
(def *ct-pkgconfig-flags* (the (Array String) []))

(doc *ct-step-files* "holds the file each running body is written in, innermost
last. This is not the load stack: while a macro from another file runs, the load
stack still names the caller's file.")
(def *ct-step-files* (the (Array String) []))

(doc CtBinding "is a name in scope at a step. `name` is the name and `value` its
value then, as text.")
(deftype CtBinding [name String
                    value String])

(doc CtStep "is one recorded step of compile-time evaluation. `form` is the form
about to be evaluated, as text. `file` and `span` say where it is written.
`frame` is the frame it ran in and `depth` how deeply nested it was. `bindings`
holds what was in scope. Only macro calls are recorded.")
(deftype CtStep
  [form String
   file String
   span SurfaceSpan
   frame Int
   depth Int
   bindings (Array CtBinding)])

(doc *ct-tracing* "is whether steps are recorded. It is off unless a debugger
asks.")
(def *ct-tracing* false)
(doc *ct-trace* "holds the steps recorded so far.")
(def *ct-trace* (the (Array CtStep) []))
(doc *ct-depth* "is how deeply nested the current evaluation is.")
(def *ct-depth* 0)

(load "carp-ct-checkpoint.carp")

(doc CtEval
  "evaluates compile-time code: macros, dynamic functions and compile-time
commands.")
(defmodule CtEval
  (doc reset-load-stack! "empties the load stack.")
  (defn reset-load-stack! [] (set! *ct-load-stack* []))

  (private meta-entry-key)
  (hidden meta-entry-key)
  (defn meta-entry-key [name key]
    (String.concat &[(String.copy name) @" " (String.copy key)]))

  (doc reset-meta! "drops the recorded metadata.")
  (defn reset-meta! [] (set! *ct-meta* []))

  (doc reset-typing-forms! "drops the forms that `type` infers against.")
  (defn reset-typing-forms! [] (set! *ct-typing-forms* []))

  (doc record-typing-form!
    "keeps the finished top-level form `form` for `type`.")
  (defn record-typing-form! [form]
    (Array.push-back! &*ct-typing-forms* (Box.init (SurfaceNode.copy form))))

  (doc record-meta! "records `value` for `name` and `key`. The expander passes
qualified names.")
  (defn record-meta! [name key value]
    (Array.push-back! &*ct-meta*
                      (Pair.init (meta-entry-key name key)
                                 (Box.init (SurfaceNode.copy value)))))

  (doc meta-value "returns the latest value recorded for `name` and `key`, if
any.")
  (defn meta-value [name key]
    (let-do [composed (meta-entry-key name key)
             result (the (Maybe (Box SurfaceNode)) (Maybe.Nothing))
             n (Array.length &*ct-meta*)]
      (for [i 0 n]
        (let [entry (Array.unsafe-nth &*ct-meta* i)]
          (when (String.= (Pair.a entry) &composed)
            (set! result (Maybe.Just (Box.copy (Pair.b entry)))))))
      result))

  (doc drain-pending-includes! "returns the `system-include` forms that
compile-time code ran since the last call, and clears them. Expansion appends
them to its result.")
  (defn drain-pending-includes! []
    (let-do [drained (Array.copy &*ct-pending-includes*)]
      (set! *ct-pending-includes* [])
      drained))

  (doc collected-cflags "returns the C and linker flags compile-time code set,
without duplicates, for the driver's C compiler.")
  (defn collected-cflags []
    (let-do [flags (the (Array String) [])
             requested (Array.concat
               &[(Array.copy &*ct-collected-cflags*)
                 (Array.copy &*ct-collected-libflags*)])]
      (for [i 0 (Array.length &requested)]
        (let [flag (Array.unsafe-nth &requested i)]
          (unless (Array.contains? &flags flag) (Array.push-back! &flags @flag))))
      flags))

  (private pkg-config-query)
  (hidden pkg-config-query)
  (doc pkg-config-query "returns the start of the `pkg-config` command that the
reference's `add-pkg` adds for `package`, with the `pkgconfigflag` settings
after it.")
  (defn pkg-config-query [package]
    (String.join " "
                 &(Array.concat
                   &[[@"`pkg-config" @package]
                     (Array.copy &*ct-pkgconfig-flags*)])))

  (doc record-build-command! "applies the build command `command` (`add-cflag`,
`add-lib` or `add-pkg`) with `argument`. A package becomes the two `pkg-config`
queries the reference adds for it, which the shell runs when the C is compiled.")
  (defn record-build-command! [command argument]
    (cond
      (String.= command "add-lib")
        (Array.push-back! &*ct-collected-libflags* @argument)
      (String.= command "add-pkg")
        (let-do [query (pkg-config-query argument)]
          (Array.push-back! &*ct-collected-cflags*
                            (String.append &query " --cflags`"))
          (Array.push-back! &*ct-collected-libflags*
                            (String.append &query " --libs`")))
      (Array.push-back! &*ct-collected-cflags* @argument)))

  (private config-default-string)
  (hidden config-default-string)
  (doc config-default-string "returns the reference's default for the string
project key `key`, or `Nothing` if it is not one.")
  (defn config-default-string [key]
    (cond
      (String.= key "title") (Maybe.Just @"Untitled")
      (String.= key "output-directory") (Maybe.Just @"out")
      (String.= key "docs-directory") (Maybe.Just @"docs")
      (String.= key "docs-logo") (Maybe.Just @"")
      (String.= key "docs-prelude") (Maybe.Just @"")
      (String.= key "docs-url") (Maybe.Just @"")
      (String.= key "docs-styling") (Maybe.Just @"carp_style.css")
      (String.= key "prompt") (Maybe.Just @"> ")
      (String.= key "compiler") (Maybe.Just @"clang")
      (String.= key "target") (Maybe.Just @"native")
      (String.= key "file-path-print-length") (Maybe.Just @"FullPath")
      (Maybe.Nothing)))

  (private config-default-bool)
  (hidden config-default-bool)
  (doc config-default-bool "returns the reference's default for the bool project
key `key`, or `Nothing` if it is not one.")
  (defn config-default-bool [key]
    (cond
      (String.= key "echo-c") (Maybe.Just false)
      (String.= key "docs-generate-index") (Maybe.Just true)
      (String.= key "paren-balance-hints") (Maybe.Just true)
      (String.= key "print-ast") (Maybe.Just false)
      (String.= key "core") (Maybe.Just true)
      (String.= key "echo-compiler-cmd") (Maybe.Just false)
      (String.= key "generate-only") (Maybe.Just false)
      (String.= key "force-reload") (Maybe.Just false)
      (String.= key "line-directives") (Maybe.Just false)
      (Maybe.Nothing)))

  (private config-kind)
  (hidden config-kind)
  (doc config-kind "returns what the project key `key` holds, as in the
reference's `projectKeyMap`: 0 a string, 1 a bool, 2 a list of strings set
whole, 3 a list of strings set one at a time, 4 a read-only value, or -1 for an
unknown key.")
  (defn config-kind [key]
    (cond
      (or (String.= key "cflag")
          (or (String.= key "libflag") (String.= key "pkgconfigflag")))
        2
      (or (String.= key "search-path") (String.= key "cmod")) 3
      (or (String.= key "includes")
          (or (String.= key "preproc") (String.= key "load-stack")))
        4
      (Maybe.just? &(config-default-string key)) 0
      (Maybe.just? &(config-default-bool key)) 1
      -1))

  (private recorded-config)
  (hidden recorded-config)
  (doc recorded-config "returns the value `Project.config` last gave `key`, if
any.")
  (defn recorded-config [key]
    (let-do [result (the (Maybe SurfaceNode) (Maybe.Nothing))]
      (for [i 0 (Array.length &*ct-project-config*)]
        (let [entry (Array.unsafe-nth &*ct-project-config* i)]
          (when (String.= (Pair.a entry) key)
            (set! result
                  (Maybe.Just (SurfaceNode.copy (Box.peek (Pair.b entry))))))))
      result))

  (private record-config!)
  (hidden record-config!)
  (defn record-config! [key value]
    (Array.push-back! &*ct-project-config*
                      (Pair.init @key (Box.init (SurfaceNode.copy value)))))

  (doc project-string "returns the string project setting `key`, such as `title`
or `output-directory`, as `Project.config` left it, or the reference's default.")
  (defn project-string [key]
    (let [default (Maybe.from (config-default-string key) @"")]
      (match (recorded-config key)
        (Maybe.Just node)
          (match-ref (SurfaceNode.form &node)
            (SurfaceForm.StringLit value) @value
            _ default)
        (Maybe.Nothing) default)))

  (doc push-step-file! "enters the file `path` for recording steps: the body
about to run is written there. Push the empty string if the file is unknown, so
a body does not inherit its caller's.")
  (defn push-step-file! [path] (Array.push-back! &*ct-step-files* @path))

  (doc pop-step-file! "leaves the file entered by `push-step-file!`.")
  (defn pop-step-file! []
    (when (Int.> (Array.length &*ct-step-files*) 0)
      (ignore (Array.pop-back! &*ct-step-files*))))

  (private current-step-file)
  (hidden current-step-file)
  (doc current-step-file "returns the file the running body is written in, or
the empty string.")
  (defn current-step-file []
    (let [n (Array.length &*ct-step-files*)]
      (if (Int.= n 0) @"" @(Array.unsafe-nth &*ct-step-files* (Int.dec n)))))

  (doc current-load-file "returns the innermost file being loaded, or the empty
string. While a macro from another file runs, this is still the caller's file,
which is what `current-file` and `relative-include` mean.")
  (defn current-load-file []
    (let [n (Array.length &*ct-load-stack*)]
      (if (Int.= n 0) @"" @(Array.unsafe-nth &*ct-load-stack* (Int.dec n)))))

  (doc definition-file "returns the file a definition being read is written in:
the step file if there is one, else the innermost file being loaded.")
  (defn definition-file []
    (let [inner (current-step-file)]
      (if (String.empty? &inner) (current-load-file) inner)))

  (doc trace-on! "starts recording compile-time steps and drops what an earlier
run recorded.")
  (defn trace-on! []
    (do (set! *ct-tracing* true) (set! *ct-trace* []) (set! *ct-depth* 0)))

  (doc trace-off! "stops recording. The recording stays until the next run
starts.")
  (defn trace-off! [] (set! *ct-tracing* false))

  (doc trace "returns the recorded steps, in order.")
  (defn trace [] (Array.copy &*ct-trace*))

  (private binding-text)
  (hidden binding-text)
  (doc binding-text "returns `value` as a recording shows it. Syntax is shown as
code. Other values say what they are.")
  (defn binding-text [value]
    (match-ref value
      (CtValue.Syntax syntax) (Surface.render (Box.peek syntax))
      (CtValue.Collection values) (fmt "«%d values»" (Array.length values))
      (CtValue.Closure _) @"«compile-time function»"
      (CtValue.Macro _) @"«macro»"
      (CtValue.Builtin name) (fmt "«builtin %s»" name)))

  (private step-bindings)
  (hidden step-bindings)
  (doc step-bindings "returns what is in scope at a step in `frame`: the names
in it and the frames around it, innermost first, without the root frame. At most
8 frames and 64 names are shown.")
  (defn step-bindings [state frame]
    (let-do [result (the (Array CtBinding) [])
             store (CtState.environment state)
             root @(FrameId.index (CtState.root state))
             current (Maybe.Just @frame)
             frames-left 8]
      (while-do (and (Int.> frames-left 0)
                     (match-ref &current
                       (Maybe.Just _) true
                       (Maybe.Nothing) false))
        (let-do [here (match-ref &current
                   (Maybe.Just f) @f
                   (Maybe.Nothing) (FrameId.init 0))]
          (if (Int.= @(FrameId.index &here) root)
            (set! current (the (Maybe FrameId) (Maybe.Nothing)))
            (let-do [bindings (CtEnv.local-bindings store &here)
                     n (Array.length &bindings)]
              (for [i 0 n]
                (when (Int.< (Array.length &result) 64)
                  (let [binding (Array.unsafe-nth &bindings i)]
                    (match (CtEnv.read-cell store (CtEnvBinding.cell binding))
                      (Maybe.Just value)
                        (Array.push-back! &result
                                          (CtBinding.init @(CtEnvBinding.name binding)
                                                          (binding-text &value)))
                      (Maybe.Nothing) ()))))
              (set! current (CtEnv.parent-frame store &here))
              (set! frames-left (Int.dec frames-left))))))
      result))

  (private record-step!)
  (hidden record-step!)
  (defn record-step! [body state frame]
    (Array.push-back! &*ct-trace*
                      (CtStep.init (Surface.render body)
                                   (current-step-file)
                                   @(SurfaceNode.span body)
                                   @(FrameId.index frame)
                                   *ct-depth*
                                   (step-bindings state frame))))

  (doc enter-call! "records `call`, whose body the expander is about to run, as
a step, and enters it, if tracing is on. Only these calls are recorded.")
  (defn enter-call! [call state frame]
    (when-do *ct-tracing*
      (record-step! call state frame)
      (set! *ct-depth* (Int.inc *ct-depth*))))

  (doc leave-call! "leaves a call entered by `enter-call!`.")
  (defn leave-call! []
    (when *ct-tracing* (set! *ct-depth* (Int.dec *ct-depth*))))

  (doc push-load-file! "enters the file `path` on the load stack.")
  (defn push-load-file! [path] (Array.push-back! &*ct-load-stack* @path))

  (doc pop-load-file! "leaves the innermost file on the load stack.")
  (defn pop-load-file! []
    (when (Int.> (Array.length &*ct-load-stack*) 0)
      (ignore (Array.pop-back! &*ct-load-stack*))))

  (private symbol-name)
  (hidden symbol-name)
  (defn symbol-name [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.Symbol segments)
        (if (Int.= 1 (Array.length segments))
          (Maybe.Just @(Array.unsafe-nth segments 0))
          (Maybe.Nothing))
      _ (Maybe.Nothing)))

  (private symbol-key)
  (hidden symbol-key)
  (defn symbol-key [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.Symbol segments)
        (if (Int.> (Array.length segments) 0)
          (Maybe.Just (String.join "." segments))
          (Maybe.Nothing))
      _ (Maybe.Nothing)))

  (private named?)
  (hidden named?)
  (defn named? [node name]
    (match (symbol-key node)
      (Maybe.Just found) (= found name)
      (Maybe.Nothing) false))

  (private error-at)
  (hidden error-at)
  (defn error-at [node message] (CtError.init message @(SurfaceNode.span node)))

  (private path-directory)
  (hidden path-directory)
  (defn path-directory [path]
    (let-do [slash -1
             i 0
             n (String.length path)]
      (while-do (Int.< i n)
        (when (Char.= (String.char-at path i) \/) (set! slash i))
        (set! i (Int.inc i)))
      (cond
        (Int.< slash 0) (String.copy ".")
        (Int.= slash 0) (String.copy "/")
        (String.slice path 0 slash))))

  (private semantic-items)
  (hidden semantic-items)
  (defn semantic-items [items]
    (let-do [result (the (Array (Box SurfaceNode)) [])
             n (Array.length items)]
      (for [i 0 n]
        (let [item (Box.peek (Array.unsafe-nth items i))]
          (match-ref (SurfaceNode.form item)
            (SurfaceForm.Comment _) ()
            _
              (set! result
                    (Array.push-back result (Box.init (SurfaceNode.copy item)))))))
      result))

  (doc state "returns a new compile-time state with one root frame.")
  (defn state []
    (let-do [environment (CtEnv.empty)
             root (CtEnv.root! &environment)]
      (CtState.init environment
                    root
                    [(CtModuleFrame.init @"" (FrameId.copy &root))])))

  (doc root "returns the root frame of `state`.")
  (defn root [state] @(CtState.root state))

  (doc child! "returns a new child frame of `parent`.")
  (defn child! [state parent] (CtEnv.child! (CtState.environment state) parent))

  (doc define! "binds `name` to `value` in `frame` and changes the environment
epoch.")
  (defn define! [state frame name value]
    (CtEnv.define! (CtState.environment state) frame name value))

  (doc define-local! "binds `name` to `value` in `frame` without changing the
environment epoch, for parameters and arguments. Child frames see it, but cached
resolutions cannot depend on it.")
  (defn define-local! [state frame name value]
    (CtEnv.define-local! (CtState.environment state) frame name value))

  (doc alias! "binds `name` in `frame` to the existing `cell`.")
  (defn alias! [state frame name cell]
    (CtEnv.bind-cell! (CtState.environment state) frame name cell))

  (doc import! "makes `frame` see the frame `imported`.")
  (defn import! [state frame imported]
    (CtEnv.add-import! (CtState.environment state) frame imported))

  (doc register-module! "records the frame of the module `path`.")
  (defn register-module! [state path frame]
    (let-do [known false
             modules (CtState.modules state)
             n (Array.length modules)]
      (for [i 0 n]
        (let [entry (Array.unsafe-nth modules i)]
          (when (= (CtModuleFrame.path entry) path) (set! known true))))
      (unless known (Array.push-back! modules (CtModuleFrame.init @path @frame)))
      true))

  (doc module-frame "returns the frame of the module `path`, if any.")
  (defn module-frame [state path]
    (CtLookup.module-frame (CtState.modules state) path))

  (doc lookup-value "returns the value bound to `name`, looked up from `frame`,
if any.")
  (defn lookup-value [state frame name]
    (CtEnv.lookup (CtState.environment state) frame name))

  (private module-member-lookup)
  (hidden module-member-lookup)
  (defn module-member-lookup [state path local]
    (CtLookup.module-member (CtState.environment state)
                            (CtState.modules state)
                            path
                            local))

  (private static-definition-value?)
  (hidden static-definition-value?)
  (private definition-head?)
  (hidden definition-head?)
  (doc definition-head? "checks whether `name` heads a static definition form.
The first character rules out most names quickly, which matters because this
runs on every name bound to list syntax.")
  (defn definition-head? [name]
    (let [first (String.char-at name 0)]
      (cond
        (Char.= first \d)
          (or (String.= name "defn")
              (or (String.= name "defn-")
                  (or (String.= name "def")
                      (or (String.= name "def-")
                          (or (String.= name "deftype")
                              (or (String.= name "deftemplate")
                                  (or (String.= name "definterface")
                                      (String.= name "defmodule"))))))))
        (Char.= first \r) (String.= name "register")
        false)))

  ; the recorded source of a static definition cannot be evaluated, so it must
  ; not shadow a `Dynamic` binding of the same name: inside `Map`, `(length m)`
  ; is `Dynamic.length`, not the source of `Map.length`.
  (defn static-definition-value? [value]
    (match-ref value
      (CtValue.Syntax boxed)
        (match-ref (SurfaceNode.form (Box.peek boxed))
          (SurfaceForm.List items)
            (if (Int.> (Array.length items) 0)
              (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth items 0)))
                (SurfaceForm.Symbol segments)
                  (and (Int.= 1 (Array.length segments))
                       (definition-head? (Array.unsafe-nth segments 0)))
                _ false)
              false)
          _ false)
      _ false))

  (doc lookup-status "resolves `name` from `frame` with `CtLookup.status`. An
import that makes it ambiguous is reported as such.")
  (defn lookup-status [state frame name]
    (CtLookup.status (CtState.environment state)
                     (CtState.modules state)
                     frame
                     name
                     &static-definition-value?))

  (doc closure-in-frame? "checks whether `name` is bound to a compile-time
function directly in `frame`, not through imports or parents. Static code names
a dynamic function by its exact path, so a `use`d or prelude module must not
supply one.")
  (defn closure-in-frame? [state frame name]
    (match (CtEnv.local-cell (CtState.environment state) frame name)
      (Maybe.Just cell)
        (match-ref (CtEnv.peek-cell (CtState.environment state) &cell)
          (CtValue.Closure _) true
          _ false)
      (Maybe.Nothing) false))

  (doc read-cell "returns a copy of the value in `cell`.")
  (defn read-cell [state cell]
    (CtEnv.read-cell (CtState.environment state) cell))

  (doc lookup "returns the syntax bound to `name`, if it is bound to syntax.")
  (defn lookup [state frame name]
    (match (lookup-value state frame name)
      (Maybe.Just value)
        (match value
          (CtValue.Syntax syntax)
            (Maybe.Just (SurfaceNode.copy (Box.peek &syntax)))
          _ (Maybe.Nothing))
      (Maybe.Nothing) (Maybe.Nothing)))

  (private copy-children)
  (hidden copy-children)
  (defn copy-children [items]
    (let-do [result (the (Array (Box SurfaceNode)) [])
             n (Array.length items)]
      (for [i 0 n]
        (set! result
              (Array.push-back result
                               (Box.init
                                 (SurfaceNode.copy (Box.peek (Array.unsafe-nth items
                                                                               i)))))))
      result))

  (private append-children)
  (hidden append-children)
  (private append-values)
  (hidden append-values)
  (defn append-children [left right]
    (let-do [result left
             n (Array.length right)]
      (for [i 0 n]
        (set! result
              (Array.push-back result
                               (Box.init
                                 (SurfaceNode.copy (Box.peek (Array.unsafe-nth right
                                                                               i)))))))
      result))

  (defn append-values [left right]
    (let-do [result left
             n (Array.length right)]
      (for [i 0 n]
        (set! result
              (Array.push-back result
                               (Box.init
                                 (CtValue.copy (Box.peek (Array.unsafe-nth right
                                                                           i)))))))
      result))

  (private syntax-from-value)
  (hidden syntax-from-value)
  (defn syntax-from-value [node value]
    (match-ref value
      (CtValue.Syntax syntax)
        (Result.Success (SurfaceNode.copy (Box.peek syntax)))
      (CtValue.Collection values)
        (let-do [result (the
                   (Result (Array (Box SurfaceNode)) CtError)
                   (Result.Success []))
                 n (Array.length values)]
          (for [i 0 n]
            (match-ref &result
              (Result.Success items)
                (match-ref (Box.peek (Array.unsafe-nth values i))
                  (CtValue.Syntax syntax)
                    (Array.push-back! items
                                      (Box.init (SurfaceNode.copy (Box.peek syntax))))
                  _
                    (set! result
                          (Result.Error
                            (error-at node
                                      @"compile-time collection contains a non-syntax value"))))
              (Result.Error error) (set! result (Result.Error @error))))
          (match result
            (Result.Success items)
              (Result.Success
                (SurfaceNode.generated @(SurfaceNode.span node)
                                       (SurfaceForm.Array items)))
            (Result.Error error) (Result.Error error)))
      _
        (Result.Error
          (error-at node @"compile-time expression must evaluate to syntax"))))

  (private closure-parameters)
  (hidden closure-parameters)
  (private list-or-collection)
  (hidden list-or-collection)
  (defn closure-parameters [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.Array forms)
        (let-do [fixed (the (Array String) [])
                 rest (the (Maybe String) (Maybe.Nothing))
                 result (the (Result CtParameters CtError)
                             (Result.Success (CtParameters.init []
                                                                (Maybe.Nothing))))
                 n (Array.length forms)]
          (for [i 0 n]
            (match-ref &result
              (Result.Success _)
                (let [form (Box.peek (Array.unsafe-nth forms i))]
                  (let [name-result (symbol-name form)]
                    (match-ref &name-result
                      (Maybe.Just name)
                        (cond
                          (= name ":rest")
                            (if (Int.= (Int.inc i) (Int.dec n))
                              (let [rest-form (Box.peek (Array.unsafe-nth forms
                                                                          (Int.inc i)))]
                                (let [rest-name-result (symbol-name rest-form)]
                                  (match-ref &rest-name-result
                                    (Maybe.Just rest-name)
                                      (do
                                        (set! rest
                                              (Maybe.Just (String.copy rest-name)))
                                        (set! i (Int.inc i)))
                                    (Maybe.Nothing)
                                      (set! result
                                            (Result.Error
                                              (error-at rest-form
                                                        @"compile-time :rest must be followed by an unqualified symbol"))))))
                              (set! result
                                    (Result.Error
                                      (error-at form
                                                @"compile-time :rest must be followed by the final parameter"))))
                          (Maybe.nothing? &rest)
                            (set! fixed
                                  (Array.push-back fixed (String.copy name)))
                          (set! result
                                (Result.Error
                                  (error-at form
                                            @"compile-time parameters cannot follow :rest"))))
                      (Maybe.Nothing)
                        (set! result
                              (Result.Error
                                (error-at form
                                          @"compile-time fn parameters must be symbols"))))))
              (Result.Error error) (set! result (Result.Error @error))))
          (match result
            (Result.Success _) (Result.Success (CtParameters.init fixed rest))
            (Result.Error error) (Result.Error error)))
      _
        (Result.Error
          (error-at node @"compile-time fn parameters must be an array"))))

  (private bind-closure)
  (hidden bind-closure)
  (defn bind-closure [call state closure arguments]
    (let [proto (Box.peek
            (Array.unsafe-nth &*ct-protos* @(CtClosure.proto closure)))
          parameters (CtProto.parameters proto)
          rest @(CtProto.rest proto)
          expected (Array.length parameters)
          actual (Array.length arguments)]
      (if (or (Int.< actual expected)
              (and (Maybe.nothing? &rest) (/= expected actual)))
        (Result.Error
          (error-at call
                    @"compile-time function called with the wrong number of arguments"))
        (let-do [frame (child! state (CtClosure.defining-frame closure))]
          (for [i 0 expected]
            (ignore
              (CtEnv.define-local! (CtState.environment state)
                                   &frame
                                   (Array.unsafe-nth parameters i)
                                   (CtValue.copy
                                     (Box.peek (Array.unsafe-nth arguments i))))))
          (match rest
            (Maybe.Just rest-name)
              (let-do [rest-values (the (Array (Box CtValue)) [])]
                (for [i expected actual]
                  (Array.push-back! &rest-values
                                    (Box.init
                                      (CtValue.copy
                                        (Box.peek (Array.unsafe-nth arguments i))))))
                (ignore
                  (CtEnv.define-local! (CtState.environment state)
                                       &frame
                                       &rest-name
                                       (list-or-collection call &rest-values))))
            (Maybe.Nothing) ())
          (Result.Success frame)))))

  (doc define-function "returns a compile-time closure over `frame` with
`parameters` and `body`, for `defndynamic`. It keeps the file it is defined in.")
  (defn define-function [parameters body frame]
    (match (closure-parameters parameters)
      (Result.Success parsed)
        (match (CtLower.lower-proto parameters body &(CtLower.empty-scope))
          (Maybe.Just proto)
            (Result.Success
              (CtValue.Closure
                (Box.init (CtClosure.init proto @frame (definition-file)))))
          (Maybe.Nothing)
            (Result.Error
              (error-at parameters @"compile-time fn parameters must be symbols")))
      (Result.Error error) (Result.Error error)))

  (doc define-dynamic-function "returns a `defndynamic` closure over `frame`
with `parameters` and `body`.")
  (defn define-dynamic-function [parameters body frame]
    (define-function parameters body frame))

  (private syntax-arguments)
  (hidden syntax-arguments)
  (defn syntax-arguments [call values]
    (let-do [result (the
               (Result (Array (Box SurfaceNode)) CtError)
               (Result.Success []))
             n (Array.length values)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success syntax)
            (let [value (Box.peek (Array.unsafe-nth values i))]
              (match (syntax-from-value call value)
                (Result.Success node) (Array.push-back! syntax (Box.init node))
                (Result.Error error) (set! result (Result.Error error))))
          (Result.Error error) (set! result (Result.Error @error))))
      result))

  (private list-items)
  (hidden list-items)
  (private values-from-syntax-items)
  (hidden values-from-syntax-items)
  (private collection-values)
  (hidden collection-values)
  (private operation-name)
  (hidden operation-name)
  (defn operation-name [call]
    (match-ref (SurfaceNode.form call)
      (SurfaceForm.List items)
        (if (Int.> (Array.length items) 0)
          (match (symbol-key (Box.peek (Array.unsafe-nth items 0)))
            (Maybe.Just name) name
            (Maybe.Nothing) @"unknown")
          @"unknown")
      _ @"unknown"))

  (defn list-items [call value]
    (match-ref value
      (CtValue.Collection values) (syntax-arguments call values)
      _
        (match (syntax-from-value call value)
          (Result.Success node)
            (match-ref (SurfaceNode.form &node)
              (SurfaceForm.List items) (Result.Success (copy-children items))
              (SurfaceForm.Array items) (Result.Success (copy-children items))
              (SurfaceForm.StaticArray items)
                (Result.Success (copy-children items))
              (SurfaceForm.Symbol _)
                (Result.Error
                  (error-at call
                            @"compile-time operation expected a list or array, got a symbol"))
              (SurfaceForm.IntLit _)
                (Result.Error
                  (error-at call
                            @"compile-time operation expected a list or array, got an Int"))
              (SurfaceForm.StringLit _)
                (Result.Error
                  (error-at call
                            @"compile-time operation expected a list or array, got a String"))
              (SurfaceForm.BoolLit _)
                (Result.Error
                  (error-at call
                            @"compile-time operation expected a list or array, got a Bool"))
              (SurfaceForm.CharLit _)
                (Result.Success [(Box.init (SurfaceNode.copy &node))])
              _
                (Result.Error
                  (error-at call
                            (String.append
                              "compile-time list operation expects a list or array: "
                              &(operation-name call)))))
          (Result.Error error) (Result.Error error))))

  (defn values-from-syntax-items [items]
    (let-do [result (the (Array (Box CtValue)) [])
             n (Array.length items)]
      (for [i 0 n]
        (set! result
              (Array.push-back result
                               (Box.init
                                 (CtValue.Syntax
                                   (Box.init
                                     (SurfaceNode.copy (Box.peek (Array.unsafe-nth items
                                                                                   i)))))))))
      result))

  (doc syntax-value? "checks whether `value` is syntax. Syntax cannot be
applied, and evaluates to itself.")
  (defn syntax-value? [value] (match-ref value (CtValue.Syntax _) true _ false))

  (private syntax-collection-values)
  (hidden syntax-collection-values)
  (defn syntax-collection-values [call node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List items) (Result.Success (values-from-syntax-items items))
      (SurfaceForm.Array items)
        (Result.Success (values-from-syntax-items items))
      (SurfaceForm.StaticArray items)
        (Result.Success (values-from-syntax-items items))
      (SurfaceForm.Symbol _)
        (Result.Error
          (error-at call
                    @"compile-time operation expected a list or array, got a symbol"))
      (SurfaceForm.IntLit _)
        (Result.Error
          (error-at call
                    @"compile-time operation expected a list or array, got an Int"))
      (SurfaceForm.StringLit _)
        (Result.Error
          (error-at call
                    @"compile-time operation expected a list or array, got a String"))
      (SurfaceForm.BoolLit _)
        (Result.Error
          (error-at call
                    @"compile-time operation expected a list or array, got a Bool"))
      (SurfaceForm.CharLit _)
        (Result.Success
          [(Box.init (CtValue.Syntax (Box.init (SurfaceNode.copy node))))])
      _
        (Result.Error
          (error-at call
                    (String.append
                      "compile-time list operation expects a list or array: "
                      &(operation-name call))))))

  (doc collection-values "returns the items of a list-like value, each as a
value of its own.")
  (defn collection-values [call value]
    (match-ref value
      (CtValue.Collection values) (Result.Success @values)
      (CtValue.Syntax syntax) (syntax-collection-values call (Box.peek syntax))
      _
        (Result.Error
          (error-at call @"compile-time expression must evaluate to syntax"))))

  (private syntax-int)
  (hidden syntax-int)
  (defn syntax-int [call value]
    (CtValue.Syntax
      (Box.init
        (SurfaceNode.generated @(SurfaceNode.span call)
                               (SurfaceForm.IntLit value)))))

  (private syntax-bool)
  (hidden syntax-bool)
  (defn syntax-bool [call value]
    (CtValue.Syntax
      (Box.init
        (SurfaceNode.generated @(SurfaceNode.span call)
                               (SurfaceForm.BoolLit value)))))

  (private syntax-string)
  (hidden syntax-string)
  (defn syntax-string [call value]
    (CtValue.Syntax
      (Box.init
        (SurfaceNode.generated @(SurfaceNode.span call)
                               (SurfaceForm.StringLit (String.copy value))))))

  (private syntax-string-collection)
  (hidden syntax-string-collection)
  (defn syntax-string-collection [call source array?]
    (let-do [items (the (Array (Box SurfaceNode)) [])
             characters (String.chars source)
             n (Array.length &characters)]
      (for [i 0 n]
        (let [piece (String.from-chars &[@(Array.unsafe-nth &characters i)])]
          (Array.push-back! &items
                            (Box.init
                              (SurfaceNode.generated @(SurfaceNode.span call)
                                                     (SurfaceForm.StringLit piece))))))
      (if array?
        (CtValue.Syntax
          (Box.init
            (SurfaceNode.generated @(SurfaceNode.span call)
                                   (SurfaceForm.Array items))))
        (CtValue.Syntax
          (Box.init
            (SurfaceNode.generated @(SurfaceNode.span call)
                                   (SurfaceForm.List items)))))))

  (private syntax-char)
  (hidden syntax-char)
  (defn syntax-char [call value]
    (CtValue.Syntax
      (Box.init
        (SurfaceNode.generated @(SurfaceNode.span call)
                               (SurfaceForm.CharLit value)))))

  (private syntax-empty)
  (hidden syntax-empty)
  (defn syntax-empty [call]
    (CtValue.Syntax
      (Box.init
        (SurfaceNode.generated @(SurfaceNode.span call) (SurfaceForm.List [])))))

  (private syntax-symbol)
  (hidden syntax-symbol)
  (defn syntax-symbol [call segments]
    (CtValue.Syntax
      (Box.init
        (SurfaceNode.generated @(SurfaceNode.span call)
                               (SurfaceForm.Symbol segments)))))

  (private source-line)
  (hidden source-line)
  (defn source-line [node]
    @(Info.line (SurfaceSpan.start (SurfaceNode.span node))))

  (private source-column)
  (hidden source-column)
  (defn source-column [node]
    @(Info.col (SurfaceSpan.start (SurfaceNode.span node))))

  (private concat-symbols)
  (hidden concat-symbols)
  (defn concat-symbols [call value]
    (match (list-items call value)
      (Result.Success items)
        (let-do [result (the (Result String CtError) (Result.Success @""))
                 n (Array.length &items)]
          (for [i 0 n]
            (match-ref &result
              (Result.Success text)
                (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth &items
                                                                         i)))
                  (SurfaceForm.Symbol parts)
                    (let [part (String.join "." parts)]
                      (set! result (Result.Success (String.append text &part))))
                  _
                    (set! result
                          (Result.Error
                            (error-at call @"Symbol.concat expects symbols"))))
              (Result.Error error) (set! result (Result.Error @error))))
          (match result
            (Result.Success text) (Result.Success (syntax-symbol call [text]))
            (Result.Error error) (Result.Error error)))
      (Result.Error error) (Result.Error error)))

  (private prefix-symbols)
  (hidden prefix-symbols)
  (defn prefix-symbols [call left right]
    (match (syntax-from-value call left)
      (Result.Success left-node)
        (match (syntax-from-value call right)
          (Result.Success right-node)
            (match-ref (SurfaceNode.form &left-node)
              (SurfaceForm.Symbol left-parts)
                (match-ref (SurfaceNode.form &right-node)
                  (SurfaceForm.Symbol right-parts)
                    (let-do [segments (Array.copy left-parts)
                             n (Array.length right-parts)]
                      (for [i 0 n]
                        (set! segments
                              (Array.push-back segments
                                               @(Array.unsafe-nth right-parts i))))
                      (Result.Success (syntax-symbol call segments)))
                  _
                    (Result.Error
                      (error-at call @"Symbol.prefix expects symbols")))
              _ (Result.Error (error-at call @"Symbol.prefix expects symbols")))
          (Result.Error error) (Result.Error error))
      (Result.Error error) (Result.Error error)))

  (private int-argument)
  (hidden int-argument)
  (defn int-argument [call value]
    (match (syntax-from-value call value)
      (Result.Success node)
        (match-ref (SurfaceNode.form &node)
          (SurfaceForm.IntLit integer) (Result.Success @integer)
          _
            (Result.Error
              (error-at call @"compile-time operation expects Int syntax")))
      (Result.Error error) (Result.Error error)))

  (private number-from-node)
  (hidden number-from-node)
  (defn number-from-node [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.IntLit value) (Maybe.Just (Double.from-int @value))
      (SurfaceForm.ByteLit value)
        (Maybe.Just (Double.from-int (Byte.to-int @value)))
      (SurfaceForm.LongLit value) (Maybe.Just (Double.from-long @value))
      (SurfaceForm.FloatLit value) (Maybe.Just (Double.from-float @value))
      (SurfaceForm.DoubleLit value) (Maybe.Just @value)
      _ (Maybe.Nothing)))

  (private number-argument)
  (hidden number-argument)
  (defn number-argument [call value]
    (match (syntax-from-value call value)
      (Result.Success node)
        (match (number-from-node &node)
          (Maybe.Just number) (Result.Success number)
          (Maybe.Nothing)
            (Result.Error
              (error-at call @"compile-time operation expects numeric syntax")))
      (Result.Error error) (Result.Error error)))

  ;; the reference evaluator's numbers are two-domain (Integral or Floating)
  ;; with a type tag, and arithmetic promotes the tag through the ladder
  ;; Byte < Int < Long < Float < Double (Types.hs promoteNumber): the widths
  ;; below follow that order, so promotion is a max and a width of Float or
  ;; wider means the value lives in the floating domain, exactly like the
  ;; reference's Num instance on Number (Obj.hs).
  (private ct-number-from-node)
  (hidden ct-number-from-node)
  (defn ct-number-from-node [node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.ByteLit value)
        (Maybe.Just (CtNumber.init 0 (Long.from-int (Byte.to-int @value)) 0.0))
      (SurfaceForm.IntLit value)
        (Maybe.Just (CtNumber.init 1 (Long.from-int @value) 0.0))
      (SurfaceForm.LongLit value) (Maybe.Just (CtNumber.init 2 @value 0.0))
      (SurfaceForm.FloatLit value)
        (Maybe.Just (CtNumber.init 3 0l (Double.from-float @value)))
      (SurfaceForm.DoubleLit value) (Maybe.Just (CtNumber.init 4 0l @value))
      _ (Maybe.Nothing)))

  (private ct-number-argument)
  (hidden ct-number-argument)
  (defn ct-number-argument [call value]
    (match (syntax-from-value call value)
      (Result.Success node)
        (match (ct-number-from-node &node)
          (Maybe.Just number) (Result.Success number)
          (Maybe.Nothing)
            (Result.Error
              (error-at call @"compile-time operation expects numeric syntax")))
      (Result.Error error) (Result.Error error)))

  (private ct-number-double)
  (hidden ct-number-double)
  (defn ct-number-double [number]
    (if (Int.>= @(CtNumber.width number) 3)
      @(CtNumber.floating number)
      (Double.from-long @(CtNumber.integral number))))

  (private syntax-number)
  (hidden syntax-number)
  (doc syntax-number "returns `number` as a literal of the width it was promoted
to, so an expansion has the type the reference gives it.")
  (defn syntax-number [call number]
    (let [width @(CtNumber.width number)]
      (CtValue.Syntax
        (Box.init
          (SurfaceNode.generated @(SurfaceNode.span call)
                                 (cond
                                   (Int.= width 0)
                                     (SurfaceForm.ByteLit
                                       (Byte.from-int
                                         (Long.to-int @(CtNumber.integral number))))
                                   (Int.= width 1)
                                     (SurfaceForm.IntLit
                                       (Long.to-int @(CtNumber.integral number)))
                                   (Int.= width 2)
                                     (SurfaceForm.LongLit @(CtNumber.integral number))
                                   (Int.= width 3)
                                     (SurfaceForm.FloatLit
                                       (Double.to-float @(CtNumber.floating number)))
                                   (SurfaceForm.DoubleLit @(CtNumber.floating number))))))))

  (private ct-arith)
  (hidden ct-arith)
  (doc ct-arith "adds, subtracts or multiplies `left` and `right` (operation 0,
1 or 2) as the reference's `commandArith` does: the result has the promoted
width, and a floating operand makes it floating.")
  (defn ct-arith [call operation left right]
    (match (ct-number-argument call left)
      (Result.Success a)
        (match (ct-number-argument call right)
          (Result.Success b)
            (let [width (Int.max @(CtNumber.width &a) @(CtNumber.width &b))]
              (Result.Success
                (syntax-number call
                               &(if (Int.>= width 3)
                                 (let [da (ct-number-double &a)
                                       db (ct-number-double &b)]
                                   (CtNumber.init width
                                                  0l
                                                  (cond
                                                    (Int.= operation 0)
                                                      (Double.+ da db)
                                                    (Int.= operation 1)
                                                      (Double.- da db)
                                                    (Double.* da db))))
                                 (let [ia @(CtNumber.integral &a)
                                       ib @(CtNumber.integral &b)]
                                   (CtNumber.init width
                                                  (cond
                                                    (Int.= operation 0)
                                                      (Long.+ ia ib)
                                                    (Int.= operation 1)
                                                      (Long.- ia ib)
                                                    (Long.* ia ib))
                                                  0.0))))))
          (Result.Error error) (Result.Error error))
      (Result.Error error) (Result.Error error)))

  (private ct-divide)
  (hidden ct-divide)
  (doc ct-divide "divides `left` by `right` as the reference's `commandDiv`
does: two integral operands use floor division, which Core's dynamic `imod`
relies on, and otherwise it divides as floating.")
  (defn ct-divide [call left right]
    (match (ct-number-argument call left)
      (Result.Success a)
        (match (ct-number-argument call right)
          (Result.Success b)
            (let [width (Int.max @(CtNumber.width &a) @(CtNumber.width &b))]
              (if (Int.>= width 3)
                (Result.Success
                  (syntax-number call
                                 &(CtNumber.init width
                                                 0l
                                                 (Double./ (ct-number-double &a)
                                                           (ct-number-double &b)))))
                (let [ia @(CtNumber.integral &a)
                      ib @(CtNumber.integral &b)]
                  (if (Long.= 0l ib)
                    (Result.Error
                      (error-at call @"compile-time division by zero"))
                    (let [quotient (Long./ ia ib)
                          remainder (Long.mod ia ib)
                          floored (if (and (not (Long.= 0l remainder))
                                           (not (Bool.= (Long.< ia 0l)
                                                        (Long.< ib 0l))))
                            (Long.dec quotient)
                            quotient)]
                      (Result.Success
                        (syntax-number call &(CtNumber.init width floored 0.0))))))))
          (Result.Error error) (Result.Error error))
      (Result.Error error) (Result.Error error)))

  (private symbol-from-value)
  (hidden symbol-from-value)
  (defn symbol-from-value [call value]
    (match (syntax-from-value call value)
      (Result.Success node)
        (match-ref (SurfaceNode.form &node)
          (SurfaceForm.IntLit integer)
            (Result.Success (syntax-symbol call [(Int.str @integer)]))
          (SurfaceForm.StringLit string)
            (Result.Success (syntax-symbol call [@string]))
          _
            (Result.Error
              (error-at call @"Symbol.from expects Int or String syntax")))
      (Result.Error error) (Result.Error error)))

  (private symbol-to-string)
  (hidden symbol-to-string)
  (defn symbol-to-string [call value]
    (match (syntax-from-value call value)
      (Result.Success node)
        (match-ref (SurfaceNode.form &node)
          (SurfaceForm.Symbol segments)
            (Result.Success (syntax-string call &(String.join "." segments)))
          _ (Result.Error (error-at call @"Symbol.str expects symbol syntax")))
      (Result.Error error) (Result.Error error)))

  (private bool-argument)
  (hidden bool-argument)
  (defn bool-argument [call value]
    (match (syntax-from-value call value)
      (Result.Success node)
        (match-ref (SurfaceNode.form &node)
          (SurfaceForm.BoolLit boolean) (Result.Success @boolean)
          _
            (Result.Error
              (error-at call @"compile-time operation expects Bool syntax")))
      (Result.Error error) (Result.Error error)))

  (private dynamic-type)
  (hidden dynamic-type)
  (defn dynamic-type [call value]
    (match-ref value
      (CtValue.Closure _) (Result.Success (syntax-symbol call [@"closure"]))
      (CtValue.Builtin _) (Result.Success (syntax-symbol call [@"fn"]))
      (CtValue.Collection _) (Result.Success (syntax-symbol call [@"array"]))
      (CtValue.Syntax syntax)
        (match-ref (SurfaceNode.form (Box.peek syntax))
          (SurfaceForm.IntLit _) (Result.Success (syntax-symbol call [@"int"]))
          (SurfaceForm.ByteLit _)
            (Result.Success (syntax-symbol call [@"byte"]))
          (SurfaceForm.LongLit _)
            (Result.Success (syntax-symbol call [@"long"]))
          (SurfaceForm.FloatLit _)
            (Result.Success (syntax-symbol call [@"float"]))
          (SurfaceForm.DoubleLit _)
            (Result.Success (syntax-symbol call [@"double"]))
          (SurfaceForm.BoolLit _)
            (Result.Success (syntax-symbol call [@"bool"]))
          (SurfaceForm.CharLit _)
            (Result.Success (syntax-symbol call [@"char"]))
          (SurfaceForm.StringLit _)
            (Result.Success (syntax-symbol call [@"string"]))
          (SurfaceForm.Symbol _)
            (Result.Success (syntax-symbol call [@"symbol"]))
          (SurfaceForm.List _) (Result.Success (syntax-symbol call [@"list"]))
          (SurfaceForm.Array _) (Result.Success (syntax-symbol call [@"array"]))
          (SurfaceForm.StaticArray _)
            (Result.Success (syntax-symbol call [@"array"]))
          (SurfaceForm.Dictionary _)
            (Result.Success (syntax-symbol call [@"array"]))
          (SurfaceForm.Comment _)
            (Result.Success (syntax-symbol call [@"comment"]))
          (SurfaceForm.PatternLit _)
            (Result.Success (syntax-symbol call [@"pattern"])))))

  (private value-at)
  (hidden value-at)
  (defn value-at [call values index]
    (if (and (Int.>= index 0) (Int.< index (Array.length values)))
      (Result.Success (CtValue.copy (Box.peek (Array.unsafe-nth values index))))
      (Result.Error
        (error-at call @"compile-time operation received too few arguments"))))

  (private source-position-node)
  (hidden source-position-node)
  (defn source-position-node [call values]
    (if (Int.= 0 (Array.length values))
      (Result.Success (SurfaceNode.copy call))
      (match (value-at call values 0)
        (Result.Success value) (syntax-from-value call &value)
        (Result.Error error) (Result.Error error))))

  (private symbol-node)
  (hidden symbol-node)
  (defn symbol-node [anchor name]
    (SurfaceNode.generated @(SurfaceNode.span anchor)
                           (SurfaceForm.Symbol [(String.copy name)])))

  (private call-node)
  (hidden call-node)
  (private call-node-with-head)
  (hidden call-node-with-head)
  (defn call-node [anchor head arguments]
    (let-do [items [(Box.init (symbol-node anchor head))]
             n (Array.length arguments)]
      (for [i 0 n]
        (Array.push-back! &items
                          (Box.init
                            (SurfaceNode.copy
                              (Box.peek (Array.unsafe-nth arguments i))))))
      (SurfaceNode.generated @(SurfaceNode.span anchor) (SurfaceForm.List items))))

  (defn call-node-with-head [anchor head arguments]
    (let-do [items [(Box.init (SurfaceNode.copy head))]
             n (Array.length arguments)]
      (for [i 0 n]
        (Array.push-back! &items
                          (Box.init
                            (SurfaceNode.copy
                              (Box.peek (Array.unsafe-nth arguments i))))))
      (SurfaceNode.generated @(SurfaceNode.span anchor) (SurfaceForm.List items))))

  (private ref-node)
  (hidden ref-node)
  (defn ref-node [anchor value]
    (call-node anchor "ref" &[(Box.init (SurfaceNode.copy value))]))

  (private set-ref-node)
  (hidden set-ref-node)
  (defn set-ref-node [anchor name value]
    (call-node anchor
               "set!"
               &[(Box.init (SurfaceNode.copy name))
                 (Box.init (ref-node anchor value))]))

  (private list-with-items)
  (hidden list-with-items)
  (private list-or-collection)
  (hidden list-or-collection)
  (private collection-like)
  (hidden collection-like)
  (defn list-with-items [call items]
    (CtValue.Syntax
      (Box.init
        (SurfaceNode.generated @(SurfaceNode.span call) (SurfaceForm.List items)))))

  (defn list-or-collection [call values]
    (match (syntax-arguments call values)
      (Result.Success items) (list-with-items call items)
      (Result.Error _) (CtValue.Collection @values)))

  (defn collection-like [call prototype values]
    (match-ref prototype
      (CtValue.Collection _) (CtValue.Collection @values)
      (CtValue.Syntax syntax)
        (match-ref (SurfaceNode.form (Box.peek syntax))
          (SurfaceForm.Array _)
            (match (syntax-arguments call values)
              (Result.Success items)
                (CtValue.Syntax
                  (Box.init
                    (SurfaceNode.generated @(SurfaceNode.span call)
                                           (SurfaceForm.Array items))))
              (Result.Error _) (CtValue.Collection @values))
          (SurfaceForm.StaticArray _)
            (match (syntax-arguments call values)
              (Result.Success items)
                (CtValue.Syntax
                  (Box.init
                    (SurfaceNode.generated @(SurfaceNode.span call)
                                           (SurfaceForm.StaticArray items))))
              (Result.Error _) (CtValue.Collection @values))
          _ (list-or-collection call values))
      _ (list-or-collection call values)))

  (private syntax-equal?)
  (private syntax-items-equal?)
  (hidden syntax-items-equal?)
  (sig syntax-equal? (Fn [(Ref SurfaceNode) (Ref SurfaceNode)] Bool))
  (sig syntax-items-equal?
       (Fn
         [(Ref (Array (Box SurfaceNode))) (Ref (Array (Box SurfaceNode)))]
         Bool))
  (hidden syntax-equal?)
  (defn syntax-equal? [left right]
    (match (number-from-node left)
      (Maybe.Just left-number)
        (match (number-from-node right)
          (Maybe.Just right-number) (Double.= left-number right-number)
          (Maybe.Nothing) false)
      (Maybe.Nothing)
        (match-ref (SurfaceNode.form left)
          (SurfaceForm.BoolLit left-value)
          (match-ref (SurfaceNode.form right)
            (SurfaceForm.BoolLit right-value) (Bool.= @left-value @right-value)
            _ false)
          (SurfaceForm.StringLit left-value)
          (match-ref (SurfaceNode.form right)
            (SurfaceForm.StringLit right-value)
              (String.= left-value right-value)
            (SurfaceForm.CharLit right-value)
              (and (Int.= (String.length left-value) 1)
                   (Char.= (String.char-at left-value 0) @right-value))
            _ false)
          (SurfaceForm.CharLit left-value)
          (match-ref (SurfaceNode.form right)
            (SurfaceForm.CharLit right-value) (Char.= @left-value @right-value)
            (SurfaceForm.StringLit right-value)
              (and (Int.= (String.length right-value) 1)
                   (Char.= @left-value (String.char-at right-value 0)))
            _ false)
          (SurfaceForm.Symbol left-segments)
          (match-ref (SurfaceNode.form right)
            (SurfaceForm.Symbol right-segments) (= left-segments right-segments)
            _ false)
          ;; lists and arrays compare structurally, element by element (see
          ;; syntax-items-equal? below); without this `(= value '())` (i.e.
          ;; `nil?`) is never true and dynamic list recursion cannot terminate.
          (SurfaceForm.List left-items)
          (match-ref (SurfaceNode.form right)
            (SurfaceForm.List right-items)
              (syntax-items-equal? left-items right-items)
            _ false)
          (SurfaceForm.Array left-items)
          (match-ref (SurfaceNode.form right)
            (SurfaceForm.Array right-items)
              (syntax-items-equal? left-items right-items)
            _ false)
          _
          false)))

  (defn syntax-items-equal? [left-raw right-raw]
    (let-do [left (semantic-items left-raw)
             right (semantic-items right-raw)
             n (Array.length &left)
             same (Int.= n (Array.length &right))]
      (when same
        (for [i 0 n]
          (unless (syntax-equal? (Box.peek (Array.unsafe-nth &left i))
                                 (Box.peek (Array.unsafe-nth &right i)))
            (set! same false))))
      same))

  (private syntax-item)
  (hidden syntax-item)
  (defn syntax-item [call items index]
    (if (and (Int.>= index 0) (Int.< index (Array.length items)))
      (Result.Success
        (CtValue.Syntax
          (Box.init (SurfaceNode.copy (Box.peek (Array.unsafe-nth items index))))))
      (Result.Error (error-at call @"compile-time list index is out of bounds"))))

  (private list-item-of-collection)
  (hidden list-item-of-collection)
  (defn list-item-of-collection [call value index]
    (let [items-result (collection-values call value)]
      (match-ref &items-result
        (Result.Success items)
          (if (and (Int.>= index 0) (Int.< index (Array.length items)))
            (Result.Success
              (CtValue.copy (Box.peek (Array.unsafe-nth items index))))
            (Result.Error
              (error-at call @"compile-time list index is out of bounds")))
        (Result.Error error) (Result.Error @error))))

  (private list-item)
  (hidden list-item)
  (doc list-item "returns a copy of the item at `index` of a list-like value.")
  (defn list-item [call value index]
    (match-ref value
      (CtValue.Collection values)
        (if (and (Int.>= index 0) (Int.< index (Array.length values)))
          (Result.Success
            (CtValue.copy (Box.peek (Array.unsafe-nth values index))))
          (Result.Error
            (error-at call @"compile-time list index is out of bounds")))
      (CtValue.Syntax syntax)
        (match-ref (SurfaceNode.form (Box.peek syntax))
          (SurfaceForm.List items) (syntax-item call items index)
          (SurfaceForm.Array items) (syntax-item call items index)
          (SurfaceForm.StaticArray items) (syntax-item call items index)
          _ (list-item-of-collection call value index))
      _ (list-item-of-collection call value index)))

  (private copy-children-from)
  (hidden copy-children-from)
  (defn copy-children-from [items start]
    (let-do [result (the (Array (Box SurfaceNode)) [])]
      (for [i (Int.max start 0) (Array.length items)]
        (Array.push-back! &result
                          (Box.init
                            (SurfaceNode.copy (Box.peek (Array.unsafe-nth items
                                                                          i))))))
      result))

  (private list-tail-of-collection)
  (hidden list-tail-of-collection)
  (defn list-tail-of-collection [call value start]
    (let [items-result (collection-values call value)]
      (match-ref &items-result
        (Result.Success items)
          (let-do [result (the (Array (Box CtValue)) [])
                   n (Array.length items)]
            (for [i start n]
              (set! result
                    (Array.push-back result
                                     (Box.init
                                       (CtValue.copy (Box.peek (Array.unsafe-nth items
                                                                                 i)))))))
            (Result.Success (list-or-collection call &result)))
        (Result.Error error) (Result.Error @error))))

  (private list-tail)
  (hidden list-tail)
  (doc list-tail "returns the items of a list-like value from `start` on.")
  (defn list-tail [call value start]
    (match-ref value
      (CtValue.Syntax syntax)
        (match-ref (SurfaceNode.form (Box.peek syntax))
          (SurfaceForm.List items)
            (Result.Success
              (list-with-items call (copy-children-from items start)))
          (SurfaceForm.Array items)
            (Result.Success
              (list-with-items call (copy-children-from items start)))
          (SurfaceForm.StaticArray items)
            (Result.Success
              (list-with-items call (copy-children-from items start)))
          _ (list-tail-of-collection call value start))
      _ (list-tail-of-collection call value start)))

  (private list-prefix)
  (hidden list-prefix)
  (defn list-prefix [call value end]
    (let [items-result (collection-values call value)]
      (match-ref &items-result
        (Result.Success items)
          (let-do [result (the (Array (Box CtValue)) [])]
            (for [i 0 end]
              (set! result
                    (Array.push-back result
                                     (Box.init
                                       (CtValue.copy (Box.peek (Array.unsafe-nth items
                                                                                 i)))))))
            (Result.Success (list-or-collection call &result)))
        (Result.Error error) (Result.Error @error))))

  (private string-argument)
  (hidden string-argument)
  (defn string-argument [call value]
    (match (syntax-from-value call value)
      (Result.Success node)
        (match-ref (SurfaceNode.form &node)
          (SurfaceForm.StringLit string) (Result.Success @string)
          _
            (Result.Error
              (error-at call @"compile-time operation expects String syntax")))
      (Result.Error error) (Result.Error error)))

  (private concat-strings)
  (hidden concat-strings)
  (defn concat-strings [call value]
    (match (collection-values call value)
      (Result.Success values)
        (let-do [parts (the (Result (Array String) CtError) (Result.Success []))
                 n (Array.length &values)]
          (for [i 0 n]
            (match-ref &parts
              (Result.Success strings)
                (match (string-argument call
                                        (Box.peek (Array.unsafe-nth &values i)))
                  (Result.Success string) (Array.push-back! strings string)
                  (Result.Error error) (set! parts (Result.Error error)))
              (Result.Error error) (set! parts (Result.Error @error))))
          (match parts
            (Result.Success strings)
              (let [joined (String.concat &strings)]
                (Result.Success (syntax-string call &joined)))
            (Result.Error error) (Result.Error error)))
      (Result.Error error) (Result.Error error)))

  (private char-argument)
  (hidden char-argument)
  (defn char-argument [call value]
    (match (syntax-from-value call value)
      (Result.Success node)
        (match-ref (SurfaceNode.form &node)
          (SurfaceForm.CharLit character) (Result.Success @character)
          _
            (Result.Error
              (error-at call @"compile-time operation expects Char syntax")))
      (Result.Error error) (Result.Error error)))

  (private load-stack-value)
  (hidden load-stack-value)
  (doc load-stack-value "returns the files being loaded as syntax, innermost
first.")
  (defn load-stack-value [call]
    (let-do [items (the (Array (Box CtValue)) [])
             n (Array.length &*ct-load-stack*)]
      (for [i 0 n]
        (Array.push-back! &items
                          (Box.init
                            (CtValue.Syntax
                              (Box.init
                                (SurfaceNode.generated @(SurfaceNode.span call)
                                                       (SurfaceForm.StringLit
                                                         @(Array.unsafe-nth &*ct-load-stack*
                                                                            (Int.- (Int.dec n)
                                                                                   i)))))))))
      (CtValue.Collection items)))

  (private string-list-syntax)
  (hidden string-list-syntax)
  (doc string-list-syntax "returns `strings` as a list of string literals, or an
array if `array?` is true.")
  (defn string-list-syntax [call strings array?]
    (let-do [items (the (Array (Box SurfaceNode)) [])]
      (for [i 0 (Array.length strings)]
        (Array.push-back! &items
                          (Box.init
                            (SurfaceNode.generated @(SurfaceNode.span call)
                                                   (SurfaceForm.StringLit @(Array.unsafe-nth strings
                                                                                             i))))))
      (CtValue.Syntax
        (Box.init
          (SurfaceNode.generated @(SurfaceNode.span call)
                                 (if array?
                                   (SurfaceForm.Array items)
                                   (SurfaceForm.List items)))))))

  (private config-strings)
  (hidden config-strings)
  (doc config-strings "returns the strings of a list or array of string
literals, or `Nothing` if `node` is anything else.")
  (defn config-strings [node]
    (let-do [items (match-ref (SurfaceNode.form node)
               (SurfaceForm.List items) (Maybe.Just @items)
               (SurfaceForm.Array items) (Maybe.Just @items)
               _ (Maybe.Nothing))
             result (the (Maybe (Array String)) (Maybe.Just []))]
      (match items
        (Maybe.Just nodes)
          (for [i 0 (Array.length &nodes)]
            (match-ref (SurfaceNode.form (Box.peek (Array.unsafe-nth &nodes i)))
              (SurfaceForm.StringLit text)
                (match-ref &result
                  (Maybe.Just strings) (Array.push-back! strings @text)
                  (Maybe.Nothing) ())
              _ (set! result (Maybe.Nothing))))
        (Maybe.Nothing) (set! result (Maybe.Nothing)))
      result))

  (private config-error)
  (hidden config-error)
  (defn config-error [call key message]
    (Result.Error
      (error-at call (fmt "Project.config: the key '%s' %s" key message))))

  (private configure)
  (hidden configure)
  (doc configure "runs `(Project.config key value)`: it records `value` for
`key`, with the reference's rules for what each key takes.")
  (defn configure [call key value]
    (let [kind (config-kind key)
          done (Result.Success (syntax-empty call))]
      (cond
        (Int.= kind -1) (config-error call key "is not a project setting")
        (Int.= kind 4) (config-error call key "is read-only")
        (Int.= kind 2)
          (match (config-strings value)
            (Maybe.Just strings)
              (do
                (cond
                  (String.= key "cflag") (set! *ct-collected-cflags* strings)
                  (String.= key "libflag")
                    (set! *ct-collected-libflags* strings)
                  (set! *ct-pkgconfig-flags* strings))
                done)
            (Maybe.Nothing) (config-error call key "takes a list of strings"))
        (Int.= kind 1)
          (match-ref (SurfaceNode.form value)
            (SurfaceForm.BoolLit _) (do (record-config! key value) done)
            _ (config-error call key "takes a bool"))
        (match-ref (SurfaceNode.form value)
          (SurfaceForm.StringLit text)
            (cond
              ;; search-path and cmod add one string, once
              (Int.= kind 3)
              (let-do [present (match (recorded-config key)
                         (Maybe.Just node)
                           (Maybe.from (config-strings &node) [])
                         (Maybe.Nothing) [])]
                (unless (Array.contains? &present text)
                  (Array.push-back! &present @text))
                (match (string-list-syntax call &present false)
                  (CtValue.Syntax node) (record-config! key (Box.peek &node))
                  _ ())
                done)
              (String.= key "file-path-print-length")
              (if (or (String.= text "short") (String.= text "full"))
                (do
                  (record-config! key
                                  &(SurfaceNode.generated @(SurfaceNode.span value)
                                                          (SurfaceForm.StringLit
                                                            (if (String.= text
                                                                          "short")
                                                              @"ShortPath"
                                                              @"FullPath"))))
                  done)
                (config-error call key "takes \"short\" or \"full\""))
              (do (record-config! key value) done))
          _ (config-error call key "takes a string")))))

  (private configuration)
  (hidden configuration)
  (doc configuration "runs `(Project.get-config key)`: it returns what
`Project.config` last set for `key`, or the reference's default.")
  (defn configuration [call key]
    (let [kind (config-kind key)]
      (cond
        (Int.= kind -1)
          (Result.Error
            (error-at call
                      (fmt
                        "Project.get-config: the key '%s' is not a project setting"
                        key)))
        (String.= key "load-stack") (Result.Success (load-stack-value call))
        (String.= key "cflag")
          (Result.Success (string-list-syntax call &*ct-collected-cflags* false))
        (String.= key "libflag")
          (Result.Success
            (string-list-syntax call &*ct-collected-libflags* false))
        (String.= key "pkgconfigflag")
          (Result.Success (string-list-syntax call &*ct-pkgconfig-flags* true))
        (match (recorded-config key)
          (Maybe.Just node)
            (Result.Success
              (CtValue.Syntax
                (Box.init
                  (SurfaceNode.generated @(SurfaceNode.span call)
                                         @(SurfaceNode.form &node)))))
          (Maybe.Nothing)
            (cond
              (Int.= kind 0)
              (Result.Success
                (syntax-string call
                               &(Maybe.from (config-default-string key) @"")))
              (Int.= kind 1)
              (Result.Success
                (syntax-bool call (Maybe.from (config-default-bool key) false)))
              ;; includes, preproc, search-path and cmod: nothing recorded
              (Result.Success (string-list-syntax call &[] false)))))))

  (private apply-builtin)
  (hidden apply-builtin)
  (defn apply-builtin [call id values]
    (if (CtWork.charge-values! values)
      (cond
        (Int.= id 0)
        (Maybe.Just (Result.Success (load-stack-value call)))
        (Int.= id 1)
        (Maybe.Just (Result.Success (list-or-collection call values)))
        (Int.= id 2)
        (match (syntax-arguments call values)
          (Result.Success items)
            (Maybe.Just
              (Result.Success
                (CtValue.Syntax
                  (Box.init
                    (SurfaceNode.generated @(SurfaceNode.span call)
                                           (SurfaceForm.Array items))))))
          (Result.Error error) (Maybe.Just (Result.Error error)))
        (Int.= id 3)
        (match (value-at call values 0)
          (Result.Success value) (Maybe.Just (symbol-from-value call &value))
          (Result.Error error) (Maybe.Just (Result.Error error)))
        (Int.= id 4)
        (match (value-at call values 0)
          (Result.Success value) (Maybe.Just (concat-symbols call &value))
          (Result.Error error) (Maybe.Just (Result.Error error)))
        (Int.= id 5)
        (match (value-at call values 0)
          (Result.Success left)
            (match (value-at call values 1)
              (Result.Success right)
                (Maybe.Just (prefix-symbols call &left &right))
              (Result.Error error) (Maybe.Just (Result.Error error)))
          (Result.Error error) (Maybe.Just (Result.Error error)))
        (or (Int.= id 6) (Int.= id 7))
        (match (value-at call values 0)
          (Result.Success value) (Maybe.Just (list-item call &value 0))
          (Result.Error error) (Maybe.Just (Result.Error error)))
        (or (Int.= id 8) (Int.= id 9))
        (match (value-at call values 0)
          (Result.Success value) (Maybe.Just (list-tail call &value 1))
          (Result.Error error) (Maybe.Just (Result.Error error)))
        (or (Int.= id 10) (Int.= id 11))
        (match (value-at call values 0)
          (Result.Success value) (Maybe.Just (list-item call &value 1))
          (Result.Error error) (Maybe.Just (Result.Error error)))
        (or (Int.= id 12) (Int.= id 13))
        (match (value-at call values 0)
          (Result.Success value) (Maybe.Just (list-item call &value 2))
          (Result.Error error) (Maybe.Just (Result.Error error)))
        (or (Int.= id 14) (Int.= id 15))
        (match (value-at call values 0)
          (Result.Success value) (Maybe.Just (list-item call &value 3))
          (Result.Error error) (Maybe.Just (Result.Error error)))
        (or (Int.= id 16) (Int.= id 17))
        (match (value-at call values 0)
          (Result.Success value) (Maybe.Just (list-tail call &value 2))
          (Result.Error error) (Maybe.Just (Result.Error error)))
        (or (Int.= id 18) (Int.= id 19))
        (match (value-at call values 0)
          (Result.Success value)
            (match (list-item call &value 1)
              (Result.Success nested) (Maybe.Just (list-item call &nested 0))
              (Result.Error error) (Maybe.Just (Result.Error error)))
          (Result.Error error) (Maybe.Just (Result.Error error)))
        (or (Int.= id 20) (Int.= id 21))
        (match (value-at call values 0)
          (Result.Success value)
            (match (list-item call &value 1)
              (Result.Success nested) (Maybe.Just (list-tail call &nested 1))
              (Result.Error error) (Maybe.Just (Result.Error error)))
          (Result.Error error) (Maybe.Just (Result.Error error)))
        (or (Int.= id 22) (Int.= id 23))
        (match (value-at call values 0)
          (Result.Success value)
            (let [items-result (collection-values call &value)]
              (match-ref &items-result
                (Result.Success items)
                  (Maybe.Just
                    (list-item call &value (Int.dec (Array.length items))))
                (Result.Error error) (Maybe.Just (Result.Error @error))))
          (Result.Error error) (Maybe.Just (Result.Error error)))
        (or (Int.= id 24) (Int.= id 25))
        (match (value-at call values 0)
          (Result.Success value)
            (let [items-result (collection-values call &value)]
              (match-ref &items-result
                (Result.Success items)
                  (Maybe.Just
                    (list-prefix call &value (Int.dec (Array.length items))))
                (Result.Error error) (Maybe.Just (Result.Error @error))))
          (Result.Error error) (Maybe.Just (Result.Error error)))
        (or (Int.= id 26) (Int.= id 27))
        (match (value-at call values 0)
          (Result.Success first)
            (match (value-at call values 1)
              (Result.Success rest)
                (let [items-result (collection-values call &rest)]
                  (match-ref &items-result
                    (Result.Success rest-items)
                      (Maybe.Just
                        (Result.Success
                          (let [combined (append-values [(Box.init first)]
                                                        rest-items)]
                            (list-or-collection call &combined))))
                    (Result.Error error) (Maybe.Just (Result.Error @error))))
              (Result.Error error) (Maybe.Just (Result.Error error)))
          (Result.Error error) (Maybe.Just (Result.Error error)))
        (or (Int.= id 28) (Int.= id 29))
        (match (value-at call values 0)
          (Result.Success last-value)
            (match (value-at call values 1)
              (Result.Success initial)
                (let [items-result (collection-values call &initial)]
                  (match-ref &items-result
                    (Result.Success initial-items)
                      (Maybe.Just
                        (Result.Success
                          (let [combined (Array.push-back @initial-items
                                                          (Box.init last-value))]
                            (list-or-collection call &combined))))
                    (Result.Error error) (Maybe.Just (Result.Error @error))))
              (Result.Error error) (Maybe.Just (Result.Error error)))
          (Result.Error error) (Maybe.Just (Result.Error error)))
        (or (Int.= id 30) (Int.= id 31))
        (match (value-at call values 0)
          (Result.Success left)
            (match (value-at call values 1)
              (Result.Success right)
                (let [left-result (collection-values call &left)
                      right-result (collection-values call &right)]
                  (match-ref &left-result
