                                                       error))))))))
              (Result.Error error) (Maybe.Just (Result.Error error)))
          (Result.Error error) (Maybe.Just (Result.Error error)))
      (named? head @"line")
        (match (source-position-node call values)
          (Result.Success node)
            (Maybe.Just (Result.Success (syntax-int call (source-line &node))))
          (Result.Error error) (Maybe.Just (Result.Error error)))
      (named? head @"column")
        (match (source-position-node call values)
          (Result.Success node)
            (Maybe.Just (Result.Success (syntax-int call (source-column &node))))
          (Result.Error error) (Maybe.Just (Result.Error error)))
      (named? head @"file")
        (Maybe.Just (Result.Success (syntax-string call "unknown")))
      (named? head @"macro-log")
        (Maybe.Just (Result.Success (syntax-empty call)))
      (named? head @"str")
        (match (value-at call values 0)
          (Result.Success value)
            (match (syntax-from-value call &value)
              (Result.Success syntax)
              ;; `str` of a string is the string itself; quoting is `prn`'s job.
              (match-ref (SurfaceNode.form &syntax)
                (SurfaceForm.StringLit text)
                  (Maybe.Just (Result.Success (syntax-string call text)))
                _
                  (let [rendered (str &syntax)]
                    (Maybe.Just (Result.Success (syntax-string call &rendered)))))
              (Result.Error error)
              (Maybe.Just (Result.Error error)))
          (Result.Error error) (Maybe.Just (Result.Error error)))
      (named? head @"hash")
        (match (value-at call values 0)
          (Result.Success value)
            (match (syntax-from-value call &value)
              (Result.Success syntax)
              ;; any deterministic hash works: dynamic maps only need
              ;; internal consistency, and the suite compares unordered.
              (let-do [rendered (str &syntax)
                       hashed 5381
                       n (String.length &rendered)]
                (for [i 0 n]
                  (set! hashed
                        (Int.bit-and 1073741823
                                     (Int.+ (Int.* hashed 33)
                                            (Char.to-int (String.char-at &rendered
                                                                         i))))))
                (Maybe.Just (Result.Success (syntax-int call hashed))))
              (Result.Error error)
              (Maybe.Just (Result.Error error)))
          (Result.Error error) (Maybe.Just (Result.Error error)))
      (named? head @"macro-error")
        (match (value-at call values 0)
          (Result.Success value)
            (match (string-argument call &value)
              (Result.Success message)
                (Maybe.Just (Result.Error (error-at call message)))
              (Result.Error error) (Maybe.Just (Result.Error error)))
          (Result.Error error) (Maybe.Just (Result.Error error)))
      (Maybe.Nothing)))

  (private apply-builtin-name)
  (hidden apply-builtin-name)
  (defn apply-builtin-name [call name values]
    (let [head (SurfaceNode.init @(SurfaceNode.span call)
                                 (SurfaceForm.Symbol [@name]))]
      (apply-builtin call &head values)))

  (private builtin-name?)
  (hidden builtin-name?)
  (private sexpr-for-binding)
  (hidden sexpr-for-binding)
  (private sexpr-from-value)
  (hidden sexpr-from-value)
  (private apply-function-value)
  (hidden apply-function-value)
  (private applied-call-syntax)
  (hidden applied-call-syntax)
  (private expand-known-syntax)
  (hidden expand-known-syntax)
  (private eval-apply)
  (hidden eval-apply)
  (private eval-expand)
  (hidden eval-expand)
  (private eval-compose)
  (hidden eval-compose)
  (private eval-let-do)
  (hidden eval-let-do)
  (private eval-for)
  (hidden eval-for)
  (defn builtin-name? [call name]
    (let [values (the (Array (Box CtValue)) [])]
      (match (apply-builtin-name call name &values)
        (Maybe.Just _) true
        (Maybe.Nothing) false)))

  (defn sexpr-for-binding [state frame body binding]
    (let [binding-name (String.concat &[@"__sexpr_" (String.copy binding)])]
      (match (lookup-status state frame &binding-name)
        (CtEnvLookup.Found cell)
          (match (read-cell state &cell)
            (Maybe.Just value) (Result.Success value)
            (Maybe.Nothing)
              (Result.Error (error-at body @"s-expr: invalid cell")))
        _
          (Result.Error
            (error-at body
                      (String.append "unknown compile-time symbol: " binding))))))

  (defn sexpr-from-value [state frame body value]
    (match (syntax-from-value body value)
      (Result.Success node)
        (match (symbol-key &node)
          (Maybe.Just binding) (sexpr-for-binding state frame body &binding)
          (Maybe.Nothing)
            (Result.Error (error-at body @"s-expr expects a symbol")))
      (Result.Error error) (Result.Error error)))

  (defn eval-compose [body items state frame]
    (if (Int.= 3 (Array.length items))
      (let [f-form (Box.peek (Array.unsafe-nth items 1))
            g-form (Box.peek (Array.unsafe-nth items 2))]
        (match (symbol-key g-form)
          (Maybe.Just g-name)
            (match (sexpr-for-binding state frame body &g-name)
              (Result.Success g-source)
                (match (list-item body &g-source 2)
                  (Result.Success parameters-value)
                    (match (syntax-from-value body &parameters-value)
                      (Result.Success parameters)
                        (let [quoted-parameters (call-node body
                                                           "quote"
                                                           &[(Box.init (SurfaceNode.copy &parameters))])
                              apply-call (call-node body
                                                    "apply"
                                                    &[(Box.init (SurfaceNode.copy g-form))
                                                      (Box.init quoted-parameters)])
                              eval-call (call-node body
                                                   "eval"
                                                   &[(Box.init apply-call)])
                              composed-body (call-node-with-head body
                                                                 f-form
                                                                 &[(Box.init eval-call)])
                              fn-node (call-node body
                                                 "fn"
                                                 &[(Box.init parameters)
                                                   (Box.init composed-body)])]
                          (Result.Success (CtValue.Syntax (Box.init fn-node))))
                      (Result.Error error) (Result.Error error))
                  (Result.Error error) (Result.Error error))
              (Result.Error error) (Result.Error error))
          (Maybe.Nothing)
            (Result.Error
              (error-at g-form @"Dynamic.compose expects named functions"))))
      (Result.Error (error-at body @"Dynamic.compose expects two functions"))))

  (sig macro-closure-for
       (Fn [(Ref SurfaceNode) (Ref CtState) (Ref FrameId)] (Maybe CtClosure)))
  (sig apply-ct-macro
       (Fn
         [(Ref SurfaceNode)
          (Ref CtClosure)
          (Ref (Array (Box SurfaceNode)))
          (Ref CtState)
          (Ref FrameId)]
         (Result CtValue CtError)))
  (sig apply-macro-to-values
       (Fn
         [(Ref SurfaceNode)
          (Ref CtClosure)
          (Ref (Array (Box CtValue)))
          (Ref CtState)
          (Ref FrameId)]
         (Result CtValue CtError)))
  (sig eval-closure-body
       (Fn
         [(Ref CtClosure) (Ref CtState) (Ref FrameId)]
         (Result CtValue CtError)))

  (doc eval-value "evaluates a compile-time expression to syntax, a lexical
closure, or a collection of compile-time values. It never evaluates target
program code.")
  (defn eval-value [body state frame]
    (let-do [_step (when-do *ct-tracing*
               (record-step! body state frame)
               (set! *ct-depth* (Int.inc *ct-depth*)))
             result (match (symbol-key body)
               (Maybe.Just name)
                 (match (lookup-status state frame &name)
                   (CtEnvLookup.Found cell)
                     (match (read-cell state &cell)
                       (Maybe.Just value) (Result.Success value)
                       (Maybe.Nothing)
                         (Result.Error
                           (error-at body @"invalid compile-time cell")))
                   (CtEnvLookup.Ambiguous)
                     (Result.Error
                       (error-at body
                                 (String.append "ambiguous compile-time binding: "
                                                &name)))
                   (CtEnvLookup.Missing)
                     (if (builtin-name? body &name)
                       (Result.Success (CtValue.Builtin name))
                       (Result.Error
                         (error-at body
                                   (String.append "unknown compile-time symbol: "
                                                  &name)))))
               (Maybe.Nothing)
                 (match-ref (SurfaceNode.form body)
                   (SurfaceForm.List items)
                   (if (Int.= 0 (Array.length items))
                     (Result.Success
                       (CtValue.Syntax (Box.init (SurfaceNode.copy body))))
                     (let [head (Box.peek (Array.unsafe-nth items 0))]
                       (cond
                         (named? head @"quote")
                         (if (Int.= 2 (Array.length items))
                           (Result.Success
                             (CtValue.Syntax
                               (Box.init
                                 (SurfaceNode.copy (Box.peek (Array.unsafe-nth items
                                                                               1))))))
                           (Result.Error
                             (error-at body @"quote expects one argument")))
                         (named? head @"apply")
                         (let [apply-items (semantic-items items)]
                           (eval-apply body &apply-items state frame))
                         (named? head @"expand")
                         (let [expand-items (semantic-items items)]
                           (eval-expand body &expand-items state frame))
                         ;; `eval` runs a compile-time expression: evaluate the argument
                         ;; to a value, and if that value is a piece of syntax (a form),
                         ;; evaluate the form itself.
                         (named? head @"eval")
                         (let [eval-items (semantic-items items)]
                           (if (Int.= 2 (Array.length &eval-items))
                             (match (eval-value
                                 (Box.peek (Array.unsafe-nth &eval-items 1))
                                 state
                                 frame)
                               (Result.Success evaluated)
                                 (match evaluated
                                   (CtValue.Syntax node)
                                     (let [syntax (Box.peek &node)]
                                       (match (symbol-key syntax)
                                         (Maybe.Just syntax-name)
                                           (match (lookup-status state
                                                                 frame
                                                                 &syntax-name)
                                             (CtEnvLookup.Missing)
                                               (if (builtin-name? syntax
                                                                  &syntax-name)
                                                 (eval-value syntax state frame)
                                                 (Result.Success
                                                   (CtValue.Syntax (Box.init (SurfaceNode.copy syntax)))))
                                             _ (eval-value syntax state frame))
                                         (Maybe.Nothing)
                                           (eval-value syntax state frame)))
                                   other (Result.Success other))
                               (Result.Error error) (Result.Error error))
                             (Result.Error
                               (error-at body @"eval expects one argument"))))
                         ;; `members` returns a type's members as `[[name type] ...]`.
                         ;; The expander records them under `__members_<TypeName>` when it
                         ;; sees the `deftype`; the argument is an unevaluated type symbol.
                         (named? head @"members")
                         (if (Int.= 2 (Array.length items))
                           (match (symbol-key (Box.peek (Array.unsafe-nth items
                                                                          1)))
                             (Maybe.Just type-name)
                               (let [binding-name (String.concat
                                       &[@"__members_" (String.copy &type-name)])]
                                 (match (lookup-status state frame &binding-name)
                                   (CtEnvLookup.Found cell)
                                     (match (read-cell state &cell)
                                       (Maybe.Just value) (Result.Success value)
                                       (Maybe.Nothing)
                                         (Result.Error (error-at body
                                                                 @"members: invalid cell")))
                                   _
                                     (Result.Error
                                       (error-at body
                                                 (String.append "not a type: "
                                                                &type-name)))))
                             (Maybe.Nothing)
                               (Result.Error
                                 (error-at body @"members expects a type symbol")))
                           (Result.Error
                             (error-at body @"members expects one argument")))
                         (named? head @"managed?")
                         (if (Int.= 2 (Array.length items))
                           (match (symbol-key (Box.peek (Array.unsafe-nth items
                                                                          1)))
                             (Maybe.Just type-name)
                               (let [binding-name (String.concat
                                       &[@"__managed_" (String.copy &type-name)])]
                                 (match (lookup-status state frame &binding-name)
                                   (CtEnvLookup.Found _)
                                     (Result.Success (syntax-bool body true))
                                   _ (Result.Success (syntax-bool body false))))
                             (Maybe.Nothing)
                               (Result.Error
                                 (error-at body
                                           @"managed? expects a type symbol")))
                           (Result.Error
                             (error-at body @"managed? expects one argument")))
                         (named? head @"s-expr")
                         (if (Int.= 2 (Array.length items))
                           (let [argument (Box.peek (Array.unsafe-nth items 1))]
                             (match (symbol-key argument)
                               (Maybe.Just binding)
                                 (match (lookup-status state frame &binding)
                                   (CtEnvLookup.Found _)
                                     (match (eval-value argument state frame)
                                       (Result.Success value)
                                         (sexpr-from-value state
                                                           frame
                                                           body
                                                           &value)
                                       (Result.Error error) (Result.Error error))
                                   (CtEnvLookup.Ambiguous)
                                     (Result.Error
                                       (error-at body
                                                 (String.append "ambiguous compile-time binding: "
                                                                &binding)))
                                   (CtEnvLookup.Missing)
                                     (sexpr-for-binding state
                                                        frame
                                                        body
                                                        &binding))
                               (Maybe.Nothing)
                                 (match (eval-value argument state frame)
                                   (Result.Success value)
                                     (sexpr-from-value state frame body &value)
                                   (Result.Error error) (Result.Error error))))
                           (Result.Error
                             (error-at body @"s-expr expects one argument")))
                         (named? head @"use")
                         (if (Int.= 2 (Array.length items))
                           (let [target (Box.peek (Array.unsafe-nth items 1))]
                             (match (symbol-key target)
                               (Maybe.Just path)
                                 (match (module-frame state &path)
                                   (Maybe.Just imported)
                                     (if (import! state frame &imported)
                                       (Result.Success (syntax-empty body))
                                       (Result.Error
                                         (error-at target
                                                   @"invalid compile-time module frame")))
                                   (Maybe.Nothing)
                                     (Result.Error
                                       (error-at target
                                                 (String.append "unknown compile-time module: "
                                                                &path))))
                               (Maybe.Nothing)
                                 (Result.Error
                                   (error-at target
                                             @"use expects a module symbol"))))
                           (Result.Error
                             (error-at body @"use expects one module")))
                         (named? head @"Dynamic.compose")
                         (let [compose-items (semantic-items items)]
                           (eval-compose body &compose-items state frame))
                         (named? head @"fn")
                         (let [fn-items (semantic-items items)]
                           (if (Int.= 3 (Array.length &fn-items))
                             (let [parameters (Box.peek (Array.unsafe-nth &fn-items
                                                                          1))
                                   fn-body (Box.peek (Array.unsafe-nth &fn-items
                                                                       2))]
                               (define-function parameters fn-body frame))
                             (Result.Error
                               (error-at body
                                         @"fn expects parameters and a body"))))
                         (named? head @"do")
                         (let-do [result (the (Result CtValue CtError)
                                              (Result.Success
                                                (CtValue.Syntax (Box.init (SurfaceNode.copy body)))))
                                  n (Array.length items)]
                           (for [i 1 n]
                             (match-ref &result
                               (Result.Success _)
                                 (set! result
                                       (eval-value (Box.peek (Array.unsafe-nth items
                                                                               i))
                                                   state
                                                   frame))
                               (Result.Error error)
                                 (set! result (Result.Error @error))))
                           result)
                         (named? head @"let-do")
                         (eval-let-do body items state frame)
                         (named? head @"if")
                         (let [if-items (semantic-items items)]
                           (if (Int.= 4 (Array.length &if-items))
                             (let [condition (Box.peek (Array.unsafe-nth &if-items
                                                                         1))
                                   then-branch (Box.peek (Array.unsafe-nth &if-items
                                                                           2))
                                   else-branch (Box.peek (Array.unsafe-nth &if-items
                                                                           3))]
                               (match (eval-value condition state frame)
                                 (Result.Success condition-value)
                                   (match-ref &condition-value
                                     (CtValue.Syntax syntax)
                                       (match-ref (SurfaceNode.form (Box.peek syntax))
                                         (SurfaceForm.BoolLit value)
                                           (if @value
                                             (eval-value then-branch state frame)
                                             (eval-value else-branch state frame))
                                         _
                                           (Result.Error
                                             (error-at condition
                                                       @"compile-time if condition must evaluate to Bool syntax")))
                                     _
                                       (Result.Error
                                         (error-at condition
                                                   @"compile-time if condition must evaluate to Bool syntax")))
                                 (Result.Error error) (Result.Error error)))
                             (Result.Error
                               (error-at body
                                         @"if expects condition, then, and else forms"))))
                         (named? head @"when")
                         (if (Int.= 3 (Array.length items))
                           (let [condition (Box.peek (Array.unsafe-nth items 1))
                                 then-branch (Box.peek (Array.unsafe-nth items 2))]
                             (match (eval-value condition state frame)
                               (Result.Success condition-value)
                                 (match (bool-argument condition
                                                       &condition-value)
                                   (Result.Success value)
                                     (if value
                                       (eval-value then-branch state frame)
                                       (Result.Success (syntax-empty body)))
                                   (Result.Error error) (Result.Error error))
                               (Result.Error error) (Result.Error error)))
                           (Result.Error
                             (error-at body
                                       @"when expects a condition and a body")))
                         (named? head @"and")
                         (let-do [result (the (Result CtValue CtError)
                                              (Result.Success (syntax-bool body
                                                                           true)))
                                  stopped false
                                  n (Array.length items)]
                           (for [i 1 n]
                             (match-ref &result
                               (Result.Success _)
                                 (unless stopped
                                   (let [form (Box.peek (Array.unsafe-nth items
                                                                          i))]
                                     (match (eval-value form state frame)
                                       (Result.Success value)
                                         (if (Int.= i (Int.dec n))
                                           (set! result (Result.Success value))
                                           (match (bool-argument form &value)
                                             (Result.Success boolean)
                                               (unless-do boolean
                                                 (set! result
                                                       (Result.Success value))
                                                 (set! stopped true))
                                             (Result.Error error)
                                               (set! result (Result.Error error))))
                                       (Result.Error error)
                                         (set! result (Result.Error error)))))
                               (Result.Error error)
                                 (set! result (Result.Error @error))))
                           result)
                         (named? head @"or")
                         (let-do [result (the (Result CtValue CtError)
                                              (Result.Success (syntax-bool body
                                                                           false)))
                                  stopped false
                                  n (Array.length items)]
                           (for [i 1 n]
                             (match-ref &result
                               (Result.Success _)
                                 (unless stopped
                                   (let [form (Box.peek (Array.unsafe-nth items
                                                                          i))]
                                     (match (eval-value form state frame)
                                       (Result.Success value)
                                         (if (Int.= i (Int.dec n))
                                           (set! result (Result.Success value))
                                           (match (bool-argument form &value)
                                             (Result.Success boolean)
                                               (when-do boolean
                                                 (set! result
                                                       (Result.Success value))
                                                 (set! stopped true))
                                             (Result.Error error)
                                               (set! result (Result.Error error))))
                                       (Result.Error error)
                                         (set! result (Result.Error error)))))
                               (Result.Error error)
                                 (set! result (Result.Error @error))))
                           result)
                         (named? head @"set!")
                         (if (Int.= 3 (Array.length items))
                           (let [target (Box.peek (Array.unsafe-nth items 1))
                                 value-node (Box.peek (Array.unsafe-nth items 2))]
                             (match (symbol-key target)
                               (Maybe.Just target-name)
                                 (match (eval-value value-node state frame)
                                   (Result.Success value)
                                     (if (CtEnv.set! (CtState.environment state)
                                                     frame
                                                     &target-name
                                                     (CtValue.copy &value))
                                       (Result.Success value)
                                       (Result.Error
                                         (error-at target
                                                   (String.append "unknown compile-time set! target: "
                                                                  &target-name))))
                                   (Result.Error error) (Result.Error error))
                               (Maybe.Nothing)
                                 (Result.Error
                                   (error-at target
                                             @"set! target must be a symbol"))))
                           (Result.Error
                             (error-at body @"set! expects a name and a value")))
                         (named? head @"let")
                         (if (Int.= 3 (Array.length items))
                           (let [binding-form (Box.peek (Array.unsafe-nth items
                                                                          1))
                                 let-body (Box.peek (Array.unsafe-nth items 2))]
                             (match-ref (SurfaceNode.form binding-form)
                               (SurfaceForm.Array pair)
                                 (let [binding-items (semantic-items pair)]
                                   (if (Int.= (mod (Array.length &binding-items)
                                                   2)
                                              0)
                                     (let-do [let-frame (child! state frame)
                                              failure (the (Maybe CtError)
                                                           (Maybe.Nothing))
                                              n (Array.length &binding-items)]
                                       (for [binding-index 0 (/ n 2)]
                                         (match-ref &failure
                                           (Maybe.Nothing)
                                             (let [index (* binding-index 2)
                                                   name-form (Box.peek (Array.unsafe-nth &binding-items
                                                                                         index))
                                                   value-form (Box.peek
                                                     (Array.unsafe-nth &binding-items
                                                                       (Int.inc index)))]
                                               (match (symbol-name name-form)
                                                 (Maybe.Just name)
                                                   (match (eval-value value-form
                                                                      state
                                                                      &let-frame)
                                                     (Result.Success value)
                                                       (ignore (define! state
                                                                        &let-frame
                                                                        &name
                                                                        value))
                                                     (Result.Error error)
                                                       (set! failure
                                                             (Maybe.Just error)))
                                                 (Maybe.Nothing)
                                                   (set! failure
                                                         (Maybe.Just
                                                           (error-at name-form
                                                                     @"compile-time let binding must have a symbol name")))))
                                           (Maybe.Just _) ()))
                                       (match failure
                                         (Maybe.Nothing)
                                           (eval-value let-body state &let-frame)
                                         (Maybe.Just error) (Result.Error error)))
                                     (Result.Error
                                       (error-at binding-form
                                                 @"compile-time let bindings must contain name/value pairs"))))
                               _
                                 (Result.Error
                                   (error-at binding-form
                                             @"compile-time let bindings must be an array"))))
                           (Result.Error
                             (error-at body @"let expects bindings and a body")))
                         (named? head @"while")
                         (if (Int.= 3 (Array.length items))
                           (let [condition (Box.peek (Array.unsafe-nth items 1))
                                 loop-body (Box.peek (Array.unsafe-nth items 2))]
                             (let-do [result (the (Result CtValue CtError)
                                                  (Result.Success (syntax-empty body)))
                                      running true]
                               (while-do running
                                 (match-ref &result
                                   (Result.Success _)
                                     (match (eval-value condition state frame)
                                       (Result.Success condition-value)
                                         (match (bool-argument condition
                                                               &condition-value)
                                           (Result.Success boolean)
                                             (if boolean
                                               (match (eval-value loop-body
                                                                  state
                                                                  frame)
                                                 (Result.Success _) ()
                                                 (Result.Error error)
                                                   (do
                                                     (set! result
                                                           (Result.Error error))
                                                     (set! running false)))
                                               (set! running false))
                                           (Result.Error error)
                                             (do
                                               (set! result (Result.Error error))
                                               (set! running false)))
                                       (Result.Error error)
                                         (do
                                           (set! result (Result.Error error))
                                           (set! running false)))
                                   (Result.Error _) (set! running false)))
                               result))
                           (Result.Error
                             (error-at body
                                       @"while expects a condition and a body")))
                         (named? head @"for")
                         (eval-for body items state frame)
                         (named? head @"case")
                         (if (Int.> (Array.length items) 2)
                           (let [target-form (Box.peek (Array.unsafe-nth items 1))]
                             (match (eval-value target-form state frame)
                               (Result.Success target-value)
                                 (match (syntax-from-value target-form
                                                           &target-value)
                                   (Result.Success target)
                                     (let-do [result (the (Result CtValue
                                                                  CtError)
                                                          (Result.Error
                                                            (error-at body
                                                                      @"compile-time case has no matching branch")))
                                              expect-pattern true
                                              take-branch false
                                              settled false
                                              n (Array.length items)]
                                       (for [i 2 n]
                                         (match-ref &result
                                           (Result.Success _) ()
                                           (Result.Error _)
                                             (unless settled
                                               (let [form (Box.peek (Array.unsafe-nth items
                                                                                      i))]
                                                 (cond
                                                   expect-pattern
                                                     (if (Int.= i (Int.dec n))
                                                       (do
                                                         (set! result
                                                               (eval-value form
                                                                           state
                                                                           frame))
                                                         (set! settled true))
                                                       (match (eval-value form
                                                                          state
                                                                          frame)
                                                         (Result.Success candidate-value)
                                                           (match (syntax-from-value form
                                                                                     &candidate-value)
                                                             (Result.Success candidate)
                                                               (do
                                                                 (set! take-branch
                                                                       (syntax-equal? &target
                                                                                      &candidate))
                                                                 (set! expect-pattern
                                                                       false))
                                                             (Result.Error error)
                                                               (set! result
                                                                     (Result.Error error)))
                                                         (Result.Error error)
                                                           (set! result
                                                                 (Result.Error error))))
                                                   take-branch
                                                     (do
                                                       (set! result
                                                             (eval-value form
                                                                         state
                                                                         frame))
                                                       (set! settled true))
                                                   (set! expect-pattern true))))))
                                       result)
                                   (Result.Error error) (Result.Error error))
                               (Result.Error error) (Result.Error error)))
                           (Result.Error
                             (error-at body @"case expects a value and branches")))
                         (named? head @"cond")
                         (let-do [result (the (Result CtValue CtError)
                                              (Result.Success
                                                (CtValue.Syntax (Box.init (SurfaceNode.copy body)))))
                                  expect-condition true
                                  take-branch false
                                  settled false
                                  n (Array.length items)]
                           (for [i 1 n]
                             (match-ref &result
                               (Result.Success _)
                                 (unless settled
                                   (let [form (Box.peek (Array.unsafe-nth items
                                                                          i))]
                                     (cond
                                       expect-condition
                                         (if (Int.= i (Int.dec n))
                                           (do
                                             (set! result
                                                   (eval-value form state frame))
                                             (set! settled true))
                                           (match (eval-value form state frame)
                                             (Result.Success condition)
                                               (match (bool-argument form
                                                                     &condition)
                                                 (Result.Success boolean)
                                                   (do
                                                     (set! take-branch boolean)
                                                     (set! expect-condition
                                                           false))
                                                 (Result.Error error)
                                                   (set! result
                                                         (Result.Error error)))
                                             (Result.Error error)
                                               (set! result (Result.Error error))))
                                       take-branch
                                         (do
                                           (set! result
                                                 (eval-value form state frame))
                                           (set! settled true))
                                       (set! expect-condition true))))
                               (Result.Error error)
                                 (set! result (Result.Error @error))))
                           result)
                         (named? head @"with-test-internal")
                         (eval-with-test-internal body items state frame)
                         (named? head @"concat")
                         (if (Int.= 3 (Array.length items))
                           (let [left (Box.peek (Array.unsafe-nth items 1))
                                 right (Box.peek (Array.unsafe-nth items 2))]
                             (match (eval-value left state frame)
                               (Result.Success left-value)
                                 (match (eval-value right state frame)
                                   (Result.Success right-value)
                                     (match-ref &left-value
                                       (CtValue.Collection left-items)
                                         (match-ref &right-value
                                           (CtValue.Collection right-items)
                                             (let-do [items @left-items
                                                      n (Array.length right-items)]
                                               (for [i 0 n]
                                                 (set! items
                                                       (Array.push-back items
                                                                        (Box.init
                                                                          (CtValue.copy
                                                                            (Box.peek (Array.unsafe-nth right-items
                                                                                                        i)))))))
                                               (Result.Success (CtValue.Collection items)))
                                           _
                                             (Result.Error
                                               (error-at right
                                                         @"concat expects compile-time collections")))
                                       _
                                         (Result.Error
                                           (error-at left
                                                     @"concat expects compile-time collections")))
                                   (Result.Error error) (Result.Error error))
                               (Result.Error error) (Result.Error error)))
                           (Result.Error
                             (error-at body @"concat expects two collections")))
                         (match (the (Maybe CtClosure)
                                     (macro-closure-for head state frame))
                           (Maybe.Just macro-closure)
                             (apply-ct-macro body
                                             &macro-closure
                                             items
                                             state
                                             frame)
                           (Maybe.Nothing)
                             (let-do [arguments (the (Result (Array (Box CtValue))
                                                             CtError)
                                                     (Result.Success []))
                                      n (Array.length items)]
                               (for [i 1 n]
                                 (match-ref &arguments
                                   (Result.Success values)
                                     (let [argument (Box.peek (Array.unsafe-nth items
                                                                                i))]
                                       (match (match (symbol-key argument)
                                           (Maybe.Just name)
                                             (if (or (named? head
                                                             @"Dynamic.compose")
                                                     (and (named? head
                                                                  @"Dynamic.curry*")
                                                          (Int.= i 1)))
                                               (match (sexpr-for-binding state
                                                                         frame
                                                                         body
                                                                         &name)
                                                 (Result.Success value)
                                                   (Result.Success value)
                                                 (Result.Error _)
                                                   (eval-value argument
                                                               state
                                                               frame))
                                               (match (lookup-status state
                                                                     frame
                                                                     &name)
                                                 (CtEnvLookup.Missing)
                                                   (if (builtin-name? argument
                                                                      &name)
                                                     (eval-value argument
                                                                 state
                                                                 frame)
                                                     (Result.Success
                                                       (CtValue.Syntax (Box.init (SurfaceNode.copy argument)))))
                                                 _
                                                   (eval-value argument
                                                               state
                                                               frame)))
                                           (Maybe.Nothing)
                                             (eval-value argument state frame))
                                         (Result.Success value)
                                           (set! arguments
                                                 (Result.Success
                                                   (Array.push-back @values
                                                                    (Box.init value))))
                                         (Result.Error error)
                                           (set! arguments (Result.Error error))))
                                   (Result.Error error)
                                     (set! arguments (Result.Error @error))))
                               (match arguments
                                 (Result.Success values)
                                   (match (apply-builtin body head &values)
                                     (Maybe.Just builtin-result) builtin-result
                                     (Maybe.Nothing)
                                       (match (symbol-key head)
                                         (Maybe.Just function-name)
                                           (match (lookup-status state
                                                                 frame
                                                                 &function-name)
                                             (CtEnvLookup.Found cell)
                                               (match (read-cell state &cell)
                                                 (Maybe.Just function-value)
                                                   (match function-value
                                                     (CtValue.Closure closure)
                                                     (match (bind-closure body
                                                                          state
                                                                          (Box.peek &closure)
                                                                          &values)
                                                       (Result.Success closure-frame)
                                                         (match (eval-closure-body (Box.peek &closure)
                                                                                   state
                                                                                   &closure-frame)
                                                           (Result.Success value)
                                                             (Result.Success value)
                                                           (Result.Error error)
                                                             (Result.Error error))
                                                       (Result.Error error)
                                                         (Result.Error error))
                                                     (CtValue.Builtin builtin-name)
                                                     (match (apply-builtin-name body
                                                                                &builtin-name
                                                                                &values)
                                                       (Maybe.Just result)
                                                         result
                                                       (Maybe.Nothing)
                                                         (Result.Error
                                                           (error-at body
                                                                     @"unknown compile-time builtin")))
                                                     ;; a parameter bound to function-naming
                                                     ;; syntax (e.g. a macro receiving
                                                     ;; `list-equal-unordered`) resolves
                                                     ;; through evaluation before applying.
                                                     (CtValue.Syntax function-syntax)
                                                     (match (eval-value (Box.peek &function-syntax)
                                                                        state
                                                                        frame)
                                                       (Result.Success resolved)
                                                         (match resolved
                                                           (CtValue.Closure resolved-closure)
                                                             (match (bind-closure body
                                                                                  state
                                                                                  (Box.peek &resolved-closure)
                                                                                  &values)
                                                               (Result.Success resolved-frame)
                                                                 (eval-closure-body (Box.peek &resolved-closure)
                                                                                    state
                                                                                    &resolved-frame)
                                                               (Result.Error error)
                                                                 (Result.Error error))
                                                           (CtValue.Builtin resolved-builtin)
                                                             (match (apply-builtin-name body
                                                                                        &resolved-builtin
                                                                                        &values)
                                                               (Maybe.Just result)
                                                                 result
                                                               (Maybe.Nothing)
                                                                 (Result.Error
                                                                   (error-at body
                                                                             @"unknown compile-time builtin")))
                                                           (CtValue.Macro resolved-macro)
                                                             (apply-macro-to-values body
                                                                                    (Box.peek &resolved-macro)
                                                                                    &values
                                                                                    state
                                                                                    frame)
                                                           _
                                                             (Result.Error
                                                               (error-at body
                                                                         @"compile-time application expects a function")))
                                                       (Result.Error error)
                                                         (Result.Error error))
                                                     (CtValue.Macro cell-macro)
                                                     (apply-macro-to-values body
                                                                            (Box.peek &cell-macro)
                                                                            &values
                                                                            state
                                                                            frame)
                                                     _
                                                     (Result.Error
                                                       (error-at body
                                                                 @"compile-time application expects a function")))
                                                 (Maybe.Nothing)
                                                   (Result.Error
                                                     (error-at body
                                                               @"invalid compile-time cell")))
                                             (CtEnvLookup.Ambiguous)
                                               (Result.Error
                                                 (error-at body
                                                           (String.append "ambiguous compile-time function: "
                                                                          &function-name)))
                                             (CtEnvLookup.Missing)
                                               (Result.Error
                                                 (error-at body
                                                           (String.append "unknown compile-time function: "
                                                                          &function-name))))
                                         (Maybe.Nothing)
                                           (match (eval-value head state frame)
                                             (Result.Success function-value)
                                               (apply-function-value body
                                                                     &function-value
                                                                     &values
                                                                     state
                                                                     frame)
                                             (Result.Error error)
                                               (Result.Error error))))
                                 (Result.Error error) (Result.Error error)))))))
                   (SurfaceForm.Array items)
                   (let-do [result (the (Result (Array (Box CtValue)) CtError)
                                        (Result.Success []))
                            n (Array.length items)]
                     (for [i 0 n]
                       (match-ref &result
                         (Result.Success values)
                           (match (eval-value (Box.peek (Array.unsafe-nth items
                                                                          i))
                                              state
                                              frame)
                             (Result.Success value)
                               (set! result
                                     (Result.Success
                                       (Array.push-back @values (Box.init value))))
                             (Result.Error error)
                               (set! result (Result.Error error)))
                         (Result.Error error)
                           (set! result (Result.Error @error))))
                     (match result
                       (Result.Success values)
                         (Result.Success (CtValue.Collection values))
                       (Result.Error error) (Result.Error error)))
                   ;; `{k v ...}` desugars to `(Map.from-array [(Pair.init k v) ...])`,
                   ;; exactly like the reference parser; in dynamic code the call then
                   ;; resolves through the `Dynamic` module.
                   (SurfaceForm.Dictionary entries)
                   (let [pairs (semantic-items entries)]
                     (if (Int./= 0 (Int.mod (Array.length &pairs) 2))
                       (Result.Error
                         (error-at body
                                   @"dictionary literal needs an even number of forms"))
                       (let-do [span @(SurfaceNode.span body)
                                pair-nodes (the (Array (Box SurfaceNode)) [])
                                n (Array.length &pairs)
                                i 0]
                         (while-do (Int.< i n)
                           (Array.push-back! &pair-nodes
                                             (Box.init
                                               (SurfaceNode.init @&span
                                                                 (SurfaceForm.List
                                                                   [(Box.init
                                                                      (SurfaceNode.init @&span
                                                                                        (SurfaceForm.Symbol [@"Pair"
                                                                                                             @"init"])))
                                                                    (Box.init
                                                                      (SurfaceNode.copy (Box.peek (Array.unsafe-nth &pairs
                                                                                                                    i))))
                                                                    (Box.init
                                                                      (SurfaceNode.copy
                                                                        (Box.peek (Array.unsafe-nth &pairs
                                                                                                    (Int.inc i)))))]))))
                           (set! i (Int.+ i 2)))
                         (eval-value
                           &(SurfaceNode.init @&span
                                              (SurfaceForm.List
                                                [(Box.init
                                                   (SurfaceNode.init @&span
                                                                     (SurfaceForm.Symbol [@"Map"
                                                                                          @"from-array"])))
                                                 (Box.init
                                                   (SurfaceNode.init @&span
                                                                     (SurfaceForm.Array pair-nodes)))]))
                           state
                           frame))))
                   _
                   (Result.Success
                     (CtValue.Syntax (Box.init (SurfaceNode.copy body))))))]
      (when *ct-tracing* (set! *ct-depth* (Int.dec *ct-depth*)))
      result))

  (private eval-closure-body)
  (hidden eval-closure-body)
  (doc eval-closure-body "evaluates a closure's body in the closure's own
file. Stepping through a compile-time function is stepping through the file
that defines it, and a closure that does not know its file says so rather
than inheriting the caller's.")
  (defn eval-closure-body [closure state frame]
    (let-do [_pushed (push-step-file! (CtClosure.file closure))
             result (eval-value (Box.peek (CtClosure.body closure)) state frame)
             _popped (pop-step-file!)]
      result))

  (defn apply-function-value [call function-value values state frame]
    (match-ref function-value
      (CtValue.Syntax syntax)
        (match (eval-value (Box.peek syntax) state frame)
          (Result.Success evaluated)
            (apply-function-value call &evaluated values state frame)
          (Result.Error error) (Result.Error error))
      (CtValue.Closure closure)
        (match (bind-closure call state (Box.peek closure) values)
          (Result.Success closure-frame)
            (eval-closure-body (Box.peek closure) state &closure-frame)
          (Result.Error error) (Result.Error error))
      (CtValue.Builtin builtin-name)
        (match (apply-builtin-name call builtin-name values)
          (Maybe.Just result) result
          (Maybe.Nothing)
            (Result.Error (error-at call @"unknown compile-time builtin")))
      (CtValue.Macro macro-closure)
        (apply-macro-to-values call (Box.peek macro-closure) values state frame)
      _
        (Result.Error
          (error-at call @"compile-time application expects a function"))))

  (defn applied-call-syntax [call function-form values]
    (let-do [result (the
               (Result (Array (Box SurfaceNode)) CtError)
               (Result.Success [(Box.init (SurfaceNode.copy function-form))]))
             n (Array.length values)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success items)
            (match (syntax-from-value call
                                      (Box.peek (Array.unsafe-nth values i)))
              (Result.Success node)
                (set! result
                      (Result.Success (Array.push-back @items (Box.init node))))
              (Result.Error error) (set! result (Result.Error error)))
          (Result.Error error) (set! result (Result.Error @error))))
      (match result
        (Result.Success items)
          (Result.Success
            (CtValue.Syntax
              (Box.init
                (SurfaceNode.init @(SurfaceNode.span call)
                                  (SurfaceForm.List items)))))
        (Result.Error error) (Result.Error error))))

  (defn expand-known-syntax [call node]
    (match-ref (SurfaceNode.form node)
      (SurfaceForm.List raw-items)
        (let [items (semantic-items raw-items)]
          (if (and (Int.> (Array.length &items) 0)
                   (named? (Box.peek (Array.unsafe-nth &items 0)) @"ignore*"))
            (let-do [expanded (the (Array (Box SurfaceNode)) [])
                     n (Array.length &items)]
              (for [i 1 n]
                (let [ignored (call-node call
                                         "ignore"
                                         &[(Box.init
                                             (SurfaceNode.copy (Box.peek (Array.unsafe-nth &items
                                                                                           i))))])]
                  (Array.push-back! &expanded (Box.init ignored))))
              (Result.Success (list-with-items call expanded)))
            (Result.Success (CtValue.Syntax (Box.init (SurfaceNode.copy node))))))
      _ (Result.Success (CtValue.Syntax (Box.init (SurfaceNode.copy node))))))

  (defn eval-apply [body items state frame]
    (if (Int.= 3 (Array.length items))
      (let [function-form (Box.peek (Array.unsafe-nth items 1))
            arguments-form (Box.peek (Array.unsafe-nth items 2))]
        (match (eval-value arguments-form state frame)
          (Result.Success argument-list)
            (let [values-result (collection-values body &argument-list)]
              (match-ref &values-result
                (Result.Success values)
                  (match (symbol-key function-form)
                    (Maybe.Just function-name)
                      (if (or (String.contains? &function-name \.)
                              (builtin-name? function-form &function-name))
                        (applied-call-syntax body function-form values)
                        (match (lookup-status state frame &function-name)
                          (CtEnvLookup.Found cell)
                            (match (read-cell state &cell)
                              (Maybe.Just function-value)
                                (let [syntax-candidate (CtValue.copy &function-value)]
                                  (match (syntax-from-value body
                                                            &syntax-candidate)
                                    (Result.Success function-node)
                                      (applied-call-syntax body
                                                           &function-node
                                                           values)
                                    (Result.Error _)
                                      (let [callable-copy (CtValue.copy &function-value)]
                                        (apply-function-value body
                                                              &callable-copy
                                                              values
                                                              state
                                                              frame))))
                              (Maybe.Nothing)
                                (Result.Error
                                  (error-at body @"invalid compile-time cell")))
                          (CtEnvLookup.Ambiguous)
                            (Result.Error
                              (error-at body
                                        (String.append "ambiguous compile-time function: "
                                                       &function-name)))
                          (CtEnvLookup.Missing)
                            (applied-call-syntax body function-form values)))
                    (Maybe.Nothing)
                      (match (eval-value function-form state frame)
                        (Result.Success function-value)
                          (apply-function-value body
                                                &function-value
                                                values
                                                state
                                                frame)
                        (Result.Error error) (Result.Error error)))
                (Result.Error error) (Result.Error @error)))
          (Result.Error error) (Result.Error error)))
      (Result.Error (error-at body @"apply expects a function and arguments"))))

  (defn eval-let-do [body items state frame]
    (if (Int.> (Array.length items) 2)
      (let [binding-form (Box.peek (Array.unsafe-nth items 1))]
        (match-ref (SurfaceNode.form binding-form)
          (SurfaceForm.Array pair)
            (let [binding-items (semantic-items pair)]
              (if (Int.= (mod (Array.length &binding-items) 2) 0)
                (let-do [let-frame (child! state frame)
                         failure (the (Maybe CtError) (Maybe.Nothing))
                         n (Array.length &binding-items)]
                  (for [binding-index 0 (/ n 2)]
                    (match-ref &failure
                      (Maybe.Nothing)
                        (let [index (* binding-index 2)
                              name-form (Box.peek (Array.unsafe-nth &binding-items
                                                                    index))
                              value-form (Box.peek
                                (Array.unsafe-nth &binding-items (Int.inc index)))]
                          (match (symbol-name name-form)
                            (Maybe.Just name)
                              (match (eval-value value-form state &let-frame)
                                (Result.Success value)
                                  (ignore (define! state &let-frame &name value))
                                (Result.Error error)
                                  (set! failure (Maybe.Just error)))
                            (Maybe.Nothing)
                              (set! failure
                                    (Maybe.Just
                                      (error-at name-form
                                                @"compile-time let-do binding must have a symbol name")))))
                      (Maybe.Just _) ()))
                  (match failure
                    (Maybe.Nothing)
                      (let-do [result (the (Result CtValue CtError)
                                           (Result.Success (syntax-empty body)))
                               item-count (Array.length items)]
                        (for [i 2 item-count]
                          (match-ref &result
                            (Result.Success _)
                              (set! result
                                    (eval-value (Box.peek (Array.unsafe-nth items
                                                                            i))
                                                state
                                                &let-frame))
                            (Result.Error error)
                              (set! result (Result.Error @error))))
                        result)
                    (Maybe.Just error) (Result.Error error)))
                (Result.Error
                  (error-at binding-form
                            @"compile-time let-do bindings must contain name/value pairs"))))
          _
            (Result.Error
              (error-at binding-form
                        @"compile-time let-do bindings must be an array"))))
      (Result.Error (error-at body @"let-do expects bindings and a body"))))

  (defn eval-for [body items state frame]
    (let [item-count (Array.length items)]
      (if (and (Int.>= item-count 2) (Int.<= item-count 3))
        (let [settings-form (Box.peek (Array.unsafe-nth items 1))]
          (match-ref (SurfaceNode.form settings-form)
            (SurfaceForm.Array raw-settings)
              (let [settings (semantic-items raw-settings)
                    setting-count (Array.length &settings)]
                (if (and (Int.>= setting-count 3) (Int.<= setting-count 5))
                  (let [variable-form (Box.peek (Array.unsafe-nth &settings 0))
                        from-form (Box.peek (Array.unsafe-nth &settings 1))
                        to-form (Box.peek (Array.unsafe-nth &settings 2))
                        step-form (if (Int.> setting-count 3)
                          (SurfaceNode.copy
                            (Box.peek (Array.unsafe-nth &settings 3)))
                          (SurfaceNode.init @(SurfaceNode.span body)
                                            (SurfaceForm.IntLit 1)))
                        comp-form (if (Int.> setting-count 4)
                          (SurfaceNode.copy
                            (Box.peek (Array.unsafe-nth &settings 4)))
                          (match-ref (SurfaceNode.form &step-form)
                            (SurfaceForm.IntLit step)
                              (if (Int.< @step 0)
                                (symbol-node body ">")
                                (symbol-node body "<"))
                            _ (symbol-node body "<")))]
                    (match (symbol-name variable-form)
                      (Maybe.Just variable-name)
                        (match (eval-value from-form state frame)
                          (Result.Success start-value)
                            (let-do [loop-frame (child! state frame)
                                     result (the (Result CtValue CtError)
                                                 (Result.Success (syntax-empty body)))
                                     running true]
                              (ignore
                                (define! state
                                         &loop-frame
                                         &variable-name
                                         start-value))
                              (while-do running
                                (match-ref &result
                                  (Result.Success _)
                                    (let [condition-call (call-node-with-head body
                                                                              &comp-form
                                                                              &[(Box.init (SurfaceNode.copy variable-form))
                                                                                (Box.init (SurfaceNode.copy to-form))])]
                                      (match (eval-value &condition-call
                                                         state
                                                         &loop-frame)
                                        (Result.Success condition-value)
                                          (match (bool-argument &condition-call
                                                                &condition-value)
                                            (Result.Success keep-going)
                                              (if keep-going
                                                (let [addition-call (call-node body
                                                                               "+"
                                                                               &[(Box.init (SurfaceNode.copy variable-form))
                                                                                 (Box.init (SurfaceNode.copy &step-form))])
                                                      increment-call (call-node body
                                                                                "set!"
                                                                                &[(Box.init (SurfaceNode.copy variable-form))
                                                                                  (Box.init addition-call)])]
                                                  (match (if (Int.= item-count 3)
                                                      (eval-value (Box.peek (Array.unsafe-nth items
                                                                                              2))
                                                                  state
                                                                  &loop-frame)
                                                      (Result.Success (syntax-empty body)))
                                                    (Result.Success _)
                                                      (match (eval-value &increment-call
                                                                         state
                                                                         &loop-frame)
                                                        (Result.Success _) ()
                                                        (Result.Error error)
                                                          (do
                                                            (set! result
                                                                  (Result.Error error))
                                                            (set! running false)))
                                                    (Result.Error error)
                                                      (do
                                                        (set! result
                                                              (Result.Error error))
                                                        (set! running false))))
                                                (set! running false))
                                            (Result.Error error)
                                              (do
                                                (set! result
                                                      (Result.Error error))
                                                (set! running false)))
                                        (Result.Error error)
                                          (do
                                            (set! result (Result.Error error))
                                            (set! running false))))
                                  (Result.Error _) (set! running false)))
                              result)
                          (Result.Error error) (Result.Error error))
                      (Maybe.Nothing)
                        (Result.Error
                          (error-at variable-form
                                    @"for binding must have a symbol name"))))
                  (Result.Error
                    (error-at settings-form
                              @"for expects [name from to] settings"))))
            _
              (Result.Error
                (error-at settings-form @"for settings must be an array"))))
        (Result.Error
          (error-at body @"for expects settings and at most one body form")))))

  (defn eval-expand [body items state frame]
    (if (Int.= 2 (Array.length items))
      (match (eval-value (Box.peek (Array.unsafe-nth items 1)) state frame)
        (Result.Success value)
          (match (syntax-from-value body &value)
            (Result.Success node) (expand-known-syntax body &node)
            (Result.Error error) (Result.Error error))
        (Result.Error error) (Result.Error error))
      (Result.Error (error-at body @"expand expects one argument"))))

  (defn eval-with-test-internal [body items state frame]
    (if (Int.= 3 (Array.length items))
      (let [name-form (Box.peek (Array.unsafe-nth items 1))
            forms-form (Box.peek (Array.unsafe-nth items 2))]
        (match (eval-value name-form state frame)
          (Result.Success name-value)
            (match (syntax-from-value name-form &name-value)
              (Result.Success name-node)
                (match (eval-value forms-form state frame)
                  (Result.Success forms-value)
                    (match (list-items body &forms-value)
                      (Result.Success forms)
                        (let-do [result (the (Array (Box CtValue)) [])
                                 n (Array.length &forms)]
                          (for [i 0 n]
                            (Array.push-back! &result
                                              (Box.init
                                                (CtValue.Syntax
                                                  (Box.init
                                                    (set-ref-node body
                                                                  &name-node
                                                                  (Box.peek (Array.unsafe-nth &forms
                                                                                              i))))))))
                          (Result.Success (CtValue.Collection result)))
                      (Result.Error error) (Result.Error error))
                  (Result.Error error) (Result.Error error))
              (Result.Error error) (Result.Error error))
          (Result.Error error) (Result.Error error)))
      (Result.Error
        (error-at body @"with-test-internal expects a name and forms"))))

  (doc eval-template "evaluates a macro body and requires its result to be
syntax. The evaluator also supports lexical `fn` closures and computed array
collections internally; a macro must still return syntax to the expander.")
  (private macro-closure-for)
  (hidden macro-closure-for)
  (doc macro-closure-for "the macro bound to a call head, when the head names
one in the compile-time environment. Macros are environment citizens (see
CtValue.Macro), so the evaluator can meet one anywhere a call is evaluated.")
  (defn macro-closure-for [head state frame]
    (match (symbol-key head)
      (Maybe.Just name)
        (match (lookup-status state frame &name)
          (CtEnvLookup.Found cell)
            (match (read-cell state &cell)
              (Maybe.Just value)
                (match value
                  (CtValue.Macro closure)
                    (Maybe.Just (CtClosure.copy (Box.peek &closure)))
                  _ (the (Maybe CtClosure) (Maybe.Nothing)))
              (Maybe.Nothing) (the (Maybe CtClosure) (Maybe.Nothing)))
          _ (the (Maybe CtClosure) (Maybe.Nothing)))
      (Maybe.Nothing) (the (Maybe CtClosure) (Maybe.Nothing))))

  (private macro-rest-syntax)
  (hidden macro-rest-syntax)
  (defn macro-rest-syntax [call arguments start]
    (let-do [items (the (Array (Box SurfaceNode)) [])
             n (Array.length arguments)]
      (for [i start n]
        (set! items
              (Array.push-back items
                               (Box.init
                                 (SurfaceNode.copy
                                   (Box.peek (Array.unsafe-nth arguments i)))))))
      (SurfaceNode.init @(SurfaceNode.span call) (SurfaceForm.List items))))

  (private apply-ct-macro)
  (hidden apply-ct-macro)
  (private expand-ct-macro)
  (hidden expand-ct-macro)
  (doc expand-ct-macro "binds the raw argument syntax (fixed then :rest) in a
child of the macro's defining frame and evaluates the body, yielding the
EXPANSION as syntax. Callers decide whether to evaluate it (a macro call) or
keep it as data (a macro reached through `apply`).")
  (defn expand-ct-macro [call closure items state]
    (let-do [arguments (the (Array (Box SurfaceNode)) [])]
      (for [i 1 (Array.length items)]
        (set! arguments
              (Array.push-back arguments
                               (Box.init
                                 (SurfaceNode.copy (Box.peek (Array.unsafe-nth items
                                                                               i)))))))
      (let [fixed (CtClosure.parameters closure)
            rest @(CtClosure.rest closure)
            fixed-count (Array.length fixed)
            argument-count (Array.length &arguments)]
        (if (or (Int.< argument-count fixed-count)
                (and (Maybe.nothing? &rest) (/= fixed-count argument-count)))
          (Result.Error
            (error-at call
                      (String.concat
                        &[@"this macro takes "
                          (if (Maybe.just? &rest)
                            (String.concat &[@"at least " (Int.str fixed-count)])
                            (Int.str fixed-count))
                          (if (Int.= fixed-count 1)
                            @" argument, got "
                            @" arguments, got ")
                          (Int.str argument-count)])))
          (let-do [macro-frame (child! state (CtClosure.defining-frame closure))]
            (for [i 0 fixed-count]
              (ignore
                (define! state
                         &macro-frame
                         (Array.unsafe-nth fixed i)
                         (CtValue.Syntax
                           (Box.init
                             (SurfaceNode.copy
                               (Box.peek (Array.unsafe-nth &arguments i))))))))
            (match rest
              (Maybe.Just rest-name)
                (ignore
                  (define! state
                           &macro-frame
                           &rest-name
                           (CtValue.Syntax
                             (Box.init
                               (macro-rest-syntax call &arguments fixed-count)))))
              (Maybe.Nothing) ())
            (match (eval-closure-body closure state &macro-frame)
              (Result.Success expansion-value)
                (syntax-from-value call &expansion-value)
              (Result.Error error) (Result.Error error)))))))

  (doc apply-ct-macro "a macro CALL met during evaluation: expansion followed
by evaluation of the expansion in the CALLER's frame.")
  (defn apply-ct-macro [call closure items state frame]
    (match (expand-ct-macro call closure items state)
      (Result.Success expansion) (eval-value &expansion state frame)
      (Result.Error error) (Result.Error error)))

  (private apply-macro-to-values)
  (hidden apply-macro-to-values)
  (doc apply-macro-to-values "applies a macro reached as a VALUE (`apply`,
higher-order use): each argument value converts back to the syntax it wraps
and binds unevaluated, matching the reference's first-class treatment of
macros in dynamic code (e.g. ControlMacros' `(apply ignore* forms)`).")
  (defn apply-macro-to-values [call closure values state frame]
    (let-do [items (the (Array (Box SurfaceNode))
                        [(Box.init (SurfaceNode.copy call))])
             failure (the (Maybe CtError) (Maybe.Nothing))
             n (Array.length values)]
      (for [i 0 n]
        (when (match-ref &failure (Maybe.Nothing) true _ false)
          (match (syntax-from-value call (Box.peek (Array.unsafe-nth values i)))
            (Result.Success node) (Array.push-back! &items (Box.init node))
            (Result.Error error) (set! failure (Maybe.Just error)))))
      (match failure
        (Maybe.Just error)
        (Result.Error error)
        (Maybe.Nothing)
        ;; the reference's `apply` on a macro yields the expansion as DATA
        ;; (dynamic code like ControlMacros' `(expand (apply ignore* forms))`
        ;; goes on to manipulate it), so no evaluation here.
        (match (expand-ct-macro call closure &items state)
          (Result.Success expansion)
            (Result.Success (CtValue.Syntax (Box.init expansion)))
          (Result.Error error) (Result.Error error)))))

  (doc pure-string-command? "the pure string commands this evaluator
implements with the reference's load-time semantics, including bounds errors
(see the String.char-at/slice/index-of builtin arms). The expander consults
this to evaluate literal-argument top-level calls the way the reference's
REPL does — the knowledge lives here, beside the implementations.")
  (defn pure-string-command? [name]
    (or (String.= name "String.char-at")
        (or (String.= name "String.slice") (String.= name "String.index-of"))))

  (doc register-macro! "binds a macro into the compile-time environment as a
CtValue.Macro, making it visible to mid-evaluation expansion. The macro keeps
the file it is defined in, the same way a compile-time function does.")
  (defn register-macro! [state frame name fixed rest body defining-frame]
    (ignore
      (define! state
               frame
               name
               (CtValue.Macro
                 (Box.init
                   (CtClosure.init fixed
                                   rest
                                   body
                                   defining-frame
                                   (definition-file)))))))

  (defn eval-template [body state frame]
    (match (eval-value body state frame)
      (Result.Success value) (syntax-from-value body &value)
      (Result.Error error) (Result.Error error))))
