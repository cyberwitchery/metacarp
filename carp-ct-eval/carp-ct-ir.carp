(load "../carp-surface/carp-surface.carp")

(doc CtRef "is how lowered code finds the value of a name. `Name` looks the name
up through the frames, from the current one out. `Free` holds the index of an
inline cache that remembers where the name resolved.")
(deftype CtRef
  (Name [])
  (Free [Int]))

(doc CtBind "is one `let` binding in lowered code. `name` is the name it binds,
`value` the code of its value and `span` its span.")
(deftype CtBind [name String
                 value (Box CtIR)
                 span SurfaceSpan])

(doc CtIR "is lowered compile-time code. Lowering decides once which special
form a list is, whether a head names a builtin, and how each name is reached.
`Lit` is syntax that evaluates to itself. `Quote` is a quoted form. `Sym` is a
name, how to reach it and its span. `ArgSym` is a call argument in symbol
position, which stays as syntax if it resolves to nothing. `Coll` is an array
literal. `If`, `When`, `And`, `Or`, `Seq`, `While` and `SetName` are those
forms. `Let` and `LetDo` hold the bindings and the body. `Cond` holds the
alternating tests and branches, and the form, which is the result if no branch
matches. `Fn` holds the index of a lambda's prototype. `CallSym` is a call with
a name as head: the name, how to reach it, its builtin id or -1, the lowered
arguments, the argument syntax for macros, and the call form. `CallExpr` is a
call with a computed head. `Special` is a form with its own rule about which
arguments are evaluated: its opcode, the arguments it evaluates and the ones it
takes as syntax. `Fail` is a malformed form, reported when it runs, as in the
reference. `Case` holds the value, alternating patterns and branches, and the
form. `SexprArg` is an argument that resolves through the recorded-source table,
else is evaluated, as the first argument of `Dynamic.curry*`.")
(deftype CtIR
  (Lit [(Box SurfaceNode)])
  (Quote [(Box SurfaceNode)])
  (Sym [String CtRef SurfaceSpan])
  (ArgSym [String CtRef (Box SurfaceNode)])
  (Coll [(Array (Box CtIR)) SurfaceSpan])
  (If [(Box CtIR) (Box CtIR) (Box CtIR) SurfaceSpan])
  (When [(Box CtIR) (Box CtIR) SurfaceSpan])
  (And [(Array (Box CtIR)) SurfaceSpan])
  (Or [(Array (Box CtIR)) SurfaceSpan])
  (Seq [(Array (Box CtIR)) SurfaceSpan])
  (Let [(Array CtBind) (Box CtIR) SurfaceSpan])
  (LetDo [(Array CtBind) (Array (Box CtIR)) SurfaceSpan])
  (Cond [(Array (Box CtIR)) (Box SurfaceNode)])
  (While [(Box CtIR) (Box CtIR) SurfaceSpan])
  (SetName [String (Box CtIR) SurfaceSpan])
  (Fn [Int SurfaceSpan])
  (CallSym
    [String
     CtRef
     Int
     (Array (Box CtIR))
     (Array (Box SurfaceNode))
     (Box SurfaceNode)])
  (CallExpr
    [(Box CtIR) (Array (Box CtIR)) (Array (Box SurfaceNode)) (Box SurfaceNode)])
  (Special [Int (Array (Box CtIR)) (Array (Box SurfaceNode)) (Box SurfaceNode)])
  (Fail [String SurfaceSpan])
  (Case [(Box CtIR) (Array (Box CtIR)) (Box SurfaceNode)])
  (SexprArg [(Box SurfaceNode) (Box CtIR)]))

(doc CtParameterNames "the names a compile-time parameter array binds.")
(deftype CtParameterNames [fixed (Array String)
                           rest (Maybe String)])

(doc CtProto "is a compile-time lambda, lowered and compiled once where it is
written. `parameters` and `rest` are its parameters. `code` is the id of its
bytecode. `body` is its syntax. A closure is a prototype index and a frame id.")
(deftype CtProto
  [parameters (Array String)
   rest (Maybe String)
   code Int
   body (Box SurfaceNode)])

(doc *ct-protos* "holds every lowered lambda, by the prototype index `CtIR.Fn`
holds.")
(def *ct-protos* (the (Array (Box CtProto)) []))

(doc *ct-cache-frame* "holds the frame each inline cache answers for. A cache
answers only for that frame and its epoch.")
(def *ct-cache-frame* (the (Array Int) []))
(doc *ct-cache-epoch* "holds the environment epoch each inline cache answers
for.")
(def *ct-cache-epoch* (the (Array Int) []))
(doc *ct-cache-cell* "holds each inline cache's answer: a cell index, or a code
from `CtCacheCode`.")
(def *ct-cache-cell* (the (Array Int) []))

(doc *ct-cache-hits* "counts inline cache hits, for `CARP_DEBUG_CT`.")
(def *ct-cache-hits* 0)
(doc *ct-cache-misses* "counts inline cache misses, for `CARP_DEBUG_CT`.")
(def *ct-cache-misses* 0)
(doc *ct-name-resolutions* "counts name resolutions that walked frames, for
`CARP_DEBUG_CT`.")
(def *ct-name-resolutions* 0)

(doc CtCacheCode "the non-cell answers an inline cache can hold.")
(defmodule CtCacheCode
  (doc builtin "is the cache answer for a name that is a builtin.")
  (defn builtin [] -2)
  (doc missing "is the cache answer for a name that is unbound.")
  (defn missing [] -3)
  (doc ambiguous "is the cache answer for a name that is ambiguous.")
  (defn ambiguous [] -4))

(doc CtSpecial "the forms with their own rule about which arguments are
evaluated. The opcode is what the lowerer writes and the evaluator matches;
the two tables must agree, the way the builtin table does.")
(defmodule CtSpecial
  (doc apply-op "is the opcode of `apply`.")
  (defn apply-op [] 0)
  (doc expand-op "is the opcode of `expand`.")
  (defn expand-op [] 1)
  (doc eval-op "is the opcode of `eval`.")
  (defn eval-op [] 2)
  (doc members-op "is the opcode of `members`.")
  (defn members-op [] 3)
  (doc managed-op "is the opcode of `managed?`.")
  (defn managed-op [] 4)
  (doc sexpr-op "is the opcode of `s-expr`.")
  (defn sexpr-op [] 5)
  (doc use-op "is the opcode of `use`.")
  (defn use-op [] 6)
  (doc concat-op "is the opcode of `concat`.")
  (defn concat-op [] 7)
  (doc with-test-op "is the opcode of `with-test-internal`.")
  (defn with-test-op [] 8)
  (doc compose-op "is the opcode of `Dynamic.compose`.")
  (defn compose-op [] 9)
  (doc meta-op "is the opcode of `meta`.")
  (defn meta-op [] 10)
  (doc type-op "is the opcode of `type`.")
  (defn type-op [] 11))

(doc CtIRSpan "returns the spans of lowered code.")
(defmodule CtIRSpan
  (doc of "the source span a lowered node came from.")
  (defn of [code]
    (match-ref code
      (CtIR.Lit node) @(SurfaceNode.span (Box.peek node))
      (CtIR.Quote node) @(SurfaceNode.span (Box.peek node))
      (CtIR.Sym _ _ span) @span
      (CtIR.ArgSym _ _ node) @(SurfaceNode.span (Box.peek node))
      (CtIR.Coll _ span) @span
      (CtIR.If _ _ _ span) @span
      (CtIR.When _ _ span) @span
      (CtIR.And _ span) @span
      (CtIR.Or _ span) @span
      (CtIR.Seq _ span) @span
      (CtIR.Let _ _ span) @span
      (CtIR.LetDo _ _ span) @span
      (CtIR.Cond _ node) @(SurfaceNode.span (Box.peek node))
      (CtIR.While _ _ span) @span
      (CtIR.SetName _ _ span) @span
      (CtIR.Fn _ span) @span
      (CtIR.CallSym _ _ _ _ _ node) @(SurfaceNode.span (Box.peek node))
      (CtIR.CallExpr _ _ _ node) @(SurfaceNode.span (Box.peek node))
      (CtIR.Special _ _ _ node) @(SurfaceNode.span (Box.peek node))
      (CtIR.Fail _ span) @span
      (CtIR.Case _ _ node) @(SurfaceNode.span (Box.peek node))
      (CtIR.SexprArg node _) @(SurfaceNode.span (Box.peek node)))))

(doc CtIRStore "manages the prototype and inline cache tables.")
(defmodule CtIRStore
  (doc reset! "empties the prototype and cache tables. Nothing calls it.")
  (defn reset! []
    (do
      (set! *ct-protos* [])
      (set! *ct-cache-frame* [])
      (set! *ct-cache-epoch* [])
      (set! *ct-cache-cell* [])))

  (doc fresh-cache! "allocates an inline cache line and returns its id.")
  (defn fresh-cache! []
    (let-do [id (Array.length &*ct-cache-cell*)]
      (Array.push-back! &*ct-cache-frame* -1)
      (Array.push-back! &*ct-cache-epoch* -1)
      (Array.push-back! &*ct-cache-cell* -1)
      id))

  (doc cache-hit? "whether cache line `id` answers for `frame` at `epoch`.")
  (defn cache-hit? [id frame epoch]
    (let-do [hit (and
               (Int.= @(Array.unsafe-nth &*ct-cache-frame* id) frame)
               (Int.= @(Array.unsafe-nth &*ct-cache-epoch* id) epoch))]
      (if hit
        (set! *ct-cache-hits* (Int.inc *ct-cache-hits*))
        (set! *ct-cache-misses* (Int.inc *ct-cache-misses*)))
      hit))

  (doc count-name-resolution! "records one resolution that walked frames.")
  (defn count-name-resolution! []
    (set! *ct-name-resolutions* (Int.inc *ct-name-resolutions*)))

  (doc report "the inline-cache counters, as text.")
  (defn report []
    (fmt
      "ct-cache hits=%d misses=%d name-resolutions=%d protos=%d caches=%d"
      *ct-cache-hits*
      *ct-cache-misses*
      *ct-name-resolutions*
      (Array.length &*ct-protos*)
      (Array.length &*ct-cache-cell*)))

  (doc cache-value "the answer held in cache line `id`.")
  (defn cache-value [id] @(Array.unsafe-nth &*ct-cache-cell* id))

  (doc cache-fill! "records `value` as the answer for `frame` at `epoch`.")
  (defn cache-fill! [id frame epoch value]
    (do
      (Array.aset! &*ct-cache-frame* id frame)
      (Array.aset! &*ct-cache-epoch* id epoch)
      (Array.aset! &*ct-cache-cell* id value)))

  (doc add-proto! "adds `proto` to the prototype table and returns its index.
Prototypes are boxed, so adding one does not move one that is running.")
  (defn add-proto! [proto]
    (let-do [id (Array.length &*ct-protos*)]
      (Array.push-back! &*ct-protos* (Box.init proto))
      id)))
