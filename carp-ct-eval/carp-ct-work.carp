(doc CtWork "charges bounded queries for the data a compile-time primitive
can copy or traverse, as well as for its VM instructions. Counting stops once
the allowance is exhausted, so repeated doubling cannot evade an instruction budget.")
(defmodule CtWork
  (private text-cost)
  (hidden text-cost)
  (defn text-cost [text limit]
    (let [length (String.length text)]
      (if (Int.>= length limit) (Int.inc limit) (Int.inc length))))

  (private syntax-cost)
  (hidden syntax-cost)
  (register syntax-cost (Fn [(Ref SurfaceNode) Int] Int))

  (private syntax-children-cost)
  (hidden syntax-children-cost)
  (defn syntax-children-cost [children limit]
    (let-do [cost 1
             i 0]
      (while-do (and (Int.< i (Array.length children)) (Int.<= cost limit))
        (set! cost
              (Int.+ cost
                     (syntax-cost (Box.peek (Array.unsafe-nth children i))
                                  (Int.- limit cost))))
        (set! i (Int.inc i)))
      cost))

  (defn syntax-cost [node limit]
    (if (Int.<= limit 0)
      1
      (match-ref (SurfaceNode.form node)
        (SurfaceForm.StringLit text) (text-cost text limit)
        (SurfaceForm.PatternLit text) (text-cost text limit)
        (SurfaceForm.Comment text) (text-cost text limit)
        (SurfaceForm.Invalid text) (text-cost text limit)
        (SurfaceForm.Symbol parts)
          (let-do [cost 1
                   i 0]
            (while-do (and (Int.< i (Array.length parts)) (Int.<= cost limit))
              (set! cost
                    (Int.+ cost
                           (text-cost (Array.unsafe-nth parts i)
                                      (Int.- limit cost))))
              (set! i (Int.inc i)))
            cost)
        (SurfaceForm.List children) (syntax-children-cost children limit)
        (SurfaceForm.Array children) (syntax-children-cost children limit)
        (SurfaceForm.StaticArray children) (syntax-children-cost children limit)
        (SurfaceForm.Dictionary children) (syntax-children-cost children limit)
        _ 1)))

  (private value-cost)
  (hidden value-cost)
  (sig value-cost (Fn [(Ref CtValue) Int] Int))

  (defn value-cost [value limit]
    (if (Int.<= limit 0)
      1
      (match-ref value
        (CtValue.Syntax node) (syntax-cost (Box.peek node) limit)
        (CtValue.Collection children)
          (let-do [cost 1
                   i 0]
            (while-do (and (Int.< i (Array.length children)) (Int.<= cost limit))
              (set! cost
                    (Int.+ cost
                           (value-cost (Box.peek (Array.unsafe-nth children i))
                                       (Int.- limit cost))))
              (set! i (Int.inc i)))
            cost)
        _ 1)))

  (doc charge-values!
    "charges a primitive's input before running the primitive.")
  (defn charge-values! [values]
    (if (not (WorkBudget.active?))
      true
      (let-do [cost 1
               i 0
               limit (WorkBudget.remaining)]
        (while-do (and (Int.< i (Array.length values)) (Int.<= cost limit))
          (set! cost
                (Int.+ cost
                       (value-cost (Box.peek (Array.unsafe-nth values i))
                                   (Int.- limit cost))))
          (set! i (Int.inc i)))
        (WorkBudget.consume! cost)))))
