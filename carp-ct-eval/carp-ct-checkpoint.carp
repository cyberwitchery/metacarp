(doc CtCodeCheckpoint "is the saved state of the code tables. `Saved` holds the
number of compiled bodies, the code id of each prototype, the inline cache
frames, epochs and cells, and the cache hit, miss and resolution counts.")
(deftype CtCodeCheckpoint
  (Saved [Int (Array Int) (Array Int) (Array Int) (Array Int) Int Int Int]))

(doc CtCheckpoint "is the compile-time state that a query must restore. `Saved`
holds the code checkpoint, the load stack, the metadata, the typing forms, the
pending includes, the C flags, the library flags, the project configuration, the
pkg-config flags, the step files, whether tracing was on and the evaluation
depth. The environment epoch is not restored, so separate environments keep
distinct cache keys.")
(deftype CtCheckpoint
  (Saved
    [CtCodeCheckpoint
     (Array String)
     (Array (Pair String (Box SurfaceNode)))
     (Array (Box SurfaceNode))
     (Array SurfaceNode)
     (Array String)
     (Array String)
     (Array (Pair String (Box SurfaceNode)))
     (Array String)
     (Array String)
     Bool
     Int]))

(defmodule CtEval
  (doc checkpoint "saves the compile-time state, turns tracing off and resets
the evaluation depth. Run one query at a time, and `restore!` after it whether
it succeeds or not.")
  (defn checkpoint []
    (let-do [prototype-codes (the (Array Int) [])]
      (for [i 0 (Array.length &*ct-protos*)]
        (Array.push-back! &prototype-codes
                          @(CtProto.code
                            (Box.peek (Array.unsafe-nth &*ct-protos* i)))))
      (let-do [saved (CtCheckpoint.Saved
                 (CtCodeCheckpoint.Saved (CtCodeStore.count)
                                         prototype-codes
                                         (Array.copy &*ct-cache-frame*)
                                         (Array.copy &*ct-cache-epoch*)
                                         (Array.copy &*ct-cache-cell*)
                                         *ct-cache-hits*
                                         *ct-cache-misses*
                                         *ct-name-resolutions*)
                 (Array.copy &*ct-load-stack*)
                 (Array.copy &*ct-meta*)
                 (Array.copy &*ct-typing-forms*)
                 (Array.copy &*ct-pending-includes*)
                 (Array.copy &*ct-collected-cflags*)
                 (Array.copy &*ct-collected-libflags*)
                 (Array.copy &*ct-project-config*)
                 (Array.copy &*ct-pkgconfig-flags*)
                 (Array.copy &*ct-step-files*)
                 *ct-tracing*
                 *ct-depth*)]
        (set! *ct-tracing* false)
        (set! *ct-depth* 0)
        saved)))

  (private restore-code!)
  (hidden restore-code!)
  (defn restore-code! [saved]
    (match saved
      (CtCodeCheckpoint.Saved count
                              codes
                              frames
                              epochs
                              cells
                              hits
                              misses
                              resolutions)
        (do
          (for [i 0 (Array.length &codes)]
            (CtProto.set-code!
              (Box.peek (Array.unsafe-nth &*ct-protos* i))
              @(Array.unsafe-nth &codes i)))
          (while-do (Int.> (Array.length &*ct-protos*) (Array.length &codes))
            (ignore (Array.pop-back! &*ct-protos*)))
          (while-do (Int.> (Array.length &*ct-codes*) count)
            (ignore (Array.pop-back! &*ct-codes*)))
          (set! *ct-cache-frame* frames)
          (set! *ct-cache-epoch* epochs)
          (set! *ct-cache-cell* cells)
          (set! *ct-cache-hits* hits)
          (set! *ct-cache-misses* misses)
          (set! *ct-name-resolutions* resolutions))))

  (doc restore! "restores the state that `saved` holds, dropping the code,
prototypes, metadata and build settings made since.")
  (defn restore! [saved]
    (match saved
      (CtCheckpoint.Saved code
                          stack
                          metadata
                          typing
                          includes
                          cflags
                          libflags
                          project
                          packages
                          files
                          tracing
                          depth)
        (do
          (restore-code! code)
          (set! *ct-load-stack* stack)
          (set! *ct-meta* metadata)
          (set! *ct-typing-forms* typing)
          (set! *ct-pending-includes* includes)
          (set! *ct-collected-cflags* cflags)
          (set! *ct-collected-libflags* libflags)
          (set! *ct-project-config* project)
          (set! *ct-pkgconfig-flags* packages)
          (set! *ct-step-files* files)
          (set! *ct-tracing* tracing)
          (set! *ct-depth* depth)))))
