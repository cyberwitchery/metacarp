(load "../carp-ct-eval.carp")
(load "Test.carp")
(Project.no-echo)
(use-all Test)

(defn frozen-view [state]
  (let [input (SourceInput.init @"ct:scope" @"Names.inherited")]
    (match (Surface.parse-input &input)
      (Result.Error _) (the (Maybe SourceCompileEnvironment) (Maybe.Nothing))
      (Result.Success parsed)
        (let-do [_start (SourceObservations.begin! (SourceInput.id &input))
                 _observed (CtEval.observe-environment!
                   (Box.peek
                     (Array.unsafe-nth
                       (SurfaceModule.forms (SourcedSurfaceModule.module &parsed))
                       0))
                   state
                   (CtState.root state))
                 views (SourceObservations.environments)
                 _end (SourceObservations.end!)]
          (if (Array.empty? &views)
            (Maybe.Nothing)
            (Maybe.Just @(Array.unsafe-nth &views 0)))))))

(defn has-cell? [view name identity]
  (let-do [query (SourceCompileEnvironment.query view)
           candidates (~query name true)
           found false]
    (for [i 0 (Array.length &candidates)]
      (match-ref (SourceLexicalBinding.identity (Array.unsafe-nth &candidates i))
        (SourceLexicalIdentity.Cell cell)
          (when (Int.= @cell identity) (set! found true))
        _ ()))
    found))

(defn inherited-and-frozen? []
  (let-do [state (CtEval.state)
           root (CtEval.root &state)
           child (CtEval.child! &state &root)
           original (CtEval.define! &state
                                    &root
                                    "inherited"
                                    (CtValue.Syntax
                                      (Box.init
                                        (SurfaceNode.generated (SurfaceSpan.anywhere)
                                                               (SurfaceForm.IntLit 42)))))
           _module (CtEval.register-module! &state "Names" &child)
           view (frozen-view &state)
           replacement (CtEval.define! &state
                                       &root
                                       "inherited"
                                       (CtValue.Syntax
                                         (Box.init
                                           (SurfaceNode.generated (SurfaceSpan.anywhere)
                                                                  (SurfaceForm.IntLit 43)))))]
    (match view
      (Maybe.Nothing) false
      (Maybe.Just frozen)
        (let [query (SourceCompileEnvironment.query &frozen)
              candidates (~query "Names.in" false)]
          (and
            (has-cell? &frozen "Names.inherited" @(CellId.index &original))
            (and
              (not
                (has-cell? &frozen
                           "Names.inherited"
                           @(CellId.index &replacement)))
              (Int.= 1 (Array.length &candidates))))))))

(defn ambiguity-survives? []
  (let-do [state (CtEval.state)
           root (CtEval.root &state)
           left (CtEval.child! &state &root)
           right (CtEval.child! &state &root)
           _left (CtEval.define! &state
                                 &left
                                 "ambiguous"
                                 (CtValue.Syntax
                                   (Box.init
                                     (SurfaceNode.generated (SurfaceSpan.anywhere)
                                                            (SurfaceForm.IntLit 1)))))
           _right (CtEval.define! &state
                                  &right
                                  "ambiguous"
                                  (CtValue.Syntax
                                    (Box.init
                                      (SurfaceNode.generated (SurfaceSpan.anywhere)
                                                             (SurfaceForm.IntLit 2)))))
           _import-left (CtEval.import! &state &root &left)
           _import-right (CtEval.import! &state &root &right)]
    (match (frozen-view &state)
      (Maybe.Nothing) false
      (Maybe.Just frozen)
        (let [query (SourceCompileEnvironment.query &frozen)
              candidates (~query "ambiguous" true)]
          (Array.empty? &candidates)))))

(deftest test
  (assert-true test
    (inherited-and-frozen?)
    "qualified completion uses inherited bindings and retains its own source revision")
  (assert-true test
    (ambiguity-survives?)
    "a frozen editing query preserves ambiguous imports"))
