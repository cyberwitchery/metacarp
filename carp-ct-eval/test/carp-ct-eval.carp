(load "../carp-ct-eval.carp")
(Project.no-echo)
(load "Test.carp")

(use-all Test)

; renders the compile-time value of the FIRST form in `source`, or an
; `<error: …>`/`<tag>` marker, so tests compare observable behavior.
(defn eval-str [source]
  (match (Surface.parse source)
    (Result.Error _) @"<parse error>"
    (Result.Success m)
      (let [forms (SurfaceModule.forms &m)]
        (if (Int.= 0 (Array.length forms))
          @"<empty>"
          (let-do [state (CtEval.state)
                   root (CtEval.root &state)]
            (match (CtEval.eval-node (Box.peek (Array.unsafe-nth forms 0))
                                     &state
                                     &root)
              (Result.Success value)
                (match value
                  (CtValue.Syntax node) (Surface.render (Box.peek &node))
                  (CtValue.Closure _) @"<closure>"
                  (CtValue.Macro _) @"<macro>"
                  (CtValue.Builtin name)
                    (String.concat &[@"<builtin " @&name @">"])
                  (CtValue.Collection _ _) @"<collection>")
              (Result.Error e)
                (String.concat
                  &[@"<error: " (String.copy (CtError.message &e)) @">"])))))))

; like eval-str, but a macro named `name` with parameters `fixed` and body
; (the first form of `macro-body-source`) is registered first.
(defn eval-str-with-macro [name fixed macro-body-source source]
  (match (Surface.parse macro-body-source)
    (Result.Error _) @"<parse error in macro body>"
    (Result.Success macro-module)
      (let [macro-forms (SurfaceModule.forms &macro-module)]
        (if (Int.= 0 (Array.length macro-forms))
          @"<empty macro body>"
          (match (Surface.parse source)
            (Result.Error _) @"<parse error>"
            (Result.Success m)
              (let [forms (SurfaceModule.forms &m)]
                (if (Int.= 0 (Array.length forms))
                  @"<empty>"
                  (let-do [state (CtEval.state)
                           root (CtEval.root &state)]
                    (CtEval.register-macro! &state
                                            &root
                                            name
                                            fixed
                                            (the (Maybe String) (Maybe.Nothing))
                                            (Box.init
                                              (SurfaceNode.copy
                                                (Box.peek (Array.unsafe-nth macro-forms
                                                                            0))))
                                            (FrameId.copy &root))
                    (match (CtEval.eval-node (Box.peek (Array.unsafe-nth forms 0))
                                             &state
                                             &root)
                      (Result.Success value)
                        (match value
                          (CtValue.Syntax node)
                            (Surface.render (Box.peek &node))
                          _ @"<non-syntax>")
                      (Result.Error e)
                        (String.concat
                          &[@"<error: " (String.copy (CtError.message &e)) @">"]))))))))))

(defn literal-evals-to-itself? [] (String.= &(eval-str "42") "42"))

(defn arithmetic-evaluates? [] (String.= &(eval-str "(+ 1 2)") "3"))

(defn nested-arithmetic-evaluates? []
  (String.= &(eval-str "(* (+ 1 2) (- 10 6))") "12"))

(defn let-binds-and-evaluates? []
  (String.= &(eval-str "(let [x 5] (+ x 2))") "7"))

(defn lambda-applies? [] (String.= &(eval-str "((fn [x] (+ x 1)) 4)") "5"))

(defn string-concat-evaluates? []
  (String.= &(eval-str "(String.concat [\"a\" \"b\"])") "\"ab\""))

(defn string-head-returns-one-character-string? []
  (String.= &(eval-str "(String.concat [(String.head \"abc\") \"b\"])") "\"ab\""))

; `split-on` follows the reference (Haskell's `splitOn`): pieces between
; separators, empty ones kept, and an empty separator splitting before every
; character
(defn split-on-evaluates? []
  (and
    (String.=
      &(eval-str "(Dynamic.String.split-on \"-\" \"a-b\")")
      "[\"a\" \"b\"]")
    (and
      (String.=
        &(eval-str "(Dynamic.String.split-on \"-\" \"-a-\")")
        "[\"\" \"a\" \"\"]")
      (and
        (String.=
          &(eval-str "(Dynamic.String.split-on \"\" \"aλ\")")
          "[\"\" \"a\" \"λ\"]")
        (and
          (String.= &(eval-str "(Dynamic.String.split-on \"-\" \"\")") "[\"\"]")
          (String.=
            &(eval-str "(String.split-on \"ab\" \"xabyab\")")
            "[\"x\" \"y\" \"\"]"))))))

; dynamic-type names static arrays, dictionaries and macros as the reference does
;; an array literal of forms is an array form, as in the reference; only a
;; literal holding something that is not a form is a collection, so a
;; collection never holds only forms
(defn array-literal-of-forms-is-a-form? []
  (and
    (String.= &(eval-str "[1 (+ 1 1) 'a]") "[1 2 a]")
    (and
      (String.= &(eval-str "(list? [1])") "false")
      (and
        (String.= &(eval-str "[car]") "<collection>")
        (and
          (String.= &(eval-str "(cdr [car 1])") "[1]")
          (String.= &(eval-str "(concat [1] [2])") "[1 2]"))))))

;; a list or array holding a value that is not a form is still a list or an
;; array, as in the reference, where any value can sit in one
(defn sequences-of-values-keep-their-kind? []
  (and
    (String.= &(eval-str "(list? (list car))") "true")
    (and
      (String.= &(eval-str "(dynamic-type (list car))") "list")
      (and
        (String.= &(eval-str "(array? [car])") "true")
        (and
          (String.= &(eval-str "(dynamic-type [car 1])") "array")
          (and
            (String.= &(eval-str "(list? (cons car '(1)))") "true")
            (String.= &(eval-str "(array? (cdr [car 1]))") "true")))))))

;; macro-log prints its arguments, a string as its text and anything else
;; rendered, as the reference does
(defn macro-log-renders? []
  (String.=
    &(CtEval.macro-log-text
      &[(Box.init
          (CtValue.Syntax
            (Box.init
              (SurfaceNode.init (SurfaceSpan.anywhere)
                                (SurfaceForm.StringLit @"n=")))))
        (Box.init
          (CtValue.Syntax
            (Box.init
              (SurfaceNode.init (SurfaceSpan.anywhere) (SurfaceForm.IntLit 3)))))
        (Box.init
          (CtValue.Syntax
            (Box.init
              (SurfaceNode.init (SurfaceSpan.anywhere)
                                (SurfaceForm.StringLit @"!")))))])
    "n=3!"))

;; build and run, the REPL commands, only record that the driver should
;; build and run what it compiles
(defn build-and-run-are-requests? []
  (do
    (CtEval.reset-requests!)
    (and (not (CtEval.build-requested?))
         (and
           (String.= &(eval-str "(Unsafe.request-build)") "()")
           (and (CtEval.build-requested?)
                (and (not (CtEval.run-requested?))
                     (and
                       (String.= &(eval-str "(Unsafe.request-run)") "()")
                       (CtEval.run-requested?))))))))

;; past the end of a sequence is an error, as in the reference: cdr of an
;; empty sequence, cddr of a one-element one, all-but-last of an empty one
(defn tail-past-the-end-errors? []
  (and
    (String.starts-with? &(eval-str "(cdr '())") "<error")
    (and
      (String.starts-with? &(eval-str "(cdr '[])") "<error")
      (and
        (String.starts-with? &(eval-str "(cddr '(1))") "<error")
        (and
          (String.starts-with? &(eval-str "(all-but-last '())") "<error")
          (String.= &(eval-str "(cdr '(1))") "()"))))))

;; write-file writes the string to the file at compile time, as the reference
;; does, and answers nil
(defn write-file-writes? []
  (and
    (String.=
      &(eval-str "(write-file \"ct-write-file-test.txt\" \"hi there\")")
      "()")
    (match (IO.read-file "ct-write-file-test.txt")
      (Result.Success text) (String.= &text "hi there")
      (Result.Error _) false)))

(defn dynamic-type-names-collections? []
  (and
    (String.= &(eval-str "(dynamic-type $[1])") "static-array")
    (and
      (String.= &(eval-str "(dynamic-type (quote {}))") "map")
      (and
        (String.= &(eval-str "(dynamic-type [1])") "array")
        (String.=
          &(eval-str-with-macro "m" [@"x"] "x" "(dynamic-type m)")
          "macro")))))

(defn unicode-string-to-list-evaluates? []
  (String.= &(eval-str "(String.to-list \"aλ\")") "(\"a\" \"λ\")"))

(defn unicode-string-commands-use-character-indices? []
  (and
    (String.= &(eval-str "(String.length \"aλb\")") "3")
    (and
      (String.= &(eval-str "(String.index-of \"aλb\" \\λ)") "1")
      (and
        (String.= &(eval-str "(String.char-at \"aλb\" 1)") "\\u03bb")
        (String.= &(eval-str "(String.slice \"aλb\" 1 2)") "\"λ\"")))))

(defn char-at-in-bounds? []
  (String.= &(eval-str "(String.char-at \"ab\" 1)") "\\b"))

(defn char-at-out-of-bounds-errors? []
  (let [rendered (eval-str "(String.char-at \"ab\" 5)")]
    (and
      (String.starts-with? &rendered "<error:")
      (String.in? &rendered "too large"))))

;; cons and cons-last keep the kind of the sequence they extend, and append
;; takes two of one kind, as the reference does
(defn sequence-builtins-keep-the-kind? []
  (and
    (String.= &(eval-str "(cons 1 [2 3])") "[1 2 3]")
    (and
      (String.= &(eval-str "(cons-last 4 [2 3])") "[2 3 4]")
      (and
        (String.= &(eval-str "(cons 1 '(2 3))") "(1 2 3)")
        (and
          (String.= &(eval-str "(cons 1 (array))") "[1]")
          (and
            (String.= &(eval-str "(dynamic-type (cons car [car]))") "array")
            (and
              (String.starts-with? &(eval-str "(append [1] '(2))") "<error")
              (String.starts-with? &(eval-str "(append '(1) [2])") "<error"))))))))

;; cdr, cddr and all-but-last keep the kind of the sequence they shorten, as
;; the reference does
(defn tails-keep-the-kind? []
  (and
    (String.= &(eval-str "(cdr [1 2 3])") "[2 3]")
    (and
      (String.= &(eval-str "(cddr [1 2 3])") "[3]")
      (and
        (String.= &(eval-str "(all-but-last [1 2 3])") "[1 2]")
        (and (String.= &(eval-str "(cdr [1])") "[]")
             (and
               (String.=
                 &(eval-str "(dynamic-type (all-but-last [1 car]))")
                 "array")
               (and
                 (String.= &(eval-str "(cdr '(1 2))") "(2)")
                 (String.= &(eval-str "(all-but-last '(1 2))") "(1)"))))))))

(defn cons-builds-a-list? []
  (String.= &(eval-str "(cons 1 (list 2 3))") "(1 2 3)"))

(defn cons-last-appends? []
  (String.= &(eval-str "(cons-last 3 (list 1 2))") "(1 2 3)"))

(defn append-joins-lists? []
  (String.= &(eval-str "(append (list 1) (list 2 3))") "(1 2 3)"))

(defn macro-call-expands-and-evaluates? []
  ; body BUILDS the expansion (+ 4 1); the call evaluates it to 5.
  (String.=
    &(eval-str-with-macro "inc!" [@"x"] "(list (quote +) x 1)" "(inc! 4)")
    "5"))

(defn macro-expansion-uses-unevaluated-arguments? []
  ; quoting the argument keeps it as data: (+ 1 2) arrives UNEVALUATED, so
  ; the result renders as the list, not as 3.
  (String.=
    &(eval-str-with-macro "q!" [@"x"] "(list (quote quote) x)" "(q! (+ 1 2))")
    "(+ 1 2)"))

(defn macro-as-value-returns-expansion-as-data? []
  ; `apply` on a macro yields the EXPANSION as syntax (the reference's
  ; semantics): (+ 4 1) stays unevaluated data, while a direct call would
  ; evaluate it to 5.
  (String.=
    &(eval-str-with-macro "inc!"
                          [@"x"]
                          "(list (quote +) x 1)"
                          "(apply inc! (list 4))")
    "(+ 4 1)"))

(defn pure-string-commands-are-exactly-the-three? []
  (and
    (CtEval.pure-string-command? "String.char-at")
    (and
      (CtEval.pure-string-command? "String.slice")
      (and
        (CtEval.pure-string-command? "String.index-of")
        (not (CtEval.pure-string-command? "String.length"))))))

; the reference applies `car`, `cdr` and `length` to list and array forms only:
; "Applying 'car' to non-list" for a static array or a Char.
(defn rejects? [source] (String.starts-with? &(eval-str source) "<error:"))

(defn car-of-an-array-form? [] (String.= &(eval-str "(car [1 2])") "1"))

(defn sequence-ops-reject-static-arrays? []
  (and (rejects? "(car $[1 2 3])")
       (and (rejects? "(cdr $[1 2 3])") (rejects? "(length $[1 2 3])"))))

(defn sequence-ops-reject-chars? []
  (and (rejects? "(car \\a)")
       (and (rejects? "(cdr \\a)") (rejects? "(length \\a)"))))

(defn unknown-symbol-errors? []
  (String.starts-with? &(eval-str "definitely-not-bound") "<error:"))

(deftest test
  (assert-true test (literal-evals-to-itself?) "a literal evaluates to itself")
  (assert-true test (arithmetic-evaluates?) "arithmetic evaluates")
  (assert-true test (nested-arithmetic-evaluates?) "nested arithmetic evaluates")
  (assert-true test
    (let-binds-and-evaluates?)
    "let binds and evaluates its body")
  (assert-true test (lambda-applies?) "a lambda applies to arguments")
  (assert-true test (string-concat-evaluates?) "String.concat evaluates")
  (assert-true test
    (string-head-returns-one-character-string?)
    "dynamic String.head composes as a one-character string")
  (assert-true test
    (unicode-string-to-list-evaluates?)
    "String.to-list splits Unicode by character rather than byte")
  (assert-true test
    (split-on-evaluates?)
    "split-on splits as the reference does")
  (assert-true test
    (array-literal-of-forms-is-a-form?)
    "an array literal of forms is an array form")
  (assert-true test (write-file-writes?) "write-file writes a file")
  (assert-true test
    (tail-past-the-end-errors?)
    "a tail past the end of a sequence is an error")
  (assert-true test
    (build-and-run-are-requests?)
    "build and run record requests for the driver")
  (assert-true test (macro-log-renders?) "macro-log renders its arguments")
  (assert-true test
    (sequences-of-values-keep-their-kind?)
    "a list or array of values that are not forms keeps its kind")
  (assert-true test
    (dynamic-type-names-collections?)
    "dynamic-type names static arrays, dictionaries and macros as the reference does")
  (assert-true test
    (unicode-string-commands-use-character-indices?)
    "compile-time string commands use Unicode character indices")
  (assert-true test (char-at-in-bounds?) "String.char-at works in bounds")
  (assert-true test
    (char-at-out-of-bounds-errors?)
    "String.char-at reports an index error out of bounds")
  (assert-true test (cons-builds-a-list?) "cons builds a list")
  (assert-true test
    (sequence-builtins-keep-the-kind?)
    "cons, cons-last and append keep the sequence's kind")
  (assert-true test
    (tails-keep-the-kind?)
    "cdr, cddr and all-but-last keep the sequence's kind")
  (assert-true test (cons-last-appends?) "cons-last appends")
  (assert-true test (append-joins-lists?) "append joins lists")
  (assert-true test
    (macro-call-expands-and-evaluates?)
    "a macro call expands, then evaluates")
  (assert-true test
    (macro-expansion-uses-unevaluated-arguments?)
    "macro arguments bind unevaluated")
  (assert-true test
    (macro-as-value-returns-expansion-as-data?)
    "apply on a macro returns the expansion as data")
  (assert-true test
    (pure-string-commands-are-exactly-the-three?)
    "pure-string-command? covers exactly the implemented commands")
  (assert-true test
    (car-of-an-array-form?)
    "car takes the head of an array form")
  (assert-true test
    (sequence-ops-reject-static-arrays?)
    "car, cdr and length reject a static array, as the reference does")
  (assert-true test
    (sequence-ops-reject-chars?)
    "car, cdr and length reject a Char: it is not a sequence")
  (assert-true test
    (unknown-symbol-errors?)
    "an unbound symbol is a compile-time error")
  (assert-equal test
    "<error: compile-time application expects a function: 1>"
    &(eval-str "(1)")
    "applying a literal is rejected rather than recursed on forever")
  (assert-equal test
    "<error: compile-time application expects a function: \"s\">"
    &(eval-str "(\"s\")")
    "the same for a string in head position"))
