(load "../carp-work.carp")
(load "Test.carp")
(Project.no-echo)
(use-all Test)

(defn stops-at-limit? []
  (let-do [_begin (WorkBudget.begin! 5 true (fn [] false))
           first (WorkBudget.consume! 2)
           second (WorkBudget.consume! 3)
           third (WorkBudget.consume! 1)
           reason (WorkBudget.end!)]
    (and first
         (and second
              (and (not third)
                   (match reason (Maybe.Just (WorkStop.Limit)) true _ false))))))

(defn cancels? []
  (let-do [_begin (WorkBudget.begin! 64 false (fn [] true))
           allowed (WorkBudget.consume! 64)
           reason (WorkBudget.end!)]
    (and (not allowed)
         (match reason (Maybe.Just (WorkStop.Cancelled)) true _ false))))

(defn stops-on-effect? []
  (let-do [_begin (WorkBudget.begin! 10 true (fn [] false))
           _effect (WorkBudget.forbid! "read-file")
           allowed (WorkBudget.consume! 1)
           reason (WorkBudget.end!)]
    (and (not allowed)
         (match reason
           (Maybe.Just (WorkStop.Effect effect)) (String.= &effect "read-file")
           _ false))))

(deftest test
  (assert-true test
    (stops-at-limit?)
    "bounded work stops before exceeding its allowance")
  (assert-true test (cancels?) "a bounded query polls cancellation")
  (assert-true test (stops-on-effect?) "a forbidden effect stops its query")
  (assert-true test
    (WorkBudget.consume! 1000000)
    "ending a query restores ordinary compilation")
  (assert-false test
    (WorkBudget.preview?)
    "preview policy does not leak into later work"))
