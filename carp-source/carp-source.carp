(load "carp-work.carp")

(doc SourceInput "is a source text. `id` names it in spans and diagnostics.
`source` is the UTF-8 text.")
(deftype SourceInput [id String
                      source String])

(doc SourceSpan "is a byte range in a source. `source-id` is the id of the
`SourceInput`. `start` is the offset of the first byte and `end` the offset
after the last.")
(deftype SourceSpan [source-id String
                     start Int
                     end Int])

(doc Diagnostic "is an error reported by the compiler or its tools. `phase`
names the compiler phase or tool that reported it. `message` describes the
error. `span` is its source location, if it can be tied to one.")
(deftype Diagnostic [phase String
                     message String
                     span (Maybe SourceSpan)])
