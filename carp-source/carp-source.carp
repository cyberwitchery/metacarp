(doc SourceInput "is one caller-owned source buffer. `id` is a stable logical
identity supplied by the client; `source` is the exact UTF-8 text parsed by the
compiler.")
(deftype SourceInput [id String
                      source String])

(doc SourceSpan "is a half-open UTF-8 byte range into the exact `SourceInput`
named by `source-id`. It is the stable span representation exposed by tooling
and session APIs.")
(deftype SourceSpan [source-id String
                     start Int
                     end Int])
