(doc WorkStop "is the reason a bounded query stopped. `Cancelled` means the
query was cancelled. `Limit` means it used up its budget. `Effect` means it
attempted a compile-time effect that a preview forbids, and holds the effect's
name. A stop is not a language error and should not be shown as one.")
(deftype WorkStop
  (Cancelled [])
  (Limit [])
  (Effect [String]))

(doc *work-remaining* "is the remaining budget of the running query, or -1 if
no query is running.")
(def *work-remaining* -1)
(doc *work-preview* "is whether the running query is a preview.")
(def *work-preview* false)
(doc *work-polls* "counts the calls to `consume!` in the running query.")
(def *work-polls* 0)
(doc *work-cancel* "is the cancellation callback of the running query.")
(def *work-cancel* (the (Maybe (Fn [] Bool)) (Maybe.Nothing)))
(doc *work-stop* "is the reason the running query stopped, if it has.")
(def *work-stop* (the (Maybe WorkStop) (Maybe.Nothing)))

(doc WorkBudget "limits the work a compiler query may do. Only one query can
run at a time. A query started with `begin!` must be ended with `end!`, whether
it succeeds or fails.")
(defmodule WorkBudget
  (doc begin! "starts a query with a budget of `steps`. In a preview,
compile-time effects are forbidden. The query is cancelled when `cancelled`
returns true.")
  (defn begin! [steps preview cancelled]
    (do
      (set! *work-remaining* (Int.max 0 (Int.min steps (Int.dec Int.MAX))))
      (set! *work-polls* 0)
      (set! *work-preview* preview)
      (set! *work-cancel* (Maybe.Just cancelled))
      (set! *work-stop* (Maybe.Nothing))))

  (doc preview? "whether the current query forbids external compile-time
effects.")
  (defn preview? [] *work-preview*)

  (doc active? "checks whether a query is running.")
  (defn active? [] (Int.>= *work-remaining* 0))

  (doc remaining "the remaining allowance, or -1 during ordinary compilation.")
  (defn remaining [] *work-remaining*)

  (doc stopped? "whether the current bounded query has stopped.")
  (defn stopped? [] (Maybe.just? &*work-stop*))

  (doc forbid! "stops the query because it attempted the effect `effect`.")
  (defn forbid! [effect]
    (when (Maybe.nothing? &*work-stop*)
      (set! *work-stop* (Maybe.Just (WorkStop.Effect (String.copy effect))))))

  (doc consume! "charges `cost` against the budget. Returns false if the query
has stopped.")
  (defn consume! [cost]
    (cond
      (Int.< *work-remaining* 0) true
      (Maybe.just? &*work-stop*) false
      (or (Int.< cost 0) (Int.> cost *work-remaining*))
        (do (set! *work-stop* (Maybe.Just (WorkStop.Limit))) false)
      (do
        (when (Int.= (Int.bit-and *work-polls* 63) 0)
          (match-ref &*work-cancel*
            (Maybe.Nothing) ()
            (Maybe.Just cancelled)
              (when (~cancelled)
                (set! *work-stop* (Maybe.Just (WorkStop.Cancelled))))))
        (set! *work-polls* (Int.inc *work-polls*))
        (set! *work-remaining* (Int.- *work-remaining* cost))
        (Maybe.nothing? &*work-stop*))))

  (doc reason "returns a message describing why the query stopped.")
  (defn reason []
    (String.copy
      (match-ref &*work-stop*
        (Maybe.Just (WorkStop.Cancelled)) "analysis cancelled"
        (Maybe.Just (WorkStop.Limit)) "analysis work limit reached"
        (Maybe.Just (WorkStop.Effect _))
          "compile-time effect requires an explicit query"
        _ "analysis stopped")))

  (doc end! "ends the query and returns the reason it stopped, if it did.")
  (defn end! []
    (let-do [stopped @(ref *work-stop*)]
      (set! *work-cancel* (Maybe.Nothing))
      (set! *work-stop* (Maybe.Nothing))
      (set! *work-remaining* -1)
      (set! *work-preview* false)
      stopped)))
