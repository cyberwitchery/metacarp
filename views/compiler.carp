; views/compiler.carp — views for the compiler's own artifacts.
;
; Loaded by `gt.carp`, the entry a GT session uses. A cell that answers a
; type, a diagnostic or a parsed module then inspects as that thing rather
; than as a print string.
;
; These use the shared carp-views runtime. gt.carp loads the inspector
; declarations as part of the session's project entry.

(defview metacarp-type
         [t MonoType]
         (=> (View.text) (View.title @"Type") (View.content (Type.render t))))

(defview metacarp-type-abi
         [t MonoType]
         (=> (View.text) (View.title @"ABI key") (View.content (Type.name t))))

(doc metacarp-type-parts "the parts a type is made of: the arguments of a
nominal application or a function, each of which is a type you can open.")
(defview metacarp-type-parts
         [t MonoType]
         (let [parts (let [boxed (match-ref t
                             (MonoType.Named _ arguments) @arguments
                             (MonoType.Function arguments _) @arguments
                             (MonoType.Reference inner _) [(Box.copy inner)]
                             _ (the (Array (Box MonoType)) []))]
                 (Array.copy-map &(fn [b] @(Box.peek b)) &boxed))]
           (if (Int.= 0 (Array.length &parts))
             (View.empty)
             (=> (View.columned)
                 (View.title @"Parts")
                 (View.with-columns
                   [(View.column @"#" (fn [i] (str i)))
                    (View.column @"Type"
                                 (fn [i]
                                   (Type.render (Array.unsafe-nth &parts i))))])
                 (View.items (fn [] (Array.length &parts)))
                 (View.send
                   (fn [i] (view-register @(Array.unsafe-nth &parts i))))))))

(defview metacarp-diagnostic
         [d Diagnostic]
         (=> (View.text)
             (View.title @"Diagnostic")
             (View.content
               (String.concat
                 &[@(Diagnostic.phase d) @": " @(Diagnostic.message d)]))))

(doc metacarp-diagnostic-span "where the diagnostic points, when the phase
that raised it had provenance to point with.")
(defview metacarp-diagnostic-span
         [d Diagnostic]
         (match-ref (Diagnostic.span d)
           (Maybe.Just span)
             (=> (View.columned)
                 (View.title @"Span")
                 (View.with-columns
                   [(View.column @"Field"
                                 (fn [i]
                                   (cond
                                     (Int.= i 0) @"input"
                                     (Int.= i 1) @"start"
                                     @"end")))
                    (View.column @"Value"
                                 (fn [i]
                                   (cond
                                     (Int.= i 0) @(SourceSpan.source-id span)
                                     (Int.= i 1) (str @(SourceSpan.start span))
                                     (str @(SourceSpan.end span)))))])
                 (View.items (fn [] 3)))
           (Maybe.Nothing) (View.empty)))

;; --- surface syntax ------------------------------------------------------

(defview metacarp-surface-source
         [n SurfaceNode]
         (=> (View.text)
             (View.title @"Source")
             (View.content (Surface.render n))))

(doc metacarp-surface-forms "a parsed file, one form per row. Each opens as
the node it is, which is how you walk what the parser actually saw.")
(defview metacarp-surface-forms
         [m SurfaceModule]
         (let [forms (Array.copy-map &(fn [f] @(Box.peek f))
                                     (SurfaceModule.forms m))]
           (=> (View.columned)
               (View.title @"Forms")
               (View.with-columns
                 [(View.column @"#" (fn [i] (str i)))
                  (View.column @"Form"
                               (fn [i]
                                 (View.cap
                                   (Surface.render (Array.unsafe-nth &forms i)))))])
               (View.items (fn [] (Array.length &forms)))
               (View.send (fn [i] (view-register @(Array.unsafe-nth &forms i)))))))

;; --- resolved and inferred programs --------------------------------------

(doc metacarp-core-definitions "what a resolved module defines, which is the
shape every later phase works on.")
(defview metacarp-core-definitions
         [m CoreModule]
         (let [functions (Array.copy-map
                 &(fn [f] @(CoreRef.name (CoreFunction.reference f)))
                 (CoreModule.functions m))]
           (=> (View.columned)
               (View.title @"Definitions")
               (View.with-columns
                 [(View.column @"#" (fn [i] (str i)))
                  (View.column @"Name" (fn [i] @(Array.unsafe-nth &functions i)))])
               (View.items (fn [] (Array.length &functions))))))

(doc metacarp-core-shape "the parts a resolved module carries, so an empty
one is distinguishable from a full one at a glance.")
(defview metacarp-core-shape
         [m CoreModule]
         (let [counts [(Array.length (CoreModule.functions m))
                       (Array.length (CoreModule.values m))
                       (Array.length (CoreModule.type-declarations m))
                       (Array.length (CoreModule.constructors m))
                       (Array.length (CoreModule.interfaces m))
                       (Array.length (CoreModule.implementations m))]
               names [@"functions"
                      @"values"
                      @"types"
                      @"constructors"
                      @"interfaces"
                      @"implementations"]]
           (=> (View.columned)
               (View.title @"Shape")
               (View.with-columns
                 [(View.column @"Part" (fn [i] @(Array.unsafe-nth &names i)))
                  (View.column @"Count"
                               (fn [i] (str @(Array.unsafe-nth &counts i))))])
               (View.items (fn [] 6)))))

(doc metacarp-inferred-schemes "every definition inference gave a scheme,
rendered the way a diagnostic renders a type.")
(defview metacarp-inferred-schemes
         [m InferredModule]
         (let [names (Array.copy-map
                 &(fn [b] @(CoreRef.name (SchemeBinding.reference b)))
                 (InferredModule.environment m))
               types (Array.copy-map
                 &(fn [b]
                   (Type.render
                     (Box.peek (TypeScheme.body (SchemeBinding.scheme b)))))
                 (InferredModule.environment m))]
           (=> (View.columned)
               (View.title @"Schemes")
               (View.with-columns
                 [(View.column @"Name" (fn [i] @(Array.unsafe-nth &names i)))
                  (View.column @"Type" (fn [i] @(Array.unsafe-nth &types i)))])
               (View.items (fn [] (Array.length &names))))))
