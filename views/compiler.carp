; Glamorous Toolkit views for compiler artifacts, loaded by `gt.carp`.
; These views depend on gt4carp notebook runtime bindings and are excluded
; from the standalone compiler build.

(defview metacarp-type
         [t MonoType]
         (=> (NB.text) (NB.title @"Type") (NB.content (Type.render t))))

(defview metacarp-type-abi
         [t MonoType]
         (=> (NB.text) (NB.title @"ABI key") (NB.content (Type.name t))))

(doc metacarp-type-parts
  "returns a view of a type's nominal arguments or function parameter and
result types.")
(defview metacarp-type-parts
         [t MonoType]
         (let [parts (let [boxed (match-ref t
                             (MonoType.Named _ arguments) @arguments
                             (MonoType.Function arguments _) @arguments
                             (MonoType.Reference inner _) [(Box.copy inner)]
                             _ (the (Array (Box MonoType)) []))]
                 (Array.copy-map &(fn [b] @(Box.peek b)) &boxed))]
           (if (Int.= 0 (Array.length &parts))
             (NB.empty)
             (=> (NB.columned)
                 (NB.title @"Parts")
                 (NB.with-columns
                   [(NB.column @"#" (fn [i] (str i)))
                    (NB.column @"Type"
                               (fn [i] (Type.render (Array.unsafe-nth &parts i))))])
                 (NB.items (fn [] (Array.length &parts)))
                 (NB.send (fn [i] (nb-register @(Array.unsafe-nth &parts i))))))))

(defview metacarp-diagnostic
         [d Diagnostic]
         (=> (NB.text)
             (NB.title @"Diagnostic")
             (NB.content
               (String.concat
                 &[@(Diagnostic.phase d) @": " @(Diagnostic.message d)]))))

(doc metacarp-diagnostic-span
  "returns a view of the diagnostic's optional source span.")
(defview metacarp-diagnostic-span
         [d Diagnostic]
         (match-ref (Diagnostic.span d)
           (Maybe.Just span)
             (=> (NB.columned)
                 (NB.title @"Span")
                 (NB.with-columns
                   [(NB.column @"Field"
                               (fn [i]
                                 (cond
                                   (Int.= i 0) @"input"
                                   (Int.= i 1) @"start"
                                   @"end")))
                    (NB.column @"Value"
                               (fn [i]
                                 (cond
                                   (Int.= i 0) @(SourceSpan.source-id span)
                                   (Int.= i 1) (str @(SourceSpan.start span))
                                   (str @(SourceSpan.end span)))))])
                 (NB.items (fn [] 3)))
           (Maybe.Nothing) (NB.empty)))

;; --- surface syntax ------------------------------------------------------

(defview metacarp-surface-source
         [n SurfaceNode]
         (=> (NB.text) (NB.title @"Source") (NB.content (Surface.render n))))

(doc metacarp-surface-forms
  "returns a view of parsed top-level forms with navigation to their surface
nodes.")
(defview metacarp-surface-forms
         [m SurfaceModule]
         (let [forms (Array.copy-map &(fn [f] @(Box.peek f))
                                     (SurfaceModule.forms m))]
           (=> (NB.columned)
               (NB.title @"Forms")
               (NB.with-columns
                 [(NB.column @"#" (fn [i] (str i)))
                  (NB.column @"Form"
                             (fn [i]
                               (NB.cap
                                 (Surface.render (Array.unsafe-nth &forms i)))))])
               (NB.items (fn [] (Array.length &forms)))
               (NB.send (fn [i] (nb-register @(Array.unsafe-nth &forms i)))))))

;; --- resolved and inferred programs --------------------------------------

(doc metacarp-core-definitions "returns a view of resolved module definitions.")
(defview metacarp-core-definitions
         [m CoreModule]
         (let [functions (Array.copy-map
                 &(fn [f] @(CoreRef.name (CoreFunction.reference f)))
                 (CoreModule.functions m))]
           (=> (NB.columned)
               (NB.title @"Definitions")
               (NB.with-columns
                 [(NB.column @"#" (fn [i] (str i)))
                  (NB.column @"Name" (fn [i] @(Array.unsafe-nth &functions i)))])
               (NB.items (fn [] (Array.length &functions))))))

(doc metacarp-core-shape
  "returns a view of a resolved module's fields and collection sizes.")
(defview metacarp-core-shape
         [m CoreModule]
         (let [counts [(Array.length (CoreModule.functions m))
                       (Array.length (CoreModule.values m))
                       (Array.length (CoreModule.type-declarations m))
                       (Array.length (CoreModule.constructors m))
                       (Array.length (CoreModule.interfaces m))
                       (Array.length (CoreModule.implementations m))]
               names [@"functions"
                      @"values"
                      @"types"
                      @"constructors"
                      @"interfaces"
                      @"implementations"]]
           (=> (NB.columned)
               (NB.title @"Shape")
               (NB.with-columns
                 [(NB.column @"Part" (fn [i] @(Array.unsafe-nth &names i)))
                  (NB.column @"Count"
                             (fn [i] (str @(Array.unsafe-nth &counts i))))])
               (NB.items (fn [] 6)))))

(doc metacarp-inferred-schemes
  "returns a view of inferred definition schemes rendered as source-shaped
types.")
(defview metacarp-inferred-schemes
         [m InferredModule]
         (let [names (Array.copy-map
                 &(fn [b] @(CoreRef.name (SchemeBinding.reference b)))
                 (InferredModule.environment m))
               types (Array.copy-map
                 &(fn [b]
                   (Type.render
                     (Box.peek (TypeScheme.body (SchemeBinding.scheme b)))))
                 (InferredModule.environment m))]
           (=> (NB.columned)
               (NB.title @"Schemes")
               (NB.with-columns
                 [(NB.column @"Name" (fn [i] @(Array.unsafe-nth &names i)))
                  (NB.column @"Type" (fn [i] @(Array.unsafe-nth &types i)))])
               (NB.items (fn [] (Array.length &names))))))
