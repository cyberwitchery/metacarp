; views/session.carp — views for what a warm session answers.
;
; Separate from views/compiler.carp because carp-session is a layer the
; compiler proper does not load; `gt.carp` loads both.

(doc metacarp-cell-definitions
  "returns a view of the cell report's definitions and their inferred schemes.")
(defview metacarp-cell-definitions
         [r CellReport]
         (let [names (Array.copy-map &(fn [d] @(SessionDefInfo.name d))
                                     (CellReport.definitions r))
               schemes (Array.copy-map &(fn [d] @(SessionDefInfo.scheme d))
                                       (CellReport.definitions r))]
           (=> (NB.columned)
               (NB.title @"Definitions")
               (NB.with-columns
                 [(NB.column @"Name" (fn [i] @(Array.unsafe-nth &names i)))
                  (NB.column @"Type" (fn [i] @(Array.unsafe-nth &schemes i)))])
               (NB.items (fn [] (Array.length &names))))))

(doc metacarp-cell-expressions
  "returns a view of the cell report's expressions and their inferred types.")
(defview metacarp-cell-expressions
         [r CellReport]
         (let [types (Array.copy-map &(fn [e] @(SessionTypedEntity.type e))
                                     (CellReport.expressions r))]
           (=> (NB.columned)
               (NB.title @"Expressions")
               (NB.with-columns
                 [(NB.column @"#" (fn [i] (str i)))
                  (NB.column @"Type" (fn [i] @(Array.unsafe-nth &types i)))])
               (NB.items (fn [] (Array.length &types))))))

(defview metacarp-definition
         [d SessionDefInfo]
         (=> (NB.text)
             (NB.title @"Definition")
             (NB.content
               (String.concat
                 &[@(SessionDefInfo.name d) @" : " @(SessionDefInfo.scheme d)]))))

(defview metacarp-candidate
         [c Candidate]
         (=> (NB.text)
             (NB.title @"Candidate")
             (NB.content
               (String.concat
                 &[@(Candidate.name c) @" : " @(Candidate.scheme c)]))))
