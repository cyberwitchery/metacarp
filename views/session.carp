; views/session.carp — views for what a warm session answers.
;
; Separate from views/compiler.carp because carp-session is a layer the
; compiler proper does not load; `gt.carp` loads both.

(doc metacarp-cell-definitions "the definitions a cell commits, with the type
the session gave each one.")
(defview metacarp-cell-definitions
         [r CellReport]
         (let [names (Array.copy-map &(fn [d] @(SessionDefInfo.name d))
                                     (CellReport.definitions r))
               schemes (Array.copy-map &(fn [d] @(SessionDefInfo.scheme d))
                                       (CellReport.definitions r))]
           (=> (View.columned)
               (View.title @"Definitions")
               (View.with-columns
                 [(View.column @"Name" (fn [i] @(Array.unsafe-nth &names i)))
                  (View.column @"Type" (fn [i] @(Array.unsafe-nth &schemes i)))])
               (View.items (fn [] (Array.length &names))))))

(doc metacarp-cell-expressions "the expressions a cell holds and what each one
turned out to be, which is what the editor prints beside your code.")
(defview metacarp-cell-expressions
         [r CellReport]
         (let [types (Array.copy-map &(fn [e] @(SessionTypedEntity.type e))
                                     (CellReport.expressions r))]
           (=> (View.columned)
               (View.title @"Expressions")
               (View.with-columns
                 [(View.column @"#" (fn [i] (str i)))
                  (View.column @"Type" (fn [i] @(Array.unsafe-nth &types i)))])
               (View.items (fn [] (Array.length &types))))))

(defview metacarp-definition
         [d SessionDefInfo]
         (=> (View.text)
             (View.title @"Definition")
             (View.content
               (String.concat
                 &[@(SessionDefInfo.name d) @" : " @(SessionDefInfo.scheme d)]))))

(defview metacarp-candidate
         [c Candidate]
         (=> (View.text)
             (View.title @"Candidate")
             (View.content
               (String.concat
                 &[@(Candidate.name c) @" : " @(Candidate.scheme c)]))))
