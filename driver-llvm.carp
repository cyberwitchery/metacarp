; the LLVM driver behind `metacarp --emit llvm`. it runs the same pipeline as
; the C driver up to lowering, then emits LLVM instead of C. without -b or -x
; it prints the IR. -b and -x emit an object file and link it with clang against
; the C support and a generated `main`. it needs libLLVM (see `LLVM.setup`).

(load "driver.carp")
(load "carp-llvm-backend/carp-llvm-backend.carp")

(doc lower-input "loads `input` with Core and lowers it to a `BackendModule`. It
reports errors and returns `Nothing` on failure.")
(defn lower-input [input core-dir no-core]
  (match (load-with-core input core-dir no-core)
    (Maybe.Nothing) (the (Maybe BackendModule) (Maybe.Nothing))
    (Maybe.Just pair)
      (match (CarpCompiler.lower-module-full (Pair.a &pair)
                                             &(ExpandConfig.init [@"Dynamic"])
                                             &(collect-check-names (Pair.b &pair))
                                             (source-echo-enabled? (Pair.b &pair)))
        (Result.Success backend) (Maybe.Just backend)
        (Result.Error error)
          (do
            (IO.errorln &(CompileError.render &error))
            (the (Maybe BackendModule) (Maybe.Nothing))))))

(doc emit-llvm "emits `backend` into a new LLVM module for the host and returns
its IR. If `obj-path` is given, it also writes an object file there. The module
is verified first.")
(defn emit-llvm [backend core-dir obj-path]
  (let-do [ctx (LLVM.context-create)
           builder (LLVM.builder-create ctx)
           mod (LLVM.module-create (String.cstr &@"carp") ctx)
           _init (do
             (ignore (LLVM.initialize-native-target))
             (ignore (LLVM.initialize-native-asm-printer))
             0)
           triple (LLVM.default-target-triple)
           tm (LLVM.create-target-machine
             (LLVM.target-from-triple (String.cstr &triple))
             (String.cstr &triple)
             (String.cstr &@"")
             (String.cstr &@"")
             LLVM.codegen-level-default
             LLVM.reloc-pic
             LLVM.codemodel-default)
           td (LLVM.create-target-data-layout tm)
           _setup (do
             (LLVM.set-target mod (String.cstr &triple))
             (LLVM.set-module-data-layout mod td)
             0)
           foreign-query (ForeignLayouts.query backend
                                               &triple
                                               core-dir
                                               &(CtEval.collected-cflags)
                                               "/tmp"
                                               &(ForeignLayouts.empty-cache))
           emit-result (match foreign-query
             (Result.Error message) (Result.Error message)
             (Result.Success cache)
               (LLVMBackend.emit-module-with-layouts ctx
                                                     builder
                                                     mod
                                                     td
                                                     backend
                                                     (ForeignLayoutCache.layouts &cache)))
           verify (LLVM.verify-module mod)
           result (match emit-result
             (Result.Error message)
               (Result.Error (fmt "llvm backend: %s" &message))
             (Result.Success _)
               (if (not (String.empty? &verify))
                 (Result.Error (fmt "llvm verifier: %s" &verify))
                 (match-ref obj-path
                   (Maybe.Nothing) (Result.Success (LLVM.print-module mod))
                   (Maybe.Just path)
                     (let [emit-error (LLVM.emit-to-file tm
                                                         mod
                                                         (String.cstr path)
                                                         LLVM.filetype-object)]
                       (if (String.empty? &emit-error)
                         (Result.Success (LLVM.print-module mod))
                         (Result.Error (fmt "llvm codegen: %s" &emit-error)))))))]
    (LLVM.dispose-target-data td)
    (LLVM.dispose-target-machine tm)
    (LLVM.module-dispose mod)
    (LLVM.builder-dispose builder)
    (LLVM.context-dispose ctx)
    result))

(doc executable-shim "returns the C to link beside the object file: the C
support of `backend` and a `main`. The `main` sets `System.args`, runs the roots
function, and calls the program's `main` if it has one. It returns that
function's `Int`, or 0.")
(defn executable-shim [backend]
  (match (LLVMBackend.shim-translation-unit backend)
    (Result.Success shim)
      (let [entry (find-entry backend)
            main-c (match-ref &entry
              (Maybe.Just pair) (if @(Pair.b pair) (fmt "int %s(void);
Array System_args;
int main(int argc, char** argv) {
  System_args.len = argc;
  System_args.data = argv;
  (void)carp_llvm_roots();
  return %s();
}
" (Pair.a pair) (Pair.a pair)) (fmt "void %s(void);
Array System_args;
int main(int argc, char** argv) {
  System_args.len = argc;
  System_args.data = argv;
  (void)carp_llvm_roots();
  %s();
  return 0;
}
" (Pair.a pair) (Pair.a pair)))
              (Maybe.Nothing) @"Array System_args;
int main(int argc, char** argv) {
  System_args.len = argc;
  System_args.data = argv;
  (void)carp_llvm_roots();
  return 0;
}
")]
        (Result.Success (String.concat &[shim @"
int carp_llvm_roots(void);
" main-c])))
    (Result.Error error) (Result.Error @(BackendError.message &error))))

(doc build-llvm "builds `backend` into the executable `binary`: an object file
linked with clang against the C support. On macOS, a debug build with
`bundle-debug` also runs `dsymutil`. It returns whether it succeeded.")
(defn build-llvm [backend core-dir binary log-memory debug bundle-debug]
  (let-do [obj (fmt "/tmp/carp-llvm-%d.o" (compiler-process-id))
           shim-c (fmt "/tmp/carp-llvm-%d-shim.c" (compiler-process-id))
           ok false]
    (match (emit-llvm backend core-dir &(Maybe.Just @&obj))
      (Result.Error e) (report-error &(fmt "%s" &e))
      (Result.Success _)
        (match (executable-shim backend)
          (Result.Error e) (report-error &(fmt "%s" &e))
          (Result.Success shim)
            (match (IO.write-file &shim &shim-c)
              (Result.Error e) (report-error &(fmt "cannot write shim: %s" &e))
              (Result.Success _)
                (if (Int.= 0
                           (System.system
                             &(fmt "%s %s-I . -I %s %s %s %s -lm -o %s"
                                   (ForeignLayouts.compiler)
                                   (if log-memory "-D LOG_MEMORY " "")
                                   core-dir
                                   &(String.join " " &(CtEval.collected-cflags))
                                   &shim-c
                                   &obj
                                   binary)))
                  (if (and debug
                           bundle-debug
                           (String.= &(compiler-host-os) "darwin"))
                    (if (Int.= 0 (System.system &(fmt "dsymutil %s" binary)))
                      (set! ok true)
                      (report-error "dsymutil failed"))
                    (set! ok true))
                  (report-error "clang failed")))))
    (compiler-remove-file &obj)
    (compiler-remove-file &shim-c)
    ok))

(doc llvm-build-action "builds `backend` into `output`, or the project's binary
path. It returns the exit code.")
(defn llvm-build-action [backend core-dir output log-memory debug]
  (let [binary (match-ref output
          (Maybe.Just p) @p
          (Maybe.Nothing) (project-binary))]
    (if (build-llvm backend core-dir &binary log-memory debug true)
      (do (report &(String.append "wrote executable " &binary)) 0)
      1)))

(doc llvm-execute-action "builds `backend` and runs it. It returns the program's
exit code, or 1 if it could not be built.")
(defn llvm-execute-action [backend core-dir log-memory debug]
  (let [binary (project-binary)]
    (if (build-llvm backend core-dir &binary log-memory debug false)
      (let [status (System.system &binary)] (compiler-system-exit-code status))
      1)))

(doc llvm-emit-action "writes the LLVM IR of `backend` to `output`, or to
standard output. It returns the exit code.")
(defn llvm-emit-action [backend core-dir output]
  (match (emit-llvm backend core-dir &(the (Maybe String) (Maybe.Nothing)))
    (Result.Error e) (do (report-error &(fmt "%s" &e)) 1)
    (Result.Success ir)
      (match-ref output
        (Maybe.Just path)
          (match (IO.write-file &ir path)
            (Result.Success _) 0
            (Result.Error e)
              (do (report-error &(fmt "cannot write '%s': %s" path &e)) 1))
        (Maybe.Nothing) (do (IO.print &ir) 0))))

(doc run-llvm "compiles `input` with the LLVM backend and runs `action` on it,
as `run` does for C. It needs a Core directory, also with `no-core`, to resolve
loads. It returns the exit code.")
(defn run-llvm [input core-dir output action no-core log-memory debug]
  (do
    (set! *want-source-map* debug)
    ;; the driver's builds always link the shim, so IR-side heap operations go
    ;; through its CARP_MALLOC/CARP_FREE helpers
    (LLVMBackend.use-carp-allocator!)
    (match (effective-core-dir core-dir)
      (Maybe.Nothing)
        (do
          (report-error
            "--core <dir> or CARP_DIR is required (--no-core still needs it for load resolution)")
          1)
      (Maybe.Just dir)
        (match (lower-input input &dir no-core)
          (Maybe.Nothing) 1
          (Maybe.Just backend)
            (cond
              (Int.= action 1)
                (llvm-build-action &backend &dir output log-memory debug)
              (Int.= action 2)
                (llvm-execute-action &backend &dir log-memory debug)
              (llvm-emit-action &backend &dir output))))))
