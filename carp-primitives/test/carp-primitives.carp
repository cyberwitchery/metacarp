(load "../carp-primitives.carp")
(Project.no-echo)
(load "Test.carp")

(use-all Test)

(defn contains-text? [text fragment]
  (Int.>= (String.index-of-string text fragment) 0))

(defn spec-by-id [entries id]
  (let-do [result (Array.unsafe-nth entries 0)
           n (Array.length entries)]
    (for [i 0 n]
      (when (Int.= id
                   @(CoreRef.id
                     (PrimitiveSpec.reference (Array.unsafe-nth entries i))))
        (set! result (Array.unsafe-nth entries i))))
    result))

(defn stable-registry-shape? []
  (let [globals (PrimitiveRegistry.globals)
        interfaces (PrimitiveRegistry.interfaces)
        builtins (PrimitiveRegistry.builtins)
        implementations (PrimitiveRegistry.implementations)]
    (and
      (Result.success? &(PrimitiveRegistry.validate))
      (and (Int.= 97 (Array.length &globals))
           (and (Int.= 4 (Array.length &interfaces))
                (and (Int.= 93 (Array.length &builtins))
                     (Int.= 47 (Array.length &implementations))))))))

(defn parameterized-copy-lowerings? []
  (let [entries (PrimitiveRegistry.specs)
        array-copy (spec-by-id &entries 52)
        pointer-copy (spec-by-id &entries 54)]
    (and
      (match-ref (PrimitiveSpec.lowering array-copy)
        (PrimitiveLowering.ParameterizedTemplate template)
          (match-ref template (PrimitiveTemplate.ArrayCopy _) true _ false)
        _ false)
      (match-ref (PrimitiveSpec.lowering pointer-copy)
        (PrimitiveLowering.ParameterizedTemplate template)
          (match-ref template (PrimitiveTemplate.PointerCopy) true _ false)
        _ false))))

(defn function-copy-lowerings? []
  (let-do [valid true
           entries (PrimitiveRegistry.specs)]
    (for [arity 0 10]
      (let [entry (spec-by-id &entries (Int.+ 55 arity))]
        (match-ref (PrimitiveSpec.lowering entry)
          (PrimitiveLowering.ParameterizedTemplate template)
            (match-ref template
              (PrimitiveTemplate.FunctionCopy found-arity)
                (unless-do (Int.= arity @found-arity) (set! valid false))
              _ (set! valid false))
          _ (set! valid false))))
    valid))

(defn function-delete-lowerings? []
  (let-do [valid true
           entries (PrimitiveRegistry.specs)]
    (for [arity 0 10]
      (let [entry (spec-by-id &entries (Int.+ 120 arity))]
        (match-ref (PrimitiveSpec.lowering entry)
          (PrimitiveLowering.ParameterizedTemplate template)
            (match-ref template
              (PrimitiveTemplate.FunctionDelete found-arity)
                (unless-do (Int.= arity @found-arity) (set! valid false))
              _ (set! valid false))
          _ (set! valid false))))
    valid))

(defn int-comparison-lowerings? []
  (let [entries (PrimitiveRegistry.specs)
        less-equal (spec-by-id &entries 45)
        greater-equal (spec-by-id &entries 46)
        not-equal (spec-by-id &entries 47)]
    (and
      (match-ref (PrimitiveSpec.lowering less-equal)
        (PrimitiveLowering.ParameterizedTemplate template)
          (match-ref template
            (PrimitiveTemplate.IntComparison comparison)
              (match-ref comparison
                (PrimitiveIntComparison.LessEqual) true
                _ false)
            _ false)
        _ false)
      (and
        (match-ref (PrimitiveSpec.lowering greater-equal)
          (PrimitiveLowering.ParameterizedTemplate template)
            (match-ref template
              (PrimitiveTemplate.IntComparison comparison)
                (match-ref comparison
                  (PrimitiveIntComparison.GreaterEqual) true
                  _ false)
              _ false)
          _ false)
        (match-ref (PrimitiveSpec.lowering not-equal)
          (PrimitiveLowering.ParameterizedTemplate template)
            (match-ref template
              (PrimitiveTemplate.IntComparison comparison)
                (match-ref comparison
                  (PrimitiveIntComparison.NotEqual) true
                  _ false)
              _ false)
          _ false)))))

(defn rejects-duplicate-registry-entries? []
  (let [entries (PrimitiveRegistry.specs)
        first (spec-by-id &entries 0)
        duplicates [(PrimitiveSpec.copy first) (PrimitiveSpec.copy first)]]
    (Result.error? &(PrimitiveRegistry.validate-specs &duplicates))))

(defn array-growth-allocates-null-storage? []
  (match (PrimitiveRegistry.template-c-for "Array.push-back")
    (Maybe.Just template)
      (and
        (contains-text? (Pair.b &template) "a.data ? CARP_REALLOC")
        (contains-text? (Pair.b &template) ": CARP_MALLOC"))
    (Maybe.Nothing) false))

(defn memory-of [entries id] (PrimitiveSpec.memory (spec-by-id entries id)))

(defn open? [manifest]
  (Array.any?
    &(fn [effect] (match-ref effect (CoreMemoryEffect.Unknown) true _ false))
    (CoreMemoryManifest.effects manifest)))

(defn structured-memory-manifests? []
  (let [entries (PrimitiveRegistry.specs)
        allocate (memory-of &entries 14)
        grow (memory-of &entries 25)
        index (memory-of &entries 11)
        interface (memory-of &entries 0)]
    (and
      (match-ref (Array.unsafe-nth (CoreMemoryManifest.effects allocate) 0)
        (CoreMemoryEffect.Allocate extent)
          (match-ref extent
            (CoreMemoryExtent.ArgumentElements argument) (Int.= @argument 0)
            _ false)
        _ false)
      (match-ref (Array.unsafe-nth (CoreMemoryManifest.effects grow) 0)
        (CoreMemoryEffect.Resize argument _ may-move)
          (and (Int.= @argument 0) @may-move)
        _ false)
      (= (CoreMemoryManifest.invalidates grow) &[0])
      (Array.empty? (CoreMemoryManifest.effects index))
      (open? interface))))

(defn higher-order-primitives-remain-unknown? []
  (let [entries (PrimitiveRegistry.specs)] (open? (memory-of &entries 39))))

; `Pair.init-from-refs` copies both members and `field-set!` deletes the value
; it overwrites; neither is annotated, so neither may claim no effect.
(defn unannotated-builtins-stay-unknown? []
  (let [entries (PrimitiveRegistry.specs)]
    (and (open? (memory-of &entries 31)) (open? (memory-of &entries 49)))))

(defn element-calling-templates-stay-open? []
  (let [entries (PrimitiveRegistry.specs)
        array-delete (memory-of &entries 72)]
    (and (open? array-delete)
         (match-ref (Array.unsafe-nth
             (CoreMemoryManifest.effects array-delete)
             0)
           (CoreMemoryEffect.Free argument) (Int.= @argument 0)
           _ false)
         (open? (memory-of &entries 52))
         (open? (memory-of &entries 41)))))

(deftest t
  (assert-true t
    (stable-registry-shape?)
    "the registry exposes stable globals, phases, and implementations")
  (assert-true t
    (parameterized-copy-lowerings?)
    "container copy primitives declare parameterized-template lowering")
  (assert-true t
    (function-copy-lowerings?)
    "function-copy templates cover arities zero through nine")
  (assert-true t
    (function-delete-lowerings?)
    "function-delete templates cover arities zero through nine")
  (assert-true t
    (int-comparison-lowerings?)
    "compiler-provided Int comparisons declare semantic template lowering")
  (assert-true t
    (rejects-duplicate-registry-entries?)
    "registry validation rejects duplicate IDs and names")
  (assert-true t
    (array-growth-allocates-null-storage?)
    "growing a NULL-backed array records its first allocation")
  (assert-true t
    (structured-memory-manifests?)
    "primitive manifests separate allocation, relocation, free, no-effect, and unknown")
  (assert-true t
    (higher-order-primitives-remain-unknown?)
    "higher-order intrinsics cannot hide callback memory effects")
  (assert-true t
    (unannotated-builtins-stay-unknown?)
    "a builtin without a declared manifest does not claim no effect")
  (assert-true t
    (element-calling-templates-stay-open?)
    "templates that call element interfaces keep their direct effect and stay open"))
