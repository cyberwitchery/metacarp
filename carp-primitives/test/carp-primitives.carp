(load "../carp-primitives.carp")
(Project.no-echo)
(load "Test.carp")

(use-all Test)

(defn spec-by-id [entries id]
  (let-do [result (Array.unsafe-nth entries 0)
           n (Array.length entries)]
    (for [i 0 n]
      (when (Int.= id
                   @(CoreRef.id
                     (PrimitiveSpec.reference (Array.unsafe-nth entries i))))
        (set! result (Array.unsafe-nth entries i))))
    result))

(defn stable-registry-shape? []
  (let [globals (PrimitiveRegistry.globals)
        interfaces (PrimitiveRegistry.interfaces)
        builtins (PrimitiveRegistry.builtins)
        implementations (PrimitiveRegistry.implementations)]
    (and
      (Result.success? &(PrimitiveRegistry.validate))
      (and (Int.= 103 (Array.length &globals))
           (and (Int.= 4 (Array.length &interfaces))
                (and (Int.= 99 (Array.length &builtins))
                     (Int.= 51 (Array.length &implementations))))))))

(defn parameterized-copy-lowerings? []
  (let [entries (PrimitiveRegistry.specs)
        array-copy (spec-by-id &entries 52)
        box-copy (spec-by-id &entries 53)
        pointer-copy (spec-by-id &entries 54)]
    (and
      (match-ref (PrimitiveSpec.lowering array-copy)
        (PrimitiveLowering.ParameterizedTemplate template)
          (match-ref template (PrimitiveTemplate.ArrayCopy _) true _ false)
        _ false)
      (and
        (match-ref (PrimitiveSpec.lowering box-copy)
          (PrimitiveLowering.ParameterizedTemplate template)
            (match-ref template (PrimitiveTemplate.BoxCopy _) true _ false)
          _ false)
        (match-ref (PrimitiveSpec.lowering pointer-copy)
          (PrimitiveLowering.ParameterizedTemplate template)
            (match-ref template (PrimitiveTemplate.PointerCopy) true _ false)
          _ false)))))

(defn function-copy-lowerings? []
  (let-do [valid true
           entries (PrimitiveRegistry.specs)]
    (for [arity 0 10]
      (let [entry (spec-by-id &entries (Int.+ 55 arity))]
        (match-ref (PrimitiveSpec.lowering entry)
          (PrimitiveLowering.ParameterizedTemplate template)
            (match-ref template
              (PrimitiveTemplate.FunctionCopy found-arity)
                (unless-do (Int.= arity @found-arity) (set! valid false))
              _ (set! valid false))
          _ (set! valid false))))
    valid))

(defn function-delete-lowerings? []
  (let-do [valid true
           entries (PrimitiveRegistry.specs)]
    (for [arity 0 10]
      (let [entry (spec-by-id &entries (Int.+ 120 arity))]
        (match-ref (PrimitiveSpec.lowering entry)
          (PrimitiveLowering.ParameterizedTemplate template)
            (match-ref template
              (PrimitiveTemplate.FunctionDelete found-arity)
                (unless-do (Int.= arity @found-arity) (set! valid false))
              _ (set! valid false))
          _ (set! valid false))))
    valid))

(defn int-comparison-lowerings? []
  (let [entries (PrimitiveRegistry.specs)
        less-equal (spec-by-id &entries 45)
        greater-equal (spec-by-id &entries 46)
        not-equal (spec-by-id &entries 47)]
    (and
      (match-ref (PrimitiveSpec.lowering less-equal)
        (PrimitiveLowering.ParameterizedTemplate template)
          (match-ref template
            (PrimitiveTemplate.IntComparison comparison)
              (match-ref comparison
                (PrimitiveIntComparison.LessEqual) true
                _ false)
            _ false)
        _ false)
      (and
        (match-ref (PrimitiveSpec.lowering greater-equal)
          (PrimitiveLowering.ParameterizedTemplate template)
            (match-ref template
              (PrimitiveTemplate.IntComparison comparison)
                (match-ref comparison
                  (PrimitiveIntComparison.GreaterEqual) true
                  _ false)
              _ false)
          _ false)
        (match-ref (PrimitiveSpec.lowering not-equal)
          (PrimitiveLowering.ParameterizedTemplate template)
            (match-ref template
              (PrimitiveTemplate.IntComparison comparison)
                (match-ref comparison
                  (PrimitiveIntComparison.NotEqual) true
                  _ false)
              _ false)
          _ false)))))

(defn rejects-duplicate-registry-entries? []
  (let [entries (PrimitiveRegistry.specs)
        first (spec-by-id &entries 0)
        duplicates [(PrimitiveSpec.copy first) (PrimitiveSpec.copy first)]]
    (Result.error? &(PrimitiveRegistry.validate-specs &duplicates))))

(deftest t
  (assert-true t
    (stable-registry-shape?)
    "the registry exposes stable globals, phases, and implementations")
  (assert-true t
    (parameterized-copy-lowerings?)
    "container copy primitives declare parameterized-template lowering")
  (assert-true t
    (function-copy-lowerings?)
    "function-copy templates cover arities zero through nine")
  (assert-true t
    (function-delete-lowerings?)
    "function-delete templates cover arities zero through nine")
  (assert-true t
    (int-comparison-lowerings?)
    "compiler-provided Int comparisons declare semantic template lowering")
  (assert-true t
    (rejects-duplicate-registry-entries?)
    "registry validation rejects duplicate IDs and names"))
