(load "../carp-ir/carp-ir.carp")

(deftype PrimitivePhase
  (Interface [])
  (Runtime []))

(deftype PrimitiveIntComparison
  (LessEqual [])
  (GreaterEqual [])
  (NotEqual []))

(deftype PrimitiveTemplate
  (ArrayCopy [CoreRef])
  (ArrayStr [CoreRef])
  (ArrayDelete [CoreRef])
  (BoxDelete [CoreRef])
  (BoxCopy [CoreRef])
  (BoxStr [CoreRef])
  (PairCopy [CoreRef])
  (PointerCopy [])
  (FunctionCopy [Int])
  (FunctionDelete [Int])
  (FunctionStr [])
  (IntComparison [PrimitiveIntComparison])
  (CollectionLength []))

(deftype PrimitiveLowering
  (Intrinsic [])
  (ParameterizedTemplate [PrimitiveTemplate]))

(deftype PrimitiveSpec
  [reference CoreRef
   signature (Box CoreType)
   phase PrimitivePhase
   lowering PrimitiveLowering])

(deftype PrimitiveRegistryError [message String])

(defmodule PrimitiveRegistry
  (defn reference [id name] (CoreRef.init id (String.copy name) true))

  (doc delete-reference "the stable identity of the built-in `delete` ownership
interface. Ownership analysis matches delete implementations against this
reference, not against the spelling \"delete\".")
  (defn delete-reference [] (reference 3 "delete"))

  (doc ref-reference "the stable identity of the built-in `ref` borrow
primitive. Ownership analysis recognizes borrows by this reference, not by the
spelling \"ref\".")
  (defn ref-reference [] (reference 5 "ref"))

  (doc str-reference "the stable identity of the built-in `str` interface, for
demands raised outside resolution (e.g. top-level result echo).")
  (defn str-reference [] (reference 1 "str"))

  (defn variable [name] (CoreType.Variable (String.copy name)))

  (defn named-one [name parameter]
    (CoreType.Named (String.copy name) [(Box.init parameter)]))

  (defn named-two [name first second]
    (CoreType.Named (String.copy name) [(Box.init first) (Box.init second)]))

  (defn reference-type [inner]
    (CoreType.Reference (Box.init inner) (CoreLifetime.Inferred 0)))

  (defn function [arguments result]
    (CoreType.Function arguments (Box.init result)))

  (defn interface-spec [id name signature]
    (PrimitiveSpec.init (reference id name)
                        (Box.init signature)
                        (PrimitivePhase.Interface)
                        (PrimitiveLowering.Intrinsic)))

  (defn builtin-spec [id name signature]
    (PrimitiveSpec.init (reference id name)
                        (Box.init signature)
                        (PrimitivePhase.Runtime)
                        (PrimitiveLowering.Intrinsic)))

  (defn template-spec [id name signature template]
    (PrimitiveSpec.init (reference id name)
                        (Box.init signature)
                        (PrimitivePhase.Runtime)
                        (PrimitiveLowering.ParameterizedTemplate template)))

  ;; Concrete (Array a)-exposing signatures for the array built-ins whose C is a
  ;; per-element source template (see template-c-for). The element variable must
  ;; be spelled "a" so the template's `$a` binds during codegen.
  (defn array-of-a [] (named-one "Array" (variable "a")))
  (defn ref-array-of-a [] (reference-type (named-one "Array" (variable "a"))))
  (defn ptr-of-a [] (named-one "Ptr" (variable "a")))

  (defn array-raw [id name]
    (builtin-spec id name (function [(Box.init (ref-array-of-a))] (ptr-of-a))))

  (defn array-raw-value [id name]
    (builtin-spec id name (function [(Box.init (array-of-a))] (ptr-of-a))))

  (defn tpl-push-back [id name]
    (builtin-spec id
                  name
                  (function
                    [(Box.init (array-of-a)) (Box.init (variable "a"))]
                    (array-of-a))))
  (defn tpl-push-back-mut [id name]
    (builtin-spec id
                  name
                  (function
                    [(Box.init (ref-array-of-a)) (Box.init (variable "a"))]
                    (CoreType.Unit))))
  (defn tpl-pop-back [id name]
    (builtin-spec id name (function [(Box.init (array-of-a))] (array-of-a))))
  (defn tpl-aset [id name]
    (builtin-spec id
                  name
                  (function
                    [(Box.init (array-of-a))
                     (Box.init (CoreType.Integer))
                     (Box.init (variable "a"))]
                    (array-of-a))))
  (defn tpl-aset-mut [id name]
    (builtin-spec id
                  name
                  (function
                    [(Box.init (ref-array-of-a))
                     (Box.init (CoreType.Integer))
                     (Box.init (variable "a"))]
                    (CoreType.Unit))))
  (defn tpl-endo-map [id name]
    (builtin-spec id
                  name
                  (function
                    [(Box.init
                       (reference-type
                         (function [(Box.init (variable "a"))] (variable "a"))))
                     (Box.init (array-of-a))]
                    (array-of-a))))
  (defn tpl-endo-filter [id name]
    (builtin-spec id
                  name
                  (function
                    [(Box.init
                       (reference-type
                         (function
                           [(Box.init (reference-type (variable "a")))]
                           (CoreType.Boolean))))
                     (Box.init (array-of-a))]
                    (array-of-a))))
  (defn collection-str [id name collection-name template]
    (template-spec id
                   name
                   (function
                     [(Box.init
                        (reference-type
                          (named-one collection-name (variable "a"))))]
                     (CoreType.String))
                   template))

  (defn copy-interface []
    (interface-spec 0
                    "copy"
                    (function
                      [(Box.init (reference-type (variable "a")))]
                      (variable "a"))))

  (defn string-interface [id name]
    (interface-spec id
                    name
                    (function [(Box.init (variable "a"))] (CoreType.String))))

  (defn delete-interface []
    (interface-spec 3
                    "delete"
                    (function [(Box.init (variable "a"))] (CoreType.Unit))))

  (defn unary [id name result]
    (builtin-spec id name (function [(Box.init (variable "a"))] result)))

  (defn ref-builtin []
    (builtin-spec 5
                  "ref"
                  (function [(Box.init (variable "a"))]
                            (reference-type (variable "a")))))

  (defn deref-builtin []
    (builtin-spec 6
                  "deref"
                  (function
                    [(Box.init (reference-type (variable "a")))]
                    (variable "a"))))

  (defn null-builtin [] (builtin-spec 7 "NULL" (named-one "Ptr" (variable "a"))))

  (defn box-unbox []
    (builtin-spec 4
                  "Box.unbox"
                  (function
                    [(Box.init (named-one "Box" (variable "a")))]
                    (variable "a"))))

  (defn box-init []
    (builtin-spec 67
                  "Box.init"
                  (function [(Box.init (variable "a"))]
                            (named-one "Box" (variable "a")))))

  (defn box-peek []
    (builtin-spec 68
                  "Box.peek"
                  (function
                    [(Box.init (reference-type (named-one "Box" (variable "a"))))]
                    (reference-type (variable "a")))))

  (defn box-str []
    (template-spec 69
                   "Box.str"
                   (function
                     [(Box.init
                        (reference-type (named-one "Box" (variable "a"))))]
                     (CoreType.String))
                   ;; elements render through `prn` like the reference
                   ;; (StructUtils/ArrayTemplates dispatch "prn" for members).
                   (PrimitiveTemplate.BoxStr (reference 2 "prn"))))

  ;; length instances need real bodies when referenced as values (e.g.
  ;; `&Array.length` passed to copy-map); call sites still inline `.len`.
  (defn length-builtin [id name]
    (template-spec id
                   name
                   (function [(Box.init (variable "a"))] (CoreType.Integer))
                   (PrimitiveTemplate.CollectionLength)))

  ;; the concrete `Array.length`/`StaticArray.length` take a reference to their
  ;; collection, not an unconstrained value: this constrains callers like
  ;; `(defn empty? [a] (= (Array.length a) 0))` so their parameter resolves to
  ;; `(Ref (Array a))` and interface dispatch is not ambiguous with StaticArray.
  (defn collection-length-builtin [id name collection-name]
    (template-spec id
                   name
                   (function
                     [(Box.init
                        (reference-type
                          (named-one collection-name (variable "a"))))]
                     (CoreType.Integer))
                   (PrimitiveTemplate.CollectionLength)))

  (defn get-tag-builtin []
    (builtin-spec 48
                  "get-tag"
                  (function
                    [(Box.init (reference-type (variable "a")))]
                    (CoreType.Integer))))

  ;; in-place struct-field write behind a `(Ref a)`: arguments are the record
  ;; reference, the constructor tag, the member index, and the new value. The
  ;; backend renders it as `(*self).data.variant_<tag>.member_<index> = value`;
  ;; it backs the mutating `set-<field>!` accessors Derive generates.
  (defn field-set-builtin []
    (builtin-spec 49
                  "field-set!"
                  (function
                    [(Box.init (reference-type (variable "a")))
                     (Box.init (CoreType.Integer))
                     (Box.init (CoreType.Integer))
                     (Box.init (variable "b"))]
                    (CoreType.Unit))))

  (defn generic-index [id name]
    (builtin-spec id
                  name
                  (function
                    [(Box.init (ref-array-of-a)) (Box.init (CoreType.Integer))]
                    (reference-type (variable "a")))))

  (defn indexed [id name collection-name]
    (builtin-spec id
                  name
                  (function
                    [(Box.init
                       (reference-type
                         (named-one collection-name (variable "element"))))
                     (Box.init (CoreType.Integer))]
                    (reference-type (variable "element")))))

  (defn allocate [id name]
    (builtin-spec id
                  name
                  (function [(Box.init (CoreType.Integer))]
                            (named-one "Array" (variable "a")))))

  (defn generic-set [id name]
    (builtin-spec id
                  name
                  (function
                    [(Box.init (ref-array-of-a))
                     (Box.init (CoreType.Integer))
                     (Box.init (variable "a"))]
                    (CoreType.Unit))))

  (defn indexed-set [id name collection-name]
    (builtin-spec id
                  name
                  (function
                    [(Box.init
                       (reference-type
                         (named-one collection-name (variable "element"))))
                     (Box.init (CoreType.Integer))
                     (Box.init (variable "element"))]
                    (CoreType.Unit))))

  (defn generic-set-value [id name]
    (builtin-spec id
                  name
                  (function
                    [(Box.init (array-of-a))
                     (Box.init (CoreType.Integer))
                     (Box.init (variable "a"))]
                    (array-of-a))))

  (defn indexed-set-value [id name collection-name]
    (builtin-spec id
                  name
                  (function
                    [(Box.init (named-one collection-name (variable "element")))
                     (Box.init (CoreType.Integer))
                     (Box.init (variable "element"))]
                    (named-one collection-name (variable "element")))))

  (defn generic-push [id name]
    (builtin-spec id
                  name
                  (function
                    [(Box.init (array-of-a)) (Box.init (variable "a"))]
                    (array-of-a))))

  (defn generic-push-mut [id name]
    (builtin-spec id
                  name
                  (function
                    [(Box.init (ref-array-of-a)) (Box.init (variable "a"))]
                    (CoreType.Unit))))

  (defn generic-pop [id name]
    (builtin-spec id name (function [(Box.init (array-of-a))] (array-of-a))))

  (defn array-pop-mut [id name]
    (builtin-spec id
                  name
                  (function
                    [(Box.init
                       (reference-type (named-one "Array" (variable "a"))))]
                    (variable "a"))))

  (defn array-delete [id name]
    (template-spec id
                   name
                   (function [(Box.init (array-of-a))] (CoreType.Unit))
                   (PrimitiveTemplate.ArrayDelete (reference 3 "delete"))))

  ;; `Box` owns a heap allocation exactly like `Array`: its deleter frees the
  ;; boxed cell after deleting a managed element.
  (defn box-delete [id name]
    (template-spec id
                   name
                   (function
                     [(Box.init (named-one "Box" (variable "a")))]
                     (CoreType.Unit))
                   (PrimitiveTemplate.BoxDelete (reference 3 "delete"))))

  (defn string-command [id name]
    (builtin-spec id
                  name
                  (function
                    [(Box.init (reference-type (CoreType.String)))]
                    (CoreType.Unit))))

  (defn pair-init [id name]
    (builtin-spec id
                  name
                  (function
                    [(Box.init (variable "a")) (Box.init (variable "b"))]
                    (CoreType.Named (String.copy "Pair")
                                    [(Box.init (variable "a"))
                                     (Box.init (variable "b"))]))))

  (defn pair-init-from-refs [id name]
    (builtin-spec id
                  name
                  (function
                    [(Box.init (reference-type (variable "a")))
                     (Box.init (reference-type (variable "b")))]
                    (CoreType.Named (String.copy "Pair")
                                    [(Box.init (variable "a"))
                                     (Box.init (variable "b"))]))))

  (defn unary-polymorphic [id name]
    (builtin-spec id
                  name
                  (function [(Box.init (variable "input"))] (variable "output"))))

  (defn pair-set-b []
    (builtin-spec 34
                  "Pair.set-b"
                  (function
                    [(Box.init (variable "pair")) (Box.init (variable "b"))]
                    (variable "pair"))))

  (defn string-builtin [id name] (unary id name (CoreType.String)))

  (defn ignore-builtin [] (unary 42 "ignore" (CoreType.Unit)))

  (defn int-comparison [id name comparison]
    (template-spec id
                   name
                   (function
                     [(Box.init (CoreType.Integer))
                      (Box.init (CoreType.Integer))]
                     (CoreType.Boolean))
                   (PrimitiveTemplate.IntComparison comparison)))

  (defn collection-int-transform [id name]
    (builtin-spec id
                  name
                  (function
                    [(Box.init (reference-type (variable "collection")))
                     (Box.init (CoreType.Integer))]
                    (variable "collection"))))

  (defn parameterized-copy [id name container-name template]
    (template-spec id
                   name
                   (function
                     [(Box.init
                        (reference-type
                          (named-one container-name (variable "a"))))]
                     (named-one container-name (variable "a")))
                   template))

  (defn pair-copy [id name template]
    (let [pair-type (named-two "Pair" (variable "a") (variable "b"))]
      (template-spec id
                     name
                     (function
                       [(Box.init (reference-type (CoreType.copy &pair-type)))]
                       pair-type)
                     template)))

  (defn function-type [arity]
    (let-do [arguments (the (Array (Box CoreType)) [])]
      (for [i 0 arity]
        (set! arguments
              (Array.push-back arguments
                               (Box.init
                                 (variable
                                   &(String.concat &[@"argument" (Int.str i)]))))))
      (function arguments (variable "result"))))

  (defn function-copy-spec [arity]
    (let [name (String.concat &[@"Function.Arity" (Int.str arity) @".copy"])]
      (template-spec (Int.+ 55 arity)
                     &name
                     (function
                       [(Box.init (reference-type (function-type arity)))]
                       (function-type arity))
                     (PrimitiveTemplate.FunctionCopy arity))))

  (defn function-delete-spec [arity]
    (let [name (String.concat &[@"Function.Arity" (Int.str arity) @".delete"])]
      (template-spec (Int.+ 120 arity)
                     &name
                     (function [(Box.init (function-type arity))]
                               (CoreType.Unit))
                     (PrimitiveTemplate.FunctionDelete arity))))

  ;; the reference gives every function type a `str`/`prn` that renders the
  ;; fixed string "λ" (StartingEnv.generateTemplateFuncStrOrPrn). A deftype with
  ;; a function-typed member needs it to derive its own str.
  (defn function-str-spec [id arity name-suffix]
    (let [name (String.concat
            &[@"Function.Arity" (Int.str arity) @"." @name-suffix])]
      (template-spec id
                     &name
                     (function
                       [(Box.init (reference-type (function-type arity)))]
                       (CoreType.String))
                     (PrimitiveTemplate.FunctionStr))))

  (defn base-specs []
    [(copy-interface)
     (string-interface 1 "str")
     (string-interface 2 "prn")
     (delete-interface)
     (box-unbox)
     (ref-builtin)
     (deref-builtin)
     (null-builtin)
     (length-builtin 8 "length")
     (box-init)
     (box-peek)
     (box-str)
     (collection-length-builtin 9 "Array.length" "Array")
     (collection-length-builtin 10 "StaticArray.length" "StaticArray")
     (get-tag-builtin)
     (field-set-builtin)
     (generic-index 11 "unsafe-nth")
     (indexed 12 "Array.unsafe-nth" "Array")
     (indexed 13 "StaticArray.unsafe-nth" "StaticArray")
     (allocate 14 "allocate")
     (allocate 15 "Array.allocate")
     (generic-set 16 "aset-uninitialized!")
     (indexed-set 17 "Array.aset-uninitialized!" "Array")
     (indexed-set 18 "StaticArray.aset-uninitialized!" "StaticArray")
     (indexed-set 21 "StaticArray.aset!" "StaticArray")
     (generic-set 19 "aset!")
     (tpl-aset-mut 20 "Array.aset!")
     (indexed-set-value 30 "StaticArray.aset" "StaticArray")
     (tpl-aset 29 "Array.aset")
     (tpl-push-back 23 "Array.push-back")
     (generic-push-mut 24 "push-back!")
     (tpl-push-back-mut 25 "Array.push-back!")
     (tpl-pop-back 27 "Array.pop-back")
     (generic-set-value 28 "aset")
     ;; the bare names carry the array-shaped signatures so their template's
     ;; `$a` binds; the reference only ever defines these for arrays.
     (tpl-endo-filter 36 "endo-filter")
     (tpl-endo-filter 37 "Array.endo-filter")
     (tpl-endo-map 39 "endo-map")
     (tpl-endo-map 40 "Array.endo-map")
     ;; elements render through `prn` like the reference (ArrayTemplates
     ;; dispatches "prn" inside arrays, so strings show as @"..." literals).
     (collection-str 41
                     "Array.str"
                     "Array"
                     (PrimitiveTemplate.ArrayStr (reference 2 "prn")))
     (collection-str 71
                     "StaticArray.str"
                     "StaticArray"
                     (PrimitiveTemplate.ArrayStr (reference 2 "prn")))
     (array-pop-mut 50 "pop-back!")
     (array-pop-mut 51 "Array.pop-back!")
     (pair-init-from-refs 31 "Pair.init-from-refs")
     (unary-polymorphic 32 "Pair.a")
     (unary-polymorphic 33 "Pair.b")
     (pair-set-b)
     (unary-polymorphic 35 "Pair.reverse")
     (pair-init 38 "Pair.init")
     (ignore-builtin)
     (int-comparison 45 "Int.<=" (PrimitiveIntComparison.LessEqual))
     (int-comparison 46 "Int.>=" (PrimitiveIntComparison.GreaterEqual))
     (int-comparison 47 "Int./=" (PrimitiveIntComparison.NotEqual))
     (parameterized-copy 52
                         "Array.copy"
                         "Array"
                         (PrimitiveTemplate.ArrayCopy (reference 0 "copy")))
     (parameterized-copy 53
                         "Box.copy"
                         "Box"
                         (PrimitiveTemplate.BoxCopy (reference 0 "copy")))
     (parameterized-copy 54 "Pointer.copy" "Ptr" (PrimitiveTemplate.PointerCopy))
     (array-raw 65 "unsafe-raw")
     (array-raw-value 70 "Array.raw")
     (pair-copy 66 "Pair.copy" (PrimitiveTemplate.PairCopy (reference 0 "copy")))
     (array-delete 72 "Array.delete")
     (box-delete 76 "Box.delete")
     (string-command 73 "add-cflag")
     (string-command 74 "add-lib")
     (string-command 75 "add-pkg")])

  (defn specs []
    (let-do [result (base-specs)]
      (for [arity 0 10]
        (set! result (Array.push-back result (function-copy-spec arity))))
      (for [arity 0 10]
        (set! result (Array.push-back result (function-delete-spec arity))))
      (for [arity 0 10]
        (set! result
              (Array.push-back result
                               (function-str-spec (Int.+ 100 arity) arity "str"))))
      (for [arity 0 10]
        (set! result
              (Array.push-back result
                               (function-str-spec (Int.+ 110 arity) arity "prn"))))
      result))

  (defn validate-specs [entries]
    (let-do [result (the (Result Unit PrimitiveRegistryError)
                         (Result.Success ()))
             n (Array.length entries)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success _)
            (let-do [left (Array.unsafe-nth entries i)
                     left-reference (PrimitiveSpec.reference left)]
              (when (Int.< @(CoreRef.id left-reference) 0)
                (set! result
                      (Result.Error
                        (PrimitiveRegistryError.init @"primitive IDs must be non-negative"))))
              (for [j (Int.inc i) n]
                (match-ref &result
                  (Result.Success _)
                    (let [right (Array.unsafe-nth entries j)
                          right-reference (PrimitiveSpec.reference right)]
                      (if (Int.= @(CoreRef.id left-reference)
                                 @(CoreRef.id right-reference))
                        (set! result
                              (Result.Error
                                (PrimitiveRegistryError.init @"duplicate primitive ID")))
                        (when (= (CoreRef.name left-reference)
                                 (CoreRef.name right-reference))
                          (set! result
                                (Result.Error
                                  (PrimitiveRegistryError.init @"duplicate primitive name"))))))
                  (Result.Error _) ())))
          (Result.Error _) ()))
      result))

  (defn validate [] (let [entries (specs)] (validate-specs &entries)))

  (defn globals []
    (let-do [result (the (Array CoreRef) [])
             entries (specs)
             n (Array.length &entries)]
      (for [i 0 n]
        (set! result
              (Array.push-back result
                               @(PrimitiveSpec.reference (Array.unsafe-nth &entries
                                                                           i)))))
      result))

  (doc template-c-for
    "the compiler-provided C source template (declaration, body) for a built-in
whose lowering is a monomorphic-per-element source template, keyed by the
qualified builtin name. Mirrors the reference compiler's ArrayTemplates: the
same `$NAME`/`$a`/`$DECL` substitution the deftemplate path uses. Returns Nothing
for builtins whose lowering is intrinsic or parameterized.")
  (defn template-c-for [name]
    (cond
      (= name "Array.push-back")
      (Maybe.Just
        (Pair.init @"Array $NAME(Array a, $a value)"
                   @"$DECL { a.len++; if(a.len > a.capacity){ a.capacity = a.len * 2; a.data = CARP_REALLOC(a.data, sizeof($a) * a.capacity); } (($a*)a.data)[a.len - 1] = value; return a; }"))
      (= name "Array.push-back!")
      (Maybe.Just
        (Pair.init @"void $NAME(Array *aRef, $a value)"
                   @"$DECL { aRef->len++; if(aRef->len > aRef->capacity){ aRef->capacity = aRef->len * 2; aRef->data = CARP_REALLOC(aRef->data, sizeof($a) * aRef->capacity); } (($a*)aRef->data)[aRef->len - 1] = value; }"))
      (= name "Array.pop-back")
      (Maybe.Just
        (Pair.init @"Array $NAME(Array a)" @"$DECL { a.len--; return a; }"))
      (= name "Array.pop-back!")
      (Maybe.Just
        (Pair.init @"$a $NAME(Array *aRef)"
                   @"$DECL { $a ret = (($a*)aRef->data)[aRef->len - 1]; aRef->len--; return ret; }"))
      (= name "Array.aset")
      (Maybe.Just
        (Pair.init @"Array $NAME(Array a, int n, $a value)"
                   @"$DECL { (($a*)a.data)[n] = value; return a; }"))
      (= name "Array.aset!")
      (Maybe.Just
        (Pair.init
          @"void $NAME(Array *aRef, int n, $a value)"
          @"$DECL { (($a*)aRef->data)[n] = value; }"))
      (= name "Array.endo-map")
      (Maybe.Just
        (Pair.init @"Array $NAME(Lambda *f, Array a)"
                   @"$DECL { for(int i = 0; i < a.len; ++i){ (($a*)a.data)[i] = ((*f).env ? (($a (*)(void*, $a))(*f).callback)((*f).env, (($a*)a.data)[i]) : (($a (*)($a))(*f).callback)((($a*)a.data)[i])); } return a; }"))
      (= name "Array.endo-filter")
      (Maybe.Just
        (Pair.init
          @"Array $NAME(Lambda *predicate, Array a)"
          @"$DECL { int insertIndex = 0; for(int i = 0; i < a.len; ++i){ if((*predicate).env ? ((bool (*)(void*, $a*))(*predicate).callback)((*predicate).env, &((($a*)a.data)[i])) : ((bool (*)($a*))(*predicate).callback)(&((($a*)a.data)[i]))){ (($a*)a.data)[insertIndex++] = (($a*)a.data)[i]; } } a.len = insertIndex; return a; }"))
      ;; the interface-level generics share the array templates: a call site
      ;; that dispatches to the bare name must still link.
      (= name "aset")
      (Maybe.Just
        (Pair.init @"Array $NAME(Array a, int n, $a value)"
                   @"$DECL { (($a*)a.data)[n] = value; return a; }"))
      (= name "aset!")
      (Maybe.Just
        (Pair.init
          @"void $NAME(Array *aRef, int n, $a value)"
          @"$DECL { (($a*)aRef->data)[n] = value; }"))
      (= name "endo-map")
      (Maybe.Just
        (Pair.init @"Array $NAME(Lambda *f, Array a)"
                   @"$DECL { for(int i = 0; i < a.len; ++i){ (($a*)a.data)[i] = ((*f).env ? (($a (*)(void*, $a))(*f).callback)((*f).env, (($a*)a.data)[i]) : (($a (*)($a))(*f).callback)((($a*)a.data)[i])); } return a; }"))
      (= name "endo-filter")
      (Maybe.Just
        (Pair.init
          @"Array $NAME(Lambda *predicate, Array a)"
          @"$DECL { int insertIndex = 0; for(int i = 0; i < a.len; ++i){ if((*predicate).env ? ((bool (*)(void*, $a*))(*predicate).callback)((*predicate).env, &((($a*)a.data)[i])) : ((bool (*)($a*))(*predicate).callback)(&((($a*)a.data)[i]))){ (($a*)a.data)[insertIndex++] = (($a*)a.data)[i]; } } a.len = insertIndex; return a; }"))
      (= name "Box.init")
      (Maybe.Just
        (Pair.init @"$a* $NAME($a value)"
                   @"$DECL { $a* box = CARP_MALLOC(sizeof($a)); *box = value; return box; }"))
      (= name "Box.peek")
      (Maybe.Just (Pair.init @"$a* $NAME($a** box)" @"$DECL { return *box; }"))
      (= name "Box.unbox")
      (Maybe.Just
        (Pair.init @"$a $NAME($a* box)"
                   @"$DECL { $a value = *box; CARP_FREE(box); return value; }"))
      (the (Maybe (Pair String String)) (Maybe.Nothing))))

  (doc template-sources
    "compiler-provided CoreBuiltinSource entries (source-template payloads) for the
array built-ins whose C is a per-element template. They reuse the registered
spec's reference and signature, so ids stay reserved and gap-free; the backend
prefers this source payload over the spec's intrinsic lowering.")
  (defn template-sources []
    (let-do [result (the (Array CoreBuiltinSource) [])
             entries (specs)
             n (Array.length &entries)]
      (for [i 0 n]
        (let [spec (Array.unsafe-nth &entries i)]
          (match (template-c-for (CoreRef.name (PrimitiveSpec.reference spec)))
            (Maybe.Just dc)
              (Array.push-back! &result
                                (CoreBuiltinSource.init @(PrimitiveSpec.reference spec)
                                                        (Box.init
                                                          @(Box.peek (PrimitiveSpec.signature spec)))
                                                        (CoreBuiltinPayload.Template @(Pair.a &dc)
                                                                                     @(Pair.b &dc))))
            (Maybe.Nothing) ())))
      result))

  (defn interfaces []
    (let-do [result (the (Array CoreInterface) [])
             entries (specs)
             n (Array.length &entries)]
      (for [i 0 n]
        (let [entry (Array.unsafe-nth &entries i)]
          (match-ref (PrimitiveSpec.phase entry)
            (PrimitivePhase.Interface)
              (set! result
                    (Array.push-back result
                                     (CoreInterface.init @(PrimitiveSpec.reference entry)
                                                         @(PrimitiveSpec.signature entry))))
            (PrimitivePhase.Runtime) ())))
      result))

  (defn builtins []
    (let-do [result (the (Array CoreBuiltin) [])
             entries (specs)
             n (Array.length &entries)]
      (for [i 0 n]
        (let [entry (Array.unsafe-nth &entries i)]
          (match-ref (PrimitiveSpec.phase entry)
            (PrimitivePhase.Interface) ()
            (PrimitivePhase.Runtime)
              (set! result
                    (Array.push-back result
                                     (CoreBuiltin.init @(PrimitiveSpec.reference entry)
                                                       @(PrimitiveSpec.signature entry)))))))
      result))

  (defn implementations []
    (let-do [result [(CoreImplementation.init (reference 0 "copy")
                                              (reference 52 "Array.copy"))
                     (CoreImplementation.init (reference 0 "copy")
                                              (reference 53 "Box.copy"))
                     (CoreImplementation.init (reference 0 "copy")
                                              (reference 54 "Pointer.copy"))
                     (CoreImplementation.init (reference 1 "str")
                                              (reference 41 "Array.str"))
                     (CoreImplementation.init (reference 1 "str")
                                              (reference 71 "StaticArray.str"))
                     (CoreImplementation.init (reference 1 "str")
                                              (reference 69 "Box.str"))
                     ;; container str doubles as prn (the reference registers
                     ;; StaticArray.str/Box.prn/Array under the prn interface),
                     ;; so nested containers resolve as struct members.
                     (CoreImplementation.init (reference 2 "prn")
                                              (reference 41 "Array.str"))
                     (CoreImplementation.init (reference 2 "prn")
                                              (reference 71 "StaticArray.str"))
                     (CoreImplementation.init (reference 2 "prn")
                                              (reference 69 "Box.str"))
                     (CoreImplementation.init (reference 3 "delete")
                                              (reference 72 "Array.delete"))
                     (CoreImplementation.init (reference 3 "delete")
                                              (reference 76 "Box.delete"))]]
      (for [arity 0 10]
        (set! result
              (Array.push-back result
                               (CoreImplementation.init (reference 0 "copy")
                                                        (reference (Int.+ 55
                                                                          arity)
                                                                   &(String.concat
                                                                     &[@"Function.Arity"
                                                                       (Int.str arity)
                                                                       @".copy"]))))))
      (for [arity 0 10]
        (set! result
              (Array.push-back result
                               (CoreImplementation.init (reference 3 "delete")
                                                        (reference (Int.+ 120
                                                                          arity)
                                                                   &(String.concat
                                                                     &[@"Function.Arity"
                                                                       (Int.str arity)
                                                                       @".delete"]))))))
      (for [arity 0 10]
        (set! result
              (Array.push-back result
                               (CoreImplementation.init (reference 1 "str")
                                                        (reference (Int.+ 100
                                                                          arity)
                                                                   &(String.concat
                                                                     &[@"Function.Arity"
                                                                       (Int.str arity)
                                                                       @".str"]))))))
      (for [arity 0 10]
        (set! result
              (Array.push-back result
                               (CoreImplementation.init (reference 2 "prn")
                                                        (reference (Int.+ 110
                                                                          arity)
                                                                   &(String.concat
                                                                     &[@"Function.Arity"
                                                                       (Int.str arity)
                                                                       @".prn"]))))))
      result))

  (defn lowering-for [reference]
    (let-do [result (the (Maybe PrimitiveLowering) (Maybe.Nothing))
             entries (specs)
             n (Array.length &entries)]
      (for [i 0 n]
        (let [entry (Array.unsafe-nth &entries i)]
          (when (CoreIR.same-ref? (PrimitiveSpec.reference entry) reference)
            (set! result (Maybe.Just @(PrimitiveSpec.lowering entry))))))
      result)))
