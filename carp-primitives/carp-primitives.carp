(load "../carp-ir/carp-ir.carp")

(doc PrimitivePhase "is whether a primitive is an interface or a builtin.
`Interface` marks an interface such as `copy` or `delete`. `Runtime` marks a
builtin function.")
(deftype PrimitivePhase
  (Interface [])
  (Runtime []))

(doc PrimitiveIntComparison "is the comparison an `IntComparison` template
performs: `LessEqual`, `GreaterEqual` or `NotEqual`.")
(deftype PrimitiveIntComparison
  (LessEqual [])
  (GreaterEqual [])
  (NotEqual []))

(doc PrimitiveTemplate "is a C template a builtin is rendered from, once per
instance. `ArrayCopy`, `ArrayStr` and `PairCopy` call the given interface on
each element. `ArrayDelete`, `ArraySet`, `ArrayFilter` and `ArrayPopBack` call
the given `delete` on the elements they drop or overwrite. `PointerCopy` copies
a pointer. `FunctionCopy` and `FunctionDelete` copy and delete a closure of the
given arity. `FunctionStr` renders a function. `IntComparison` compares
integers. `CollectionLength` returns the length of a collection.")
(deftype PrimitiveTemplate
  (ArrayCopy [CoreRef])
  (ArrayStr [CoreRef])
  (ArrayDelete [CoreRef])
  (ArraySet [CoreRef])
  (ArrayFilter [CoreRef])
  (ArrayPopBack [CoreRef])
  (PairCopy [CoreRef])
  (PointerCopy [])
  (FunctionCopy [Int])
  (FunctionDelete [Int])
  (FunctionStr [])
  (IntComparison [PrimitiveIntComparison])
  (CollectionLength []))

(doc PrimitiveLowering "is how a builtin is compiled. The backend compiles an
`Intrinsic` builtin itself. A `ParameterizedTemplate` builtin is rendered from
its template.")
(deftype PrimitiveLowering
  (Intrinsic [])
  (ParameterizedTemplate [PrimitiveTemplate]))

(doc PrimitiveSpec "describes a primitive. `reference` is its identity.
`signature` is its type. `phase` says whether it is an interface or a builtin.
`lowering` says how it is compiled. `memory` records its effects on memory.")
(deftype PrimitiveSpec
  [reference CoreRef
   signature (Box CoreType)
   phase PrimitivePhase
   lowering PrimitiveLowering
   memory CoreMemoryManifest])

(doc PrimitiveRegistryError "is an error in the primitive table, such as a
duplicate id. `message` describes it.")
(deftype PrimitiveRegistryError [message String])

(defmodule PrimitiveRegistry
  (doc reference "returns a global reference with the id `id` and the name
`name`.")
  (defn reference [id name] (CoreRef.init id (String.copy name) true))

  (doc delete-reference "returns the identity of the builtin `delete`
interface. Ownership analysis finds delete implementations by it.")
  (defn delete-reference [] (reference 3 "delete"))

  (doc ref-reference "returns the identity of the builtin `ref` primitive.
Ownership analysis finds borrows by it.")
  (defn ref-reference [] (reference 5 "ref"))

  (doc str-reference "returns the identity of the builtin `str` interface.")
  (defn str-reference [] (reference 1 "str"))

  (doc variable "returns the type variable `name`.")
  (defn variable [name] (CoreType.Variable (String.copy name)))

  (doc named-one "returns the named type `name` applied to one argument.")
  (defn named-one [name parameter]
    (CoreType.Named (String.copy name) [(Box.init parameter)]))

  (doc named-two "returns the named type `name` applied to two arguments.")
  (defn named-two [name first second]
    (CoreType.Named (String.copy name) [(Box.init first) (Box.init second)]))

  (doc reference-type "returns a reference to the type `inner`, with a lifetime
to infer.")
  (defn reference-type [inner]
    (CoreType.Reference (Box.init inner) (CoreLifetime.Inferred 0)))

  (doc function "returns the function type from `arguments` to `result`.")
  (defn function [arguments result]
    (CoreType.Function arguments (Box.init result)))

  (doc no-memory "returns a memory manifest with no effects.")
  (defn no-memory [] (CoreMemoryManifest.init [] []))

  (doc unknown-memory "returns a memory manifest with an unknown effect.")
  (defn unknown-memory []
    (CoreMemoryManifest.init [(CoreMemoryEffect.Unknown)] []))

  (doc allocating "returns a memory manifest that allocates memory of the size
`extent`.")
  (defn allocating [extent]
    (CoreMemoryManifest.init [(CoreMemoryEffect.Allocate extent)] []))

  (doc resizing "returns a memory manifest that resizes the argument at index
`argument` to the size `extent`. If `may-move` is true, the memory of the
argument may move.")
  (defn resizing [argument extent may-move]
    (CoreMemoryManifest.init
      [(CoreMemoryEffect.Resize argument extent may-move)]
      (if may-move [argument] [])))

  (doc freeing "returns a memory manifest that frees the argument at index
`argument`.")
  (defn freeing [argument]
    (CoreMemoryManifest.init [(CoreMemoryEffect.Free argument)] []))

  (doc calling-elements "returns a memory manifest with `effect` and an unknown
effect, for a template that also calls the `copy`, `prn` or `delete` of the
elements.")
  (defn calling-elements [effect]
    (CoreMemoryManifest.init [effect (CoreMemoryEffect.Unknown)] []))

  (doc interface-spec "returns the spec of the interface `name` with the id `id`
and the type `signature`.")
  (defn interface-spec [id name signature]
    (PrimitiveSpec.init (reference id name)
                        (Box.init signature)
                        (PrimitivePhase.Interface)
                        (PrimitiveLowering.Intrinsic)
                        (unknown-memory)))

  (doc builtin-spec "returns the spec of an intrinsic builtin with unknown
memory effects.")
  (defn builtin-spec [id name signature]
    (PrimitiveSpec.init (reference id name)
                        (Box.init signature)
                        (PrimitivePhase.Runtime)
                        (PrimitiveLowering.Intrinsic)
                        (unknown-memory)))

  (doc builtin-memory-spec "returns the spec of an intrinsic builtin with the
memory manifest `memory`.")
  (defn builtin-memory-spec [id name signature memory]
    (PrimitiveSpec.init (reference id name)
                        (Box.init signature)
                        (PrimitivePhase.Runtime)
                        (PrimitiveLowering.Intrinsic)
                        memory))

  (doc effect-free-spec "returns the spec of an intrinsic builtin with no memory
effects.")
  (defn effect-free-spec [id name signature]
    (builtin-memory-spec id name signature (no-memory)))

  (doc template-spec "returns the spec of a builtin rendered from `template`,
with unknown memory effects.")
  (defn template-spec [id name signature template]
    (PrimitiveSpec.init (reference id name)
                        (Box.init signature)
                        (PrimitivePhase.Runtime)
                        (PrimitiveLowering.ParameterizedTemplate template)
                        (unknown-memory)))

  (doc template-memory-spec "returns the spec of a builtin rendered from
`template`, with the memory manifest `memory`.")
  (defn template-memory-spec [id name signature template memory]
    (PrimitiveSpec.init (reference id name)
                        (Box.init signature)
                        (PrimitivePhase.Runtime)
                        (PrimitiveLowering.ParameterizedTemplate template)
                        memory))

  ; signatures for the array builtins. the element variable is spelled `a`, so
  ; the `$a` in a template from `template-c-for` binds to it.
  (doc array-of-a "returns the type `(Array a)`.")
  (defn array-of-a [] (named-one "Array" (variable "a")))
  (doc ref-array-of-a "returns the type `(Ref (Array a))`.")
  (defn ref-array-of-a [] (reference-type (named-one "Array" (variable "a"))))
  (doc ptr-of-a "returns the type `(Ptr a)`.")
  (defn ptr-of-a [] (named-one "Ptr" (variable "a")))

  (doc array-raw "returns the spec of a builtin that returns a pointer to the
elements of an array behind a reference.")
  (defn array-raw [id name]
    (effect-free-spec id
                      name
                      (function [(Box.init (ref-array-of-a))] (ptr-of-a))))

  (doc array-raw-value "returns the spec of a builtin that returns a pointer to
the elements of an array.")
  (defn array-raw-value [id name]
    (effect-free-spec id name (function [(Box.init (array-of-a))] (ptr-of-a))))

  (doc tpl-push-back "returns the spec of a builtin that appends a value to an
array and returns the array.")
  (defn tpl-push-back [id name]
    (builtin-memory-spec id
                         name
                         (function
                           [(Box.init (array-of-a)) (Box.init (variable "a"))]
                           (array-of-a))
                         (resizing 0 (CoreMemoryExtent.Unknown) true)))
  (doc tpl-push-back-mut "returns the spec of a builtin that appends a value to
an array in place.")
  (defn tpl-push-back-mut [id name]
    (builtin-memory-spec id
                         name
                         (function
                           [(Box.init (ref-array-of-a))
                            (Box.init (variable "a"))]
                           (CoreType.Unit))
                         (resizing 0 (CoreMemoryExtent.Unknown) true)))
  (doc tpl-pop-back "returns the spec of a builtin that removes the last element
of an array and returns the array. The removed element is deleted.")
  (defn tpl-pop-back [id name]
    (template-spec id
                   name
                   (function [(Box.init (array-of-a))] (array-of-a))
                   (PrimitiveTemplate.ArrayPopBack (reference 3 "delete"))))
  (doc tpl-aset "returns the spec of a builtin that sets an element of an array
and returns the array. The old element is deleted.")
  (defn tpl-aset [id name]
    (template-spec id
                   name
                   (function
                     [(Box.init (array-of-a))
                      (Box.init (CoreType.Integer))
                      (Box.init (variable "a"))]
                     (array-of-a))
                   (PrimitiveTemplate.ArraySet (reference 3 "delete"))))
  (doc tpl-aset-mut "returns the spec of a builtin that sets an element of an
array in place. The old element is deleted.")
  (defn tpl-aset-mut [id name]
    (template-spec id
                   name
                   (function
                     [(Box.init (ref-array-of-a))
                      (Box.init (CoreType.Integer))
                      (Box.init (variable "a"))]
                     (CoreType.Unit))
                   (PrimitiveTemplate.ArraySet (reference 3 "delete"))))
  (doc tpl-endo-map "returns the spec of a builtin that applies a function to
every element of an array in place and returns the array.")
  (defn tpl-endo-map [id name]
    (builtin-memory-spec id
                         name
                         (function
                           [(Box.init
                              (reference-type
                                (function [(Box.init (variable "a"))]
                                          (variable "a"))))
                            (Box.init (array-of-a))]
                           (array-of-a))
                         ;; The intrinsic calls a user-supplied function whose transitive effect
                         ;; is not represented by its own direct C lowering.
                         (unknown-memory)))
  (doc tpl-endo-filter "returns the spec of a builtin that keeps the elements of
an array that satisfy a predicate and returns the array. The removed elements
are deleted.")
  (defn tpl-endo-filter [id name]
    (template-spec id
                   name
                   (function
                     [(Box.init
                        (reference-type
                          (function
                            [(Box.init (reference-type (variable "a")))]
                            (CoreType.Boolean))))
                      (Box.init (array-of-a))]
                     (array-of-a))
                   (PrimitiveTemplate.ArrayFilter (reference 3 "delete"))))
  (doc collection-str "returns the spec of the `str` builtin of the collection
type `collection-name`, rendered from `template`.")
  (defn collection-str [id name collection-name template]
    (template-memory-spec id
                          name
                          (function
                            [(Box.init
                               (reference-type
                                 (named-one collection-name (variable "a"))))]
                            (CoreType.String))
                          template
                          (calling-elements
                            (CoreMemoryEffect.Allocate (CoreMemoryExtent.Unknown)))))

  (doc copy-interface "returns the spec of the `copy` interface.")
  (defn copy-interface []
    (interface-spec 0
                    "copy"
                    (function
                      [(Box.init (reference-type (variable "a")))]
                      (variable "a"))))

  (doc string-interface "returns the spec of an interface that renders a value
as a string, such as `str` or `prn`.")
  (defn string-interface [id name]
    (interface-spec id
                    name
                    (function [(Box.init (variable "a"))] (CoreType.String))))

  (doc delete-interface "returns the spec of the `delete` interface.")
  (defn delete-interface []
    (interface-spec 3
                    "delete"
                    (function [(Box.init (variable "a"))] (CoreType.Unit))))

  (doc unary "returns the spec of a builtin that takes a value of any type and
returns `result`.")
  (defn unary [id name result]
    (builtin-spec id name (function [(Box.init (variable "a"))] result)))

  (doc ref-builtin "returns the spec of `ref`, which borrows a value.")
  (defn ref-builtin []
    (effect-free-spec 5
                      "ref"
                      (function [(Box.init (variable "a"))]
                                (reference-type (variable "a")))))

  (doc deref-builtin "returns the spec of `deref`, which reads the value behind
a reference.")
  (defn deref-builtin []
    (effect-free-spec 6
                      "deref"
                      (function
                        [(Box.init (reference-type (variable "a")))]
                        (variable "a"))))

  (doc null-builtin "returns the spec of `NULL`, the null pointer.")
  (defn null-builtin []
    (effect-free-spec 7 "NULL" (named-one "Ptr" (variable "a"))))

  (doc length-builtin "returns the spec of a `length` builtin that takes a value
of any type. It has a body for when it is used as a value. Calls to it are
inlined.")
  (defn length-builtin [id name]
    (template-memory-spec id
                          name
                          (function [(Box.init (variable "a"))]
                                    (CoreType.Integer))
                          (PrimitiveTemplate.CollectionLength)
                          (no-memory)))

  (doc collection-length-builtin "returns the spec of the `length` builtin of
the collection type `collection-name`, which takes a reference to the
collection.")
  (defn collection-length-builtin [id name collection-name]
    (template-memory-spec id
                          name
                          (function
                            [(Box.init
                               (reference-type
                                 (named-one collection-name (variable "a"))))]
                            (CoreType.Integer))
                          (PrimitiveTemplate.CollectionLength)
                          (no-memory)))

  (doc get-tag-builtin "returns the spec of `get-tag`, which returns the
constructor tag of a value behind a reference.")
  (defn get-tag-builtin []
    (effect-free-spec 48
                      "get-tag"
                      (function
                        [(Box.init (reference-type (variable "a")))]
                        (CoreType.Integer))))

  (doc field-set-builtin "returns the spec of `field-set!`, which writes a field
of a value behind a reference. Its arguments are the reference, the constructor
tag, the index of the field and the new value. The old value of the field is
deleted. The `set-<field>!` functions that derive generates call it.")
  (defn field-set-builtin []
    (builtin-spec 49
                  "field-set!"
                  (function
                    [(Box.init (reference-type (variable "a")))
                     (Box.init (CoreType.Integer))
                     (Box.init (CoreType.Integer))
                     (Box.init (variable "b"))]
                    (CoreType.Unit))))

  (doc generic-index "returns the spec of a builtin that returns a reference to
an element of an array.")
  (defn generic-index [id name]
    (effect-free-spec id
                      name
                      (function
                        [(Box.init (ref-array-of-a))
                         (Box.init (CoreType.Integer))]
                        (reference-type (variable "a")))))

  (doc indexed "returns the spec of a builtin that returns a reference to an
element of the collection type `collection-name`.")
  (defn indexed [id name collection-name]
    (effect-free-spec id
                      name
                      (function
                        [(Box.init
                           (reference-type
                             (named-one collection-name (variable "element"))))
                         (Box.init (CoreType.Integer))]
                        (reference-type (variable "element")))))

  (doc allocate "returns the spec of a builtin that allocates an array with room
for a number of elements.")
  (defn allocate [id name]
    (builtin-memory-spec id
                         name
                         (function [(Box.init (CoreType.Integer))]
                                   (named-one "Array" (variable "a")))
                         (allocating (CoreMemoryExtent.ArgumentElements 0))))

  (doc generic-set "returns the spec of a builtin that sets an element of an
array in place.")
  (defn generic-set [id name]
    (effect-free-spec id
                      name
                      (function
                        [(Box.init (ref-array-of-a))
                         (Box.init (CoreType.Integer))
                         (Box.init (variable "a"))]
                        (CoreType.Unit))))

  (doc indexed-set "returns the spec of a builtin that sets an element of the
collection type `collection-name` in place.")
  (defn indexed-set [id name collection-name]
    (effect-free-spec id
                      name
                      (function
                        [(Box.init
                           (reference-type
                             (named-one collection-name (variable "element"))))
                         (Box.init (CoreType.Integer))
                         (Box.init (variable "element"))]
                        (CoreType.Unit))))

  (doc indexed-set-value "returns the spec of a builtin that sets an element of
the collection type `collection-name` and returns the collection.")
  (defn indexed-set-value [id name collection-name]
    (builtin-spec id
                  name
                  (function
                    [(Box.init (named-one collection-name (variable "element")))
                     (Box.init (CoreType.Integer))
                     (Box.init (variable "element"))]
                    (named-one collection-name (variable "element")))))

  (doc generic-push-mut "returns the spec of a builtin that appends a value to
an array in place.")
  (defn generic-push-mut [id name]
    (builtin-memory-spec id
                         name
                         (function
                           [(Box.init (ref-array-of-a))
                            (Box.init (variable "a"))]
                           (CoreType.Unit))
                         (resizing 0 (CoreMemoryExtent.Unknown) true)))

  (doc array-pop-mut "returns the spec of a builtin that removes the last
element of an array in place and returns it.")
  (defn array-pop-mut [id name]
    (builtin-spec id
                  name
                  (function
                    [(Box.init
                       (reference-type (named-one "Array" (variable "a"))))]
                    (variable "a"))))

  (doc array-delete "returns the spec of a builtin that deletes an array and its
elements.")
  (defn array-delete [id name]
    (template-memory-spec id
                          name
                          (function [(Box.init (array-of-a))] (CoreType.Unit))
                          (PrimitiveTemplate.ArrayDelete (reference 3 "delete"))
                          (calling-elements (CoreMemoryEffect.Free 0))))

  (doc static-array-delete "returns the spec of a builtin that deletes the
elements of a static array. It does not free the storage, which the static array
does not own.")
  (defn static-array-delete [id name]
    (template-memory-spec id
                          name
                          (function
                            [(Box.init (named-one "StaticArray" (variable "a")))]
                            (CoreType.Unit))
                          (PrimitiveTemplate.ArrayDelete (reference 3 "delete"))
                          ; frees no memory itself. the effects of the
                          ; element deletes it calls are unknown.
                          (unknown-memory)))

  (doc string-command "returns the spec of a build command that takes a string,
such as `add-cflag`.")
  (defn string-command [id name]
    (effect-free-spec id
                      name
                      (function
                        [(Box.init (reference-type (CoreType.String)))]
                        (CoreType.Unit))))

  (doc pair-init
    "returns the spec of a builtin that makes a pair of two values.")
  (defn pair-init [id name]
    (builtin-spec id
                  name
                  (function
                    [(Box.init (variable "a")) (Box.init (variable "b"))]
                    (CoreType.Named (String.copy "Pair")
                                    [(Box.init (variable "a"))
                                     (Box.init (variable "b"))]))))

  (doc pair-init-from-refs "returns the spec of a builtin that makes a pair from
two references.")
  (defn pair-init-from-refs [id name]
    (builtin-spec id
                  name
                  (function
                    [(Box.init (reference-type (variable "a")))
                     (Box.init (reference-type (variable "b")))]
                    (CoreType.Named (String.copy "Pair")
                                    [(Box.init (variable "a"))
                                     (Box.init (variable "b"))]))))

  (doc unary-polymorphic "returns the spec of a builtin that takes one value and
returns a value of another type.")
  (defn unary-polymorphic [id name]
    (builtin-spec id
                  name
                  (function [(Box.init (variable "input"))] (variable "output"))))

  (doc pair-set-b "returns the spec of `Pair.set-b`, which sets the second value
of a pair and returns the pair.")
  (defn pair-set-b []
    (builtin-spec 34
                  "Pair.set-b"
                  (function
                    [(Box.init (variable "pair")) (Box.init (variable "b"))]
                    (variable "pair"))))

  (doc ignore-builtin "returns the spec of `ignore`, which discards a value.")
  (defn ignore-builtin [] (unary 42 "ignore" (CoreType.Unit)))

  (doc int-comparison "returns the spec of a builtin that compares two integers
with `comparison`.")
  (defn int-comparison [id name comparison]
    (template-memory-spec id
                          name
                          (function
                            [(Box.init (CoreType.Integer))
                             (Box.init (CoreType.Integer))]
                            (CoreType.Boolean))
                          (PrimitiveTemplate.IntComparison comparison)
                          (no-memory)))

  (doc parameterized-copy "returns the spec of the `copy` builtin of the
container type `container-name`, rendered from `template`.")
  (defn parameterized-copy [id name container-name template]
    (template-memory-spec id
                          name
                          (function
                            [(Box.init
                               (reference-type
                                 (named-one container-name (variable "a"))))]
                            (named-one container-name (variable "a")))
                          template
                          (if (String.= container-name "Array")
                            (calling-elements
                              (CoreMemoryEffect.Allocate (CoreMemoryExtent.Unknown)))
                            (no-memory))))

  (doc pair-copy "returns the spec of `Pair.copy`, rendered from `template`.")
  (defn pair-copy [id name template]
    (let [pair-type (named-two "Pair" (variable "a") (variable "b"))]
      (template-spec id
                     name
                     (function
                       [(Box.init (reference-type (CoreType.copy &pair-type)))]
                       pair-type)
                     template)))

  (doc function-type "returns the type of a function with `arity` arguments,
with a type variable for each argument and for the result.")
  (defn function-type [arity]
    (let-do [arguments (the (Array (Box CoreType)) [])]
      (for [i 0 arity]
        (set! arguments
              (Array.push-back arguments
                               (Box.init
                                 (variable
                                   &(String.concat &[@"argument" (Int.str i)]))))))
      (function arguments (variable "result"))))

  (doc function-copy-spec "returns the spec of the `copy` builtin for functions
of `arity` arguments.")
  (defn function-copy-spec [arity]
    (let [name (String.concat &[@"Function.Arity" (Int.str arity) @".copy"])]
      (template-memory-spec (Int.+ 55 arity)
                            &name
                            (function
                              [(Box.init (reference-type (function-type arity)))]
                              (function-type arity))
                            (PrimitiveTemplate.FunctionCopy arity)
                            (allocating (CoreMemoryExtent.Unknown)))))

  (doc function-delete-spec "returns the spec of the `delete` builtin for
functions of `arity` arguments.")
  (defn function-delete-spec [arity]
    (let [name (String.concat &[@"Function.Arity" (Int.str arity) @".delete"])]
      (template-memory-spec (Int.+ 120 arity)
                            &name
                            (function [(Box.init (function-type arity))]
                                      (CoreType.Unit))
                            (PrimitiveTemplate.FunctionDelete arity)
                            (freeing 0))))

  (doc function-str-spec "returns the spec of the `str` or `prn` builtin, named
by `name-suffix`, for functions of `arity` arguments. It renders \"λ\", as in
the reference compiler.")
  (defn function-str-spec [id arity name-suffix]
    (let [name (String.concat
            &[@"Function.Arity" (Int.str arity) @"." @name-suffix])]
      (template-memory-spec id
                            &name
                            (function
                              [(Box.init (reference-type (function-type arity)))]
                              (CoreType.String))
                            (PrimitiveTemplate.FunctionStr)
                            (allocating (CoreMemoryExtent.Unknown)))))

  (doc base-specs "returns the specs of the primitives, without the function
builtins.")
  (defn base-specs []
    [(copy-interface)
     (string-interface 1 "str")
     (string-interface 2 "prn")
     (delete-interface)
     (ref-builtin)
     (deref-builtin)
     (null-builtin)
     (length-builtin 8 "length")
     (collection-length-builtin 9 "Array.length" "Array")
     (collection-length-builtin 10 "StaticArray.length" "StaticArray")
     (get-tag-builtin)
     (field-set-builtin)
     (generic-index 11 "unsafe-nth")
     (indexed 12 "Array.unsafe-nth" "Array")
     (indexed 13 "StaticArray.unsafe-nth" "StaticArray")
     (allocate 14 "allocate")
     (allocate 15 "Array.allocate")
     (generic-set 16 "aset-uninitialized!")
     (indexed-set 17 "Array.aset-uninitialized!" "Array")
     (indexed-set 18 "StaticArray.aset-uninitialized!" "StaticArray")
     (indexed-set 21 "StaticArray.aset!" "StaticArray")
     (tpl-aset-mut 19 "aset!")
     (tpl-aset-mut 20 "Array.aset!")
     (indexed-set-value 30 "StaticArray.aset" "StaticArray")
     (tpl-aset 29 "Array.aset")
     (tpl-push-back 23 "Array.push-back")
     (generic-push-mut 24 "push-back!")
     (tpl-push-back-mut 25 "Array.push-back!")
     (tpl-pop-back 27 "Array.pop-back")
     (tpl-aset 28 "aset")
     ; the bare names carry the array signatures, so the `$a` in their
     ; templates binds
     (tpl-endo-filter 36 "endo-filter")
     (tpl-endo-filter 37 "Array.endo-filter")
     (tpl-endo-map 39 "endo-map")
     (tpl-endo-map 40 "Array.endo-map")
     ; elements render through `prn`, so strings show as literals, as in the
     ; reference compiler
     (collection-str 41
                     "Array.str"
                     "Array"
                     (PrimitiveTemplate.ArrayStr (reference 2 "prn")))
     (collection-str 71
                     "StaticArray.str"
                     "StaticArray"
                     (PrimitiveTemplate.ArrayStr (reference 2 "prn")))
     (array-pop-mut 50 "pop-back!")
     (array-pop-mut 51 "Array.pop-back!")
     (pair-init-from-refs 31 "Pair.init-from-refs")
     (unary-polymorphic 32 "Pair.a")
     (unary-polymorphic 33 "Pair.b")
     (pair-set-b)
     (unary-polymorphic 35 "Pair.reverse")
     (pair-init 38 "Pair.init")
     (ignore-builtin)
     (int-comparison 45 "Int.<=" (PrimitiveIntComparison.LessEqual))
     (int-comparison 46 "Int.>=" (PrimitiveIntComparison.GreaterEqual))
     (int-comparison 47 "Int./=" (PrimitiveIntComparison.NotEqual))
     (parameterized-copy 52
                         "Array.copy"
                         "Array"
                         (PrimitiveTemplate.ArrayCopy (reference 0 "copy")))
     (parameterized-copy 54 "Pointer.copy" "Ptr" (PrimitiveTemplate.PointerCopy))
     (array-raw 65 "unsafe-raw")
     (array-raw-value 70 "Array.raw")
     (pair-copy 66 "Pair.copy" (PrimitiveTemplate.PairCopy (reference 0 "copy")))
     (array-delete 72 "Array.delete")
     (string-command 73 "add-cflag")
     (string-command 74 "add-lib")
     (string-command 75 "add-pkg")
     (static-array-delete 76 "StaticArray.delete")])

  (doc specs "returns the specs of all primitives, including the `copy`,
`delete`, `str` and `prn` builtins for functions of up to ten arguments.")
  (defn specs []
    (let-do [result (base-specs)]
      (for [arity 0 10]
        (set! result (Array.push-back result (function-copy-spec arity))))
      (for [arity 0 10]
        (set! result (Array.push-back result (function-delete-spec arity))))
      (for [arity 0 10]
        (set! result
              (Array.push-back result
                               (function-str-spec (Int.+ 100 arity) arity "str"))))
      (for [arity 0 10]
        (set! result
              (Array.push-back result
                               (function-str-spec (Int.+ 110 arity) arity "prn"))))
      result))

  (doc validate-specs "checks that `entries` have non-negative ids and no
duplicate ids or names.")
  (defn validate-specs [entries]
    (let-do [result (the (Result Unit PrimitiveRegistryError)
                         (Result.Success ()))
             n (Array.length entries)]
      (for [i 0 n]
        (match-ref &result
          (Result.Success _)
            (let-do [left (Array.unsafe-nth entries i)
                     left-reference (PrimitiveSpec.reference left)]
              (when (Int.< @(CoreRef.id left-reference) 0)
                (set! result
                      (Result.Error
                        (PrimitiveRegistryError.init @"primitive IDs must be non-negative"))))
              (for [j (Int.inc i) n]
                (match-ref &result
                  (Result.Success _)
                    (let [right (Array.unsafe-nth entries j)
                          right-reference (PrimitiveSpec.reference right)]
                      (if (Int.= @(CoreRef.id left-reference)
                                 @(CoreRef.id right-reference))
                        (set! result
                              (Result.Error
                                (PrimitiveRegistryError.init @"duplicate primitive ID")))
                        (when (= (CoreRef.name left-reference)
                                 (CoreRef.name right-reference))
                          (set! result
                                (Result.Error
                                  (PrimitiveRegistryError.init @"duplicate primitive name"))))))
                  (Result.Error _) ())))
          (Result.Error _) ()))
      result))

  (doc validate "checks the primitive specs with `validate-specs`.")
  (defn validate [] (let [entries (specs)] (validate-specs &entries)))

  (doc globals "returns the references of all primitives.")
  (defn globals []
    (let-do [result (the (Array CoreRef) [])
             entries (specs)
             n (Array.length &entries)]
      (for [i 0 n]
        (set! result
              (Array.push-back result
                               @(PrimitiveSpec.reference (Array.unsafe-nth &entries
                                                                           i)))))
      result))

  (doc template-c-for "returns the C template (declaration and body) for the
builtin `name`, or `Nothing` if it has none. The templates use the same
`$NAME`, `$a` and `$DECL` substitutions as `deftemplate`.")
  (defn template-c-for [name]
    (cond
      (= name "Array.push-back")
      (Maybe.Just
        (Pair.init @"Array $NAME(Array a, $a value)"
                   @"$DECL { a.len++; if(a.len > a.capacity){ a.capacity = a.len * 2; a.data = a.data ? CARP_REALLOC(a.data, sizeof($a) * a.capacity) : CARP_MALLOC(sizeof($a) * a.capacity); } (($a*)a.data)[a.len - 1] = value; return a; }"))
      (= name "Array.push-back!")
      (Maybe.Just
        (Pair.init @"void $NAME(Array *aRef, $a value)"
                   @"$DECL { aRef->len++; if(aRef->len > aRef->capacity){ aRef->capacity = aRef->len * 2; aRef->data = aRef->data ? CARP_REALLOC(aRef->data, sizeof($a) * aRef->capacity) : CARP_MALLOC(sizeof($a) * aRef->capacity); } (($a*)aRef->data)[aRef->len - 1] = value; }"))
      (= name "Array.pop-back!")
      (Maybe.Just
        (Pair.init @"$a $NAME(Array *aRef)"
                   @"$DECL { $a ret = (($a*)aRef->data)[aRef->len - 1]; aRef->len--; return ret; }"))
      (= name "Array.endo-map")
      (Maybe.Just
        (Pair.init @"Array $NAME(Lambda *f, Array a)"
                   @"$DECL { for(int i = 0; i < a.len; ++i){ (($a*)a.data)[i] = ((*f).env ? (($a (*)(void*, $a))(*f).callback)((*f).env, (($a*)a.data)[i]) : (($a (*)($a))(*f).callback)((($a*)a.data)[i])); } return a; }"))
      ;; the interface-level generics share the array templates: a call site
      ;; that dispatches to the bare name must still link.
      (= name "endo-map")
      (Maybe.Just
        (Pair.init @"Array $NAME(Lambda *f, Array a)"
                   @"$DECL { for(int i = 0; i < a.len; ++i){ (($a*)a.data)[i] = ((*f).env ? (($a (*)(void*, $a))(*f).callback)((*f).env, (($a*)a.data)[i]) : (($a (*)($a))(*f).callback)((($a*)a.data)[i])); } return a; }"))
      (the (Maybe (Pair String String)) (Maybe.Nothing))))

  (doc template-sources "returns a builtin source for each builtin that has a
template in `template-c-for`. Each reuses the builtin's reference and
signature, so no new ids are added. The backend uses these sources in place of
the builtins' intrinsic lowering.")
  (defn template-sources []
    (let-do [result (the (Array CoreBuiltinSource) [])
             entries (specs)
             n (Array.length &entries)]
      (for [i 0 n]
        (let [spec (Array.unsafe-nth &entries i)]
          (match (template-c-for (CoreRef.name (PrimitiveSpec.reference spec)))
            (Maybe.Just dc)
              (Array.push-back! &result
                                (CoreBuiltinSource.init @(PrimitiveSpec.reference spec)
                                                        (Box.init
                                                          @(Box.peek (PrimitiveSpec.signature spec)))
                                                        (CoreBuiltinPayload.Template @(Pair.a &dc)
                                                                                     @(Pair.b &dc))))
            (Maybe.Nothing) ())))
      result))

  (doc interfaces "returns the primitive interfaces.")
  (defn interfaces []
    (let-do [result (the (Array CoreInterface) [])
             entries (specs)
             n (Array.length &entries)]
      (for [i 0 n]
        (let [entry (Array.unsafe-nth &entries i)]
          (match-ref (PrimitiveSpec.phase entry)
            (PrimitivePhase.Interface)
              (set! result
                    (Array.push-back result
                                     (CoreInterface.init @(PrimitiveSpec.reference entry)
                                                         @(PrimitiveSpec.signature entry))))
            (PrimitivePhase.Runtime) ())))
      result))

  (doc builtins "returns the primitive builtins.")
  (defn builtins []
    (let-do [result (the (Array CoreBuiltin) [])
             entries (specs)
             n (Array.length &entries)]
      (for [i 0 n]
        (let [entry (Array.unsafe-nth &entries i)]
          (match-ref (PrimitiveSpec.phase entry)
            (PrimitivePhase.Interface) ()
            (PrimitivePhase.Runtime)
              (set! result
                    (Array.push-back result
                                     (CoreBuiltin.init @(PrimitiveSpec.reference entry)
                                                       @(PrimitiveSpec.signature entry)))))))
      result))

  (doc implementations "returns the implementations of interfaces by primitive
builtins.")
  (defn implementations []
    (let-do [result [(CoreImplementation.init (reference 0 "copy")
                                              (reference 52 "Array.copy"))
                     (CoreImplementation.init (reference 0 "copy")
                                              (reference 54 "Pointer.copy"))
                     (CoreImplementation.init (reference 1 "str")
                                              (reference 41 "Array.str"))
                     (CoreImplementation.init (reference 1 "str")
                                              (reference 71 "StaticArray.str"))
                     ; the container str functions also implement prn, which
                     ; renders containers nested in other values
                     (CoreImplementation.init (reference 2 "prn")
                                              (reference 41 "Array.str"))
                     (CoreImplementation.init (reference 2 "prn")
                                              (reference 71 "StaticArray.str"))
                     (CoreImplementation.init (reference 3 "delete")
                                              (reference 72 "Array.delete"))
                     (CoreImplementation.init (reference 3 "delete")
                                              (reference 76 "StaticArray.delete"))]]
      (for [arity 0 10]
        (set! result
              (Array.push-back result
                               (CoreImplementation.init (reference 0 "copy")
                                                        (reference (Int.+ 55
                                                                          arity)
                                                                   &(String.concat
                                                                     &[@"Function.Arity"
                                                                       (Int.str arity)
                                                                       @".copy"]))))))
      (for [arity 0 10]
        (set! result
              (Array.push-back result
                               (CoreImplementation.init (reference 3 "delete")
                                                        (reference (Int.+ 120
                                                                          arity)
                                                                   &(String.concat
                                                                     &[@"Function.Arity"
                                                                       (Int.str arity)
                                                                       @".delete"]))))))
      (for [arity 0 10]
        (set! result
              (Array.push-back result
                               (CoreImplementation.init (reference 1 "str")
                                                        (reference (Int.+ 100
                                                                          arity)
                                                                   &(String.concat
                                                                     &[@"Function.Arity"
                                                                       (Int.str arity)
                                                                       @".str"]))))))
      (for [arity 0 10]
        (set! result
              (Array.push-back result
                               (CoreImplementation.init (reference 2 "prn")
                                                        (reference (Int.+ 110
                                                                          arity)
                                                                   &(String.concat
                                                                     &[@"Function.Arity"
                                                                       (Int.str arity)
                                                                       @".prn"]))))))
      result))

  (private table)
  (hidden table)
  (doc table "is the primitive specs, built once.")
  (def table (specs))

  (doc lowering-for "returns how the primitive `reference` is compiled, or
`Nothing` if it is not a primitive.")
  (defn lowering-for [reference]
    (let-do [result (the (Maybe PrimitiveLowering) (Maybe.Nothing))
             n (Array.length &table)]
      (for [i 0 n]
        (let [entry (Array.unsafe-nth &table i)]
          (when (CoreIR.same-ref? (PrimitiveSpec.reference entry) reference)
            (set! result (Maybe.Just @(PrimitiveSpec.lowering entry))))))
      result)))
