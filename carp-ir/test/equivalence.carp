(load "../carp-ir.carp")
(load "Test.carp")
(Project.no-echo)
(use-all Test)

(defn definition-with [parameters body]
  (let-do [module (CoreIR.empty-module)]
    (CoreModule.set-functions! &module
                               [(CoreFunction.init (CoreRef.init 1
                                                                 @"compared"
                                                                 true)
                                                   parameters
                                                   (Box.init body))])
    module))

(defn lexical-definition [first second selected]
  (let [outer (CoreRef.init first @"x" false)
        inner (CoreRef.init second @"x" false)]
    (definition-with []
                     (CoreExpr.Let 20
                                   @&outer
                                   (Box.init (CoreExpr.IntLit 21 1))
                                   (Box.init
                                     (CoreExpr.Let 22
                                                   @&inner
                                                   (Box.init (CoreExpr.IntLit 23
                                                                              2))
                                                   (Box.init
                                                     (CoreExpr.Reference 24
                                                                         (if selected
                                                                           @&inner
                                                                           @&outer)))))))))

(defn constructor-context [id type]
  (let-do [module (CoreIR.empty-module)]
    (CoreModule.set-constructors! &module
                                  [(CoreConstructorDeclaration.init (CoreRef.init id
                                                                                  @"Record.init"
                                                                                  true)
                                                                    0
                                                                    [(Box.init @type)]
                                                                    [@"field"]
                                                                    (Box.init (CoreType.Named @"Record"
                                                                                              [])))])
    module))

(deftest test
  (assert-true test
    (CoreIR.equivalent-definition? &(lexical-definition -2 -3 false)
                                   &(lexical-definition -20 -30 false)
                                   "compared")
    "replayed local IDs do not change a definition's native identity")
  (assert-false test
    (CoreIR.equivalent-definition? &(lexical-definition -2 -3 false)
                                   &(lexical-definition -20 -30 true)
                                   "compared")
    "same-named lexical binders remain distinct when a reference changes target")
  (assert-false test
    (CoreIR.equivalent-definition?
      &(definition-with [] (CoreExpr.DoubleLit 1 0.0))
      &(definition-with [] (CoreExpr.DoubleLit 2 -0.0))
      "compared")
    "signed zero remains observable in native code")
  (assert-false test
    (CoreIR.equivalent-definition?
      &(definition-with []
                        (CoreExpr.FloatLit 1
                                           (Float.+ 1f (Float./ 1f 8.38861e+06f))))
      &(definition-with []
                        (CoreExpr.FloatLit 2
                                           (Float.+ 1f (Float./ 2f 8.38861e+06f))))
      "compared")
    "literal equality does not lose precision through display formatting")
  (assert-true test
    (CoreIR.equivalent-native-context?
      &(constructor-context 1 &(CoreType.Integer))
      &(constructor-context 100 &(CoreType.Integer)))
    "constructor allocation IDs do not change the native layout")
  (assert-false test
    (CoreIR.equivalent-native-context?
      &(constructor-context 1 &(CoreType.Integer))
      &(constructor-context 100 &(CoreType.String)))
    "a constructor field type changes the native layout"))
