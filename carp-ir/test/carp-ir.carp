(load "../carp-ir.carp")
(Project.no-echo)
(load "Test.carp")

(use-all Test)

(defn gref [id name] (CoreRef.init id (String.copy name) true))

(defn lref [id name] (CoreRef.init id (String.copy name) false))

(defn fn-with [id name body]
  (CoreFunction.init (gref id name) [] (Box.init body)))

(defn module-with [functions values]
  (CoreModule.init functions values [] [] [] [] [] [] [] [] []))

(defn allocator-counts-up? []
  (let-do [alloc (IdAllocator.init [10])]
    (and (Int.= 10 (IdAllocator.next-up! &alloc))
         (and (Int.= 11 (IdAllocator.next-up! &alloc))
              (Int.= 12 (IdAllocator.next-up! &alloc))))))

(defn allocator-counts-down? []
  (let-do [alloc (IdAllocator.init [-5])]
    (and
      (Int.= -5 (IdAllocator.next-down! &alloc))
      (and
        (Int.= -6 (IdAllocator.next-down! &alloc))
        (Int.= -7 (IdAllocator.next-down! &alloc))))))

(defn same-ref-compares-id-and-name? []
  (let [a (gref 3 "f")
        b (gref 3 "f")
        c (gref 3 "g")
        d (gref 4 "f")]
    (and (CoreIR.same-ref? &a &b)
         (and (not (CoreIR.same-ref? &a &c)) (not (CoreIR.same-ref? &a &d))))))

(defn empty-module-watermark-is-minus-one? []
  (let [m (module-with [] [])] (Int.= -1 (CoreIR.max-declared-global-id &m))))

(defn watermark-covers-functions-and-values? []
  (let [m (module-with [(fn-with 7 "f" (CoreExpr.UnitLit 0))]
                       [(CoreValue.init (gref 12 "v")
                                        (Box.init (CoreExpr.UnitLit 1)))])]
    (Int.= 12 (CoreIR.max-declared-global-id &m))))

(defn fresh-globals-start-past-watermark? []
  (let-do [m (module-with [(fn-with 7 "f" (CoreExpr.UnitLit 0))] [])
           alloc (CoreIR.fresh-global-allocator &m)]
    (Int.= 8 (IdAllocator.next-up! &alloc))))

(defn no-duplicate-in-distinct-functions? []
  (let [m (module-with
          [(fn-with 1 "f" (CoreExpr.UnitLit 0))
           (fn-with 2 "g" (CoreExpr.UnitLit 1))]
          [])]
    (match (CoreIR.duplicate-global-id &m)
      (Maybe.Nothing) true
      (Maybe.Just _) false)))

(defn duplicate-function-id-is-reported? []
  (let [m (module-with
          [(fn-with 1 "f" (CoreExpr.UnitLit 0))
           (fn-with 1 "g" (CoreExpr.UnitLit 1))]
          [])]
    (match (CoreIR.duplicate-global-id &m)
      (Maybe.Just id) (Int.= id 1)
      (Maybe.Nothing) false)))

(defn cross-category-id-sharing-is-not-a-duplicate? []
  ; a function and a VALUE may share an id (deliberate cross-category
  ; identity); duplication is only within one category.
  (let [m (module-with [(fn-with 1 "f" (CoreExpr.UnitLit 0))]
                       [(CoreValue.init (gref 1 "f")
                                        (Box.init (CoreExpr.UnitLit 1)))])]
    (match (CoreIR.duplicate-global-id &m)
      (Maybe.Nothing) true
      (Maybe.Just _) false)))

(defn local-allocator-clamps-below-resolver-range? []
  ; an empty module has no locals; synthesized locals must still start BELOW
  ; the resolver's local range start (-(2^20)).
  (let-do [m (module-with [] [])
           alloc (CoreIR.fresh-local-allocator &m)
           first-id (IdAllocator.next-down! &alloc)]
    (and (Int.= first-id -1048577)
         (Int.= -1048578 (IdAllocator.next-down! &alloc)))))

(defn local-allocator-descends-past-deepest-local? []
  (let-do [body (CoreExpr.Let 0
                              (lref -2000000 "x")
                              (Box.init (CoreExpr.UnitLit 1))
                              (Box.init (CoreExpr.UnitLit 2)))
           m (module-with [(fn-with 1 "f" body)] [])
           alloc (CoreIR.fresh-local-allocator &m)]
    (Int.= -2000001 (IdAllocator.next-down! &alloc))))

(deftest test
  (assert-true test (allocator-counts-up?) "next-up! counts upward")
  (assert-true test (allocator-counts-down?) "next-down! counts downward")
  (assert-true test
    (same-ref-compares-id-and-name?)
    "same-ref? needs id AND name to agree")
  (assert-true test
    (empty-module-watermark-is-minus-one?)
    "an empty module's global watermark is -1")
  (assert-true test
    (watermark-covers-functions-and-values?)
    "the watermark spans every declaration category")
  (assert-true test
    (fresh-globals-start-past-watermark?)
    "fresh globals allocate one past the watermark")
  (assert-true test
    (no-duplicate-in-distinct-functions?)
    "distinct ids are not duplicates")
  (assert-true test
    (duplicate-function-id-is-reported?)
    "two functions sharing an id are a duplicate")
  (assert-true test
    (cross-category-id-sharing-is-not-a-duplicate?)
    "cross-category id sharing is deliberate identity")
  (assert-true test
    (local-allocator-clamps-below-resolver-range?)
    "synthesized locals start below the resolver's local range")
  (assert-true test
    (local-allocator-descends-past-deepest-local?)
    "synthesized locals descend past the deepest existing local"))
