(load "../module-transactions.carp")
(Project.no-echo)
(load "Test.carp")

(use-all Test)

(defn gref [id name] (CoreRef.init id (String.copy name) true))

(defn lref [id name] (CoreRef.init id (String.copy name) false))

(defn fn-with [id name body]
  (CoreFunction.init (gref id name) [] (Box.init body)))

(defn module-with [functions values]
  (CoreModule.init functions values [] [] [] [] [] [] [] [] [] [] []))

(defn allocator-counts-up? []
  (let-do [alloc (IdAllocator.init [10])]
    (and (Int.= 10 (IdAllocator.next-up! &alloc))
         (and (Int.= 11 (IdAllocator.next-up! &alloc))
              (Int.= 12 (IdAllocator.next-up! &alloc))))))

(defn allocator-counts-down? []
  (let-do [alloc (IdAllocator.init [-5])]
    (and
      (Int.= -5 (IdAllocator.next-down! &alloc))
      (and
        (Int.= -6 (IdAllocator.next-down! &alloc))
        (Int.= -7 (IdAllocator.next-down! &alloc))))))

(defn same-ref-compares-id-and-name? []
  (let [a (gref 3 "f")
        b (gref 3 "f")
        c (gref 3 "g")
        d (gref 4 "f")]
    (and (CoreIR.same-ref? &a &b)
         (and (not (CoreIR.same-ref? &a &c)) (not (CoreIR.same-ref? &a &d))))))

(defn empty-module-watermark-is-minus-one? []
  (let [m (module-with [] [])] (Int.= -1 (CoreIR.max-declared-global-id &m))))

(defn watermark-covers-functions-and-values? []
  (let [m (module-with [(fn-with 7 "f" (CoreExpr.UnitLit 0))]
                       [(CoreValue.init (gref 12 "v")
                                        (Box.init (CoreExpr.UnitLit 1)))])]
    (Int.= 12 (CoreIR.max-declared-global-id &m))))

(defn fresh-globals-start-past-watermark? []
  (let-do [m (module-with [(fn-with 7 "f" (CoreExpr.UnitLit 0))] [])
           alloc (CoreIR.fresh-global-allocator &m)]
    (Int.= 8 (IdAllocator.next-up! &alloc))))

(defn no-duplicate-in-distinct-functions? []
  (let [m (module-with
          [(fn-with 1 "f" (CoreExpr.UnitLit 0))
           (fn-with 2 "g" (CoreExpr.UnitLit 1))]
          [])]
    (match (CoreIR.duplicate-global-id &m)
      (Maybe.Nothing) true
      (Maybe.Just _) false)))

(defn duplicate-function-id-is-reported? []
  (let [m (module-with
          [(fn-with 1 "f" (CoreExpr.UnitLit 0))
           (fn-with 1 "g" (CoreExpr.UnitLit 1))]
          [])]
    (match (CoreIR.duplicate-global-id &m)
      (Maybe.Just id) (Int.= id 1)
      (Maybe.Nothing) false)))

(defn cross-category-id-sharing-is-not-a-duplicate? []
  ; a function and a VALUE may share an id (deliberate cross-category
  ; identity); duplication is only within one category.
  (let [m (module-with [(fn-with 1 "f" (CoreExpr.UnitLit 0))]
                       [(CoreValue.init (gref 1 "f")
                                        (Box.init (CoreExpr.UnitLit 1)))])]
    (match (CoreIR.duplicate-global-id &m)
      (Maybe.Nothing) true
      (Maybe.Just _) false)))

(defn local-allocator-clamps-below-resolver-range? []
  ; an empty module has no locals; synthesized locals must still start BELOW
  ; the resolver's local range start (-(2^20)).
  (let-do [m (module-with [] [])
           alloc (CoreIR.fresh-local-allocator &m)
           first-id (IdAllocator.next-down! &alloc)]
    (and (Int.= first-id -1048577)
         (Int.= -1048578 (IdAllocator.next-down! &alloc)))))

(defn local-allocator-descends-past-deepest-local? []
  (let-do [body (CoreExpr.Let 0
                              (lref -2000000 "x")
                              (Box.init (CoreExpr.UnitLit 1))
                              (Box.init (CoreExpr.UnitLit 2)))
           m (module-with [(fn-with 1 "f" body)] [])
           alloc (CoreIR.fresh-local-allocator &m)]
    (Int.= -2000001 (IdAllocator.next-down! &alloc))))

(defn generated-identities-are-fresh-and-spanned? []
  (let-do [span (SourceSpan.init (String.copy "cell:derive") 2 19)
           fallback (the (Maybe SourceSpan) (Maybe.Just (SourceSpan.copy &span)))
           body (CoreExpr.Do -1
                             [(Box.init (CoreExpr.UnitLit 42))
                              (Box.init (CoreExpr.UnitLit -1))])
           m (module-with [(fn-with 1 "derived" body)] [])
           provenance (CoreProvenance.init
             [(NodeProvenance.init 42 (SourceSpan.copy &span))]
             []
             [])
           allocator (IdAllocator.init [100])
           identified (CoreIR.identify-generated &m
                                                 &provenance
                                                 &allocator
                                                 &fallback)
           function (Array.unsafe-nth
             (CoreModule.functions (ProvenancedCoreModule.core &identified))
             0)]
    (match-ref (Box.peek (CoreFunction.body function))
      (CoreExpr.Do root expressions)
        (and (Int.= @root 100)
             (and
               (Int.=
                 (CoreIR.expression-id
                   (Box.peek (Array.unsafe-nth expressions 0)))
                 42)
               (and
                 (Int.=
                   (CoreIR.expression-id
                     (Box.peek (Array.unsafe-nth expressions 1)))
                   101)
                 (and
                   (match (CoreProvenance.node-span
                       (ProvenancedCoreModule.provenance &identified)
                       100)
                     (Maybe.Just generated-span)
                       (String.= (SourceSpan.source-id &generated-span)
                                 "cell:derive")
                     (Maybe.Nothing) false)
                   (and
                     (match (CoreProvenance.binding-span
                         (ProvenancedCoreModule.provenance &identified)
                         (CoreFunction.reference function))
                       (Maybe.Just binding-span)
                         (String.= (SourceSpan.source-id &binding-span)
                                   "cell:derive")
                       (Maybe.Nothing) false)
                     (and
                       (Int.= 1
                              (Array.length
                                (CoreProvenance.definitions
                                  (ProvenancedCoreModule.provenance &identified))))
                       (Int.= 102 (IdAllocator.next-up! &allocator))))))))
      _ false)))

(defn empty-module-has-no-payload? []
  (let-do [module (CoreIR.empty-module)
           total 0]
    (set! total (Int.+ total (Array.length (CoreModule.functions &module))))
    (set! total (Int.+ total (Array.length (CoreModule.values &module))))
    (set! total (Int.+ total (Array.length (CoreModule.builtins &module))))
    (set! total
          (Int.+ total (Array.length (CoreModule.builtin-sources &module))))
    (set! total (Int.+ total (Array.length (CoreModule.signatures &module))))
    (set! total
          (Int.+ total (Array.length (CoreModule.type-declarations &module))))
    (set! total (Int.+ total (Array.length (CoreModule.constructors &module))))
    (set! total (Int.+ total (Array.length (CoreModule.interfaces &module))))
    (set! total
          (Int.+ total (Array.length (CoreModule.implementations &module))))
    (set! total
          (Int.+ total (Array.length (CoreModule.system-includes &module))))
    (set! total (Int.+ total (Array.length (CoreModule.expressions &module))))
    (Int.= 0 total)))

(defn module-append-preserves-source-order? []
  (let [left (CoreModule.init
          [(fn-with 1 "left" (CoreExpr.UnitLit 1))]
          []
          []
          []
          []
          []
          []
          []
          []
          []
          []
          [(String.copy "left.h")]
          [(Box.init (CoreExpr.UnitLit 11))])
        right (CoreModule.init
          [(fn-with 2 "right" (CoreExpr.UnitLit 2))]
          []
          []
          []
          []
          []
          []
          []
          []
          []
          []
          [(String.copy "right.h")]
          [(Box.init (CoreExpr.UnitLit 12))])
        merged (CoreIR.append-modules &left &right)]
    (and
      (Int.= 2 (Array.length (CoreModule.functions &merged)))
      (and
        (String.= "left"
                  (CoreRef.name
                    (CoreFunction.reference
                      (Array.unsafe-nth (CoreModule.functions &merged) 0))))
        (and
          (String.= "right"
                    (CoreRef.name
                      (CoreFunction.reference
                        (Array.unsafe-nth (CoreModule.functions &merged) 1))))
          (and
            (String.= "left.h"
                      (Array.unsafe-nth (CoreModule.system-includes &merged) 0))
            (String.= "right.h"
                      (Array.unsafe-nth (CoreModule.system-includes &merged) 1))))))))

(defn provenance-append-preserves-source-order? []
  (let [left-span (SourceSpan.init (String.copy "left") 1 2)
        right-span (SourceSpan.init (String.copy "right") 3 4)
        left (CoreProvenance.init [(NodeProvenance.init 10 left-span)] [] [])
        right (CoreProvenance.init [(NodeProvenance.init 20 right-span)] [] [])
        merged (CoreProvenance.append &left &right)]
    (and
      (Int.= 2 (Array.length (CoreProvenance.nodes &merged)))
      (and
        (Int.= 10
               @(NodeProvenance.id
                 (Array.unsafe-nth (CoreProvenance.nodes &merged) 0)))
        (Int.= 20
               @(NodeProvenance.id
                 (Array.unsafe-nth (CoreProvenance.nodes &merged) 1)))))))

(defmacro core-module-field-count [] (length (eval '__members_CoreModule)))

; Distinct field lengths expose mismatched checkpoint slots.
(defn fill-fixture-field! [items count]
  (for [i 1 count]
    (let [item @(Array.unsafe-nth items 0)] (Array.push-back! items item))))

(defn complete-module-fixture [name]
  (let-do [reference (gref 1 name)
           signature (CoreType.Function [] (Box.init (CoreType.Unit)))
           nominal (CoreType.Named (String.copy name) [])
           module (CoreModule.init [(fn-with 1 name (CoreExpr.UnitLit 1))]
                                   [(CoreValue.init (gref 2 name)
                                                    (Box.init (CoreExpr.IntLit 2
                                                                               42)))]
                                   [(CoreBuiltin.init (gref 3 name)
                                                      (Box.init (CoreType.copy &signature)))]
                                   [(CoreBuiltinSource.init (gref 3 name)
                                                            (Box.init (CoreType.copy &signature))
                                                            (CoreBuiltinPayload.External (Maybe.Nothing)))]
                                   [(CoreSignature.init (CoreRef.copy &reference)
                                                        (Box.init signature))]
                                   [(CoreTypeDeclaration.init (String.copy name)
                                                              (Maybe.Nothing)
                                                              [])]
                                   [(CoreConstructorDeclaration.init (gref 4
                                                                           name)
                                                                     0
                                                                     []
                                                                     []
                                                                     (Box.init nominal))]
                                   [(String.copy name)]
                                   [(CoreInterface.init (gref 5 name)
                                                        (Box.init (CoreType.Unit)))]
                                   [(CoreImplementation.init (gref 5 name)
                                                             (CoreRef.copy &reference))]
                                   [(CoreOverload.init (gref 6 name) [reference])]
                                   [(String.copy name)]
                                   [(Box.init (CoreExpr.UnitLit 7))])]
    (fill-fixture-field! (CoreModule.functions &module) 1)
    (fill-fixture-field! (CoreModule.values &module) 2)
    (fill-fixture-field! (CoreModule.builtins &module) 3)
    (fill-fixture-field! (CoreModule.builtin-sources &module) 4)
    (fill-fixture-field! (CoreModule.signatures &module) 5)
    (fill-fixture-field! (CoreModule.type-declarations &module) 6)
    (fill-fixture-field! (CoreModule.constructors &module) 7)
    (fill-fixture-field! (CoreModule.recursive-types &module) 8)
    (fill-fixture-field! (CoreModule.interfaces &module) 9)
    (fill-fixture-field! (CoreModule.implementations &module) 10)
    (fill-fixture-field! (CoreModule.overloads &module) 11)
    (fill-fixture-field! (CoreModule.system-includes &module) 12)
    (fill-fixture-field! (CoreModule.expressions &module) 13)
    module))

(defn module-transactions-preserve-all-fields? []
  (let-do [left (complete-module-fixture "left")
           right (complete-module-fixture "right")
           resident (CoreIR.empty-module)
           empty-mark (CoreIR.mark-module &resident)]
    (CoreIR.append-module! &resident &left)
    (let-do [copied-all (String.= &(str &resident) &(str &left))
             mark (CoreIR.mark-module &resident)
             expected (CoreIR.append-modules &left &right)]
      (CoreIR.append-module! &resident &right)
      (let-do [equivalent (String.= &(str &resident) &(str &expected))]
        (CoreIR.retract-module! &resident &mark)
        (let-do [restored-left (String.= &(str &resident) &(str &left))]
          (CoreIR.retract-module! &resident &empty-mark)
          (and copied-all
               (and equivalent
                    (and restored-left
                         (String.= &(str &resident)
                                   &(str &(CoreIR.empty-module)))))))))))

(deftest test
  (assert-true test (allocator-counts-up?) "next-up! counts upward")
  (assert-true test (allocator-counts-down?) "next-down! counts downward")
  (assert-true test
    (same-ref-compares-id-and-name?)
    "same-ref? needs id AND name to agree")
  (assert-true test
    (empty-module-watermark-is-minus-one?)
    "an empty module's global watermark is -1")
  (assert-true test
    (watermark-covers-functions-and-values?)
    "the watermark spans every declaration category")
  (assert-true test
    (fresh-globals-start-past-watermark?)
    "fresh globals allocate one past the watermark")
  (assert-true test
    (no-duplicate-in-distinct-functions?)
    "distinct ids are not duplicates")
  (assert-true test
    (duplicate-function-id-is-reported?)
    "two functions sharing an id are a duplicate")
  (assert-true test
    (cross-category-id-sharing-is-not-a-duplicate?)
    "cross-category id sharing is deliberate identity")
  (assert-true test
    (local-allocator-clamps-below-resolver-range?)
    "synthesized locals start below the resolver's local range")
  (assert-true test
    (local-allocator-descends-past-deepest-local?)
    "synthesized locals descend past the deepest existing local")
  (assert-true test
    (generated-identities-are-fresh-and-spanned?)
    "generated nodes get fresh identities and declaration provenance")
  (assert-true test
    (empty-module-has-no-payload?)
    "empty Core modules have no declaration or expression payload")
  (assert-true test
    (module-append-preserves-source-order?)
    "Core module append preserves source order")
  (assert-true test
    (provenance-append-preserves-source-order?)
    "Core provenance append preserves source order")
  (assert-true test
    (module-transactions-preserve-all-fields?)
    "complete module assembly and nested rollback preserve every field")
  (assert-equal test
    (core-module-field-count)
    (Array.length &(CoreIR.mark-module &(CoreIR.empty-module)))
    "a checkpoint covers every field declared by CoreModule"))
