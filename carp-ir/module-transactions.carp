(load "carp-ir.carp")

; Checkpoints belong to append-only session transactions. Batch compilation
; only needs the ordinary module assembly functions in carp-ir.carp.
(defmodule CoreIR
  (doc mark-module
    "records each array boundary before append-module!. The returned checkpoint is opaque and belongs to this module; it does not capture edits to existing entries.")
  (defn mark-module [module]
    [(Array.length (CoreModule.functions module))
     (Array.length (CoreModule.values module))
     (Array.length (CoreModule.builtins module))
     (Array.length (CoreModule.builtin-sources module))
     (Array.length (CoreModule.signatures module))
     (Array.length (CoreModule.type-declarations module))
     (Array.length (CoreModule.constructors module))
     (Array.length (CoreModule.recursive-types module))
     (Array.length (CoreModule.interfaces module))
     (Array.length (CoreModule.implementations module))
     (Array.length (CoreModule.overloads module))
     (Array.length (CoreModule.system-includes module))
     (Array.length (CoreModule.expressions module))])

  (private retract-array!)
  (hidden retract-array!)
  (defn retract-array! [target length]
    (while-do (Int.> (Array.length target) length)
      (ignore (Array.pop-back! target))))

  (doc retract-module!
    "removes every entry appended after mark-module, retaining the original entries and their order. Checkpoints may be nested and must come from the same module.")
  (defn retract-module! [module mark]
    (do
      (retract-array! (CoreModule.functions module) @(Array.unsafe-nth mark 0))
      (retract-array! (CoreModule.values module) @(Array.unsafe-nth mark 1))
      (retract-array! (CoreModule.builtins module) @(Array.unsafe-nth mark 2))
      (retract-array! (CoreModule.builtin-sources module)
                      @(Array.unsafe-nth mark 3))
      (retract-array! (CoreModule.signatures module) @(Array.unsafe-nth mark 4))
      (retract-array! (CoreModule.type-declarations module)
                      @(Array.unsafe-nth mark 5))
      (retract-array! (CoreModule.constructors module)
                      @(Array.unsafe-nth mark 6))
      (retract-array! (CoreModule.recursive-types module)
                      @(Array.unsafe-nth mark 7))
      (retract-array! (CoreModule.interfaces module) @(Array.unsafe-nth mark 8))
      (retract-array! (CoreModule.implementations module)
                      @(Array.unsafe-nth mark 9))
      (retract-array! (CoreModule.overloads module) @(Array.unsafe-nth mark 10))
      (retract-array! (CoreModule.system-includes module)
                      @(Array.unsafe-nth mark 11))
      (retract-array! (CoreModule.expressions module)
                      @(Array.unsafe-nth mark 12)))))
